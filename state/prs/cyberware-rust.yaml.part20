ests with enhanced SQLite coverage.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-20T17:45:58Z","updated_at":"2026-02-08T10:15:47Z","closed_at":"2026-01-22T18:31:35Z","merged_at":"2026-01-22T18:31:34Z","merge_commit_sha":"d507ee61d5fafc9ca1eec0682272237ed764ac8c","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/284/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/284/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/284/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/69748c6cb4794a442e7817368386788dadac45cb","head":{"label":"Bechma:prepare-lib2","ref":"prepare-lib2","sha":"69748c6cb4794a442e7817368386788dadac45cb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_v
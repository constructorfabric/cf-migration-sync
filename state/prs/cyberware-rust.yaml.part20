Xlsx,\n+    /// Excel Open XML Macro-Enabled format (.xlsm)\n+    Xlsm,\n+    /// Excel Binary format (.xlsb)\n+    Xlsb,\n+}\n+\n+/// OLE Compound Document magic bytes (used by .xls)\n+const OLE_MAGIC: [u8; 4] = [0xD0, 0xCF, 0x11, 0xE0];\n+/// ZIP archive magic bytes (used by .xlsx, .xlsm, .xlsb)\n+const ZIP_MAGIC: [u8; 4] = [0x50, 0x4B, 0x03, 0x04];\n+\n+impl From<&str> for ExcelFormat {\n+    fn from(value: &str) -> Self {\n+        Self::from_filename(value).unwrap_or_default()\n+    }\n+}\n+\n+impl ExcelFormat {\n+    #[must_use] \n+    pub const fn as_str(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"xls\",\n+            Self::Xlsx => \"xlsx\",\n+            Self::Xlsm => \"xlsm\",\n+            Self::Xlsb => \"xlsb\",\n+        }\n+    }\n+    /// Determine format from filename extension (used as hint for MIME type)\n+    /// Returns an error if the extension is not a recognized Excel format\n+    pub fn from_filename(filename: &str) -> Result<Self, DomainError> {\n+        let ext = Path::new(filename).extension().and_then(|os| os.to_str());\n+\n+        if let Some(ext) = ext {\n+            return Ok(ExcelFormat::from(ext));\n+        }\n+\n+        Err(DomainError::parse_error(format!(\n+            \"Unrecognized Excel file extension: '{filename}'\"\n+        )))\n+    }","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"430507b579433131ee5a2a385ce678500c9a370e","original_commit_id":"88e3df0b780006ef504ea9a2e8184cb98b04b3db","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n**Critical: `From<&str>` and `from_filename` have a circular dependency that causes incorrect format detection.**\n\nThe `From<&str>` implementation calls `from_filename`, which in turn calls `ExcelFormat::from(ext)`. While this doesn't cause infinite recursion (because `Path::new(\"xls\").extension()` returns `None` for a bare extension string), it produces incorrect results:\n\n- `\"xls\".into()` → calls `from_filename(\"xls\")` → no extension found → returns `Err` → `unwrap_or_default()` → returns `Xlsx` instead of `Xls`\n\nThis means all tests like `assert_eq!(ExcelFormat::Xls, \"xls\".into())` (line 406) will fail.\n\n\n\n<details>\n<summary>🐛 Proposed fix: Separate extension matching from filename parsing</summary>\n\n```diff\n impl From<&str> for ExcelFormat {\n     fn from(value: &str) -> Self {\n-        Self::from_filename(value).unwrap_or_default()\n+        match value.to_lowercase().as_str() {\n+            \"xls\" => Self::Xls,\n+            \"xlsx\" => Self::Xlsx,\n+            \"xlsm\" => Self::Xlsm,\n+            \"xlsb\" => Self::Xlsb,\n+            _ => Self::default(),\n+        }\n     }\n }\n\n impl ExcelFormat {\n     // ...\n \n     pub fn from_filename(filename: &str) -> Result<Self, DomainError> {\n-        let ext = Path::new(filename).extension().and_then(|os| os.to_str());\n-\n-        if let Some(ext) = ext {\n-            return Ok(ExcelFormat::from(ext));\n+        let ext = Path::new(filename)\n+            .extension()\n+            .and_then(|os| os.to_str())\n+            .map(|e| e.to_lowercase());\n+\n+        match ext.as_deref() {\n+            Some(\"xls\") => Ok(Self::Xls),\n+            Some(\"xlsx\") => Ok(Self::Xlsx),\n+            Some(\"xlsm\") => Ok(Self::Xlsm),\n+            Some(\"xlsb\") => Ok(Self::Xlsb),\n+            _ => Err(DomainError::parse_error(format!(\n+                \"Unrecognized Excel file extension: '{filename}'\"\n+            ))),\n         }\n-\n-        Err(DomainError::parse_error(format!(\n-            \"Unrecognized Excel file extension: '{filename}'\"\n-        )))\n     }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs` around lines 29 - 57,\nThe problem is a circular/incorrect mapping: the impl From<&str> for ExcelFormat\ndelegates to from_filename which treats the entire input as a filepath and then\ncalls ExcelFormat::from(ext), causing bare extension strings like \"xls\" to be\nmisdetected; fix by separating concerns: change From<&str> for ExcelFormat to\ndirectly match common extension strings (\"xls\",\"xlsx\",\"xlsm\",\"xlsb\") and return\nthe corresponding variant (i.e., implement direct mapping in the From<&str>\nimpl), and modify from_filename(filename: &str) to only extract the\nPath::extension() and then call ExcelFormat::from(the_ext_str) (or .into()) so\nfilenames and extensions use the proper conversion without recursion; update\nreferences to ExcelFormat::from(ext) to rely on the direct From<&str> mapping.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-28T17:30:59Z","updated_at":"2026-01-28T18:34:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2737741333","pull_request_url":"h
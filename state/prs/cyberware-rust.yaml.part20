url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We are not working with unsafe code. It makes no sense","created_at":"2026-01-26T10:57:46Z","updated_at":"2026-01-26T11:02:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2727170160","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727170160"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2727170160"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727170160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":8,"side":"RIGHT","author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727181589","pull_request_review_id":3705521616,"id":2727181589,"node_id":"PRRC_kwDOPaLyBs6ijX0V","diff_hunk":"@@ -97,6 +97,29 @@ make coverage-unit # Run only unit tests with code coverage\n make coverage-e2e # Run only e2e tests with code coverage\n ```\n \n+### 2.4. Run Fuzzing Tests (Recommended)\n+\n+Before submitting changes to parsers or validation logic, run fuzzing:\n+\n+```bash\n+# Quick smoke test (30s per target)\n+make fuzz\n+\n+# Longer test for critical changes (5 minutes per target)\n+python scripts/ci.py fuzz --seconds 300\n+\n+# Target specific component\n+make fuzz-run FUZZ_TARGET=fuzz_odata_filter FUZZ_SECONDS=600\n+```\n+\n+Fuzzing helps catch:\n+- Memory safety issues","path":"CONTRIBUTING.md","commit_id":"1ac308103d710197a0b9aa0538f7cec28b81b2d4","original_commit_id":"1ac308103d710197a0b9aa0538f7cec28b81b2d4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"there's no memory safety checks, we are not using unsafe","created_at":"2026-01-26T11:01:51Z","updated_at":"2026-01-26T11:02:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2727181589","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727181589"},"html":
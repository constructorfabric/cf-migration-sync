thubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes. Also needed","created_at":"2026-01-23T16:14:00Z","updated_at":"2026-01-23T16:14:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2721881258","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721881258"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2721881258"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721881258/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":3,"original_line":3,"side":"RIGHT","in_reply_to_id":2721294661,"author_association":"MEMBER","original_position":6,"position":6,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721997966","pull_request_review_id":3698492622,"id":2721997966,"node_id":"PRRC_kwDOPaLyBs6iPmSO","diff_hunk":"@@ -0,0 +1,13 @@\n+[workspace]\n+# Keep the defaults simple and explicit. We rely on Cargo manifests for:\n+# - which crates are publishable (`publish = false` disables)\n+# - per-crate versioning (explicit `version = ...` for modules/sdks, and `version.workspace = true` for ModKit libs)\n+changelog_update = true\n+git_release_enable = true\n+\n+# We keep a single changelog for the repo. release-plz will update it in the release PR.\n+changelog_path = \"CHANGELOG.md\"\n+\n+# Enable semver checks by default (can be overridden per package if needed later).\n+semver_check = true","path":"release-plz.toml","commit_id":"d24898483e891dd23eac658c2e2d21a92634cbac","original_commit_id":"76e998087fa6cfc7abfef3b99ce42d6c55b410f2","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's not true","created_at":"2026-01-23T16:38:55Z","updated_at":"2026-01-23T16:38:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2721997966","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721997966"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2721997966"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721997966/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":12,"original_line":12,"side":"RIGHT","in_reply_to_id":2721315170,"author_association":"MEMBER","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2722003473","pull_request_review_id":3698499409,"id":2722003473,"node_id":"PRRC_kwDOPaLyBs6iPnoR","diff_hunk":"@@ -0,0 +1,13 @@\n+[workspace]\n+# Keep the defaults simple and explicit. We rely on Cargo manifests for:\n+# - which crates are publishable (`publish = false` disables)\n+# - per-crate versioning (explicit `version = ...` for modules/sdks, and `version.workspace = true` for ModKit libs)\n+changelog_update = true\n+git_release_enable = true\n+\n+# We keep a single changelog for the repo. release-plz will update it in the release PR.\n+changelog_path = \"CHANGELOG.md\"\n+\n+# Enable semver checks by default (can be overridden per package if needed later).\n+semver_check = true","path":"release-plz.toml","commit_id":"d24898483e891dd23eac658c2e2d21a92634cbac","original_commit_id":"76e998087fa6cfc7abfef3b99ce42d6c55b410f2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<details>\n<summary>🧩 Analysis chain</summary>\n\n🌐 Web query:\n\n```web\nrelease-plz workspace changelog_path configuration documentation\n```\n\n💡 Result:\n\nIn **release-plz**, `changelog_path` is documented in two relevant places:\n\n- **Per-package changelog path (the “standard” setting):** set `changelog_path` under `[[package]]`. It’s **relative to the root `Cargo.toml`** (i.e., repo root in CI). The config reference also notes that this *package-section* `changelog_path` “cannot be set in the `[workspace]` section.” [1]\n\n  ```toml\n  [[package]]\n  name = \"my_package\"\n  changelog_path = \"docs/CHANGELOG.md\"\n  ```\n\n- **Workspace-wide single changelog (one file for the whole workspace):** the “Single changelog” doc shows using `changelog_path` under `[workspace]` to point all packages at one shared changelog file (and optionally overriding per-package). [2]\n\n  ```toml\n  [workspace]\n  changelog_path = \"./CHANGELOG.md\"\n\n  [[package]]\n  name = \"package_b\"\n  changelog_path = \"package_b/CHANGELOG.md\"\n  ```\n\n**Docs:** Configuration reference [1] and “Extra → Single changelog” [2].\n\n**Sources:**  \n[1] https://release-plz.dev/docs/config  \n[2] https://release-plz.dev/docs/extra/single-changelog\n\n---\n\n\n\n</details>\n\n`@MikeFalcon77`, you're absolutely right—I apologize for the incorrect comment.\n\nThe `changelog_path` setting **can** be used in the `[workspace]` section for the **single workspace changelog** feature. This is explicitly documented in the [release-plz \"Single changelog\" guide](https://release-plz.dev/docs/extra/single-changelog), which shows exactly what you're doing:\n\n```toml\n[workspace]\nchangelog_path = \"./CHANGELOG.md\"\n```\n\nThe confusion came from the main configuration reference, which states that the *per-package* `changelog_path` cannot be set in `[workspace]`. However, there's a separate feature for maintaining one shared changelog for the entire workspace, which is configured at the workspace level.\n\nYour configuration is correct for maintaining a single `CHANGELOG.md` at the repository root that release-plz will update with changes from all publishable crates.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: MikeFalcon77\nRepo: hypernetix/hyperspot PR: 303\nFile: release-plz.toml:1-12\nTimestamp: 2026-01-23T16:39:59.174Z\nLearning: In release-plz configuration, `changelog_path` can be set in the `[workspace]` section to enable a single workspace-wide changelog (documented at https://release-plz.dev/docs/extra/single-changelog). This is distinct from per-package changelogs, where `changelog_path` must be set in `[[package]]` sections.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: CR\nRepo: hypernetix/hyperspot PR: 0\nFile: dylint_lints/AGENTS.md:0-0\nTimestamp: 2026-01-14T17:18:31.912Z\nLearning: Applies to dylint_lints/**/Cargo.toml : In `Cargo.toml` for lint crates, reference common workspace dependencies (`clippy_utils`, `dylint_linting`, `lint_utils`) using `.workspace = true` to avoid duplication\n```\n\n---\n\n```\nLearnt from: CR\nRepo: hypernetix/hyperspot PR: 0\nFile: dylint_lints/AGENTS.md:0-0\nTimestamp: 2026-01-14T17:18:31.912Z\nLearning: Applies to dylint_lints/**/Cargo.toml : Register new lint crates by adding them to the `members` list in the workspace root `Cargo.toml`\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-23T16:40:07Z","updated_at":"2026-01-23T16:40:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2722003473","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2722003473"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/303#discussion_r2722003473"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2722003473/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":12,"original_line":12,"side":"RIGHT","in_reply_to_id":2721315170,"author_association":"CONTRIBUTOR","original_position":12,"position":12,"subject_type":"line"}],"source_reviews":[{"id":3697634974,"node_id":"PRR_kwDOPaLyBs7cZW6e","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 4**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (2)</summary><blockquote>\n> \n> <details>\n> <summary>apps/hyperspot-server/src/registered_modules.rs (1)</summary><blockquote>\n> \n> `32-37`: **Duplicate import: `tenant_resolver_gw` is already imported unconditionally.**\n> \n> `tenant_resolver_gw` is imported unconditionally at line 9, making this conditional import redundant when the `tenant-resolver-example` feature is enabled. The crate will already be linked regardless of this feature flag.\n> \n> \n> \n> <details>\n> <summary>Proposed fix</summary>\n> \n> ```diff\n>  #[cfg(feature = \"tenant-resolver-example\")]\n>  use contoso_tr_plugin as _;\n>  #[cfg(feature = \"tenant-resolver-example\")]\n>  use fabrikam_tr_plugin as _;\n> -#[cfg(feature = \"tenant-resolver-example\")]\n> -use tenant_resolver_gw as _;\n> ```\n> \n> </details>\n> \n> </blockquote></details>\n> <details>\n> <summary>apps/hyperspot-server/Cargo.toml (1)</summary><blockquote>\n> \n> `16-40`: **Rename optional dependency to resolve normalized name collision.**\n> \n> Both `tenant-resolver-gw` (line 40) and `tenant_resolver_gw` (line 66) normalize to `tenant_resolver_gw`, creating a collision. Rename the optional example dependency to avoid Cargo's name normalization conflict.\n> \n> <details>\n> <summary>🔧 Required changes</summary>\n> \n> **apps/hyperspot-server/Cargo.toml:**\n> - Line 17: Change `\"dep:tenant_resolver_gw\"` to `\"dep:tenant_resolver_gw_example\"`\n> - Line 66: Change `tenant_resolver_gw` to `tenant_resolver_gw_example`\n> \n> **apps/hyperspot-server/src/registered_modules.rs:**\n> - Line 37: Change `use tenant_resolver_gw as _;` to `use tenant_resolver_gw_example as _;`\n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn @.github/workflows/release-plz.yml:\n- Around line 40-42: The workflow uses a mutable tag for the release step\n(\"release-plz release-pr\") referencing release-plz/action@v0.5; replace the tag\nwith the specific commit SHA recommended by release-plz (pin the action to a\ncommit) so the step uses release-plz/action@<COMMIT_SHA> instead of `@v0.5`—update\nboth occurrences if present to match other actions' SHA pinning and keep the\nstep name \"release-plz release-pr\" unchanged.\n\nIn `@docs/releasing.md`:\n- Line 34: Update the wording to distinguish filesystem paths from package\nnames: change the reference from \"libs/cf-modkit*\" to \"libs/modkit-*\"\n(filesystem directories) and note that the \"cf-\" prefix is used in Cargo package\nnames in Cargo.toml (e.g., package.name = \"cf-modkit-*\"); keep the guidance that\nthese crates share a single version via version.workspace = true and the root\n[workspace.package] version in Cargo.toml.\n\nIn `@modules/system/nodes_registry/nodes_registry-sdk/Cargo.toml`:\n- Line 2: The package name in the Cargo.toml currently uses mixed punctuation\n(`cf-nodes_registry-sdk`); update the package name to use hyphens consistently\n(rename to `cf-nodes-registry-sdk`) in the Cargo.toml package name field so it\nmatches the `cf-*` naming convention used elsewhere (ensure any workspace or\ndependency references to `cf-nodes_registry-sdk` are also updated to the new\n`cf-nodes-registry-sdk`).\n\nIn `@release-plz.toml`:\n- Around line 1-12: The workspace-level changelog_path setting is invalid;\nremove the changelog_path = \"CHANGELOG.md\" entry from the [workspace] section\nand, if a package-specific changelog is required, add changelog_path under the\ncorresponding [[package]] blocks instead (or rely on release-plz's default\nrepo-root behavior); keep changelog_update, git_release_enable, and semver_check\nin [workspace] as-is and ensure no other workspace keys reference\nchangelog_path.\n```\n\n</details>\n\n<details>\n<summary>♻️ Duplicate comments (2)</summary><blockquote>\n\n<details>\n<summary>modules/system/tenant_resolver/plugins/single_tenant_tr_plugin/src/module.rs (1)</summary><blockquote>\n\n`6-6`: **Same tenant_resolver_sdk migration verification as earlier.**\n\n</blockquote></details>\n<details>\n<summary>examples/modkit/users_info/users_info/src/domain/service/cities.rs (1)</summary><blockquote>\n\n`9-9`: **Same tenant_resolver_sdk migration verification as earlier.**\n\n</blockquote></details>\n\n</blockquote></details>\n\n<details>\n<summary>🧹 Nitpick comments (3)</summary><blockquote>\n\n<details>\n<summary>examples/plugin-modules/tenant_resolver/tenant_resolver-gw/Cargo.toml (1)</summary><blockquote>\n\n`15-16`: **Consider adding version specifiers for consistency.**\n\nWhile `publish = false` means this crate won't be published, the PR objectives mention adding `version = ...` entries for intra-workspace path dependencies. The `tenant-resolver-sdk` and `types-registry-sdk` dependencies here lack version specifiers.\n\nThis isn't blocking since the crate is unpublishable, but adding versions would maintain consistency with the stated PR goals and make the dependency graph more explicit.\n\n</blockquote></details>\n<details>\n<summary>modules/system/nodes_registry/nodes_registry/Cargo.toml (1)</summary><blockquote>\n\n`1-9`: **Consider adding missing workspace metadata fields.**\n\nThis manifest only inherits `edition` and `license` from the workspace, whereas other module manifests (e.g., `modules/file_parser/Cargo.toml`) also inherit `authors`. For consistency and to ensure proper crates.io metadata, consider adding `authors.workspace = true` (and optionally `repository.workspace = true`, `rust-version.workspace = true` if applicable).\n\n<details>\n<summary>Suggested addition</summary>\n\n```diff\n [package]\n name = \"cf-nodes_registry\"\n version = \"0.1.0\"\n edition.workspace = true\n license.workspace = true\n+authors.workspace = true\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/system/module_orchestrator/Cargo.toml (1)</summary><blockquote>\n\n`1-11`: **Address naming convention inconsistency across `cf-*` packages.**\n\nThe workspace has mixed naming conventions for `cf-*` packages: `cf-module_orchestrator` uses underscores, while most newer packages use hyphens exclusively (e.g., `cf-tenant-resolver-sdk`, `cf-types-registry-sdk`). Five other packages also use the underscore pattern: `cf-file_parser`, `cf-api_gateway`, `cf-grpc_hub`, `cf-nodes_registry`, and `cf-nodes_registry-sdk`. \n\nAlign all `cf-*` packages to a single convention:\n- Standardize to `cf-module-orchestrator` (hyphens, preferred for crates.io)\n- Or document why underscore packages differ and keep intentionally separate\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/303#pullrequestreview-3697634974","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/303#pullrequestreview-3697634974"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/303"}},"submitted_at":"2026-01-23T14:00:30Z","commit_id":"76e998087fa6cfc7abfef3b99ce42d6c55b410f2"}]},{"source_pr_number":301,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/301","source_state":"closed","source_author":"KvizadSaderah","target_issue_number":null,"title":"[PR #301] feat(fuzz): integrate ClusterFuzzLite continuous fuzzing","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feat/clusterfuzzlite-fuzzing","pr_head_sha":"9ef0561564fdd44fddb3844c7c2f21201ac52940","pr_base_ref":"main","pr_head_owner":"KvizadSaderah","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","id":3203033766,"node_id":"PR_kwDOPaLyBs6-6mqm","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/301.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/301.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/301","number":301,"state":"closed","locked":false,"title":"feat(fuzz): integrate ClusterFuzzLite continuous fuzzing","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\nImplements ClusterFuzzLite continuous fuzzing infrastructure for HyperSpot.\n\nCloses #269\n\n## Changes\n- Add cargo-fuzz infrastructure with 8 fuzz targets for critical parsers\n- Add ClusterFuzzLite GitHub Actions workflow (PR: 10min, main: 1hr)\n- Integrate fuzzing into Makefile and scripts/ci.py\n- Update documentation\n\n## Fuzz Targets\n| Target | Priority | Description |\n|--------|----------|-------------|\n| fuzz_odata_filter | HIGH | OData $filter query parser |\n| fuzz_odata_cursor | HIGH | Pagination cursor decoder |\n| fuzz_yaml_config | HIGH | YAML configuration parser |\n| fuzz_html_parser | MEDIUM | HTML document parser |\n| fuzz_pdf_parser | MEDIUM | PDF document parser |\n| fuzz_json_config | MEDIUM | JSON parser |\n| fuzz_odata_orderby | MEDIUM | $orderby token parser |\n| fuzz_markdown_parser | LOW | Markdown parser |\n\n## Testing\n- `make fuzz-build` - builds all targets\n- `make fuzz-list` - lists 8 targets  \n- `make fuzz` - runs smoke test (30s each)\n- Local fuzzing verified: 7790 runs, 0 crashes\n\n## Checklist\n- [x] Code follows project conventions\n- [x] DCO sign-off included\n- [x] Documentation updated\n- [x] Local testing passed\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added fuzzing support with local fuzz targets, CLI and Makefile commands for build/list/run/smoke/corpus, and multiple fuzz harnesses for OData components.\n\n* **Documentation**\n  * Added a dedicated fuzzing guide and README; updated CONTRIBUTING and main README with fuzzing instructions.\n\n* **Tests**\n  * Enabled PR-based CI fuzzing with sanitizer-enabled runs, crash reporting, and artifact uploads.\n\n* **Chores**\n  * Added CI/tooling configs, toolchain settings, and ignore rules to support fuzzing.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-23T11:56:13Z","updated_at":"2026-01-28T18:41:10Z","closed_at":"2026-01-28T18:41:10Z","merged_at":"2026-01-28T18:41:10Z","merge_commit_sha":"47b4cfb404377256c31d1f180b577ff03e731e00","assignees":[],"requested_reviewers":[{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/301/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/9ef0561564fdd44fddb3844c7c2f21201ac52940","head":{"label":"KvizadS
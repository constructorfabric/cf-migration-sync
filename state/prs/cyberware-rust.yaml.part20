ssues/comments/3798277499/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2721113798","pull_request_review_id":3697379863,"id":2721113798,"node_id":"PRRC_kwDOPaLyBs6iMObG","diff_hunk":"@@ -509,4 +537,105 @@ mod tests {\n             .expect(\"should list instances\");\n         assert_eq!(instances.len(), 0);\n     }\n+\n+    mod send_terminate_signal_tests {\n+        use super::*;\n+\n+        #[cfg(unix)]\n+        #[tokio::test]\n+        async fn test_send_terminate_signal_to_valid_process() {\n+            // Spawn a long-running process\n+            #[cfg(not(windows))]\n+            let binary = PathBuf::from(\"/bin/sleep\");\n+\n+            let mut cmd = tokio::process::Command::new(binary);\n+            cmd.arg(\"30\"); // Sleep for 30 seconds\n+\n+            let mut child = cmd.spawn().expect(\"should spawn test process\");\n+\n+            // Send termination signal\n+            let result = send_terminate_signal(&child);\n+\n+            // Should return true indicating signal was sent\n+            assert!(result, \"Should successfully send SIGTERM to valid process\");\n+\n+            // Wait briefly for graceful shutdown\n+            let _ = tokio::time::timeout(Duration::from_millis(100), child.wait()).await;\n+\n+            // Clean up if still running\n+            let _ = child.kill().await;\n+        }\n+\n+        #[cfg(unix)]\n+        #[tokio::test]\n+        async fn test_send_terminate_signal_to_exited_process() {\n+            // Spawn a process that exits immediately\n+            #[cfg(not(windows))]\n+            let binary = PathBuf::from(\"/bin/true\");\n+\n+            let mut cmd = tokio::process::Command::new(binary);\n+            let mut child = cmd.spawn().expect(\"should spawn test process\");\n+\n+            // Wait for it to exit\n+            let _ = child.wait().await;\n+\n+            // Try to send termination signal to exited process\n+            let result = send_terminate_signal(&child);\n+\n+            // Should return false because PID is no longer available\n+            assert!(!result, \"Should return false for already-exited process\");\n+        }\n+\n+        #[cfg(windows)]\n+        #[tokio::test]\n+        async fn test_send_terminate_signal_windows_always_returns_false() {","path":"libs/modkit/src/backends/local.rs","commit_id":"a28fc24fea4b47e95ecdf2465903afaae76038ce","original_commit_id":"a28fc24fea4b47e95ecdf2465903afaae76038ce","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Let's remove it from unit tests. It ma be fragile and slow on different OSes","created_at":"2026-01-23T13:02:51Z","updated_at":"2026-01-23T13:03:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/300#discussion_r2721113798","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/300","_links":{"self":{"href":"https://a
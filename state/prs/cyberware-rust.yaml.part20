     \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"pptx\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_pptx_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let config = ParserConfig::builder()\n+        .extract_images(false)\n+        .include_slide_comment(false)\n+        .build();\n+\n+    let mut container = PptxContainer::open(path, config)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open PPTX: {e}\")))?;\n+\n+    let slides = container\n+        .parse_all()\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse PPTX slides: {e}\")))?;\n+\n+    Ok(extract_blocks_from_slides(&slides))\n+}\n+\n+fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n+    // pptx-to-md requires a file path, so we need to use a temp file\n+    let mut temp_file = tempfile::NamedTempFile::new()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n+\n+    std::io::Write::write_all(&mut temp_file, bytes)","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It may not work in Windows. \n1. You create file\n2. Write to it\n3. Open it again for reading. Windows doesn't allow it. Also not all data may be written due buffering.\n\nyou need to do something like (https://docs.rs/tempfile/latest/tempfile/struct.TempPath.html):\n```Rust\ntemp_file .flush()?;\nlet path = temp_file.into_temp_path();\n```","created_at":"2026-01-27T10:49:00Z","updated_at":"2026-01-27T10:49:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731409839","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731409839"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731409839"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731409839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":157,"original_line":115,"side":"RIGHT","author_association":"MEMBER","original_position":115,"position":157,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193484","pull_request_review_id":3716170888,"id":2736193484,"node_id":"PRRC_kwDOPaLyBs6jFv_M","diff_hunk":"@@ -0,0 +1,479 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// Excel file format variants\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum ExcelFormat {\n+    /// Legacy Excel format (.xls)\n+    Xls,\n+    /// Excel Open XML format (.xlsx)\n+    Xlsx,\n+    /// Excel Open XML Macro-Enabled format (.xlsm)\n+    Xlsm,\n+    /// Excel Binary format (.xlsb)\n+    Xlsb,\n+}\n+\n+/// OLE Compound Document magic bytes (used by .xls)\n+const OLE_MAGIC: [u8; 4] = [0xD0, 0xCF, 0x11, 0xE0];\n+/// ZIP archive magic bytes (used by .xlsx, .xlsm, .xlsb)\n+const ZIP_MAGIC: [u8; 4] = [0x50, 0x4B, 0x03, 0x04];\n+\n+impl ExcelFormat {\n+    /// Determine format from filename extension (used as hint for MIME type)\n+    #[must_use]\n+    pub fn from_filename(filename: &str) -> Self {\n+        let ext = filename.rsplit('.').next().unwrap_or(\"\").to_lowercase();\n+        match ext.as_str() {\n+            \"xls\" => Self::Xls,\n+            \"xlsm\" => Self::Xlsm,\n+            \"xlsb\" => Self::Xlsb,\n+            _ => Self::Xlsx,\n+        }\n+    }\n+\n+    /// Detect format from file magic bytes\n+    /// Returns None if the bytes don't match any known Excel format\n+    #[must_use]\n+    pub fn from_magic_bytes(bytes: &[u8]) -> Option<Self> {\n+        if bytes.len() < 4 {\n+            return None;\n+        }\n+\n+        let magic: [u8; 4] = [bytes[0], bytes[1], bytes[2], bytes[3]];\n+\n+        if magic == OLE_MAGIC {\n+            // OLE format = legacy XLS\n+            Some(Self::Xls)\n+        } else if magic == ZIP_MAGIC {\n+            // ZIP-based format (xlsx, xlsm, or xlsb)\n+            // All three share the same magic bytes; we'll try parsers in order\n+            Some(Self::Xlsx)\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Get the MIME type for this format\n+    #[must_use]\n+    pub const fn mime_type(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"application/vnd.ms-excel\",\n+            Self::Xlsx => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+            Self::Xlsm => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+            Self::Xlsb => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        }\n+    }\n+\n+    /// Get the file extension for this format (without dot)\n+    #[must_use]\n+    pub const fn extension(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"xls\",\n+            Self::Xlsx => \"xlsx\",\n+            Self::Xlsm => \"xlsm\",\n+            Self::Xlsb => \"xlsb\",\n+        }\n+    }\n+\n+    /// Get all supported file extensions\n+    #[must_use]\n+    pub const fn all_extensions() -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    /// Get the default format\n+    #[must_use]\n+    pub const fn default() -> Self {\n+        Self::Xlsx\n+    }\n+\n+    /// Get the default extension\n+    #[must_use]\n+    pub const fn default_extension() -> &'static str {\n+        Self::default().extension()\n+    }\n+}\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        ExcelFormat::all_extensions()\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let default_filename = format!(\"unknown.{}\", ExcelFormat::default_extension());\n+        let filename = path\n+            .file_name()\n+            .and_then(|s| s.to_str())\n+            .unwrap_or(&default_filename);\n+        let format = ExcelFormat::from_filename(filename);\n+        let content_type = format.mime_type();\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let default_filename = format!(\"unknown.{}\", ExcelFormat::default_extension());\n+        let filename = filename_hint.unwrap_or(&default_filename).to_owned();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let format = ExcelFormat::from_filename(&filename);\n+        let content_type = format.mime_type();\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"8789539b6c8231d5e8b1d8fbc9632030b43189ae","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\nfind . -type f -name \"*.rs\" | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1494\n\n---\n\n🏁 Script executed:\n\n```shell\ncd modules/file_parser && git ls-files | grep -E \"(xlsx|parser)\" | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 474\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/file_parser/src/infra/parsers/xlsx_parser.rs | head -50\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1995\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"struct ExcelFormat|impl ExcelFormat\" modules/file_parser/src/ -A 5\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 650\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"from_magic_bytes\" modules/file_parser/src/\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1331\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/file_parser/src/infra/parsers/xlsx_parser.rs | sed -n '163,193p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1388\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/file_parser/src/infra/parsers/xlsx_parser.rs | sed -n '40,80p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1704\n\n---\n\n\n\n</details>\n\n**Use magic bytes to determine format, falling back to filename only when detection fails.**\n\nThe current implementation determines the Excel format solely from the filename extension, ignoring both the actual file bytes and the provided `content_type` parameter. This creates a risk of content type drift when `filename_hint` is missing or incorrect. \n\nThe `ExcelFormat::from_magic_bytes()` method already exists and is tested; it should be called first to detect format from the file's actual magic bytes (OLE for .xls, ZIP for .xlsx/.xlsm/.xlsb), with fallback to `from_filename()` only if magic byte detection returns `None`.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-        let blocks =\n+        let format = ExcelFormat::from_magic_bytes(bytes.as_ref())\n+            .unwrap_or_else(|| ExcelFormat::from_filename(&filename));\n+\n+        let blocks =\n             tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n                 parse_spreadsheet_from_bytes(&bytes)\n             })\n             .await\n             .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n \n-        let format = ExcelFormat::from_filename(&filename);\n         let content_type = format.mime_type();\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs` around lines 163 - 193,\nDetect the Excel format from the actual file bytes first using\nExcelFormat::from_magic_bytes(bytes.as_ref()) and only fall back to\nExcelFormat::from_filename(&filename) when that returns None; then use the\nresulting format for content_type (format.mime_type()) and any other\nformat-dependent behavior. Update parse_bytes (and the local filename/default\nlogic remains) to call from_magic_bytes with the bytes slice, assign let format\n= magic_format.unwrap_or_else(|| ExcelFormat::from_filename(&filename)), and\nproceed to set content_type and build the DocumentBuilder from that format.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit d3c17f3","created_at":"2026-01-28T11:25:48Z","updated_at":"2026-01-28T12:11:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736193484","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193484"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736193484"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193484/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":122,"original_start_line":163,"start_side":"RIGHT","line":151,"original_line":193,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":193,"position":151,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193487","pull_request_review_id":3716170888,"id":2736193487,"node_id":"PRRC_kwDOPaLyBs6jFv_P","diff_hunk":"@@ -0,0 +1,193 @@\n+\"\"\"E2E tests for file_parser XLSX and PPTX support.\"\"\"\n+import httpx\n+import pytest\n+from pathlib import Path\n+\n+\n+def get_testdata_dir():\n+    \"\"\"Get the testdata directory path.\"\"\"\n+    return Path(__file__).parent.parent.parent / \"testdata\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_xlsx_upload_simple(base_url, auth_headers):\n+    \"\"\"Test uploading a simple XLSX file.\"\"\"\n+    xlsx_file = get_testdata_dir() / \"xlsx\" / \"simple_data.xlsx\"\n+\n+    if not xlsx_file.exists():\n+        pytest.skip(f\"Test file not found: {xlsx_file}\")\n+\n+    with open(xlsx_file, \"rb\") as f:\n+        file_content = f.read()\n+\n+    async with httpx.AsyncClient(timeout=30.0) as client:\n+        response = await client.post(\n+            f\"{base_url}/file-parser/v1/upload\",\n+            params={\"render_markdown\": \"true\", \"filename\": \"simple_data.xlsx\"},\n+            headers={**auth_headers, \"Content-Type\": \"application/octet-stream\"},\n+            content=file_content\n+        )\n+\n+    assert response.status_code == 200, f\"Upload failed: {response.text}\"\n+\n+    data = response.json()\n+    assert \"document\" in data\n+    assert \"markdown\" in data\n+\n+    document = data[\"document\"]\n+    assert document[\"meta\"][\"original_filename\"] == \"simple_data.xlsx\"\n+    assert \"spreadsheetml\" in document[\"meta\"][\"content_type\"]\n+\n+    # Should have blocks (heading for sheet + table)\n+    assert len(document[\"blocks\"]) > 0","path":"testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"8789539b6c8231d5e8b1d8fbc9632030b43189ae","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coder
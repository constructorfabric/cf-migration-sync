ple-user-settings-sdk\"\n version = \"0.1.0\"\n+publish = false\n edition.workspace = true\n license.workspace = true\n authors.workspace = true\n description = \"SDK for simple-user-settings module: API trait, types, and error definitions\"\n+repository.workspace = true\n+readme = \"README.md\"\n+keywords = [\"cyberfabric\", \"cyberfabric-system\"]\n+categories = [\"web-programming\", \"settings\"]","path":"modules/simple_user_settings/simple_user_settings_sdk/Cargo.toml","commit_id":"fdcf42c2ed8d2856e850680efa0573fff1c7e92c","original_commit_id":"bf70e87a87e2606b231c9efa518bd1a07272434e","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@MikeFalcon77`, understood! Would you like me to create a GitHub issue to track this directory rename so it doesn't get lost?\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: CR\nRepo: hypernetix/hyperspot PR: 0\nFile: dylint_lints/AGENTS.md:0-0\nTimestamp: 2026-01-14T17:18:31.912Z\nLearning: Applies to dylint_lints/**/Cargo.toml : In `Cargo.toml` for lint crates, reference common workspace dependencies (`clippy_utils`, `dylint_linting`, `lint_utils`) using `.workspace = true` to avoid duplication\n```\n\n---\n\n```\nLearnt from: Artifizer\nRepo: hypernetix/hyperspot PR: 314\nFile: modules/system/types_registry/types_registry/Cargo.toml:18-18\nTimestamp: 2026-01-26T20:17:53.124Z\nLearning: In Rust workspace modules, the naming convention follows \"module_name-suffix\" pattern where module_name uses snake_case and suffix (like \"sdk\", \"gw\") is separated by a hyphen. Example: types_registry-sdk, simple_user_settings-sdk.\n```\n\n---\n\n```\nLearnt from: Artifizer\nRepo: hypernetix/hyperspot PR: 314\nFile: modules/system/tenant_resolver/plugins/static_tr_plugin/Cargo.toml:18-18\nTimestamp: 2026-01-26T20:17:54.827Z\nLearning: In the hyperspot repository, the naming convention for SDK subdirectories is \"module_name\" + \"-<suffix>\" (e.g., types_registry-sdk, not types_registry_sdk). Module directories use snake_case, but suffixes like \"-sdk\" use a hyphen separator.\n```\n\n---\n\n```\nLearnt from: Artifizer\nRepo: hypernetix/hyperspot PR: 314\nFile: modules/system/tenant_resolver/tenant_resolver-gw/Cargo.toml:18-18\nTimestamp: 2026-01-26T20:17:35.744Z\nLearning: In the hypernetix/hyperspot repository, the naming convention for module paths and directory names is: `module_name-suffix` where `module_name` uses snake_case and suffixes (like `-sdk`, `-gw`) are separated by hyphens. For example: `types_registry-sdk`, `tenant_resolver-sdk`, `simple_user_settings_sdk`.\n```\n\n---\n\n```\nLearnt from: CR\nRepo: hypernetix/hyperspot PR: 0\nFile: modules/simple_user_settings/openspec/AGENTS.md:0-0\nTimestamp: 2026-01-26T20:17:56.723Z\nLearning: Applies to modules/simple_user_settings/openspec/openspec/changes/*/specs/*/spec.md : Use ADDED for new capabilities or sub-capabilities that can stand alone; use MODIFIED for changes to behavior, scope, or acceptance criteria of existing requirements\n```\n\n---\n\n```\nLearnt from: CR\nRepo: hypernetix/hyperspot PR: 0\nFile: modules/simple_user_settings/openspec/AGENTS.md:0-0\nTimestamp: 2026-01-26T20:17:56.723Z\nLearning: Applies to modules/simple_user_settings/openspec/openspec/changes/*/proposal.md : In proposal.md, document why the change is needed, what changes, and impact including affected specs and code\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-27T08:07:54Z","updated_at":"2026-01-27T08:07:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/315#discussion_r2730749134","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/315","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730749134"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/315#discussion_r2730749134"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/315"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730749134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":12,"original_line":12,"side":"RIGHT","in_reply_to_id":2729905810,"author_association":"CONTRIBUTOR","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730749529","pull_request_review_id":3709680916,"id":2730749529,"node_id":"PRRC_kwDOPaLyBs6iw-5Z","diff_hunk":"@@ -6,8 +6,10 @@ license.workspace = true\n authors.workspace = true\n repository.workspace = true\n description = \"Directory service SDK module\"\n+readme = \"README.md\"\n rust-version.workspace = true\n keywords = [\"cyberfabric\", \"cyberfabric-system\"]\n+categories = [\"directory-service\"]","path":"libs/system-sdks/sdks/di
vacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"ADR lint now runs only on pull requests.\n\nOn push we cannot reliably detect PR metadata or labels, so skipping runs for release-plz merges is not possible there.\nRunning the lint at PR time gives the right signal before merge and avoids noisy post-merge runs that do not add value.","created_at":"2026-01-27T01:33:12Z","updated_at":"2026-01-27T01:33:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/315#discussion_r2729893936","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/315","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729893936"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/315#discussion_r2729893936"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/315"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729893936/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":4,"original_line":4,"side":"LEFT","author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729894316","pull_request_review_id":3708730486,"id":2729894316,"node_id":"PRRC_kwDOPaLyBs6ituGs","diff_hunk":"@@ -11,8 +11,7 @@ on:\n   # https://github.com/ossf/scorecard/blob/main/docs/checks.md#maintained\n   schedule:\n     - cron: '32 2 * * 0'\n-  push:","path":".github/workflows/scorecard.yml","commit_id":"fdcf42c2ed8d2856e850680efa0573fff1c7e92c","original_commit_id":"bf70e87a87e2606b231c9efa518bd1a07272434e","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.g
l":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Add comprehensive documentation for the unified error handling system:\r\n- GTS_ERRORS.md: Global Type System (GTS) error handling guidelines\r\n- UNIFIED_ERROR_SYSTEM.md: Detailed design for standardized error handling\r\n\r\nThese docs establish patterns for RFC 9457 Problem Details and consistent error responses across modules.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **Documentation**\n  * Added a Unified Error System: PRD, detailed technical design, migration plan, examples, operational guidance, and rollout phases for standardized REST errors.\n  * Published ADRs adopting RFC 9457 Problem Details, GTS-based error identifiers, a macro-driven error-definition approach, and a security-first disclosure model.\n  * Added an error catalog mapping standardized error types to categories, HTTP/gRPC mappings, status codes, and trace_id/metadata guidance.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-21T10:25:55Z","updated_at":"2026-03-12T10:19:00Z","closed_at":"2026-03-12T10:19:00Z","merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabri
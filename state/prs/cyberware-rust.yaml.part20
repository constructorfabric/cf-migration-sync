 params construction in the test (the params variable in\nlibs/modkit-db/tests/sqlite/manager.rs) and replace the \"WAL\" key with\n\"journal_mode\" and value \"WAL\" so the WAL journal mode is actually applied.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-20T22:00:20Z","updated_at":"2026-01-20T22:00:21Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/284#discussion_r2710223739","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/284","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710223739"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/284#discussion_r2710223739"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/284"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710223739/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":113,"original_start_line":113,"start_side":"RIGHT","line":118,"original_line":118,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":118,"position":118,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710223750","pull_request_review_id":3684481837,"id":2710223750,"node_id":"PRRC_kwDOPaLyBs6hiruG","diff_hunk":"@@ -0,0 +1,180 @@\n+use modkit_db::{DbConnConfig, DbEngine, PoolCfg, build_db_handle};\n+use std::collections::HashMap;\n+use std::time::Duration;\n+use tempfile::TempDir;\n+\n+#[test]\n+fn test_build_db_handle_env_expansion() {\n+    temp_env::with_var(\"TEST_DB_PASSWORD\", Some(\"secret123\"), || {\n+        let rt = tokio::runtime::Builder::new_current_thread()\n+            .enable_all()\n+            .build()\n+            .unwrap();\n+        rt.block_on(async {\n+            let config = DbC
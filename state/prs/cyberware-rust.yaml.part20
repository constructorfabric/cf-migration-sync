ts module\nrg -n \"struct ParsedFilter\" --type rust\ncat -n libs/modkit-odata/src/limits.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 6504\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Read ParsedFilter struct definition and search for MAX_NODES\nsed -n '608,630p' libs/modkit-odata/src/lib.rs\nrg -n \"MAX_NODES\\|node_count\" --type rust -B 2 -A 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 562\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Read the full fuzz target\ncat -n fuzz/fuzz_targets/fuzz_odata_filter.rs\n# Check if node_count is used anywhere in fuzz target\nrg -n \"node_count\\|parse_filter_string\" fuzz/fuzz_targets/fuzz_odata_filter.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 608\n\n---\n\n\n\n</details>\n\n**Add complexity guard to fuzz harness before calling `parse_filter_string`.**\n\nThe parser tracks AST node count but never enforces limits. Small, deeply-nested inputs can still trigger expensive parse operations despite the 1KB size cap. Either validate `node_count()` after parsing and skip pathological cases, or add a pre-parse nesting depth check.\n\n<details>\n<summary>🛠️ Example: pre-parse depth cap</summary>\n\n```diff\n     if let Ok(s) = std::str::from_utf8(data) {\n+        let mut depth = 0usize;\n+        for ch in s.chars() {\n+            match ch {\n+                '(' => {\n+                    depth += 1;\n+                    if depth > 64 {\n+                        return;\n+                    }\n+                }\n+                ')' => depth = depth.saturating_sub(1),\n+                _ => {}\n+            }\n+        }\n         // Don't panic on invalid input - this is expected\n         let _ = parse_filter_string(s);\n     }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\nfuzz_target!(|data: &[u8]| {\n    // Limit input size to avoid OOM on pathological inputs\n    if data.len() > 1024 {\n        return;\n    }\n    // Convert bytes to string (may be invalid UTF-8)\n    if let Ok(s) = std::str::from_utf8(data) {\n        let mut depth = 0usize;\n        for ch in s.chars() {\n            match ch {\n                '(' => {\n                    depth += 1;\n                    if depth > 64 {\n                        return;\n                    }\n                }\n                ')' => depth = depth.saturating_sub(1),\n                _ => {}\n            }\n        }\n        // Don't panic on invalid input - this is expected\n        let _ = parse_filter_string(s);\n    }\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@fuzz/fuzz_targets/fuzz_odata_filter.rs` around lines 6 - 15, Add a complexity\nguard to the fuzz harness around parse_filter_string to avoid expensive\npathological inputs: in the fuzz_target before invoking parse_filter_string\neither perform a cheap pre-parse nesting/depth check or parse into an AST and\nimmediately call node_count() and return if it exceeds a safe threshold (e.g.\n1000). Locate the call to parse_filter_string in the fuzz_target and add the\nguard so deeply-nested inputs are skipped (use parse result + node_count() or a\npre-parse depth heuristic) rather than allowing the parser to consume excessive\nresources.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-27T14:00:00Z","updated_at":"2026-01-27T14:00:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149953","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149953"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149953"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149953/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":6,"original_start_line":6,"start_side":"RIGHT","line":15,"original_line":15,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":15,"position":15,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149975","pull_request_review_id":3711368711,"id":2732149975,"node_id":"PRRC_kwDOPaLyBs6i2UzX","diff_hunk":"@@ -0,0 +1,159 @@\n+//! Proc-macro implementation for `#[domain_model]` attribute.\n+//!\n+//! This macro marks structs as domain models and enforces at compile-time\n+//! that all fields are `DomainSafe` (free of infrastructure dependencies).\n+\n+use proc_macro2::TokenStream;\n+use quote::quote;\n+use syn::{DeriveInput, Fields, Type};\n+\n+/// Expands the `#[domain_model]` attribute macro.\n+///\n+/// Generates:\n+/// - `impl DomainSafe for T {}`\n+/// - `impl DomainModel for T {}`\n+/// - Compile-time assertion that all fields implement `DomainSafe`\n+pub fn expand_domain_model(input: &DeriveInput) -> TokenStream {\n+    let name = &input.ident;\n+    let (impl_generics, ty_generics, where_clause) = input.generics.split_for_impl();\n+\n+    // Collect field types for compile-time validation\n+    let field_types: Vec<&Type> = match &input.data {\n+        syn::Data::Struct(data) => match &data.fields {\n+            Fields::Named(fields) => fields.named.iter().map(|f| &f.ty).collect(),\n+            Fields::Unnamed(fields) => fields.unnamed.iter().map(|f| &f.ty).collect(),\n+            Fields::Unit => vec![],\n+        },\n+        syn::Data::Enum(data) => {\n+            // For enums, collect all variant field types\n+            data.variants\n+                .iter()\n+                .flat_map(|v| match &v.fields {\n+                    Fields::Named(fields) => fields.named.iter().map(|f| &f.ty).collect::<Vec<_>>(),\n+                    Fields::Unnamed(fields) => {\n+                        fields.unnamed.iter().map(|f| &f.ty).collect::<Vec<_>>()\n+                    }\n+                    Fields::Unit => vec![],\n+                })\n+                .collect()\n+        }\n+        syn::Data::Union(_) => {\n+            return syn::Error::new_spanned(\n+                name,\n+                \"domain_model cannot be applied to unions\",\n+            )\n+            .to_compile_error();\n+        }\n+    };\n+\n+    // Build the compile-time field validation\n+    let field_assertions = if field_types.is_empty() {\n+        quote! {}\n+    } else {\n+        quote! {\n+            const _: () = {\n+                #[allow(dead_code)]\n+                fn __assert_field_is_domain_safe<T: ::modkit::domain::DomainSafe>() {}\n+\n+                #[allow(dead_code)]\n+                fn __validate_domain_model_fields() {\n+                    #(\n+                        __assert_field_is_domain_safe::<#field_types>();\n+                    )*\n+                }\n+            };\n+        }\n+    };\n+\n+    quote! {\n+        #input\n+\n+        impl #impl_generics ::modkit::domain::DomainSafe for #name #ty_generics #where_clause {}\n+        impl #impl_generics ::modkit::domain::DomainModel for #name #ty_generics #where_clause {}\n+\n+        #field_assertions\n+    }\n+}","path":"libs/modkit-macros/src/domain_model.rs","commit_id":"24a5734aa20105673196c4904f52a84341199147","original_commit_id":"24a5734aa20105673196c4904f52a84341199147","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Find integration/UI tests for the domain_model macro\nfind . -type f -name \"*.rs\" | xargs grep -l \"domain_model.*valid\\|domain_model.*fail\" | head -20\n\n# Look for actual usage of domain_model on generic structs\nrg \"#\\[domain_model\\]\" -A 5 --type=rs | grep -E \"struct|enum\" -A 3\n\n# Check the test fixtures mentioned in the code\nfd \"domain_model.*\\.rs\" --type f | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 369\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look specifically in the modkit-macros test directories\nfind . -path \"*modkit-macros*\" -name \"*.rs\" -type f | head -20\n\n# Check what tests are actually running for this macro\nrg \"test.*domain_model\" --type=rs -B 2 -A 10\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1190\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look at the actual structure of the repository to understand where tests might be\nls -la libs/modkit-macros/ 2>/dev/null || echo \"Directory not found\"\nfind . -path \"*modkit-macros*\" -type d | head -10\n\n# Look for tests directory structure\nfind . -type d -name \"tests\" | head -10\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 912\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check the valid domain model tests\ncat -n ./libs/modkit/tests/ui/domain_model_valid.rs | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1173\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check if there are any generic domain models tested\nrg \"domain_model.*<.*>\" ./libs/modkit/tests -A 5 --type rust\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 2358\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look for generic struct definitions in the domain_model tests\ncat -n ./libs/modkit/tests/ui/domain_model_with_infra_type.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 517\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check if there's a domain_model compile-fail test\nls -la ./libs/modkit-macros/tests/ui/fail/ 2>/dev/null | grep domain\nfind ./libs/modkit-macros/tests -name \"*domain*\"\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for any usage of domain_model macro on generic structs in the entire codebase\nrg \"#\\[domain_model\\]\" -A 3 --type rust | grep -E \"^[0-9-]+.*<[A-Z]\" -A 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look at the unit test more carefully to understand what it's testing\ncat -n ./libs/modkit-macros/src/domain_model.rs | sed -n '145,159p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 569\n\n---\n\n\n\n</details>\n\n**Add end-to-end test for generic domain models.**\n\nThe unit test for `test_expand_generic_struct` (lines 146-158) only verifies the generated code string, not actual compilation. This misses two real issues:\n\n1. For generic structs like `Container<T>`, the const-block assertion `__assert_field_is_domain_safe::<T>()` may reference an out-of-scope type parameter at module level.\n2. The generated `impl<T> DomainSafe for Container<T>` lacks a `T: DomainSafe` bound, potentially allowing `Container<http::StatusCode>` to be incorrectly considered `DomainSafe`.\n\nAdd a UI test with a generic domain model to verify it compiles and enforces constraints correctly (e.g., that generic type parameters must implement `DomainSafe`). Alternatively, document that generic domain models are not currently supported.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-macros/src/domain_model.rs` around lines 16 - 76, The test found\ntwo issues: the field-assertion const block references generic type parameters\nout of scope and the generated impl of DomainSafe lacks required trait bounds on\ntype parameters. Fix expand_domain_model by (1) attaching the struct's generics\nto the validation functions/const block so type params are in scope (use the\nexisting impl_generics when declaring fn __validate_domain_model_fields and the\nconst block, e.g., fn __validate_domain_model_fields#impl_generics() {\n__assert_field_is_domain_safe::<#field_types>(); }) and (2) require each generic\ntype parameter to implement ::modkit::domain::DomainSafe by extending\nimpl_generics/where_clause for the impl of ::modkit::domain::DomainSafe for\n`#name` (so impl `#impl_generics` becomes impl `#impl_generics` where <generic\nparams>: ::modkit::domain::DomainSafe). Ensure you update the generated\nfield_assertions and the impl for ::modkit::domain::DomainSafe accordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-27T14:00:00Z","updated_at":"2026-01-27T14:00:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149975","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149975"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149975"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149975/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":16,"start_side":"RIGHT","line":null,"original_line":76,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":76,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149983","pull_request_review_id":3711368711,"id":2732149983,"node_id":"PRRC_kwDOPaLyBs6i2Uzf","diff_hunk":"@@ -0,0 +1,199 @@\n+//! Domain Layer Marker Traits\n+//!\n+//! This module provides marker traits for enforcing domain-driven design boundaries\n+//! at compile time. Types marked with these traits are guaranteed to be free of\n+//! infrastructure dependencies (sqlx, sea_orm, http, axum, etc.).\n+//!\n+//! # Usage\n+//!\n+//! Use the `#[domain_model]` attribute macro to mark domain types:\n+//!\n+//! ```rust,ignore\n+//! use modkit_macros::domain_model;\n+//!\n+//! #[domain_model]\n+//! pub struct User {\n+//!     pub id: Uuid,\n+//!     pub email: String,\n+//!     pub created_at: DateTime<Utc>,\n+//! }\n+//! ```\n+//!\n+//! The macro will:\n+//! - Implement `DomainSafe` and `DomainModel` for the type\n+//! - Verify at compile-time that all fields are also `DomainSafe`\n+//!\n+//! # Enforcement\n+//!\n+//! Domain services can use trait bounds to ensure they only work with domain-safe types:\n+//!\n+//! ```rust,ignore\n+//! pub trait UserRepository: Send + Sync {\n+//!     type Model: DomainModel;\n+//!     \n+//!     async fn find(&self, id: Uuid) -> Result<Option<Self::Model>>;\n+//! }\n+//! ```\n+\n+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};\n+use uuid::Uuid;\n+\n+/// Marker trait for types that are safe to use in the domain layer.\n+///\n+/// Types implementing this trait are guaranteed to be free of infrastructure\n+/// dependencies such as:\n+/// - Database types (sqlx, sea_orm)\n+/// - HTTP types (http, axum, hyper)\n+/// - Framework-specific types\n+///\n+/// # Implementing\n+///\n+/// Do NOT implement this trait manually. Use the `#[domain_model]` attribute macro\n+/// which performs compile-time validation that all fields are also `DomainSafe`.\n+///\n+/// # Blanket Implementations\n+///\n+/// Common standard library and third-party types have blanket implementations:\n+/// - Primitives: `bool`, `i8`..`i128`, `u8`..`u128`, `f32`, `f64`, `char`, `String`, `&str`\n+/// - Collections: `Vec<T>`, `Option<T>`, `Result<T, E>`, `HashMap<K, V>`, etc.\n+/// - Common crates: `uuid::Uuid`, `chrono::DateTime`, `rust_decimal::Decimal`\n+pub trait DomainSafe {}","path":"libs/modkit/src/domain/mod.rs","commit_id":"24a5734aa20105673196c4904f52a84341199147","original_commit_id":"24a5734aa20105673196c4904f52a84341199147","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# Check for chrono/rust_decimal in Cargo.toml files\nfind . -name 'Cargo.toml' -type f | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1350\n\n---\n\n🏁 Script executed:\n\n```shell\n# Verify whether chrono / rust_decimal are in the dependency graph\nrg -n 'chrono|rust_decimal' --type toml\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3139\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the actual file mentioned in the review\ncat -n libs/modkit/src/domain/mod.rs | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3924\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check for existing DomainSafe impls for these types\nrg -n \"impl\\s+DomainSafe\\s+for\" --type rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 90\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check for all DomainSafe impls with correct syntax\nrg -n \"impl\\s+DomainSafe\\s+for\" -t rust\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1515\n\n---\n\n🏁 Script executed:\n\n```shell\n# Read more of the mod.rs file to see all implementations\ncat -n libs/modkit/src/domain/mod.rs | tail -150\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 6423\n\n---\n\n\n\n</details>\n\n**Docs claim `chrono::DateTime`, `rust_decimal::Decimal`, and `&str` support, but implementations are missing.**\n\nThe documentation (lines 56-59) lists these types as having blanket implementations, but the actual code only implements `str` (not `&str`), `Uuid`, and `serde_json::Value`. Domain models using `chrono::DateTime` or `rust_decimal::Decimal` will fail to compile despite the docs indicating support.\n\nBoth `chrono` and `rust_decimal` are workspace dependencies, so add the feature-gated implementations:\n\n<details>\n<summary>Fix</summary>\n\n```diff\n+impl<'a> DomainSafe for &'a str {}\n+#[cfg(feature = \"chrono\")]\n+impl<Tz: chrono::TimeZone> DomainSafe for chrono::DateTime<Tz> {}\n+#[cfg(feature = \"rust_decimal\")]\n+impl DomainSafe for rust_decimal::Decimal {}\n```\n</details>\n\nAlternatively, update the docs (line 59) to remove unsupported types and update line 57 to remove `&str` (only `str` is implemented).\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n/// Common standard library and third-party types have blanket implementations:\n/// - Primitives: `bool`, `i8`..`i128`, `u8`..`u128`, `f32`, `f64`, `char`, `String`, `&str`\n/// - Collections: `Vec<T>`, `Option<T>`, `Result<T, E>`, `HashMap<K, V>`, etc.\n/// - Common crates: `uuid::Uuid`, `chrono::DateTime`, `rust_decimal::Decimal`\npub trait DomainSafe {}\n\nimpl<'a> DomainSafe for &'a str {}\n#[cfg(feature = \"chrono\")]\nimpl<Tz: chrono::TimeZone> DomainSafe for chrono::DateTime<Tz> {}\n#[cfg(feature = \"rust_decimal\")]\nimpl DomainSafe for rust_decimal::Decimal {}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-27T14:00:00Z","updated_at":"2026-01-27T14:00:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149983","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149983"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149983"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149983/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":56,"start_side":"RIGHT","line":null,"original_line":60,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149991","pull_request_review_id":3711368711,"id":2732149991,"node_id":"PRRC_kwDOPaLyBs6i2Uzn","diff_hunk":"@@ -506,6 +506,151 @@ def cmd_dylint_list(_args):\n         run_cmd([\"cargo\", \"dylint\", \"list\", \"--lib-path\", lib], cwd=PROJECT_ROOT)\n \n \n+def ensure_nightly_toolchain():\n+    \"\"\"Ensure Rust nightly toolchain is installed.\"\"\"\n+    result = run_cmd_allow_fail([\"rustup\", \"run\", \"nightly\", \"rustc\", \"--version\"])\n+    if result.returncode != 0:\n+        print(\n+            \"ERROR: Rust nightly toolchain not installed. \"\n+            \"Install with: rustup toolchain install nightly\"\n+        )\n+        sys.exit(1)\n+\n+\n+def ensure_cargo_fuzz():\n+    \"\"\"Ensure cargo-fuzz is installed.\"\"\"\n+    ensure_nightly_toolchain()\n+    result = run_cmd_allow_fail([\"cargo\", \"+nightly\", \"fuzz\", \"--version\"])\n+    if result.returncode != 0:\n+        print(\"Installing cargo-fuzz...\")\n+        run_cmd([\"cargo\", \"install\", \"cargo-fuzz\"])","path":"scripts/ci.py","commit_id":"2f83e76ca0c63d26c2b41aedb6
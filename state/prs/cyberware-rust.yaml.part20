pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3851590215","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#issuecomment-3851590215","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/282","id":3851590215,"node_id":"IC_kwDOPaLyBs7lkppH","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-05T07:45:41Z","updated_at":"2026-02-05T07:45:41Z","body":"> Let's consider to add:\r\n> \r\n> 1. per-module \"service\" tokens. How to issue? Who configures it?\r\n> 2. per-module \"service\" scoping down to a tenant or user\r\n\r\nGood idea, will do. I'm not 100% sure that we need to expose additional methods in AuthN Resolver for this and perhaps it's enough to support OAuth 2.0 Token Request flow (https://datatracker.ietf.org/doc/html/rfc6749#section-4.4) for S2S tokens, but it definitely should be reflect in AuthN & AuthZ design docs. My suggestion is not blocking on this in this PR and creating a separate issue. @Artifizer are you ok?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3851590215/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3851779397","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#issuecomment-3851779397","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/282","id":3851779397,"node_id":"IC_kwDOPaLyBs7llX1F","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2026-02-05T08:19:00Z","updated_at":"2026-02-05T08:19:00Z","body":"There are unresolved review comments awaiting response.\n\nUnanswered human review threads: 10\nUnresolved comments: 20","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3851779397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":15368,"client_id":"Iv1.05c79e9ad1f6bdfa","slug":"github-actions","node_id":"MDM6QXBwMTUzNjg=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url":"https://api.github.com/users/github/following{/other_user}","gists_url":"https://api.github.com/users/github/gists{/gist_id}","starred_url":"https://api.github.com/users/github/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github/subscriptions","organizations_url":"https://api.github.com/users/github/orgs","repos_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-05-05T14:51:38Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718236635","pull_request_review_id":3694099455,"id":2718236635,"node_id":"PRRC_kwDOPaLyBs6iBP_b","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe it's technically an ADR, it's a design document. \n\nI think that typical ADR must answer the question 'why so', not 'how'\n\n1. The decision (present)\n2. The context that led to it <<< not covered\n3. The alternatives considered <<< not covered\n4. Why this option was chosen <<< not covered\n5. The consequences (trade-offs) <<< not covered\n\nSo that in 6–24 months:\n1. new engineers understand why\n2. reviewers stop re-arguing old topics\n3. architecture does not drift silently\n4. decisions remain explicit and auditable\n\nThis document explains design (partially) and doesn't explain real \"decision\"\n\nIn order to make it ADR, I would:\n\n1. The decision ... \n\n2. Explain the context (the problem), that is:\na. we want modules to follow access check policy as we want them to be 'zero-trust'\nb. we do not want modules to manager access rules as it would be hard to manage it\nc. we also want access policies to be vendor-provided, not hardcoded\nd. we want modules to implement RBAC/ABAC/ReBAC in their APIs\n\n3. Explain what options were reviewed\na. modules parse token claims and implement simple filter by tenant id and some other attributes ...\nb. ...\nc. AuthZEN support\n\n4. Why AuthZEN?\n\n5. The consequences and trade-offs, known (accepted) limitations","created_at":"2026-01-22T19:09:48Z","updated_at":"2026-01-22T19:24:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718236635","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718236635"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718236635"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718236635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718238386","pull_request_review_id":3694099455,"id":2718238386,"node_id":"PRRC_kwDOPaLyBs6iBQay","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0\n+\n+- **Status**: Draft\n+- **Date**: 2026-01-21\n+- **Supersedes**: `modules/system/auth_resolver/docs/ADR.md` (proposed)\n+- **Decision Drivers**: AuthZEN standardization (approved 2026-01-12), vendor-neutral authorization, scalable query-time enforcement, pluggable modular architecture\n+\n+## Table of Contents\n+\n+- [Context](#context)\n+- [Decision](#decision)\n+- [AuthZEN Overview](#authzen-overview)\n+- [AuthZEN Gap Analysis](#authzen-gap-analysis)\n+- [Core Terms](#core-terms)\n+- [Integration Architecture](#integration-architecture)\n+- [API Specifications](#api-specifications)\n+  - [Access Evaluation API (AuthZEN-extended)](#access-evaluation-api-authzen-extended)\n+  - [Filter Types Reference](#filter-types-reference)\n+  - [Capabilities → Filter Matrix](#capabilities--filter-matrix)\n+- [PEP Enforcement](#pep-enforcement)\n+- [Rationale](#rationale)\n+- [Consequences](#consequences)\n+- [Open Questions](#open-questions)\n+\n+---\n+\n+## Context\n+\n+HyperSpot is a pluggable, modular platform intended to be embedded into multi-tenant vendor platforms. Each vendor can have its own identity provider (IdP), authorization model, and tenant service. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+On January 12, 2026, the OpenID Foundation approved [AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html), establishing a standard for authorization APIs. This ADR evaluates adopting AuthZEN as the foundation for HyperSpot's Auth Resolver.\n+\n+**Key requirement not fully addressed by AuthZEN**: HyperSpot modules need to enforce authorization at the **query level** (e.g., SQL WHERE clauses), not just perform point-in-time access checks. For LIST/query operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## Decision\n+\n+We adopt AuthZEN Authorization API 1.0 as the foundation for Auth Resolver, with a **HyperSpot-specific extension** for constraint-based authorization via the extended evaluation response:\n+\n+**Endpoints:**\n+- `POST /access/v1/evaluation` — Single evaluation (AuthZEN-extended)\n+- `POST /access/v1/evaluations` — Batch evaluation (AuthZEN-extended)\n+\n+**Response extension:**\n+- PDP returns `decision` plus optional `context.constraints` when `decision: true`","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"PDP and PEP terms were not introduced yet, I would put terms on top (in the beginning)","created_at":"2026-01-22T19:10:21Z","updated_at":"2026-01-22T19:24:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718238386","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718238386"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718238386"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718238386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":46,"side":"RIGHT","author_association":"MEMBER","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718314710","pull_request_review_id":3694201646,"id":2718314710,"node_id":"PRRC_kwDOPaLyBs6iBjDW","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0\n+\n+- **Status**: Draft","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"ChatGPT comment: \n\nA problem: Policy language becomes a query language\n\nThis is an anti-pattern.\nAuth systems must reason about:  “is subject allowed to access object”\nNot: “generate SQL-compatible filters”.\n\nThis is exactly why Zanzibar / FGA do not return filters.","created_at":"2026-01-22T19:28:30Z","updated_at":"2026-01-22T19:30:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718314710","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718314710"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2718314710"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2718314710/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":3,"side":"RIGHT","author_association":"MEMBER","original_position":3,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2725989242","pull_request_review_id":3704297082,"id":2725989242,"node_id":"PRRC_kwDOPaLyBs6ie0t6","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"sorting breaks even before pagination","created_at":"2026-01-25T22:43:30Z","updated_at":"2026-01-25T22:44:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2725989242","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2725989242"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2725989242"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2725989242/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":114,"side":"RIGHT","author_association":"MEMBER","original_position":114,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726017068","pull_request_review_id":3704317693,"id":2726017068,"node_id":"PRRC_kwDOPaLyBs6ie7gs","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need explicit entities relationship model, incl.\r\n- tenant hierarchy, if supported\r\n- recursive resource groups, if supported\r\n- one member (resource or resource group) to many resource group relations, if supported","created_at":"2026-01-25T23:27:31Z","updated_at":"2026-01-25T23:27:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726017068","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726017068"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726017068"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726017068/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":593,"original_line":153,"side":"RIGHT","author_association":"MEMBER","original_position":153,"position":593,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726032230","pull_request_review_id":3704329522,"id":2726032230,"node_id":"PRRC_kwDOPaLyBs6ie_Nm","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Is Resource Group Owner Tenant missed?\r\nI guess YES, but be aware, that combined with tenant hierarchy, this answer will add complexity:\r\n- can resource owner tenant be a parent of a resource group owner tenant, the resource is a member of?\r\n- what if the tenant path between the resource tenant and resource group tenant has a tenant 'barrier'?\r\n\r\nGenerally, access propagation with resource groups (with tenant ownership) and tenants hierarchy (with tenant 'barriers) should be modelled as graph, acyclic for consistency.\r\nWhether to implement this model in unified way, or have separate closures for tenants and resource groups - is another choice","created_at":"2026-01-25T23:50:50Z","updated_at":"2026-01-25T23:52:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726032230","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726032230"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726032230"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726032230/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":148,"side":"RIGHT","author_association":"MEMBER","original_position":148,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726033038","pull_request_review_id":3704330084,"id":2726033038,"node_id":"PRRC_kwDOPaLyBs6ie_aO","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"'barrier' is not defined, but referenced below","created_at":"2026-01-25T23:51:59Z","updated_at":"2026-01-25T23:51:59Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726033038","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726033038"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726033038"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726033038/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":142,"side":"RIGHT","author_association":"MEMBER","original_position":142,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726038784","pull_request_review_id":3704334494,"id":2726038784,"node_id":"PRRC_kwDOPaLyBs6ifA0A","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |","path":"docs/design/AUTH.md","commit_id":"8c3d6c5bff437a59752efb13d42c9c243225ca9c","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"this literally assumes local projections shared between domain modules, that is not true i guess","created_at":"2026-01-26T00:01:49Z","updated_at":"2026-01-26T00:01:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726038784","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726038784"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726038784"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726038784/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":175,"side":"RIGHT","author_association":"MEMBER","original_position":175,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726040304","pull_request_review_id":3704336150,"id":2726040304,"node_id":"PRRC_kwDOPaLyBs6ifBLw","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |","path":"docs/design/AUTH.md","commit_id":"8c3d6c5bff437a59752efb13d42c9c243225ca9c","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"tenants and resource groups themselves need access check too, need to show its model and flows","created_at":"2026-01-26T00:04:40Z","updated_at":"2026-01-26T00:05:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726040304","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726040304"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726040304"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726040304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":163,"side":"RIGHT","author_association":"MEMBER","original_position":163,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726044458","pull_request_review_id":3704340017,"id":2726044458,"node_id":"PRRC_kwDOPaLyBs6ifCMq","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need to show 'Local Projections' related flows.\r\nThe flows related to a resource groups may not be too trivial: e.g. module with resources of type T may or may not need local resource_group_closure and resource_group_membership to have items for resources != T","created_at":"2026-01-26T00:10:23Z","updated_at":"2026-01-26T00:11:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726044458","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726044458"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726044458"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726044458/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":618,"original_line":219,"side":"RIGHT","author_association":"MEMBER","original_position":219,"position":618,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726051032","pull_request_review_id":3704346961,"id":2726051032,"node_id":"PRRC_kwDOPaLyBs6ifDzY","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"","path":"docs/authorization/AUTH.md","commit_id":"a3347f6f3de3606b4c9a8cb0eed2e3c5109cd52a","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Where it comes from?\r\nNeed to show in the flow above","created_at":"2026-01-26T00:19:02Z","updated_at":"2026-01-26T00:19:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726051032","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726051032"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726051032"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726051032/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":278,"side":"RIGHT","author_association":"MEMBER","original_position":278,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726055766","pull_request_review_id":3704351280,"id":2726055766,"node_id":"PRRC_kwDOPaLyBs6ifE9W","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"","path":"docs/authorization/AUTH.md","commit_id":"a3347f6f3de3606b4c9a8cb0eed2e3c5109cd52a","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Where it comes from (from the resource server API query parameters)?\r\nNeed to show in the flow above","created_at":"2026-01-26T00:25:25Z","updated_at":"2026-01-26T00:25:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726055766","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726055766"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726055766"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726055766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":288,"side":"RIGHT","author_association":"MEMBER","original_position":288,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726062588","pull_request_review_id":3704358066,"id":2726062588,"node_id":"PRRC_kwDOPaLyBs6ifGn8","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{\n+      // Filters within a constraint are AND'd together\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter - uses local tenant_closure table\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+          \"respect_barrier\": true,\n+          \"tenant_status\": [\"active\", \"suspended\"]\n+        },\n+        {\n+          // Simple column equality from resource properties\n+          \"type\": \"field\",","path":"docs/design/AUTH.md","commit_id":"94105f3381edf6a539a0e2988056d53dfad21a19","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The namings used here and in the comments assume the PDP 'knows' the PEP storage 'model'.","created_at":"2026-01-26T00:34:13Z","updated_at":"2026-01-26T00:34:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726062588","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726062588"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726062588"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726062588/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":336,"side":"RIGHT","author_association":"MEMBER","original_position":336,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726065200","pull_request_review_id":3704360528,"id":2726065200,"node_id":"PRRC_kwDOPaLyBs6ifHQw","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{","path":"docs/design/AUTH.md","commit_id":"94105f3381edf6a539a0e2988056d53dfad21a19","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"All the presented 'constraints' look just like an (not evaluated in partial PDP evaluation) access grants - why not use the latter term then?","created_at":"2026-01-26T00:37:28Z","updated_at":"2026-01-26T00:37:29Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726065200","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726065200"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726065200"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726065200/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":323,"side":"RIGHT","author_association":"MEMBER","original_position":323,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726077370","pull_request_review_id":3704372308,"id":2726077370,"node_id":"PRRC_kwDOPaLyBs6ifKO6","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not every (access) policy can be evaluated to access constraints / grants, enforcable on a given PEP: any disclaimers then?","created_at":"2026-01-26T00:51:32Z","updated_at":"2026-01-26T00:51:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726077370","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726077370"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726077370"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726077370/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":150,"side":"RIGHT","author_association":"MEMBER","original_position":150,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726087639","pull_request_review_id":3704382716,"id":2726087639,"node_id":"PRRC_kwDOPaLyBs6ifMvX","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{\n+      // Filters within a constraint are AND'd together\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter - uses local tenant_closure table\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+          \"respect_barrier\": true,\n+          \"tenant_status\": [\"active\", \"suspended\"]\n+        },\n+        {\n+          // Simple column equality from resource properties\n+          \"type\": \"field\",\n+          \"field\": \"resource.topic_id\",\n+          \"op\": \"eq\",\n+          \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+        }\n+      ]\n+    }]\n+  }\n+}\n+```\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-A\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-A\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Filter\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"tenant-A\",\n+          \"respect_barrier\": true\n+        },\n+        {\n+          // Resource group membership with closure - uses resource_group_membership + resource_group_closure tables\n+          \"type\": \"group_membership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"project-root-group\"\n+        }\n+      ]\n+    }]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+## Filter Types Reference\n+\n+The following filter types can appear in the `filters` array. There are **three distinct filter types**, each with specific semantics:\n+\n+| Filter Type | Description | Operations |\n+|-------------|-------------|------------|\n+| `field` | Simple column comparisons on resource properties | `eq`, `in` |\n+| `tenant_ownership` | Tenant hierarchy filtering | `in`, `in_closure` |\n+| `group_membership` | Resource group membership filtering | `in`, `in_closure` |\n+\n+### 1. Field Filter (`type: \"field\"`)\n+\n+Simple operations on resource columns. Filter fields use **logical names** (DSL), not physical column names. PEP maps logical fields to actual database columns.\n+\n+**Schema:**\n+- `type` (required): `\"field\"`\n+- `field` (required): Logical field name in DSL format (`resource.<property>`)\n+- `op` (required): `\"eq\"` | `\"in\"`\n+- `value` (required for `op: eq`): Single value\n+- `values` (required for `op: in`): Array of values\n+\n+```jsonc\n+// Equality\n+{ \"type\": \"field\", \"field\": \"resource.topic_id\", \"op\": \"eq\", \"value\": \"uuid-123\" }\n+// PEP maps resource.topic_id -> topic_id column\n+// SQL: topic_id = 'uuid-123'\n+\n+// IN list\n+{ \"type\": \"field\", \"field\": \"resource.status\", \"op\": \"in\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+**Field naming convention (DSL):**\n+\n+| Prefix | Maps To | Example |\n+|--------|---------|---------|\n+| `resource.<property>` | Resource table column | `resource.topic_id` -> `topic_id` |\n+\n+PEP maintains mapping from logical field names to physical schema. PDP uses only logical names — **it doesn't know the database schema**.\n+\n+### 2. Tenant Ownership Filter (`type: \"tenant_ownership\"`)\n+\n+Filters resources by tenant hierarchy. The tenant column name in the resource table is configured at the module level when setting up the SQL builder (default: `owner_tenant_id`). Different resources may have different tenant columns (e.g., `owner_tenant_id`, `billing_tenant_id`).\n+\n+**Schema:**\n+- `type` (required): `\"tenant_ownership\"`\n+- `op` (required): `\"in\"` | `\"in_closure\"`\n+- `values` (required for `op: in`): Array of tenant IDs\n+- `ancestor_id` (required for `op: in_closure`): Root of tenant subtree\n+- `respect_barrier` (optional for `op: in_closure`): Honor `self_managed` barrier in hierarchy traversal, default `false`\n+- `tenant_status` (optional for `op: in_closure`): Filter by tenant status\n+\n+```jsonc\n+// Explicit tenant IDs\n+{ \"type\": \"tenant_ownership\", \"op\": \"in\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+// Tenant closure (requires local_tenant_closure capability)\n+{\n+  \"type\": \"tenant_ownership\",\n+  \"op\": \"in_closure\",\n+  \"ancestor_id\": \"tenant-A\",\n+  \"respect_barrier\": true,\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"ast2074","id":192745410,"node_id":"U_kgDOC30Pwg","avatar_url":"https://avatars.githubusercontent.com/u/192745410?v=4","gravatar_id":"","url":"https://api.github.com/users/ast2074","html_url":"https://github.com/ast2074","followers_url":"https://api.github.com/users/ast2074/followers","following_url":"https://api.github.com/users/ast2074/following{/other_user}","gists_url":"https://api.github.com/users/ast2074/gists{/gist_id}","starred_url":"https://api.github.com/users/ast2074/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ast2074/subscriptions","organizations_url":"https://api.github.com/users/ast2074/orgs","repos_url":"https://api.github.com/users/ast2074/repos","events_url":"https://api.github.com/users/ast2074/events{/privacy}","received_events_url":"https://api.github.com/users/ast2074/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"What is an expected load volume model?\r\nStarting from ~10+M objects distributed / owned by tenants in tenant hierarchy of ~10+ depth, the usual SELECT ... FROM objects <plus the join like the one in comments> ORDER BY ... LIMIT ... will just not perform well for all possible subject tenants in RDBMS on 'typical' 2026 hw.","created_at":"2026-01-26T01:03:09Z","updated_at":"2026-01-26T01:16:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726087639","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726087639"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2726087639"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2726087639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1065,"original_line":529,"side":"RIGHT","author_association":"MEMBER","original_position":529,"position":1065,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731018113","pull_request_review_id":3710019839,"id":2731018113,"node_id":"PRRC_kwDOPaLyBs6iyAeB","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The original doc was divided into 2 parts: ADR and design doc.","created_at":"2026-01-27T09:13:46Z","updated_at":"2026-01-27T09:13:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2731018113","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731018113"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2731018113"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731018113/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","in_reply_to_id":2718236635,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740592320","pull_request_review_id":3721440726,"id":2740592320,"node_id":"PRRC_kwDOPaLyBs6jWh7A","diff_hunk":"@@ -0,0 +1,1179 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+  - [PDP/PEP Model](#pdppep-model)\n+  - [Request Flow](#request-flow)\n+  - [Auth Resolver: Gateway + Plugin Architecture](#auth-resolver-gateway--plugin-architecture)\n+  - [Integration Architecture](#integration-architecture)\n+  - [Deployment Modes and Trust Model](#deployment-modes-and-trust-model)\n+- [Core Terms](#core-terms)\n+- [Authentication](#authentication)\n+  - [Configuration](#configuration)\n+  - [Token Introspection](#token-introspection)\n+  - [OpenID Connect Integration](#openid-connect-integration)\n+  - [Plugin Role](#plugin-role)\n+  - [Validation](#validation)\n+  - [Introspection Caching](#introspection-caching)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+- [Tenant Model](./TENANT_MODEL.md)\n+- [Usage Scenarios](./SCENARIOS.md)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot integrates with vendor's Identity Provider (IdP) to validate access tokens and extract subject identity.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the Auth Resolver module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the details.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **Auth Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full rationale.\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant AuthN as AuthN Layer<br/>(Gateway)\n+    participant PEP as PEP<br/>(Domain Module)\n+    participant PDP as PDP<br/>(Auth Resolver)\n+    participant DB as Database\n+\n+    Client->>AuthN: Request + Token\n+    AuthN->>AuthN: Validate token, extract claims\n+    AuthN->>PEP: Request + SecurityContext\n+    PEP->>PDP: AuthZ Request<br/>(subject, action, resource, context)\n+    PDP->>PDP: Evaluate policies\n+    PDP-->>PEP: decision + constraints\n+    PEP->>PEP: Compile constraints to SQL\n+    PEP->>DB: Query with WHERE clauses\n+    DB-->>PEP: Filtered results\n+    PEP-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Layer** — validates token, extracts identity → `SecurityContext`\n+2. **PEP** — builds AuthZ request, compiles constraints to SQL\n+3. **PDP** — evaluates policies, returns decision + constraints\n+\n+### Auth Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern:\n+\n+- **Auth Resolver** — a HyperSpot gateway module that defines a unified interface for AuthN/AuthZ operations\n+- **Vendor Plugin** — implements the Auth Resolver interface, integrating with vendor's IdP and Authorization API\n+\n+This allows HyperSpot domain modules (PEPs) to use a consistent API regardless of the vendor's identity and authorization infrastructure. Each vendor develops their own Auth Resolver plugin that bridges to their specific systems.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthResolver[\"Auth Resolver\"]\n+            AuthGW[\"Gateway\"]\n+            AuthPlugin[\"Plugin<br/>(AuthN + PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% Auth Resolver flow\n+    AuthGW --> AuthPlugin\n+    AuthPlugin -->|introspection| IdP\n+    AuthPlugin -->|authz| AuthzSvc\n+    AuthPlugin -.->|tenant hierarchy| TenantGW\n+    AuthPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    Handler -->|token introspection| AuthGW\n+    Handler -->|/access/v1/evaluation| AuthGW\n+    Handler -->|constraints → SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **Handler → Auth Resolver (Gateway)** — PEP calls for token introspection and authorization\n+2. **Auth Resolver (Gateway) → Auth Resolver (Plugin)** — gateway delegates to vendor plugin (handles both AuthN and PDP)\n+3. **Auth Resolver (Plugin) → IdP** — token introspection\n+4. **Auth Resolver (Plugin) → Authz Svc** — authorization decisions\n+5. **Auth Resolver (Plugin) → Tenant Resolver (Gateway)** — tenant hierarchy queries\n+6. **Auth Resolver (Plugin) → RG Resolver (Gateway)** — group hierarchy and membership queries\n+7. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Auth Resolver (PDP) can run in two configurations with different trust models.\n+\n+#### In-Process (Plugin)\n+\n+```\n+┌─────────────────────────────────┐\n+│       HyperSpot Process         │\n+│  PEP ───function call───► PDP   │\n+└─────────────────────────────────┘\n+```\n+\n+- PDP runs as a plugin in the same process\n+- Communication via direct function calls\n+- **Trust model:** implicit — same process, same memory space\n+- No additional authentication required\n+\n+#### Out-of-Process (Separate Service)\n+\n+```\n+┌─────────────┐        gRPC/mTLS        ┌───────────────┐\n+│  HyperSpot  │ ──────────────────────► │ Auth Resolver │\n+│    (PEP)    │                         │    (PDP)      │\n+└─────────────┘                         └───────────────┘\n+```\n+\n+- PDP runs as a separate process (same machine or remote)\n+- Communication via gRPC\n+- **Trust model:** explicit authentication required\n+- **mTLS required:** PDP authenticates that the caller is a legitimate PEP\n+\n+#### Trust Boundaries\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| PEP → PDP AuthN | implicit | mTLS |\n+| Subject identity | PDP trusts PEP | PDP trusts authenticated PEP |\n+| Network exposure | none | internal network only |\n+\n+**Note:** In both modes, PDP trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from the AuthN layer (Gateway) and flows through PEP to PDP.\n+\n+---\n+\n+## Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+\n+  **Why \"constraints\" not \"grants\":** The term \"grant\" is overloaded in authorization contexts—OAuth uses it for token acquisition flows (Authorization Code Grant), Zanzibar/ReBAC uses it for static relation tuples stored in the system. Constraints are fundamentally different: they are *computed predicates* returned by PDP at evaluation time, not stored permission facts. The term \"constraints\" accurately describes their role as query-level restrictions.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `bearer_token`.\n+\n+---\n+\n+# Authentication\n+\n+## Overview\n+\n+HyperSpot integrates with the vendor's Identity Provider (IdP) to authenticate requests. It supports two token formats:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens (RFC 7519), can be validated locally via signature verification or via introspection for revocation checking and claim enrichment\n+- **Opaque tokens** — Tokens validated via Token Introspection endpoint (RFC 7662)\n+\n+For JWT-based authentication, HyperSpot follows OpenID Connect Core 1.0 standards. Auto-configuration is supported via OpenID Connect Discovery 1.0 (`.well-known/openid-configuration`).\n+\n+**Token type detection**: JWT tokens are identified by their structure (three base64url-encoded segments separated by dots). All other tokens are treated as opaque.\n+\n+### Token Validation Modes\n+\n+| Mode | When | How |\n+|------|------|-----|\n+| JWT local | JWT + introspection not required | Validate signature via JWKS, extract claims |\n+| Introspection | Opaque token OR JWT requiring enrichment/revocation check | Plugin calls `introspection_endpoint` |\n+\n+### JWT Local Validation\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Gateway as API Gateway (HyperSpot)\n+    participant AuthResolver as Auth Resolver (HyperSpot)\n+    participant IdP as Vendor's IdP\n+    participant Module as HyperSpot Module\n+\n+    Client->>Gateway: Request + Bearer {JWT}\n+    Gateway->>Gateway: Extract iss from JWT (unverified)\n+    Gateway->>Gateway: Lookup iss in jwt.trusted_issuers\n+\n+    alt iss not in jwt.trusted_issuers\n+        Gateway-->>Client: 401 Untrusted issuer\n+    end\n+\n+    alt JWKS not cached or expired (1h)\n+        Gateway->>AuthResolver: get JWKS(discovery_url)\n+        AuthResolver->>IdP: GET {discovery_url}/.well-known/openid-configuration\n+        IdP-->>AuthResolver: { jwks_uri, ... }\n+        AuthResolver->>IdP: GET {jwks_uri}\n+        IdP-->>AuthResolver: JWKS\n+        AuthResolver-->>Gateway: JWKS (cached 1h)\n+    end\n+\n+    Gateway->>Gateway: Validate signature (JWKS)\n+    Gateway->>Gateway: Check exp, aud\n+    Gateway->>Gateway: Extract claims → SecurityContext\n+    Gateway->>Module: Request + SecurityContext\n+    Module-->>Gateway: Response\n+    Gateway-->>Client: Response\n+```\n+\n+### Token Introspection\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Gateway as API Gateway (HyperSpot)\n+    participant AuthResolver as Auth Resolver (HyperSpot)\n+    participant IdP as Vendor's IdP\n+    participant Module as HyperSpot Module\n+\n+    Client->>Gateway: Request + Bearer {token}\n+\n+    Note over Gateway: Token is opaque OR introspection.mode=always\n+\n+    Gateway->>AuthResolver: introspect(token)\n+    AuthResolver->>IdP: POST /introspect { token }\n+    IdP-->>AuthResolver: { active: true, sub, sub_tenant_id, sub_type, exp, ... }\n+    AuthResolver->>AuthResolver: Map response → SecurityContext\n+    AuthResolver-->>Gateway: SecurityContext\n+    Gateway->>Module: Request + SecurityContext\n+    Module-->>Gateway: Response\n+    Gateway-->>Client: Response\n+```\n+\n+### AuthN Result: Security Context\n+\n+Successful authentication produces a `SecurityContext` that flows to authorization:\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim\n+    subject_type: GtsTypeId,      // vendor-specific subject type (optional)\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    bearer_token: Option<String>, // original token for forwarding and PDP validation\n+}\n+```\n+\n+**Field sources by validation mode:**\n+\n+| Field | JWT Local | Introspection |\n+|-------|-----------|---------------|\n+| `subject_id` | `sub` claim | Introspection response `sub` |\n+| `subject_type` | Custom claim (vendor-defined) | Plugin maps from response |\n+| `subject_tenant_id` | Custom claim (vendor-defined) | Plugin maps from response |\n+| `bearer_token` | Original token from `Authorization` header | Original token from `Authorization` header |\n+\n+**Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext. Expiration is token metadata, not identity. The caching layer uses `exp` as upper bound for cache entry TTL.\n+- **Security:** `bearer_token` is a credential. It MUST NOT be logged, serialized to persistent storage, or included in error messages. Implementations should use opaque wrapper types (e.g., `Secret<String>`) and exclude from `Debug` output. The token is included for two purposes:\n+  1. **Forwarding** — Auth Resolver plugin may need to call external vendor services that require the original bearer token for authentication\n+  2. **PDP validation** — In out-of-process deployments, PDP may independently validate the token as defence-in-depth, not trusting the PEP's claim extraction\n+\n+---\n+\n+## Configuration\n+\n+```yaml\n+auth:\n+  jwt:\n+    trusted_issuers:\n+      \"https://accounts.google.com\":\n+        discovery_url: \"https://accounts.google.com\"\n+      \"my-corp-idp\":\n+        discovery_url: \"https://idp.corp.example.com\"\n+    require_audience: true\n+    expected_audience:\n+      - \"https://*.my-company.com\"\n+      - \"https://api.my-company.com\"\n+  jwks:\n+    cache:\n+      ttl: 1h\n+  introspection:\n+    mode: opaque_only\n+    endpoint: \"https://idp.corp.example.com/oauth2/introspect\"\n+    cache:\n+      enabled: true\n+      max_entries: 10000\n+      ttl: 5m\n+    endpoint_discovery_cache:\n+      enabled: true\n+      max_entries: 10000\n+      ttl: 1h\n+```\n+\n+### JWT Settings\n+\n+- `auth.jwt.trusted_issuers` — map of issuer identifier to discovery config\n+  - **Key** — expected `iss` claim value in JWT\n+  - **`discovery_url`** — base URL for OpenID Discovery (`{value}/.well-known/openid-configuration`)\n+- `auth.jwt.require_audience` — whether to require `aud` claim validation (default: `false`)\n+- `auth.jwt.expected_audience` — list of glob patterns for valid audiences (e.g., `https://*.my-company.com`)\n+\n+### JWKS Settings\n+\n+- `auth.jwks.cache.ttl` — JWKS cache TTL (default: `1h`)\n+\n+### Introspection Settings\n+\n+- `auth.introspection.mode` — when to introspect: `never`, `opaque_only` (default), `always`\n+- `auth.introspection.endpoint` — global introspection endpoint URL (applies to all issuers)\n+- `auth.introspection.cache.enabled` — enable introspection result caching (default: `true`)\n+- `auth.introspection.cache.max_entries` — max cached introspection results (default: `10000`)\n+- `auth.introspection.cache.ttl` — introspection result cache TTL (default: `5m`)\n+- `auth.introspection.endpoint_discovery_cache.enabled` — cache discovered introspection endpoints (default: `true`)\n+- `auth.introspection.endpoint_discovery_cache.max_entries` — max cached endpoints (default: `10000`)\n+- `auth.introspection.endpoint_discovery_cache.ttl` — endpoint discovery cache TTL (default: `1h`)\n+\n+---\n+\n+## Token Introspection\n+\n+Introspection (RFC 7662) is used in three scenarios:\n+\n+1. **Opaque tokens** — token is not self-contained, must be validated by IdP\n+2. **JWT enrichment** — JWT lacks HyperSpot-specific claims (`sub_tenant_id`, `sub_type`), plugin fetches additional subject info via introspection\n+3. **Revocation checking** — even for valid JWTs, introspection provides central point to check if token was revoked (e.g., user logout, compromised token)\n+\n+Configuration determines when introspection is triggered via `introspection.mode`:\n+- `introspection.mode: always` — all tokens (JWT and opaque) go through introspection\n+- `introspection.mode: opaque_only` — only opaque tokens (default)\n+- `introspection.mode: never` — JWT local validation only (no revocation check)\n+\n+**Configuration Matrix:**\n+\n+| Token Type | `introspection.mode` | `introspection.endpoint` | Behavior |\n+|------------|----------------------|--------------------------|----------|\n+| JWT | `never` | (any) | Local validation only, no introspection |\n+| JWT | `opaque_only` | (any) | Local validation only |\n+| JWT | `always` | configured | Use configured endpoint |\n+| JWT | `always` | not configured | Discover endpoint from issuer's OIDC config |\n+| Opaque | `never` | (any) | **401 Unauthorized** (cannot validate opaque without introspection) |\n+| Opaque | `opaque_only` / `always` | configured | Use configured endpoint |\n+| Opaque | `opaque_only` / `always` | not configured | **401 Unauthorized** (no `iss` claim to discover endpoint) |\n+\n+**Note:** Discovery requires the `iss` claim to look up the issuer configuration. Opaque tokens don't contain claims, so discovery is only possible for JWTs. For opaque tokens, `introspection.endpoint` must be explicitly configured.\n+\n+## OpenID Connect Integration\n+\n+HyperSpot leverages OpenID Connect standards for authentication:\n+\n+- **JWT validation** per OpenID Connect Core 1.0 — signature verification, claim validation\n+- **Discovery** via `.well-known/openid-configuration` (OpenID Connect Discovery 1.0) — automatic endpoint configuration\n+- **JWKS (JSON Web Key Set)** — public keys for JWT signature validation, fetched from `jwks_uri`\n+- **Token Introspection** (RFC 7662) — for opaque token validation, JWT enrichment, and revocation checking\n+\n+### Issuer Configuration\n+\n+The `trusted_issuers` map is required for JWT validation. This separation exists because:\n+\n+1. **Trust anchor** — HyperSpot must know which issuers to trust before receiving tokens\n+2. **Flexible mapping** — `iss` claim may differ from discovery URL (e.g., custom identifiers)\n+3. **Bootstrap problem** — to validate JWT, we need JWKS; to get JWKS, we need discovery URL\n+\n+**Lazy initialization flow:**\n+1. Admin configures `jwt.trusted_issuers` map\n+2. On first request, extract `iss` from JWT (unverified)\n+3. Look up `iss` in `jwt.trusted_issuers` → get discovery URL\n+4. If not found → reject (untrusted issuer)\n+5. Fetch `{discovery_url}/.well-known/openid-configuration`\n+6. Validate and cache JWKS, then verify JWT signature\n+\n+### Discovery\n+\n+Discovery is performed lazily on the first authenticated request (not at startup). HyperSpot fetches the OpenID configuration from `{issuer}/.well-known/openid-configuration` and extracts:\n+\n+- `jwks_uri` — for fetching signing keys\n+- `introspection_endpoint` — for opaque token validation (optional)\n+\n+**Caching:** JWKS is cached for `jwks.cache.ttl` (default: **1 hour**) and refreshed automatically on cache expiry or when signature validation fails with unknown `kid`.\n+\n+---\n+\n+## Plugin Role\n+\n+The Auth Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+\n+1. **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+2. **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+3. **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+\n+**When a plugin is needed:**\n+- Vendor's IdP uses opaque tokens\n+- Standard claims don't include tenant information\n+- Custom subject type mapping is required\n+- Additional validation rules apply\n+\n+---\n+\n+## Validation\n+\n+### Token Expiration\n+\n+The `exp` (expiration) claim is always validated:\n+- JWT local: `exp` claim must be in the future\n+- Introspection: response `active` must be `true` and `exp` must be in the future\n+\n+### Audience Validation\n+\n+The `aud` (audience) claim validation is controlled by `jwt.require_audience` and `jwt.expected_audience`:\n+\n+- If `require_audience: true` and JWT lacks `aud` claim → **401 Unauthorized**\n+- If `require_audience: false` (default) and JWT lacks `aud` claim → validation passes\n+- If JWT has `aud` claim and `expected_audience` is configured → at least one audience must match a pattern (glob pattern matching with `*` wildcard)\n+- If JWT has `aud` claim but `expected_audience` is empty/not configured → validation passes\n+\n+---\n+\n+## Introspection Caching\n+\n+Introspection results MAY be cached to reduce IdP load and latency (`introspection.cache.*`). Trade-off: revoked tokens remain valid until cache expires. Cache TTL should be shorter than token lifetime; use token `exp` as upper bound for cache entry lifetime.\n+\n+---\n+\n+# Authorization\n+\n+## Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for Auth Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+#### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+#### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle missing required fields** - Treat containing constraint as false\n+8. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant and PEP capabilities\n+  \"context\": {\n+    // Tenant context — use ONE of: tenant_id OR tenant_subtree\n+\n+    // Option 1: Single tenant (simple case)\n+    // \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+\n+    // Option 2: Tenant subtree (with hierarchy options)\n+    \"tenant_subtree\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_root\": true,        // default: true\n+      \"respect_barrier\": true,     // default: false, honor self_managed barrier\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filter by status\n+    },\n+\n+    // PEP enforcement mode\n+    \"require_constraints\": true,  // if true, decision without constraints = deny\n+\n+    // PEP capabilities: what predicate types the caller can enforce locally\n+    \"capabilities\": [\"tenant_hierarchy\", \"group_membership\", \"group_hierarchy\"],\n+\n+    // Original bearer token (optional) — see \"Bearer Token in Context\" below\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"\n+  }\n+}\n+```\n+\n+#### Bearer Token in Context\n+\n+The `context.bearer_token` field is optional. PEP includes it when PDP needs access to the original token. Use cases:\n+\n+1. **PDP validation (defence-in-depth)** — In out-of-process deployments, PDP may not fully trust subject claims extracted by PEP. PDP can independently validate the token signature and extract claims to verify `subject.id` and `subject.properties` match the token.\n+\n+2. **External service calls** — Auth Resolver plugin may need to call vendor's external APIs (authorization service, user info endpoint, etc.) that require the original bearer token for authentication.\n+\n+3. **Token-embedded policies** — Some IdPs embed access policies directly in the token (e.g., `permissions`, `roles`, `scopes` claims in JWT). PDP extracts and evaluates these claims to generate constraints.\n+\n+4. **Scope narrowing** — Token may contain scope restrictions (e.g., `scope: \"read:events\"`, resource-specific access tokens). PDP uses these to narrow the access decision beyond what static policies would allow.\n+\n+5. **Audit and tracing** — Token may contain correlation IDs, session info, or other metadata useful for audit logging in PDP.\n+\n+**When to omit:** If PDP fully trusts PEP's claim extraction and doesn't need to call external services, `bearer_token` can be omitted to reduce payload size and minimize credential exposure.\n+\n+**Security:** `bearer_token` is a credential. PDP MUST NOT log it, persist it, or include it in error responses.\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"respect_barrier\": true,\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"respect_barrier\": true\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+## Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `respect_barrier`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `respect_barrier` (optional): Honor `self_managed` barrier in hierarchy traversal, default `false`","path":"docs/authorization/AUTH.md","commit_id":"4ea08d8f1092a727549e0eb225f042f824f4fdee","original_commit_id":"4087d373a05859f20d6611fe8f76831ec5d57d93","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"shouldn't it be `true` by default? otherwise forgetting to set this parameter might lead to access to restricted data","created_at":"2026-01-29T08:55:19Z","updated_at":"2026-01-29T09:00:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2740592320","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740592320"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2740592320"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740592320/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":927,"side":"RIGHT","author_association":"MEMBER","original_position":927,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740612089","pull_request_review_id":3721440726,"id":2740612089,"node_id":"PRRC_kwDOPaLyBs6jWmv5","diff_hunk":"@@ -0,0 +1,1514 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Projection Tables](#projection-tables)\n+  - [What Are Projection Tables?](#what-are-projection-tables)\n+  - [Choosing Projection Tables](#choosing-projection-tables)\n+  - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+  - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+  - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+  - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+  - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+  - [Combinations Summary](#combinations-summary)\n+- [Scenarios](#scenarios)\n+  - [With `tenant_closure`](#with-tenant_closure)\n+    - [S01: LIST, tenant subtree, PEP has tenant_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+    - [S02: GET, tenant subtree, PEP has tenant_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+    - [S03: UPDATE, tenant subtree, PEP has tenant_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+    - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+    - [S05: LIST, tenant subtree with barrier, PEP has tenant_closure](#s05-list-tenant-subtree-with-barrier-pep-has-tenant_closure)\n+  - [Without `tenant_closure`](#without-tenant_closure)\n+    - [S06: LIST, tenant subtree, PEP without tenant_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+    - [S07: GET, tenant subtree, PEP without tenant_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+    - [S08: UPDATE, tenant subtree, PEP without tenant_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+    - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+  - [Resource Groups](#resource-groups)\n+    - [S10: LIST, group membership, PEP has resource_group_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+    - [S11: LIST, group subtree, PEP has resource_group_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+    - [S12: UPDATE, group membership, PEP has resource_group_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+    - [S13: UPDATE, group subtree, PEP has resource_group_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+    - [S14: GET, group membership, PEP without resource_group_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+    - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+  - [Advanced Patterns](#advanced-patterns)\n+    - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+    - [S17: LIST, multiple access paths (OR)](#s17-list-multiple-access-paths-or)\n+    - [S18: Access denied](#s18-access-denied)\n+- [TOCTOU Analysis](#toctou-analysis)\n+- [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true,\n+      \"respect_barrier\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"respect_barrier\": true\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+    AND (barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1')\n+)\n+```\n+\n+---\n+\n+#### S02: GET, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+User requests a specific task; PEP enforces tenant subtree access at query level.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row → return task\n+- 0 rows → **404 Not Found** (hides resource existence from unauthorized users)\n+\n+---\n+\n+#### S03: UPDATE, tenant subtree, PEP has tenant_closure\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+User updates a task; constraint ensures atomic authorization check.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row affected → success\n+- 0 rows affected → **404 Not Found** (task doesn't exist or no access)\n+\n+---\n+\n+#### S04: CREATE, tenant context\n+\n+`POST /tasks`\n+\n+User creates a new task. No constraints needed — PDP just validates permission.\n+\n+**Request:**\n+```http\n+POST /tasks\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"title\": \"New Task\", \"owner_tenant_id\": \"T2\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T2\",\n+    \"require_constraints\": false,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**SQL:**\n+```sql\n+INSERT INTO tasks (id, owner_tenant_id, title, status)\n+VALUES ('task-new', 'T2', 'New Task', 'pending')\n+```\n+\n+**Note:** No constraints returned — `require_constraints: false` allows PEP to trust the decision for CREATE operations.\n+\n+---\n+\n+#### S05: LIST, tenant subtree with barrier, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true&respect_barrier=true`\n+\n+User in parent tenant T1 requests tasks, but child tenant T2 is self-managed (barrier). Tasks in T2 subtree should be excluded.\n+\n+**Tenant hierarchy:**\n+```\n+T1 (parent)\n+├── T2 (self_managed=true)  ← barrier\n+│   └── T3\n+└── T4\n+```\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true&respect_barrier=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true,\n+      \"respect_barrier\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"respect_barrier\": true\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+    AND (barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1')\n+)\n+```\n+\n+**Result:** Returns tasks from T1 and T4 only. Tasks from T2 and T3 are excluded because T2 is a barrier.\n+\n+**tenant_closure data example:**\n+\n+| ancestor_id | descendant_id | barrier_ancestor_id |\n+|-------------|---------------|---------------------|\n+| T1 | T1 | NULL |\n+| T1 | T2 | T2 |\n+| T1 | T3 | T2 |\n+| T1 | T4 | NULL |\n+| T2 | T2 | NULL |\n+| T2 | T3 | NULL |\n+\n+When querying from T1 with `respect_barrier=true`, only rows where `barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1'` match → T1, T4.\n+\n+---\n+\n+### Without `tenant_closure`\n+\n+PEP has no tenant_closure table → PDP returns explicit IDs or PEP prefetches attributes.\n+\n+---\n+\n+#### S06: LIST, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. PDP resolves the subtree and returns explicit tenant IDs.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP resolves the subtree internally and returns explicit IDs:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"values\": [\"T1\", \"T2\", \"T3\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN ('T1', 'T2', 'T3')\n+```\n+\n+**Trade-off:** PDP must know the tenant hierarchy and resolve it. Works well for small tenant counts; may not scale for thousands of tenants.\n+\n+---\n+\n+#### S07: GET, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. For read-only operations, PEP fetches the resource first, then asks PDP for a decision based on resource attributes. No second query needed — TOCTOU is not a concern for reads.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**Step 1 — PEP fetches resource:**\n+```sql\n+SELECT * FROM tasks WHERE id = 'task-456'\n+```\n+Result: full task record with `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request (with resource properties):**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": false,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP validates that T2 is in T1's subtree and returns decision only (no constraints needed for read):\n+\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**Step 3 — Return result:**\n+- `decision: true` → return already-fetched task\n+- `decision: false` → **404 Not Found** (hides resource existence)\n+- Resource not found in Step 1 → **404 Not Found**\n+\n+**Why no TOCTOU concern:** For GET, the \"use\" is returning data to the client. Even if `owner_tenant_id` changed between check and response, no security violation occurs — the client either gets data they had access to at query time, or gets 404. For mutations (UPDATE/DELETE), see S08.\n+\n+---\n+\n+#### S08: UPDATE, tenant subtree, PEP without tenant_closure (prefetch)\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+Unlike S07 (GET), mutations require TOCTOU protection. PEP prefetches `owner_tenant_id`, gets `eq` constraint from PDP, and applies it in UPDATE's WHERE clause. This ensures atomic check-and-modify.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**Step 1 — PEP prefetches:**\n+```sql\n+SELECT owner_tenant_id FROM tasks WHERE id = 'task-456'\n+```\n+Result: `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T2\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Step 3 — SQL with constraint:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T2'\n+```\n+\n+**TOCTOU protection:** If another request changed `owner_tenant_id` between prefetch and UPDATE, the WHERE clause won't match → 0 rows affected → **404**. This prevents unauthorized modification even in a race condition.\n+\n+---\n+\n+#### S09: GET, context tenant only (no subtree)\n+\n+`GET /tasks/{id}`\n+\n+Simplest case — access limited to context tenant only, no subtree traversal. User can only access resources directly owned by their tenant.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+```\n+\n+**Note:** No prefetch needed, no closure table required. PDP returns direct `eq` constraint based on context tenant. This pattern applies when the endpoint operates within a single tenant context, regardless of whether the overall tenant model is hierarchical.\n+\n+---\n+\n+### Resource Groups\n+\n+> **Note:** Resource groups operate within tenant boundaries. All group-based constraints include a tenant predicate (typically `eq` on `owner_tenant_id`) to ensure tenant isolation. Groups don't bypass multi-tenancy — a user in T1 cannot access resources in T2's groups even if they somehow have group membership.\n+\n+---\n+\n+#### S10: LIST, group membership, PEP has resource_group_membership\n+\n+`GET /tasks`\n+\n+User has access to specific projects (flat group membership, no hierarchy).\n+\n+**Request:**\n+```http\n+GET /tasks\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_membership\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included — groups don't bypass tenant isolation:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group\",\n+            \"resource_property\": \"id\",\n+            \"group_ids\": [\"ProjectA\", \"ProjectB\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN ('ProjectA', 'ProjectB')\n+  )\n+```\n+\n+---\n+\n+#### S11: LIST, group subtree, PEP has resource_group_closure\n+\n+`GET /tasks`\n+\n+User has access to a project folder and all its subfolders.\n+\n+**Request:**\n+```http\n+GET /tasks\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"FolderA\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN (\n+      SELECT descendant_id FROM resource_group_closure\n+      WHERE ancestor_id = 'FolderA'\n+  )\n+)\n+```\n+\n+---\n+\n+#### S12: UPDATE, group membership, PEP has resource_group_membership\n+\n+`PUT /tasks/{id}`\n+\n+User updates a task; PEP has resource_group_membership table. Similar to tenant-based S03, but filtering by group membership.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_membership\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group\",\n+            \"resource_property\": \"id\",\n+            \"group_ids\": [\"ProjectA\", \"ProjectB\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN ('ProjectA', 'ProjectB')\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row affected → success\n+- 0 rows affected → task doesn't exist or not in user's accessible groups → **404**\n+\n+---\n+\n+#### S13: UPDATE, group subtree, PEP has resource_group_closure\n+\n+`PUT /tasks/{id}`\n+\n+User updates a task; PEP has both resource_group_membership and resource_group_closure tables.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"FolderA\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN (\n+      SELECT descendant_id FROM resource_group_closure\n+      WHERE ancestor_id = 'FolderA'\n+    )\n+  )\n+```\n+\n+---\n+\n+#### S14: GET, group membership, PEP without resource_group_membership\n+\n+`GET /tasks/{id}`\n+\n+PEP doesn't have resource_group_membership table. For read operations, PEP fetches the resource and sends group membership info to PDP for decision.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456\n+Authorization: Bearer <token>\n+```\n+\n+**Step 1 — PEP fetches resource with group info:**","path":"docs/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"9c0a36ed4cddfe6e5c21a1651c051284972691ce","original_commit_id":"4087d373a05859f20d6611fe8f76831ec5d57d93","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It appears that this introduces coupling between PEP and PDP. How does the PEP know that it needs to send `group_ids` alongs with the rest of resource properties in request to PDP? In all previous examples it didn't send those. What if PDP authz rules change and it starts to need additional data - this will require changes on PEP side as well.\n\nMaybe PDP can exctract the group membership information from `resource_group_membership` projection table by itself in this scenario? I assume it should have access to it","created_at":"2026-01-29T09:00:44Z","updated_at":"2026-01-29T09:00:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2740612089","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740612089"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2740612089"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740612089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1121,"side":"RIGHT","author_association":"MEMBER","original_position":1121,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741434491","pull_request_review_id":3722433047,"id":2741434491,"node_id":"PRRC_kwDOPaLyBs6jZvh7","diff_hunk":"@@ -0,0 +1,243 @@\n+# Resource Group Model\n+\n+This document describes HyperSpot's resource group model for authorization: group topology, membership mechanisms, and how groups are used in access control.\n+\n+## Table of Contents\n+\n+- [Resource Group Model](#resource-group-model)\n+  - [Table of Contents](#table-of-contents)\n+  - [Overview](#overview)\n+  - [Resource Group Topology: Forest](#resource-group-topology-forest)\n+  - [Resource Group Properties](#resource-group-properties)\n+  - [Resource-to-Group Membership](#resource-to-group-membership)\n+  - [Closure Table](#closure-table)\n+  - [Membership Table](#membership-table)\n+  - [Relationship with Tenant Model](#relationship-with-tenant-model)\n+  - [References](#references)\n+\n+---\n+\n+## Overview\n+\n+HyperSpot uses **resource groups** as an optional organizational layer for grouping resources. The primary purpose is **access control** — granting permissions at the group level rather than per-resource.\n+\n+Vendors may implement various group types depending on their domain. Examples include:\n+\n+- Projects (task management, issue tracking)\n+- Workspaces (collaboration spaces)\n+- Folders (document organization with nesting)\n+- Teams, Departments, Campaigns, etc.\n+\n+The specific group types and their semantics are vendor-defined. HyperSpot provides the infrastructure for hierarchical grouping and membership resolution without prescribing what groups represent.\n+\n+```\n+Tenant T1\n+├── [Group A]\n+│   ├── Resource 1\n+│   ├── Resource 2\n+│   └── [Group A.1]\n+│       └── Resource 3\n+├── [Group B]\n+│   └── Resource 4\n+└── (ungrouped resources)","path":"docs/arch/authorization/RESOURCE_GROUP_MODEL.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"52bd329ddb1d645268e0f977a0d68406c3c272fe","user":{"login":"ffedoroff","id":1179771,"node_id":"MDQ6VXNlcjExNzk3NzE=","avatar_url":"https://avatars.githubusercontent.com/u/1179771?v=4","gravatar_id":"","url":"https://api.github.com/users/ffedoroff","html_url":"https://github.com/ffedoroff","followers_url":"https://api.github.com/users/ffedoroff/followers","following_url":"https://api.github.com/users/ffedoroff/following{/other_user}","gists_url":"https://api.github.com/users/ffedoroff/gists{/gist_id}","starred_url":"https://api.github.com/users/ffedoroff/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ffedoroff/subscriptions","organizations_url":"https://api.github.com/users/ffedoroff/orgs","repos_url":"https://api.github.com/users/ffedoroff/repos","events_url":"https://api.github.com/users/ffedoroff/events{/privacy}","received_events_url":"https://api.github.com/users/ffedoroff/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\n[Tenant T1]\n├── [Group A]\n│   ├── Resource 1\n│   ├── Resource 2\n│   └── [Group A.1]\n│       └── Resource 3\n└── [Group B]\n    ├── Resource 1\n    └── Resource 4\nResource 1\nResource 5\nOther ungrouped Resources\n```\n\nSince we could have the same Resource in different groups, and some resource not in Groups at all, suggest to change ","created_at":"2026-01-29T12:36:24Z","updated_at":"2026-01-29T12:36:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2741434491","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741434491"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2741434491"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741434491/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":34,"original_start_line":34,"start_side":"RIGHT","line":43,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":42,"position":43,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743459003","pull_request_review_id":3724949458,"id":2743459003,"node_id":"PRRC_kwDOPaLyBs6jhdy7","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good point. All these aspects are described in `docs/authorization/TENANT_MODEL.md` and `docs/authorization/RESOURCE_GROUP_MODEL.md` now.","created_at":"2026-01-29T20:43:27Z","updated_at":"2026-01-29T20:43:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743459003","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743459003"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743459003"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743459003/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":593,"original_line":153,"side":"RIGHT","in_reply_to_id":2726017068,"author_association":"MEMBER","original_position":153,"position":593,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743461686","pull_request_review_id":3724952688,"id":2743461686,"node_id":"PRRC_kwDOPaLyBs6jhec2","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Barrier concept is explained in `docs/authorization/TENANT_MODEL.md` now.","created_at":"2026-01-29T20:44:03Z","updated_at":"2026-01-29T20:44:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743461686","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743461686"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743461686"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743461686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":142,"side":"RIGHT","in_reply_to_id":2726033038,"author_association":"MEMBER","original_position":142,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743511569","pull_request_review_id":3725009220,"id":2743511569,"node_id":"PRRC_kwDOPaLyBs6jhqoR","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |","path":"docs/design/AUTH.md","commit_id":"8c3d6c5bff437a59752efb13d42c9c243225ca9c","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tenant Service and RG Service are supposed to be used by HyperSpot only for read operations and only via vendor-specific Tenant Resolver / RG Resolver plugins which will be fully responsible to implementing authorization properly.","created_at":"2026-01-29T20:54:01Z","updated_at":"2026-01-29T20:54:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743511569","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743511569"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743511569"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743511569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":163,"side":"RIGHT","in_reply_to_id":2726040304,"author_association":"MEMBER","original_position":163,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743519607","pull_request_review_id":3725017603,"id":2743519607,"node_id":"PRRC_kwDOPaLyBs6jhsl3","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks, different flows (including both cases when domain module has / doesn't have tenant / resource group projection tables) are covered in `docs/authorization/AUTHZ_USAGE_SCENARIOS.md` now.","created_at":"2026-01-29T20:56:19Z","updated_at":"2026-01-29T20:56:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743519607","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743519607"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2743519607"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2743519607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":618,"original_line":219,"side":"RIGHT","in_reply_to_id":2726044458,"author_association":"MEMBER","original_position":219,"position":618,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745250196","pull_request_review_id":3727073976,"id":2745250196,"node_id":"PRRC_kwDOPaLyBs6joTGU","diff_hunk":"@@ -0,0 +1,1179 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+  - [PDP/PEP Model](#pdppep-model)\n+  - [Request Flow](#request-flow)\n+  - [Auth Resolver: Gateway + Plugin Architecture](#auth-resolver-gateway--plugin-architecture)\n+  - [Integration Architecture](#integration-architecture)\n+  - [Deployment Modes and Trust Model](#deployment-modes-and-trust-model)\n+- [Core Terms](#core-terms)\n+- [Authentication](#authentication)\n+  - [Configuration](#configuration)\n+  - [Token Introspection](#token-introspection)\n+  - [OpenID Connect Integration](#openid-connect-integration)\n+  - [Plugin Role](#plugin-role)\n+  - [Validation](#validation)\n+  - [Introspection Caching](#introspection-caching)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+- [Tenant Model](./TENANT_MODEL.md)\n+- [Usage Scenarios](./SCENARIOS.md)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot integrates with vendor's Identity Provider (IdP) to validate access tokens and extract subject identity.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the Auth Resolver module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the details.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **Auth Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full rationale.\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant AuthN as AuthN Layer<br/>(Gateway)\n+    participant PEP as PEP<br/>(Domain Module)\n+    participant PDP as PDP<br/>(Auth Resolver)\n+    participant DB as Database\n+\n+    Client->>AuthN: Request + Token\n+    AuthN->>AuthN: Validate token, extract claims\n+    AuthN->>PEP: Request + SecurityContext\n+    PEP->>PDP: AuthZ Request<br/>(subject, action, resource, context)\n+    PDP->>PDP: Evaluate policies\n+    PDP-->>PEP: decision + constraints\n+    PEP->>PEP: Compile constraints to SQL\n+    PEP->>DB: Query with WHERE clauses\n+    DB-->>PEP: Filtered results\n+    PEP-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Layer** — validates token, extracts identity → `SecurityContext`\n+2. **PEP** — builds AuthZ request, compiles constraints to SQL\n+3. **PDP** — evaluates policies, returns decision + constraints\n+\n+### Auth Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern:\n+\n+- **Auth Resolver** — a HyperSpot gateway module that defines a unified interface for AuthN/AuthZ operations\n+- **Vendor Plugin** — implements the Auth Resolver interface, integrating with vendor's IdP and Authorization API\n+\n+This allows HyperSpot domain modules (PEPs) to use a consistent API regardless of the vendor's identity and authorization infrastructure. Each vendor develops their own Auth Resolver plugin that bridges to their specific systems.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthResolver[\"Auth Resolver\"]\n+            AuthGW[\"Gateway\"]\n+            AuthPlugin[\"Plugin<br/>(AuthN + PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% Auth Resolver flow\n+    AuthGW --> AuthPlugin\n+    AuthPlugin -->|introspection| IdP\n+    AuthPlugin -->|authz| AuthzSvc\n+    AuthPlugin -.->|tenant hierarchy| TenantGW\n+    AuthPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    Handler -->|token introspection| AuthGW\n+    Handler -->|/access/v1/evaluation| AuthGW\n+    Handler -->|constraints → SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **Handler → Auth Resolver (Gateway)** — PEP calls for token introspection and authorization\n+2. **Auth Resolver (Gateway) → Auth Resolver (Plugin)** — gateway delegates to vendor plugin (handles both AuthN and PDP)\n+3. **Auth Resolver (Plugin) → IdP** — token introspection\n+4. **Auth Resolver (Plugin) → Authz Svc** — authorization decisions\n+5. **Auth Resolver (Plugin) → Tenant Resolver (Gateway)** — tenant hierarchy queries\n+6. **Auth Resolver (Plugin) → RG Resolver (Gateway)** — group hierarchy and membership queries\n+7. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Auth Resolver (PDP) can run in two configurations with different trust models.\n+\n+#### In-Process (Plugin)\n+\n+```\n+┌─────────────────────────────────┐\n+│       HyperSpot Process         │\n+│  PEP ───function call───► PDP   │\n+└─────────────────────────────────┘\n+```\n+\n+- PDP runs as a plugin in the same process\n+- Communication via direct function calls\n+- **Trust model:** implicit — same process, same memory space\n+- No additional authentication required\n+\n+#### Out-of-Process (Separate Service)\n+\n+```\n+┌─────────────┐        gRPC/mTLS        ┌───────────────┐\n+│  HyperSpot  │ ──────────────────────► │ Auth Resolver │\n+│    (PEP)    │                         │    (PDP)      │\n+└─────────────┘                         └───────────────┘\n+```\n+\n+- PDP runs as a separate process (same machine or remote)\n+- Communication via gRPC\n+- **Trust model:** explicit authentication required\n+- **mTLS required:** PDP authenticates that the caller is a legitimate PEP\n+\n+#### Trust Boundaries\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| PEP → PDP AuthN | implicit | mTLS |\n+| Subject identity | PDP trusts PEP | PDP trusts authenticated PEP |\n+| Network exposure | none | internal network only |\n+\n+**Note:** In both modes, PDP trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from the AuthN layer (Gateway) and flows through PEP to PDP.\n+\n+---\n+\n+## Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+\n+  **Why \"constraints\" not \"grants\":** The term \"grant\" is overloaded in authorization contexts—OAuth uses it for token acquisition flows (Authorization Code Grant), Zanzibar/ReBAC uses it for static relation tuples stored in the system. Constraints are fundamentally different: they are *computed predicates* returned by PDP at evaluation time, not stored permission facts. The term \"constraints\" accurately describes their role as query-level restrictions.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `bearer_token`.\n+\n+---\n+\n+# Authentication\n+\n+## Overview\n+\n+HyperSpot integrates with the vendor's Identity Provider (IdP) to authenticate requests. It supports two token formats:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens (RFC 7519), can be validated locally via signature verification or via introspection for revocation checking and claim enrichment\n+- **Opaque tokens** — Tokens validated via Token Introspection endpoint (RFC 7662)\n+\n+For JWT-based authentication, HyperSpot follows OpenID Connect Core 1.0 standards. Auto-configuration is supported via OpenID Connect Discovery 1.0 (`.well-known/openid-configuration`).\n+\n+**Token type detection**: JWT tokens are identified by their structure (three base64url-encoded segments separated by dots). All other tokens are treated as opaque.\n+\n+### Token Validation Modes\n+\n+| Mode | When | How |\n+|------|------|-----|\n+| JWT local | JWT + introspection not required | Validate signature via JWKS, extract claims |\n+| Introspection | Opaque token OR JWT requiring enrichment/revocation check | Plugin calls `introspection_endpoint` |\n+\n+### JWT Local Validation\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Gateway as API Gateway (HyperSpot)\n+    participant AuthResolver as Auth Resolver (HyperSpot)\n+    participant IdP as Vendor's IdP\n+    participant Module as HyperSpot Module\n+\n+    Client->>Gateway: Request + Bearer {JWT}\n+    Gateway->>Gateway: Extract iss from JWT (unverified)\n+    Gateway->>Gateway: Lookup iss in jwt.trusted_issuers\n+\n+    alt iss not in jwt.trusted_issuers\n+        Gateway-->>Client: 401 Untrusted issuer\n+    end\n+\n+    alt JWKS not cached or expired (1h)\n+        Gateway->>AuthResolver: get JWKS(discovery_url)\n+        AuthResolver->>IdP: GET {discovery_url}/.well-known/openid-configuration\n+        IdP-->>AuthResolver: { jwks_uri, ... }\n+        AuthResolver->>IdP: GET {jwks_uri}\n+        IdP-->>AuthResolver: JWKS\n+        AuthResolver-->>Gateway: JWKS (cached 1h)\n+    end\n+\n+    Gateway->>Gateway: Validate signature (JWKS)\n+    Gateway->>Gateway: Check exp, aud\n+    Gateway->>Gateway: Extract claims → SecurityContext\n+    Gateway->>Module: Request + SecurityContext\n+    Module-->>Gateway: Response\n+    Gateway-->>Client: Response\n+```\n+\n+### Token Introspection\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Gateway as API Gateway (HyperSpot)\n+    participant AuthResolver as Auth Resolver (HyperSpot)\n+    participant IdP as Vendor's IdP\n+    participant Module as HyperSpot Module\n+\n+    Client->>Gateway: Request + Bearer {token}\n+\n+    Note over Gateway: Token is opaque OR introspection.mode=always\n+\n+    Gateway->>AuthResolver: introspect(token)\n+    AuthResolver->>IdP: POST /introspect { token }\n+    IdP-->>AuthResolver: { active: true, sub, sub_tenant_id, sub_type, exp, ... }\n+    AuthResolver->>AuthResolver: Map response → SecurityContext\n+    AuthResolver-->>Gateway: SecurityContext\n+    Gateway->>Module: Request + SecurityContext\n+    Module-->>Gateway: Response\n+    Gateway-->>Client: Response\n+```\n+\n+### AuthN Result: Security Context\n+\n+Successful authentication produces a `SecurityContext` that flows to authorization:\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim\n+    subject_type: GtsTypeId,      // vendor-specific subject type (optional)\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    bearer_token: Option<String>, // original token for forwarding and PDP validation\n+}\n+```\n+\n+**Field sources by validation mode:**\n+\n+| Field | JWT Local | Introspection |\n+|-------|-----------|---------------|\n+| `subject_id` | `sub` claim | Introspection response `sub` |\n+| `subject_type` | Custom claim (vendor-defined) | Plugin maps from response |\n+| `subject_tenant_id` | Custom claim (vendor-defined) | Plugin maps from response |\n+| `bearer_token` | Original token from `Authorization` header | Original token from `Authorization` header |\n+\n+**Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext. Expiration is token metadata, not identity. The caching layer uses `exp` as upper bound for cache entry TTL.\n+- **Security:** `bearer_token` is a credential. It MUST NOT be logged, serialized to persistent storage, or included in error messages. Implementations should use opaque wrapper types (e.g., `Secret<String>`) and exclude from `Debug` output. The token is included for two purposes:\n+  1. **Forwarding** — Auth Resolver plugin may need to call external vendor services that require the original bearer token for authentication\n+  2. **PDP validation** — In out-of-process deployments, PDP may independently validate the token as defence-in-depth, not trusting the PEP's claim extraction\n+\n+---\n+\n+## Configuration\n+\n+```yaml\n+auth:\n+  jwt:\n+    trusted_issuers:\n+      \"https://accounts.google.com\":\n+        discovery_url: \"https://accounts.google.com\"\n+      \"my-corp-idp\":\n+        discovery_url: \"https://idp.corp.example.com\"\n+    require_audience: true\n+    expected_audience:\n+      - \"https://*.my-company.com\"\n+      - \"https://api.my-company.com\"\n+  jwks:\n+    cache:\n+      ttl: 1h\n+  introspection:\n+    mode: opaque_only\n+    endpoint: \"https://idp.corp.example.com/oauth2/introspect\"\n+    cache:\n+      enabled: true\n+      max_entries: 10000\n+      ttl: 5m\n+    endpoint_discovery_cache:\n+      enabled: true\n+      max_entries: 10000\n+      ttl: 1h\n+```\n+\n+### JWT Settings\n+\n+- `auth.jwt.trusted_issuers` — map of issuer identifier to discovery config\n+  - **Key** — expected `iss` claim value in JWT\n+  - **`discovery_url`** — base URL for OpenID Discovery (`{value}/.well-known/openid-configuration`)\n+- `auth.jwt.require_audience` — whether to require `aud` claim validation (default: `false`)\n+- `auth.jwt.expected_audience` — list of glob patterns for valid audiences (e.g., `https://*.my-company.com`)\n+\n+### JWKS Settings\n+\n+- `auth.jwks.cache.ttl` — JWKS cache TTL (default: `1h`)\n+\n+### Introspection Settings\n+\n+- `auth.introspection.mode` — when to introspect: `never`, `opaque_only` (default), `always`\n+- `auth.introspection.endpoint` — global introspection endpoint URL (applies to all issuers)\n+- `auth.introspection.cache.enabled` — enable introspection result caching (default: `true`)\n+- `auth.introspection.cache.max_entries` — max cached introspection results (default: `10000`)\n+- `auth.introspection.cache.ttl` — introspection result cache TTL (default: `5m`)\n+- `auth.introspection.endpoint_discovery_cache.enabled` — cache discovered introspection endpoints (default: `true`)\n+- `auth.introspection.endpoint_discovery_cache.max_entries` — max cached endpoints (default: `10000`)\n+- `auth.introspection.endpoint_discovery_cache.ttl` — endpoint discovery cache TTL (default: `1h`)\n+\n+---\n+\n+## Token Introspection\n+\n+Introspection (RFC 7662) is used in three scenarios:\n+\n+1. **Opaque tokens** — token is not self-contained, must be validated by IdP\n+2. **JWT enrichment** — JWT lacks HyperSpot-specific claims (`sub_tenant_id`, `sub_type`), plugin fetches additional subject info via introspection\n+3. **Revocation checking** — even for valid JWTs, introspection provides central point to check if token was revoked (e.g., user logout, compromised token)\n+\n+Configuration determines when introspection is triggered via `introspection.mode`:\n+- `introspection.mode: always` — all tokens (JWT and opaque) go through introspection\n+- `introspection.mode: opaque_only` — only opaque tokens (default)\n+- `introspection.mode: never` — JWT local validation only (no revocation check)\n+\n+**Configuration Matrix:**\n+\n+| Token Type | `introspection.mode` | `introspection.endpoint` | Behavior |\n+|------------|----------------------|--------------------------|----------|\n+| JWT | `never` | (any) | Local validation only, no introspection |\n+| JWT | `opaque_only` | (any) | Local validation only |\n+| JWT | `always` | configured | Use configured endpoint |\n+| JWT | `always` | not configured | Discover endpoint from issuer's OIDC config |\n+| Opaque | `never` | (any) | **401 Unauthorized** (cannot validate opaque without introspection) |\n+| Opaque | `opaque_only` / `always` | configured | Use configured endpoint |\n+| Opaque | `opaque_only` / `always` | not configured | **401 Unauthorized** (no `iss` claim to discover endpoint) |\n+\n+**Note:** Discovery requires the `iss` claim to look up the issuer configuration. Opaque tokens don't contain claims, so discovery is only possible for JWTs. For opaque tokens, `introspection.endpoint` must be explicitly configured.\n+\n+## OpenID Connect Integration\n+\n+HyperSpot leverages OpenID Connect standards for authentication:\n+\n+- **JWT validation** per OpenID Connect Core 1.0 — signature verification, claim validation\n+- **Discovery** via `.well-known/openid-configuration` (OpenID Connect Discovery 1.0) — automatic endpoint configuration\n+- **JWKS (JSON Web Key Set)** — public keys for JWT signature validation, fetched from `jwks_uri`\n+- **Token Introspection** (RFC 7662) — for opaque token validation, JWT enrichment, and revocation checking\n+\n+### Issuer Configuration\n+\n+The `trusted_issuers` map is required for JWT validation. This separation exists because:\n+\n+1. **Trust anchor** — HyperSpot must know which issuers to trust before receiving tokens\n+2. **Flexible mapping** — `iss` claim may differ from discovery URL (e.g., custom identifiers)\n+3. **Bootstrap problem** — to validate JWT, we need JWKS; to get JWKS, we need discovery URL\n+\n+**Lazy initialization flow:**\n+1. Admin configures `jwt.trusted_issuers` map\n+2. On first request, extract `iss` from JWT (unverified)\n+3. Look up `iss` in `jwt.trusted_issuers` → get discovery URL\n+4. If not found → reject (untrusted issuer)\n+5. Fetch `{discovery_url}/.well-known/openid-configuration`\n+6. Validate and cache JWKS, then verify JWT signature\n+\n+### Discovery\n+\n+Discovery is performed lazily on the first authenticated request (not at startup). HyperSpot fetches the OpenID configuration from `{issuer}/.well-known/openid-configuration` and extracts:\n+\n+- `jwks_uri` — for fetching signing keys\n+- `introspection_endpoint` — for opaque token validation (optional)\n+\n+**Caching:** JWKS is cached for `jwks.cache.ttl` (default: **1 hour**) and refreshed automatically on cache expiry or when signature validation fails with unknown `kid`.\n+\n+---\n+\n+## Plugin Role\n+\n+The Auth Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+\n+1. **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+2. **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+3. **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+\n+**When a plugin is needed:**\n+- Vendor's IdP uses opaque tokens\n+- Standard claims don't include tenant information\n+- Custom subject type mapping is required\n+- Additional validation rules apply\n+\n+---\n+\n+## Validation\n+\n+### Token Expiration\n+\n+The `exp` (expiration) claim is always validated:\n+- JWT local: `exp` claim must be in the future\n+- Introspection: response `active` must be `true` and `exp` must be in the future\n+\n+### Audience Validation\n+\n+The `aud` (audience) claim validation is controlled by `jwt.require_audience` and `jwt.expected_audience`:\n+\n+- If `require_audience: true` and JWT lacks `aud` claim → **401 Unauthorized**\n+- If `require_audience: false` (default) and JWT lacks `aud` claim → validation passes\n+- If JWT has `aud` claim and `expected_audience` is configured → at least one audience must match a pattern (glob pattern matching with `*` wildcard)\n+- If JWT has `aud` claim but `expected_audience` is empty/not configured → validation passes\n+\n+---\n+\n+## Introspection Caching\n+\n+Introspection results MAY be cached to reduce IdP load and latency (`introspection.cache.*`). Trade-off: revoked tokens remain valid until cache expires. Cache TTL should be shorter than token lifetime; use token `exp` as upper bound for cache entry lifetime.\n+\n+---\n+\n+# Authorization\n+\n+## Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for Auth Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+#### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+#### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle missing required fields** - Treat containing constraint as false\n+8. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant and PEP capabilities\n+  \"context\": {\n+    // Tenant context — use ONE of: tenant_id OR tenant_subtree\n+\n+    // Option 1: Single tenant (simple case)\n+    // \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+\n+    // Option 2: Tenant subtree (with hierarchy options)\n+    \"tenant_subtree\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_root\": true,        // default: true\n+      \"respect_barrier\": true,     // default: false, honor self_managed barrier\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filter by status\n+    },\n+\n+    // PEP enforcement mode\n+    \"require_constraints\": true,  // if true, decision without constraints = deny\n+\n+    // PEP capabilities: what predicate types the caller can enforce locally\n+    \"capabilities\": [\"tenant_hierarchy\", \"group_membership\", \"group_hierarchy\"],\n+\n+    // Original bearer token (optional) — see \"Bearer Token in Context\" below\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"\n+  }\n+}\n+```\n+\n+#### Bearer Token in Context\n+\n+The `context.bearer_token` field is optional. PEP includes it when PDP needs access to the original token. Use cases:\n+\n+1. **PDP validation (defence-in-depth)** — In out-of-process deployments, PDP may not fully trust subject claims extracted by PEP. PDP can independently validate the token signature and extract claims to verify `subject.id` and `subject.properties` match the token.\n+\n+2. **External service calls** — Auth Resolver plugin may need to call vendor's external APIs (authorization service, user info endpoint, etc.) that require the original bearer token for authentication.\n+\n+3. **Token-embedded policies** — Some IdPs embed access policies directly in the token (e.g., `permissions`, `roles`, `scopes` claims in JWT). PDP extracts and evaluates these claims to generate constraints.\n+\n+4. **Scope narrowing** — Token may contain scope restrictions (e.g., `scope: \"read:events\"`, resource-specific access tokens). PDP uses these to narrow the access decision beyond what static policies would allow.\n+\n+5. **Audit and tracing** — Token may contain correlation IDs, session info, or other metadata useful for audit logging in PDP.\n+\n+**When to omit:** If PDP fully trusts PEP's claim extraction and doesn't need to call external services, `bearer_token` can be omitted to reduce payload size and minimize credential exposure.\n+\n+**Security:** `bearer_token` is a credential. PDP MUST NOT log it, persist it, or include it in error responses.\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"respect_barrier\": true,\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"respect_barrier\": true }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"respect_barrier\": true\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+## Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `respect_barrier`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `respect_barrier` (optional): Honor `self_managed` barrier in hierarchy traversal, default `false`","path":"docs/authorization/AUTH.md","commit_id":"4ea08d8f1092a727549e0eb225f042f824f4fdee","original_commit_id":"4087d373a05859f20d6611fe8f76831ec5d57d93","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"yes, you are right. I've reworked this place and introduced `barrier_mode` instead with two possible values:\r\n- `\"all\"` - respect all barrier kinds (current we have only self-managed barrier, but it may extended in the future - DB column \"barrier\" is int and may be used for bitmask operations in SQL).\r\n- `\"none\"` - ignore all barriers","created_at":"2026-01-30T08:49:04Z","updated_at":"2026-01-30T08:49:04Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745250196","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745250196"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745250196"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745250196/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":927,"side":"RIGHT","in_reply_to_id":2740592320,"author_association":"MEMBER","original_position":927,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745258944","pull_request_review_id":3727085344,"id":2745258944,"node_id":"PRRC_kwDOPaLyBs6joVPA","diff_hunk":"@@ -0,0 +1,243 @@\n+# Resource Group Model\n+\n+This document describes HyperSpot's resource group model for authorization: group topology, membership mechanisms, and how groups are used in access control.\n+\n+## Table of Contents\n+\n+- [Resource Group Model](#resource-group-model)\n+  - [Table of Contents](#table-of-contents)\n+  - [Overview](#overview)\n+  - [Resource Group Topology: Forest](#resource-group-topology-forest)\n+  - [Resource Group Properties](#resource-group-properties)\n+  - [Resource-to-Group Membership](#resource-to-group-membership)\n+  - [Closure Table](#closure-table)\n+  - [Membership Table](#membership-table)\n+  - [Relationship with Tenant Model](#relationship-with-tenant-model)\n+  - [References](#references)\n+\n+---\n+\n+## Overview\n+\n+HyperSpot uses **resource groups** as an optional organizational layer for grouping resources. The primary purpose is **access control** — granting permissions at the group level rather than per-resource.\n+\n+Vendors may implement various group types depending on their domain. Examples include:\n+\n+- Projects (task management, issue tracking)\n+- Workspaces (collaboration spaces)\n+- Folders (document organization with nesting)\n+- Teams, Departments, Campaigns, etc.\n+\n+The specific group types and their semantics are vendor-defined. HyperSpot provides the infrastructure for hierarchical grouping and membership resolution without prescribing what groups represent.\n+\n+```\n+Tenant T1\n+├── [Group A]\n+│   ├── Resource 1\n+│   ├── Resource 2\n+│   └── [Group A.1]\n+│       └── Resource 3\n+├── [Group B]\n+│   └── Resource 4\n+└── (ungrouped resources)","path":"docs/arch/authorization/RESOURCE_GROUP_MODEL.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"52bd329ddb1d645268e0f977a0d68406c3c272fe","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"changed, now the scheme shows the resource can be linked with multiple groups","created_at":"2026-01-30T08:51:50Z","updated_at":"2026-01-30T08:51:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745258944","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745258944"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745258944"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745258944/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":34,"original_start_line":34,"start_side":"RIGHT","line":43,"original_line":42,"side":"RIGHT","in_reply_to_id":2741434491,"author_association":"MEMBER","original_position":42,"position":43,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745369386","pull_request_review_id":3727215938,"id":2745369386,"node_id":"PRRC_kwDOPaLyBs6jowMq","diff_hunk":"@@ -0,0 +1,1514 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Projection Tables](#projection-tables)\n+  - [What Are Projection Tables?](#what-are-projection-tables)\n+  - [Choosing Projection Tables](#choosing-projection-tables)\n+  - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+  - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+  - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+  - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+  - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+  - [Combinations Summary](#combinations-summary)\n+- [Scenarios](#scenarios)\n+  - [With `tenant_closure`](#with-tenant_closure)\n+    - [S01: LIST, tenant subtree, PEP has tenant_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+    - [S02: GET, tenant subtree, PEP has tenant_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+    - [S03: UPDATE, tenant subtree, PEP has tenant_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+    - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+    - [S05: LIST, tenant subtree with barrier, PEP has tenant_closure](#s05-list-tenant-subtree-with-barrier-pep-has-tenant_closure)\n+  - [Without `tenant_closure`](#without-tenant_closure)\n+    - [S06: LIST, tenant subtree, PEP without tenant_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+    - [S07: GET, tenant subtree, PEP without tenant_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+    - [S08: UPDATE, tenant subtree, PEP without tenant_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+    - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+  - [Resource Groups](#resource-groups)\n+    - [S10: LIST, group membership, PEP has resource_group_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+    - [S11: LIST, group subtree, PEP has resource_group_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+    - [S12: UPDATE, group membership, PEP has resource_group_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+    - [S13: UPDATE, group subtree, PEP has resource_group_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+    - [S14: GET, group membership, PEP without resource_group_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+    - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+  - [Advanced Patterns](#advanced-patterns)\n+    - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+    - [S17: LIST, multiple access paths (OR)](#s17-list-multiple-access-paths-or)\n+    - [S18: Access denied](#s18-access-denied)\n+- [TOCTOU Analysis](#toctou-analysis)\n+- [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true,\n+      \"respect_barrier\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"respect_barrier\": true\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+    AND (barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1')\n+)\n+```\n+\n+---\n+\n+#### S02: GET, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+User requests a specific task; PEP enforces tenant subtree access at query level.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row → return task\n+- 0 rows → **404 Not Found** (hides resource existence from unauthorized users)\n+\n+---\n+\n+#### S03: UPDATE, tenant subtree, PEP has tenant_closure\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+User updates a task; constraint ensures atomic authorization check.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row affected → success\n+- 0 rows affected → **404 Not Found** (task doesn't exist or no access)\n+\n+---\n+\n+#### S04: CREATE, tenant context\n+\n+`POST /tasks`\n+\n+User creates a new task. No constraints needed — PDP just validates permission.\n+\n+**Request:**\n+```http\n+POST /tasks\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"title\": \"New Task\", \"owner_tenant_id\": \"T2\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T2\",\n+    \"require_constraints\": false,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**SQL:**\n+```sql\n+INSERT INTO tasks (id, owner_tenant_id, title, status)\n+VALUES ('task-new', 'T2', 'New Task', 'pending')\n+```\n+\n+**Note:** No constraints returned — `require_constraints: false` allows PEP to trust the decision for CREATE operations.\n+\n+---\n+\n+#### S05: LIST, tenant subtree with barrier, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true&respect_barrier=true`\n+\n+User in parent tenant T1 requests tasks, but child tenant T2 is self-managed (barrier). Tasks in T2 subtree should be excluded.\n+\n+**Tenant hierarchy:**\n+```\n+T1 (parent)\n+├── T2 (self_managed=true)  ← barrier\n+│   └── T3\n+└── T4\n+```\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true&respect_barrier=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true,\n+      \"respect_barrier\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"respect_barrier\": true\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+    AND (barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1')\n+)\n+```\n+\n+**Result:** Returns tasks from T1 and T4 only. Tasks from T2 and T3 are excluded because T2 is a barrier.\n+\n+**tenant_closure data example:**\n+\n+| ancestor_id | descendant_id | barrier_ancestor_id |\n+|-------------|---------------|---------------------|\n+| T1 | T1 | NULL |\n+| T1 | T2 | T2 |\n+| T1 | T3 | T2 |\n+| T1 | T4 | NULL |\n+| T2 | T2 | NULL |\n+| T2 | T3 | NULL |\n+\n+When querying from T1 with `respect_barrier=true`, only rows where `barrier_ancestor_id IS NULL OR barrier_ancestor_id = 'T1'` match → T1, T4.\n+\n+---\n+\n+### Without `tenant_closure`\n+\n+PEP has no tenant_closure table → PDP returns explicit IDs or PEP prefetches attributes.\n+\n+---\n+\n+#### S06: LIST, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. PDP resolves the subtree and returns explicit tenant IDs.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP resolves the subtree internally and returns explicit IDs:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"values\": [\"T1\", \"T2\", \"T3\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN ('T1', 'T2', 'T3')\n+```\n+\n+**Trade-off:** PDP must know the tenant hierarchy and resolve it. Works well for small tenant counts; may not scale for thousands of tenants.\n+\n+---\n+\n+#### S07: GET, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. For read-only operations, PEP fetches the resource first, then asks PDP for a decision based on resource attributes. No second query needed — TOCTOU is not a concern for reads.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**Step 1 — PEP fetches resource:**\n+```sql\n+SELECT * FROM tasks WHERE id = 'task-456'\n+```\n+Result: full task record with `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request (with resource properties):**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": false,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP validates that T2 is in T1's subtree and returns decision only (no constraints needed for read):\n+\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**Step 3 — Return result:**\n+- `decision: true` → return already-fetched task\n+- `decision: false` → **404 Not Found** (hides resource existence)\n+- Resource not found in Step 1 → **404 Not Found**\n+\n+**Why no TOCTOU concern:** For GET, the \"use\" is returning data to the client. Even if `owner_tenant_id` changed between check and response, no security violation occurs — the client either gets data they had access to at query time, or gets 404. For mutations (UPDATE/DELETE), see S08.\n+\n+---\n+\n+#### S08: UPDATE, tenant subtree, PEP without tenant_closure (prefetch)\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+Unlike S07 (GET), mutations require TOCTOU protection. PEP prefetches `owner_tenant_id`, gets `eq` constraint from PDP, and applies it in UPDATE's WHERE clause. This ensures atomic check-and-modify.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**Step 1 — PEP prefetches:**\n+```sql\n+SELECT owner_tenant_id FROM tasks WHERE id = 'task-456'\n+```\n+Result: `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T2\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Step 3 — SQL with constraint:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T2'\n+```\n+\n+**TOCTOU protection:** If another request changed `owner_tenant_id` between prefetch and UPDATE, the WHERE clause won't match → 0 rows affected → **404**. This prevents unauthorized modification even in a race condition.\n+\n+---\n+\n+#### S09: GET, context tenant only (no subtree)\n+\n+`GET /tasks/{id}`\n+\n+Simplest case — access limited to context tenant only, no subtree traversal. User can only access resources directly owned by their tenant.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": []\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+```\n+\n+**Note:** No prefetch needed, no closure table required. PDP returns direct `eq` constraint based on context tenant. This pattern applies when the endpoint operates within a single tenant context, regardless of whether the overall tenant model is hierarchical.\n+\n+---\n+\n+### Resource Groups\n+\n+> **Note:** Resource groups operate within tenant boundaries. All group-based constraints include a tenant predicate (typically `eq` on `owner_tenant_id`) to ensure tenant isolation. Groups don't bypass multi-tenancy — a user in T1 cannot access resources in T2's groups even if they somehow have group membership.\n+\n+---\n+\n+#### S10: LIST, group membership, PEP has resource_group_membership\n+\n+`GET /tasks`\n+\n+User has access to specific projects (flat group membership, no hierarchy).\n+\n+**Request:**\n+```http\n+GET /tasks\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_membership\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included — groups don't bypass tenant isolation:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group\",\n+            \"resource_property\": \"id\",\n+            \"group_ids\": [\"ProjectA\", \"ProjectB\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN ('ProjectA', 'ProjectB')\n+  )\n+```\n+\n+---\n+\n+#### S11: LIST, group subtree, PEP has resource_group_closure\n+\n+`GET /tasks`\n+\n+User has access to a project folder and all its subfolders.\n+\n+**Request:**\n+```http\n+GET /tasks\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"FolderA\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN (\n+      SELECT descendant_id FROM resource_group_closure\n+      WHERE ancestor_id = 'FolderA'\n+  )\n+)\n+```\n+\n+---\n+\n+#### S12: UPDATE, group membership, PEP has resource_group_membership\n+\n+`PUT /tasks/{id}`\n+\n+User updates a task; PEP has resource_group_membership table. Similar to tenant-based S03, but filtering by group membership.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_membership\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group\",\n+            \"resource_property\": \"id\",\n+            \"group_ids\": [\"ProjectA\", \"ProjectB\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN ('ProjectA', 'ProjectB')\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row affected → success\n+- 0 rows affected → task doesn't exist or not in user's accessible groups → **404**\n+\n+---\n+\n+#### S13: UPDATE, group subtree, PEP has resource_group_closure\n+\n+`PUT /tasks/{id}`\n+\n+User updates a task; PEP has both resource_group_membership and resource_group_closure tables.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_id\": \"T1\",\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"group_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+Tenant constraint is always included:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          },\n+          {\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"FolderA\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+  AND id IN (\n+    SELECT resource_id FROM resource_group_membership\n+    WHERE group_id IN (\n+      SELECT descendant_id FROM resource_group_closure\n+      WHERE ancestor_id = 'FolderA'\n+    )\n+  )\n+```\n+\n+---\n+\n+#### S14: GET, group membership, PEP without resource_group_membership\n+\n+`GET /tasks/{id}`\n+\n+PEP doesn't have resource_group_membership table. For read operations, PEP fetches the resource and sends group membership info to PDP for decision.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456\n+Authorization: Bearer <token>\n+```\n+\n+**Step 1 — PEP fetches resource with group info:**","path":"docs/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"9c0a36ed4cddfe6e5c21a1651c051284972691ce","original_commit_id":"4087d373a05859f20d6611fe8f76831ec5d57d93","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good catch, yes. Original idea was that PDP checks resource-group ownership itself using `resource_group_membership` projection table or via direct call to RG Resolver (it's internal implementation detail of AuthZ Resolver (PDP) plugin). Fixed.","created_at":"2026-01-30T09:23:25Z","updated_at":"2026-01-30T09:23:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745369386","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745369386"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745369386"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745369386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1121,"side":"RIGHT","in_reply_to_id":2740612089,"author_association":"MEMBER","original_position":1121,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745506937","pull_request_review_id":3727378269,"id":2745506937,"node_id":"PRRC_kwDOPaLyBs6jpRx5","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0\n+\n+- **Status**: Draft\n+- **Date**: 2026-01-21\n+- **Supersedes**: `modules/system/auth_resolver/docs/ADR.md` (proposed)\n+- **Decision Drivers**: AuthZEN standardization (approved 2026-01-12), vendor-neutral authorization, scalable query-time enforcement, pluggable modular architecture\n+\n+## Table of Contents\n+\n+- [Context](#context)\n+- [Decision](#decision)\n+- [AuthZEN Overview](#authzen-overview)\n+- [AuthZEN Gap Analysis](#authzen-gap-analysis)\n+- [Core Terms](#core-terms)\n+- [Integration Architecture](#integration-architecture)\n+- [API Specifications](#api-specifications)\n+  - [Access Evaluation API (AuthZEN-extended)](#access-evaluation-api-authzen-extended)\n+  - [Filter Types Reference](#filter-types-reference)\n+  - [Capabilities → Filter Matrix](#capabilities--filter-matrix)\n+- [PEP Enforcement](#pep-enforcement)\n+- [Rationale](#rationale)\n+- [Consequences](#consequences)\n+- [Open Questions](#open-questions)\n+\n+---\n+\n+## Context\n+\n+HyperSpot is a pluggable, modular platform intended to be embedded into multi-tenant vendor platforms. Each vendor can have its own identity provider (IdP), authorization model, and tenant service. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+On January 12, 2026, the OpenID Foundation approved [AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html), establishing a standard for authorization APIs. This ADR evaluates adopting AuthZEN as the foundation for HyperSpot's Auth Resolver.\n+\n+**Key requirement not fully addressed by AuthZEN**: HyperSpot modules need to enforce authorization at the **query level** (e.g., SQL WHERE clauses), not just perform point-in-time access checks. For LIST/query operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## Decision\n+\n+We adopt AuthZEN Authorization API 1.0 as the foundation for Auth Resolver, with a **HyperSpot-specific extension** for constraint-based authorization via the extended evaluation response:\n+\n+**Endpoints:**\n+- `POST /access/v1/evaluation` — Single evaluation (AuthZEN-extended)\n+- `POST /access/v1/evaluations` — Batch evaluation (AuthZEN-extended)\n+\n+**Response extension:**\n+- PDP returns `decision` plus optional `context.constraints` when `decision: true`","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"docs were completely reworked, PDP/PEP/PIP/etc are described now","created_at":"2026-01-30T10:00:37Z","updated_at":"2026-01-30T10:00:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745506937","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745506937"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745506937"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745506937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":46,"side":"RIGHT","in_reply_to_id":2718238386,"author_association":"MEMBER","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525327","pull_request_review_id":3727401877,"id":2745525327,"node_id":"PRRC_kwDOPaLyBs6jpWRP","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).\n+\n+3. **Seamless vendor integration** — HyperSpot must integrate into vendor's existing infrastructure without requiring significant changes on their side:\n+   - **No resource sync** — Resources stay in HyperSpot's DB; vendors don't need to replicate millions of resources or all their relationships to their authorization service\n+   - **No policy format requirements** — Vendors keep their existing policy storage (RBAC tables, ReBAC tuples, custom DSL); HyperSpot only defines the response contract\n+   - **Leverage existing infrastructure** — Works with vendor's IdP, tenant service, and policy manager as-is\n+\n+### PDP/PEP Architecture Model\n+\n+Industry best practices (NIST SP 800-162, XACML, AuthZEN) recommend separating authorization into:\n+\n+- **PDP (Policy Decision Point)** — Evaluates policies and returns access decisions. In HyperSpot, this is the vendor's authorization service accessed via AuthZ Resolver gateway.\n+- **PEP (Policy Enforcement Point)** — Enforces PDP decisions at resource access points. In HyperSpot, domain modules act as PEPs, with ModKit providing shared enforcement infrastructure.\n+- **PAP (Policy Administration Point)** — Where policies are authored and managed. This is entirely vendor-controlled (their admin UI, policy DSL, etc.). HyperSpot never sees or stores policies.\n+- **PIP (Policy Information Point)** — Provides additional attributes for decision-making (user roles, tenant hierarchy, resource metadata). In HyperSpot, Tenant Resolver and Resource Group Resolver serve as PIPs.\n+\n+Benefits of PDP/PEP separation:\n+\n+- Centralized policy management and auditability\n+- Consistent enforcement across all modules\n+- Separation of concerns (business logic vs authorization logic)\n+- Easier security audits and compliance\n+\n+HyperSpot modules act as PEPs; AuthZ Resolver integrates with vendor's PDP; Tenant/RG Resolvers act as PIPs.\n+\n+## Decision Drivers\n+\n+- **Performance** — O(1) authorization overhead per query, not O(N) per resource\n+- **Simplicity** — Module developers use shared ModKit library, not manual authorization code\n+- **Vendor integration** — No resource sync, no policy format requirements, leverage existing infrastructure\n+- **Vendor-neutral** — No assumption about policy model (RBAC/ABAC/ReBAC)\n+- **Standards-based** — Build on industry standards where possible\n+- **Query-time enforcement** — Authorization as SQL WHERE constraints, not post-fetch filtering\n+\n+## Considered Options\n+\n+- **Option A**: Module-level authorization (PEP = PDP)\n+- **Option B**: Google Zanzibar / ReBAC\n+- **Option C**: OpenID AuthZEN 1.0 (as-is)\n+- **Option D**: OPA Partial Evaluation\n+- **Option E**: OpenID AuthZEN 1.0 + Constraint Extensions\n+\n+## Decision Outcome\n+\n+Chosen option: **Option E - AuthZEN 1.0 + Constraint Extensions**, because it provides a standards-based foundation with targeted extensions for SQL-level constraint enforcement, maintaining vendor neutrality while solving the core architectural challenge of PDP not having access to resources.\n+\n+Implementation:\n+\n+- Use AuthZEN standard request/response structure\n+- Extend evaluation response with optional `context.constraints`\n+- Constraints contain typed filters (field, group_membership) with known operators (eq, in, in_closure)\n+- PEP compiles filters directly to SQL without intermediate translation\n+- Endpoints: `/access/v1/evaluation`, `/access/v1/evaluations`\n+","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# Search for caching references in authorization docs and ADRs\nrg -n \"cach\" docs/adrs/authorization/ docs/authorization/ 2>/dev/null | head -50\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 6636\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the structure of authorization docs\nfind docs/adrs/authorization/ docs/authorization/ -type f -name \"*.md\" 2>/dev/null | sort\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 444\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if AUTH.md exists and look for caching content\nfind docs -name \"AUTH.md\" -o -name \"auth.md\" 2>/dev/null | head -5\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 90\n\n---\n\n🏁 Script executed:\n\n```shell\n# Specifically check ADR 0001 for any cache-related content\ncat -n docs/adrs/authorization/0001-pdp-pep-authorization-model.md 2>/dev/null | grep -i cache\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if ADR 0002 exists and search for caching mentions\nif [ -f docs/adrs/authorization/0002-*.md ]; then\n  ls -la docs/adrs/authorization/0002-*.md\n  echo \"---\"\n  cat -n docs/adrs/authorization/0002-*.md | grep -i -B2 -A2 cache\nfi\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3149\n\n---\n\n\n\n</details>\n\n**Caching strategy documented but incomplete in AUTH.md.**\n\nCaching is addressed in `docs/authorization/AUTH.md` (lines 624-641), not in this ADR. However, AUTH.md explicitly states: \"Status: Requires further design work. This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\"\n\nThe section covers mandatory caching requirements (consistency, scope isolation by token) but leaves several questions open: cache-control protocol, TTL negotiation, and invalidation signals.\n\nADR 0001 focuses on the AuthZEN architectural choice, while caching strategy is appropriately documented at the implementation level in AUTH.md. If caching design is critical to validate this decision, either:\n1. Reference AUTH.md's caching section from this ADR's consequences, or\n2. Complete the caching strategy design in AUTH.md before finalizing the architectural decision\n\nADR 0002 separately addresses caching differences between AuthN and AuthZ (lines 30-32), providing orthogonal guidance.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/adrs/authorization/0001-pdp-pep-authorization-model.md` around lines 59\n- 70, The ADR omits/does not reference the incomplete caching design in AUTH.md;\nupdate the ADR's \"Decision Outcome\" or \"Consequences\" to explicitly reference\nthe AUTH.md caching section (lines describing \"Status: Requires further design\nwork\") and either note that caching protocol details (cache-control metadata,\nTTL negotiation, invalidation signals) are deferred to AUTH.md or state that\nthose details must be completed before finalizing Option E (AuthZEN +\ncontext.constraints). Specifically mention AuthZEN, the extended evaluation\nresponse field context.constraints, and the endpoints (/access/v1/evaluation,\n/access/v1/evaluations) so reviewers can see caching implications for PDP/PEP\ninteractions and token-scoped caches, or alternatively require completing\nAUTH.md caching design prior to accepting ADR 0001.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 870dc98","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-02-02T15:04:46Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525327","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525327"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525327"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525327/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":59,"original_start_line":59,"start_side":"RIGHT","line":70,"original_line":70,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":70,"position":70,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525335","pull_request_review_id":3727401877,"id":2745525335,"node_id":"PRRC_kwDOPaLyBs6jpWRX","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Tenant context (from request header/query param) — use ONE of: tenant_id OR tenant_subtree\n+    // \"tenant_id\": \"...\",  // Option 1: single tenant\n+    \"tenant_subtree\": {     // Option 2: tenant subtree\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // request header: X-Tenant-Id\n+      \"include_root\": true,        // request param, default: true\n+      \"barrier_mode\": \"all\",       // request param, default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // request param, optional\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: bearer_token is a credential — PDP MUST NOT log it or persist it.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+\n+---\n+\n+### Capabilities -> Predicate Matrix\n+\n+The PEP declares its capabilities in the request. This determines what predicate types the PDP can return.\n+\n+#### `require_constraints` Flag\n+\n+The `require_constraints` field (separate from capabilities array) controls PEP behavior when constraints are absent:\n+\n+| `require_constraints` | `decision: true` without `constraints` |\n+|-----------------------|----------------------------------------|\n+| `true` | **deny** (constraints required but missing) |\n+| `false` | **allow** (trust PDP decision) |\n+\n+**Usage:**\n+- For LIST operations: typically `true` (constraints needed for SQL WHERE)\n+- For CREATE operations: typically `false` (no query, just permission check)\n+- For GET/UPDATE/DELETE: depends on whether PEP wants SQL-level enforcement or trusts PDP decision\n+\n+#### Capabilities Array\n+\n+Capabilities declare what predicate types the PEP can enforce locally:\n+\n+| Capability | Enables Predicate Types |\n+|------------|---------------------|\n+| `tenant_hierarchy` | `in_tenant_subtree` |\n+| `group_membership` | `in_group` |\n+| `group_hierarchy` | `in_group_subtree` (implies `group_membership`) |\n+\n+**Capability dependencies:**\n+- `group_hierarchy` implies `group_membership` — if PEP has the closure table, it necessarily has the membership table\n+- When declaring capabilities, `[\"group_hierarchy\"]` is sufficient; `group_membership` is implied\n+\n+**Predicate type availability by capability:**\n+\n+| Predicate Type | Required Capability |\n+|-------------|---------------------|\n+| `eq`, `in` | (none — always available) |\n+| `in_tenant_subtree` | `tenant_hierarchy` |\n+| `in_group` | `group_membership` |\n+| `in_group_subtree` | `group_hierarchy` |\n+\n+**Capability degradation**: If a PEP lacks a capability, the PDP must either:\n+1. Expand the predicate to explicit IDs (may be large)\n+2. Return `decision: false` if expansion is not feasible\n+\n+---\n+\n+### Table Schemas (Local Projections)\n+\n+These tables are maintained locally by HyperSpot gateway modules (Tenant Resolver, Resource Group Resolver) and used by PEPs to execute constraint queries efficiently without calling back to the vendor platform.\n+\n+#### `tenant_closure`\n+\n+Denormalized closure table for tenant hierarchy. Enables efficient subtree queries without recursive CTEs.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent tenant in the hierarchy |\n+| `descendant_id` | UUID | No | Child tenant (the one we check ownership against) |\n+| `barrier` | INT | No | 0 = no barrier on path, 1 = barrier exists between ancestor and descendant (default 0) |\n+| `descendant_status` | TEXT | No | Status of descendant tenant (`active`, `suspended`, `deleted`) |\n+\n+**Notes:**\n+- Status is denormalized into closure for query simplicity (avoids JOIN). When a tenant's status changes, all rows where it is `descendant_id` are updated.\n+- **Barrier semantics:** The `barrier` column stores barriers **strictly between** ancestor and descendant, **not including the ancestor itself**. This means when T2 is self_managed, rows with `ancestor_id = T2` have `barrier = 0`, while rows with T2 on the path from another ancestor have `barrier = 1`.\n+- The `barrier` column enables simple filtering: `barrier_mode: \"all\"` adds `AND barrier = 0`, `barrier_mode: \"none\"` omits the clause.\n+- Self-referential rows exist: each tenant has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_tenant_subtree` predicate compiles to SQL using this closure table.\n+- **Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types (e.g., `(barrier & mask) = 0` for selective enforcement).\n+\n+**Example query (in_tenant_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = :root_tenant_id\n+    AND barrier = 0  -- barrier_mode: \"all\"\n+    AND descendant_status IN ('active', 'suspended')  -- tenant_status filter\n+)\n+```\n+\n+#### `resource_group_closure`\n+\n+Closure table for resource group hierarchy. Similar structure to tenant_closure but simpler (no barrier or status).\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent group |\n+| `descendant_id` | UUID | No | Child group |\n+\n+**Notes:**\n+- Self-referential rows exist: each group has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_group_subtree` predicate compiles to SQL using this closure table.\n+\n+#### `resource_group_membership`\n+\n+Association between resources and groups. A resource can belong to multiple groups.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `resource_id` | UUID | No | ID of the resource (FK to resource table) |\n+| `group_id` | UUID | No | ID of the group (FK to resource_group_closure) |\n+\n+**Notes:**\n+- The `resource_id` column joins with the resource table's ID column (configurable per module, default `id`).\n+- **Predicate mapping:** `in_group` and `in_group_subtree` predicates use this table for the resource-to-group join.\n+\n+**Example query (in_group_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE id IN (\n+  SELECT resource_id FROM resource_group_membership\n+  WHERE group_id IN (\n+    SELECT descendant_id FROM resource_group_closure\n+    WHERE ancestor_id = :root_group_id\n+  )\n+)\n+```\n+\n+---\n+\n+### Usage Scenarios\n+\n+For concrete examples demonstrating the authorization model in practice, see [AUTHZ_USAGE_SCENARIOS.md](./AUTHZ_USAGE_SCENARIOS.md).\n+\n+---\n+\n+## Open Questions\n+\n+1. **Batch evaluation optimization** - We support `/access/v1/evaluations` for batch requests. Should PDP optimize constraint generation when multiple evaluations share the same subject/context? Use cases: bulk operations, permission checks for UI rendering (checking permissions for 50 list items at once).\n+\n+---\n+\n+## References\n+\n+### Authentication\n+- [AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md) — JWT + OIDC plugin reference implementation\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+### Authorization\n+- [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12)\n+- [ADR 0001: PDP/PEP Authorization Model](../adrs/authorization/0001-pdp-pep-authorization-model.md)\n+- [ADR 0002: Split AuthN and AuthZ Resolvers](../adrs/authorization/0002-split-authn-authz-resolvers.md)\n+\n+### Internal\n+- [TENANT_MODEL.md](./TENANT_MODEL.md) — Tenant topology, barriers, closure tables\n+- [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) — Resource group topology, membership, hierarchy\n+- [AUTHZ_USAGE_SCENARIOS.md](./AUTHZ_USAGE_SCENARIOS.md) — Authorization usage scenarios","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Overall assessment: Architecturally solid, but operational gaps must be addressed.**\n\nThis is a comprehensive and well-structured design document with strong architectural decisions (constraint-based enforcement, AuthZEN extensions, fail-closed rules). The separation of AuthN/AuthZ, plugin architecture, and extensibility design are excellent.\n\n**Strengths:**\n- Clear separation of concerns (PDP/PEP, AuthN/AuthZ)\n- Well-specified predicate types and SQL compilation\n- Thorough security considerations (fail-closed, token handling, trust boundaries)\n- Extensibility (custom predicates, vendor-neutral scopes)\n- Good use of diagrams and examples\n\n**Critical gaps requiring resolution before implementation:**\n\n**Priority 1 (Blocking):**\n1. **Policy representation** - How are authorization rules stored and represented in PDP? (see comment on lines 119-122)\n2. **Resource property schema contract** - How does PDP know valid properties for resource types? (see comment on lines 1039-1064)\n3. **Caching strategy** - Currently marked TODO, but critical for performance (see comment on lines 622-645)\n\n**Priority 2 (Important):**\n4. **Schema evolution** - Closure table migration coordination (see comment on lines 1114-1185)\n5. **Token vs policy justification** - Why not encode rules in tokens? (see comment on lines 47-59)\n6. **Middleware authz strategy** - Clarify fail-fast approach (see comment on lines 86-89)\n\n**Priority 3 (Nice to have):**\n7. **Empty constraints array** - Minor clarification needed (see comment on lines 607-619)\n8. **Token scope intersection** - How PDP implements scope narrowing (see comment on lines 234-293)\n9. **Trust model clarity** - When bearer_token is omitted (see comment on lines 224-232)\n\n**Recommendation:** Address Priority 1 items before proceeding with implementation. Consider creating separate ADRs for caching strategy and schema contract specification, as these are complex topics affecting multiple components.\n\nThe reviewer's concerns (API tokens, handler flow, PDP rules, caching, schema coupling) are valid and should be systematically addressed in the next revision.\n\n\n\nWould you like me to draft initial specifications for any of the Priority 1 gaps (policy representation, schema contract, or caching strategy)?\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Gitleaks (8.30.0)</summary>\n\n[high] 726-726: Detected a Generic API Key, potentially exposing access to various services and sensitive operations.\n\n(generic-api-key)\n\n</details>\n<details>\n<summary>🪛 LanguageTool</summary>\n\n[grammar] ~1212-~1212: Ensure spelling is correct\nContext: ...-model.md) - [ADR 0002: Split AuthN and AuthZ Resolvers](../adrs/authorization/0002-split-authn-authz-resolvers.md)  ### Internal - [TENANT_MODEL.md](./TENANT_MO...\n\n(QB_NEW_EN_ORTHOGRAPHY_ERROR_IDS_1)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 1 - 1217, Summary: The doc misses\nconcrete specs for (1) policy representation in the PDP, (2) the resource\nproperty schema contract between PDP and PEP, and (3) a production-ready caching\nstrategy for authorization decisions. Fix: add three focused subsections (or\nseparate ADRs) under Authorization that (A) define \"Policy Representation\"\ndescribing how rules are modeled/stored in the PDP (policy format, identifiers,\nversioning, evaluation inputs/outputs and sample rule->constraint compilation),\n(B) author a \"Resource Property Schema Contract\" that formalizes the property\nnamespace, type system, validation rules and the mapping from\npredicate.resource_property to PEP column names (include negotiation/extension\nmechanism and mention resource_property, context.constraints and\nrequire_constraints), and (C) provide an \"Authorization Decision Caching\"\nspecification detailing cache-key composition (include token_scopes, subject_id,\nsubject_tenant_id, require_constraints, capabilities, PDP cache TTL semantics\nand token exp boundary), invalidation strategy, and security constraints;\nreference the AuthZ Resolver / PDP and PEP / require_constraints terminology so\nreviewers can locate where to integrate these additions.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-01-30T10:05:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525335","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525335"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525335"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":1343,"original_line":1217,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1217,"position":1343,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525340","pull_request_review_id":3727401877,"id":2745525340,"node_id":"PRRC_kwDOPaLyBs6jpWRc","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_🛠️ Refactor suggestion_ | _🟠 Major_\n\n**Clarify middleware-level authorization strategy.**\n\nThe reviewer asked: \"Is there a fail-fast role check at middleware level, and would that middleware call AuthZEN?\"\n\nThe document shows middleware handles only authentication (lines 325-329), with all authorization delegated to handlers (PEPs). Consider explicitly addressing:\n\n1. **No middleware-level authz** - If middleware doesn't perform any authorization checks, state this explicitly and explain why (flexibility, per-operation policies, avoid double PDP calls)\n2. **Optional gateway-level scope checks** - Lines 295-317 describe optional coarse-grained scope checks at gateway level, but relationship to middleware is unclear\n3. **When to fail fast** - Clarify when PEP should call PDP (before or after fetching resource for point operations)\n\nRecommendation: Add a \"Middleware vs Handler Authorization\" subsection explaining that middleware extracts SecurityContext (AuthN only), while handlers perform all authorization checks (AuthZ), with optional gateway-level scope filtering for performance.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 86 - 89, Add a new \"Middleware vs\nHandler Authorization\" subsection that explicitly states the AuthN Middleware\nonly extracts and validates identity and produces SecurityContext (no\nmiddleware-level AuthZ/fail-fast role checks), explains that Module Handler\n(PEP) is responsible for building AuthZ requests and invoking the AuthZ Resolver\n(PDP) for per-operation policies, clarifies that optional gateway-level scope\nchecks are coarse-grained and may be applied before handlers for performance but\nare not a replacement for handler-level PDP evaluation, and state when to fail\nfast: PEP should invoke PDP before performing sensitive point operations (i.e.,\nbefore fetching/modifying a specific resource) but can defer PDP until after\ncoarse filtering for list/aggregate operations to avoid unnecessary PDP calls.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit fac409b","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-01-30T13:56:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525340","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525340"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525340"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525340/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":86,"original_start_line":86,"start_side":"RIGHT","line":89,"original_line":89,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":89,"position":89,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525342","pull_request_review_id":3727401877,"id":2745525342,"node_id":"PRRC_kwDOPaLyBs6jpWRe","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Critical gap: How are authorization policies stored and represented in the PDP?**\n\nThe reviewer asked: \"How authorization rules will appear in the PDP service?\" This is not addressed in the document.\n\nThe document thoroughly describes:\n- What the PDP returns (constraints via AuthZEN evaluation)\n- What the PDP does (policy evaluation, constraint generation)\n\nBut does NOT describe:\n- **Policy storage format** - How are policies persisted? (database, files, external policy store)\n- **Policy representation** - What syntax/structure? (RBAC rules, ABAC conditions, ReBAC tuples, Rego policies, Cedar policies)\n- **Policy authoring** - Who creates policies? Via what interface? (UI, API, configuration files)\n- **Policy versioning** - How are policy changes tracked and deployed?\n\nWhile policy format may be vendor-specific (implemented in AuthZ Resolver Plugin), the document should specify:\n1. **Minimum requirements** - What must vendor plugins support to generate valid constraints?\n2. **Example policy** - Show a concrete example mapping \"user in role X can read events in tenant subtree Y\" → constraint predicates\n3. **Policy-to-constraint mapping** - Explain how vendor translates their policy model to SQL predicates\n\nWithout this, implementers cannot understand how to author policies or validate that their PDP integration is correct.\n\n\n\nWould you like me to draft a \"Policy Representation\" section with example policy structures and constraint generation logic?\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 119 - 122, Add a \"Policy\nRepresentation\" section to the AuthZ docs that specifies how authorization\npolicies are stored, authored, versioned, and represented in the PDP: describe\nsupported storage options (DB/files/external store), policy syntaxes to support\n(RBAC, ABAC, ReBAC, Rego/Cedar examples), authoring interfaces (UI/API/CLI), and\nversioning/deployment expectations; state minimum requirements for AuthZ\nResolver plugin implementers (e.g., must accept subject/action/resource/context,\nexpose policy IDs/versions, and return AuthZEN-compatible decisions and\nmetadata); include a concrete example mapping \"user in role X can read events in\ntenant subtree Y\" to the exact constraint predicate(s) and show how the plugin\nuses Tenant Resolver and RG Resolver during policy-to-constraint translation;\nfinally, explain the required policy-to-constraint translation contract (how to\nsurface attributes, constraints format, error handling, and metadata required by\nAuthZEN evaluation).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit fac409b","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-01-30T13:56:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525342","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525342"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525342"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525342/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":119,"original_start_line":119,"start_side":"RIGHT","line":122,"original_line":122,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":122,"position":122,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525343","pull_request_review_id":3727401877,"id":2745525343,"node_id":"PRRC_kwDOPaLyBs6jpWRf","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_🛠️ Refactor suggestion_ | _🟠 Major_\n\n**Clarify semantics of empty constraints array.**\n\nThe fail-closed rules thoroughly cover empty/missing predicates (line 616), but one case is ambiguous:\n\n**What if `constraints: []` (empty array)?**\n\nLine 611 states: \"require_constraints: true and decision: true but **no constraints** -> deny all\"\n\nDoes \"no constraints\" mean:\n1. Field absent: `{ \"decision\": true }` (no `constraints` field)\n2. Empty array: `{ \"decision\": true, \"context\": { \"constraints\": [] } }`\n3. Both?\n\n**Recommendation:** Clarify that both cases should deny access when `require_constraints: true`. Semantically, empty array means \"OR of zero constraints = false,\" so it should be treated identically to absent field.\n\nSuggested addition to line 611:\n```diff\n-2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but `constraints` field is absent or empty array -> deny all (403 Forbidden)\n```\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 607 - 619, Clarify that when\nrequire_constraints is true the PEP must treat both a missing constraints field\nand an explicit empty constraints array the same (deny all): update the rule for\n\"require_constraints\" to state that `{ \"decision\": true }` and `{ \"decision\":\ntrue, \"context\": { \"constraints\": [] } }` are equivalent and must result in 403\n(fail-closed); reference the PEP behavior around `require_constraints`,\n`constraints`, and `decision` so readers know empty arrays are interpreted as\n\"OR of zero constraints = false\" and therefore deny access.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 870dc98","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-02-02T15:04:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525343","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525343"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525343"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":628,"original_start_line":607,"start_side":"RIGHT","line":641,"original_line":619,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":619,"position":641,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525351","pull_request_review_id":3727401877,"id":2745525351,"node_id":"PRRC_kwDOPaLyBs6jpWRn","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Tenant context (from request header/query param) — use ONE of: tenant_id OR tenant_subtree\n+    // \"tenant_id\": \"...\",  // Option 1: single tenant\n+    \"tenant_subtree\": {     // Option 2: tenant subtree\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // request header: X-Tenant-Id\n+      \"include_root\": true,        // request param, default: true\n+      \"barrier_mode\": \"all\",       // request param, default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // request param, optional\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: bearer_token is a credential — PDP MUST NOT log it or persist it.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# First, get the file size and explore the AUTH.md structure\nwc -l docs/authorization/AUTH.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 95\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for schema-related content, property definitions, and versioning information\nrg -n \"schema|property.*definition|resource.*type|version|compatibility\" docs/authorization/AUTH.md | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1451\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look specifically around line 618 (fail-closed behavior)\nsed -n '610,630p' docs/authorization/AUTH.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1591\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check around lines 890-905 (predicate extensibility)\nsed -n '885,910p' docs/authorization/AUTH.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1441\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check for any \"Resource Schema\" or \"Contract\" sections\nrg -n \"Resource.*Schema|Contract|property.*name.*resource|resource.*property\" docs/authorization/AUTH.md -A 3\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 6524\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for custom properties or vendor extension documentation\nrg -n \"custom.*propert|vendor.*extension|extension.*property|register.*property\" docs/authorization/AUTH.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 472\n\n---\n\n\n\n</details>\n\n**Add formal resource property schema contract and custom property registration mechanism.**\n\nThe documentation correctly states (line 1041) that \"PDP uses property names — **it doesn't know the database schema**,\" establishing good separation of concerns. However, this raises critical unanswered questions:\n\n**1. How does PDP know valid property names for a given resource type?**\nThe document shows property → column mappings (lines 1043–1049) but does not specify a schema registry or discovery mechanism. Policy authors must somehow \"know\" which properties exist for `resource.type: \"gts.x.events.event.v1~\"`.\n\n**2. Custom property registration is undocumented.**\nLines 894–905 explain how vendors can extend the system with custom *predicate types*, but not custom *resource properties*. If a vendor adds a new property (e.g., `priority`), how is this communicated to PDP?\n\n**3. Version skew and schema evolution are not addressed.**\n- What happens when PDP (v1) returns a property name that PEP (v2) no longer recognizes? (Line 626 says fail-closed, but this should be explicit.)\n- How do vendors safely add or remove properties when PDP and PEP are upgraded separately?\n\n**4. No formal schema contract exists.**\nThe document needs a \"Resource Property Schema Contract\" section specifying:\n- Resource type → valid properties mapping\n- Property definitions (type, required, description)\n- Who maintains this schema (PEP module)\n- How it's communicated to PDP (API discovery, config, compile-time constant?)\n- Compatibility guarantees (what guarantees hold across versions?)\n\nAdd this documentation before final release, particularly for vendors implementing custom AuthZ resolvers.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 1039 - 1064, The docs lack a formal\n\"Resource Property Schema Contract\" and a custom property registration\nmechanism: add a new section titled \"Resource Property Schema Contract\" (placed\nnear the PEP Property Mapping content) that defines for each resource.type the\nvalid resource_property names and their metadata (type, required, description),\nspecify that PEP modules own and maintain the schema, document how PEP\ncommunicates valid properties to PDP (e.g., discovery API, config file, or\ncompile-time manifest), describe a vendor-facing registration process for custom\nproperties (how to register priority → column mapping with the PEP and surface\nto PDP), and specify version/compatibility rules including explicit fail-closed\nbehavior when PDP returns unknown properties and guidance for safe schema\nevolution and upgrades between PDP/PEP versions; reference resource.properties,\nresource_property, PEP, PDP, and the predicate types (e.g., in_group,\nin_tenant_subtree) when giving examples.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit fac409b","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-01-30T13:56:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525351","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525351"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525351"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525351/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1139,"original_start_line":1039,"start_side":"RIGHT","line":1166,"original_line":1064,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1064,"position":1166,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525355","pull_request_review_id":3727401877,"id":2745525355,"node_id":"PRRC_kwDOPaLyBs6jpWRr","diff_hunk":"@@ -0,0 +1,1218 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Tenant context (from request header/query param) — use ONE of: tenant_id OR tenant_subtree\n+    // \"tenant_id\": \"...\",  // Option 1: single tenant\n+    \"tenant_subtree\": {     // Option 2: tenant subtree\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // request header: X-Tenant-Id\n+      \"include_root\": true,        // request param, default: true\n+      \"barrier_mode\": \"all\",       // request param, default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // request param, optional\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: bearer_token is a credential — PDP MUST NOT log it or persist it.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+\n+---\n+\n+### Capabilities -> Predicate Matrix\n+\n+The PEP declares its capabilities in the request. This determines what predicate types the PDP can return.\n+\n+#### `require_constraints` Flag\n+\n+The `require_constraints` field (separate from capabilities array) controls PEP behavior when constraints are absent:\n+\n+| `require_constraints` | `decision: true` without `constraints` |\n+|-----------------------|----------------------------------------|\n+| `true` | **deny** (constraints required but missing) |\n+| `false` | **allow** (trust PDP decision) |\n+\n+**Usage:**\n+- For LIST operations: typically `true` (constraints needed for SQL WHERE)\n+- For CREATE operations: typically `false` (no query, just permission check)\n+- For GET/UPDATE/DELETE: depends on whether PEP wants SQL-level enforcement or trusts PDP decision\n+\n+#### Capabilities Array\n+\n+Capabilities declare what predicate types the PEP can enforce locally:\n+\n+| Capability | Enables Predicate Types |\n+|------------|---------------------|\n+| `tenant_hierarchy` | `in_tenant_subtree` |\n+| `group_membership` | `in_group` |\n+| `group_hierarchy` | `in_group_subtree` (implies `group_membership`) |\n+\n+**Capability dependencies:**\n+- `group_hierarchy` implies `group_membership` — if PEP has the closure table, it necessarily has the membership table\n+- When declaring capabilities, `[\"group_hierarchy\"]` is sufficient; `group_membership` is implied\n+\n+**Predicate type availability by capability:**\n+\n+| Predicate Type | Required Capability |\n+|-------------|---------------------|\n+| `eq`, `in` | (none — always available) |\n+| `in_tenant_subtree` | `tenant_hierarchy` |\n+| `in_group` | `group_membership` |\n+| `in_group_subtree` | `group_hierarchy` |\n+\n+**Capability degradation**: If a PEP lacks a capability, the PDP must either:\n+1. Expand the predicate to explicit IDs (may be large)\n+2. Return `decision: false` if expansion is not feasible\n+\n+---\n+\n+### Table Schemas (Local Projections)\n+\n+These tables are maintained locally by HyperSpot gateway modules (Tenant Resolver, Resource Group Resolver) and used by PEPs to execute constraint queries efficiently without calling back to the vendor platform.\n+\n+#### `tenant_closure`\n+\n+Denormalized closure table for tenant hierarchy. Enables efficient subtree queries without recursive CTEs.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent tenant in the hierarchy |\n+| `descendant_id` | UUID | No | Child tenant (the one we check ownership against) |\n+| `barrier` | INT | No | 0 = no barrier on path, 1 = barrier exists between ancestor and descendant (default 0) |\n+| `descendant_status` | TEXT | No | Status of descendant tenant (`active`, `suspended`, `deleted`) |\n+\n+**Notes:**\n+- Status is denormalized into closure for query simplicity (avoids JOIN). When a tenant's status changes, all rows where it is `descendant_id` are updated.\n+- **Barrier semantics:** The `barrier` column stores barriers **strictly between** ancestor and descendant, **not including the ancestor itself**. This means when T2 is self_managed, rows with `ancestor_id = T2` have `barrier = 0`, while rows with T2 on the path from another ancestor have `barrier = 1`.\n+- The `barrier` column enables simple filtering: `barrier_mode: \"all\"` adds `AND barrier = 0`, `barrier_mode: \"none\"` omits the clause.\n+- Self-referential rows exist: each tenant has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_tenant_subtree` predicate compiles to SQL using this closure table.\n+- **Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types (e.g., `(barrier & mask) = 0` for selective enforcement).\n+\n+**Example query (in_tenant_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = :root_tenant_id\n+    AND barrier = 0  -- barrier_mode: \"all\"\n+    AND descendant_status IN ('active', 'suspended')  -- tenant_status filter\n+)\n+```\n+\n+#### `resource_group_closure`\n+\n+Closure table for resource group hierarchy. Similar structure to tenant_closure but simpler (no barrier or status).\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent group |\n+| `descendant_id` | UUID | No | Child group |\n+\n+**Notes:**\n+- Self-referential rows exist: each group has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_group_subtree` predicate compiles to SQL using this closure table.\n+\n+#### `resource_group_membership`\n+\n+Association between resources and groups. A resource can belong to multiple groups.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `resource_id` | UUID | No | ID of the resource (FK to resource table) |\n+| `group_id` | UUID | No | ID of the group (FK to resource_group_closure) |\n+\n+**Notes:**\n+- The `resource_id` column joins with the resource table's ID column (configurable per module, default `id`).\n+- **Predicate mapping:** `in_group` and `in_group_subtree` predicates use this table for the resource-to-group join.\n+\n+**Example query (in_group_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE id IN (\n+  SELECT resource_id FROM resource_group_membership\n+  WHERE group_id IN (\n+    SELECT descendant_id FROM resource_group_closure\n+    WHERE ancestor_id = :root_group_id\n+  )\n+)\n+```\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_🛠️ Refactor suggestion_ | _🟠 Major_\n\n**Specify closure table schema evolution and migration strategy.**\n\nLines 1116 states closure tables are \"maintained locally by HyperSpot gateway modules,\" but doesn't address schema evolution:\n\n**Scenario: Closure table schema change**\n- Suppose `tenant_closure` needs a new column (e.g., `path_length` for optimization)\n- All PEPs depend on these tables for SQL compilation\n- How is schema upgrade coordinated across modules?\n\n**Required specification:**\n\n1. **Schema versioning** - How are closure table schemas versioned? (e.g., `tenant_closure_v1`, `tenant_closure_v2`?)\n\n2. **Migration protocol** - How do gateway modules (Tenant Resolver, RG Resolver) signal schema updates to PEPs?\n\n3. **Backward compatibility** - Can old PEPs work with new closure table schema? Or must all modules upgrade atomically?\n\n4. **Future extensibility note** - Lines 983, 1135 mention `barrier` column is INT for \"future use as a bitmask.\" Excellent forward-thinking design. But when that future arrives, how will PEPs learn about new barrier modes?\n\n**Recommendation:** Add a \"Schema Evolution\" subsection addressing:\n- Closure table schema is controlled by gateway modules (single source of truth)\n- PEPs treat closure tables as read-only projections (never directly modify)\n- Schema changes require coordinated upgrade of gateway + all PEPs\n- Alternative: Use schema migration framework (e.g., Flyway) with version checks\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 1114 - 1185, The docs lack a \"Schema\nEvolution\" subsection for closure tables; add a short subsection that declares\n(1) schema versioning approach (e.g., semantic table versions or a\nschema_version meta-table) and names the affected tables (tenant_closure,\nresource_group_closure, resource_group_membership), (2) a migration protocol\ndescribing how gateway modules (Tenant Resolver, Resource Group Resolver)\nannounce schema changes to PEPs (version checks at startup, feature flags, or\nmigration scripts), (3) backward-compatibility rules (read-only projections,\ncompatibility guarantees or required coordinated upgrades vs. multi-version\nsupport), and (4) how future changes to barrier semantics will be signaled to\nPEPs (schema version bump + capability/feature flag). Keep it concise and\nprocedural so PEP authors know to perform version checks and follow the\nmigration protocol.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 785f54d","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-02-02T18:04:21Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525355","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525355"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525355"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525355/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1216,"original_start_line":1114,"start_side":"RIGHT","line":1287,"original_line":1185,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1185,"position":1287,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525358","pull_request_review_id":3727401877,"id":2745525358,"node_id":"PRRC_kwDOPaLyBs6jpWRu","diff_hunk":"@@ -0,0 +1,696 @@\n+# AuthN Resolver: JWT + OIDC Plugin Reference Implementation\n+\n+## Overview\n+\n+This document describes the **reference implementation** of an AuthN Resolver plugin that supports:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens validated locally via signature verification (RFC 7519)\n+- **Opaque tokens** — Validated via Token Introspection endpoint (RFC 7662)\n+- **OpenID Connect** — Auto-configuration via Discovery (OpenID Connect Core 1.0, Discovery 1.0)\n+\n+**Scope:** This is ONE possible implementation of the `AuthNResolverPluginClient` trait. Vendors may implement different authentication strategies (mTLS, API keys, custom protocols) without following this design.\n+\n+**Use case:** This plugin is suitable for vendors with standard OIDC-compliant Identity Providers that issue JWTs and support token introspection. It ships as part of HyperSpot's standard distribution and can be configured for most OAuth 2.0 / OIDC providers.\n+\n+**Standards:**\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+---\n+\n+## Supported Token Formats\n+\n+**JWT (JSON Web Token):**\n+- **Structure:** Three base64url-encoded segments separated by dots (`header.payload.signature`)\n+- **Contains:** Claims (subject, issuer, expiration, custom fields)\n+- **Validation:** Signature verification via JWKS (JSON Web Key Set)\n+- **Use case:** Self-contained tokens for distributed systems, offline validation\n+\n+**Opaque Tokens:**\n+- **Structure:** Arbitrary string (no internal structure)\n+- **Contains:** No claims (reference to IdP state)\n+- **Validation:** Token Introspection endpoint call\n+- **Use case:** Revocation-sensitive flows, tokens with sensitive claims\n+\n+**Token Type Detection:**\n+- **JWT:** Identified by structure (three base64url segments separated by dots)\n+- **Opaque:** All other formats\n+","path":"docs/arch/authorization/AUTHN_JWT_OIDC_PLUGIN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify API token handling and scope.**\n\nThe document describes JWT and opaque tokens but doesn't mention API tokens (e.g., long-lived access keys, PATs). This leaves ambiguity about whether:\n1. API tokens are treated as opaque tokens (validated via introspection)\n2. API tokens require a separate plugin/authentication mechanism\n3. API tokens are out of scope for this plugin\n\n\n\nPer reviewer feedback, explicitly document how API tokens fit into the authentication model. If they're opaque tokens validated via introspection, state that. If they require separate handling, clarify the boundary.\n\n<details>\n<summary>📝 Suggested addition</summary>\n\nAfter line 39, add:\n\n```diff\n+\n+**API Tokens (Long-Lived Access Keys):**\n+- **Structure:** Opaque string (vendor-specific format)\n+- **Validation:** Treated as opaque tokens, validated via introspection endpoint\n+- **Use case:** Service-to-service authentication, CLI tools, CI/CD pipelines\n+- **Note:** API tokens use the same introspection flow as other opaque tokens. Vendors may use different introspection endpoints or validation logic for API tokens vs. user tokens.\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n## Supported Token Formats\n\n**JWT (JSON Web Token):**\n- **Structure:** Three base64url-encoded segments separated by dots (`header.payload.signature`)\n- **Contains:** Claims (subject, issuer, expiration, custom fields)\n- **Validation:** Signature verification via JWKS (JSON Web Key Set)\n- **Use case:** Self-contained tokens for distributed systems, offline validation\n\n**Opaque Tokens:**\n- **Structure:** Arbitrary string (no internal structure)\n- **Contains:** No claims (reference to IdP state)\n- **Validation:** Token Introspection endpoint call\n- **Use case:** Revocation-sensitive flows, tokens with sensitive claims\n\n**Token Type Detection:**\n- **JWT:** Identified by structure (three base64url segments separated by dots)\n- **Opaque:** All other formats\n\n**API Tokens (Long-Lived Access Keys):**\n- **Structure:** Opaque string (vendor-specific format)\n- **Validation:** Treated as opaque tokens, validated via introspection endpoint\n- **Use case:** Service-to-service authentication, CLI tools, CI/CD pipelines\n- **Note:** API tokens use the same introspection flow as other opaque tokens. Vendors may use different introspection endpoints or validation logic for API tokens vs. user tokens.\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTHN_JWT_OIDC_PLUGIN.md` around lines 23 - 40, Add a\nshort clarifying paragraph after the \"Token Type Detection\" section that\nexplains how API tokens (e.g., long-lived access keys, PATs) are handled: state\nexplicitly whether API tokens are treated as opaque tokens validated via token\nintrospection (include note about long-lived token revocation and recommended\nrotation) or whether they fall outside this plugin's scope and require a\nseparate authentication mechanism/plugin; reference the existing terms \"JWT\",\n\"Opaque Tokens\" and \"Token Introspection\" so readers can map behaviors, and\ninclude a brief recommendation (e.g., prefer short-lived JWTs or introspected\nopaque tokens and use rotation/revocation best practices).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-30T10:05:26Z","updated_at":"2026-01-30T10:05:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525358","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525358"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525358"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525358/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":23,"start_side":"RIGHT","line":40,"original_line":40,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":40,"position":40,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525365","pull_request_review_id":3727401877,"id":2745525365,"node_id":"PRRC_kwDOPaLyBs6jpWR1","diff_hunk":"@@ -0,0 +1,1544 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Authorization Usage Scenarios](#authorization-usage-scenarios)\n+  - [Table of Contents](#table-of-contents)\n+  - [Projection Tables](#projection-tables)\n+    - [What Are Projection Tables?](#what-are-projection-tables)\n+    - [Choosing Projection Tables](#choosing-projection-tables)\n+    - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+    - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+    - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+    - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+    - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+    - [Combinations Summary](#combinations-summary)\n+  - [Scenarios](#scenarios)\n+    - [With `tenant_closure`](#with-tenant_closure)\n+      - [S01: LIST, tenant subtree, PEP has tenant\\_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+      - [S02: GET, tenant subtree, PEP has tenant\\_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+      - [S03: UPDATE, tenant subtree, PEP has tenant\\_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+      - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+      - [S05: LIST, tenant subtree with barrier, PEP has tenant\\_closure](#s05-list-tenant-subtree-with-barrier-pep-has-tenant_closure)\n+    - [Without `tenant_closure`](#without-tenant_closure)\n+      - [S06: LIST, tenant subtree, PEP without tenant\\_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+      - [S07: GET, tenant subtree, PEP without tenant\\_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+      - [S08: UPDATE, tenant subtree, PEP without tenant\\_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+      - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+    - [Resource Groups](#resource-groups)\n+      - [S10: LIST, group membership, PEP has resource\\_group\\_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+      - [S11: LIST, group subtree, PEP has resource\\_group\\_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+      - [S12: UPDATE, group membership, PEP has resource\\_group\\_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+      - [S13: UPDATE, group subtree, PEP has resource\\_group\\_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+      - [S14: GET, group membership, PEP without resource\\_group\\_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+      - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+    - [Advanced Patterns](#advanced-patterns)\n+      - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+      - [S17: LIST, multiple access paths (OR)](#s17-list-multiple-access-paths-or)\n+      - [S18: Access denied](#s18-access-denied)\n+  - [TOCTOU Analysis](#toctou-analysis)\n+    - [When TOCTOU Matters](#when-toctou-matters)\n+    - [How Each Scenario Handles TOCTOU](#how-each-scenario-handles-toctou)\n+    - [Key Insight: Prefetch + Constraint for Mutations](#key-insight-prefetch--constraint-for-mutations)\n+  - [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+","path":"docs/arch/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for migration, schema version, or sync strategy documentation\nrg -n -C3 \"migration|schema.*version|backward.*compat|sync.*strategy|capability.*advertis\" docs/authorization/ docs/adrs/authorization/ --type md 2>/dev/null | head -200\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 646\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Also search for PDP/PEP interaction patterns and configuration\nrg -n \"PEP.*capability|declare.*capabil|schema.*awareness|in_sync|projection.*sync\" docs/authorization/ docs/adrs/authorization/ --type md 2>/dev/null | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1333\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check what files exist in authorization documentation\nfind docs/authorization docs/adrs/authorization -type f -name \"*.md\" 2>/dev/null | sort\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 444\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check AUTH.md for capability declaration documentation\nsed -n '660,680p' docs/authorization/AUTH.md\necho \"---\"\nsed -n '770,790p' docs/authorization/AUTH.md\necho \"---\"\nsed -n '1065,1085p' docs/authorization/AUTH.md\necho \"---\"\nsed -n '1105,1125p' docs/authorization/AUTH.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3672\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for resolver design documentation (TBD or existing)\nfind docs -name \"*resolver*\" -o -name \"*Resolver*\" | head -20\nrg -l \"Tenant.*Resolver|Resource.*Group.*Resolver\" docs/ 2>/dev/null\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 395\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check what the AUTHZ_USAGE_SCENARIOS.md says about capability declaration around line 1226\nsed -n '1220,1235p' docs/authorization/AUTHZ_USAGE_SCENARIOS.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 535\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check ADRs for resolver design discussion\nrg -n \"Resolver|resolver\" docs/adrs/authorization/ --type md | head -30\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 5360\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check if there are any references to sync/consistency strategy in ADRs\nrg -n \"synchroniz|consistency|migration\" docs/adrs/authorization/ --type md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 220\n\n---\n\n\n\n</details>\n\n**Schema awareness is documented; synchronization strategy is intentionally deferred as TBD.**\n\nThe concern about schema awareness is addressed—AUTH.md extensively documents capability negotiation: PEP declares `require_constraints` and the `capabilities` array in its request, and PDP responds with predicates appropriate to those capabilities, with explicit degradation rules (expand to explicit IDs if PEP lacks a capability). Table schemas are also documented (tenant_closure columns, predicate types, etc.).\n\nHowever, synchronization, migrations, and consistency are real gaps. Both TENANT_MODEL.md and RESOURCE_GROUP_MODEL.md explicitly mark synchronization as \"out of scope for this document\" with references to \"Tenant Resolver design documentation (TBD)\" and \"Resource Group Resolver design documentation\" that don't yet exist. These deferred docs need to address:\n- How Tenant/Resource Group Resolvers stay in sync with source-of-truth data\n- Migration paths when new columns or predicates are added\n- Backward compatibility between PDP and PEP upgrades\n- Consistency guarantees during partial failures\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTHZ_USAGE_SCENARIOS.md` around lines 59 - 148, The docs\nnote schema awareness but defer synchronization—add concrete synchronization and\nmigration guidance by creating the missing \"Tenant Resolver design\" and\n\"Resource Group Resolver design\" docs and update TENANT_MODEL.md and\nRESOURCE_GROUP_MODEL.md to link to them; each new doc should describe how the\nTenant Resolver and Resource Group Resolver keep projection tables\n(tenant_closure, resource_group_membership, resource_group_closure) in sync with\nsource-of-truth, migration paths for schema/predicate changes, backward\ncompatibility strategies between PDP and PEP (e.g. capability negotiation using\nrequire_constraints and capabilities, graceful degradation to explicit IDs), and\nconsistency/partial-failure guarantees (reconciliation, transactional update or\neventual consistency windows, retry/alerting policies) so reviewers can find\nconcrete operational steps rather than TBD placeholders.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-30T10:05:27Z","updated_at":"2026-01-30T10:05:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525365","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525365"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525365"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525365/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":60,"original_start_line":59,"start_side":"RIGHT","line":149,"original_line":148,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":148,"position":149,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525367","pull_request_review_id":3727401877,"id":2745525367,"node_id":"PRRC_kwDOPaLyBs6jpWR3","diff_hunk":"@@ -0,0 +1,1544 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Authorization Usage Scenarios](#authorization-usage-scenarios)\n+  - [Table of Contents](#table-of-contents)\n+  - [Projection Tables](#projection-tables)\n+    - [What Are Projection Tables?](#what-are-projection-tables)\n+    - [Choosing Projection Tables](#choosing-projection-tables)\n+    - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+    - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+    - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+    - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+    - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+    - [Combinations Summary](#combinations-summary)\n+  - [Scenarios](#scenarios)\n+    - [With `tenant_closure`](#with-tenant_closure)\n+      - [S01: LIST, tenant subtree, PEP has tenant\\_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+      - [S02: GET, tenant subtree, PEP has tenant\\_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+      - [S03: UPDATE, tenant subtree, PEP has tenant\\_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+      - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+      - [S05: LIST, tenant subtree with barrier, PEP has tenant\\_closure](#s05-list-tenant-subtree-with-barrier-pep-has-tenant_closure)\n+    - [Without `tenant_closure`](#without-tenant_closure)\n+      - [S06: LIST, tenant subtree, PEP without tenant\\_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+      - [S07: GET, tenant subtree, PEP without tenant\\_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+      - [S08: UPDATE, tenant subtree, PEP without tenant\\_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+      - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+    - [Resource Groups](#resource-groups)\n+      - [S10: LIST, group membership, PEP has resource\\_group\\_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+      - [S11: LIST, group subtree, PEP has resource\\_group\\_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+      - [S12: UPDATE, group membership, PEP has resource\\_group\\_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+      - [S13: UPDATE, group subtree, PEP has resource\\_group\\_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+      - [S14: GET, group membership, PEP without resource\\_group\\_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+      - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+    - [Advanced Patterns](#advanced-patterns)\n+      - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+      - [S17: LIST, multiple access paths (OR)](#s17-list-multiple-access-paths-or)\n+      - [S18: Access denied](#s18-access-denied)\n+  - [TOCTOU Analysis](#toctou-analysis)\n+    - [When TOCTOU Matters](#when-toctou-matters)\n+    - [How Each Scenario Handles TOCTOU](#how-each-scenario-handles-toctou)\n+    - [Key Insight: Prefetch + Constraint for Mutations](#key-insight-prefetch--constraint-for-mutations)\n+  - [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_subtree\": {\n+      \"root_id\": \"T1\",\n+      \"include_root\": true,\n+      \"barrier_mode\": \"all\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"barrier_mode\": \"all\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```","path":"docs/arch/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify semantics for empty or missing constraints.**\n\nThe scenarios cover `decision: false` (fail-closed, line 1482) and `require_constraints: false` (decision only, lines 430, 637), but don't explicitly state what happens when:\n\n1. `decision: true` with empty `constraints: []` array\n2. `constraints: [{}]` (array with empty constraint object)\n3. `constraints: [{ \"predicates\": [] }]` (constraint with empty predicates)\n\nPer reviewer feedback `#6`, the authorization model should explicitly define these semantics. Suggested rules:\n\n| Response | Interpretation | SQL Behavior |\n|----------|---------------|--------------|\n| `decision: false` | Access denied | No query executed (fail-closed) ✅ Documented |\n| `decision: true, constraints: []` | Access granted with no restrictions | Query without WHERE constraints (⚠️ dangerous) |\n| `decision: true, constraints: [{}]` | Invalid response | PEP rejects as malformed |\n| `decision: true, constraints: [{predicates: []}]` | Invalid response | PEP rejects as malformed |\n\n\n\nAdd an explicit section (e.g., \"Constraint Semantics\") documenting these cases and whether empty constraints are:\n- Allowed (unrestricted access)\n- Rejected as malformed\n- Treated as `decision: false` (fail-closed)\n\nThis is critical for security - accidental empty constraints could bypass authorization entirely.\n\n\nAlso applies to: 417-423, 644-651, 771-793, 1471-1483\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTHZ_USAGE_SCENARIOS.md` around lines 195 - 215, Add a\nnew \"Constraint Semantics\" section that explicitly defines handling for\nempty/malformed constraints: state that decision:false always denies\n(fail-closed); decision:true with constraints:[] is allowed and means\n\"unrestricted access\" (results in no WHERE clause); decision:true with\nconstraints:[{}] is invalid and must be rejected as malformed by the PEP;\ndecision:true with constraints:[{ \"predicates\": [] }] is also invalid and must\nbe rejected as malformed. Reference the JSON response fields (\"decision\",\n\"context.constraints\", \"constraint.predicates\") and update the document areas\nthat discuss require_constraints/decision semantics so they consistently enforce\nthese rules and specify that malformed constraint responses cause the PEP to\ntreat the response as a protocol error (reject request) rather than executing an\nunconstrained query.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 3171fc2","created_at":"2026-01-30T10:05:27Z","updated_at":"2026-02-02T15:37:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525367","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525367"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525367"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525367/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":197,"original_start_line":195,"start_side":"RIGHT","line":217,"original_line":215,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":215,"position":217,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525372","pull_request_review_id":3727401877,"id":2745525372,"node_id":"PRRC_kwDOPaLyBs6jpWR8","diff_hunk":"@@ -0,0 +1,261 @@\n+# Tenant Model\n+\n+This document describes HyperSpot's multi-tenancy model, tenant topology, and isolation mechanisms.\n+\n+## Table of Contents\n+\n+- [Tenant Model](#tenant-model)\n+  - [Table of Contents](#table-of-contents)\n+  - [Overview](#overview)\n+  - [Tenant Topology: Forest](#tenant-topology-forest)\n+  - [Tenant Properties](#tenant-properties)\n+  - [Barriers (Self-Managed Tenants)](#barriers-self-managed-tenants)\n+  - [Context Tenant vs Subject Tenant](#context-tenant-vs-subject-tenant)\n+  - [Tenant Subtree Queries](#tenant-subtree-queries)\n+  - [Closure Table](#closure-table)\n+  - [References](#references)\n+\n+---\n+\n+## Overview\n+\n+HyperSpot uses a **hierarchical multi-tenancy** model where tenants form a forest (multiple independent trees). Each tenant can have child tenants, creating organizational structures like:\n+\n+```\n+Vendor\n+├── Organization A\n+│   ├── Team A1\n+│   └── Team A2\n+└── Organization B\n+    ├── Team B1\n+    └── Team B2\n+```\n+\n+Key principles:\n+- **Isolation by default** — tenants cannot access each other's data\n+- **Hierarchical access** — parent tenants may access child tenant data (configurable)\n+- **Barriers** — child tenants can opt out of parent visibility via `self_managed` flag\n+\n+---\n+\n+## Tenant Topology: Forest\n+\n+The tenant structure is a **forest** — a collection of independent trees with no single global root.\n+\n+```\n+       [T1]              [T5]           ← Root tenants (no parent)\n+      /    \\               |\n+   [T2]    [T3]          [T6]\n+     |\n+   [T4]\n+```\n+\n+**Properties:**\n+- Each tree has exactly one root tenant (`parent_id = NULL`)\n+- A tenant belongs to exactly one tree\n+- Trees are completely isolated from each other\n+- Depth is unlimited (but deep hierarchies may impact performance)\n+\n+**Why forest, not single tree?**\n+- Supports multiple independent vendors/organizations\n+- No artificial \"super-root\" that would complicate access control\n+- Each tree can have different policies and configurations\n+- Enables datacenter migration — vendor can gradually move tenant trees between regions/datacenters without cross-tree dependencies\n+\n+---\n+\n+## Tenant Properties\n+\n+| Property | Type | Description |\n+|----------|------|-------------|\n+| `id` | UUID | Unique tenant identifier |\n+| `parent_id` | UUID? | Parent tenant (NULL for root tenants) |\n+| `status` | enum | `active`, `suspended`, `deleted` |\n+| `self_managed` | bool | If true, creates a barrier — parent cannot access this subtree |\n+\n+**Status semantics:**\n+- `active` — normal operation\n+- `suspended` — tenant temporarily disabled (e.g., billing issue), data preserved\n+- `deleted` — soft-deleted, may be purged after retention period\n+\n+---\n+\n+## Barriers (Self-Managed Tenants)\n+\n+A **barrier** is created when a tenant sets `self_managed = true`. This prevents parent tenants from accessing the subtree rooted at the barrier tenant.\n+\n+**Example:**\n+\n+```\n+T1 (parent)\n+├── T2 (self_managed=true)  ← BARRIER\n+│   └── T3\n+└── T4\n+```\n+\n+**Access from T1's perspective:**\n+- ✅ Can access T1's own resources\n+- ❌ Cannot access T2's resources (barrier)\n+- ❌ Cannot access T3's resources (behind barrier)\n+- ✅ Can access T4's resources\n+\n+**Access from T2's perspective:**\n+- ✅ Can access T2's own resources\n+- ✅ Can access T3's resources (T3 is in T2's subtree, no barrier between them)\n+\n+**Use cases:**\n+- Enterprise customer wants data isolation from reseller/partner\n+- Compliance requirements (data sovereignty)\n+- Organizational autonomy within a larger structure\n+\n+**Barrier interpretation is context-dependent:**\n+\n+Barriers are not absolute — their enforcement depends on the type of data and operation. The same parent-child relationship may have different access rules for different resource types:\n+\n+| Data Type | Barrier Enforced? | Rationale |\n+|-----------|-------------------|-----------|\n+| Business data (tasks, documents) | ✅ Yes | Core isolation requirement |\n+| Usage/metrics for billing | ❌ No | Parent needs to bill child tenant |\n+| Audit logs | ⚠️ Configurable | Compliance may require parent visibility |\n+| Tenant metadata (name, status) | ❌ No | Parent needs to manage child tenants |\n+\n+**Example:** Reseller T1 has enterprise customer T2 (`self_managed=true`):\n+- T1 ❌ cannot read T2's business data (tasks, files, etc.)\n+- T1 ✅ can read T2's usage metrics for billing purposes\n+- T1 ✅ can see T2's tenant metadata (name, status, plan)\n+\n+This means `barrier_mode` in authorization requests applies to specific resource types, not globally. Each module/endpoint decides whether barriers apply to its resources.\n+","path":"docs/arch/authorization/TENANT_MODEL.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"90bf65fe94572ad7aebb9c478fc77c4a1482cdd6","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Clarify how PDP handles context-dependent barrier enforcement.**\n\nLines 112-128 explain that barrier interpretation varies by data type (business data respects barriers, usage metrics don't, etc.). Line 127 states: \"`barrier_mode` in authorization requests applies to specific resource types, not globally.\"\n\nThis raises operational questions:\n\n1. **How does PDP know which resource types enforce barriers?**\n   - Is there a central registry mapping resource types to barrier policies?\n   - Does each module declare barrier enforcement in its AuthZ request?\n   - Are barrier rules part of the PDP's policy configuration?\n\n2. **How are barrier policies versioned?**\n   - If a vendor changes barrier enforcement for a resource type, how is that communicated?\n   - Can different modules have different barrier policies for the same tenant relationship?\n\n3. **What's the default behavior?**\n   - If a new resource type is added, does it enforce barriers by default or not?\n\n\n\nThis ties to reviewer feedback `#7` about PDP/PEP schema coupling. The context-dependent barrier enforcement adds complexity beyond just tenant hierarchy - it requires the PDP to understand resource type semantics.\n\n<details>\n<summary>Suggested approach</summary>\n\nAdd a section explaining the mechanism:\n\n```markdown\n### Barrier Policy Mechanism\n\nBarrier enforcement is resource-type specific and declared in the AuthZ evaluation request:\n\n**Option 1: Module Declaration**\n```json\n{\n  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n  \"context\": {\n    \"tenant_subtree\": {\n      \"barrier_mode\": \"all\"  // This module enforces barriers\n    }\n  }\n}\n```\n\n**Option 2: PDP Configuration**\n```yaml\nbarrier_policies:\n  \"gts.x.tasks.task.v1~\": \"all\"  # Enforce barriers\n  \"gts.x.billing.usage.v1~\": \"none\"  # Ignore barriers\n```\n\nThe chosen approach determines how barrier policies are versioned and updated.\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/TENANT_MODEL.md` around lines 112 - 128, The doc is\nunclear on how the PDP determines resource-specific barrier enforcement; add a\nconcise \"Barrier Policy Mechanism\" section that specifies whether barrier rules\nare discovered via a central registry, declared per-request by modules, or built\ninto PDP policy config, and explain versioning/defaults; reference the existing\nterms `PDP`, `PEP`, `barrier_mode` and the AuthZ evaluation request so readers\nknow where to supply enforcement (e.g., module-declared in the request vs\nPDP-configured mapping), state how policy versioning/propagation works and what\nthe default behavior is for new resource types.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 3171fc2","created_at":"2026-01-30T10:05:27Z","updated_at":"2026-02-02T15:37:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525372","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525372"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2745525372"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2745525372/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":112,"original_start_line":112,"start_side":"RIGHT","line":128,"original_line":128,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":128,"position":128,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746724464","pull_request_review_id":3728860266,"id":2746724464,"node_id":"PRRC_kwDOPaLyBs6jt7Bw","diff_hunk":"@@ -0,0 +1,875 @@\n+# ADR-0001: Auth Resolver Based on AuthZEN Authorization API 1.0\n+\n+- **Status**: Draft","path":"docs/decisions/authorization/0001-auth-resolver.md","commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","original_commit_id":"7dda780b5a5297d0fcf234b8cf4957215245ad56","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"AuthZ Resolver (Plugin, PDP) returns abstract logical predicates rather than raw filters, ensuring the PDP remains agnostic of the database schema while the PEP maintains sole ownership of physical SQL compilation. This approach is a deliberate architectural choice to solve the critical performance and pagination bottlenecks inherent in Zanzibar-style \"point-check\" systems for LIST operations. By decoupling logical policy reasoning from physical database enforcement, we achieve O(1) authorization overhead without sacrificing vendor neutrality or separation of concerns.","created_at":"2026-01-30T15:07:58Z","updated_at":"2026-01-30T15:07:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746724464","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746724464"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746724464"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746724464/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":3,"side":"RIGHT","in_reply_to_id":2718314710,"author_association":"MEMBER","original_position":3,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746726606","pull_request_review_id":3728862688,"id":2746726606,"node_id":"PRRC_kwDOPaLyBs6jt7jO","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"problems are rephrased","created_at":"2026-01-30T15:08:35Z","updated_at":"2026-01-30T15:08:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746726606","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746726606"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746726606"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746726606/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":114,"side":"RIGHT","in_reply_to_id":2725989242,"author_association":"MEMBER","original_position":114,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746775046","pull_request_review_id":3728918013,"id":2746775046,"node_id":"PRRC_kwDOPaLyBs6juHYG","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"PDP will be responsible for checking resource group tenant ownership. I've mentioned it in AUTH.md:\r\n> Group Tenant Scoping\r\nResource groups are tenant-scoped. PDP guarantees that any group_ids (in in_group predicate) or root_group_id (in in_group_subtree predicate) returned in constraints belong to the same tenant as the request context.\r\n\r\nThen it should be handled via resource group projection table (membership and/or closure).","created_at":"2026-01-30T15:20:43Z","updated_at":"2026-01-30T15:20:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746775046","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746775046"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2746775046"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746775046/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":148,"side":"RIGHT","in_reply_to_id":2726032230,"author_association":"MEMBER","original_position":148,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754322085","pull_request_review_id":3739381963,"id":2754322085,"node_id":"PRRC_kwDOPaLyBs6kK56l","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |","path":"docs/design/AUTH.md","commit_id":"8c3d6c5bff437a59752efb13d42c9c243225ca9c","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We are considering 2 options here: 1) dedicated local projections per module; 2) shared projections - will work for cases when multiple modules store their tables in the same DB.\r\n\r\n1st option is must to support, 2nd option is questionable. So, yes, the diagram was reworked.\r\n","created_at":"2026-02-02T13:25:24Z","updated_at":"2026-02-02T13:25:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754322085","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754322085"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754322085"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754322085/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":175,"side":"RIGHT","in_reply_to_id":2726038784,"author_association":"MEMBER","original_position":175,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334346","pull_request_review_id":3739396507,"id":2754334346,"node_id":"PRRC_kwDOPaLyBs6kK86K","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"","path":"docs/authorization/AUTH.md","commit_id":"a3347f6f3de3606b4c9a8cb0eed2e3c5109cd52a","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"good point, comments are added","created_at":"2026-02-02T13:28:25Z","updated_at":"2026-02-02T13:28:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754334346","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334346"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754334346"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":288,"side":"RIGHT","in_reply_to_id":2726055766,"author_association":"MEMBER","original_position":288,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334977","pull_request_review_id":3739397124,"id":2754334977,"node_id":"PRRC_kwDOPaLyBs6kK9EB","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"","path":"docs/authorization/AUTH.md","commit_id":"a3347f6f3de3606b4c9a8cb0eed2e3c5109cd52a","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"described in comments","created_at":"2026-02-02T13:28:34Z","updated_at":"2026-02-02T13:28:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754334977","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334977"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754334977"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754334977/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":278,"side":"RIGHT","in_reply_to_id":2726051032,"author_association":"MEMBER","original_position":278,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754452840","pull_request_review_id":3739550265,"id":2754452840,"node_id":"PRRC_kwDOPaLyBs6kLZ1o","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{\n+      // Filters within a constraint are AND'd together\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter - uses local tenant_closure table\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+          \"respect_barrier\": true,\n+          \"tenant_status\": [\"active\", \"suspended\"]\n+        },\n+        {\n+          // Simple column equality from resource properties\n+          \"type\": \"field\",","path":"docs/design/AUTH.md","commit_id":"94105f3381edf6a539a0e2988056d53dfad21a19","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Current format of constraints is the following\r\n```json\r\n{\r\n  \"decision\": true,\r\n  \"context\": {\r\n    \"constraints\": [\r\n      {\r\n        \"predicates\": [\r\n          {\r\n            // Tenant subtree predicate\r\n            \"type\": \"in_tenant_subtree\",\r\n            \"resource_property\": \"owner_tenant_id\",\r\n            \"root_tenant_id\": \"tenant-A\",\r\n            \"barrier_mode\": \"all\"  // default: \"all\"\r\n          },\r\n          {\r\n            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\r\n            \"type\": \"in_group_subtree\",\r\n            \"resource_property\": \"id\",\r\n            \"root_group_id\": \"project-root-group\"\r\n          }\r\n        ]\r\n      }\r\n    ]\r\n  }\r\n}\r\n```\r\nThe PEP declares (via common library) its supported properties (`fields` were renamed to `properties` to be consistent with AuthZen 1.0) in every authorization request via `context.supported_properties`. This field contains the list of property names that the PEP can map to SQL columns. The PDP uses this information to validate that returned constraints only reference properties the PEP can enforce.\r\n\r\nThe `resource_property` in predicates corresponds to `resource.properties` in the request (part of AuthZen 1.0 specification). Each module (PEP) defines (again via common library) a mapping from property names to physical SQL columns. PDP uses property names - it doesn't know the database schema.\r\n\r\nIn short, resource's properties are part of authorization protocol between PEP and PDP and don't reflect the module's DB scheme.","created_at":"2026-02-02T13:53:48Z","updated_at":"2026-02-02T13:53:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754452840","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754452840"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754452840"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754452840/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":336,"side":"RIGHT","in_reply_to_id":2726062588,"author_association":"MEMBER","original_position":336,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754545299","pull_request_review_id":3739667935,"id":2754545299,"node_id":"PRRC_kwDOPaLyBs6kLwaT","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{","path":"docs/design/AUTH.md","commit_id":"94105f3381edf6a539a0e2988056d53dfad21a19","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've brainstormed this aspect a lot and in my view it's better to keep the \"constraints\" term here. \"grants\" usually implies stored permissions (OAuth, Zanzibar tuples, RBAC). These are computed predicates for SQL WHERE, they are ephemeral, not persisted, computed by PDP at evaluation time. I highlighted this distinction in the Core Terms section.","created_at":"2026-02-02T14:12:53Z","updated_at":"2026-02-02T14:12:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754545299","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754545299"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754545299"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754545299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":323,"side":"RIGHT","in_reply_to_id":2726065200,"author_association":"MEMBER","original_position":323,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754603425","pull_request_review_id":3739739983,"id":2754603425,"node_id":"PRRC_kwDOPaLyBs6kL-mh","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.","path":"docs/design/AUTH.md","commit_id":"afdc77c7e7b4ee3f0aacb6378b3b3eadcdc5d1bf","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good catch. Not all policies are SQL-expressible. For example, time-based or external data dependencies must be enforced at the decision level (decision: false) before constraint generation. I'll add a disclaimer clarifying that constraints cover data-scoping policies (tenant, group, ownership), while other policy types are enforced via the boolean decision or outside PEP.","created_at":"2026-02-02T14:24:46Z","updated_at":"2026-02-02T14:24:46Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754603425","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754603425"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754603425"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754603425/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":150,"side":"RIGHT","in_reply_to_id":2726077370,"author_association":"MEMBER","original_position":150,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754821298","pull_request_review_id":3740056647,"id":2754821298,"node_id":"PRRC_kwDOPaLyBs6kMzyy","diff_hunk":"@@ -0,0 +1,1255 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Tenant context (from request header/query param) — use ONE of: tenant_id OR tenant_subtree\n+    // \"tenant_id\": \"...\",  // Option 1: single tenant\n+    \"tenant_subtree\": {     // Option 2: tenant subtree\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // request header: X-Tenant-Id\n+      \"include_root\": true,        // request param, default: true\n+      \"barrier_mode\": \"all\",       // request param, default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // request param, optional\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"supported_properties\": [\"owner_tenant_id\", \"topic_id\", \"id\"],  // handler config: properties PEP can map to SQL\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+  }","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"870dc980ca470f3898bf9adb33f3c58189b454d1","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Redact bearer token example to avoid secret‑scanner false positives.**\n\nThe sample token string is realistic enough to trigger secret scanners (and already did). Use an explicit redaction placeholder.  \n\n\n<details>\n<summary>🧹 Suggested change</summary>\n\n```diff\n-    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+    \"bearer_token\": \"<redacted>\"  // SecurityContext.bearer_token (optional, see notes below)\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Gitleaks (8.30.0)</summary>\n\n[high] 761-761: Detected a Generic API Key, potentially exposing access to various services and sensitive operations.\n\n(generic-api-key)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 757 - 762, The example includes a\nrealistic bearer token string that can trip secret scanners; replace the literal\ntoken in the sample JSON (the \"bearer_token\" field /\nSecurityContext.bearer_token) with a clear redaction placeholder such as\n\"<REDACTED_BEARER_TOKEN>\" or \"{REDACTED}\" and update any accompanying comment to\nindicate the value is intentionally redacted and optional.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 5f00f1e","created_at":"2026-02-02T15:08:12Z","updated_at":"2026-02-05T07:54:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754821298","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754821298"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754821298"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754821298/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":760,"original_start_line":757,"start_side":"RIGHT","line":765,"original_line":762,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":762,"position":765,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945358","pull_request_review_id":3740221683,"id":2754945358,"node_id":"PRRC_kwDOPaLyBs6kNSFO","diff_hunk":"@@ -0,0 +1,1263 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"3a1d2c8025e24830a7b836566012c754685f8d45","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**API tokens and token-embedding rationale still missing despite marked resolution.**\n\nPer PR objectives (concern `#2`), the reviewer requested:\n1. Explicit mention of API tokens\n2. Explanation of why authorization rules cannot be fully encoded in tokens\n\nA past review comment on these lines was marked \"✅ Addressed in commit 870dc98,\" but the current text does **not include either**:\n\n**Missing content:**\n- **API tokens** - No mention of long-lived access keys, service-to-service tokens, or PATs. Line 47 generically defines \"Access Token\" but doesn't differentiate user tokens from service tokens.\n- **Token-embedding rationale** - No explanation of why PDP evaluation is superior to embedding authorization rules in tokens (size, staleness, dynamic context, revocation).\n\nLines 252-336 discuss token scopes and first-party vs third-party apps but don't explicitly address service-to-service authentication or API token lifecycle.\n\nThe past review comment provided a concrete template for both additions that should be incorporated.\n\n\n\nAlso applies to: 252-336\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 47 - 59, The docs are missing\nexplicit coverage of API tokens and the rationale for not embedding full\nauthorization rules in tokens; add two brief entries under the glossary near\n\"Access Token\" and cross-reference \"Token Scopes\": (1) Add an \"API Token\" (or\n\"Service / API Token\" / \"PAT\") definition that explains long-lived\nservice-to-service credentials, lifecycle, revocation, and where they differ\nfrom short-lived user bearer tokens; (2) Add a short \"Why not embed\nauthorization rules in tokens\" paragraph referencing the Policy Decision Point\n(PDP) and explaining limits of token-embedded rules (size, staleness, revocation\ndifficulty, dynamic context like tenant/resource state), and state that\nPDP-evaluated Access Constraints are used instead; reference the existing\nsymbols \"Access Token\", \"Token Scopes\", \"Access Constraints\", and \"PDP\" so the\nadditions slot into the same section and link to Token Scopes discussion at\nlines ~252-336.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-02T15:34:01Z","updated_at":"2026-02-02T15:34:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945358","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945358"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945358"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945358/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":47,"original_start_line":47,"start_side":"RIGHT","line":59,"original_line":59,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":59,"position":59,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945367","pull_request_review_id":3740221683,"id":2754945367,"node_id":"PRRC_kwDOPaLyBs6kNSFX","diff_hunk":"@@ -0,0 +1,1263 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"3a1d2c8025e24830a7b836566012c754685f8d45","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Caching strategy remains incomplete despite reviewer insistence.**\n\nPer PR objectives (concern `#5`), the reviewer insisted: \"caching strategy being described, as it impacts performance and feasibility.\"\n\nLines 655-678 provide a caching section, but line 659 explicitly states: **\"Status: Requires further design work.\"** Lines 671-677 list open questions including:\n- Cache key structure and canonicalization\n- Cache-control protocol and TTL negotiation\n- Invalidation strategy\n- Token expiration handling\n\n**Impact:** Without a concrete caching strategy:\n- Every authorization check = 1 PDP network call\n- LIST operations on high-traffic APIs = potential PDP bottleneck\n- Latency overhead on every request\n\nThe past review comment suggested extracting this to a separate ADR. This is still the correct recommendation - caching protocol affects both PDP and PEP implementations and deserves dedicated design before implementation proceeds.\n\n**Recommendation:** Create ADR for caching strategy or complete the design in this section before finalizing the authorization model.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 655 - 678, The \"Authorization\nDecision Caching\" section is incomplete and must be turned into a concrete\ndesign or moved to a dedicated ADR: draft a standalone ADR (or fully flesh out\nthis section) that specifies cache key structure (including token scopes and\ntenant context), canonicalization rules for resource.properties, cache-control\nprotocol and TTL negotiation (including PDP-provided cacheability and\nmin(pdp_ttl, token_expires_at - now) semantics), invalidation strategies\n(policy-versioning, push events, or TTL), and how token_expires_at is surfaced\n(e.g., add token_expires_at to SecurityContext vs. passed separately); reference\nthe Authorization Decision Caching heading, PDP/PEP interactions, and\nSecurityContext/token_expires_at in the ADR and update this doc to point to that\nADR.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 08c804f","created_at":"2026-02-02T15:34:01Z","updated_at":"2026-02-02T15:34:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945367","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945367"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945367"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945367/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":659,"original_start_line":655,"start_side":"RIGHT","line":682,"original_line":678,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":678,"position":682,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945369","pull_request_review_id":3740221683,"id":2754945369,"node_id":"PRRC_kwDOPaLyBs6kNSFZ","diff_hunk":"@@ -0,0 +1,1263 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Tenant context (from request header/query param) — use ONE of: tenant_id OR tenant_subtree\n+    // \"tenant_id\": \"...\",  // Option 1: single tenant\n+    \"tenant_subtree\": {     // Option 2: tenant subtree\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // request header: X-Tenant-Id\n+      \"include_root\": true,        // request param, default: true\n+      \"barrier_mode\": \"all\",       // request param, default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // request param, optional\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"supported_properties\": [\"owner_tenant_id\", \"topic_id\", \"id\"],  // handler config: properties PEP can map to SQL\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: bearer_token is a credential — PDP MUST NOT log it or persist it.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The PEP declares its supported properties in every authorization request via `context.supported_properties`. This field contains the list of property names that the PEP can map to SQL columns. The PDP uses this information to validate that returned constraints only reference properties the PEP can enforce.\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+\n+---\n+\n+### Capabilities -> Predicate Matrix\n+\n+The PEP declares its capabilities in the request. This determines what predicate types the PDP can return.\n+\n+#### `require_constraints` Flag\n+\n+The `require_constraints` field (separate from capabilities array) controls PEP behavior when constraints are absent:\n+\n+| `require_constraints` | `decision: true` without `constraints` |\n+|-----------------------|----------------------------------------|\n+| `true` | **deny** (constraints required but missing) |\n+| `false` | **allow** (trust PDP decision) |\n+\n+**Usage:**\n+- For LIST operations: typically `true` (constraints needed for SQL WHERE)\n+- For CREATE operations: typically `false` (no query, just permission check)\n+- For GET/UPDATE/DELETE: depends on whether PEP wants SQL-level enforcement or trusts PDP decision\n+\n+#### Capabilities Array\n+\n+Capabilities declare what predicate types the PEP can enforce locally:\n+\n+| Capability | Enables Predicate Types |\n+|------------|---------------------|\n+| `tenant_hierarchy` | `in_tenant_subtree` |\n+| `group_membership` | `in_group` |\n+| `group_hierarchy` | `in_group_subtree` (implies `group_membership`) |\n+\n+**Capability dependencies:**\n+- `group_hierarchy` implies `group_membership` — if PEP has the closure table, it necessarily has the membership table\n+- When declaring capabilities, `[\"group_hierarchy\"]` is sufficient; `group_membership` is implied\n+\n+**Predicate type availability by capability:**\n+\n+| Predicate Type | Required Capability |\n+|-------------|---------------------|\n+| `eq`, `in` | (none — always available) |\n+| `in_tenant_subtree` | `tenant_hierarchy` |\n+| `in_group` | `group_membership` |\n+| `in_group_subtree` | `group_hierarchy` |\n+\n+**Capability degradation**: If a PEP lacks a capability, the PDP must either:\n+1. Expand the predicate to explicit IDs (may be large)\n+2. Return `decision: false` if expansion is not feasible\n+\n+---\n+\n+### Table Schemas (Local Projections)\n+\n+These tables are maintained locally by HyperSpot gateway modules (Tenant Resolver, Resource Group Resolver) and used by PEPs to execute constraint queries efficiently without calling back to the vendor platform.\n+\n+#### `tenant_closure`\n+\n+Denormalized closure table for tenant hierarchy. Enables efficient subtree queries without recursive CTEs.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent tenant in the hierarchy |\n+| `descendant_id` | UUID | No | Child tenant (the one we check ownership against) |\n+| `barrier` | INT | No | 0 = no barrier on path, 1 = barrier exists between ancestor and descendant (default 0) |\n+| `descendant_status` | TEXT | No | Status of descendant tenant (`active`, `suspended`, `deleted`) |\n+\n+**Notes:**\n+- Status is denormalized into closure for query simplicity (avoids JOIN). When a tenant's status changes, all rows where it is `descendant_id` are updated.\n+- **Barrier semantics:** The `barrier` column stores barriers **strictly between** ancestor and descendant, **not including the ancestor itself**. This means when T2 is self_managed, rows with `ancestor_id = T2` have `barrier = 0`, while rows with T2 on the path from another ancestor have `barrier = 1`.\n+- The `barrier` column enables simple filtering: `barrier_mode: \"all\"` adds `AND barrier = 0`, `barrier_mode: \"none\"` omits the clause.\n+- Self-referential rows exist: each tenant has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_tenant_subtree` predicate compiles to SQL using this closure table.\n+- **Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types (e.g., `(barrier & mask) = 0` for selective enforcement).\n+\n+**Example query (in_tenant_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = :root_tenant_id\n+    AND barrier = 0  -- barrier_mode: \"all\"\n+    AND descendant_status IN ('active', 'suspended')  -- tenant_status filter\n+)\n+```","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"3a1d2c8025e24830a7b836566012c754685f8d45","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Closure table schema evolution strategy is missing.**\n\nLines 1151-1183 document the `tenant_closure` schema, and line 1172 mentions \"Future extensibility\" for the barrier bitmask. However, per reviewer feedback (concern `#7` about PDP/PEP schema coupling), the document lacks guidance on **schema evolution and migration**:\n\n**Missing specification:**\n1. **Schema versioning** - How are closure table schemas versioned? (Semantic versioning? Version column?)\n2. **Migration protocol** - When `tenant_closure` schema changes (e.g., adding `path_length` column), how do PEPs learn about it?\n3. **Backward compatibility** - Can old PEPs work with new schema? Or must all modules upgrade atomically?\n4. **Barrier bitmask migration** - Line 1172 says barrier will become a bitmask \"in future.\" When that future arrives, how will existing deployments migrate? How will PEPs learn about new barrier modes?\n\n**Recommendation:** Add a \"Schema Evolution\" subsection addressing:\n- Closure tables are controlled by gateway modules (Tenant Resolver, RG Resolver)\n- Schema changes require coordinated upgrade of gateway + all PEPs\n- Alternatively: Use schema migration framework with version checks at PEP startup\n- Future barrier modes will be announced via schema version bump + capability negotiation\n\nThis directly addresses reviewer concern about ensuring \"PDP and PEP schema consistency when upgraded separately.\"\n\n\n\nAlso applies to: 1185-1221\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 1151 - 1183, Add a \"Schema\nEvolution\" subsection for the tenant_closure table that specifies a clear\nversioning and migration protocol: define a schema_version (semantic or integer)\nfor tenant_closure, require gateway modules (Tenant Resolver, Resource Group\nResolver) to own version bumps, and document how PEPs discover version (via a\nschema_version column, gateway-provided metadata API, or bootstrap capability\nendpoint). Describe migration protocol steps (gateway publishes new\nschema_version + migration plan, perform rolling migrations, update closure\npopulation logic), backward-compatibility rules (support additive changes where\nold PEPs continue to read known columns; breaking changes require coordinated\nupgrade or a compatibility shim), and explicit barrier bitmask migration\nguidance (how to transition barrier INT -> bitmask: new version, dual-write\nperiod, PEP capability negotiation, and fallback behavior). Reference\ntenant_closure, barrier, in_tenant_subtree, PEPs, Tenant Resolver and RG\nResolver in the text so implementers know where to make checks and where\nmetadata is served.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 57bbb93","created_at":"2026-02-02T15:34:01Z","updated_at":"2026-02-02T18:37:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945369","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945369"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2754945369"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2754945369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1216,"original_start_line":1151,"start_side":"RIGHT","line":1248,"original_line":1183,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1183,"position":1248,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755484941","pull_request_review_id":3740932547,"id":2755484941,"node_id":"PRRC_kwDOPaLyBs6kPV0N","diff_hunk":"@@ -0,0 +1,693 @@\n+# Auth Resolver Technical Specification\n+\n+> **Related ADR:** [0001-pdp-pep-authorization-model.md](../../../docs/adrs/authorization/0001-pdp-pep-authorization-model.md)\n+\n+## Overview\n+\n+Auth Resolver is HyperSpot's Policy Decision Point (PDP) integration module. It implements an AuthZEN-based authorization API extended with constraint-based filtering for SQL-level enforcement.\n+\n+The core problem Auth Resolver solves: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks. For LIST operations, we need **constraints** that can filter results, not a boolean decision or enumerated resource IDs.\n+\n+---\n+\n+## AuthZEN Overview\n+\n+AuthZEN Authorization API 1.0 (approved by OpenID Foundation on 2026-01-12) defines:\n+\n+### Access Evaluation API\n+\n+Point-in-time check: \"Can subject S perform action A on resource R?\"\n+\n+```\n+POST /access/v1/evaluation\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\", \"properties\": {...} },\n+  \"action\": { \"name\": \"read\", \"properties\": {...} },\n+  \"resource\": { \"type\": \"document\", \"id\": \"doc-123\", \"properties\": {...} },\n+  \"context\": { ... }\n+}\n+\n+Response:\n+{\n+  \"decision\": true,\n+  \"context\": { ... }\n+}\n+```\n+\n+### Search APIs\n+\n+AuthZEN defines three search operations:\n+\n+| API | Question | Response |\n+|-----|----------|----------|\n+| Subject Search | \"Who can perform action A on resource R?\" | List of subject entities |\n+| Resource Search | \"What resources can subject S perform action A on?\" | List of resource entities |\n+| Action Search | \"What actions can subject S perform on resource R?\" | List of action entities |\n+\n+```\n+POST /access/v1/search/resources\n+\n+Request:\n+{\n+  \"subject\": { \"type\": \"user\", \"id\": \"alice\" },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"document\" }  // no \"id\" - searching\n+}\n+\n+Response:\n+{\n+  \"results\": [\n+    { \"type\": \"document\", \"id\": \"doc-123\" },\n+    { \"type\": \"document\", \"id\": \"doc-456\" },\n+    ...\n+  ],\n+  \"page\": { \"next_token\": \"...\", \"result_count\": 2 }\n+}\n+```\n+\n+**Why Search APIs don't work for HyperSpot:**\n+\n+Search APIs assume the PDP has access to resource data. In HyperSpot, resources live in the PEP's database - the PDP cannot enumerate what it doesn't have. This creates an architectural mismatch: the component that knows \"who can access what\" (PDP) is separate from the component that has \"what exists\" (PEP).\n+\n+---\n+\n+## AuthZEN Gap Analysis\n+\n+| Aspect | AuthZEN 1.0 | HyperSpot Requirement | Resolution |\n+|--------|-------------|----------------------|------------|\n+| **Point access check** | `decision: true/false` | Same | AuthZEN-compliant |\n+| **List/query operations** | Resource Search returns IDs | Need constraints for SQL WHERE | **Extended evaluation response** |\n+| **Resource location** | PDP has resource data | Resources in PEP's database | **Constraints instead of enumeration** |\n+| **Tenant hierarchy** | Not specified | First-class primitive | Extension via `context.tenant_scope` |\n+| **Resource groups** | Not specified | First-class primitive | Extension via filters |\n+| **Capability negotiation** | Not specified | PEP declares what it can enforce | Extension via `context.capabilities` |\n+| **Constraint-based filtering** | Not supported | Core requirement | **Extended evaluation response** |\n+\n+### The Fundamental Problem: PDP Doesn't Have Resources\n+\n+In HyperSpot's architecture, resources live in the PEP's database. The PDP knows authorization policies but cannot enumerate resources it doesn't have access to.\n+\n+**The naive approach without constraints:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP\n+    participant DB\n+    participant PDP\n+\n+    Client->>PEP: GET /events?limit=10\n+    PEP->>DB: SELECT * FROM events (millions!)\n+    DB-->>PEP: all rows\n+    loop For each resource\n+        PEP->>PDP: evaluate(evt-N)?\n+        PDP-->>PEP: decision\n+    end\n+    Note over PEP: filter results<br/>apply limit=10<br/>(wrong order!)\n+    PEP-->>Client: response\n+```\n+\n+**Problems:**\n+1. **O(N) evaluations** - Must check every resource, even to return 10 items\n+2. **Pagination breaks** - `limit=10` applied after filtering; may return 0-10 items unpredictably\n+3. **Total count impossible** - Can't know total without evaluating all resources\n+4. **Dynamic data** - Results change between pagination requests\n+\n+**What HyperSpot needs:**\n+```jsonc\n+// Extended evaluation response with constraints\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        // Tenant ownership filter - uses local tenant_closure table\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-123\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Now: SELECT * FROM events WHERE (constraints) LIMIT 10 - correct pagination!\n+```\n+\n+**Our resolution**: Extend the AuthZEN evaluation response with optional `context.constraints`. The PDP expresses \"what the user can access\" as predicates; the PEP applies them to SQL before fetching data.\n+\n+---\n+\n+## Core Terms\n+\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation)\n+- **Subject / Principal** - Actor initiating the request (user or API client)\n+- **Subject Tenant** - Tenant the subject belongs to\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources (project/workspace/folder)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (which are stored vendor-side), but compiled, time-bound enforcement artifacts.\n+- **PDP (Policy Decision Point)** - Auth Resolver implementing authorization decisions\n+- **PEP (Policy Enforcement Point)** - HyperSpot domain modules applying constraints\n+\n+---\n+\n+## Integration Architecture\n+\n+```\n++---------------------------------------------------------------------+\n+|                        Vendor Platform                              |\n+|  +----------+  +-----------------+  +------------+  +------------+  |\n+|  |   IdP    |  | Tenant Service  |  |  RG Svc    |  | Authz Svc  |  |\n+|  +----^-----+  +-------^---------+  +-----^------+  +-----^------+  |\n++-------+----------------+------------------+---------------+---------+\n+        |                |                  |               |\n++-------+----------------+------------------+---------------+---------+\n+|       |         HyperSpot                 |               |         |\n+|  +----+----+  +--------+--------+  +------+-----+  +------+------+  |\n+|  |  AuthN  |  | Tenant Resolver |  | RG Resolver|  |Auth Resolver|  |\n+|  | (JWT/   |  |    (Gateway)    |  |  (Gateway) |  |   (PDP)     |  |\n+|  | Introsp)|  +--------+--------+  +------+-----+  +------+------+  |\n+|  +---------+           |                  |               |         |\n+|                        v                  v               |         |\n+|              +-------------------------------+            |         |\n+|              |     Local Projections         |            |         |\n+|              |  * tenant_closure             |            |         |\n+|              |  * resource_group_closure     |            |         |\n+|              |  * resource_group_membership  |            |         |\n+|              +-------------------------------+            |         |\n+|                                                           |         |\n+|  +-------------------------------------------------------+-------+ |\n+|  |                    Domain Module (PEP)                 |       | |\n+|  |  +-------------+                                       |       | |\n+|  |  |   Handler   |---- /access/v1/evaluation ----------->|       | |\n+|  |  +------+------+     (returns decision + constraints)          | |\n+|  |         | Compile constraints to SQL                           | |\n+|  |         v                                                      | |\n+|  |  +-------------+                                               | |\n+|  |  |  Database   |  WHERE owner_tenant_id IN (...)               | |\n+|  |  +-------------+                                               | |\n+|  +----------------------------------------------------------------+ |\n++---------------------------------------------------------------------+\n+```\n+\n+---\n+\n+## PEP Enforcement\n+\n+### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant PDP as Auth Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>PDP: evaluation request\n+    PDP-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles the `filters` array to SQL WHERE clauses:\n+\n+1. **Filters within a constraint** are AND'd together\n+2. **Multiple constraints** (alternatives) are OR'd together\n+3. **Unknown filter types** cause that constraint to be treated as false (fail-closed)\n+\n+### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown filter types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle unknown filter ops** - Treat containing constraint as false\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown field names** - Treat containing constraint as false (PEP doesn't know how to map)\n+\n+---\n+\n+## API Specifications\n+\n+### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), filters within constraint are AND'd\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // AuthZEN standard fields\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"\n+    }\n+  },\n+  \"action\": {\n+    \"name\": \"list\"  // or \"read\", \"update\", \"delete\", \"create\"\n+  },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",  // present for point ops, absent for list\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+    }\n+  },\n+\n+  // HyperSpot extension: context with tenant scope and PEP capabilities\n+  \"context\": {\n+    // Tenant scope configuration\n+    \"tenant_scope\": {\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+      \"include_self\": true,\n+      \"depth\": \"descendants\",      // \"none\" | \"children\" | \"descendants\"\n+      \"respect_barrier\": true,     // honor self_managed barrier in hierarchy traversal\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional, filters by tenant status\n+    },\n+\n+    // PEP capabilities: what the caller can enforce locally\n+    \"capabilities\": {\n+      \"require_constraints\": true,              // if true, decision without constraints = deny\n+      \"local_tenant_closure\": true,              // can use tenant_closure table\n+      \"local_resource_group_membership\": true,  // can use resource_group_membership table\n+      \"local_resource_group_closure\": true      // can use resource_group_closure table\n+    }\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint contains a `filters` array of typed filter objects that the PEP compiles to SQL.\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    \"constraints\": [{\n+      // Filters within a constraint are AND'd together\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter - uses local tenant_closure table\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+          \"respect_barrier\": true,\n+          \"tenant_status\": [\"active\", \"suspended\"]\n+        },\n+        {\n+          // Simple column equality from resource properties\n+          \"type\": \"field\",\n+          \"field\": \"resource.topic_id\",\n+          \"op\": \"eq\",\n+          \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+        }\n+      ]\n+    }]\n+  }\n+}\n+```\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-A\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        { \"type\": \"tenant_ownership\", \"op\": \"in_closure\", \"ancestor_id\": \"tenant-A\", \"respect_barrier\": true }\n+      ]\n+    }]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Filter\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [{\n+      \"filters\": [\n+        {\n+          // Tenant ownership filter\n+          \"type\": \"tenant_ownership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"tenant-A\",\n+          \"respect_barrier\": true\n+        },\n+        {\n+          // Resource group membership with closure - uses resource_group_membership + resource_group_closure tables\n+          \"type\": \"group_membership\",\n+          \"op\": \"in_closure\",\n+          \"ancestor_id\": \"project-root-group\"\n+        }\n+      ]\n+    }]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+```jsonc\n+{\n+  \"decision\": false\n+}\n+```\n+\n+---\n+\n+## Filter Types Reference\n+\n+The following filter types can appear in the `filters` array. There are **three distinct filter types**, each with specific semantics:\n+\n+| Filter Type | Description | Operations |\n+|-------------|-------------|------------|\n+| `field` | Simple column comparisons on resource properties | `eq`, `in` |\n+| `tenant_ownership` | Tenant hierarchy filtering | `in`, `in_closure` |\n+| `group_membership` | Resource group membership filtering | `in`, `in_closure` |\n+\n+### 1. Field Filter (`type: \"field\"`)\n+\n+Simple operations on resource columns. Filter fields use **logical names** (DSL), not physical column names. PEP maps logical fields to actual database columns.\n+\n+**Schema:**\n+- `type` (required): `\"field\"`\n+- `field` (required): Logical field name in DSL format (`resource.<property>`)\n+- `op` (required): `\"eq\"` | `\"in\"`\n+- `value` (required for `op: eq`): Single value\n+- `values` (required for `op: in`): Array of values\n+\n+```jsonc\n+// Equality\n+{ \"type\": \"field\", \"field\": \"resource.topic_id\", \"op\": \"eq\", \"value\": \"uuid-123\" }\n+// PEP maps resource.topic_id -> topic_id column\n+// SQL: topic_id = 'uuid-123'\n+\n+// IN list\n+{ \"type\": \"field\", \"field\": \"resource.status\", \"op\": \"in\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+**Field naming convention (DSL):**\n+\n+| Prefix | Maps To | Example |\n+|--------|---------|---------|\n+| `resource.<property>` | Resource table column | `resource.topic_id` -> `topic_id` |\n+\n+PEP maintains mapping from logical field names to physical schema. PDP uses only logical names — **it doesn't know the database schema**.\n+\n+### 2. Tenant Ownership Filter (`type: \"tenant_ownership\"`)\n+\n+Filters resources by tenant hierarchy. The tenant column name in the resource table is configured at the module level when setting up the SQL builder (default: `owner_tenant_id`). Different resources may have different tenant columns (e.g., `owner_tenant_id`, `billing_tenant_id`).\n+\n+**Schema:**\n+- `type` (required): `\"tenant_ownership\"`\n+- `op` (required): `\"in\"` | `\"in_closure\"`\n+- `values` (required for `op: in`): Array of tenant IDs\n+- `ancestor_id` (required for `op: in_closure`): Root of tenant subtree\n+- `respect_barrier` (optional for `op: in_closure`): Honor `self_managed` barrier in hierarchy traversal, default `false`\n+- `tenant_status` (optional for `op: in_closure`): Filter by tenant status\n+\n+```jsonc\n+// Explicit tenant IDs\n+{ \"type\": \"tenant_ownership\", \"op\": \"in\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+// Tenant closure (requires local_tenant_closure capability)\n+{\n+  \"type\": \"tenant_ownership\",\n+  \"op\": \"in_closure\",\n+  \"ancestor_id\": \"tenant-A\",\n+  \"respect_barrier\": true,\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5288c6b4a25fe5b125e4832b536b93073ccfe274","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for pointing out this - I've added this in the \"Open Questions\" section. I believe we need to have a section with some benchmark results for different RDBMS and some kind of guidelines for using closure tables.","created_at":"2026-02-02T17:32:07Z","updated_at":"2026-02-02T17:32:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2755484941","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755484941"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2755484941"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755484941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1065,"original_line":529,"side":"RIGHT","in_reply_to_id":2726087639,"author_association":"MEMBER","original_position":529,"position":1065,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759033597","pull_request_review_id":3745209854,"id":2759033597,"node_id":"PRRC_kwDOPaLyBs6kc4L9","diff_hunk":"@@ -0,0 +1,1268 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",","path":"docs/authorization/AUTH.md","commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","original_commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"GTS must have 4 segments always:\n- vendor\n- package\n- namespace\n- name\n\nNow there are 5 - x.core.security.subject.user","created_at":"2026-02-03T13:16:23Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2759033597","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759033597"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2759033597"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759033597/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":296,"side":"RIGHT","author_association":"MEMBER","original_position":296,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759036434","pull_request_review_id":3745209854,"id":2759036434,"node_id":"PRRC_kwDOPaLyBs6kc44S","diff_hunk":"@@ -0,0 +1,1268 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+10. **Handle empty constraints array** - If `constraints` field is present but empty (`constraints: []`) -> deny all. An empty array means no access paths exist (OR of empty set is false).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type","path":"docs/authorization/AUTH.md","commit_id":"51d28fc84a77c6080af0060f595be1409408b91b","original_commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It must be gtx.x.core.events.event.v1 (4 segments always)","created_at":"2026-02-03T13:17:01Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2759036434","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759036434"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2759036434"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2759036434/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":740,"side":"RIGHT","author_association":"MEMBER","original_position":740,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761493312","pull_request_review_id":3745209854,"id":2761493312,"node_id":"PRRC_kwDOPaLyBs6kmQtA","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We'll need to move it to PRD later...","created_at":"2026-02-03T23:31:05Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761493312","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761493312"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761493312"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761493312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":13,"original_line":13,"side":"RIGHT","author_association":"MEMBER","original_position":13,"position":13,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761495721","pull_request_review_id":3745209854,"id":2761495721,"node_id":"PRRC_kwDOPaLyBs6kmRSp","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In the PRD, we'd need to start with the glossary to explain PDP, PEP, etc","created_at":"2026-02-03T23:32:12Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761495721","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761495721"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761495721"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761495721/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":17,"original_line":17,"side":"RIGHT","author_association":"MEMBER","original_position":17,"position":17,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761498816","pull_request_review_id":3745209854,"id":2761498816,"node_id":"PRRC_kwDOPaLyBs6kmSDA","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).\n+\n+3. **Seamless vendor integration** — HyperSpot must integrate into vendor's existing infrastructure without requiring significant changes on their side:\n+   - **No resource sync** — Resources stay in HyperSpot's DB; vendors don't need to replicate millions of resources or all their relationships to their authorization service\n+   - **No policy format requirements** — Vendors keep their existing policy storage (RBAC tables, ReBAC tuples, custom DSL); HyperSpot only defines the response contract\n+   - **Leverage existing infrastructure** — Works with vendor's IdP, tenant service, and policy manager as-is\n+\n+### PDP/PEP Architecture Model\n+\n+Industry best practices (NIST SP 800-162, XACML, AuthZEN) recommend separating authorization into:\n+\n+- **PDP (Policy Decision Point)** — Evaluates policies and returns access decisions. In HyperSpot, this is the vendor's authorization service accessed via AuthZ Resolver gateway.\n+- **PEP (Policy Enforcement Point)** — Enforces PDP decisions at resource access points. In HyperSpot, domain modules act as PEPs, with ModKit providing shared enforcement infrastructure.\n+- **PAP (Policy Administration Point)** — Where policies are authored and managed. This is entirely vendor-controlled (their admin UI, policy DSL, etc.). HyperSpot never sees or stores policies.","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"technically we can have our module that stores and manages policy, just for those who do not have it","created_at":"2026-02-03T23:33:40Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761498816","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761498816"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761498816"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761498816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":30,"original_line":30,"side":"RIGHT","author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761557088","pull_request_review_id":3745209854,"id":2761557088,"node_id":"PRRC_kwDOPaLyBs6kmgRg","diff_hunk":"@@ -0,0 +1,200 @@\n+---\n+status: accepted\n+date: 2026-01-29\n+decision-makers: Vasily\n+---\n+\n+# Use Separate AuthN Resolver and AuthZ Resolver\n+\n+## Context and Problem Statement\n+\n+HyperSpot requires integration with vendor-specific identity and authorization infrastructure. This integration involves two distinct concerns:","path":"docs/arch/authorization/ADR/0002-split-authn-authz-resolvers.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"again, we might have local implementation as well for those who do not have own identity and authorization, so need just to rephrase it a bit","created_at":"2026-02-03T23:58:42Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761557088","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761557088"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761557088"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761557088/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":11,"original_line":11,"side":"RIGHT","author_association":"MEMBER","original_position":11,"position":11,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580531","pull_request_review_id":3745209854,"id":2761580531,"node_id":"PRRC_kwDOPaLyBs6kml_z","diff_hunk":"@@ -0,0 +1,1282 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional","path":"docs/authorization/AUTH.md","commit_id":"51d28fc84a77c6080af0060f595be1409408b91b","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"wrong GTS id (5 tokens, while only 4 allowed)\nalso, can we say that subject is a type and user is an instance? like:\n`gts.x.core.idp.subject.v1~.x.core._.user.v1`\n","created_at":"2026-02-04T00:11:17Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761580531","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580531"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761580531"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580531/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":296,"side":"RIGHT","author_association":"MEMBER","original_position":296,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580835","pull_request_review_id":3745209854,"id":2761580835,"node_id":"PRRC_kwDOPaLyBs6kmmEj","diff_hunk":"@@ -0,0 +1,1282 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |","path":"docs/authorization/AUTH.md","commit_id":"51d28fc84a77c6080af0060f595be1409408b91b","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"wrong GTS id ...","created_at":"2026-02-04T00:11:27Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761580835","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580835"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761580835"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761580835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":462,"side":"RIGHT","author_association":"MEMBER","original_position":462,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761620111","pull_request_review_id":3745209854,"id":2761620111,"node_id":"PRRC_kwDOPaLyBs6kmvqP","diff_hunk":"@@ -0,0 +1,1683 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Authorization Usage Scenarios](#authorization-usage-scenarios)\n+  - [Table of Contents](#table-of-contents)\n+  - [Projection Tables](#projection-tables)\n+    - [What Are Projection Tables?](#what-are-projection-tables)\n+    - [Choosing Projection Tables](#choosing-projection-tables)\n+    - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+    - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+    - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+    - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+    - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+    - [Combinations Summary](#combinations-summary)\n+  - [Scenarios](#scenarios)\n+    - [With `tenant_closure`](#with-tenant_closure)\n+      - [S01: LIST, tenant subtree, PEP has tenant\\_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+      - [S02: GET, tenant subtree, PEP has tenant\\_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+      - [S03: UPDATE, tenant subtree, PEP has tenant\\_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+      - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+      - [S05: LIST, billing data, ignore barriers (barrier\\_mode: \"none\")](#s05-list-billing-data-ignore-barriers-barrier_mode-none)\n+    - [Without `tenant_closure`](#without-tenant_closure)\n+      - [S06: LIST, tenant subtree, PEP without tenant\\_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+      - [S07: GET, tenant subtree, PEP without tenant\\_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+      - [S08: UPDATE, tenant subtree, PEP without tenant\\_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+      - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+    - [Resource Groups](#resource-groups)\n+      - [S10: LIST, group membership, PEP has resource\\_group\\_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+      - [S11: LIST, group subtree, PEP has resource\\_group\\_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+      - [S12: UPDATE, group membership, PEP has resource\\_group\\_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+      - [S13: UPDATE, group subtree, PEP has resource\\_group\\_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+      - [S14: GET, group membership, PEP without resource\\_group\\_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+      - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+    - [Advanced Patterns](#advanced-patterns)\n+      - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+      - [S17: LIST, tenant subtree and group subtree](#s17-list-tenant-subtree-and-group-subtree)\n+      - [S18: LIST, multiple access paths (OR)](#s18-list-multiple-access-paths-or)\n+      - [S19: Access denied](#s19-access-denied)\n+  - [TOCTOU Analysis](#toctou-analysis)\n+    - [When TOCTOU Matters](#when-toctou-matters)\n+    - [How Each Scenario Handles TOCTOU](#how-each-scenario-handles-toctou)\n+    - [Key Insight: Prefetch + Constraint for Mutations](#key-insight-prefetch--constraint-for-mutations)\n+  - [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\",\n+      \"barrier_mode\": \"all\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"barrier_mode\": \"all\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'","path":"docs/arch/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"we'll need to ensure we avoid SQL injections in the implementation if \"root_tnenat_id\" is \"T1'; DROP TABLE tasks; --\"","created_at":"2026-02-04T00:26:08Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761620111","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761620111"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761620111"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761620111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":224,"original_line":224,"side":"RIGHT","author_association":"MEMBER","original_position":224,"position":224,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761632966","pull_request_review_id":3745209854,"id":2761632966,"node_id":"PRRC_kwDOPaLyBs6kmyzG","diff_hunk":"@@ -0,0 +1,1282 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')","path":"docs/authorization/AUTH.md","commit_id":"8b9b7ec58165c6b91c63453998d1c107d7b52286","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe barrier is forgotten here... ","created_at":"2026-02-04T00:32:29Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761632966","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761632966"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761632966"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761632966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":581,"side":"RIGHT","author_association":"MEMBER","original_position":581,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761644320","pull_request_review_id":3745209854,"id":2761644320,"node_id":"PRRC_kwDOPaLyBs6km1kg","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).\n+\n+3. **Seamless vendor integration** — HyperSpot must integrate into vendor's existing infrastructure without requiring significant changes on their side:\n+   - **No resource sync** — Resources stay in HyperSpot's DB; vendors don't need to replicate millions of resources or all their relationships to their authorization service\n+   - **No policy format requirements** — Vendors keep their existing policy storage (RBAC tables, ReBAC tuples, custom DSL); HyperSpot only defines the response contract\n+   - **Leverage existing infrastructure** — Works with vendor's IdP, tenant service, and policy manager as-is\n+\n+### PDP/PEP Architecture Model\n+\n+Industry best practices (NIST SP 800-162, XACML, AuthZEN) recommend separating authorization into:\n+\n+- **PDP (Policy Decision Point)** — Evaluates policies and returns access decisions. In HyperSpot, this is the vendor's authorization service accessed via AuthZ Resolver gateway.\n+- **PEP (Policy Enforcement Point)** — Enforces PDP decisions at resource access points. In HyperSpot, domain modules act as PEPs, with ModKit providing shared enforcement infrastructure.\n+- **PAP (Policy Administration Point)** — Where policies are authored and managed. This is entirely vendor-controlled (their admin UI, policy DSL, etc.). HyperSpot never sees or stores policies.\n+- **PIP (Policy Information Point)** — Provides additional attributes for decision-making (user roles, tenant hierarchy, resource metadata). In HyperSpot, Tenant Resolver and Resource Group Resolver serve as PIPs.\n+\n+Benefits of PDP/PEP separation:\n+\n+- Centralized policy management and auditability\n+- Consistent enforcement across all modules\n+- Separation of concerns (business logic vs authorization logic)\n+- Easier security audits and compliance\n+\n+HyperSpot modules act as PEPs; AuthZ Resolver integrates with vendor's PDP; Tenant/RG Resolvers act as PIPs.\n+\n+## Decision Drivers\n+\n+- **Performance** — O(1) authorization overhead per query, not O(N) per resource\n+- **Simplicity** — Module developers use shared ModKit library, not manual authorization code\n+- **Vendor integration** — No resource sync, no policy format requirements, leverage existing infrastructure\n+- **Vendor-neutral** — No assumption about policy model (RBAC/ABAC/ReBAC)\n+- **Standards-based** — Build on industry standards where possible\n+- **Query-time enforcement** — Authorization as SQL WHERE constraints, not post-fetch filtering\n+\n+## Considered Options\n+\n+- **Option A**: Module-level authorization (PEP = PDP)\n+- **Option B**: Google Zanzibar / ReBAC\n+- **Option C**: OpenID AuthZEN 1.0 (as-is)\n+- **Option D**: OPA Partial Evaluation\n+- **Option E**: OpenID AuthZEN 1.0 + Constraint Extensions\n+\n+## Decision Outcome\n+\n+Chosen option: **Option E - AuthZEN 1.0 + Constraint Extensions**, because it provides a standards-based foundation with targeted extensions for SQL-level constraint enforcement, maintaining vendor neutrality while solving the core architectural challenge of PDP not having access to resources.\n+\n+Implementation:\n+\n+- Use AuthZEN standard request/response structure\n+- Extend evaluation response with optional `context.constraints`\n+- Constraints contain typed filters (field, group_membership) with known operators (eq, in, in_closure)\n+- PEP compiles filters directly to SQL without intermediate translation\n+- Endpoints: `/access/v1/evaluation`, `/access/v1/evaluations`\n+\n+### Consequences\n+\n+**Positive:**\n+\n+- Standards-based foundation (AuthZEN 1.0)\n+- Single endpoint for all operations (LIST, GET, UPDATE, DELETE)\n+- Vendor-neutral: no assumption about policy model\n+- SQL-first: constraints designed for efficient database enforcement\n+- Fail-closed: structural guarantees against authorization bypass","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Please re-check whether the spec actually enforces fail-closed behavior for the following cases and document it explicitly:\n\n- `decision=true` with missing `context.constraints`\n- `decision=true` with `constraints: []`\n- `unknown` / `unsupported` predicate types\n\nIf fail-closed depends on PEP behavior, this must be stated normatively (MUST / MUST NOT), otherwise the claim seems overstated","created_at":"2026-02-04T00:38:46Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761644320","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761644320"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761644320"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761644320/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":79,"original_line":79,"side":"RIGHT","author_association":"MEMBER","original_position":79,"position":79,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761665211","pull_request_review_id":3745209854,"id":2761665211,"node_id":"PRRC_kwDOPaLyBs6km6q7","diff_hunk":"@@ -0,0 +1,696 @@\n+# AuthN Resolver: JWT + OIDC Plugin Reference Implementation\n+\n+## Overview\n+\n+This document describes the **reference implementation** of an AuthN Resolver plugin that supports:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens validated locally via signature verification (RFC 7519)\n+- **Opaque tokens** — Validated via Token Introspection endpoint (RFC 7662)\n+- **OpenID Connect** — Auto-configuration via Discovery (OpenID Connect Core 1.0, Discovery 1.0)\n+\n+**Scope:** This is ONE possible implementation of the `AuthNResolverPluginClient` trait. Vendors may implement different authentication strategies (mTLS, API keys, custom protocols) without following this design.\n+\n+**Use case:** This plugin is suitable for vendors with standard OIDC-compliant Identity Providers that issue JWTs and support token introspection. It ships as part of HyperSpot's standard distribution and can be configured for most OAuth 2.0 / OIDC providers.\n+\n+**Standards:**\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+---\n+\n+## Supported Token Formats\n+\n+**JWT (JSON Web Token):**\n+- **Structure:** Three base64url-encoded segments separated by dots (`header.payload.signature`)\n+- **Contains:** Claims (subject, issuer, expiration, custom fields)\n+- **Validation:** Signature verification via JWKS (JSON Web Key Set)\n+- **Use case:** Self-contained tokens for distributed systems, offline validation\n+\n+**Opaque Tokens:**\n+- **Structure:** Arbitrary string (no internal structure)\n+- **Contains:** No claims (reference to IdP state)\n+- **Validation:** Token Introspection endpoint call\n+- **Use case:** Revocation-sensitive flows, tokens with sensitive claims\n+\n+**Token Type Detection:**\n+- **JWT:** Identified by structure (three base64url segments separated by dots)\n+- **Opaque:** All other formats\n+\n+---\n+\n+## Token Validation Modes\n+\n+The plugin supports three validation modes controlled by `introspection.mode` configuration:\n+\n+| Mode | When | How |\n+|------|------|-----|\n+| JWT local | JWT + introspection not required | Validate signature via JWKS, extract claims |\n+| Introspection | Opaque token OR JWT requiring enrichment/revocation check | Plugin calls `introspection_endpoint` |\n+\n+**Detailed Mode Behavior:**\n+\n+| Mode | JWT Behavior | Opaque Behavior | Use Case |\n+|------|--------------|-----------------|----------|\n+| `never` | Local validation only | **401 Unauthorized** | Offline validation, low latency |\n+| `opaque_only` (default) | Local validation only | Introspection | Balance of performance and revocation |\n+| `always` | Introspection (+ signature check) | Introspection | Strict revocation checking |\n+\n+**Rationale:**\n+- `never` — Fastest, but no revocation checking for JWTs (opaque tokens fail)\n+- `opaque_only` — Default, reasonable balance (JWTs validated locally, opaque via introspection)\n+- `always` — Strictest, every token checked against IdP (highest latency, best revocation guarantees)\n+\n+---\n+\n+## JWT Local Validation Flow\n+\n+**When used:**\n+- `introspection.mode: never` or `opaque_only` (default)\n+- Token is JWT format\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {JWT}\n+    Middleware->>Middleware: Extract iss from JWT (unverified)\n+    Middleware->>Middleware: Lookup iss in jwt.trusted_issuers\n+\n+    alt iss not in jwt.trusted_issuers\n+        Middleware-->>Client: 401 Untrusted issuer\n+    end\n+\n+    alt JWKS not cached or expired (1h)\n+        Middleware->>AuthN: get JWKS(discovery_url)\n+        AuthN->>IdP: GET {discovery_url}/.well-known/openid-configuration\n+        IdP-->>AuthN: { jwks_uri, ... }\n+        AuthN->>IdP: GET {jwks_uri}\n+        IdP-->>AuthN: JWKS\n+        AuthN-->>Middleware: JWKS (cached 1h)\n+    end\n+\n+    Middleware->>Middleware: Validate signature (JWKS)\n+    Middleware->>Middleware: Check exp, aud\n+    Middleware->>Middleware: Extract claims → AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Steps:**\n+\n+1. **Parse JWT** — Decode header and payload (unverified)\n+2. **Issuer Validation** — Check `iss` claim against `trusted_issuers` list\n+3. **JWKS Retrieval** — Fetch signing keys via OpenID Discovery (if not cached)\n+4. **Signature Validation** — Verify JWT signature using key identified by `kid` header\n+5. **Claim Validation** — Verify `exp` (expiration), `aud` (audience), `iss` (issuer)\n+6. **Claim Extraction** — Map JWT claims to `SecurityContext` fields\n+7. **Result Construction** — Wrap `SecurityContext` in `AuthenticationResult`\n+\n+---\n+\n+## Token Introspection Flow\n+\n+**When used:**\n+- `introspection.mode: opaque_only` and token is opaque\n+- `introspection.mode: always` (all tokens)\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {token}\n+\n+    Note over Middleware: Token is opaque OR introspection.mode=always\n+\n+    Middleware->>AuthN: authenticate(token)\n+    AuthN->>IdP: POST /introspect { token }\n+    IdP-->>AuthN: { active: true, sub, sub_tenant_id, sub_type, exp, ... }\n+    AuthN->>AuthN: Map response → AuthenticationResult\n+    AuthN-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Use Cases:**\n+\n+1. **Opaque tokens** — Token is not self-contained, must be validated by IdP\n+2. **JWT enrichment** — JWT lacks required claims (`subject_tenant_id`, `subject_type`), plugin fetches via introspection\n+3. **Revocation checking** — Even for valid JWTs, introspection provides central revocation point\n+\n+---\n+\n+## Configuration\n+\n+**Complete YAML example:**\n+\n+```yaml\n+auth:\n+  jwt:\n+    # Trusted issuers map — required for JWT validation\n+    trusted_issuers:\n+      \"https://accounts.google.com\":\n+        discovery_url: \"https://accounts.google.com\"\n+      \"my-corp-idp\":\n+        discovery_url: \"https://idp.corp.example.com\"\n+\n+    # Audience validation (optional)\n+    require_audience: true  # default: false\n+    expected_audience:\n+      - \"https://*.my-company.com\"  # glob patterns\n+      - \"https://api.my-company.com\"\n+\n+    # Claim mapping — maps JWT claims to SecurityContext fields\n+    claim_mapping:\n+      subject_id: \"sub\"  # default: \"sub\"\n+      subject_type: \"sub_type\"  # vendor-specific, no default\n+      subject_tenant_id: \"tenant_id\"  # vendor-specific, e.g., \"tenant_id\", \"org_id\", \"account_id\"\n+      token_scopes: \"scope\"  # default: \"scope\", can be \"permissions\", \"scp\"\n+\n+  jwks:\n+    cache:\n+      ttl: 1h  # JWKS cache TTL (default: 1h)\n+\n+  introspection:\n+    # When to introspect tokens\n+    mode: opaque_only  # never | opaque_only (default) | always\n+\n+    # Global introspection endpoint (applies to all issuers)\n+    # If not set, endpoint is discovered per-issuer via OIDC config\n+    endpoint: \"https://idp.corp.example.com/oauth2/introspect\"\n+\n+    # Claim mapping for introspection response (if different from JWT)\n+    # If not specified, uses jwt.claim_mapping\n+    claim_mapping:\n+      subject_id: \"sub\"\n+      subject_type: \"sub_type\"\n+      subject_tenant_id: \"tenant_id\"\n+      token_scopes: \"scope\"\n+\n+    # Introspection result caching\n+    cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 5m  # default: 5m (upper bound, actual TTL = min(exp, ttl))\n+\n+    # Discovery endpoint caching (per-issuer introspection endpoint URLs)\n+    endpoint_discovery_cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 1h  # default: 1h\n+```\n+\n+### Configuration Sections\n+\n+#### jwt.trusted_issuers\n+\n+Map of issuer identifier to discovery configuration. **Required** for JWT validation.\n+\n+**Format:**\n+```yaml\n+trusted_issuers:\n+  \"<iss-claim-value>\":\n+    discovery_url: \"<base-url-for-oidc-discovery>\"\n+```\n+\n+**Why required:**\n+- **Trust anchor** — Plugin must know which issuers to trust before validating tokens\n+- **Bootstrap problem** — To validate JWT signature, need JWKS; to get JWKS, need discovery URL\n+- **Flexible mapping** — `iss` claim may differ from discovery URL\n+\n+**Lazy initialization:**\n+1. Admin configures `trusted_issuers` map\n+2. On first request, extract `iss` from JWT (unverified)\n+3. Look up `iss` in map → get discovery URL\n+4. If not found → reject (untrusted issuer)\n+5. Fetch OIDC config from `{discovery_url}/.well-known/openid-configuration`\n+6. Cache JWKS and validate signature\n+\n+#### jwt.require_audience\n+\n+Boolean flag controlling audience validation:\n+- `true` — JWT MUST have `aud` claim, and it must match `expected_audience` patterns\n+- `false` (default) — `aud` claim is optional; if present, validated against `expected_audience`\n+\n+#### jwt.expected_audience\n+\n+List of glob patterns for valid audiences. Supports `*` wildcard.\n+\n+**Examples:**\n+- `https://*.my-company.com` — matches `https://api.my-company.com`, `https://web.my-company.com`\n+- `https://api.my-company.com` — exact match only\n+\n+**Validation:**\n+- If JWT has `aud` claim and `expected_audience` is configured → at least one audience must match a pattern\n+- If JWT has `aud` claim but `expected_audience` is empty → validation passes (no restrictions)\n+- If JWT lacks `aud` claim → validation passes if `require_audience: false`, fails if `require_audience: true`\n+\n+#### jwt.claim_mapping\n+\n+Maps JWT claim names to `SecurityContext` fields. Required to handle vendor-specific claim names.\n+\n+**Fields:**\n+- `subject_id` (string) — Claim name for subject identifier (default: `\"sub\"`)\n+- `subject_type` (string) — Claim name for subject type (vendor-specific, no default)\n+- `subject_tenant_id` (string) — Claim name for subject's tenant ID (vendor-specific, e.g., `\"tenant_id\"`, `\"org_id\"`, `\"account_id\"`)\n+- `token_scopes` (string) — Claim name for token scopes (default: `\"scope\"`, can be `\"permissions\"`, `\"scp\"`)\n+\n+**Example:**\n+```yaml\n+claim_mapping:\n+  subject_id: \"sub\"\n+  subject_type: \"user_type\"\n+  subject_tenant_id: \"org_id\"\n+  token_scopes: \"permissions\"\n+```\n+\n+**Behavior:**\n+- Plugin extracts claim value using specified name\n+- If claim is missing and field is required (`subject_id`, `subject_tenant_id`) → authentication fails\n+- If claim is missing and field is optional (`subject_type`) → field is omitted from SecurityContext\n+\n+#### jwks.cache.ttl\n+\n+JWKS (JSON Web Key Set) cache TTL. Default: `1h`.\n+\n+**Behavior:**\n+- JWKS is fetched on first token validation for an issuer\n+- Cached for `ttl` duration\n+- Automatically refreshed on cache expiry or when signature validation fails with unknown `kid`\n+\n+#### introspection.mode\n+\n+Controls when introspection is triggered:\n+\n+| Value | Description |\n+|-------|-------------|\n+| `never` | JWT local validation only (opaque tokens fail) |\n+| `opaque_only` (default) | JWT local validation, opaque tokens via introspection |\n+| `always` | All tokens (JWT and opaque) go through introspection |\n+\n+#### introspection.endpoint\n+\n+Global introspection endpoint URL. If configured, used for all issuers.\n+\n+**If not configured:**\n+- For JWT tokens with `introspection.mode: always` → endpoint discovered from issuer's OIDC config (`introspection_endpoint` field)\n+- For opaque tokens → **401 Unauthorized** (no `iss` claim to discover endpoint)\n+\n+**Configuration Matrix:**\n+\n+| Token Type | `introspection.mode` | `introspection.endpoint` | Behavior |\n+|------------|----------------------|--------------------------|----------|\n+| JWT | `never` | (any) | Local validation only, no introspection |\n+| JWT | `opaque_only` | (any) | Local validation only |\n+| JWT | `always` | configured | Use configured endpoint |\n+| JWT | `always` | not configured | Discover endpoint from issuer's OIDC config |\n+| Opaque | `never` | (any) | **401 Unauthorized** (cannot validate opaque without introspection) |\n+| Opaque | `opaque_only` / `always` | configured | Use configured endpoint |\n+| Opaque | `opaque_only` / `always` | not configured | **401 Unauthorized** (no `iss` claim to discover endpoint) |\n+\n+**Note:** Discovery requires the `iss` claim to look up the issuer configuration. Opaque tokens don't contain claims, so discovery is only possible for JWTs. For opaque tokens, `introspection.endpoint` must be explicitly configured.\n+\n+#### introspection.claim_mapping\n+\n+Maps introspection response field names to `SecurityContext` fields. Optional — if not specified, uses `jwt.claim_mapping`.\n+\n+**Fields:**\n+- `subject_id` (string) — Response field for subject identifier (default: `\"sub\"`)\n+- `subject_type` (string) — Response field for subject type (vendor-specific)\n+- `subject_tenant_id` (string) — Response field for subject's tenant ID (vendor-specific)\n+- `token_scopes` (string) — Response field for token scopes (default: `\"scope\"`)\n+\n+**Example:**\n+```yaml\n+introspection:\n+  claim_mapping:\n+    subject_id: \"sub\"\n+    subject_type: \"user_type\"\n+    subject_tenant_id: \"organization_id\"\n+    token_scopes: \"scope\"\n+```\n+\n+**Behavior:**\n+- If not configured, falls back to `jwt.claim_mapping`\n+- Useful when introspection response uses different field names than JWT claims\n+- If field is missing in response and required → authentication fails\n+\n+#### introspection.cache\n+\n+Introspection result caching configuration.\n+\n+**Fields:**\n+- `enabled` (bool) — Enable caching (default: `true`)\n+- `max_entries` (int) — Max cached introspection results (default: `10000`)\n+- `ttl` (duration) — Cache TTL upper bound (default: `5m`)","path":"docs/authorization/AUTHN_JWT_OIDC_PLUGIN.md","commit_id":"8b9b7ec58165c6b91c63453998d1c107d7b52286","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As I understand 5m is too much for highly regulated systems and it will be flagged as a TOCTOU  vulnerability, I'd set it to 0 (?) by default, but then create a performance section in some tutorial to explain how to tune performance","created_at":"2026-02-04T00:49:17Z","updated_at":"2026-02-04T01:07:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761665211","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761665211"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2761665211"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2761665211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":360,"side":"RIGHT","author_association":"MEMBER","original_position":360,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763095091","pull_request_review_id":3750017936,"id":2763095091,"node_id":"PRRC_kwDOPaLyBs6ksXwz","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Agree. I’ll prepare a PRD based on these docs and align the ADRs with the templates once https://github.com/hypernetix/hyperspot/pull/400 is merged.\r\n\r\nMy suggestion is to not block on this: if everyone is OK with the current content, let’s merge this PR now and I’ll follow up with the PRD + ADR-template alignment in the next PR.","created_at":"2026-02-04T09:41:50Z","updated_at":"2026-02-04T09:41:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763095091","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763095091"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763095091"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763095091/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":13,"original_line":13,"side":"RIGHT","in_reply_to_id":2761493312,"author_association":"MEMBER","original_position":13,"position":13,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763099108","pull_request_review_id":3750022021,"id":2763099108,"node_id":"PRRC_kwDOPaLyBs6ksYvk","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"ok, will do. Regarding PRD - pls check my suggestion in https://github.com/hypernetix/hyperspot/pull/282#discussion_r2763095091.","created_at":"2026-02-04T09:42:45Z","updated_at":"2026-02-04T09:42:45Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763099108","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763099108"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763099108"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763099108/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":17,"original_line":17,"side":"RIGHT","in_reply_to_id":2761495721,"author_association":"MEMBER","original_position":17,"position":17,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763109947","pull_request_review_id":3750034142,"id":2763109947,"node_id":"PRRC_kwDOPaLyBs6ksbY7","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).\n+\n+3. **Seamless vendor integration** — HyperSpot must integrate into vendor's existing infrastructure without requiring significant changes on their side:\n+   - **No resource sync** — Resources stay in HyperSpot's DB; vendors don't need to replicate millions of resources or all their relationships to their authorization service\n+   - **No policy format requirements** — Vendors keep their existing policy storage (RBAC tables, ReBAC tuples, custom DSL); HyperSpot only defines the response contract\n+   - **Leverage existing infrastructure** — Works with vendor's IdP, tenant service, and policy manager as-is\n+\n+### PDP/PEP Architecture Model\n+\n+Industry best practices (NIST SP 800-162, XACML, AuthZEN) recommend separating authorization into:\n+\n+- **PDP (Policy Decision Point)** — Evaluates policies and returns access decisions. In HyperSpot, this is the vendor's authorization service accessed via AuthZ Resolver gateway.\n+- **PEP (Policy Enforcement Point)** — Enforces PDP decisions at resource access points. In HyperSpot, domain modules act as PEPs, with ModKit providing shared enforcement infrastructure.\n+- **PAP (Policy Administration Point)** — Where policies are authored and managed. This is entirely vendor-controlled (their admin UI, policy DSL, etc.). HyperSpot never sees or stores policies.","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, but this is a big topic that requires deep investigation and a proper design","created_at":"2026-02-04T09:45:21Z","updated_at":"2026-02-04T09:45:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763109947","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763109947"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763109947"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763109947/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":30,"original_line":30,"side":"RIGHT","in_reply_to_id":2761498816,"author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763628827","pull_request_review_id":3750619106,"id":2763628827,"node_id":"PRRC_kwDOPaLyBs6kuaEb","diff_hunk":"@@ -0,0 +1,1693 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Authorization Usage Scenarios](#authorization-usage-scenarios)\n+  - [Table of Contents](#table-of-contents)\n+  - [Projection Tables](#projection-tables)\n+    - [What Are Projection Tables?](#what-are-projection-tables)\n+    - [Choosing Projection Tables](#choosing-projection-tables)\n+    - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+    - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+    - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+    - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+    - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+    - [Combinations Summary](#combinations-summary)\n+  - [Scenarios](#scenarios)\n+    - [With `tenant_closure`](#with-tenant_closure)\n+      - [S01: LIST, tenant subtree, PEP has tenant\\_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+      - [S02: GET, tenant subtree, PEP has tenant\\_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+      - [S03: UPDATE, tenant subtree, PEP has tenant\\_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+      - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+      - [S05: LIST, billing data, ignore barriers (barrier\\_mode: \"none\")](#s05-list-billing-data-ignore-barriers-barrier_mode-none)\n+    - [Without `tenant_closure`](#without-tenant_closure)\n+      - [S06: LIST, tenant subtree, PEP without tenant\\_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+      - [S07: GET, tenant subtree, PEP without tenant\\_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+      - [S08: UPDATE, tenant subtree, PEP without tenant\\_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+      - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+    - [Resource Groups](#resource-groups)\n+      - [S10: LIST, group membership, PEP has resource\\_group\\_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+      - [S11: LIST, group subtree, PEP has resource\\_group\\_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+      - [S12: UPDATE, group membership, PEP has resource\\_group\\_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+      - [S13: UPDATE, group subtree, PEP has resource\\_group\\_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+      - [S14: GET, group membership, PEP without resource\\_group\\_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+      - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+    - [Advanced Patterns](#advanced-patterns)\n+      - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+      - [S17: LIST, tenant subtree and group subtree](#s17-list-tenant-subtree-and-group-subtree)\n+      - [S18: LIST, multiple access paths (OR)](#s18-list-multiple-access-paths-or)\n+      - [S19: Access denied](#s19-access-denied)\n+  - [TOCTOU Analysis](#toctou-analysis)\n+    - [When TOCTOU Matters](#when-toctou-matters)\n+    - [How Each Scenario Handles TOCTOU](#how-each-scenario-handles-toctou)\n+    - [Key Insight: Prefetch + Constraint for Mutations](#key-insight-prefetch--constraint-for-mutations)\n+  - [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\",\n+      \"barrier_mode\": \"all\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"barrier_mode\": \"all\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+    AND barrier = 0\n+)\n+```\n+\n+---\n+\n+#### S02: GET, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+User requests a specific task; PEP enforces tenant subtree access at query level.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+      AND barrier = 0  -- barrier_mode defaults to \"all\"\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row → return task\n+- 0 rows → **404 Not Found** (hides resource existence from unauthorized users)\n+\n+---\n+\n+#### S03: UPDATE, tenant subtree, PEP has tenant_closure\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+User updates a task; constraint ensures atomic authorization check.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id IN (\n+    SELECT descendant_id FROM tenant_closure\n+    WHERE ancestor_id = 'T1'\n+      AND barrier = 0  -- barrier_mode defaults to \"all\"\n+  )\n+```\n+\n+**Result interpretation:**\n+- 1 row affected → success\n+- 0 rows affected → **404 Not Found** (task doesn't exist or no access)\n+\n+---\n+\n+#### S04: CREATE, tenant context\n+\n+`POST /tasks`\n+\n+User creates a new task. No constraints needed — PDP just validates permission.\n+\n+**Request:**\n+```http\n+POST /tasks\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"title\": \"New Task\", \"owner_tenant_id\": \"T2\"}\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"root_only\",\n+      \"root_id\": \"T2\"\n+    },\n+    \"require_constraints\": false,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**SQL:**\n+```sql\n+INSERT INTO tasks (id, owner_tenant_id, title, status)\n+VALUES ('task-new', 'T2', 'New Task', 'pending')\n+```\n+\n+**Note:** No constraints returned — `require_constraints: false` allows PEP to trust the decision for CREATE operations.\n+\n+---\n+\n+#### S05: LIST, billing data, ignore barriers (barrier_mode: \"none\")\n+\n+`GET /billing/usage?tenant_subtree=true&barrier_mode=none`\n+\n+Billing service needs usage data from all tenants in subtree, including self-managed tenants (barriers ignored). This is a cross-barrier operation for administrative purposes.\n+\n+**Tenant hierarchy:**\n+```\n+T1 (parent)\n+├── T2 (self_managed=true)  ← barrier (ignored for billing)\n+│   └── T3\n+└── T4\n+```\n+\n+**Request:**\n+```http\n+GET /billing/usage?tenant_subtree=true&barrier_mode=none\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.billing.usage.v1~\" },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\",\n+      \"barrier_mode\": \"none\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"barrier_mode\": \"none\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM billing_usage\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'\n+  -- no barrier clause because barrier_mode = \"none\"\n+)\n+```\n+\n+**Result:** Returns usage data from T1, T2, T3, and T4. Barriers are ignored for billing operations.\n+\n+**tenant_closure data example:**\n+\n+| ancestor_id | descendant_id | barrier |\n+|-------------|---------------|---------|\n+| T1 | T1 | 0 |\n+| T1 | T2 | 1 |\n+| T1 | T3 | 1 |\n+| T1 | T4 | 0 |\n+| T2 | T2 | 0 |\n+| T2 | T3 | 0 |\n+\n+When querying from T1 with `barrier_mode=all`, only rows where `barrier = 0` match → T1, T4.\n+\n+**Key insight:** T2 → T2 and T2 → T3 have `barrier = 0` because barriers are tracked **strictly between** ancestor and descendant, not including the ancestor itself. When T2 is the query root, its self_managed status doesn't block access to its own subtree.\n+\n+---\n+\n+### Without `tenant_closure`\n+\n+PEP has no tenant_closure table → PDP returns explicit IDs or PEP prefetches attributes.\n+\n+---\n+\n+#### S06: LIST, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. PDP resolves the subtree and returns explicit tenant IDs.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP resolves the subtree internally and returns explicit IDs:\n+\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"values\": [\"T1\", \"T2\", \"T3\"]\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN ('T1', 'T2', 'T3')\n+```\n+\n+**Trade-off:** PDP must know the tenant hierarchy and resolve it. Works well for small tenant counts; may not scale for thousands of tenants.\n+\n+---\n+\n+#### S07: GET, tenant subtree, PEP without tenant_closure\n+\n+`GET /tasks/{id}?tenant_subtree=true`\n+\n+PEP doesn't have tenant_closure. For read-only operations, PEP fetches the resource first, then asks PDP for a decision based on resource attributes. No second query needed — TOCTOU is not a concern for reads.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**Step 1 — PEP fetches resource:**\n+```sql\n+SELECT * FROM tasks WHERE id = 'task-456'\n+```\n+Result: full task record with `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request (with resource properties):**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": false,\n+    \"capabilities\": [],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+\n+PDP validates that T2 is in T1's subtree and returns decision only (no constraints needed for read):\n+\n+```json\n+{\n+  \"decision\": true\n+}\n+```\n+\n+**Step 3 — Return result:**\n+- `decision: true` → return already-fetched task\n+- `decision: false` → **404 Not Found** (hides resource existence)\n+- Resource not found in Step 1 → **404 Not Found**\n+\n+**Why no TOCTOU concern:** For GET, the \"use\" is returning data to the client. Even if `owner_tenant_id` changed between check and response, no security violation occurs — the client either gets data they had access to at query time, or gets 404. For mutations (UPDATE/DELETE), see S08.\n+\n+---\n+\n+#### S08: UPDATE, tenant subtree, PEP without tenant_closure (prefetch)\n+\n+`PUT /tasks/{id}?tenant_subtree=true`\n+\n+Unlike S07 (GET), mutations require TOCTOU protection. PEP prefetches `owner_tenant_id`, gets `eq` constraint from PDP, and applies it in UPDATE's WHERE clause. This ensures atomic check-and-modify.\n+\n+**Request:**\n+```http\n+PUT /tasks/task-456?tenant_subtree=true\n+Authorization: Bearer <token>\n+Content-Type: application/json\n+\n+{\"status\": \"completed\"}\n+```\n+\n+**Step 1 — PEP prefetches:**\n+```sql\n+SELECT owner_tenant_id FROM tasks WHERE id = 'task-456'\n+```\n+Result: `owner_tenant_id = 'T2'`\n+\n+**Step 2 — PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"update\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\",\n+    \"properties\": {\n+      \"owner_tenant_id\": \"T2\"\n+    }\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T2\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Step 3 — SQL with constraint:**\n+```sql\n+UPDATE tasks\n+SET status = 'completed'\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T2'\n+```\n+\n+**TOCTOU protection:** If another request changed `owner_tenant_id` between prefetch and UPDATE, the WHERE clause won't match → 0 rows affected → **404**. This prevents unauthorized modification even in a race condition.\n+\n+---\n+\n+#### S09: GET, context tenant only (no subtree)\n+\n+`GET /tasks/{id}`\n+\n+Simplest case — access limited to context tenant only, no subtree traversal. User can only access resources directly owned by their tenant.\n+\n+**Request:**\n+```http\n+GET /tasks/task-456\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.tasks.task.v1~\",\n+    \"id\": \"task-456\"\n+  },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"root_only\",\n+      \"root_id\": \"T1\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"eq\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"value\": \"T1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE id = 'task-456'\n+  AND owner_tenant_id = 'T1'\n+```\n+\n+**Note:** No prefetch needed, no closure table required. PDP returns direct `eq` constraint based on context tenant. This pattern applies when the endpoint operates within a single tenant context, regardless of whether the overall tenant model is hierarchical.","path":"docs/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"78718459191d49439ecb4a3ce9948ecf2b54a08a","original_commit_id":"61b765d2c0c663e5ba22c1bcc1ea1cb43f2ff560","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Hyphenate “single-tenant context.”**\n\nSmall wording fix to align with style guidance and improve readability.  \n\n<details>\n<summary>✍️ Suggested edit</summary>\n\n```diff\n-**Note:** No prefetch needed, no closure table required. PDP returns direct `eq` constraint based on context tenant. This pattern applies when the endpoint operates within a single tenant context, regardless of whether the overall tenant model is hierarchical.\n+**Note:** No prefetch needed, no closure table required. PDP returns direct `eq` constraint based on context tenant. This pattern applies when the endpoint operates within a single-tenant context, regardless of whether the overall tenant model is hierarchical.\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 LanguageTool</summary>\n\n[grammar] ~818-~818: Use a hyphen to join words.\nContext: ...en the endpoint operates within a single tenant context, regardless of whether th...\n\n(QB_NEW_EN_HYPHEN)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTHZ_USAGE_SCENARIOS.md` around lines 754 - 818, Update\nthe wording in the Note paragraph of S09 so that the phrase \"single tenant\ncontext\" is hyphenated to \"single-tenant context\"; locate the sentence that\ncurrently reads \"This pattern applies when the endpoint operates within a single\ntenant context, regardless of whether the overall tenant model is hierarchical.\"\nand change it to use \"single-tenant context\" to follow style guidance.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @aviator5\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-04T11:54:20Z","updated_at":"2026-02-05T08:39:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763628827","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763628827"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763628827"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763628827/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":754,"start_side":"RIGHT","line":null,"original_line":818,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":818,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632568","pull_request_review_id":3727382771,"id":2763632568,"node_id":"PRRC_kwDOPaLyBs6kua-4","diff_hunk":"@@ -0,0 +1,1331 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+10. **Handle empty constraints array** - If `constraints` field is present but empty (`constraints: []`) -> deny all. An empty array means no access paths exist (OR of empty set is false).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // optional - SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // required - SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // optional - SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Context Tenant (optional) — PDP, for example, can determine from token_scopes or subject.tenant_id if absent\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",           // \"root_only\" | \"subtree\", default: \"subtree\"\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // optional - request param (URL query, header), handler can set\n+      \"include_root\": true,        // subtree mode only, default: true, ignored for root_only\n+      \"barrier_mode\": \"all\",       // default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional filter","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"61b765d2c0c663e5ba22c1bcc1ea1cb43f2ff560","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`include_root` parameter is included in the request's `tenant_context` but is never propagated to the predicate response or handled in SQL compilation. The `in_tenant_subtree` predicate schema (lines 1050-1054) does not include an `include_root` field, and the SQL examples always include the root tenant due to self-referential rows in `tenant_closure`. Either:\n\n1. Add `include_root` to the predicate schema and document SQL handling:\n```json\n{\n  \"type\": \"in_tenant_subtree\",\n  \"resource_property\": \"owner_tenant_id\",\n  \"root_tenant_id\": \"...\",\n  \"include_root\": true,\n  \"barrier_mode\": \"all\"\n}\n```\n\n2. Or remove `include_root` from the request schema if it's not needed (since self-referential rows handle it automatically).\n```suggestion\n      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // optional - request param (URL query, header), handler can set\n      \"barrier_mode\": \"all\",       // default: \"all\"\n      \"tenant_status\": [\"active\", \"suspended\"]  // optional filter\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/282?chatWithGeneratedComment=f5c613ae-2b7b-4998-8d9a-bd85d506d6dd\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-04T11:55:17Z","updated_at":"2026-02-04T11:55:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763632568","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632568"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763632568"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632568/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":755,"original_start_line":752,"start_side":"RIGHT","line":757,"original_line":755,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":755,"position":757,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632677","pull_request_review_id":3727382771,"id":2763632677,"node_id":"PRRC_kwDOPaLyBs6kubAl","diff_hunk":"@@ -0,0 +1,696 @@\n+# AuthN Resolver: JWT + OIDC Plugin Reference Implementation\n+\n+## Overview\n+\n+This document describes the **reference implementation** of an AuthN Resolver plugin that supports:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens validated locally via signature verification (RFC 7519)\n+- **Opaque tokens** — Validated via Token Introspection endpoint (RFC 7662)\n+- **OpenID Connect** — Auto-configuration via Discovery (OpenID Connect Core 1.0, Discovery 1.0)\n+\n+**Scope:** This is ONE possible implementation of the `AuthNResolverPluginClient` trait. Vendors may implement different authentication strategies (mTLS, API keys, custom protocols) without following this design.\n+\n+**Use case:** This plugin is suitable for vendors with standard OIDC-compliant Identity Providers that issue JWTs and support token introspection. It ships as part of HyperSpot's standard distribution and can be configured for most OAuth 2.0 / OIDC providers.\n+\n+**Standards:**\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+---\n+\n+## Supported Token Formats\n+\n+**JWT (JSON Web Token):**\n+- **Structure:** Three base64url-encoded segments separated by dots (`header.payload.signature`)\n+- **Contains:** Claims (subject, issuer, expiration, custom fields)\n+- **Validation:** Signature verification via JWKS (JSON Web Key Set)\n+- **Use case:** Self-contained tokens for distributed systems, offline validation\n+\n+**Opaque Tokens:**\n+- **Structure:** Arbitrary string (no internal structure)\n+- **Contains:** No claims (reference to IdP state)\n+- **Validation:** Token Introspection endpoint call\n+- **Use case:** Revocation-sensitive flows, tokens with sensitive claims\n+\n+**Token Type Detection:**\n+- **JWT:** Identified by structure (three base64url segments separated by dots)\n+- **Opaque:** All other formats\n+\n+---\n+\n+## Token Validation Modes\n+\n+The plugin supports three validation modes controlled by `introspection.mode` configuration:\n+\n+| Mode | When | How |\n+|------|------|-----|\n+| JWT local | JWT + introspection not required | Validate signature via JWKS, extract claims |\n+| Introspection | Opaque token OR JWT requiring enrichment/revocation check | Plugin calls `introspection_endpoint` |\n+\n+**Detailed Mode Behavior:**\n+\n+| Mode | JWT Behavior | Opaque Behavior | Use Case |\n+|------|--------------|-----------------|----------|\n+| `never` | Local validation only | **401 Unauthorized** | Offline validation, low latency |\n+| `opaque_only` (default) | Local validation only | Introspection | Balance of performance and revocation |\n+| `always` | Introspection (+ signature check) | Introspection | Strict revocation checking |\n+\n+**Rationale:**\n+- `never` — Fastest, but no revocation checking for JWTs (opaque tokens fail)\n+- `opaque_only` — Default, reasonable balance (JWTs validated locally, opaque via introspection)\n+- `always` — Strictest, every token checked against IdP (highest latency, best revocation guarantees)\n+\n+---\n+\n+## JWT Local Validation Flow\n+\n+**When used:**\n+- `introspection.mode: never` or `opaque_only` (default)\n+- Token is JWT format\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {JWT}\n+    Middleware->>Middleware: Extract iss from JWT (unverified)\n+    Middleware->>Middleware: Lookup iss in jwt.trusted_issuers\n+\n+    alt iss not in jwt.trusted_issuers\n+        Middleware-->>Client: 401 Untrusted issuer\n+    end\n+\n+    alt JWKS not cached or expired (1h)\n+        Middleware->>AuthN: get JWKS(discovery_url)\n+        AuthN->>IdP: GET {discovery_url}/.well-known/openid-configuration\n+        IdP-->>AuthN: { jwks_uri, ... }\n+        AuthN->>IdP: GET {jwks_uri}\n+        IdP-->>AuthN: JWKS\n+        AuthN-->>Middleware: JWKS (cached 1h)\n+    end\n+\n+    Middleware->>Middleware: Validate signature (JWKS)\n+    Middleware->>Middleware: Check exp, aud\n+    Middleware->>Middleware: Extract claims → AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Steps:**\n+\n+1. **Parse JWT** — Decode header and payload (unverified)\n+2. **Issuer Validation** — Check `iss` claim against `trusted_issuers` list\n+3. **JWKS Retrieval** — Fetch signing keys via OpenID Discovery (if not cached)\n+4. **Signature Validation** — Verify JWT signature using key identified by `kid` header\n+5. **Claim Validation** — Verify `exp` (expiration), `aud` (audience), `iss` (issuer)\n+6. **Claim Extraction** — Map JWT claims to `SecurityContext` fields\n+7. **Result Construction** — Wrap `SecurityContext` in `AuthenticationResult`\n+\n+---\n+\n+## Token Introspection Flow\n+\n+**When used:**\n+- `introspection.mode: opaque_only` and token is opaque\n+- `introspection.mode: always` (all tokens)\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {token}\n+\n+    Note over Middleware: Token is opaque OR introspection.mode=always\n+\n+    Middleware->>AuthN: authenticate(token)\n+    AuthN->>IdP: POST /introspect { token }\n+    IdP-->>AuthN: { active: true, sub, sub_tenant_id, sub_type, exp, ... }\n+    AuthN->>AuthN: Map response → AuthenticationResult\n+    AuthN-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Use Cases:**\n+\n+1. **Opaque tokens** — Token is not self-contained, must be validated by IdP\n+2. **JWT enrichment** — JWT lacks required claims (`subject_tenant_id`, `subject_type`), plugin fetches via introspection\n+3. **Revocation checking** — Even for valid JWTs, introspection provides central revocation point\n+\n+---\n+\n+## Configuration\n+\n+**Complete YAML example:**\n+\n+```yaml\n+auth:\n+  jwt:\n+    # Trusted issuers map — required for JWT validation\n+    trusted_issuers:\n+      \"https://accounts.google.com\":\n+        discovery_url: \"https://accounts.google.com\"\n+      \"my-corp-idp\":\n+        discovery_url: \"https://idp.corp.example.com\"\n+\n+    # Audience validation (optional)\n+    require_audience: true  # default: false\n+    expected_audience:\n+      - \"https://*.my-company.com\"  # glob patterns\n+      - \"https://api.my-company.com\"\n+\n+    # Claim mapping — maps JWT claims to SecurityContext fields\n+    claim_mapping:\n+      subject_id: \"sub\"  # default: \"sub\"\n+      subject_type: \"sub_type\"  # vendor-specific, no default\n+      subject_tenant_id: \"tenant_id\"  # vendor-specific, e.g., \"tenant_id\", \"org_id\", \"account_id\"\n+      token_scopes: \"scope\"  # default: \"scope\", can be \"permissions\", \"scp\"\n+\n+  jwks:\n+    cache:\n+      ttl: 1h  # JWKS cache TTL (default: 1h)\n+\n+  introspection:\n+    # When to introspect tokens\n+    mode: opaque_only  # never | opaque_only (default) | always\n+\n+    # Global introspection endpoint (applies to all issuers)\n+    # If not set, endpoint is discovered per-issuer via OIDC config\n+    endpoint: \"https://idp.corp.example.com/oauth2/introspect\"\n+\n+    # Claim mapping for introspection response (if different from JWT)\n+    # If not specified, uses jwt.claim_mapping\n+    claim_mapping:\n+      subject_id: \"sub\"\n+      subject_type: \"sub_type\"\n+      subject_tenant_id: \"tenant_id\"\n+      token_scopes: \"scope\"\n+\n+    # Introspection result caching\n+    cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 5m  # default: 5m (upper bound, actual TTL = min(exp, ttl))\n+\n+    # Discovery endpoint caching (per-issuer introspection endpoint URLs)\n+    endpoint_discovery_cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 1h  # default: 1h\n+```\n+\n+### Configuration Sections\n+\n+#### jwt.trusted_issuers\n+\n+Map of issuer identifier to discovery configuration. **Required** for JWT validation.\n+\n+**Format:**\n+```yaml\n+trusted_issuers:\n+  \"<iss-claim-value>\":\n+    discovery_url: \"<base-url-for-oidc-discovery>\"\n+```\n+\n+**Why required:**\n+- **Trust anchor** — Plugin must know which issuers to trust before validating tokens\n+- **Bootstrap problem** — To validate JWT signature, need JWKS; to get JWKS, need discovery URL\n+- **Flexible mapping** — `iss` claim may differ from discovery URL\n+\n+**Lazy initialization:**\n+1. Admin configures `trusted_issuers` map\n+2. On first request, extract `iss` from JWT (unverified)\n+3. Look up `iss` in map → get discovery URL\n+4. If not found → reject (untrusted issuer)\n+5. Fetch OIDC config from `{discovery_url}/.well-known/openid-configuration`\n+6. Cache JWKS and validate signature\n+\n+#### jwt.require_audience\n+\n+Boolean flag controlling audience validation:\n+- `true` — JWT MUST have `aud` claim, and it must match `expected_audience` patterns\n+- `false` (default) — `aud` claim is optional; if present, validated against `expected_audience`\n+\n+#### jwt.expected_audience\n+\n+List of glob patterns for valid audiences. Supports `*` wildcard.\n+\n+**Examples:**\n+- `https://*.my-company.com` — matches `https://api.my-company.com`, `https://web.my-company.com`\n+- `https://api.my-company.com` — exact match only\n+\n+**Validation:**\n+- If JWT has `aud` claim and `expected_audience` is configured → at least one audience must match a pattern\n+- If JWT has `aud` claim but `expected_audience` is empty → validation passes (no restrictions)\n+- If JWT lacks `aud` claim → validation passes if `require_audience: false`, fails if `require_audience: true`\n+\n+#### jwt.claim_mapping\n+\n+Maps JWT claim names to `SecurityContext` fields. Required to handle vendor-specific claim names.\n+\n+**Fields:**\n+- `subject_id` (string) — Claim name for subject identifier (default: `\"sub\"`)\n+- `subject_type` (string) — Claim name for subject type (vendor-specific, no default)\n+- `subject_tenant_id` (string) — Claim name for subject's tenant ID (vendor-specific, e.g., `\"tenant_id\"`, `\"org_id\"`, `\"account_id\"`)\n+- `token_scopes` (string) — Claim name for token scopes (default: `\"scope\"`, can be `\"permissions\"`, `\"scp\"`)\n+\n+**Example:**\n+```yaml\n+claim_mapping:\n+  subject_id: \"sub\"\n+  subject_type: \"user_type\"\n+  subject_tenant_id: \"org_id\"\n+  token_scopes: \"permissions\"\n+```\n+\n+**Behavior:**\n+- Plugin extracts claim value using specified name","path":"docs/arch/authorization/AUTHN_JWT_OIDC_PLUGIN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"61b765d2c0c663e5ba22c1bcc1ea1cb43f2ff560","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Contradiction with AUTH.md SecurityContext definition. This line states `subject_tenant_id` is required, but AUTH.md line 452 defines it as `subject_tenant_id: Option<TenantId>` (optional in Rust). AUTH.md line 460 also marks it as optional. This inconsistency will cause implementation confusion about whether to fail authentication when `subject_tenant_id` is missing.\n\nFix: Change to match AUTH.md semantics:\n```markdown\n- If claim is missing and field is required (`subject_id`, `token_scopes`) → authentication fails\n- If claim is missing and field is optional (`subject_type`, `subject_tenant_id`) → field is omitted from SecurityContext\n```\n```suggestion\n- Plugin extracts claim value using specified name (if claim is missing and field is optional like `subject_tenant_id`, the field is omitted from SecurityContext)\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/282?chatWithGeneratedComment=e3d693bb-a447-4f73-a18f-6bd998e5ee03\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-04T11:55:18Z","updated_at":"2026-02-04T11:55:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763632677","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632677"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763632677"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763632677/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":283,"original_line":283,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":283,"position":283,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763652899","pull_request_review_id":3750649777,"id":2763652899,"node_id":"PRRC_kwDOPaLyBs6kuf8j","diff_hunk":"@@ -0,0 +1,1683 @@\n+# Authorization Usage Scenarios\n+\n+This document demonstrates the authorization model through concrete examples.\n+Each scenario shows the full flow: HTTP request → PDP evaluation → SQL execution.\n+\n+For the core authorization design, see [AUTH.md](./AUTH.md).\n+\n+All examples use a Task Management domain:\n+- **Resource:** `tasks` table with `id`, `owner_tenant_id`, `title`, `status`\n+- **Resource Groups:** Projects (tasks belong to projects)\n+- **Tenant Model:** Hierarchical multi-tenancy — see [TENANT_MODEL.md](./TENANT_MODEL.md) for details on topology, barriers, and closure tables\n+\n+---\n+\n+## Table of Contents\n+\n+- [Authorization Usage Scenarios](#authorization-usage-scenarios)\n+  - [Table of Contents](#table-of-contents)\n+  - [Projection Tables](#projection-tables)\n+    - [What Are Projection Tables?](#what-are-projection-tables)\n+    - [Choosing Projection Tables](#choosing-projection-tables)\n+    - [Capabilities and PDP Response](#capabilities-and-pdp-response)\n+    - [When No Projection Tables Are Needed](#when-no-projection-tables-are-needed)\n+    - [When to Use `tenant_closure`](#when-to-use-tenant_closure)\n+    - [When to Use `resource_group_membership`](#when-to-use-resource_group_membership)\n+    - [When to Use `resource_group_closure`](#when-to-use-resource_group_closure)\n+    - [Combinations Summary](#combinations-summary)\n+  - [Scenarios](#scenarios)\n+    - [With `tenant_closure`](#with-tenant_closure)\n+      - [S01: LIST, tenant subtree, PEP has tenant\\_closure](#s01-list-tenant-subtree-pep-has-tenant_closure)\n+      - [S02: GET, tenant subtree, PEP has tenant\\_closure](#s02-get-tenant-subtree-pep-has-tenant_closure)\n+      - [S03: UPDATE, tenant subtree, PEP has tenant\\_closure](#s03-update-tenant-subtree-pep-has-tenant_closure)\n+      - [S04: CREATE, tenant context](#s04-create-tenant-context)\n+      - [S05: LIST, billing data, ignore barriers (barrier\\_mode: \"none\")](#s05-list-billing-data-ignore-barriers-barrier_mode-none)\n+    - [Without `tenant_closure`](#without-tenant_closure)\n+      - [S06: LIST, tenant subtree, PEP without tenant\\_closure](#s06-list-tenant-subtree-pep-without-tenant_closure)\n+      - [S07: GET, tenant subtree, PEP without tenant\\_closure](#s07-get-tenant-subtree-pep-without-tenant_closure)\n+      - [S08: UPDATE, tenant subtree, PEP without tenant\\_closure (prefetch)](#s08-update-tenant-subtree-pep-without-tenant_closure-prefetch)\n+      - [S09: GET, context tenant only (no subtree)](#s09-get-context-tenant-only-no-subtree)\n+    - [Resource Groups](#resource-groups)\n+      - [S10: LIST, group membership, PEP has resource\\_group\\_membership](#s10-list-group-membership-pep-has-resource_group_membership)\n+      - [S11: LIST, group subtree, PEP has resource\\_group\\_closure](#s11-list-group-subtree-pep-has-resource_group_closure)\n+      - [S12: UPDATE, group membership, PEP has resource\\_group\\_membership](#s12-update-group-membership-pep-has-resource_group_membership)\n+      - [S13: UPDATE, group subtree, PEP has resource\\_group\\_closure](#s13-update-group-subtree-pep-has-resource_group_closure)\n+      - [S14: GET, group membership, PEP without resource\\_group\\_membership](#s14-get-group-membership-pep-without-resource_group_membership)\n+      - [S15: LIST, group subtree, PEP has membership but no closure](#s15-list-group-subtree-pep-has-membership-but-no-closure)\n+    - [Advanced Patterns](#advanced-patterns)\n+      - [S16: LIST, tenant subtree and group membership (AND)](#s16-list-tenant-subtree-and-group-membership-and)\n+      - [S17: LIST, tenant subtree and group subtree](#s17-list-tenant-subtree-and-group-subtree)\n+      - [S18: LIST, multiple access paths (OR)](#s18-list-multiple-access-paths-or)\n+      - [S19: Access denied](#s19-access-denied)\n+  - [TOCTOU Analysis](#toctou-analysis)\n+    - [When TOCTOU Matters](#when-toctou-matters)\n+    - [How Each Scenario Handles TOCTOU](#how-each-scenario-handles-toctou)\n+    - [Key Insight: Prefetch + Constraint for Mutations](#key-insight-prefetch--constraint-for-mutations)\n+  - [References](#references)\n+\n+---\n+\n+## Projection Tables\n+\n+### What Are Projection Tables?\n+\n+**Projection tables** are local copies of hierarchical or relational data that enable efficient SQL-level authorization. Instead of calling external services during query execution, PEP uses these pre-synced tables to enforce constraints directly in the database.\n+\n+**The problem they solve:** When PDP returns constraints like \"user can access resources in tenant subtree T1\", the PEP needs to translate this into SQL. Without local data, PEP would need to:\n+1. Call an external service to resolve the tenant hierarchy, or\n+2. Receive thousands of explicit tenant IDs from PDP (doesn't scale)\n+\n+Projection tables allow PEP to JOIN against local data, making authorization O(1) regardless of hierarchy size.\n+\n+**Types of projection tables:**\n+\n+| Table | Purpose | Enables |\n+|-------|---------|---------|\n+| `tenant_closure` | Denormalized tenant hierarchy (ancestor→descendant pairs) | `in_tenant_subtree` predicate — efficient subtree queries without recursive CTEs |\n+| `resource_group_membership` | Resource-to-group associations | `in_group` predicate — filter by group membership |\n+| `resource_group_closure` | Denormalized group hierarchy | `in_group_subtree` predicate — filter by group subtree |\n+\n+**Closure tables** specifically solve the hierarchy traversal problem. A closure table contains all ancestor-descendant pairs, allowing subtree queries with a simple `WHERE ancestor_id = X` instead of recursive tree walking.\n+\n+### Choosing Projection Tables\n+\n+The choice depends on the application's tenant structure, resource organization, and **endpoint requirements**. Even with a hierarchical tenant model, specific endpoints may operate within a single context tenant (see S09).\n+\n+### Capabilities and PDP Response\n+\n+| PEP Capability | Closure Table | Prefetch | PDP Response |\n+|----------------|---------------|----------|--------------|\n+| `tenant_hierarchy` | tenant_closure ✅ | **No** | `in_tenant_subtree` predicate |\n+| (none) | ❌ | **Yes** | `eq`/`in` or decision only |\n+| `group_hierarchy` | resource_group_closure ✅ | **No** | `in_group_subtree` predicate |\n+| `group_membership` | resource_group_membership ✅ | **No** | `in_group` predicate |\n+| (none for groups) | ❌ | **Yes** | explicit resource IDs |\n+\n+### When No Projection Tables Are Needed\n+\n+| Condition | Why Tables Aren't Required |\n+|-----------|---------------------------|\n+| Endpoint operates in context tenant only | No subtree traversal → `eq` on `owner_tenant_id` is sufficient (see S09) |\n+| Few tenants per vendor | PDP can return explicit tenant IDs in `in` predicate |\n+| Flat tenant structure | No hierarchy → `in_tenant_subtree` not needed |\n+| No resource groups | `in_group*` predicates not used |\n+| Low frequency LIST requests | Prefetch overhead is acceptable |\n+\n+**Important:** The first condition applies regardless of overall tenant model. Even in a hierarchical multi-tenant system, specific endpoints may be designed to work within a single context tenant without subtree access. This is an endpoint-level decision, not a system-wide constraint.\n+\n+**Example:** Internal enterprise tool with 10 tenants, flat structure. Or: a \"My Tasks\" endpoint that shows only tasks in user's direct tenant, even though the system supports tenant hierarchy for other operations.\n+\n+### When to Use `tenant_closure`\n+\n+| Condition | Why Closure Is Needed |\n+|-----------|----------------------|\n+| Tenant hierarchy (parent-child) + many tenants | PDP cannot return all IDs in `in` predicate |\n+| Frequent LIST requests by subtree | Subtree JOINs more efficient than explicit ID lists |\n+\n+**Note:** Self-managed tenants (barriers) and tenant status filtering can be checked by PDP on its side — this doesn't require closure on PEP side.\n+\n+**Example:** Multi-tenant SaaS with organization hierarchy (org → teams → projects) and thousands of tenants.\n+\n+### When to Use `resource_group_membership`\n+\n+| Condition | Why Membership Table Is Needed |\n+|-----------|-------------------------------|\n+| Resources belong to groups | Projects, workspaces, folders |\n+| Frequent group-based filters | \"Show all tasks in Project X\" |\n+| Access control via groups | Role assignments at group level |\n+\n+**Example:** Project management tool where tasks belong to projects.\n+\n+### When to Use `resource_group_closure`\n+\n+| Condition | Why Group Closure Is Needed |\n+|-----------|----------------------------|\n+| Group hierarchy | Nested folders, sub-projects |\n+| Subtree queries by groups | \"Show all in folder and subfolders\" |\n+| Many groups | PDP cannot expand entire hierarchy to explicit IDs |\n+\n+**Example:** Document management with nested folders.\n+\n+### Combinations Summary\n+\n+| Use Case | tenant_closure | group_membership | group_closure |\n+|----------|----------------|------------------|---------------|\n+| Simple SaaS (flat tenants, no groups) | ❌ | ❌ | ❌ |\n+| Enterprise SaaS (tenant hierarchy) | ✅ | ❌ | ❌ |\n+| Project-based SaaS (flat tenants + projects) | ❌ | ✅ | ❌ |\n+| Complex SaaS (hierarchy + nested projects) | ✅ | ✅ | ✅ |\n+\n+---\n+\n+## Scenarios\n+\n+> **Note:** SQL examples use subqueries for clarity. Production implementations\n+> may use JOINs or EXISTS for performance optimization.\n+\n+### With `tenant_closure`\n+\n+PEP has local tenant_closure table → can enforce `in_tenant_subtree` predicates.\n+\n+---\n+\n+#### S01: LIST, tenant subtree, PEP has tenant_closure\n+\n+`GET /tasks?tenant_subtree=true`\n+\n+User requests all tasks visible in their tenant subtree.\n+\n+**Request:**\n+```http\n+GET /tasks?tenant_subtree=true\n+Authorization: Bearer <token>\n+```\n+\n+**PEP → PDP Request:**\n+```json\n+{\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",\n+    \"id\": \"user-123\",\n+    \"properties\": { \"tenant_id\": \"T1\" }\n+  },\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.tasks.task.v1~\" },\n+  \"context\": {\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",\n+      \"root_id\": \"T1\",\n+      \"barrier_mode\": \"all\"\n+    },\n+    \"require_constraints\": true,\n+    \"capabilities\": [\"tenant_hierarchy\"],\n+    \"supported_properties\": [\"owner_tenant_id\", \"id\"]\n+  }\n+}\n+```\n+\n+**PDP → PEP Response:**\n+```json\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"T1\",\n+            \"barrier_mode\": \"all\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**SQL:**\n+```sql\n+SELECT * FROM tasks\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = 'T1'","path":"docs/arch/authorization/AUTHZ_USAGE_SCENARIOS.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"it will be fully controlled by modkit-db library","created_at":"2026-02-04T12:00:16Z","updated_at":"2026-02-04T12:00:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763652899","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763652899"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763652899"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763652899/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":224,"original_line":224,"side":"RIGHT","in_reply_to_id":2761620111,"author_association":"MEMBER","original_position":224,"position":224,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763680345","pull_request_review_id":3750684942,"id":2763680345,"node_id":"PRRC_kwDOPaLyBs6kumpZ","diff_hunk":"@@ -0,0 +1,201 @@\n+---\n+status: accepted\n+date: 2026-01-22\n+decision-makers: Cyber Fabric Architects Committee\n+---\n+\n+# Adopt AuthZEN-based PDP/PEP Authorization Model\n+\n+## Context and Problem Statement\n+\n+HyperSpot is a modular platform for building multi-tenant vendor platforms. Each vendor has its own identity provider (IdP), authorization model, tenant service, and policy manager. HyperSpot must integrate with these vendor-specific systems without assuming a particular policy model (RBAC/ABAC/ReBAC).\n+\n+**Key requirements:**\n+\n+1. **Performance at scale** — Authorization must be efficient for all operations, including mass-management scenarios in multi-tenant environments (bulk updates, cross-tenant queries, hierarchical access). Access check complexity varies by vendor and should not bottleneck HyperSpot.\n+\n+2. **Simplicity for module developers** — Authorization enforcement must be hard to get wrong. Authorization logic in modules should be minimal — ideally just \"ask PDP, apply response\". Complex policy evaluation belongs in vendor's PDP, not in HyperSpot code (even shared libraries are costly to update across deployments).\n+\n+3. **Seamless vendor integration** — HyperSpot must integrate into vendor's existing infrastructure without requiring significant changes on their side:\n+   - **No resource sync** — Resources stay in HyperSpot's DB; vendors don't need to replicate millions of resources or all their relationships to their authorization service\n+   - **No policy format requirements** — Vendors keep their existing policy storage (RBAC tables, ReBAC tuples, custom DSL); HyperSpot only defines the response contract\n+   - **Leverage existing infrastructure** — Works with vendor's IdP, tenant service, and policy manager as-is\n+\n+### PDP/PEP Architecture Model\n+\n+Industry best practices (NIST SP 800-162, XACML, AuthZEN) recommend separating authorization into:\n+\n+- **PDP (Policy Decision Point)** — Evaluates policies and returns access decisions. In HyperSpot, this is the vendor's authorization service accessed via AuthZ Resolver gateway.\n+- **PEP (Policy Enforcement Point)** — Enforces PDP decisions at resource access points. In HyperSpot, domain modules act as PEPs, with ModKit providing shared enforcement infrastructure.\n+- **PAP (Policy Administration Point)** — Where policies are authored and managed. This is entirely vendor-controlled (their admin UI, policy DSL, etc.). HyperSpot never sees or stores policies.\n+- **PIP (Policy Information Point)** — Provides additional attributes for decision-making (user roles, tenant hierarchy, resource metadata). In HyperSpot, Tenant Resolver and Resource Group Resolver serve as PIPs.\n+\n+Benefits of PDP/PEP separation:\n+\n+- Centralized policy management and auditability\n+- Consistent enforcement across all modules\n+- Separation of concerns (business logic vs authorization logic)\n+- Easier security audits and compliance\n+\n+HyperSpot modules act as PEPs; AuthZ Resolver integrates with vendor's PDP; Tenant/RG Resolvers act as PIPs.\n+\n+## Decision Drivers\n+\n+- **Performance** — O(1) authorization overhead per query, not O(N) per resource\n+- **Simplicity** — Module developers use shared ModKit library, not manual authorization code\n+- **Vendor integration** — No resource sync, no policy format requirements, leverage existing infrastructure\n+- **Vendor-neutral** — No assumption about policy model (RBAC/ABAC/ReBAC)\n+- **Standards-based** — Build on industry standards where possible\n+- **Query-time enforcement** — Authorization as SQL WHERE constraints, not post-fetch filtering\n+\n+## Considered Options\n+\n+- **Option A**: Module-level authorization (PEP = PDP)\n+- **Option B**: Google Zanzibar / ReBAC\n+- **Option C**: OpenID AuthZEN 1.0 (as-is)\n+- **Option D**: OPA Partial Evaluation\n+- **Option E**: OpenID AuthZEN 1.0 + Constraint Extensions\n+\n+## Decision Outcome\n+\n+Chosen option: **Option E - AuthZEN 1.0 + Constraint Extensions**, because it provides a standards-based foundation with targeted extensions for SQL-level constraint enforcement, maintaining vendor neutrality while solving the core architectural challenge of PDP not having access to resources.\n+\n+Implementation:\n+\n+- Use AuthZEN standard request/response structure\n+- Extend evaluation response with optional `context.constraints`\n+- Constraints contain typed filters (field, group_membership) with known operators (eq, in, in_closure)\n+- PEP compiles filters directly to SQL without intermediate translation\n+- Endpoints: `/access/v1/evaluation`, `/access/v1/evaluations`\n+\n+### Consequences\n+\n+**Positive:**\n+\n+- Standards-based foundation (AuthZEN 1.0)\n+- Single endpoint for all operations (LIST, GET, UPDATE, DELETE)\n+- Vendor-neutral: no assumption about policy model\n+- SQL-first: constraints designed for efficient database enforcement\n+- Fail-closed: structural guarantees against authorization bypass","path":"docs/arch/authorization/ADR/0001-pdp-pep-authorization-model.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"everything is described in `Fail-Closed Rules` section in `AUTH.md`","created_at":"2026-02-04T12:06:25Z","updated_at":"2026-02-04T12:06:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763680345","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763680345"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763680345"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763680345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":79,"original_line":79,"side":"RIGHT","in_reply_to_id":2761644320,"author_association":"MEMBER","original_position":79,"position":79,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763745450","pull_request_review_id":3750758709,"id":2763745450,"node_id":"PRRC_kwDOPaLyBs6ku2iq","diff_hunk":"@@ -0,0 +1,696 @@\n+# AuthN Resolver: JWT + OIDC Plugin Reference Implementation\n+\n+## Overview\n+\n+This document describes the **reference implementation** of an AuthN Resolver plugin that supports:\n+\n+- **JWT (JSON Web Token)** — Self-contained tokens validated locally via signature verification (RFC 7519)\n+- **Opaque tokens** — Validated via Token Introspection endpoint (RFC 7662)\n+- **OpenID Connect** — Auto-configuration via Discovery (OpenID Connect Core 1.0, Discovery 1.0)\n+\n+**Scope:** This is ONE possible implementation of the `AuthNResolverPluginClient` trait. Vendors may implement different authentication strategies (mTLS, API keys, custom protocols) without following this design.\n+\n+**Use case:** This plugin is suitable for vendors with standard OIDC-compliant Identity Providers that issue JWTs and support token introspection. It ships as part of HyperSpot's standard distribution and can be configured for most OAuth 2.0 / OIDC providers.\n+\n+**Standards:**\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+---\n+\n+## Supported Token Formats\n+\n+**JWT (JSON Web Token):**\n+- **Structure:** Three base64url-encoded segments separated by dots (`header.payload.signature`)\n+- **Contains:** Claims (subject, issuer, expiration, custom fields)\n+- **Validation:** Signature verification via JWKS (JSON Web Key Set)\n+- **Use case:** Self-contained tokens for distributed systems, offline validation\n+\n+**Opaque Tokens:**\n+- **Structure:** Arbitrary string (no internal structure)\n+- **Contains:** No claims (reference to IdP state)\n+- **Validation:** Token Introspection endpoint call\n+- **Use case:** Revocation-sensitive flows, tokens with sensitive claims\n+\n+**Token Type Detection:**\n+- **JWT:** Identified by structure (three base64url segments separated by dots)\n+- **Opaque:** All other formats\n+\n+---\n+\n+## Token Validation Modes\n+\n+The plugin supports three validation modes controlled by `introspection.mode` configuration:\n+\n+| Mode | When | How |\n+|------|------|-----|\n+| JWT local | JWT + introspection not required | Validate signature via JWKS, extract claims |\n+| Introspection | Opaque token OR JWT requiring enrichment/revocation check | Plugin calls `introspection_endpoint` |\n+\n+**Detailed Mode Behavior:**\n+\n+| Mode | JWT Behavior | Opaque Behavior | Use Case |\n+|------|--------------|-----------------|----------|\n+| `never` | Local validation only | **401 Unauthorized** | Offline validation, low latency |\n+| `opaque_only` (default) | Local validation only | Introspection | Balance of performance and revocation |\n+| `always` | Introspection (+ signature check) | Introspection | Strict revocation checking |\n+\n+**Rationale:**\n+- `never` — Fastest, but no revocation checking for JWTs (opaque tokens fail)\n+- `opaque_only` — Default, reasonable balance (JWTs validated locally, opaque via introspection)\n+- `always` — Strictest, every token checked against IdP (highest latency, best revocation guarantees)\n+\n+---\n+\n+## JWT Local Validation Flow\n+\n+**When used:**\n+- `introspection.mode: never` or `opaque_only` (default)\n+- Token is JWT format\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {JWT}\n+    Middleware->>Middleware: Extract iss from JWT (unverified)\n+    Middleware->>Middleware: Lookup iss in jwt.trusted_issuers\n+\n+    alt iss not in jwt.trusted_issuers\n+        Middleware-->>Client: 401 Untrusted issuer\n+    end\n+\n+    alt JWKS not cached or expired (1h)\n+        Middleware->>AuthN: get JWKS(discovery_url)\n+        AuthN->>IdP: GET {discovery_url}/.well-known/openid-configuration\n+        IdP-->>AuthN: { jwks_uri, ... }\n+        AuthN->>IdP: GET {jwks_uri}\n+        IdP-->>AuthN: JWKS\n+        AuthN-->>Middleware: JWKS (cached 1h)\n+    end\n+\n+    Middleware->>Middleware: Validate signature (JWKS)\n+    Middleware->>Middleware: Check exp, aud\n+    Middleware->>Middleware: Extract claims → AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Steps:**\n+\n+1. **Parse JWT** — Decode header and payload (unverified)\n+2. **Issuer Validation** — Check `iss` claim against `trusted_issuers` list\n+3. **JWKS Retrieval** — Fetch signing keys via OpenID Discovery (if not cached)\n+4. **Signature Validation** — Verify JWT signature using key identified by `kid` header\n+5. **Claim Validation** — Verify `exp` (expiration), `aud` (audience), `iss` (issuer)\n+6. **Claim Extraction** — Map JWT claims to `SecurityContext` fields\n+7. **Result Construction** — Wrap `SecurityContext` in `AuthenticationResult`\n+\n+---\n+\n+## Token Introspection Flow\n+\n+**When used:**\n+- `introspection.mode: opaque_only` and token is opaque\n+- `introspection.mode: always` (all tokens)\n+\n+**Sequence:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer {token}\n+\n+    Note over Middleware: Token is opaque OR introspection.mode=always\n+\n+    Middleware->>AuthN: authenticate(token)\n+    AuthN->>IdP: POST /introspect { token }\n+    IdP-->>AuthN: { active: true, sub, sub_tenant_id, sub_type, exp, ... }\n+    AuthN->>AuthN: Map response → AuthenticationResult\n+    AuthN-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+**Use Cases:**\n+\n+1. **Opaque tokens** — Token is not self-contained, must be validated by IdP\n+2. **JWT enrichment** — JWT lacks required claims (`subject_tenant_id`, `subject_type`), plugin fetches via introspection\n+3. **Revocation checking** — Even for valid JWTs, introspection provides central revocation point\n+\n+---\n+\n+## Configuration\n+\n+**Complete YAML example:**\n+\n+```yaml\n+auth:\n+  jwt:\n+    # Trusted issuers map — required for JWT validation\n+    trusted_issuers:\n+      \"https://accounts.google.com\":\n+        discovery_url: \"https://accounts.google.com\"\n+      \"my-corp-idp\":\n+        discovery_url: \"https://idp.corp.example.com\"\n+\n+    # Audience validation (optional)\n+    require_audience: true  # default: false\n+    expected_audience:\n+      - \"https://*.my-company.com\"  # glob patterns\n+      - \"https://api.my-company.com\"\n+\n+    # Claim mapping — maps JWT claims to SecurityContext fields\n+    claim_mapping:\n+      subject_id: \"sub\"  # default: \"sub\"\n+      subject_type: \"sub_type\"  # vendor-specific, no default\n+      subject_tenant_id: \"tenant_id\"  # vendor-specific, e.g., \"tenant_id\", \"org_id\", \"account_id\"\n+      token_scopes: \"scope\"  # default: \"scope\", can be \"permissions\", \"scp\"\n+\n+  jwks:\n+    cache:\n+      ttl: 1h  # JWKS cache TTL (default: 1h)\n+\n+  introspection:\n+    # When to introspect tokens\n+    mode: opaque_only  # never | opaque_only (default) | always\n+\n+    # Global introspection endpoint (applies to all issuers)\n+    # If not set, endpoint is discovered per-issuer via OIDC config\n+    endpoint: \"https://idp.corp.example.com/oauth2/introspect\"\n+\n+    # Claim mapping for introspection response (if different from JWT)\n+    # If not specified, uses jwt.claim_mapping\n+    claim_mapping:\n+      subject_id: \"sub\"\n+      subject_type: \"sub_type\"\n+      subject_tenant_id: \"tenant_id\"\n+      token_scopes: \"scope\"\n+\n+    # Introspection result caching\n+    cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 5m  # default: 5m (upper bound, actual TTL = min(exp, ttl))\n+\n+    # Discovery endpoint caching (per-issuer introspection endpoint URLs)\n+    endpoint_discovery_cache:\n+      enabled: true  # default: true\n+      max_entries: 10000  # default: 10000\n+      ttl: 1h  # default: 1h\n+```\n+\n+### Configuration Sections\n+\n+#### jwt.trusted_issuers\n+\n+Map of issuer identifier to discovery configuration. **Required** for JWT validation.\n+\n+**Format:**\n+```yaml\n+trusted_issuers:\n+  \"<iss-claim-value>\":\n+    discovery_url: \"<base-url-for-oidc-discovery>\"\n+```\n+\n+**Why required:**\n+- **Trust anchor** — Plugin must know which issuers to trust before validating tokens\n+- **Bootstrap problem** — To validate JWT signature, need JWKS; to get JWKS, need discovery URL\n+- **Flexible mapping** — `iss` claim may differ from discovery URL\n+\n+**Lazy initialization:**\n+1. Admin configures `trusted_issuers` map\n+2. On first request, extract `iss` from JWT (unverified)\n+3. Look up `iss` in map → get discovery URL\n+4. If not found → reject (untrusted issuer)\n+5. Fetch OIDC config from `{discovery_url}/.well-known/openid-configuration`\n+6. Cache JWKS and validate signature\n+\n+#### jwt.require_audience\n+\n+Boolean flag controlling audience validation:\n+- `true` — JWT MUST have `aud` claim, and it must match `expected_audience` patterns\n+- `false` (default) — `aud` claim is optional; if present, validated against `expected_audience`\n+\n+#### jwt.expected_audience\n+\n+List of glob patterns for valid audiences. Supports `*` wildcard.\n+\n+**Examples:**\n+- `https://*.my-company.com` — matches `https://api.my-company.com`, `https://web.my-company.com`\n+- `https://api.my-company.com` — exact match only\n+\n+**Validation:**\n+- If JWT has `aud` claim and `expected_audience` is configured → at least one audience must match a pattern\n+- If JWT has `aud` claim but `expected_audience` is empty → validation passes (no restrictions)\n+- If JWT lacks `aud` claim → validation passes if `require_audience: false`, fails if `require_audience: true`\n+\n+#### jwt.claim_mapping\n+\n+Maps JWT claim names to `SecurityContext` fields. Required to handle vendor-specific claim names.\n+\n+**Fields:**\n+- `subject_id` (string) — Claim name for subject identifier (default: `\"sub\"`)\n+- `subject_type` (string) — Claim name for subject type (vendor-specific, no default)\n+- `subject_tenant_id` (string) — Claim name for subject's tenant ID (vendor-specific, e.g., `\"tenant_id\"`, `\"org_id\"`, `\"account_id\"`)\n+- `token_scopes` (string) — Claim name for token scopes (default: `\"scope\"`, can be `\"permissions\"`, `\"scp\"`)\n+\n+**Example:**\n+```yaml\n+claim_mapping:\n+  subject_id: \"sub\"\n+  subject_type: \"user_type\"\n+  subject_tenant_id: \"org_id\"\n+  token_scopes: \"permissions\"\n+```\n+\n+**Behavior:**\n+- Plugin extracts claim value using specified name\n+- If claim is missing and field is required (`subject_id`, `subject_tenant_id`) → authentication fails\n+- If claim is missing and field is optional (`subject_type`) → field is omitted from SecurityContext\n+\n+#### jwks.cache.ttl\n+\n+JWKS (JSON Web Key Set) cache TTL. Default: `1h`.\n+\n+**Behavior:**\n+- JWKS is fetched on first token validation for an issuer\n+- Cached for `ttl` duration\n+- Automatically refreshed on cache expiry or when signature validation fails with unknown `kid`\n+\n+#### introspection.mode\n+\n+Controls when introspection is triggered:\n+\n+| Value | Description |\n+|-------|-------------|\n+| `never` | JWT local validation only (opaque tokens fail) |\n+| `opaque_only` (default) | JWT local validation, opaque tokens via introspection |\n+| `always` | All tokens (JWT and opaque) go through introspection |\n+\n+#### introspection.endpoint\n+\n+Global introspection endpoint URL. If configured, used for all issuers.\n+\n+**If not configured:**\n+- For JWT tokens with `introspection.mode: always` → endpoint discovered from issuer's OIDC config (`introspection_endpoint` field)\n+- For opaque tokens → **401 Unauthorized** (no `iss` claim to discover endpoint)\n+\n+**Configuration Matrix:**\n+\n+| Token Type | `introspection.mode` | `introspection.endpoint` | Behavior |\n+|------------|----------------------|--------------------------|----------|\n+| JWT | `never` | (any) | Local validation only, no introspection |\n+| JWT | `opaque_only` | (any) | Local validation only |\n+| JWT | `always` | configured | Use configured endpoint |\n+| JWT | `always` | not configured | Discover endpoint from issuer's OIDC config |\n+| Opaque | `never` | (any) | **401 Unauthorized** (cannot validate opaque without introspection) |\n+| Opaque | `opaque_only` / `always` | configured | Use configured endpoint |\n+| Opaque | `opaque_only` / `always` | not configured | **401 Unauthorized** (no `iss` claim to discover endpoint) |\n+\n+**Note:** Discovery requires the `iss` claim to look up the issuer configuration. Opaque tokens don't contain claims, so discovery is only possible for JWTs. For opaque tokens, `introspection.endpoint` must be explicitly configured.\n+\n+#### introspection.claim_mapping\n+\n+Maps introspection response field names to `SecurityContext` fields. Optional — if not specified, uses `jwt.claim_mapping`.\n+\n+**Fields:**\n+- `subject_id` (string) — Response field for subject identifier (default: `\"sub\"`)\n+- `subject_type` (string) — Response field for subject type (vendor-specific)\n+- `subject_tenant_id` (string) — Response field for subject's tenant ID (vendor-specific)\n+- `token_scopes` (string) — Response field for token scopes (default: `\"scope\"`)\n+\n+**Example:**\n+```yaml\n+introspection:\n+  claim_mapping:\n+    subject_id: \"sub\"\n+    subject_type: \"user_type\"\n+    subject_tenant_id: \"organization_id\"\n+    token_scopes: \"scope\"\n+```\n+\n+**Behavior:**\n+- If not configured, falls back to `jwt.claim_mapping`\n+- Useful when introspection response uses different field names than JWT claims\n+- If field is missing in response and required → authentication fails\n+\n+#### introspection.cache\n+\n+Introspection result caching configuration.\n+\n+**Fields:**\n+- `enabled` (bool) — Enable caching (default: `true`)\n+- `max_entries` (int) — Max cached introspection results (default: `10000`)\n+- `ttl` (duration) — Cache TTL upper bound (default: `5m`)","path":"docs/authorization/AUTHN_JWT_OIDC_PLUGIN.md","commit_id":"8b9b7ec58165c6b91c63453998d1c107d7b52286","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Valid concern. Compromised:\r\n* Changed default from 5m to 60s (more defensible, still practical)\r\n* Added \"Security Considerations\" section with explicit recommendation of `ttl: 0` for regulated systems (PCI-DSS, HIPAA, SOC2)\r\n\r\nNote: TOCTOU is critical for authz mutations (UPDATE/DELETE), but for authn the revocation window is a standard industry trade-off. `ttl: 0` default would make the system impractical - every request hitting IDP.\r\n\r\n@Artifizer what do you think?","created_at":"2026-02-04T12:23:26Z","updated_at":"2026-02-04T12:23:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763745450","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763745450"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763745450"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763745450/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":360,"side":"RIGHT","in_reply_to_id":2761665211,"author_association":"MEMBER","original_position":360,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763746876","pull_request_review_id":3750760341,"id":2763746876,"node_id":"PRRC_kwDOPaLyBs6ku248","diff_hunk":"@@ -0,0 +1,1282 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')","path":"docs/authorization/AUTH.md","commit_id":"8b9b7ec58165c6b91c63453998d1c107d7b52286","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"thanks, fixed","created_at":"2026-02-04T12:23:51Z","updated_at":"2026-02-04T12:23:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763746876","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763746876"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2763746876"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2763746876/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":581,"side":"RIGHT","in_reply_to_id":2761632966,"author_association":"MEMBER","original_position":581,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764620203","pull_request_review_id":3751754965,"id":2764620203,"node_id":"PRRC_kwDOPaLyBs6kyMGr","diff_hunk":"@@ -0,0 +1,1282 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject.user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |","path":"docs/authorization/AUTH.md","commit_id":"51d28fc84a77c6080af0060f595be1409408b91b","original_commit_id":"4c0a3127155be975c2875e23180e596853933f6c","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"thanks, fixed","created_at":"2026-02-04T15:33:40Z","updated_at":"2026-02-04T15:33:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764620203","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764620203"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764620203"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764620203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":462,"side":"RIGHT","in_reply_to_id":2761580835,"author_association":"MEMBER","original_position":462,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625084","pull_request_review_id":3751760184,"id":2764625084,"node_id":"PRRC_kwDOPaLyBs6kyNS8","diff_hunk":"@@ -0,0 +1,1268 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",\n+    subject_tenant_id: \"tenant-456\",\n+    bearer_token: \"eyJ...\",\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,           // from `sub` claim or IdP response\n+    subject_type: GtsTypeId,      // vendor-specific subject type\n+    subject_tenant_id: TenantId,  // Subject Owner Tenant - tenant the subject belongs to\n+    token_scopes: Vec<String>,    // capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>, // original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Description | Used By |\n+|-------|-------------|---------|\n+| `subject_id` | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | GTS type identifier (e.g., `gts.x.core.security.subject.user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | Original bearer token (optional) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123')\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+10. **Handle empty constraints array** - If `constraints` field is present but empty (`constraints: []`) -> deny all. An empty array means no access paths exist (OR of empty set is false).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.subject.user.v1~\",  // SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.events.event.v1~\",               // handler: module's resource GTS type","path":"docs/authorization/AUTH.md","commit_id":"51d28fc84a77c6080af0060f595be1409408b91b","original_commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2026-02-04T15:34:44Z","updated_at":"2026-02-04T15:34:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764625084","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625084"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764625084"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":740,"side":"RIGHT","in_reply_to_id":2759036434,"author_association":"MEMBER","original_position":740,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625991","pull_request_review_id":3751761030,"id":2764625991,"node_id":"PRRC_kwDOPaLyBs6kyNhH","diff_hunk":"@@ -0,0 +1,1268 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Contains: `subject_id`, `subject_type`, `subject_tenant_id`, `token_scopes`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: \"gts.x.core.security.subject.user.v1~\",","path":"docs/authorization/AUTH.md","commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","original_commit_id":"57bbb93f5327a6ec5e5e3ba0d6b77a76a80d86ae","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2026-02-04T15:34:54Z","updated_at":"2026-02-04T15:34:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764625991","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625991"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2764625991"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2764625991/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":296,"side":"RIGHT","in_reply_to_id":2759033597,"author_association":"MEMBER","original_position":296,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2765003057","pull_request_review_id":3752185828,"id":2765003057,"node_id":"PRRC_kwDOPaLyBs6kzpkx","diff_hunk":"@@ -0,0 +1,1333 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.core.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject_user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject_user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages","path":"docs/authorization/AUTH.md","commit_id":"d6de9329677f64aae68df5884d338b6d57cddc29","original_commit_id":"d6de9329677f64aae68df5884d338b6d57cddc29","user":{"login":"nonameffh","id":5434885,"node_id":"MDQ6VXNlcjU0MzQ4ODU=","avatar_url":"https://avatars.githubusercontent.com/u/5434885?v=4","gravatar_id":"","url":"https://api.github.com/users/nonameffh","html_url":"https://github.com/nonameffh","followers_url":"https://api.github.com/users/nonameffh/followers","following_url":"https://api.github.com/users/nonameffh/following{/other_user}","gists_url":"https://api.github.com/users/nonameffh/gists{/gist_id}","starred_url":"https://api.github.com/users/nonameffh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nonameffh/subscriptions","organizations_url":"https://api.github.com/users/nonameffh/orgs","repos_url":"https://api.github.com/users/nonameffh/repos","events_url":"https://api.github.com/users/nonameffh/events{/privacy}","received_events_url":"https://api.github.com/users/nonameffh/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"JFYI, for such things in Constructor we use such crate https://crates.io/crates/secrecy.\nMaybe it worth to define `bearer_token` as `Option<Secret<String>>` from the beggining \n","created_at":"2026-02-04T16:57:07Z","updated_at":"2026-02-04T17:46:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2765003057","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2765003057"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2765003057"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2765003057/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":469,"side":"RIGHT","author_association":"MEMBER","original_position":469,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767600625","pull_request_review_id":3755089265,"id":2767600625,"node_id":"PRRC_kwDOPaLyBs6k9jvx","diff_hunk":"@@ -0,0 +1,1333 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.core.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject_user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(\"eyJ...\"),                                // optional\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<String>,          // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject_user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` is a credential and MUST NOT be logged, serialized to persistent storage, or included in error messages","path":"docs/authorization/AUTH.md","commit_id":"d6de9329677f64aae68df5884d338b6d57cddc29","original_commit_id":"d6de9329677f64aae68df5884d338b6d57cddc29","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"good suggestion, changed, thanks","created_at":"2026-02-05T07:55:04Z","updated_at":"2026-02-05T07:55:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2767600625","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767600625"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2767600625"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767600625/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":469,"side":"RIGHT","in_reply_to_id":2765003057,"author_association":"MEMBER","original_position":469,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767612212","pull_request_review_id":3755106412,"id":2767612212,"node_id":"PRRC_kwDOPaLyBs6k9mk0","diff_hunk":"@@ -0,0 +1,1336 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.core.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject_user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(Secret::new(\"eyJ...\".into())),            // optional, Secret<String>\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+use secrecy::Secret;\n+\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<Secret<String>>,  // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject_user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token (wrapped in `Secret` from [secrecy](https://crates.io/crates/secrecy) crate) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` uses `Secret<String>` from the `secrecy` crate which provides: redacted `Debug` output, no `Display` impl, and zeroization on drop\n+- `bearer_token` MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123' AND barrier = 0)\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+10. **Handle empty constraints array** - If `constraints` field is present but empty (`constraints: []`) -> deny all. An empty array means no access paths exist (OR of empty set is false).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.user.v1~\",          // optional - SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // required - SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // optional - SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.core.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Context Tenant (optional) — PDP, for example, can determine from token_scopes or subject.tenant_id if absent\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",           // \"root_only\" | \"subtree\", default: \"subtree\"\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // optional - request param (URL query, header), handler can set\n+      \"include_root\": true,        // subtree mode only, default: true, ignored for root_only\n+      \"barrier_mode\": \"all\",       // default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional filter\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"supported_properties\": [\"owner_tenant_id\", \"topic_id\", \"id\"],  // handler config: properties PEP can map to SQL\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token: Secret<String> (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+**Allow Response:**\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Deny Response:**\n+\n+```jsonc\n+{\n+  \"decision\": false,\n+  \"context\": {\n+    // deny_reason is required when decision is false\n+    \"deny_reason\": {\n+      // GTS-formatted error code for programmatic handling (required)\n+      \"error_code\": \"gts.x.core.errors.err.v1~x.authz.errors.insufficient_permissions.v1\",\n+      // Human-readable details for logging (optional)\n+      \"details\": \"Subject lacks permission for action 'list' on resource type 'gts.x.core.events.event.v1~'\"\n+    }\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: `bearer_token` is a credential — PDP MUST NOT log it or persist it. In Rust code, use `Secret<String>` from the `secrecy` crate (serializes to plain string in JSON).\n+\n+**Note on `tenant_context`:** The `context.tenant_context` object is optional. It defines the tenant context for the operation:\n+\n+| Field | Required | Default | Description |\n+|-------|----------|---------|-------------|\n+| `mode` | No | `\"subtree\"` | `\"root_only\"` (single tenant) or `\"subtree\"` (tenant + descendants) |\n+| `root_id` | No | — | Root tenant ID. If absent, PDP determines from `token_scopes`, `bearer_token`, or `subject.properties.tenant_id` |\n+| `include_root` | No | `true` | For `subtree` mode: include root in results. Ignored for `root_only` |\n+| `barrier_mode` | No | `\"all\"` | `\"all\"` (respect barriers) or `\"none\"` (ignore barriers) |\n+| `tenant_status` | No | — | Filter by tenant status (e.g., `[\"active\", \"suspended\"]`) |\n+\n+The `barrier_mode` and `tenant_status` parameters apply to any scope source — whether explicitly provided via `root_id` or derived from the token/subject.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.core.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.core.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.core.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+When the PDP denies access, it returns `decision: false` with a required `deny_reason` in the context (see example in [Response](#response) section above).\n+\n+##### Deny Reason Structure\n+\n+The `deny_reason` object is **required** when `decision: false` and provides structured information about why access was denied:\n+\n+| Field | Required | Description |\n+|-------|----------|-------------|\n+| `error_code` | Yes | GTS-formatted error code from Type Registry. Used for programmatic handling (e.g., retry logic, user messaging, metrics) |\n+| `details` | No | Human-readable description for logging/debugging |\n+\n+##### Standard Error Codes\n+\n+| Code | When to use |\n+|------|-------------|\n+| `gts.x.core.errors.err.v1~x.authz.errors.insufficient_permissions.v1` | No matching policy, scope restricted, tenant boundary violation, missing role/permission |\n+| `gts.x.core.errors.err.v1~x.authz.errors.invalid_request.v1` | Malformed request (missing required fields, invalid format, unknown resource type) |\n+\n+##### Vendor Extensibility\n+\n+Vendors can define custom error codes via GTS namespace for domain-specific denial reasons:\n+\n+```\n+gts.x.core.errors.err.v1~vendor.acme.license_expired.v1\n+gts.x.core.errors.err.v1~vendor.acme.quota_exceeded.v1\n+```\n+\n+##### PEP Handling of Deny Reason\n+\n+The PEP MUST:\n+1. **Use `error_code` for programmatic handling** — Route to appropriate logic based on error type (e.g., distinguish `invalid_request` from `insufficient_permissions` for different error responses or retry strategies)\n+2. **Log the deny_reason** — Include `error_code` and `details` in audit/debug logs for troubleshooting\n+3. **NOT expose details to client** — Return generic 403 Forbidden without leaking `details` or internal denial reasons\n+\n+**Security rationale:** The `details` field may contain information about authorization policies, tenant structure, or resource existence. The PEP uses `error_code` for handling logic and logs `details` internally, but returns only a generic 403 to the client.\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+**Relationship to request `tenant_context`:** The PDP uses `context.tenant_context` from the request to determine the tenant context, then generates `in_tenant_subtree` predicates in the response. The predicate's `root_tenant_id` comes from either the request's `tenant_context.root_id` or PDP's resolution from token/subject. The `barrier_mode` and `tenant_status` parameters flow through from request to predicate.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The PEP declares its supported properties in every authorization request via `context.supported_properties`. This field contains the list of property names that the PEP can map to SQL columns. The PDP uses this information to validate that returned constraints only reference properties the PEP can enforce.\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+\n+---\n+\n+### Capabilities -> Predicate Matrix\n+\n+The PEP declares its capabilities in the request. This determines what predicate types the PDP can return.\n+\n+#### `require_constraints` Flag\n+\n+The `require_constraints` field (separate from capabilities array) controls PEP behavior when constraints are absent:\n+\n+| `require_constraints` | `decision: true` without `constraints` |\n+|-----------------------|----------------------------------------|\n+| `true` | **deny** (constraints required but missing) |\n+| `false` | **allow** (trust PDP decision) |\n+\n+**Usage:**\n+- For LIST operations: typically `true` (constraints needed for SQL WHERE)\n+- For CREATE operations: typically `false` (no query, just permission check)\n+- For GET/UPDATE/DELETE: depends on whether PEP wants SQL-level enforcement or trusts PDP decision\n+\n+#### Capabilities Array\n+\n+Capabilities declare what predicate types the PEP can enforce locally:\n+\n+| Capability | Enables Predicate Types |\n+|------------|---------------------|\n+| `tenant_hierarchy` | `in_tenant_subtree` |\n+| `group_membership` | `in_group` |\n+| `group_hierarchy` | `in_group_subtree` (implies `group_membership`) |\n+\n+**Capability dependencies:**\n+- `group_hierarchy` implies `group_membership` — if PEP has the closure table, it necessarily has the membership table\n+- When declaring capabilities, `[\"group_hierarchy\"]` is sufficient; `group_membership` is implied\n+\n+**Predicate type availability by capability:**\n+\n+| Predicate Type | Required Capability |\n+|-------------|---------------------|\n+| `eq`, `in` | (none — always available) |\n+| `in_tenant_subtree` | `tenant_hierarchy` |\n+| `in_group` | `group_membership` |\n+| `in_group_subtree` | `group_hierarchy` |\n+\n+**Capability degradation**: If a PEP lacks a capability, the PDP must either:\n+1. Expand the predicate to explicit IDs (may be large)\n+2. Return `decision: false` if expansion is not feasible\n+\n+---\n+\n+### Table Schemas (Local Projections)\n+\n+These tables are maintained locally by HyperSpot gateway modules (Tenant Resolver, Resource Group Resolver) and used by PEPs to execute constraint queries efficiently without calling back to the vendor platform.\n+\n+#### `tenant_closure`\n+\n+Denormalized closure table for tenant hierarchy. Enables efficient subtree queries without recursive CTEs.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent tenant in the hierarchy |\n+| `descendant_id` | UUID | No | Child tenant (the one we check ownership against) |\n+| `barrier` | INT | No | 0 = no barrier on path, 1 = barrier exists between ancestor and descendant (default 0) |\n+| `descendant_status` | TEXT | No | Status of descendant tenant (`active`, `suspended`, `deleted`) |\n+\n+**Notes:**\n+- Status is denormalized into closure for query simplicity (avoids JOIN). When a tenant's status changes, all rows where it is `descendant_id` are updated.\n+- **Barrier semantics:** The `barrier` column stores barriers **strictly between** ancestor and descendant, **not including the ancestor itself**. This means when T2 is self_managed, rows with `ancestor_id = T2` have `barrier = 0`, while rows with T2 on the path from another ancestor have `barrier = 1`.\n+- The `barrier` column enables simple filtering: `barrier_mode: \"all\"` adds `AND barrier = 0`, `barrier_mode: \"none\"` omits the clause.\n+- Self-referential rows exist: each tenant has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_tenant_subtree` predicate compiles to SQL using this closure table.\n+- **Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types (e.g., `(barrier & mask) = 0` for selective enforcement).\n+\n+**Example query (in_tenant_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = :root_tenant_id\n+    AND barrier = 0  -- barrier_mode: \"all\"\n+    AND descendant_status IN ('active', 'suspended')  -- tenant_status filter\n+)\n+```\n+\n+#### `resource_group_closure`\n+\n+Closure table for resource group hierarchy. Similar structure to tenant_closure but simpler (no barrier or status).\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent group |\n+| `descendant_id` | UUID | No | Child group |\n+\n+**Notes:**\n+- Self-referential rows exist: each group has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_group_subtree` predicate compiles to SQL using this closure table.\n+\n+#### `resource_group_membership`\n+\n+Association between resources and groups. A resource can belong to multiple groups.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `resource_id` | UUID | No | ID of the resource (FK to resource table) |\n+| `group_id` | UUID | No | ID of the group (FK to resource_group_closure) |\n+\n+**Notes:**\n+- The `resource_id` column joins with the resource table's ID column (configurable per module, default `id`).\n+- **Predicate mapping:** `in_group` and `in_group_subtree` predicates use this table for the resource-to-group join.\n+\n+**Example query (in_group_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE id IN (\n+  SELECT resource_id FROM resource_group_membership\n+  WHERE group_id IN (\n+    SELECT descendant_id FROM resource_group_closure\n+    WHERE ancestor_id = :root_group_id\n+  )\n+)\n+```\n+","path":"docs/arch/authorization/DESIGN.md","commit_id":"7b6c1372f62ef53f50207ca12e11c6accb4530c7","original_commit_id":"5f00f1e2d828c59769aeac91ab32eafc361bad7a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_🛠️ Refactor suggestion_ | _🟠 Major_\n\n**Add explicit schema evolution and migration protocol for closure tables.**\n\nWhile lines 1239 and future extensibility are mentioned, the document lacks a formal \"Schema Evolution\" subsection addressing:\n\n1. **Schema versioning** — How are closure table schemas versioned? (semantic versioning, version column, schema_version table?)\n2. **Migration protocol** — When `tenant_closure` or `resource_group_closure` schema changes, how do PEPs learn about it?\n3. **Backward compatibility** — Can old PEPs work with new schema, or is coordinated upgrade required?\n4. **Barrier bitmask migration** — Line 1239 mentions future bitmask use. When that arrives, how will deployments migrate? How will PEPs discover new barrier modes?\n\nPer past review feedback (marked \"✅ Addressed in commit 57bbb93\"), this should include a dedicated subsection near the closure table documentation.\n\n\n\n<details>\n<summary>📋 Suggested addition</summary>\n\nAfter line 1251, add:\n\n```markdown\n#### Schema Evolution and Migration\n\n**Versioning:**\n- Closure tables are versioned via a `schema_version` metadata table maintained by gateway modules (Tenant Resolver, RG Resolver)\n- PEPs check schema version at startup and validate compatibility\n\n**Migration Protocol:**\n1. Gateway module publishes schema version bump + migration plan\n2. PEPs detect version change and validate compatibility (additive changes supported, breaking changes require coordinated upgrade)\n3. Gateway performs rolling migration (e.g., adding new columns with default values)\n4. Old PEPs continue reading known columns; new PEPs use extended schema\n\n**Backward Compatibility:**\n- Additive changes (new optional columns) preserve compatibility\n- Breaking changes (column removal, type changes) require coordinated gateway + PEP upgrade\n- Alternative: Use schema migration framework (e.g., Flyway) with version checks\n\n**Barrier Bitmask Migration:**\nWhen transitioning `barrier` from INT (0/1) to bitmask:\n1. Gateway announces new schema version\n2. Dual-write period: populate both old and new barrier semantics\n3. PEPs negotiate capabilities and use appropriate barrier checks\n4. Fallback: Unknown barrier modes treated as barriers (fail-closed)\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@docs/authorization/AUTH.md` around lines 1222 - 1289, Add a new \"Schema\nEvolution and Migration\" subsection explaining that closure tables\n(tenant_closure, resource_group_closure) must be versioned via a schema_version\nmetadata table owned by gateway modules (Tenant Resolver, RG Resolver), that\nPEPs must check this schema_version at startup and validate compatibility, and\nthat migrations follow a protocol where gateway publishes version bump +\nmigration plan, rolling migrations prefer additive changes and require\ncoordinated upgrades for breaking changes, and use dual-write/dual-read patterns\nwith capability negotiation; explicitly document backward-compatibility rules\n(additive = safe, removals/type-changes = coordinated), and spell out a barrier\nbitmask migration path (announce version, dual-write semantics, PEP capability\nnegotiation, treat unknown bitmask modes as barrier/fail-closed) so PEPs can\ndiscover and handle new barrier modes.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-05T07:58:46Z","updated_at":"2026-02-05T08:34:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2767612212","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767612212"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/282#discussion_r2767612212"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/282"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767612212/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1220,"original_start_line":1222,"start_side":"RIGHT","line":1287,"original_line":1289,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1289,"position":1287,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2767686716","pull_request_review_id":3755214841,"id":2767686716,"node_id":"PRRC_kwDOPaLyBs6k94w8","diff_hunk":"@@ -0,0 +1,1334 @@\n+# Authentication & Authorization Design\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Token Scopes](#token-scopes)\n+- [Authentication](#authentication)\n+- [Authorization](#authorization)\n+  - [Why AuthZEN (and Why It's Not Enough)](#why-authzen-and-why-its-not-enough)\n+  - [PEP Enforcement](#pep-enforcement)\n+  - [Authorization Decision Caching](#authorization-decision-caching)\n+  - [API Specifications](#api-specifications)\n+  - [Predicate Types Reference](#predicate-types-reference)\n+  - [PEP Property Mapping](#pep-property-mapping)\n+  - [Capabilities -> Predicate Matrix](#capabilities---predicate-matrix)\n+  - [Table Schemas (Local Projections)](#table-schemas-local-projections)\n+  - [Usage Scenarios](#usage-scenarios)\n+- [Open Questions](#open-questions)\n+- [References](#references)\n+\n+---\n+\n+## Overview\n+\n+This document describes HyperSpot's approach to authentication (AuthN) and authorization (AuthZ).\n+\n+**Authentication** verifies the identity of the subject making a request. HyperSpot uses the **AuthN Resolver** module to integrate with vendor's Identity Provider (IdP), validate access tokens, and extract subject identity into a `SecurityContext`.\n+\n+**Authorization** determines what the authenticated subject can do. HyperSpot uses the **AuthZ Resolver** module (acting as PDP) to obtain access decisions and query-level constraints. The core challenge: HyperSpot modules need to enforce authorization at the **query level** (SQL WHERE clauses), not just perform point-in-time access checks.\n+\n+See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the authorization model and [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind separating AuthN and AuthZ.\n+\n+### PDP/PEP Model\n+\n+This document uses the PDP/PEP authorization model (per NIST SP 800-162):\n+\n+- **PDP (Policy Decision Point)** — evaluates policies and returns access decisions with constraints\n+- **PEP (Policy Enforcement Point)** — enforces PDP decisions at resource access points\n+\n+In HyperSpot's architecture:\n+- **AuthN Resolver** validates tokens and produces SecurityContext (separate concern from PDP)\n+- **AuthZ Resolver** (via vendor-specific plugin) serves as the **PDP**\n+- **Domain modules** act as **PEPs**, applying constraints to database queries\n+\n+### Core Terms\n+\n+- **Access Token** - Credential presented by the client to authenticate requests. Format is not restricted — can be opaque token (validated via introspection) or self-contained JWT. The key requirement: it must enable authentication and subject identification.\n+- **Subject / Principal** - Actor initiating the request (user or API client), identified via access token\n+- **Tenant** - Domain of ownership/responsibility and policy (billing, security, data isolation). See [TENANT_MODEL.md](./TENANT_MODEL.md)\n+- **Subject Owner Tenant** - Tenant the subject belongs to (owning tenant of the subject)\n+- **Context Tenant** - Tenant scope root for the operation (may differ from subject owner tenant in cross-tenant scenarios)\n+- **Resource Owner Tenant** - Actual tenant owning the resource (`owner_tenant_id`)\n+- **Resource** - Object with owner tenant identifier\n+- **Resource Group** - Optional container for resources, used for access control. See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md)\n+- **Permission** - `{ resource_type, action }` - allowed operation identifier\n+- **Access Constraints** - Structured predicates returned by the PDP for query-time enforcement. NOT policies (stored vendor-side) or \"grants\" (OAuth flows, Zanzibar tuples), but compiled, time-bound enforcement artifacts computed at evaluation time.\n+- **Security Context** - Result of successful authentication containing subject identity, tenant information, and optionally the original bearer token. Flows from authentication to authorization. Required fields: `subject_id`, `token_scopes`. Optional fields: `subject_type`, `subject_tenant_id`, `bearer_token`.\n+- **Token Scopes** - Capability restrictions extracted from the access token. Act as a \"ceiling\" on what an application can do, regardless of user's actual permissions. See [Token Scopes](#token-scopes).\n+\n+### Request Flow\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Module as Module AuthN Middleware\n+    participant AuthN as AuthN Resolver\n+    participant Handler as Module Handler (PEP)\n+    participant AuthZ as AuthZ Resolver<br/>(PDP)\n+    participant DB as Database\n+\n+    Client->>Module: Request + Token\n+    Module->>AuthN: Validate token\n+    AuthN->>AuthN: Token validation or introspection\n+    AuthN-->>Module: SecurityContext\n+    Module->>Handler: Request + SecurityContext\n+    Handler->>AuthZ: AuthZ Request<br/>(subject, action, resource, context)\n+    AuthZ->>AuthZ: Evaluate policies\n+    AuthZ-->>Handler: decision + constraints\n+    Handler->>Handler: Compile constraints to SQL\n+    Handler->>DB: Query with WHERE clauses\n+    DB-->>Handler: Filtered results\n+    Handler-->>Module: Response\n+    Module-->>Client: Response\n+```\n+\n+**Separation of concerns:**\n+1. **AuthN Middleware** — calls AuthN Resolver to validate token, produces `SecurityContext`\n+2. **Module Handler (PEP)** — receives SecurityContext, builds AuthZ request, compiles constraints to SQL\n+3. **AuthZ Resolver (PDP)** — evaluates policies, returns decision + constraints\n+\n+### AuthN Resolver and AuthZ Resolver: Gateway + Plugin Architecture\n+\n+Since IdP and PDP are vendor-specific, HyperSpot cannot implement authentication and authorization directly. Instead, we use the **gateway + plugin** pattern with two separate resolvers:\n+\n+- **AuthN Resolver** — a HyperSpot gateway module that defines a unified interface for authentication operations (token validation, introspection, SecurityContext production)\n+- **AuthZ Resolver** — a HyperSpot gateway module that defines a unified interface for authorization operations (PDP functionality, policy evaluation, constraint generation)\n+- **Vendor Plugins** — implement the AuthN and/or AuthZ interfaces, integrating with vendor's IdP and Authorization API\n+\n+This separation provides:\n+- **Separation of concerns** — OIDC/JWT standards (AuthN) vs AuthZEN standards (AuthZ)\n+- **Deployment flexibility** — AuthN on edge, AuthZ centralized in distributed scenarios\n+- **Security boundaries** — Credentials (tokens) isolated in AuthN layer, AuthZ works with validated identity\n+- **Mix & match vendors** — Use different vendors for IdP (AuthN) and Policy Engine (AuthZ)\n+\n+Each vendor develops their own AuthN and AuthZ plugins (or a unified plugin implementing both interfaces) that bridge to their specific systems. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for the rationale behind this separation.\n+\n+### Plugin Roles\n+\n+**AuthN Plugin:**\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. The plugin is responsible for:\n+- **IdP communication** — calling introspection endpoints, handling IdP-specific protocols\n+- **Claim enrichment** — if the IdP doesn't include `subject_type` or `subject_tenant_id` in tokens, the plugin fetches this information from vendor services\n+- **Response mapping** — converting IdP-specific responses to `SecurityContext`\n+- **Token scope extraction** — detecting first-party vs third-party apps and setting `token_scopes` accordingly\n+\n+**AuthZ Plugin:**\n+\n+The AuthZ Resolver plugin bridges HyperSpot to the vendor's Authorization Service (PDP). The plugin is responsible for:\n+- **Policy evaluation** — calling vendor's authorization API with subject, action, resource, context\n+- **Constraint generation** — translating vendor's policy decisions into SQL-compilable constraints\n+- **Hierarchy queries** — using Tenant Resolver and RG Resolver to query tenant and group hierarchies for constraint generation\n+- **Token validation** (optional) — in out-of-process deployments, independently validating bearer_token for defense-in-depth\n+\n+**Policy Storage and Retrieval (Out of Scope):**\n+\n+How authorization rules are stored, represented, and retrieved within the PDP is entirely a vendor implementation detail. HyperSpot defines only the PDP-PEP contract (request/response format via AuthZEN-extended API).\n+\n+Vendors may use any policy model and storage mechanism:\n+- **RBAC** — role-permission tables, role hierarchies\n+- **ABAC** — attribute-based rules, policy DSLs\n+- **ReBAC** — relationship tuples (Zanzibar-style), graph databases\n+- **Custom models** — proprietary formats, hybrid approaches\n+\n+The AuthZ Resolver plugin may obtain policy information through any method:\n+- Call the vendor's centralized Authorization Service (PDP) via API\n+- Query the vendor's Policy Service or ACL storage directly\n+- Extract embedded permissions from the bearer token itself (if the token contains authorization claims)\n+- Use a hybrid approach (e.g., token for basic permissions + service call for fine-grained checks)\n+\n+The plugin is responsible for evaluating policies (in whatever internal format and from whatever source the vendor uses) and translating the results into the standardized `constraints` JSON format that PEPs can compile to SQL. All policy computation, permission resolution, and authorization logic happens within the plugin based on the vendor's chosen authorization approach.\n+\n+**Unified Plugin Pattern:**\n+\n+Vendors with integrated AuthN+AuthZ APIs can provide a unified plugin implementing both interfaces, allowing single API calls to vendor services, shared caching between AuthN and AuthZ operations, and coordinated version updates. See [ADR 0002](../adrs/authorization/0002-split-authn-authz-resolvers.md) for details.\n+\n+### Integration Architecture\n+\n+```mermaid\n+flowchart TB\n+    subgraph Vendor[\"Vendor Platform\"]\n+        IdP[\"IdP\"]\n+        TenantSvc[\"Tenant Service\"]\n+        RGSvc[\"RG Service\"]\n+        AuthzSvc[\"Authz Service\"]\n+    end\n+\n+    subgraph HyperSpot\n+        subgraph TenantResolver[\"Tenant Resolver\"]\n+            TenantGW[\"Gateway\"]\n+            TenantPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph RGResolver[\"RG Resolver\"]\n+            RGGW[\"Gateway\"]\n+            RGPlugin[\"Plugin\"]\n+        end\n+\n+        subgraph AuthNResolver[\"AuthN Resolver\"]\n+            AuthNGW[\"Gateway\"]\n+            AuthNPlugin[\"Plugin<br/>(Token Validation)\"]\n+        end\n+\n+        subgraph AuthZResolver[\"AuthZ Resolver\"]\n+            AuthZGW[\"Gateway\"]\n+            AuthZPlugin[\"Plugin<br/>(PDP)\"]\n+        end\n+\n+        subgraph PEP[\"Domain Module (PEP)\"]\n+            AuthNMiddleware[\"AuthN Middleware\"]\n+            Handler[\"Handler\"]\n+            subgraph ModuleDB[\"Module Database\"]\n+                DomainTables[\"Domain Tables<br/>(events, ...)\"]\n+                LocalProj[\"Local Projections<br/>• tenant_closure<br/>• resource_group_closure<br/>• resource_group_membership\"]\n+            end\n+        end\n+    end\n+\n+    %% Tenant Resolver flow\n+    TenantGW --> TenantPlugin\n+    TenantPlugin --> TenantSvc\n+\n+    %% RG Resolver flow\n+    RGGW --> RGPlugin\n+    RGPlugin --> RGSvc\n+\n+    %% AuthN Resolver flow\n+    AuthNMiddleware -->|authenticate| AuthNGW\n+    AuthNGW --> AuthNPlugin\n+    AuthNPlugin -->|introspection| IdP\n+\n+    %% AuthZ Resolver flow\n+    AuthZGW --> AuthZPlugin\n+    AuthZPlugin -->|authz| AuthzSvc\n+    AuthZPlugin -.->|tenant hierarchy| TenantGW\n+    AuthZPlugin -.->|group hierarchy,<br/>membership| RGGW\n+\n+    %% PEP flow\n+    AuthNMiddleware -->|SecurityContext| Handler\n+    Handler -->|access evaluation| AuthZGW\n+    Handler -->|constraints to SQL| ModuleDB\n+```\n+\n+**Communication flow:**\n+1. **AuthN Middleware → AuthN Resolver (Gateway)** — Middleware calls `authenticate(bearer_token)` to validate token and get `AuthenticationResult`\n+2. **AuthN Resolver (Gateway) → AuthN Resolver (Plugin)** — Gateway delegates to vendor plugin\n+3. **AuthN Resolver (Plugin) → IdP** — Token validation (JWT signature verification or introspection)\n+4. **AuthN Middleware → Handler** — Middleware extracts `SecurityContext` from `AuthenticationResult` and passes to handler\n+5. **Handler → AuthZ Resolver (Gateway)** — PEP calls `/access/v1/evaluation` for authorization decisions with `SecurityContext`\n+6. **AuthZ Resolver (Gateway) → AuthZ Resolver (Plugin)** — Gateway delegates to vendor plugin (PDP)\n+7. **AuthZ Resolver (Plugin) → Authz Svc** — Policy evaluation\n+8. **AuthZ Resolver (Plugin) → Tenant Resolver (Gateway)** — Tenant hierarchy queries\n+9. **AuthZ Resolver (Plugin) → RG Resolver (Gateway)** — Group hierarchy and membership queries\n+10. **Tenant/RG Resolver (Gateway) → Plugin → Vendor Service** — Gateway delegates to plugin, plugin syncs from vendor\n+\n+### Deployment Modes and Trust Model\n+\n+Both AuthN Resolver and AuthZ Resolver can run in two deployment configurations:\n+\n+**In-Process (Plugin):**\n+- Resolvers run as plugins in the same process\n+- Communication via direct function calls\n+- Trust model: implicit — same process, same memory space\n+- No additional authentication required\n+\n+**Out-of-Process (Separate Service):**\n+- Resolvers run as separate processes (same machine or remote)\n+- Communication via gRPC\n+- Trust model: explicit authentication required\n+- **mTLS required** — Resolver authenticates that the caller is legitimate\n+\n+**Trust Boundaries:**\n+\n+In both modes, AuthZ Resolver (PDP) trusts subject identity data from PEP. The mTLS in out-of-process mode authenticates *which service* is calling, not the validity of subject claims. Subject identity originates from AuthN Resolver (Gateway) and flows through PEP to AuthZ Resolver.\n+\n+| Aspect | In-Process | Out-of-Process |\n+|--------|------------|----------------|\n+| Gateway → Resolver | implicit | mTLS |\n+| Subject identity trust | Same process | Authenticated caller |\n+| Network exposure | none | internal network only |\n+\n+## Token Scopes\n+\n+### Overview\n+\n+Token scopes provide capability narrowing for third-party applications. They act as a \"ceiling\" on what an application can do, regardless of user's actual permissions.\n+\n+**Key principle:** `effective_access = min(token_scopes, user_permissions)`\n+\n+### Scope vs Permission\n+\n+| Aspect | Scope | Permission |\n+|--------|-------|------------|\n+| Granularity | Coarse (human-readable) | Fine (technical) |\n+| Example | `read:calendar` | `gts.x.core.events.event.v1~:read` |\n+| Who defines | OAuth consent / IdP | PDP policies |\n+| Purpose | Limit app capabilities | Grant user access |\n+\n+### First-party vs Third-party Apps\n+\n+| App Type | Example | token_scopes | Behavior |\n+|----------|---------|--------------|----------|\n+| First-party | UI, CLI | `[\"*\"]` | No restrictions, full user permissions |\n+| Third-party | Partner integrations | `[\"read:events\"]` | Limited to granted scopes |\n+\n+**Detection:** AuthN Resolver plugin determines app type during introspection and sets `token_scopes` accordingly. HyperSpot does not maintain a trusted client list.\n+\n+### Vendor Neutrality\n+\n+HyperSpot accepts scopes as opaque strings (`Vec<String>`). Different vendors use\n+different formats:\n+- Google-style: `https://api.vendor.com/auth/tasks.read`\n+- Simple strings: `read_all`, `admin`\n+- No scopes: Some vendors encode everything in roles\n+\n+AuthN Resolver plugin is responsible for:\n+1. Extracting scopes from token (JWT claim or introspection response)\n+2. Mapping vendor format to internal representation\n+3. Setting `[\"*\"]` for first-party apps\n+\n+### SecurityContext Integration\n+\n+```rust\n+SecurityContext {\n+    subject_id: \"user-123\",\n+    subject_type: Some(\"gts.x.core.security.subject_user.v1~\"),  // optional\n+    subject_tenant_id: Some(\"tenant-456\"),                       // optional\n+    bearer_token: Some(Secret::new(\"eyJ...\".into())),            // optional, Secret<String>\n+    token_scopes: [\"*\"],  // first-party: full access\n+    // OR\n+    token_scopes: [\"read:events\", \"write:tasks\"],  // third-party: limited\n+}\n+```\n+\n+### PDP Evaluation Flow\n+\n+1. **PEP** includes `token_scopes` in evaluation request context\n+2. **PDP** applies scope restrictions:\n+   - If `token_scopes: [\"*\"]` → no scope-based restrictions\n+   - Otherwise → intersect with user permissions\n+3. **PDP** returns constraints reflecting both scopes and permissions\n+\n+### Gateway Scope Enforcement (Optional)\n+\n+For performance-critical paths, API Gateway can reject requests early based on\n+scope mismatch without calling PDP.\n+\n+**Configuration:**\n+```yaml\n+auth:\n+  gateway_scope_checks:\n+    enabled: true\n+    routes:\n+      \"/admin/*\":\n+        required_scopes: [\"admin\"]\n+      \"/events/v1/*\":\n+        required_scopes: [\"read:events\", \"write:events\"]  # any of these\n+```\n+\n+**Behavior:**\n+- If `token_scopes: [\"*\"]` → always pass\n+- If `token_scopes` contains any of `required_scopes` → pass\n+- Otherwise → 403 Forbidden (before PDP call)\n+\n+**Note:** This is coarse-grained optimization. Fine-grained permission checks still happen in PDP.\n+\n+---\n+\n+## Authentication\n+\n+### Overview\n+\n+Authentication is performed by **AuthN middleware** within the module that accepts the request. The middleware:\n+1. Extracts the bearer token from the request\n+2. Calls **AuthN Resolver** to do authentication\n+3. Receives `AuthenticationResult` containing validated subject identity\n+4. Passes the `SecurityContext` from `AuthenticationResult` to the module's handler (PEP)\n+\n+Authentication is handled by the **AuthN Resolver** — a gateway module with a minimalist interface that validates bearer tokens and produces `AuthenticationResult`.\n+\n+**Module Structure:**\n+\n+- **authn-resolver-sdk** — SDK package containing:\n+  - `AuthNResolverGatewayClient` trait (public API for other modules)\n+  - `AuthNResolverPluginClient` trait (API for plugins)\n+  - `AuthenticationResult`, `SecurityContext` models\n+  - `AuthNResolverError` error types\n+\n+- **authn-resolver-gw** — Gateway module that:\n+  - Implements `AuthNResolverGatewayClient` trait\n+  - Discovers and delegates to vendor-specific plugins via GTS types-registry\n+  - Registers gateway client in `ClientHub` for consumption by other modules\n+\n+**Gateway Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverGatewayClient: Send + Sync {\n+    /// Authenticate a bearer token and return the authentication result.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is malformed/invalid/expired or authentication fails\n+    /// - `ServiceUnavailable` if the IdP is unreachable\n+    /// - `NoPluginAvailable` if no plugin is configured\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token from the Authorization header\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Plugin Client Interface:**\n+\n+```rust\n+#[async_trait]\n+pub trait AuthNResolverPluginClient: Send + Sync {\n+    /// Authenticate a bearer token using vendor-specific validation logic.\n+    ///\n+    /// Plugins implement this method with their validation strategy\n+    /// (JWT local validation, token introspection, custom protocols, etc.).\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `bearer_token` - The bearer token to validate\n+    async fn authenticate(&self, bearer_token: &str) -> Result<AuthenticationResult, AuthNResolverError>;\n+}\n+```\n+\n+**Architecture:**\n+- **AuthN Middleware** — Extracts bearer token from request headers\n+- **AuthN Resolver Gateway** — Delegates to vendor-specific plugin\n+- **AuthN Resolver Plugin** — Implements token validation logic (JWT, introspection, custom protocols, etc.)\n+- **Output** — `AuthenticationResult` containing `SecurityContext`\n+\n+**Request Flow:**\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant Middleware as AuthN Middleware\n+    participant Gateway as AuthN Resolver<br/>(Gateway)\n+    participant Plugin as AuthN Resolver<br/>(Plugin)\n+    participant IdP as Vendor's IdP\n+    participant Handler as Module Handler (PEP)\n+\n+    Client->>Middleware: Request + Bearer Token\n+    Middleware->>Middleware: Extract bearer_token from Authorization header\n+    Middleware->>Gateway: authenticate(bearer_token)\n+    Gateway->>Plugin: authenticate(bearer_token)\n+    Plugin->>IdP: Validate token (implementation-specific)\n+    IdP-->>Plugin: Token valid + claims\n+    Plugin->>Plugin: Map to AuthenticationResult\n+    Plugin-->>Gateway: AuthenticationResult\n+    Gateway-->>Middleware: AuthenticationResult\n+    Middleware->>Handler: Request + SecurityContext\n+    Handler-->>Middleware: Response\n+    Middleware-->>Client: Response\n+```\n+\n+### AuthenticationResult\n+\n+The `AuthenticationResult` is returned by the AuthN Resolver upon successful authentication:\n+\n+```rust\n+pub struct AuthenticationResult {\n+    /// The validated security context.\n+    pub security_context: SecurityContext,\n+}\n+```\n+\n+### SecurityContext\n+\n+The `SecurityContext` is extracted from `AuthenticationResult` and flows from AuthN Resolver to PEPs (via handlers):\n+\n+```rust\n+use secrecy::Secret;\n+\n+SecurityContext {\n+    subject_id: String,                    // required - from `sub` claim or IdP response\n+    subject_type: Option<GtsTypeId>,       // optional - vendor-specific subject type\n+    subject_tenant_id: Option<TenantId>,   // optional - Subject Owner Tenant\n+    token_scopes: Vec<String>,             // required - capability restrictions ([\"*\"] for first-party)\n+    bearer_token: Option<Secret<String>>,  // optional - original token for forwarding to PDP\n+}\n+```\n+\n+**Field Semantics:**\n+\n+| Field | Required | Description | Used By |\n+|-------|----------|-------------|---------|\n+| `subject_id` | Yes | Unique identifier for the subject | All authorization decisions |\n+| `subject_type` | No | GTS type identifier (e.g., `gts.x.core.security.subject_user.v1~`) | PDP for role/permission mapping |\n+| `subject_tenant_id` | No | Subject Owner Tenant — tenant the subject belongs to | PDP for tenant context |\n+| `token_scopes` | Yes | Capability restrictions from token (see [Token Scopes](#token-scopes)) | PDP for scope narrowing |\n+| `bearer_token` | No | Original bearer token (wrapped in `Secret` from [secrecy](https://crates.io/crates/secrecy) crate) | PDP validation, external API calls |\n+\n+**Security Notes:**\n+- Token expiration (`exp`) is validated during authentication but not included in SecurityContext (expiration is token metadata, not identity)\n+- `bearer_token` uses `Secret<String>` from the `secrecy` crate which provides: redacted `Debug` output, no `Display` impl, and zeroization on drop\n+- `bearer_token` MUST NOT be logged, serialized to persistent storage, or included in error messages\n+- The token is included for:\n+  1. **PDP validation** — In out-of-process deployments, AuthZ Resolver may independently validate the token for defense-in-depth\n+  2. **Forwarding** — AuthZ Resolver plugin may need to call external vendor services requiring authentication\n+\n+### Plugin Responsibilities\n+\n+The AuthN Resolver plugin bridges HyperSpot to the vendor's IdP. Plugin responsibilities:\n+\n+1. **Token Validation** — Implement vendor-specific validation logic (JWT signature verification, introspection, custom protocols)\n+2. **Claim Extraction** — Extract subject identity from token claims or introspection response\n+3. **Claim Enrichment** — If IdP doesn't include required claims (`subject_type`, `subject_tenant_id`), fetch from vendor services\n+4. **Token Scope Detection** — Determine first-party vs third-party apps and set `token_scopes` accordingly (see [Token Scopes](#token-scopes))\n+5. **Response Mapping** — Convert vendor-specific responses to `AuthenticationResult` (containing `SecurityContext`)\n+\n+### Rationale: Minimalist Interface\n+\n+For the rationale behind this single-method interface design, see [ADR 0003: AuthN Resolver Minimalist Interface](../adrs/authorization/0003-authn-resolver-minimalist-interface.md).\n+\n+### Implementation Reference\n+\n+For a complete implementation of JWT + OIDC authentication (JWT local validation, token introspection, OpenID Connect Discovery), see **[AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md)**.\n+\n+This reference implementation covers:\n+- JWT and opaque token support\n+- Multiple validation modes (`never`, `opaque_only`, `always`)\n+- OpenID Connect Discovery integration\n+- JWKS and introspection caching\n+- Configuration examples for standard OIDC providers\n+\n+---\n+\n+## Authorization\n+\n+### Why AuthZEN (and Why It's Not Enough)\n+\n+We chose [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12) as the foundation for AuthZ Resolver. See [ADR 0001](../adrs/authorization/0001-pdp-pep-authorization-model.md) for the full analysis of considered options.\n+\n+**Why AuthZEN:**\n+- Industry standard with growing ecosystem\n+- Vendor-neutral: doesn't dictate policy model (RBAC/ABAC/ReBAC)\n+- Clean subject/action/resource/context structure\n+- Extensible via `context` field\n+\n+However, AuthZEN out of the box doesn't solve HyperSpot's core requirement: **query-level authorization**.\n+\n+#### Why Access Evaluation API Alone Isn't Enough\n+\n+AuthZEN's Access Evaluation API answers: \"Can subject S perform action A on resource R?\" — a point-in-time check returning `decision: true/false`.\n+\n+##### LIST Operations\n+\n+For **LIST operations** with Access Evaluation API, we'd need an iterative process:\n+\n+1. Fetch a batch of resources from DB (e.g., `LIMIT 100` to get candidates for a page of 10)\n+2. Send batch to PDP for evaluation (AuthZEN supports batching via Access Evaluations API)\n+3. Filter results based on decisions\n+4. If filtered result < requested page size → fetch next batch, repeat\n+\n+**The core problem**: unpredictable number of iterations. If the user has access to only 1% of resources, fetching a page of 10 items might require 10+ round-trips (DB → PDP → filter → not enough → repeat). Worst case: user has access to nothing, and we scan the entire table before returning empty result.\n+\n+**Additional problems:**\n+- **Pagination cursor invalidation** — cursor points to DB offset, but after filtering the mapping breaks\n+- **Total count impossible** — can't know total accessible count without evaluating all resources\n+- **Inconsistent page sizes** — hard to guarantee exactly N items per page\n+\n+##### Point Operations (GET/UPDATE/DELETE)\n+\n+For **point operations**, Access Evaluation API could technically work, but requires an inefficient flow:\n+\n+1. Query database to fetch the resource\n+2. Send resource to PDP for evaluation\n+3. If denied, return 403/404\n+\n+**The problem**: the subject might not have rights to access this resource type at all. The database query is wasteful — we should fail fast before touching the database.\n+\n+**What we want instead:**\n+1. Ask PDP first: \"Can subject S perform action A on resource type T?\"\n+2. If denied → 403 immediately (fail-fast, no database query)\n+3. If allowed → get constraints, execute query with `WHERE id = :id AND (constraints)`\n+4. If 0 rows → 404 (hides resource existence from unauthorized users)\n+\n+#### Why Search API Doesn't Work\n+\n+AuthZEN's Resource Search API answers: \"What resources can subject S perform action A on?\" — returning a list of resource IDs.\n+\n+This **assumes the PDP has access to resource data**. In HyperSpot's architecture, resources live in the PEP's database — the PDP cannot enumerate what it doesn't have.\n+\n+This creates an architectural mismatch:\n+- **PDP** knows \"who can access what\" (authorization policies)\n+- **PEP** knows \"what exists\" (resources in database)\n+\n+To use Search API, we'd need to sync all resources to the PDP — defeating the purpose of keeping data local.\n+\n+#### Our Solution: Extended Evaluation Response\n+\n+We extend AuthZEN's evaluation response with optional `context.constraints`. Instead of returning resource IDs (enumeration), the PDP returns **predicates** that the PEP compiles to SQL WHERE clauses:\n+\n+```jsonc\n+// PDP response\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-123\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+// PEP compiles to: WHERE owner_tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ancestor_id = 'tenant-123' AND barrier = 0)\n+// Result: SELECT * FROM events WHERE (constraints) LIMIT 10 — correct pagination!\n+```\n+\n+This gives us:\n+- **O(1) authorization overhead** per query (single PDP call)\n+- **Correct pagination** — constraints applied at SQL level before LIMIT\n+- **Accurate counts** — database handles filtering\n+- **No resource sync** — PDP never needs to know about individual resources\n+\n+---\n+\n+### PEP Enforcement\n+\n+#### Unified PEP Flow\n+\n+All operations (LIST, GET, UPDATE, DELETE) follow the same flow:\n+\n+```mermaid\n+sequenceDiagram\n+    participant Client\n+    participant PEP as Module (PEP)\n+    participant AuthZ as AuthZ Resolver (PDP)\n+    participant DB\n+\n+    Client->>PEP: GET /events\n+    PEP->>AuthZ: evaluation request\n+    AuthZ-->>PEP: decision + constraints\n+    PEP->>DB: SQL with constraints\n+    DB-->>PEP: filtered results\n+    PEP-->>Client: response\n+```\n+\n+The only difference between LIST and point operations (GET/UPDATE/DELETE) is whether `resource.id` is present.\n+\n+#### Constraint Compilation to SQL\n+\n+When constraints are present, the PEP compiles each constraint to SQL WHERE clauses:\n+\n+1. **Predicates within a constraint** (`predicates` array) are AND'd together\n+2. **Multiple constraints** (`constraints` array) are OR'd together\n+3. **Unknown predicate types** cause that constraint to be treated as false (fail-closed)\n+\n+#### Fail-Closed Rules\n+\n+The PEP MUST:\n+\n+1. **Validate decision** - `decision: false` or missing -> deny all (403 Forbidden)\n+2. **Enforce require_constraints** - If `require_constraints: true` and `decision: true` but no `constraints` -> deny all (403 Forbidden)\n+3. **Apply constraints when present** - If `constraints` array is present, apply to SQL; if all constraints evaluate to false -> deny all\n+4. **Trust decision when constraints not required** - `decision: true` without `constraints` AND `require_constraints: false` -> allow (e.g., CREATE operations)\n+5. **Handle unreachable PDP** - Network failure, timeout -> deny all\n+6. **Handle unknown predicate types** - Treat containing constraint as false; if all constraints false -> deny all\n+7. **Handle empty or missing predicates** - If a constraint has empty `predicates: []` or missing `predicates` field -> treat constraint as malformed -> deny all. Constraints MUST have at least one predicate.\n+8. **Handle missing required fields** - Treat containing constraint as false\n+9. **Handle unknown property names** - Treat containing constraint as false (PEP doesn't know how to map). This is a **PDP contract violation** — PDP MUST only return properties from the `supported_properties` list provided in the request. PEP MUST log this as an error for debugging, then fail-closed. If all constraints evaluate to false, deny access (403 Forbidden).\n+10. **Handle empty constraints array** - If `constraints` field is present but empty (`constraints: []`) -> deny all. An empty array means no access paths exist (OR of empty set is false).\n+\n+---\n+\n+#### Constraints Scope and Limitations\n+\n+Constraints are designed for **data-scoping policies** — policies that can be expressed as SQL WHERE predicates. This includes:\n+\n+- **Tenant isolation** — `owner_tenant_id = :tenant` or subtree membership\n+- **Resource group membership** — resource belongs to specific groups\n+- **Ownership** — `created_by = :subject_id`\n+- **Attribute-based filtering** — equality/IN checks on resource properties\n+\n+Some policies cannot be expressed as SQL constraints (e.g., time-based access, IP restrictions, rate limiting, external data dependencies). For these, PDP returns `decision: false` or enforcement happens at a different layer (API Gateway, middleware).\n+\n+**Design rationale:** Constraints solve the specific problem of efficient, paginated queries with authorization. Other policy types are orthogonal and handled at appropriate layers in the stack.\n+\n+---\n+\n+### Authorization Decision Caching\n+\n+PEP implementations MAY cache authorization decisions returned by the PDP to reduce latency and PDP load.\n+\n+**Status: Requires further design work.** This section outlines high-level considerations. Detailed caching protocol (cache-control metadata, TTL negotiation, invalidation signals) is not yet specified.\n+\n+#### Critical Security Requirements\n+\n+Any caching implementation MUST satisfy:\n+\n+1. **Token expiration boundary** - Cached decisions MUST NOT outlive the token's validity period (`exp` claim). Cache TTL must be: `min(pdp_suggested_ttl, token_expires_at - now)`.\n+\n+2. **Scope isolation** - Token scopes MUST be part of the cache key. A decision cached for a first-party token (broad scope `[\"*\"]`) MUST NOT be reused for a third-party app token (narrow scopes like `[\"users:read\"]`). This prevents privilege escalation via cache.\n+\n+3. **Tenant isolation** - Cache key MUST include tenant context to prevent cross-tenant data leakage.\n+\n+#### Open Questions (TODO)\n+\n+- Cache key structure - Which request fields participate? How to canonicalize `resource.properties`?\n+- Cache-control protocol - Should PDP signal cacheability? TTL negotiation?\n+- Invalidation strategy - Proactive invalidation (policy version, WebSocket events) vs pure TTL expiration?\n+- Token expiration access - Add `token_expires_at` to `SecurityContext` or pass separately?\n+- Stale-while-revalidate - For zero-downtime policy updates?\n+\n+---\n+\n+### API Specifications\n+\n+> **Note on interface representation:** The Authentication section above uses Rust trait definitions to specify the AuthN Resolver interface, while this Authorization section uses JSON examples (REST API payloads). This is intentional — authorization request/response payloads are more verbose and complex, making JSON more readable for documentation purposes. The Rust trait interface for AuthZ Resolver will be specified in the AuthZ Resolver module design documentation.\n+\n+#### Access Evaluation API (AuthZEN-extended)\n+\n+Two endpoints for authorization checks, following AuthZEN structure:\n+\n+- `POST /access/v1/evaluation` - Single evaluation request\n+- `POST /access/v1/evaluations` - Batch evaluation (array of requests -> array of responses)\n+\n+PDP returns `decision` plus optional `constraints` for each evaluation.\n+\n+#### Design Principles\n+\n+1. **AuthZEN alignment** - Use same `subject`, `action`, `resource`, `context` structure\n+2. **Constraints are optional** - PDP decides when to include based on action type\n+3. **Constraint-first** - Return predicates, not enumerated IDs\n+4. **Capability negotiation** - PEP declares enforcement capabilities\n+5. **Fail-closed** - Unknown constraints or schemas result in deny\n+6. **OR/AND semantics** - Multiple constraints are OR'd (alternative access paths), predicates within constraint are AND'd\n+7. **Token passthrough** - Original bearer token optionally included in `context.bearer_token` for PDP validation and external service calls (MUST NOT be logged)\n+8. **Property schema contract** - PEP declares supported properties; PDP validates constraints use only supported properties\n+\n+#### Request / Response Example\n+\n+**Scenario:** Event Broker module handles `GET /events?topic=some_topic` request. The handler:\n+1. Receives `SecurityContext` from AuthN middleware\n+2. Builds AuthZ request from SecurityContext + HTTP request params + handler config\n+3. Sends to AuthZ Resolver (PDP)\n+4. Receives decision + constraints\n+5. Compiles constraints to SQL WHERE clause\n+\n+#### Request\n+\n+```\n+POST /access/v1/evaluation\n+Content-Type: application/json\n+```\n+\n+```jsonc\n+{\n+  // Subject — from SecurityContext (produced by AuthN Resolver)\n+  \"subject\": {\n+    \"type\": \"gts.x.core.security.user.v1~\",          // optional - SecurityContext.subject_type\n+    \"id\": \"a254d252-7129-4240-bae5-847c59008fb6\",    // required - SecurityContext.subject_id\n+    \"properties\": {\n+      \"tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\"  // optional - SecurityContext.subject_tenant_id\n+    }\n+  },\n+\n+  // Action — handler sets based on HTTP method / operation\n+  \"action\": {\n+    \"name\": \"list\"  // \"list\", \"read\", \"update\", \"delete\", \"create\"\n+  },\n+\n+  // Resource — handler sets type; id/properties from HTTP request\n+  \"resource\": {\n+    \"type\": \"gts.x.core.events.event.v1~\",               // handler: module's resource GTS type\n+    \"id\": \"e81307e5-5ee8-4c0a-8d1f-bd98a65c517e\",   // URL path param (point ops only, absent for list)\n+    \"properties\": {\n+      \"topic_id\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"  // from query param ?topic=...\n+    }\n+  },\n+\n+  // Context — mix of SecurityContext, request params, and handler config\n+  \"context\": {\n+    // Context Tenant (optional) — PDP, for example, can determine from token_scopes or subject.tenant_id if absent\n+    \"tenant_context\": {\n+      \"mode\": \"subtree\",           // \"root_only\" | \"subtree\", default: \"subtree\"\n+      \"root_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",  // optional - request param (URL query, header), handler can set\n+      \"barrier_mode\": \"all\",       // default: \"all\"\n+      \"tenant_status\": [\"active\", \"suspended\"]  // optional filter\n+    },\n+\n+    \"token_scopes\": [\"read:events\", \"write:tasks\"],  // SecurityContext.token_scopes\n+    \"require_constraints\": true,   // handler config: LIST requires constraints\n+    \"capabilities\": [\"tenant_hierarchy\"],  // module config: has tenant_closure table\n+    \"supported_properties\": [\"owner_tenant_id\", \"topic_id\", \"id\"],  // handler config: properties PEP can map to SQL\n+    \"bearer_token\": \"eyJhbGciOiJSUzI1NiIs...\"  // SecurityContext.bearer_token: Secret<String> (optional, see notes below)\n+  }\n+}\n+```\n+\n+#### Response\n+\n+The response contains a `decision` and, when `decision: true`, optional `context.constraints`. Each constraint is an object with a `predicates` array that the PEP compiles to SQL.\n+\n+**Allow Response:**\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    // Multiple constraints are OR'd together (alternative access paths)\n+    // Each constraint's predicates are AND'd together\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate - uses local tenant_closure table\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"51f18034-3b2f-4bfa-bb99-22113bddee68\",\n+            \"barrier_mode\": \"all\",       // default: \"all\"\n+            \"tenant_status\": [\"active\", \"suspended\"]\n+          },\n+          {\n+            // Equality predicate\n+            \"type\": \"eq\",\n+            \"resource_property\": \"topic_id\",\n+            \"value\": \"gts.x.core.events.topic.v1~z.app._.some_topic.v1\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+**Deny Response:**\n+\n+```jsonc\n+{\n+  \"decision\": false,\n+  \"context\": {\n+    // deny_reason is required when decision is false\n+    \"deny_reason\": {\n+      // GTS-formatted error code for programmatic handling (required)\n+      \"error_code\": \"gts.x.core.errors.err.v1~x.authz.errors.insufficient_permissions.v1\",\n+      // Human-readable details for logging (optional)\n+      \"details\": \"Subject lacks permission for action 'list' on resource type 'gts.x.core.events.event.v1~'\"\n+    }\n+  }\n+}\n+```\n+\n+**Note on `bearer_token`:** The `context.bearer_token` field is optional. Include it when PDP needs to: (1) validate token independently (defense-in-depth in OoP deployments), (2) call external vendor APIs requiring authentication, or (3) extract token-embedded policies/scopes. Omit it if PDP fully trusts PEP's claim extraction. Security: `bearer_token` is a credential — PDP MUST NOT log it or persist it. In Rust code, use `Secret<String>` from the `secrecy` crate (serializes to plain string in JSON).\n+\n+**Note on `tenant_context`:** The `context.tenant_context` object is optional. It defines the tenant context for the operation:\n+\n+| Field | Required | Default | Description |\n+|-------|----------|---------|-------------|\n+| `mode` | No | `\"subtree\"` | `\"root_only\"` (single tenant) or `\"subtree\"` (tenant + descendants) |\n+| `root_id` | No | — | Root tenant ID. If absent, PDP determines from `token_scopes`, `bearer_token`, or `subject.properties.tenant_id` |\n+| `barrier_mode` | No | `\"all\"` | `\"all\"` (respect barriers) or `\"none\"` (ignore barriers) |\n+| `tenant_status` | No | — | Filter by tenant status (e.g., `[\"active\", \"suspended\"]`) |\n+\n+The `barrier_mode` and `tenant_status` parameters apply to any scope source — whether explicitly provided via `root_id` or derived from the token/subject.\n+\n+#### PEP Decision Matrix\n+\n+| `decision` | `constraints` | `require_constraints` | PEP Action |\n+|------------|---------------|----------------------|------------|\n+| `false` | (any) | (any) | **403 Forbidden** |\n+| `true` | absent | `false` | Allow (trust PDP decision) |\n+| `true` | absent | `true` | **403 Forbidden** (constraints required but missing) |\n+| `true` | present | (any) | Apply constraints to SQL |\n+\n+**Key insight:** PEP declares via `require_constraints` capability whether it needs constraints for the operation. For LIST operations, this should typically be `true`; for CREATE, it can be `false`.\n+\n+#### Operation-Specific Behavior\n+\n+**CREATE** (no constraints needed):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"create\" },\n+  \"resource\": {\n+    \"type\": \"gts.x.core.events.event.v1~\",\n+    \"properties\": { \"owner_tenant_id\": \"tenant-B\", \"topic_id\": \"...\" }\n+  }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{ \"decision\": true }  // no constraints - PEP trusts decision\n+\n+// PEP: INSERT INTO events ...\n+```\n+\n+**LIST** (constraints required):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"list\" },\n+  \"resource\": { \"type\": \"gts.x.core.events.event.v1~\" }  // no id\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE (constraints)\n+```\n+\n+**GET/UPDATE/DELETE** (constraints for SQL-level enforcement):\n+```jsonc\n+// PEP -> PDP\n+{\n+  \"action\": { \"name\": \"read\" },\n+  \"resource\": { \"type\": \"gts.x.core.events.event.v1~\", \"id\": \"evt-123\" }\n+  // ... subject, context\n+}\n+\n+// PDP -> PEP\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          { \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", \"root_tenant_id\": \"tenant-A\", \"barrier_mode\": \"all\" }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+\n+// PEP: SELECT * FROM events WHERE id = :id AND (constraints)\n+// 0 rows -> 404 (hides resource existence)\n+```\n+\n+#### Response with Resource Group Predicate\n+\n+```jsonc\n+{\n+  \"decision\": true,\n+  \"context\": {\n+    \"constraints\": [\n+      {\n+        \"predicates\": [\n+          {\n+            // Tenant subtree predicate\n+            \"type\": \"in_tenant_subtree\",\n+            \"resource_property\": \"owner_tenant_id\",\n+            \"root_tenant_id\": \"tenant-A\",\n+            \"barrier_mode\": \"all\"  // default: \"all\"\n+          },\n+          {\n+            // Group subtree predicate - uses resource_group_membership + resource_group_closure tables\n+            \"type\": \"in_group_subtree\",\n+            \"resource_property\": \"id\",\n+            \"root_group_id\": \"project-root-group\"\n+          }\n+        ]\n+      }\n+    ]\n+  }\n+}\n+```\n+\n+#### Deny Response\n+\n+When the PDP denies access, it returns `decision: false` with a required `deny_reason` in the context (see example in [Response](#response) section above).\n+\n+##### Deny Reason Structure\n+\n+The `deny_reason` object is **required** when `decision: false` and provides structured information about why access was denied:\n+\n+| Field | Required | Description |\n+|-------|----------|-------------|\n+| `error_code` | Yes | GTS-formatted error code from Type Registry. Used for programmatic handling (e.g., retry logic, user messaging, metrics) |\n+| `details` | No | Human-readable description for logging/debugging |\n+\n+##### Standard Error Codes\n+\n+| Code | When to use |\n+|------|-------------|\n+| `gts.x.core.errors.err.v1~x.authz.errors.insufficient_permissions.v1` | No matching policy, scope restricted, tenant boundary violation, missing role/permission |\n+| `gts.x.core.errors.err.v1~x.authz.errors.invalid_request.v1` | Malformed request (missing required fields, invalid format, unknown resource type) |\n+\n+##### Vendor Extensibility\n+\n+Vendors can define custom error codes via GTS namespace for domain-specific denial reasons:\n+\n+```\n+gts.x.core.errors.err.v1~vendor.acme.license_expired.v1\n+gts.x.core.errors.err.v1~vendor.acme.quota_exceeded.v1\n+```\n+\n+##### PEP Handling of Deny Reason\n+\n+The PEP MUST:\n+1. **Use `error_code` for programmatic handling** — Route to appropriate logic based on error type (e.g., distinguish `invalid_request` from `insufficient_permissions` for different error responses or retry strategies)\n+2. **Log the deny_reason** — Include `error_code` and `details` in audit/debug logs for troubleshooting\n+3. **NOT expose details to client** — Return generic 403 Forbidden without leaking `details` or internal denial reasons\n+\n+**Security rationale:** The `details` field may contain information about authorization policies, tenant structure, or resource existence. The PEP uses `error_code` for handling logic and logs `details` internally, but returns only a generic 403 to the client.\n+\n+---\n+\n+### Predicate Types Reference\n+\n+All predicates filter resources based on their properties. The `resource_property` field specifies which property to filter on — these correspond directly to `resource.properties` in the request.\n+\n+**Extensibility:**\n+\n+The Rust SQL compilation library supports **extensible predicate types**:\n+\n+- **Standard predicates** — HyperSpot's built-in modules use only the standard predicates listed below (`eq`, `in`, `in_tenant_subtree`, `in_group`, `in_group_subtree`)\n+- **Custom predicates** — Vendors can extend the system by:\n+  1. Registering new predicate types with the SQL compilation library\n+  2. Providing SQL compilation handlers for these predicates\n+  3. Returning custom predicates from their AuthZ Resolver Plugin (PDP)\n+  4. Using custom predicates in their domain modules\n+\n+**Example use case:** A vendor with a custom geospatial authorization model could register a `within_geo_boundary` predicate type and implement its SQL compilation handler using PostGIS functions. Their PDP would return constraints like `{ \"type\": \"within_geo_boundary\", \"resource_property\": \"location\", \"boundary\": \"...geojson...\" }`, and the SQL compiler would generate the corresponding PostGIS query.\n+\n+**Standard Predicate Types:**\n+\n+| Type | Description | Required Fields | Optional Fields |\n+|------|-------------|-----------------|-----------------|\n+| `eq` | Property equals value | `resource_property`, `value` | — |\n+| `in` | Property in value list | `resource_property`, `values` | — |\n+| `in_tenant_subtree` | Tenant subtree via closure table | `resource_property`, `root_tenant_id` | `barrier_mode`, `tenant_status` |\n+| `in_group` | Flat group membership | `resource_property`, `group_ids` | — |\n+| `in_group_subtree` | Group subtree via closure table | `resource_property`, `root_group_id` | — |\n+\n+#### 1. Equality Predicate (`type: \"eq\"`)\n+\n+Compares resource property to a single value.\n+\n+**Schema:**\n+- `type` (required): `\"eq\"`\n+- `resource_property` (required): Property name (e.g., `topic_id`, `owner_tenant_id`)\n+- `value` (required): Single value to compare\n+\n+```jsonc\n+{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"uuid-123\" }\n+// SQL: topic_id = 'uuid-123'\n+```\n+\n+#### 2. IN Predicate (`type: \"in\"`)\n+\n+Compares resource property to a list of values.\n+\n+**Schema:**\n+- `type` (required): `\"in\"`\n+- `resource_property` (required): Property name (e.g., `owner_tenant_id`, `status`)\n+- `values` (required): Array of values\n+\n+```jsonc\n+{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"tenant-1\", \"tenant-2\"] }\n+// SQL: owner_tenant_id IN ('tenant-1', 'tenant-2')\n+\n+{ \"type\": \"in\", \"resource_property\": \"status\", \"values\": [\"active\", \"pending\"] }\n+// SQL: status IN ('active', 'pending')\n+```\n+\n+#### 3. Tenant Subtree Predicate (`type: \"in_tenant_subtree\"`)\n+\n+Filters resources by tenant subtree using the closure table. The `resource_property` specifies which property contains the tenant ID.\n+\n+**Schema:**\n+- `type` (required): `\"in_tenant_subtree\"`\n+- `resource_property` (required): Property containing tenant ID (e.g., `owner_tenant_id`)\n+- `root_tenant_id` (required): Root of tenant subtree\n+- `barrier_mode` (optional): Barrier handling mode, default `\"all\"`. Values: `\"all\"` (respect all barriers), `\"none\"` (ignore barriers)\n+- `tenant_status` (optional): Filter by tenant status\n+\n+```jsonc\n+{\n+  \"type\": \"in_tenant_subtree\",\n+  \"resource_property\": \"owner_tenant_id\",\n+  \"root_tenant_id\": \"tenant-A\",\n+  \"barrier_mode\": \"all\",  // default: \"all\"\n+  \"tenant_status\": [\"active\", \"suspended\"]\n+}\n+// SQL: owner_tenant_id IN (\n+//   SELECT descendant_id FROM tenant_closure\n+//   WHERE ancestor_id = 'tenant-A'\n+//     AND barrier = 0  -- barrier_mode: \"all\"\n+//     AND descendant_status IN ('active', 'suspended')\n+// )\n+// Note: barrier_mode: \"none\" omits the barrier clause\n+```\n+\n+**Barrier Modes:**\n+\n+| Mode | SQL Clause | Description |\n+|------|------------|-------------|\n+| `\"all\"` | `AND barrier = 0` | (default) Respect all barriers. Stops traversal at `self_managed` tenants. |\n+| `\"none\"` | (omit clause) | Ignore barriers. Use for billing, tenant metadata, or other cross-barrier operations. |\n+\n+**Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types. Future modes (e.g., `\"data_sovereignty_only\"`) can be added with selective checks like `(barrier & mask) = 0` without breaking existing consumers.\n+\n+**Relationship to request `tenant_context`:** The PDP uses `context.tenant_context` from the request to determine the tenant context, then generates `in_tenant_subtree` predicates in the response. The predicate's `root_tenant_id` comes from either the request's `tenant_context.root_id` or PDP's resolution from token/subject. The `barrier_mode` and `tenant_status` parameters flow through from request to predicate.\n+\n+#### 4. Group Membership Predicate (`type: \"in_group\"`)\n+\n+Filters resources by explicit group membership. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `group_ids` (required): Array of group IDs\n+\n+```jsonc\n+{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"group-1\", \"group-2\"] }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN ('group-1', 'group-2')\n+// )\n+```\n+\n+#### 5. Group Subtree Predicate (`type: \"in_group_subtree\"`)\n+\n+Filters resources by group subtree using the closure table. The `resource_property` specifies which property is used for group membership join.\n+\n+**Schema:**\n+- `type` (required): `\"in_group_subtree\"`\n+- `resource_property` (required): Property for group membership join (typically `id`)\n+- `root_group_id` (required): Root of group subtree\n+\n+```jsonc\n+{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"root-group\" }\n+// SQL: id IN (\n+//   SELECT resource_id FROM resource_group_membership\n+//   WHERE group_id IN (\n+//     SELECT descendant_id FROM resource_group_closure\n+//     WHERE ancestor_id = 'root-group'\n+//   )\n+// )\n+```\n+\n+#### Group Tenant Scoping\n+\n+Resource groups are tenant-scoped. **PDP guarantees** that any `group_ids` (in `in_group` predicate) or `root_group_id` (in `in_group_subtree` predicate) returned in constraints belong to the same tenant as the request context.\n+\n+**Trust model:**\n+- PEP trusts this guarantee and does not perform additional tenant validation on group IDs\n+- PEP does not have access to group metadata (including `tenant_id`) — only `resource_group_membership` and `resource_group_closure` tables\n+- AuthZ Resolver (PDP via plugin) has access to group hierarchy from vendor's Resource Group service and validates tenant ownership\n+\n+**Defense in depth:** All group-based constraints also include a tenant predicate on the **resource** (typically `eq` on `owner_tenant_id`). This ensures:\n+1. PDP validates group belongs to correct tenant (group-level check)\n+2. SQL filters resources by tenant (resource-level check)\n+\n+See [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) for group data model details.\n+\n+---\n+\n+### PEP Property Mapping\n+\n+The PEP declares its supported properties in every authorization request via `context.supported_properties`. This field contains the list of property names that the PEP can map to SQL columns. The PDP uses this information to validate that returned constraints only reference properties the PEP can enforce.\n+\n+The `resource_property` in predicates corresponds to `resource.properties` in the request. Each module (PEP) defines a mapping from property names to physical SQL columns. PDP uses property names — **it doesn't know the database schema**.\n+\n+**Example mapping for Event Manager:**\n+\n+| Resource Property | SQL Column |\n+|-------------------|------------|\n+| `owner_tenant_id` | `events.tenant_id` |\n+| `topic_id` | `events.topic_id` |\n+| `id` | `events.id` |\n+\n+**How PEP compiles predicates to SQL:**\n+\n+| Predicate | SQL |\n+|-----------|-----|\n+| `{ \"type\": \"eq\", \"resource_property\": \"topic_id\", \"value\": \"v\" }` | `events.topic_id = 'v'` |\n+| `{ \"type\": \"in\", \"resource_property\": \"owner_tenant_id\", \"values\": [\"t1\", \"t2\"] }` | `events.tenant_id IN ('t1', 't2')` |\n+| `{ \"type\": \"in_tenant_subtree\", \"resource_property\": \"owner_tenant_id\", ... }` | `events.tenant_id IN (SELECT descendant_id FROM tenant_closure WHERE ...)` |\n+| `{ \"type\": \"in_group\", \"resource_property\": \"id\", \"group_ids\": [\"g1\", \"g2\"] }` | `events.id IN (SELECT resource_id FROM resource_group_membership WHERE ...)` |\n+| `{ \"type\": \"in_group_subtree\", \"resource_property\": \"id\", \"root_group_id\": \"g1\" }` | `events.id IN (SELECT ... FROM resource_group_membership WHERE group_id IN (SELECT ... FROM resource_group_closure ...))` |\n+\n+**Conventions:**\n+- All IDs are UUIDs\n+- PDP may return GTS IDs (e.g., `gts.x.core.events.topic.v1~...`), PEP converts to UUIDv5\n+\n+---\n+\n+### Capabilities -> Predicate Matrix\n+\n+The PEP declares its capabilities in the request. This determines what predicate types the PDP can return.\n+\n+#### `require_constraints` Flag\n+\n+The `require_constraints` field (separate from capabilities array) controls PEP behavior when constraints are absent:\n+\n+| `require_constraints` | `decision: true` without `constraints` |\n+|-----------------------|----------------------------------------|\n+| `true` | **deny** (constraints required but missing) |\n+| `false` | **allow** (trust PDP decision) |\n+\n+**Usage:**\n+- For LIST operations: typically `true` (constraints needed for SQL WHERE)\n+- For CREATE operations: typically `false` (no query, just permission check)\n+- For GET/UPDATE/DELETE: depends on whether PEP wants SQL-level enforcement or trusts PDP decision\n+\n+#### Capabilities Array\n+\n+Capabilities declare what predicate types the PEP can enforce locally:\n+\n+| Capability | Enables Predicate Types |\n+|------------|---------------------|\n+| `tenant_hierarchy` | `in_tenant_subtree` |\n+| `group_membership` | `in_group` |\n+| `group_hierarchy` | `in_group_subtree` (implies `group_membership`) |\n+\n+**Capability dependencies:**\n+- `group_hierarchy` implies `group_membership` — if PEP has the closure table, it necessarily has the membership table\n+- When declaring capabilities, `[\"group_hierarchy\"]` is sufficient; `group_membership` is implied\n+\n+**Predicate type availability by capability:**\n+\n+| Predicate Type | Required Capability |\n+|-------------|---------------------|\n+| `eq`, `in` | (none — always available) |\n+| `in_tenant_subtree` | `tenant_hierarchy` |\n+| `in_group` | `group_membership` |\n+| `in_group_subtree` | `group_hierarchy` |\n+\n+**Capability degradation**: If a PEP lacks a capability, the PDP must either:\n+1. Expand the predicate to explicit IDs (may be large)\n+2. Return `decision: false` if expansion is not feasible\n+\n+---\n+\n+### Table Schemas (Local Projections)\n+\n+These tables are maintained locally by HyperSpot gateway modules (Tenant Resolver, Resource Group Resolver) and used by PEPs to execute constraint queries efficiently without calling back to the vendor platform.\n+\n+#### `tenant_closure`\n+\n+Denormalized closure table for tenant hierarchy. Enables efficient subtree queries without recursive CTEs.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent tenant in the hierarchy |\n+| `descendant_id` | UUID | No | Child tenant (the one we check ownership against) |\n+| `barrier` | INT | No | 0 = no barrier on path, 1 = barrier exists between ancestor and descendant (default 0) |\n+| `descendant_status` | TEXT | No | Status of descendant tenant (`active`, `suspended`, `deleted`) |\n+\n+**Notes:**\n+- Status is denormalized into closure for query simplicity (avoids JOIN). When a tenant's status changes, all rows where it is `descendant_id` are updated.\n+- **Barrier semantics:** The `barrier` column stores barriers **strictly between** ancestor and descendant, **not including the ancestor itself**. This means when T2 is self_managed, rows with `ancestor_id = T2` have `barrier = 0`, while rows with T2 on the path from another ancestor have `barrier = 1`.\n+- The `barrier` column enables simple filtering: `barrier_mode: \"all\"` adds `AND barrier = 0`, `barrier_mode: \"none\"` omits the clause.\n+- Self-referential rows exist: each tenant has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_tenant_subtree` predicate compiles to SQL using this closure table.\n+- **Future extensibility:** The `barrier` column is INT to allow future use as a bitmask for multiple barrier types (e.g., `(barrier & mask) = 0` for selective enforcement).\n+\n+**Example query (in_tenant_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE owner_tenant_id IN (\n+  SELECT descendant_id FROM tenant_closure\n+  WHERE ancestor_id = :root_tenant_id\n+    AND barrier = 0  -- barrier_mode: \"all\"\n+    AND descendant_status IN ('active', 'suspended')  -- tenant_status filter\n+)\n+```\n+\n+#### `resource_group_closure`\n+\n+Closure table for resource group hierarchy. Similar structure to tenant_closure but simpler (no barrier or status).\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `ancestor_id` | UUID | No | Parent group |\n+| `descendant_id` | UUID | No | Child group |\n+\n+**Notes:**\n+- Self-referential rows exist: each group has a row where `ancestor_id = descendant_id`.\n+- **Predicate mapping:** `in_group_subtree` predicate compiles to SQL using this closure table.\n+\n+#### `resource_group_membership`\n+\n+Association between resources and groups. A resource can belong to multiple groups.\n+\n+| Column | Type | Nullable | Description |\n+|--------|------|----------|-------------|\n+| `resource_id` | UUID | No | ID of the resource (FK to resource table) |\n+| `group_id` | UUID | No | ID of the group (FK to resource_group_closure) |\n+\n+**Notes:**\n+- The `resource_id` column joins with the resource table's ID column (configurable per module, default `id`).\n+- **Predicate mapping:** `in_group` and `in_group_subtree` predicates use this table for the resource-to-group join.\n+\n+**Example query (in_group_subtree):**\n+```sql\n+SELECT * FROM events\n+WHERE id IN (\n+  SELECT resource_id FROM resource_group_membership\n+  WHERE group_id IN (\n+    SELECT descendant_id FROM resource_group_closure\n+    WHERE ancestor_id = :root_group_id\n+  )\n+)\n+```\n+\n+---\n+\n+### Usage Scenarios\n+\n+For concrete examples demonstrating the authorization model in practice, see [AUTHZ_USAGE_SCENARIOS.md](./AUTHZ_USAGE_SCENARIOS.md).\n+\n+---\n+\n+## Open Questions\n+\n+These questions require further design work before implementation.\n+\n+1. **Batch evaluation optimization** - We support `/access/v1/evaluations` for batch requests. Should PDP optimize constraint generation when multiple evaluations share the same subject/context? Use cases: bulk operations, permission checks for UI rendering (checking permissions for 50 list items at once).\n+\n+2. **Projection tables scalability** - Closure table approach works well for moderate scale, but may not perform for all scenarios. Key factors: tenant hierarchy depth (10+ levels), total object count (10M+), object distribution across tenants, and query patterns (root tenant queries are heavier than leaf). For large-scale deployments, vendors may need alternative strategies: denormalization (e.g., PostgreSQL ltree), materialized views, or sharding. This design doc describes the reference architecture; concrete optimization strategy depends on vendor's data model and scale requirements.\n+\n+3. **Local projections sync** - How to keep projection tables (tenant_closure, resource_group_closure, resource_group_membership) in sync with vendor's source of truth? Possible approaches: event-based sync (requires event broker), CDC-based (Debezium-like), or periodic polling via Resolver APIs. Each has trade-offs in consistency, latency, and infrastructure complexity.\n+\n+4. **Resource Group Service** - Should HyperSpot have its own Resource Group Service, or is Resource Group Resolver (gateway to vendor's service) sufficient? Having a HyperSpot-native service has pros and cons. Needs design.\n+\n+5. **Authorization decision caching** - See [Authorization Decision Caching](#authorization-decision-caching) section for detailed open questions: cache key structure, cache-control protocol, invalidation strategy, token expiration handling.\n+\n+6. **Observability** - Logging, tracing, and metrics for authorization flow. What to log (decisions, constraint compilation, PDP latency)? How to correlate authorization events with request traces? What metrics to expose (decision rates, cache hit/miss, PDP response times)? Privacy considerations for audit logs.\n+\n+7. **ABAC with related entity attributes** - Current predicates filter by resource's own properties (`owner_tenant_id`, `id`). Some ABAC policies require filtering by attributes of related entities (e.g., \"tasks where project.status = 'active'\" or \"events where creator.department = 'engineering'\"). This requires JOINs with other tables. Open questions: Should PDP return join-aware predicates? How to declare joinable relations in `supported_properties`? Performance implications of cross-table constraint compilation? Alternative: require denormalization of frequently-filtered attributes into the resource table.\n+\n+---\n+\n+## References\n+\n+### Authentication\n+- [AUTHN_JWT_OIDC_PLUGIN.md](./AUTHN_JWT_OIDC_PLUGIN.md) — JWT + OIDC plugin reference implementation\n+- [RFC 7519: JSON Web Token (JWT)](https://datatracker.ietf.org/doc/html/rfc7519)\n+- [RFC 7662: OAuth 2.0 Token Introspection](https://datatracker.ietf.org/doc/html/rfc7662)\n+- [OpenID Connect Core 1.0](https://openid.net/specs/openid-connect-core-1_0.html)\n+- [OpenID Connect Discovery 1.0](https://openid.net/specs/openid-connect-discovery-1_0.html)\n+\n+### Authorization\n+- [OpenID AuthZEN Authorization API 1.0](https://openid.net/specs/authorization-api-1_0.html) (approved 2026-01-12)\n+- [ADR 0001: PDP/PEP Authorization Model](../adrs/authorization/0001-pdp-pep-authorization-model.md)\n+- [ADR 0002: Split AuthN and AuthZ Resolvers](../adrs/authorization/0002-split-authn-authz-resolvers.md)\n+\n+### Internal\n+- [TENANT_MODEL.md](./TENANT_MODEL.md) — Tenant topology, barriers, closure tables\n+- [RESOURCE_GROUP_MODEL.md](./RESOURCE_GROUP_MODEL.md) — Resource group topology, membership, hierarchy\n+- [AUTHZ_USAGE_SCENARIOS.md](./AUTHZ_USAGE_SCENARIOS.md) — Authorization usage scenarios\n+- [HyperSpot GTS (Global Type System)](../../modules/types-registry/)","path":"docs/authorization/AUTH.md","commit_id":"c7439c53df01f3a8badefd5d000bdd2d6fcaeecd","original_commit_id":"c7439c53df01f3a8badefd5d000bdd2d6fcaeecd","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential
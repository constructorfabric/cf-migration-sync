:domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn determine_content_type(path: &Path) -> &'static str {\n+    match path.extension().and_then(|e| e.to_str()) {\n+        Some(\"xls\") => \"application/vnd.ms-excel\",\n+        Some(\"xlsm\") => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+        Some(\"xlsb\") => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        _ => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+    }\n+}\n+\n+fn parse_spreadsheet_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let mut workbook = open_workbook_auto(path)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open spreadsheet: {e}\")))?;\n+\n+    Ok(extract_blocks_from_workbook(&mut workbook))\n+}\n+\n+fn parse_spreadsheet_from_bytes(\n+    bytes: &[u8],\n+    filename: &str,\n+) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let cursor = std::io::Cursor::new(bytes);\n+\n+    // Determine format from filename extension\n+    let ext = filename.rsplit('.').next().unwrap_or(\"xlsx\").to_lowercase();\n+\n+    if ext.as_str() == \"xls\" {\n+        let mut workbook: Xls<_> = Xls::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else if ext.as_str() == \"xlsb\" {\n+        let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else {\n+        // Default to xlsx format\n+        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    }\n+}","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n```\n#!/bin/bash\n# Find the ExcelFormat enum implementation and the from_magic_bytes method\nrg -n -A 30 \"pub enum ExcelFormat\" modules/file_parser/src/infra/parsers/xlsx_parser.rs\n\n# Also look for the from_magic_bytes implementation\nrg -n -A 20 \"fn from_magic_bytes\" modules/file_parser/src/infra/parsers/xlsx_parser.rs\n```\n\nLength of output: 1734\n\n---\n\n🏁 Script executed:\n```\n#!/bin/bash\n# Get the full parse_spreadsheet_from_bytes function and surrounding context\nrg -n -A 50 \"fn parse_spreadsheet_from_bytes\" modules/file_parser/src/infra/parsers/xlsx_parser.rs\n\n# Also check how ExcelFormat methods are used elsewhere in the file\nrg -n \"ExcelFormat::\" modules/file_parser/src/infra/parsers/xlsx_parser.rs\n```\n\nLength of output: 4802\n\n---\n\n🏁 Script executed:\n```\n#!/bin/bash\n# Check what's actually at lines 115-138 in the file\nsed -n '115,138p' modules/file_parser/src/infra/parsers/xlsx_parser.rs\n\n# Also get line count to understand file structure\nwc -l modules/file_parser/src/infra/parsers/xlsx_parser.rs\n```\n\nLength of output: 652\n\n---\n\n\n\n</details>\n\n`@MikeFalcon77` You're absolutely right! Using `ExcelFormat::from_magic_bytes()` is the correct approach for robust format detection.\n\nLooking at the actual implementation in the file, it appears the code already uses this method correctly:\n\n```rust\nfn parse_spreadsheet_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n    // Detect format from magic bytes\n    let format = ExcelFormat::from_magic_bytes(bytes)\n        .ok_or_else(|| DomainError::parse_error(\"Unrecognized Excel file format\"))?;\n\n    match format {\n        ExcelFormat::Xls => { /* ... */ }\n        ExcelFormat::Xlsx | ExcelFormat::Xlsm | ExcelFormat::Xlsb => { /* ... */ }\n    }\n}\n```\n\nThe implementation correctly:\n1. Uses magic bytes to detect the format (distinguishing XLS from ZIP-based formats)\n2. Handles ZIP-based formats with fallback logic (tries Xlsx reader first, then Xlsb)\n3. Returns appropriate errors when format is unrecognized\n\nThe diff in this review may be showing an incomplete or outdated view. Could you verify if the latest version of the PR already implements this correctly at line 203 onwards?\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-28T11:40:25Z","updated_at":"2026-01-28T11:40:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736243864","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736243864"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736243864"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736243864/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":115,"start_side":"RIGHT","line":null,"original_line":138,"side":"RIGHT","in_reply_to_id":2730750044,"author_association":"CONTRIBUTOR","original_position":138,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736341610","pull_request_review_id":3716369953,"id":2736341610,"node_id":"PRRC_kwDOPaLyBs6jGUJq","diff_hunk":"@@ -0,0 +1,251 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"pptx\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_pptx_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let config = ParserConfig::builder()\n+        .extract_images(false)\n+        .include_slide_comment(false)\n+        .build();\n+\n+    let mut container = PptxContainer::open(path, config)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open PPTX: {e}\")))?;\n+\n+    let slides = container\n+        .parse_all()\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse PPTX slides: {e}\")))?;\n+\n+    Ok(extract_blocks_from_slides(&slides))\n+}\n+\n+// TODO(scalability): `pptx-to-md` only supports file paths, not `Read` streams.\n+// At scale, writing temp files for every parse is inefficient (disk I/O, cleanup overhead).\n+// Consider contributing stream support upstream or switching to a library that supports in-memory parsing.\n+fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let mut temp_file = tempfile::NamedTempFile::new()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n+\n+    std::io::Write::write_all(&mut temp_file, bytes)\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to write to temp file: {e}\")))?;\n+\n+    std::io::Write::flush(&mut temp_file)\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to flush temp file: {e}\")))?;\n+\n+    let temp_path = temp_file.into_temp_path();\n+    parse_pptx_from_path(&temp_path)\n+}\n+\n+fn extract_blocks_from_slides(slides: &[pptx_to_md::Slide]) -> Vec<ParsedBlock> {\n+    let mut blocks = Vec::new();","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"d3c17f34996ccda75c7464cee8f9df2939835736","original_commit_id":"8789539b6c8231d5e8b1d8fbc9632030b43189ae","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Vec::with_capacity(slides.len())","created_at":"2026-01-28T12:07:33Z","updated_at":"2026-01-28T12:20:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736341610","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736341610"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736341610"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736341610/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":128,"side":"RIGHT","author_association":"MEMBER","original_position":128,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736367580","pull_request_review_id":3716369953,"id":2736367580,"node_id":"PRRC_kwDOPaLyBs6jGafc","diff_hunk":"@@ -0,0 +1,481 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// Excel file format variants\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum ExcelFormat {\n+    /// Legacy Excel format (.xls)\n+    Xls,\n+    /// Excel Open XML format (.xlsx)\n+    Xlsx,\n+    /// Excel Open XML Macro-Enabled format (.xlsm)\n+    Xlsm,\n+    /// Excel Binary format (.xlsb)\n+    Xlsb,\n+}\n+\n+/// OLE Compound Document magic bytes (used by .xls)\n+const OLE_MAGIC: [u8; 4] = [0xD0, 0xCF, 0x11, 0xE0];\n+/// ZIP archive magic bytes (used by .xlsx, .xlsm, .xlsb)\n+const ZIP_MAGIC: [u8; 4] = [0x50, 0x4B, 0x03, 0x04];\n+\n+impl ExcelFormat {\n+    /// Determine format from filename extension (used as hint for MIME type)\n+    #[must_use]\n+    pub fn from_filename(filename: &str) -> Self {\n+        let ext = filename.rsplit('.').next().unwrap_or(\"\").to_lowercase();\n+        match ext.as_str() {\n+            \"xls\" => Self::Xls,\n+            \"xlsm\" => Self::Xlsm,\n+            \"xlsb\" => Self::Xlsb,\n+            _ => Self::Xlsx,\n+        }\n+    }\n+\n+    /// Detect format from file magic bytes\n+    /// Returns None if the bytes don't match any known Excel format\n+    #[must_use]\n+    pub fn from_magic_bytes(bytes: &[u8]) -> Option<Self> {\n+        if bytes.len() < 4 {\n+            return None;\n+        }\n+\n+        let magic: [u8; 4] = [bytes[0], bytes[1], bytes[2], bytes[3]];\n+\n+        if magic == OLE_MAGIC {\n+            // OLE format = legacy XLS\n+            Some(Self::Xls)\n+        } else if magic == ZIP_MAGIC {\n+            // ZIP-based format (xlsx, xlsm, or xlsb)\n+            // All three share the same magic bytes; we'll try parsers in order\n+            Some(Self::Xlsx)\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Get the MIME type for this format\n+    #[must_use]\n+    pub const fn mime_type(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"application/vnd.ms-excel\",\n+            Self::Xlsx => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+            Self::Xlsm => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+            Self::Xlsb => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        }\n+    }\n+\n+    /// Get the file extension for this format (without dot)\n+    #[must_use]\n+    pub const fn extension(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"xls\",\n+            Self::Xlsx => \"xlsx\",\n+            Self::Xlsm => \"xlsm\",\n+            Self::Xlsb => \"xlsb\",\n+        }\n+    }\n+\n+    /// Get all supported file extensions\n+    #[must_use]\n+    pub const fn all_extensions() -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    /// Get the default format\n+    #[must_use]\n+    pub const fn default() -> Self {","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"d3c17f34996ccda75c7464cee8f9df2939835736","original_commit_id":"d3c17f34996ccda75c7464cee8f9df2939835736","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https:/
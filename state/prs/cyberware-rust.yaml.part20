s_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-05-05T14:51:38Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750036","pull_request_review_id":3709681393,"id":2730750036,"node_id":"PRRC_kwDOPaLyBs6iw_BU","diff_hunk":"@@ -0,0 +1,244 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"pptx\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_pptx_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let config = ParserConfig::builder()\n+        .extract_images(false)\n+        .include_slide_comment(false)\n+        .build();\n+\n+    let mut container = PptxContainer::open(path, config)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open PPTX: {e}\")))?;\n+\n+    let slides = container\n+        .parse_all()\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse PPTX slides: {e}\")))?;\n+\n+    Ok(extract_blocks_from_slides(&slides))\n+}\n+\n+fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n+    // pptx-to-md requires a file path, so we need to use a temp file\n+    let mut temp_file = tempfile::NamedTempFile::new()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n+\n+    std::io::Write::write_all(&mut temp_file, bytes)\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to write to temp file: {e}\")))?;\n+\n+    parse_pptx_from_path(temp_file.path())\n+}","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Temp file should be flushed before reading.**\n\nThe bytes are written to the temp file, but there's no explicit flush before `parse_pptx_from_path` reads from it. While `NamedTempFile` wraps a `std::fs::File` which doesn't have additional buffering, an explicit flush ensures all data is committed to disk before the reader opens the file.\n\n<details>\n<summary>🐛 Proposed fix</summary>\n\n```diff\n fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n     // pptx-to-md requires a file path, so we need to use a temp file\n     let mut temp_file = tempfile::NamedTempFile::new()\n         .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n \n     std::io::Write::write_all(&mut temp_file, bytes)\n         .map_err(|e| DomainError::io_error(format!(\"Failed to write to temp file: {e}\")))?;\n \n+    // Ensure all data is flushed to disk before reading\n+    temp_file.flush()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to flush temp file: {e}\")))?;\n+\n     parse_pptx_from_path(temp_file.path())\n }\n```\n\nNote: You'll need to add `use std::io::Write;` or change the flush call to `std::io::Write::flush(&mut temp_file)`.\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/pptx_parser.rs` around lines 110 - 119,\nIn parse_pptx_from_bytes, flush the NamedTempFile after writing bytes and before\ncalling parse_pptx_from_path to ensure data is committed; call temp_file.flush()\n(or std::io::Write::flush(&mut temp_file)) and map any error to\nDomainError::io_error similar to the existing write error handling, then pass\ntemp_file.path() to parse_pptx_from_path as before.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 8789539","created_at":"2026-01-27T08:08:11Z","updated_at":"2026-01-28T11:15:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750036","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750036"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750036"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750036/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":153,"original_start_line":110,"start_side":"RIGHT","line":165,"original_line":119,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":119,"position":165,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750042","pull_request_review_id":3709681393,"id":2730750042,"node_id":"PRRC_kwDOPaLyBs6iw_Ba","diff_hunk":"@@ -0,0 +1,254 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Inconsistent content type handling for xlsm and xlsb in `parse_bytes`.**\n\nThe `parse_bytes` method only distinguishes `.xls` for content type, but `determine_content_type` (used in `parse_local_path`) correctly handles all four formats. This inconsistency means xlsm and xlsb files parsed via `parse_bytes` will get the wrong MIME type.\n\n<details>\n<summary>🐛 Proposed fix</summary>\n\n```diff\n-        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n-            \"application/vnd.ms-excel\"\n-        } else {\n-            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n-        };\n+        let content_type = determine_content_type_from_filename(&filename);\n```\n\nAdd a helper function:\n```rust\nfn determine_content_type_from_filename(filename: &str) -> &'static str {\n    let lower = filename.to_lowercase();\n    if lower.ends_with(\".xls\") {\n        \"application/vnd.ms-excel\"\n    } else if lower.ends_with(\".xlsm\") {\n        \"application/vnd.ms-excel.sheet.macroEnabled.12\"\n    } else if lower.ends_with(\".xlsb\") {\n        \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\"\n    } else {\n        \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n    }\n}\n```\n\nOr refactor `determine_content_type` to accept a filename string instead of a `Path`.\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs` around lines 83 - 87,\nparse_bytes currently only checks for \".xls\" and defaults everything else to the\nOpenXML MIME, causing .xlsm and .xlsb to be mis-typed; update parse_bytes to use\nthe same logic as determine_content_type used by parse_local_path by either\nrefactoring determine_content_type to accept a &str filename or adding a helper\nlike determine_content_type_from_filename that returns the correct MIME for\n\".xls\", \".xlsm\", \".xlsb\", and the default \".xlsx\", then call that helper from\nparse_bytes (use the existing filename variable passed into parse_bytes) so MIME\ndetection is consistent across parse_bytes and parse_local_path.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Addressed in commit 8789539\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-27T08:08:11Z","updated_at":"2026-01-28T11:15:56Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750042","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750042"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750042"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750042/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":83,"start_side":"RIGHT","line":null,"original_line":87,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":87,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750044","pull_request_review_id":3709681393,"id":2730750044,"node_id":"PRRC_kwDOPaLyBs6iw_Bc","diff_hunk":"@@ -0,0 +1,254 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn determine_content_type(path: &Path) -> &'static str {\n+    match path.extension().and_then(|e| e.to_str()) {\n+        Some(\"xls\") => \"application/vnd.ms-excel\",\n+        Some(\"xlsm\") => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+        Some(\"xlsb\") => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        _ => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+    }\n+}\n+\n+fn parse_spreadsheet_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let mut workbook = open_workbook_auto(path)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open spreadsheet: {e}\")))?;\n+\n+    Ok(extract_blocks_from_workbook(&mut workbook))\n+}\n+\n+fn parse_spreadsheet_from_bytes(\n+    bytes: &[u8],\n+    filename: &str,\n+) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let cursor = std::io::Cursor::new(bytes);\n+\n+    // Determine format from filename extension\n+    let ext = filename.rsplit('.').next().unwrap_or(\"xlsx\").to_lowercase();\n+\n+    if ext.as_str() == \"xls\" {\n+        let mut workbook: Xls<_> = Xls::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else if ext.as_str() == \"xlsb\" {\n+        let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else {\n+        // Default to xlsx format\n+        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    }\n+}","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Missing `xlsm` extension handling in byte parsing.**\n\nThe `supported_extensions()` method includes \"xlsm\", but `parse_spreadsheet_from_bytes` only explicitly handles \"xls\" and \"xlsb\", defaulting everything else (including \"xlsm\") to the `Xlsx` reader. While xlsm files may parse correctly as xlsx in many cases, this is inconsistent with the explicit handling pattern used for other formats.\n\n<details>\n<summary>🐛 Proposed fix</summary>\n\n```diff\n     if ext.as_str() == \"xls\" {\n         let mut workbook: Xls<_> = Xls::new(cursor)\n             .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n         Ok(extract_blocks_from_workbook(&mut workbook))\n     } else if ext.as_str() == \"xlsb\" {\n         let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n             .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n         Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else if ext.as_str() == \"xlsm\" {\n+        // XLSM is essentially XLSX with macros - use Xlsx reader\n+        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSM: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n     } else {\n         // Default to xlsx format\n         let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n             .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n         Ok(extract_blocks_from_workbook(&mut workbook))\n     }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\nfn parse_spreadsheet_from_bytes(\n    bytes: &[u8],\n    filename: &str,\n) -> Result<Vec<ParsedBlock>, DomainError> {\n    let cursor = std::io::Cursor::new(bytes);\n\n    // Determine format from filename extension\n    let ext = filename.rsplit('.').next().unwrap_or(\"xlsx\").to_lowercase();\n\n    if ext.as_str() == \"xls\" {\n        let mut workbook: Xls<_> = Xls::new(cursor)\n            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n        Ok(extract_blocks_from_workbook(&mut workbook))\n    } else if ext.as_str() == \"xlsb\" {\n        let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n        Ok(extract_blocks_from_workbook(&mut workbook))\n    } else if ext.as_str() == \"xlsm\" {\n        // XLSM is essentially XLSX with macros - use Xlsx reader\n        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSM: {e}\")))?;\n        Ok(extract_blocks_from_workbook(&mut workbook))\n    } else {\n        // Default to xlsx format\n        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n        Ok(extract_blocks_from_workbook(&mut workbook))\n    }\n}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs` around lines 115 - 138,\nparse_spreadsheet_from_bytes currently checks \"xls\" and \"xlsb\" but falls through\nto the generic xlsx branch for \"xlsm\", which is inconsistent with\nsupported_extensions() listing \"xlsm\"; add an explicit branch for ext == \"xlsm\"\nin parse_spreadsheet_from_bytes that constructs an Xlsx reader from the cursor\n(same as the xlsx branch) and calls extract_blocks_from_workbook(&mut workbook),\nmapping errors to DomainError::parse_error with a \"Failed to open XLSM: {e}\"\nmessage so xlsm is handled explicitly and consistently with other formats\nreferenced in supported_extensions().\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-27T08:08:11Z","updated_at":"2026-01-28T11:38:59Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750044","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750044"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2730750044"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730750044/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":115,"start_side":"RIGHT","line":null,"original_line":138,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":138,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731242616","pull_request_review_id":3710277223,"id":2731242616,"node_id":"PRRC_kwDOPaLyBs6iy3R4","diff_hunk":"@@ -0,0 +1,244 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"pptx\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+    
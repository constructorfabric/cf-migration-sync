scripts/ci.py` around lines 520 - 526, In ensure_cargo_fuzz(), the\ninstallation currently uses the default toolchain; change the install invocation\nto run under nightly so cargo-fuzz is installed into the nightly toolchain:\nreplace the run_cmd([\"cargo\", \"install\", \"cargo-fuzz\"]) call with\nrun_cmd([\"cargo\", \"+nightly\", \"install\", \"cargo-fuzz\"]) so that\nensure_cargo_fuzz() consistently checks and installs cargo-fuzz for the nightly\ntoolchain.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 892ac22","created_at":"2026-01-27T14:00:00Z","updated_at":"2026-01-28T08:43:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149991","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149991"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2732149991"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2732149991/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":520,"start_side":"RIGHT","line":null,"original_line":526,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":21,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2737807935","pull_request_review_id":3718129428,"id":2737807935,"node_id":"PRRC_kwDOPaLyBs6jL6I_","diff_hunk":"@@ -97,6 +97,28 @@ make coverage-unit # Run only unit tests with code coverage\n make coverage-e2e # Run only e2e tests with code coverage\n ```\n \n+### 2.4. Run Fuzzing Tests (Recommended)\n+\n+Before submitting changes to parsers or validation logic, run fuzzing:\n+\n+```bash\n+# Quick smoke test (30s per target)\n+make fuzz\n+\n+# Longer test for critical changes (5 minutes per target)\n+python scripts/ci.py fuzz --seconds 300\n+\n+# Target specific component\n+make fuzz-run FUZZ_TARGET=fuzz_odata_filter FUZZ_SECONDS=600\n+```\n+\n+Fuzzing helps catch:\n+- Parser crashes\n+- Performance problems\n+- Edge cases\n+\n+See `fuzz/README.md` for detailed fuzzing documentation.","path":"CONTRIBUTING.md","commit_id":"9ef0561564fdd44fddb3844c7c2f21201ac52940","original_commit_id":"9ef0561564fdd44fddb3844c7c2f21201ac52940","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Example references a disabled fuzz target.**\n\nLine 112 uses `fuzz_odata_filter` as the example, but this target is currently disabled due to a known parser bug (catastrophic backtracking). Consider using an enabled target like `fuzz_odata_cursor` or `fuzz_odata_orderby` to avoid confusing contributors who try this exact command.\n\n```diff\n # Target specific component\n-make fuzz-run FUZZ_TARGET=fuzz_odata_filter FUZZ_SECONDS=600\n+make fuzz-run FUZZ_TARGET=fuzz_odata_cursor FUZZ_SECONDS=600\n```\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n### 2.4. Run Fuzzing Tests (Recommended)\n\nBefore submitting changes to parsers or validation logic, run fuzzing:\n\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@CONTRIBUTING.md` around lines 100 - 120, The example in CONTRIBUTING.md shows\nthe disabled fuzz target fuzz_odata_filter which will confuse contributors;\nupdate the example command to use an enabled target such as fuzz_odata_cursor or\nfuzz_odata_orderby (e.g., replace occurrences of fuzz_odata_filter in the\n\"Target specific component\" example) and add a short parenthetical note\nindicating that fuzz_odata_filter is currently disabled due to a parser bug to\nprevent future confusion.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-28T17:49:38Z","updated_at":"2026-01-28T17:49:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2737807935","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2737807935"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2737807935"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware
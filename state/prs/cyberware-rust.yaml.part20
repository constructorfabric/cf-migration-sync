all\", \"cargo-fuzz\"])\n+\n+    fuzz_seconds = args.seconds or 60\n+    fuzz_cmd = [\n+        \"cargo\", \"+nightly\", \"fuzz\", \"run\", args.target,\n+        \"--\", f\"-max_total_time={fuzz_seconds}\"\n+    ]","path":"scripts/ci.py","commit_id":"9ef0561564fdd44fddb3844c7c2f21201ac52940","original_commit_id":"d882f161185dc52f0478308b057991d31ad2ca99","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Guard against non‑positive `--seconds`.**\n\nPassing `0` or a negative value currently either defaults unexpectedly or yields invalid fuzz args. A simple check avoids confusing runs.\n\n<details>\n<summary>✅ Suggested guard</summary>\n\n```diff\n-    fuzz_seconds = args.seconds or 60\n+    fuzz_seconds = args.seconds or 60\n+    if fuzz_seconds <= 0:\n+        print(\"ERROR: --seconds must be a positive integer\")\n+        sys.exit(1)\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    fuzz_seconds = args.seconds or 60\n    if fuzz_seconds <= 0:\n        print(\"ERROR: --seconds must be a positive integer\")\n        sys.exit(1)\n    fuzz_cmd = [\n        \"cargo\", \"+nightly\", \"fuzz\", \"run\", args.target,\n        \"--\", f\"-max_total_time={fuzz_seconds}\"\n    ]\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@scripts/ci.py` around lines 547 - 551, The fuzz_seconds assignment needs\nvalidation so passing 0 or negative seconds doesn't produce invalid fuzz args;\nupdate the logic around fuzz_seconds (used to build fuzz_cmd) to validate\nargs.seconds: if args.seconds is None use the existing default (60), otherwise\ncoerce to an int and if <= 0 either raise a clear error or clamp to a minimum\n(e.g., 1) and log/warn; then use that validated fuzz_seconds when constructing\nfuzz_cmd to ensure \"-max_total_time\" is always a positive value.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-26T12:24:41Z","updated_at":"2026-01-26T12:24:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2727407974","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727407974"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2727407974"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2727407974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":552,"original_start_line":547,"start_side":"RIGHT","line":559,"original_line":551,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":46,"position":54,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2728085860","pull_request_review_id":3706608366,"id":2728085860,"node_id":"PRRC_kwDOPaLyBs6im0lk","diff_hunk":"@@ -506,6 +506,148 @@ def cmd_dylint_list(_args):\n         run_cmd([\"cargo\", \"dylint\", \"list\", \"--lib-path\", lib], cwd=PROJECT_ROOT)\n \n \n+def ensure_nightly_toolchain():\n+    \"\"\"Ensure Rust nightly toolchain is installed.\"\"\"\n+    result = run_cmd_allow_fail([\"rustup\", \"run\", \"nightly\", \"rustc\", \"--version\"])\n+    if result.returncode != 0:\n+        print(\n+            \"ERROR: Rust nightly toolchain not installed. \"\n+            \"Install with: rustup toolchain install nightly\"\n+        )\n+        sys.exit(1)\n+\n+\n+def ensure_cargo_fuzz():\n+    \"\"\"Ensure cargo-fuzz is installed.\"\"\"\n+    ensure_nightly_toolchain()\n+    result = run_cmd_allow_fail([\"cargo\", \"+nightly\", \"fuzz\", \"--version\"])\n+    if result.returncode != 0:\n+        print(\"Installing cargo-fuzz...\")\n+        run_cmd([\"cargo\", \"install\", \"cargo-fuzz\"])\n+\n+\n+def cmd_fuzz_build(_args):\n+    step(\"Building fuzz targets\")\n+    fuzz_dir = os.path.join(PROJECT_ROOT, \"fuzz\")\n+    ensure_cargo_fuzz()\n+\n+    # Build all fuzz targets (no TARGET argument = build all)\n+    run_cmd([\"cargo\", \"+nightly\", \"fuzz\", \"build\"], cwd=fuzz_dir)\n+    print(\"All fuzz targets built successfully\")\n+\n+\n+def cmd_fuzz_list(_args):\n+    step(\"Listing fuzz targets\")\n+    fuzz_dir = os.path.join(PROJECT_ROOT, \"fuzz\")\n+    ensure_cargo_fuzz()\n+\n+    run_cmd([\"cargo\", \"+nightly\", \"fuzz\", \"list\"], cwd=fuzz_dir)\n+\n+\n+def cmd_fuzz_run(args):\n+    step(f\"Running fuzz target: {args.target}\")\n+    fuzz_dir = os.path.join(PROJECT_ROOT, \"fuzz\")\n+    ensure_cargo_fuzz()\n+\n+    fuzz_seconds = args.seconds or 60\n+    if fuzz_seconds <= 0:\n+        print(\"ERROR: --seconds must be a positive integer\")\n+        sys.exit(1)\n+    fuzz_cmd = [\n+        \"cargo\", \"+nightly\", \"fuzz\", \"run\", args.target,\n+        \"--\", f\"-max_total_time={fuzz_seconds}\"\n+    ]\n+\n+    result = run_cmd_allow_fail(fuzz_cmd, cwd=fuzz_dir)\n+\n+    if result.returncode != 0:\n+        print(f\"Fuzzing found issues. Check fuzz/artifacts/{args.target}/\")\n+        sys.exit(result.returncode)\n+\n+    print(f\"Fuzzing completed successfully ({fuzz_seconds}s)\")\n+\n+\n+def cmd_fuzz(args):\n+    step(\"Running smoke test fuzzing on all targets\")\n+    fuzz_dir = os.path.join(PROJECT_ROOT, \"fuzz\")\n+\n+    # Build all targets first\n+    cmd_fuzz_build(args)\n+\n+    # Get list of targets\n+    result = subprocess.run(\n+        [\"cargo\", \"+nightly\", \"fuzz\", \"list\"],\n+        cwd=fuzz_dir,\n+        capture_output=True,\n+        text=True\n+    )\n+\n+    if result.returncode != 0:\n+        print(\"Failed to list fuzz targets\")\n+        sys.exit(1)\n+\n+    targets = result.stdout.strip().split('\\n')\n+    smoke_time = args.seconds or 30\n+\n+    failed_targets = []\n+\n+    for target in targets:\n+        target = target.strip()\n+        if not target:\n+            continue\n+\n+        print(f\"\\n=== Fuzzing {target} for {smoke_time}s ===\")\n+        fuzz_cmd = [\n+            \"cargo\", \"+nightly\", \"fuzz\", \"run\", target,\n+            \"--\", f\"-max_total_time={smoke_time}\"","path":"scripts/ci.py","commit_id":"9ef0561564fdd44fddb3844c7c2f21201ac52940","original_commit_id":"eac065952000074e1b64ba216b257e5922b1a5e8","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Add validation for `--seconds` consistency with `cmd_fuzz_run`.**\n\nThe `cmd_fuzz_run` function validates that `--seconds` must be positive, but `cmd_fuzz` lacks this check. Passing a negative value (e.g., `--seconds -5`) would bypass the `or 30` fallback and produce invalid fuzz args.\n\n<details>\n<summary>✅ Suggested fix</summary>\n\n```diff\n     smoke_time = args.seconds or 30\n+    if smoke_time <= 0:\n+        print(\"ERROR: --seconds must be a positive integer\")\n+        sys.exit(1)\n\n     failed_targets = []\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    smoke_time = args.seconds or 30\n    if smoke_time <= 0:\n        print(\"ERROR: --seconds must be a positive integer\")\n        sys.exit(1)\n\n    failed_targets = []\n\n    for target in targets:\n        target = target.strip()\n        if not target:\n            continue\n\n        print(f\"\\n=== Fuzzing {target} for {smoke_time}s ===\")\n        fuzz_cmd = [\n            \"cargo\", \"+nightly\", \"fuzz\", \"run\", target,\n            \"--\", f\"-max_total_time={smoke_time}\"\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@scripts/ci.py` around lines 590 - 602, The smoke_time calculation in cmd_fuzz\n(smoke_time = args.seconds or 30) can accept negative values because cmd_fuzz\nlacks the positive-seconds validation present in cmd_fuzz_run; update cmd_fuzz\nto validate args.seconds is None or a positive integer (e.g., if args.seconds is\nnot None and args.seconds <= 0: raise/exit with an error), then set smoke_time\nusing the validated value (smoke_time = args.seconds if args.seconds is not None\nelse 30) so negative values cannot produce invalid fuzz arguments.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-26T15:31:24Z","updated_at":"2026-01-26T15:31:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2728085860","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2728085860"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/301#discussion_r2728085860"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/301"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2728085860/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":590,"original_start_line":590,"
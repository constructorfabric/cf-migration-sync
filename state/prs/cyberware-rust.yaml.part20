ath_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_pptx_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let config = ParserConfig::builder()\n+        .extract_images(false)\n+        .include_slide_comment(false)\n+        .build();\n+\n+    let mut container = PptxContainer::open(path, config)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open PPTX: {e}\")))?;\n+\n+    let slides = container\n+        .parse_all()\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse PPTX slides: {e}\")))?;\n+\n+    Ok(extract_blocks_from_slides(&slides))\n+}\n+\n+fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n+    // pptx-to-md requires a file path, so we need to use a temp file\n+    let mut temp_file = tempfile::NamedTempFile::new()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n+\n+    std::io::Write::write_all(&mut temp_file, bytes)\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to write to temp file: {e}\")))?;\n+\n+    parse_pptx_from_path(temp_file.path())\n+}\n+\n+fn extract_blocks_from_slides(slides: &[pptx_to_md::Slide]) -> Vec<ParsedBlock> {\n+    let mut blocks = Vec::new();\n+\n+    for (slide_idx, slide) in slides.iter().enumerate() {\n+        // Add slide separator as heading\n+        blocks.push(ParsedBlock::Heading {\n+            level: 2,\n+            #[allow(clippy::arithmetic_side_effects)]\n+            inlines: vec![Inline::plain(format!(\"Slide {}\", slide_idx + 1))],\n+        });\n+\n+        // Process slide elements\n+        for element in &slide.elements {\n+            match element {\n+                SlideElement::Text(text, _pos) => {\n+                    let content: String = text\n+                        .runs\n+                        .iter()\n+                        .map(|run| run.text.as_str())\n+                        .collect::<Vec<_>>()\n+                        .join(\"\");\n+                    if !content.trim().is_empty() {\n+                        blocks.push(ParsedBlock::Paragraph {\n+                            inlines: vec![Inline::plain(content.trim())],\n+                        });\n+                    }\n+                }\n+                SlideElement::Table(table, _pos) => {\n+                    if let Some(table_block) = convert_pptx_table(table) {\n+                        blocks.push(table_block);\n+                    }\n+                }\n+                SlideElement::List(list, _pos) => {\n+                    blocks.extend(convert_pptx_list(list));\n+                }\n+                SlideElement::Image(..) | SlideElement::Unknown => {\n+                    // Skip images and unknown elements - focused on text extraction\n+                }\n+            }\n+        }\n+\n+        // Add page break between slides (except after last slide)\n+        #[allow(clippy::arithmetic_side_effects)]\n+        if slide_idx < slides.len() - 1 {","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"same, no allow, saturated substraction","created_at":"2026-01-27T10:13:23Z","updated_at":"2026-01-27T10:23:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731253515","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731253515"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731253515"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731253515/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":210,"original_line":164,"side":"RIGHT","author_association":"MEMBER","original_position":164,"position":210,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731262637","pull_request_review_id":3710277223,"id":2731262637,"node_id":"PRRC_kwDOPaLyBs6iy8Kt","diff_hunk":"@@ -0,0 +1,244 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"pptx\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_bytes(&bytes)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.pptx\").to_owned(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\n+                \"application/vnd.openxmlformats-officedocument.presentationml.presentation\",\n+            )\n+            .blocks(blocks);\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_pptx_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let config = ParserConfig::builder()\n+        .extract_images(false)\n+        .include_slide_comment(false)\n+        .build();\n+\n+    let mut container = PptxContainer::open(path, config)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open PPTX: {e}\")))?;\n+\n+    let slides = container\n+        .parse_all()\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse PPTX slides: {e}\")))?;\n+\n+    Ok(extract_blocks_from_slides(&slides))\n+}\n+\n+fn parse_pptx_from_bytes(bytes: &[u8]) -> Result<Vec<ParsedBlock>, DomainError> {\n+    // pptx-to-md requires a file path, so we need to use a temp file\n+    let mut temp_file = tempfile::NamedTempFile::new()\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to create temp file: {e}\")))?;\n+\n+    std::io::Write::write_all(&mut temp_file, bytes)\n+        .map_err(|e| DomainError::io_error(format!(\"Failed to write to temp file: {e}\")))?;\n+\n+    parse_pptx_from_path(temp_file.path())\n+}\n+\n+fn extract_blocks_from_slides(slides: &[pptx_to_md::Slide]) -> Vec<ParsedBlock> {\n+    let mut blocks = Vec::new();\n+\n+    for (slide_idx, slide) in slides.iter().enumerate() {\n+        // Add slide separator as heading\n+        blocks.push(ParsedBlock::Heading {\n+            level: 2,\n+            #[allow(clippy::arithmetic_side_effects)]\n+            inlines: vec![Inline::plain(format!(\"Slide {}\", slide_idx + 1))],\n+        });\n+\n+        // Process slide elements\n+        for element in &slide.elements {\n+            match element {\n+                SlideElement::Text(text, _pos) => {\n+                    let content: String = text\n+                        .runs\n+                        .iter()\n+                        .map(|run| run.text.as_str())\n+                        .collect::<Vec<_>>()\n+                        .join(\"\");\n+                    if !content.trim().is_empty() {\n+                        blocks.push(ParsedBlock::Paragraph {\n+                            inlines: vec![Inline::plain(content.trim())],\n+                        });\n+                    }\n+                }\n+                SlideElement::Table(table, _pos) => {\n+                    if let Some(table_block) = convert_pptx_table(table) {\n+                        blocks.push(table_block);\n+                    }\n+                }\n+                SlideElement::List(list, _pos) => {\n+                    blocks.extend(convert_pptx_list(list));\n+                }\n+                SlideElement::Image(..) | SlideElement::Unknown => {\n+                    // Skip images and unknown elements - focused on text extraction\n+                }\n+            }\n+        }\n+\n+        // Add page break between slides (except after last slide)\n+        #[allow(clippy::arithmetic_side_effects)]\n+        if slide_idx < slides.len() - 1 {\n+            blocks.push(ParsedBlock::PageBreak);\n+        }\n+    }\n+\n+    blocks\n+}\n+\n+fn convert_pptx_table(table: &TableElement) -> Option<ParsedBlock> {\n+    if table.rows.is_empty() {\n+        return None;\n+    }\n+\n+    let mut rows = Vec::with_capacity(table.rows.len());\n+\n+    for (row_idx, row) in table.rows.iter().enumerate() {\n+        let is_header = row_idx == 0;\n+        let mut cells = Vec::with_capacity(row.cells.len());\n+\n+        for cell in &row.cells {\n+            let cell_text: String = cell\n+                .runs\n+                .iter()\n+                .map(|run| run.text.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"\");\n+            cells.push(TableCell {\n+                blocks: vec![ParsedBlock::Paragraph {\n+                    inlines: vec![Inline::plain(cell_text.trim())],\n+                }],\n+            });\n+        }\n+\n+        rows.push(TableRow { is_header, cells });\n+    }\n+\n+    Some(ParsedBlock::Table(TableBlock { rows }))\n+}\n+\n+fn convert_pptx_list(list: &ListElement) -> Vec<ParsedBlock> {\n+    let mut blocks = Vec::new();\n+\n+    for item in &list.items {\n+        // Extract text from runs\n+        let text: String = item\n+            .runs\n+            .iter()\n+            .map(|run| run.text.as_str())\n+            .collect::<Vec<_>>()\n+            .join(\"\");\n+\n+        if !text.trim().is_empty() {","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not sure about this transformation, do the trim per iteration before. You are doing it twice","created_at":"2026-01-27T10:15:29Z","updated_at":"2026-01-27T10:23:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731262637","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731262637"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/
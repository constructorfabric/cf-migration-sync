        match self {\n+            Self::Xls => \"xls\",\n+            Self::Xlsx => \"xlsx\",\n+            Self::Xlsm => \"xlsm\",\n+            Self::Xlsb => \"xlsb\",\n+        }\n+    }\n+    /// Determine format from filename extension (used as hint for MIME type)\n+    /// Returns an error if the extension is not a recognized Excel format\n+    pub fn from_filename(filename: &str) -> Result<Self, DomainError> {\n+        let ext = Path::new(filename).extension().and_then(|os| os.to_str());\n+\n+        if let Some(ext) = ext {\n+            return Ok(ExcelFormat::from(ext));\n+        }\n+\n+        Err(DomainError::parse_error(format!(\n+            \"Unrecognized Excel file extension: '{filename}'\"\n+        )))\n+    }\n+\n+    /// Detect format from file magic bytes\n+    /// Returns None if the bytes don't match any known Excel format\n+    #[must_use]\n+    pub fn from_magic_bytes(bytes: &[u8]) -> Option<Self> {\n+        if bytes.len() < 4 {\n+            return None;\n+        }\n+\n+        let magic: [u8; 4] = [bytes[0], bytes[1], bytes[2], bytes[3]];\n+\n+        if magic == OLE_MAGIC {\n+            // OLE format = legacy XLS\n+            Some(Self::Xls)\n+        } else if magic == ZIP_MAGIC {\n+            // ZIP-based format (xlsx, xlsm, or xlsb)\n+            // All three share the same magic bytes; we'll try parsers in order\n+            Some(Self::Xlsx)\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Get the MIME type for this format\n+    #[must_use]\n+    pub const fn mime_type(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"application/vnd.ms-excel\",\n+            Self::Xlsx => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+            Self::Xlsm => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+            Self::Xlsb => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        }\n+    }\n+\n+    /// Get all supported file extensions\n+    #[must_use]\n+    pub const fn all_extensions() -> &'static [&'static str] {\n+        const EXTENSIONS: &[&str] = &[\n+            ExcelFormat::Xlsx.as_str(),\n+            ExcelFormat::Xls.as_str(),\n+            ExcelFormat::Xlsm.as_str(),\n+            ExcelFormat::Xls.as_str(),\n+        ];\n+        EXTENSIONS\n+    }","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"430507b579433131ee5a2a385ce678500c9a370e","original_commit_id":"88e3df0b780006ef504ea9a2e8184cb98b04b3db","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"??","created_at":"2026-01-29T10:32:13Z","updated_at":"2026-01-29T10:32:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2740979095","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740979095"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2740979095"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740979095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":95,"start_side":"RIGHT","line":null,"original_line":102,"side":"RIGHT","in_reply_to_id":2737741801,"author_association":"MEMBER","original_position":102,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741712105","pull_request_review_id":3722801579,"id":2741712105,"node_id":"PRRC_kwDOPaLyBs6jazTp","diff_hunk":"@@ -0,0 +1,309 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+/// File extension constants\n+const EXT_PPTX: &str = \"pptx\";\n+\n+/// Supported file extensions for `PowerPoint`\n+const SUPPORTED_EXTENSIONS: &[&str] = &[EXT_PPTX];\n+\n+/// MIME type constants\n+const MIME_TYPE_PPTX: &str =\n+    \"application/vnd.openxmlformats-officedocument.presentationml.presentation\";\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Determine MIME type from filename or provided content type\n+    fn determine_mime_type(\n+        filename_hint: Option<&str>,\n+        content_type: Option<&str>,\n+    ) -> Result<String, DomainError> {\n+        // Priority 1: Use provided content-type if it's PPTX\n+        if let Some(ct) = content_type\n+            && ct == MIME_TYPE_PPTX\n+        {\n+            return Ok(ct.to_owned());\n+        }\n+\n+        // Priority 2: Infer from filename extension\n+        if let Some(filename) = filename_hint\n+            && let Some(ext) = Path::new(filename).extension().and_then(|s| s.to_str())\n+            && ext.to_lowercase() == EXT_PPTX\n+        {\n+            return Ok(MIME_TYPE_PPTX.to_owned());\n+        }\n+\n+        Err(DomainError::unsupported_file_type(\n+            \"Unable to determine PowerPoint format\",\n+        ))\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"5d43345029f496685d973ca3d818326136641cf1","original_commit_id":"5d43345029f496685d973ca3d818326136641cf1","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"use the const reference here also","created_at":"2026-01-29T13:40:49Z","updated_at":"2026-01-29T13:45:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741712105","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741712105"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741712105"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741712105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":65,"side":"RIGHT","author_association":"MEMBER","original_position":65,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741717768","pull_request_review_id":3722801579,"id":2741717768,"node_id":"PRRC_kwDOPaLyBs6ja0sI","diff_hunk":"@@ -0,0 +1,309 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+/// File extension constants\n+const EXT_PPTX: &str = \"pptx\";\n+\n+/// Supported file extensions for `PowerPoint`\n+const SUPPORTED_EXTENSIONS: &[&str] = &[EXT_PPTX];\n+\n+/// MIME type constants\n+const MIME_TYPE_PPTX: &str =\n+    \"application/vnd.openxmlformats-officedocument.presentationml.presentation\";\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Determine MIME type from filename or provided content type\n+    fn determine_mime_type(\n+        filename_hint: Option<&str>,\n+        content_type: Option<&str>,\n+    ) -> Result<String, DomainError> {\n+        // Priority 1: Use provided content-type if it's PPTX\n+        if let Some(ct) = content_type\n+            && ct == MIME_TYPE_PPTX\n+        {\n+            return Ok(ct.to_owned());\n+        }\n+\n+        // Priority 2: Infer from filename extension\n+        if let Some(filename) = filename_hint\n+            && let Some(ext) = Path::new(filename).extension().and_then(|s| s.to_str())\n+            && ext.to_lowercase() == EXT_PPTX\n+        {\n+            return Ok(MIME_TYPE_PPTX.to_owned());\n+        }\n+\n+        Err(DomainError::unsupported_file_type(\n+            \"Unable to determine PowerPoint format\",\n+        ))\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        SUPPORTED_EXTENSIONS\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        tracing::debug!(path = %path.display(), \"Parsing PPTX from local path\");\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let filename = path.file_name().and_then(|s| s.to_str());\n+        let content_type =\n+            Self::determine_mime_type(filename, None).unwrap_or_else(|_| MIME_TYPE_PPTX.to_owned());","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"5d43345029f496685d973ca3d818326136641cf1","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why if we can't detect a pptx we default to a pptx?","created_at":"2026-01-29T13:42:14Z","updated_at":"2026-01-29T13:45:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741717768","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741717768"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741717768"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741717768/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":88,"original_line":88,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":88,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741728381","pull_request_review_id":3722801579,"id":2741728381,"node_id":"PRRC_kwDOPaLyBs6ja3R9","diff_hunk":"@@ -0,0 +1,390 @@\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+/// File extension constants\n+const EXT_XLS: &str = \"xls\";\n+const EXT_XLSX: &str = \"xlsx\";\n+const EXT_XLSM: &str = \"xlsm\";\n+const EXT_XLSB: &str = \"xlsb\";\n+\n+/// Supported file extensions for Excel formats\n+const SUPPORTED_EXTENSIONS: &[&str] = &[EXT_XLSX, EXT_XLS, EXT_XLSM, EXT_XLSB];\n+\n+/// MIME type constants\n+const MIME_TYPE_XLS: &str = \"application/vnd.ms-excel\";\n+const MIME_TYPE_XLSX: &str = \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\";\n+const MIME_TYPE_XLSM: &str = \"application/vnd.ms-excel.sheet.macroEnabled.12\";\n+const MIME_TYPE_XLSB: &str = \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\";\n+\n+/// Default MIME type for Excel files\n+const DEFAULT_MIME_TYPE: &str = MIME_TYPE_XLSX;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Determine MIME type from file extension\n+    fn mime_type_from_extension(extension: &str) -> Option<&'static str> {\n+        match extension.to_lowercase().as_str() {\n+            EXT_XLS => Some(MIME_TYPE_XLS),\n+            EXT_XLSX => Some(MIME_TYPE_XLSX),\n+            EXT_XLSM => Some(MIME_TYPE_XLSM),\n+            EXT_XLSB => Some(MIME_TYPE_XLSB),\n+            _ => None,\n+        }\n+    }\n+\n+    /// Determine MIME type from filename or provided content type\n+    fn determine_mime_type(\n+        filename_hint: Option<&str>,\n+        content_type: Option<&str>,\n+    ) -> Result<String, DomainError> {\n+        // Priority 1: Use provided content-type if it matches an Excel type\n+        if let Some(ct) = content_type {\n+            let is_excel_type = matches!(\n+                ct,\n+                MIME_TYPE_XLS | MIME_TYPE_XLSX | MIME_TYPE_XLSM | MIME_TYPE_XLSB\n+            );\n+            if is_excel_type {\n+                return Ok(ct.to_owned());\n+            }\n+        }\n+\n+        // Priority 2: Infer from filename extension\n+        if let Some(filename) = filename_hint\n+            && let Some(ext) = Path::new(filename).extension().and_then(|s| s.to_str())\n+            && let Some(mime) = Self::mime_type_from_extension(ext)\n+        {\n+            return Ok(mime.to_owned());\n+        }\n+\n+        Err(DomainError::unsupported_file_type(\n+            \"Unable to determine Excel format\",\n+        ))\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"5d43345029f496685d973ca3d818326136641cf1","original_commit_id":"5d43345029f496685d973ca3d818326136641cf1","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"use the const reference here also","created_at":"2026-01-29T13:44:40Z","updated_at":"2026-01-29T13:45:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741728381","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741728381"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741728381"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741728381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":87,"side":"RIGHT","author_association":"MEMBER","original_position":87,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741880011","pull_request_review_id":3723014376,"id":2741880011,"node_id":"PRRC_kwDOPaLyBs6jbcTL","diff_hunk":"@@ -0,0 +1,309 @@\n+use async_trait::async_trait;\n+use pptx_to_md::{ListElement, ParserConfig, PptxContainer, SlideElement, TableElement};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// PPTX parser that extracts text from `PowerPoint` presentations using `pptx-to-md`\n+pub struct PptxParser;\n+\n+/// File extension constants\n+const EXT_PPTX: &str = \"pptx\";\n+\n+/// Supported file extensions for `PowerPoint`\n+const SUPPORTED_EXTENSIONS: &[&str] = &[EXT_PPTX];\n+\n+/// MIME type constants\n+const MIME_TYPE_PPTX: &str =\n+    \"application/vnd.openxmlformats-officedocument.presentationml.presentation\";\n+\n+impl PptxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Determine MIME type from filename or provided content type\n+    fn determine_mime_type(\n+        filename_hint: Option<&str>,\n+        content_type: Option<&str>,\n+    ) -> Result<String, DomainError> {\n+        // Priority 1: Use provided content-type if it's PPTX\n+        if let Some(ct) = content_type\n+            && ct == MIME_TYPE_PPTX\n+        {\n+            return Ok(ct.to_owned());\n+        }\n+\n+        // Priority 2: Infer from filename extension\n+        if let Some(filename) = filename_hint\n+            && let Some(ext) = Path::new(filename).extension().and_then(|s| s.to_str())\n+            && ext.to_lowercase() == EXT_PPTX\n+        {\n+            return Ok(MIME_TYPE_PPTX.to_owned());\n+        }\n+\n+        Err(DomainError::unsupported_file_type(\n+            \"Unable to determine PowerPoint format\",\n+        ))\n+    }\n+}\n+\n+impl Default for PptxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for PptxParser {\n+    fn id(&self) -> &'static str {\n+        \"pptx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        SUPPORTED_EXTENSIONS\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        tracing::debug!(path = %path.display(), \"Parsing PPTX from local path\");\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_pptx_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let filename = path.file_name().and_then(|s| s.to_str());\n+        let content_type =\n+            Self::determine_mime_type(filename, None).unwrap_or_else(|_| MIME_TYPE_PPTX.to_owned());","path":"modules/file_parser/src/infra/parsers/pptx_parser.rs","commit_id":"9bd35dcfa89ab9e5b9fbf6b2e161f61eb46294b5","original_commit_id":"5d43345029f496685d973ca3d818326136641cf1","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Because the router already chose this PPTX parser, a missing/unknown extension shouldn’t reject the file—defaulting to the PPTX MIME lets parsing proceed instead of failing on a harmless detection miss.","created_at":"2026-01-29T14:17:29Z","updated_at":"2026-01-29T14:17:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741880011","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741880011"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2741880011"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2741880011/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":88,"original_line":88,"side":"RIGHT","in_reply_to_id":2741717768,"author_association":"MEMBER","original_position":88,"position":88,"subject_type":"line"}],"source_reviews":[{"id":3709681393,"node_id":"PRR_kwDOPaLyBs7dHT7x","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 3**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/pptx_parser.rs`:\n- Around line 110-119: In parse_pptx_from_bytes, flush the NamedTempFile after\nwriting bytes and before calling parse_pptx_from_path to ensure data is\ncommitted; call temp_file.flush() (or std::io::Write::flush(&mut temp_file)) and\nmap any error to DomainError::io_error similar to the existing write error\nhandling, then pass temp_file.path() to parse_pptx_from_path as before.\n\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs`:\n- Around line 115-138: parse_spreadsheet_from_bytes currently checks \"xls\" and\n\"xlsb\" but falls through to the generic xlsx branch for \"xlsm\", which is\ninconsistent with supported_extensions() listing \"xlsm\"; add an explicit branch\nfor ext == \"xlsm\" in parse_spreadsheet_from_bytes that constructs an Xlsx reader\nfrom the cursor (same as the xlsx branch) and calls\nextract_blocks_from_workbook(&mut workbook), mapping errors to\nDomainError::parse_error with a \"Failed to open XLSM: {e}\" message so xlsm is\nhandled explicitly and consistently with other formats referenced in\nsupported_extensions().\n- Around line 83-87: parse_bytes currently only checks for \".xls\" and defaults\neverything else to the OpenXML MIME, causing .xlsm and .xlsb to be mis-typed;\nupdate parse_bytes to use the same logic as determine_content_type used by\nparse_local_path by either refactoring determine_content_type to accept a &str\nfilename or adding a helper like determine_content_type_from_filename that\nreturns the correct MIME for \".xls\", \".xlsm\", \".xlsb\", and the default \".xlsx\",\nthen call that helper from parse_bytes (use the existing filename variable\npassed into parse_bytes) so MIME detection is consistent across parse_bytes and\nparse_local_path.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (4)</summary><blockquote>\n\n<details>\n<summary>modules/file_parser/tests/xlsx_parser_tests.rs (2)</summary><blockquote>\n\n`34-37`: **Silent test skipping could mask CI failures.**\n\nThe pattern of silently skipping tests when test data files are missing means the test suite will pass even if the test data generation hasn't been run. This could hide missing test coverage in CI pipelines.\n\nConsider using `#[ignore]` attribute with a clear reason, or assert that the files exist and fail explicitly if CI should have generated them.\n\n<details>\n<summary>♻️ Suggested approach</summary>\n\n```diff\n+#[tokio::test]\n+async fn test_xlsx_parser_with_simple_file() {\n+    let parser = XlsxParser::new();\n     let test_file = get_test_file_path(\"simple_data.xlsx\");\n \n-    if !test_file.exists() {\n-        eprintln!(\"Skipping test: test file not found at {test_file:?}\");\n-        return;\n-    }\n+    assert!(\n+        test_file.exists(),\n+        \"Test file not found at {test_file:?}. Run `python testing/e2e/testdata/generate_xlsx_pptx_testdata.py` to generate test data.\"\n+    );\n```\n\nAlternatively, use a CI environment variable check:\n```rust\nif !test_file.exists() {\n    if std::env::var(\"CI\").is_ok() {\n        panic!(\"Test file not found in CI: {test_file:?}\");\n    }\n    eprintln!(\"Skipping test: test file not found at {test_file:?}\");\n    return;\n}\n```\n</details>\n\n\nAlso applies to: 67-70, 123-126, 185-188\n\n---\n\n`145-161`: **Extension-specific error message assertion may be fragile.**\n\nThe test asserts that the error message contains \"XLS\" or \"xls\", but this depends on the calamine library's error message formatting which could change between versions.\n\n\nConsider whether simply asserting `result.is_err()` is sufficient, or document this as a behavior contract that should be verified if calamine is upgraded.\n\n</blockquote></details>\n<details>\n<summary>modules/file_parser/src/infra/parsers/xlsx_parser.rs (1)</summary><blockquote>\n\n`205-214`: **Float-to-integer conversion could produce incorrect results for extreme values.**\n\nThe cast `*f as i64` can silently produce incorrect results for floats outside the i64 range (approximately ±9.2×10¹⁸). While Excel's precision limits make this unlikely in practice, the behavior is undefined/implementation-specific for such values.\n\n\nConsider using a saturating conversion or returning the float representation for out-of-range values:\n```rust\nif f.fract() == 0.0 && *f >= i64::MIN as f64 && *f <= i64::MAX as f64 {\n    format!(\"{}\", *f as i64)\n} else {\n    format!(\"{f}\")\n}\n```\n\n</blockquote></details>\n<details>\n<summary>testing/e2e/testdata/generate_xlsx_pptx_testdata.py (1)</summary><blockquote>\n\n`12-24`: **Minor: Use `sys.exit()` instead of bare `exit()`.**\n\nThe `exit()` built-in is intended for interactive use. For scripts, `sys.exit()` is the conventional choice and behaves more predictably in all contexts.\n\n<details>\n<summary>♻️ Suggested fix</summary>\n\n```diff\n+import sys\n import os\n from pathlib import Path\n \n try:\n     from openpyxl import Workbook\n     from openpyxl.styles import Font\n except ImportError:\n     print(\"Please install openpyxl: pip install openpyxl\")\n-    exit(1)\n+    sys.exit(1)\n \n try:\n     from pptx import Presentation\n     from pptx.util import Inches, Pt\n except ImportError:\n     print(\"Please install python-pptx: pip install python-pptx\")\n-    exit(1)\n+    sys.exit(1)\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3709681393","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3709681393"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"submitted_at":"2026-01-27T08:08:12Z","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a"},{"id":3716170888,"node_id":"PRR_kwDOPaLyBs7dgESI","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 2**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs`:\n- Around line 163-193: Detect the Excel format from the actual file bytes first\nusing ExcelFormat::from_magic_bytes(bytes.as_ref()) and only fall back to\nExcelFormat::from_filename(&filename) when that returns None; then use the\nresulting format for content_type (format.mime_type()) and any other\nformat-dependent behavior. Update parse_bytes (and the local filename/default\nlogic remains) to call from_magic_bytes with the bytes slice, assign let format\n= magic_format.unwrap_or_else(|| ExcelFormat::from_filename(&filename)), and\nproceed to set content_type and build the DocumentBuilder from that format.\n\nIn `@testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py`:\n- Around line 12-42: The upload tests test_xlsx_upload_simple,\ntest_xlsx_upload_multisheet, test_pptx_upload_simple, and\ntest_pptx_upload_multislide should guard against running without credentials:\nbefore asserting response.status_code, check whether auth is configured (e.g.\nverify auth_headers is present or os.environ.get(\"E2E_AUTH_TOKEN\") is set) and\ncall pytest.skip(...) if not, so the test will skip instead of failing on\n401/403; add this short auth existence check at the start of each test (using\nthe existing auth_headers parameter) immediately before the HTTP\nrequest/response status assertion.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>modules/file_parser/tests/pptx_parser_tests.rs (1)</summary><blockquote>\n\n`31-34`: **Consider making test data presence explicit in CI.**\n\nThe skip pattern when test files don't exist is convenient for local development, but in CI environments, missing test data could cause tests to silently pass without actually validating anything. Consider either:\n1. Committing the generated test files to the repository, or\n2. Adding a CI step to generate test data before running tests, or\n3. Using `#[cfg_attr(not(feature = \"skip_missing_testdata\"), should_panic)]` to fail explicitly when data is expected\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3716170888","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3716170888"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"submitted_at":"2026-01-28T11:25:48Z","commit_id":"8789539b6c8231d5e8b1d8fbc9632030b43189ae"},{"id":3718052235,"node_id":"PRR_kwDOPaLyBs7dnPmL","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 3**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/file_parser/src/infra/parsers/xlsx_parser.rs`:\n- Around line 92-102: The all_extensions() function currently lists\nExcelFormat::Xls twice which omits the Xlsb entry; update the EXTENSIONS array\ninside all_extensions() to replace the second ExcelFormat::Xls.as_str() with\nExcelFormat::Xlsb.as_str() so the returned slice becomes\n[\"xlsx\",\"xls\",\"xlsm\",\"xlsb\"] and matches the test expectations.\n- Around line 29-57: The problem is a circular/incorrect mapping: the impl\nFrom<&str> for ExcelFormat delegates to from_filename which treats the entire\ninput as a filepath and then calls ExcelFormat::from(ext), causing bare\nextension strings like \"xls\" to be misdetected; fix by separating concerns:\nchange From<&str> for ExcelFormat to directly match common extension strings\n(\"xls\",\"xlsx\",\"xlsm\",\"xlsb\") and return the corresponding variant (i.e.,\nimplement direct mapping in the From<&str> impl), and modify\nfrom_filename(filename: &str) to only extract the Path::extension() and then\ncall ExcelFormat::from(the_ext_str) (or .into()) so filenames and extensions use\nthe proper conversion without recursion; update references to\nExcelFormat::from(ext) to rely on the direct From<&str> mapping.\n\nIn `@testing/e2e/testdata/generate_xlsx_pptx_testdata.py`:\n- Around line 192-231: Add the missing XLSX test files by implementing\ncreate_xlsx_merged_cells() and create_xlsx_formula_cells() functions and\ninvoking them from main(): create_xlsx_merged_cells() should produce a Workbook\nwith a sheet (e.g., \"MergedCells\") containing merged range A1:B1 with a header\nand a few data rows, and create_xlsx_formula_cells() should produce a Workbook\n(e.g., \"Formulas\") with numeric cells A1/A2 and a formula in A3 (e.g.,\n'=SUM(A1:A2)'). Then in main() save their workbooks as \"merged_cells.xlsx\" and\n\"formula_cells.xlsx\" into the xlsx_dir so the Rust xlsx_parser_tests referencing\nthose filenames find the test files.\n```\n\n</details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3718052235","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#pullrequestreview-3718052235"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"submitted_at":"2026-01-28T17:31:00Z","commit_id":"88e3df0b780006ef504ea9a2e8184cb98b04b3db"}]},{"source_pr_number":318,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/318","source_state":"closed","source_author":"github-actions[bot]","t
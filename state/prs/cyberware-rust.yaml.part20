ailto,\n+    Other,\n+}\n+\n+/// Represents a broken link error\n+#[derive(Debug, Clone, Serialize)]\n+pub struct LinkError {\n+    pub file: PathBuf,\n+    pub line: usize,\n+    pub column: usize,\n+    pub link_text: String,\n+    pub link_url: String,\n+    pub error: String,\n+}\n+\n+/// Result of link checking\n+#[derive(Debug, Default)]\n+pub struct LinkCheckResult {\n+    pub errors: Vec<LinkError>,\n+    pub files_scanned: usize,\n+    pub links_checked: usize,\n+}\n+\n+impl LinkCheckResult {\n+    #[must_use]\n+    pub fn new(files_scanned: usize) -> Self {\n+        Self {\n+            errors: Vec::new(),\n+            files_scanned,\n+            links_checked: 0,\n+        }\n+    }\n+\n+    pub fn add_error(&mut self, error: LinkError) {\n+        self.errors.push(error);\n+    }\n+\n+    #[must_use]\n+    pub fn is_ok(&self) -> bool {\n+        self.errors.is_empty()\n+    }\n+}\n+\n+/// Extract all Markdown links from content\n+/// Supports:\n+/// - [text](url)\n+/// - [text](url \"title\")\n+/// - <url>\n+#[must_use]\n+pub fn extract_markdown_links(content: &str) -> Vec<MarkdownLink> {\n+    let mut links = Vec::new();\n+\n+    // Pattern for [text](url) or [text](url \"title\")\n+    let link_pattern = Regex::new(r\"\\[([^\\]]+)\\]\\(([^\\)]+)\\)\").expect(\"Invalid regex\");\n+\n+    // Pattern for <url>\n+    let autolink_pattern = Regex::new(r\"<(https?://[^>]+)>\").expect(\"Invalid regex\");\n+\n+    let content_lines: Vec<&str> = content.lines().collect();\n+\n+    for (line_idx, line) in content_lines.iter().enumerate() {\n+        let line_num = line_idx + 1;\n+\n+        // Extract [text](url) style links\n+        for cap in link_pattern.captures_iter(line) {\n+            if let (Some(text_match), Some(url_match)) = (cap.get(1), cap.get(2)) {\n+                let text = text_match.as_str().to_owned();\n+                let url_full = url_match.as_str();\n+\n+                // Remove optional title from URL (e.g., \"url \"title\"\" -> \"url\")\n+                let url = url_full\n+                    .split_whitespace()\n+                    .next()\n+                    .unwrap_or(url_full)\n+                    .trim_matches('\"')\n+                    .to_owned();\n+\n+                links.push(MarkdownLink {\n+                    text,\n+                    url,\n+                    line: line_num,\n+                    column: url_match.start() + 1,\n+                });\n+            }\n+        }\n+\n+        // Extract <url> style autolinks\n+        for cap in autolink_pattern.captures_iter(line) {\n+            if let Some(url_match) = cap.get(1) {\n+                let url = url_match.as_str().to_owned();\n+                links.push(MarkdownLink {\n+                    text: url.clone(),\n+                    url,\n+                    line: line_num,\n+                    column: url_match.start() + 1,\n+                });\n+            }\n+        }\n+    }\n+\n+    links\n+}\n+\n+/// Determine the type of a link\n+#[must_use]\n+pub fn classify_link(url: &str) -> LinkType {\n+    if url.starts_with(\"http://\") {\n+        LinkType::Http\n+    } else if url.starts_with(\"https://\") {\n+        LinkType::Https\n+    } else if url.starts_with(\"mailto:\") {\n+        LinkType::Mailto\n+    } else if url.starts_with('#') {\n+        LinkType::LocalAnchor\n+    } else if url.starts_with(\"ftp://\") || url.starts_with(\"file://\") {\n+        LinkType::Other\n+    } else {\n+        LinkType::LocalFile\n+    }\n+}\n+\n+/// Extract headings from Markdown content for anchor validation\n+#[must_use]\n+pub fn extract_headings(content: &str) -> HashSet<String> {\n+    let mut headings = HashSet::new();\n+    let heading_pattern = Regex::new(r\"^#{1,6}\\s+(.+)$\").expect(\"Invalid regex\");\n+\n+    for line in content.lines() {\n+        if let Some(heading_match) = heading_pattern.captures(line).and_then(|cap| cap.get(1)) {\n+            let heading = heading_match.as_str().trim();\n+            // Convert to anchor format: lowercase, replace spaces with hyphens\n+            let anchor = heading\n+                .to_lowercase()\n+                .replace(' ', \"-\")\n+                .chars()\n+                .filter(|c| c.is_alphanumeric() || *c == '-' || *c == '_')\n+                .collect::<String>();\n+            headings.insert(format!(\"#{anchor}\"));\n+        }\n+    }\n+\n+    headings\n+}\n+\n+/// Check if a local file link is valid\n+pub fn check_local_file_link(base_path: &Path, link_url: &str) -> Result<(), String> {\n+    // Split anchor from path\n+    let (file_path, anchor) = if let Some(pos) = link_url.find('#') {\n+        (&link_url[..pos], Some(&link_url[pos..]))\n+    } else {\n+        (link_url, None)\n+    };\n+\n+    // Resolve relative path\n+    let full_path = if file_path.is_empty() {\n+        // Just an anchor reference to current file\n+        base_path.to_path_buf()\n+    } else {\n+        let parent = base_path.parent().unwrap_or(base_path);\n+        parent.join(file_path)\n+    };\n+\n+    // Check if path exists (file or directory)\n+    if !full_path.exists() {\n+        return Err(format!(\"Path not found: {}\", full_path.display()));\n+    }\n+\n+    // If it's a directory, that's valid (directory links are allowed)\n+    if full_path.is_dir() {\n+        // Optionally check if directory contains a README.md\n+        let readme_path = full_path.join(\"README.md\");\n+        if !readme_path.exists() {\n+            // Just a warning in verbose mode, not an error\n+            // Directory links without README are still valid\n+        }\n+        return Ok(());\n+    }\n+\n+    // If it's a file, validate it exists (already checked above)\n+    // If there's an anchor, validate it exists in the target file\n+    if let Some(anchor_ref) = anchor\n+        && full_path.extension().and_then(|e| e.to_str()) == Some(\"md\")\n+    {\n+        if let Ok(content) = fs::read_to_string(&full_path) {\n+            let headings = extract_headings(&content);\n+            if !headings.contains(anchor_ref) {\n+                return Err(\n+                        \"Anchor '{}' not found in {}\",\n+                        anchor_ref,\n+                        full_path.display()\n+                    );","path":"apps/gts-docs-validator/src/link_checker.rs","commit_id":"121075ca5765d13875944700bd1059b4dcf2e161","original_commit_id":"121075ca5765d13875944700bd1059b4dcf2e161","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Critical bug: `Err()` is missing `format!()` macro. The error message will be a literal string `\"Anchor '{}' not found in {}\"` instead of the formatted values.\n\n```rust\nreturn Err(format!(\n    \"Anchor '{}' not found in {}\",\n    anchor_ref,\n    full_path.display()\n));\n```\n```suggestion\n                return Err(format!(\n                        \"Anchor '{}' not found in {}\",\n                        anchor_ref,\n          
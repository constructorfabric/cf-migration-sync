pt executed:\n\n```shell\ncat -n testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py | head -60\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 2522\n\n---\n\n🏁 Script executed:\n\n```shell\nwc -l testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 129\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 8349\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check other upload test files\ncat -n testing/e2e/modules/file_parser/test_file_parser_upload.py | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3889\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n testing/e2e/modules/file_parser/test_file_parser_upload.py | tail -80\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3401\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n testing/e2e/modules/file_parser/test_file_parser_upload_markdown.py | head -150\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 5979\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n testing/e2e/modules/file_parser/test_file_parser_upload.py | sed -n '84,150p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 2913\n\n---\n\n\n\n</details>\n\n**Add auth requirement checks to upload tests to prevent false failures.**\n\nThe four upload tests in this file (`test_xlsx_upload_simple`, `test_xlsx_upload_multisheet`, `test_pptx_upload_simple`, `test_pptx_upload_multislide`) lack the auth skip check that already exists in the info-endpoint tests within the same file and in other upload test files. Running E2E tests without `E2E_AUTH_TOKEN` will fail hard on 401/403 responses. Add the auth check before each status code assertion to skip gracefully:\n\n<details>\n<summary>Pattern to apply to all four upload tests</summary>\n\n```diff\n     assert response.status_code == 200, f\"Upload failed: {response.text}\"\n+    if response.status_code in (401, 403) and not auth_headers:\n+        pytest.skip(\n+            f\"Endpoint requires authentication (got {response.status_code}). \"\n+            \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+        )\n```\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@testing/e2e/modules/file_parser/test_file_parser_xlsx_pptx.py` around lines\n12 - 42, The upload tests test_xlsx_upload_simple, test_xlsx_upload_multisheet,\ntest_pptx_upload_simple, and test_pptx_upload_multislide should guard against\nrunning without credentials: before asserting response.status_code, check\nwhether auth is configured (e.g. verify auth_headers is present or\nos.environ.get(\"E2E_AUTH_TOKEN\") is set) and call pytest.skip(...) if not, so\nthe test will skip instead of failing on 401/403; add this short auth existence\ncheck at the start of each test (using the existing auth_headers parameter)\nimmediately before the HTTP request/response status assertion.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit d3c17f3","created_at":"2026-01-28T11:25:48Z","updated_at":"2026-01-28T12:11:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736193487","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193487"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736193487"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736193487/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":12,"original_start_line":12,"start_side":"RIGHT","line":45,"original_line":42,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":42,"position":45,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2736237486","pull_request_review_id":3716234809,"id":2736237486,"node_id":"PRRC_kwDOPaLyBs6jF6uu","diff_hunk":"@@ -0,0 +1,254 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn determine_content_type(path: &Path) -> &'static str {\n+    match path.extension().and_then(|e| e.to_str()) {\n+        Some(\"xls\") => \"application/vnd.ms-excel\",\n+        Some(\"xlsm\") => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+        Some(\"xlsb\") => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        _ => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+    }\n+}\n+\n+fn parse_spreadsheet_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let mut workbook = open_workbook_auto(path)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open spreadsheet: {e}\")))?;\n+\n+    Ok(extract_blocks_from_workbook(&mut workbook))\n+}\n+\n+fn parse_spreadsheet_from_bytes(\n+    bytes: &[u8],\n+    filename: &str,\n+) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let cursor = std::io::Cursor::new(bytes);\n+\n+    // Determine format from filename extension\n+    let ext = filename.rsplit('.').next().unwrap_or(\"xlsx\").to_lowercase();\n+\n+    if ext.as_str() == \"xls\" {\n+        let mut workbook: Xls<_> = Xls::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else if ext.as_str() == \"xlsb\" {\n+        let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else {\n+        // Default to xlsx format\n+        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    }\n+}","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"http
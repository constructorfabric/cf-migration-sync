alamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// Excel file format variants\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum ExcelFormat {\n+    /// Legacy Excel format (.xls)\n+    Xls,\n+    /// Excel Open XML format (.xlsx)\n+    Xlsx,\n+    /// Excel Open XML Macro-Enabled format (.xlsm)\n+    Xlsm,\n+    /// Excel Binary format (.xlsb)\n+    Xlsb,\n+}\n+\n+/// OLE Compound Document magic bytes (used by .xls)\n+const OLE_MAGIC: [u8; 4] = [0xD0, 0xCF, 0x11, 0xE0];\n+/// ZIP archive magic bytes (used by .xlsx, .xlsm, .xlsb)\n+const ZIP_MAGIC: [u8; 4] = [0x50, 0x4B, 0x03, 0x04];\n+\n+impl ExcelFormat {\n+    /// Determine format from filename extension (used as hint for MIME type)\n+    #[must_use]\n+    pub fn from_filename(filename: &str) -> Self {\n+        let ext = filename.rsplit('.').next().unwrap_or(\"\").to_lowercase();\n+        match ext.as_str() {\n+            \"xls\" => Self::Xls,\n+            \"xlsm\" => Self::Xlsm,\n+            \"xlsb\" => Self::Xlsb,\n+            _ => Self::Xlsx,\n+        }\n+    }\n+\n+    /// Detect format from file magic bytes\n+    /// Returns None if the bytes don't match any known Excel format\n+    #[must_use]\n+    pub fn from_magic_bytes(bytes: &[u8]) -> Option<Self> {\n+        if bytes.len() < 4 {\n+            return None;\n+        }\n+\n+        let magic: [u8; 4] = [bytes[0], bytes[1], bytes[2], bytes[3]];\n+\n+        if magic == OLE_MAGIC {\n+            // OLE format = legacy XLS\n+            Some(Self::Xls)\n+        } else if magic == ZIP_MAGIC {\n+            // ZIP-based format (xlsx, xlsm, or xlsb)\n+            // All three share the same magic bytes; we'll try parsers in order\n+            Some(Self::Xlsx)\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Get the MIME type for this format\n+    #[must_use]\n+    pub const fn mime_type(self) -> &'static str {\n+        match self {\n+            Self::Xls => \"application/vnd.ms-excel\",\n+            Self::Xlsx => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+            Self::Xlsm => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+            Self::Xlsb => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        }\n+    }\n+\n+    /// Get the file extension for this format (without dot)\n+    #[must_use]\n+    pub const fn extension(self) -> &'static str {","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"d3c17f34996ccda75c7464cee8f9df2939835736","original_commit_id":"d3c17f34996ccda75c7464cee8f9df2939835736","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"impl AsRef for ExcelFormat","created_at":"2026-01-28T12:16:14Z","updated_at":"2026-01-28T16:07:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2736371889","pull_request_url":"https://api.github.com/repos/cyber
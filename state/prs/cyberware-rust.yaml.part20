r, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn determine_content_type(path: &Path) -> &'static str {\n+    match path.extension().and_then(|e| e.to_str()) {","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"let's improve our parsing logic, there are too many strings here.\r\nTry to use an enum instead of strings everywhere, so we can have warranties at compile time where we are not being exhaustive and where are we using the references","created_at":"2026-01-27T10:20:46Z","updated_at":"2026-01-27T10:23:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731282374","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731282374"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/319#discussion_r2731282374"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/319"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731282374/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":100,"side":"RIGHT","author_association":"MEMBER","original_position":100,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2731290839","pull_request_review_id":3710277223,"id":2731290839,"node_id":"PRRC_kwDOPaLyBs6izDDX","diff_hunk":"@@ -0,0 +1,254 @@\n+use async_trait::async_trait;\n+use calamine::{Data, Reader, Xls, Xlsb, Xlsx, open_workbook_auto};\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{\n+    DocumentBuilder, Inline, ParsedBlock, ParsedSource, TableBlock, TableCell, TableRow,\n+};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// XLSX/XLS parser that extracts data from Excel spreadsheets using calamine\n+pub struct XlsxParser;\n+\n+impl XlsxParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for XlsxParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for XlsxParser {\n+    fn id(&self) -> &'static str {\n+        \"xlsx\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"xlsx\", \"xls\", \"xlsm\", \"xlsb\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let path_buf = path.to_path_buf();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_path(&path_buf)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let content_type = determine_content_type(path);\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.title(filename).original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename = filename_hint.unwrap_or(\"unknown.xlsx\").to_owned();\n+        let filename_for_ext = filename.clone();\n+\n+        let blocks =\n+            tokio::task::spawn_blocking(move || -> Result<Vec<ParsedBlock>, DomainError> {\n+                parse_spreadsheet_from_bytes(&bytes, &filename_for_ext)\n+            })\n+            .await\n+            .map_err(|e| DomainError::parse_error(format!(\"Task join error: {e}\")))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename.clone(),\n+        };\n+\n+        let content_type = if filename.to_lowercase().ends_with(\".xls\") {\n+            \"application/vnd.ms-excel\"\n+        } else {\n+            \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(content_type)\n+            .blocks(blocks);\n+\n+        builder = builder.title(&filename).original_filename(&filename);\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn determine_content_type(path: &Path) -> &'static str {\n+    match path.extension().and_then(|e| e.to_str()) {\n+        Some(\"xls\") => \"application/vnd.ms-excel\",\n+        Some(\"xlsm\") => \"application/vnd.ms-excel.sheet.macroEnabled.12\",\n+        Some(\"xlsb\") => \"application/vnd.ms-excel.sheet.binary.macroEnabled.12\",\n+        _ => \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n+    }\n+}\n+\n+fn parse_spreadsheet_from_path(path: &Path) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let mut workbook = open_workbook_auto(path)\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to open spreadsheet: {e}\")))?;\n+\n+    Ok(extract_blocks_from_workbook(&mut workbook))\n+}\n+\n+fn parse_spreadsheet_from_bytes(\n+    bytes: &[u8],\n+    filename: &str,\n+) -> Result<Vec<ParsedBlock>, DomainError> {\n+    let cursor = std::io::Cursor::new(bytes);\n+\n+    // Determine format from filename extension\n+    let ext = filename.rsplit('.').next().unwrap_or(\"xlsx\").to_lowercase();\n+\n+    if ext.as_str() == \"xls\" {\n+        let mut workbook: Xls<_> = Xls::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLS: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else if ext.as_str() == \"xlsb\" {\n+        let mut workbook: Xlsb<_> = Xlsb::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSB: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    } else {\n+        // Default to xlsx format\n+        let mut workbook: Xlsx<_> = Xlsx::new(cursor)\n+            .map_err(|e| DomainError::parse_error(format!(\"Failed to open XLSX: {e}\")))?;\n+        Ok(extract_blocks_from_workbook(&mut workbook))\n+    }\n+}\n+\n+fn extract_blocks_from_workbook<RS: std::io::Read + std::io::Seek, R: Reader<RS>>(\n+    workbook: &mut R,\n+) -> Vec<ParsedBlock> {\n+    let mut blocks = Vec::new();\n+    let sheet_names = workbook.sheet_names();\n+\n+    for sheet_name in sheet_names {\n+        // Add sheet name as a heading\n+        blocks.push(ParsedBlock::Heading {\n+            level: 2,\n+            inlines: vec![Inline::plain(&sheet_name)],\n+        });\n+\n+        // Get the worksheet range\n+        let range = match workbook.worksheet_range(&sheet_name) {\n+            Ok(range) => range,\n+            Err(e) => {\n+                tracing::warn!(\"Failed to read sheet '{}': {:?}\", sheet_name, e);\n+                continue;\n+            }\n+        };\n+\n+        // Convert range to table block\n+        if let Some(table_block) = range_to_table_block(&range) {\n+            blocks.push(table_block);\n+        }\n+    }\n+\n+    blocks\n+}\n+\n+fn range_to_table_block(range: &calamine::Range<Data>) -> Option<ParsedBlock> {\n+    let height = range.height();\n+    let width = range.width();\n+\n+    if height == 0 || width == 0 {\n+        return None;\n+    }\n+\n+    let mut rows = Vec::with_capacity(height);\n+\n+    for (row_idx, row) in range.rows().enumerate() {\n+        let is_header = row_idx == 0;\n+        let mut cells = Vec::with_capacity(width);\n+\n+        for cell in row {\n+            let text = cell_to_string(cell);\n+            cells.push(TableCell {\n+                blocks: vec![ParsedBlock::Paragraph {\n+                    inlines: vec![Inline::plain(text)],\n+                }],\n+            });\n+        }\n+\n+        rows.push(TableRow { is_header, cells });\n+    }\n+\n+    Some(ParsedBlock::Table(TableBlock { rows }))\n+}\n+\n+fn cell_to_string(cell: &Data) -> String {\n+    match cell {\n+        Data::Empty => String::new(),\n+        Data::String(s) | Data::DateTimeIso(s) | Data::DurationIso(s) => s.clone(),\n+        Data::Int(i) => i.to_string(),\n+        Data::Float(f) => {\n+            // Format floats nicely - remove trailing zeros\n+            if f.fract() == 0.0 {\n+                #[allow(clippy::cast_possible_truncation)]\n+                let int_val = *f as i64;","path":"modules/file_parser/src/infra/parsers/xlsx_parser.rs","commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","original_commit_id":"442c8b97ba7088ff0732ba5241570f898973e67a","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think what you want t
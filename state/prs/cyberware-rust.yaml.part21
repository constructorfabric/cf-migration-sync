ody":"also @MikeFalcon77 feedback, should we allow the screaming?","created_at":"2026-01-15T12:24:56Z","updated_at":"2026-01-15T12:25:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694182237","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694182237"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694182237"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694182237/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":6,"original_line":5,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":6,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694189673","pull_request_review_id":3665363817,"id":2694189673,"node_id":"PRRC_kwDOPaLyBs6glhJp","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Currently only this one in tenant-resolver:\r\n```rust\r\n#[derive(Debug, Clone, Copy, Serialize, Deserialize, ToSchema)]\r\n#[serde(rename_all = \"SCREAMING_SNAKE_CASE\")]\r\npub enum TenantStatusDto {\r\n    Unspecified,\r\n    Active,\r\n    SoftDeleted,\r\n}\r\n```","created_at":"2026-01-15T12:27:18Z","updated_at":"2026-01-15T12:27:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694189673","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694189673"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694189673"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694189673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694549476","pull_request_review_id":3665839429,"id":2694549476,"node_id":"PRRC_kwDOPaLyBs6gm4_k","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@aviator5 can we change it to snake_case?","created_at":"2026-01-15T14:11:24Z","updated_at":"2026-01-15T14:11:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694549476","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694549476"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2694549476"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694549476/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702661719","pull_request_review_id":3675696304,"id":2702661719,"node_id":"PRRC_kwDOPaLyBs6hF1hX","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The idea behind this lint makes sense but the current implementation is quite fragile and does not actually guarantee that outcome.\r\n\r\nThe issues:\r\n\r\n1. `rename_all` is optional\r\n   If a DTO has no `#[serde(rename_all = \"...\")]`, the lint does nothing. This allows non-snake_case responses to slip through by default\r\n\r\n2. Non-snake variants are explicitly allowed\r\n   `SCREAMING_SNAKE_CASE` and `UPPERCASE` are permitted, which contradicts the stated goal of enforcing snake_case for API responses\r\n\r\n3. Field visibility is ignored\r\n   The lint does not distinguish between `pub` and non-`pub` fields. Private fields may never be serialized, but are still linted if they have attributes, while public fields without `serde(rename)` are not checked at all\r\n\r\n4. No check that the type is actually serialized\r\n   There is no validation that the struct/enum derives `Serialize` or `Deserialize`. Non-DTO types in `api/rest` are treated the same as real API response models\r\n\r\n5. Folder-based detection is brittle\r\n   Relying on `span` location in `api/rest` is easy to bypass via re-exports, shared DTOs defined elsewhere, or `include!`","created_at":"2026-01-18T19:23:58Z","updated_at":"2026-01-18T19:37:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702661719","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702661719"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702661719"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702661719/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":26,"original_line":26,"side":"RIGHT","author_association":"MEMBER","original_position":26,"position":26,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702665039","pull_request_review_id":3675696304,"id":2702665039,"node_id":"PRRC_kwDOPaLyBs6hF2VP","diff_hunk":"","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this can be made much simpler and more reliable with proc macro.\r\n\r\nInstead of trying to infer API rules from a mix of `serde` attributes (really complicated task) I strongly suggest introducing a single marker macro like `#[api_dto]` and enforcing its presence.\r\n\r\nWith this approach:\r\n\r\n* `#[api_dto]` becomes the single source of truth for API DTO policy.\r\n* The macro can consistently apply:\r\n\r\n  * `#[derive(Serialize, Deserialize)]`\r\n  * `#[serde(rename_all = \"snake_case\")]`\r\n  * any other API-level defaults we want.\r\n* The dylint lint (this one) logic becomes trivial and robust:\r\n  * all structs/enums used as API DTOs in `api/rest` must have `#[api_dto]`\r\n\r\nThis avoids the current fragile behavior where:\r\n\r\n* `rename_all` is optional,\r\n* non-snake variants are allowed,\r\n* field visibility is ignored,\r\n* types that are not actually serialized are still linted,\r\n* folder-based heuristics try to guess intent.\r\n\r\nIf needed, we can additionally forbid `#[serde(rename = ...)]` on fields (or strictly validate it) to prevent bypassing the policy.\r\n\r\nOverall, a mandatory `#[api_dto]` marker is clearer for developers, harder to misuse accidentally, and much easier to enforce correctly than the current attribute-inspection approach.\r\n","created_at":"2026-01-18T19:28:41Z","updated_at":"2026-01-18T19:40:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702665039","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702665039"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702665039"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702665039/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702666400","pull_request_review_id":3675704387,"id":2702666400,"node_id":"PRRC_kwDOPaLyBs6hF2qg","diff_hunk":"@@ -0,0 +1,10 @@\n+// simulated_dir=/hyperspot/modules/some_module/api/rest/dto.rs\n+use serde::{Deserialize, Serialize};\n+\n+#[derive(Serialize, Deserialize)]\n+#[serde(rename_all = \"SCREAMING_SNAKE_CASE\")]","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/ui/fail_screaming_snake_case.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why do we need it? :)","created_at":"2026-01-18T19:30:53Z","updated_at":"2026-01-18T19:30:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702666400","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702666400"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2702666400"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702666400/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":6,"original_line":5,"side":"RIGHT","in_reply_to_id":2694182237,"author_association":"MEMBER","original_position":5,"position":6,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703634042","pull_request_review_id":3676755270,"id":2703634042,"node_id":"PRRC_kwDOPaLyBs6hJi56","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's a Tenant Resolver from the examples, it demonstrates how to implement module gateway + plugin pattern: https://github.com/hypernetix/hyperspot/blob/35dca94cd2ebe3cbf2004e1b3529028837ecaa25/examples/plugin-modules/tenant_resolver/tenant_resolver-gw/src/api/rest/dto.rs#L27-L33.\r\n@nanoandrew4 feel free to change its code.\r\n\r\nbtw, @MikeFalcon77, @Bechma we have a convention for enums? it should be `snake_case`, not `SCREAMING_SNAKE_CASE`, right?\r\n","created_at":"2026-01-19T07:53:37Z","updated_at":"2026-01-19T07:53:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703634042","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703634042"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703634042"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703634042/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703762821","pull_request_review_id":3676907428,"id":2703762821,"node_id":"PRRC_kwDOPaLyBs6hKCWF","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I agree with your next comment, but:\r\n3. You need to use `#[serde(skip)]`, this is not go with the visibility thing \r\n4. I don't understand what you mean\r\n5. The initial idea was to force it to the models defined inside of that location","created_at":"2026-01-19T08:38:36Z","updated_at":"2026-01-19T08:38:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703762821","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703762821"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703762821"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703762821/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":26,"original_line":26,"side":"RIGHT","in_reply_to_id":2702661719,"author_association":"MEMBER","original_position":26,"position":26,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703810223","pull_request_review_id":3676962458,"id":2703810223,"node_id":"PRRC_kwDOPaLyBs6hKN6v","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"For enums we are using std Rust conventions: PascalCase","created_at":"2026-01-19T08:52:22Z","updated_at":"2026-01-19T08:52:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703810223","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703810223"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703810223"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703810223/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703817428","pull_request_review_id":3676973390,"id":2703817428,"node_id":"PRRC_kwDOPaLyBs6hKPrU","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"What I mean is this: The lint assumes that every struct or enum in api/rest is an API DTO, but it never verifies that the type is actually used for serialization.\r\n\r\n**Details:**\r\n\r\nA type without #[derive(Serialize)] or #[derive(Deserialize)] cannot be serialized by serde at all.\r\nDespite that, the lint still analyzes such types and enforces naming rules on their serde attributes, even though they may never appear in an API response or request.\r\n\r\nSo the lint does not distinguish between real API models that are part of the serialized contract, and\r\nhelper types, internal enums, or request-processing structs that happen to live in api/rest but are not serialized.\r\n\r\nBTW this is another reason why a dedicated marker like #[api_dto] is cleaner: it explicitly states “this type is part of the API contract”, instead of guessing based on location and partial attribute inspection.","created_at":"2026-01-19T08:54:18Z","updated_at":"2026-01-19T08:54:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703817428","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703817428"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703817428"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703817428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":26,"original_line":26,"side":"RIGHT","in_reply_to_id":2702661719,"author_association":"MEMBER","original_position":26,"position":26,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703821632","pull_request_review_id":3676980042,"id":2703821632,"node_id":"PRRC_kwDOPaLyBs6hKQtA","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Just to be clear, PascalCase in the code, but when serialized they should be snake_case, to avoid having an exception for enums correct? @MikeFalcon77 ","created_at":"2026-01-19T08:55:17Z","updated_at":"2026-01-19T08:55:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703821632","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703821632"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2703821632"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2703821632/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704507356","pull_request_review_id":3677790160,"id":2704507356,"node_id":"PRRC_kwDOPaLyBs6hM4Hc","diff_hunk":"@@ -0,0 +1,152 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+extern crate rustc_span;\n+\n+use rustc_ast::{Attribute, Item, ItemKind, VariantData};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_api_rest_folder;\n+\n+dylint_linting::declare_pre_expansion_lint! {\n+    /// DE0803: API DTOs Must Use Snake Case in Serde Attributes\n+    ///\n+    /// DTOs must use snake_case in serde rename_all and rename attributes.\n+    /// This lint checks both:\n+    /// - Type-level `#[serde(rename_all = \"...\")]` attributes\n+    /// - Field-level `#[serde(rename = \"...\")]` attributes\n+    ///\n+    /// Only snake_case is allowed for API consistency per DNA guidelines.\n+    pub DE0803_API_SNAKE_CASE,\n+    Deny,\n+    \"API DTOs must use snake_case in serde rename attributes (DE0803)\"\n+}\n+\n+impl EarlyLintPass for De0803ApiSnakeCase {\n+    /// Checks structs and enums in api/rest folders for snake_case compliance.\n+    fn check_item(&mut self, cx: &EarlyContext<'_>, item: &Item) {\n+        if !is_in_api_rest_folder(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+\n+        match &item.kind {\n+            ItemKind::Struct(_, _, variant_data) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            let Some(value) = meta_item.value_str() else {\n+                continue;\n+            };\n+\n+            results.push((meta_item.span, value.as_str().to_string()));\n+        }\n+    }\n+    \n+    results\n+}\n+\n+/// Validates that `rename_all` attributes use snake_case variants.\n+fn check_type_rename_all(cx: &EarlyContext<'_>, attrs: &[Attribute]) {\n+    for (span, value) in find_serde_attribute_value(attrs, \"rename_all\") {\n+        if value != \"snake_case\" && value != \"SCREAMING_SNAKE_CASE\" && value != \"UPPERCASE\" {\n+            cx.span_lint(\n+                DE0803_API_SNAKE_CASE,\n+                span,\n+                |diag| {\n+                    diag.primary_message(\n+                        \"DTOs must not use non-snake_case in serde rename_all (DE0803)\"\n+                    );\n+                    diag.help(\"DTOs in api/rest must use snake_case (or default) to match API standards\");\n+                },\n+            );\n+        }\n+    }\n+}\n+\n+/// Validates that field `rename` attributes use snake_case.\n+fn check_fields(cx: &EarlyContext<'_>, variant_data: &VariantData) {\n+    for field in variant_data.fields() {\n+        for (span, value) in find_serde_attribute_value(&field.attrs, \"rename\") {\n+            if !is_valid_case(&value) {\n+                cx.span_lint(\n+                    DE0803_API_SNAKE_CASE,\n+                    span,\n+                    |diag| {\n+                        diag.primary_message(\n+                            \"DTO fields must not use non-snake_case in serde rename (DE0803)\"\n+                        );\n+                        diag.help(\"DTO fields in api/rest must use snake_case to match API standards\");\n+                    },\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+/// Checks if a string uses valid snake_case, SCREAMING_SNAKE_CASE, or plain upper/lowercase.\n+fn is_valid_case(s: &str) -> bool {\n+    if s.is_empty() {\n+        return false;\n+    }\n+\n+    if s.contains('-') || s.contains(' ') {\n+        return false;\n+    }\n+\n+    // Accept uppercase and lowercase, as well as snake_case and SCREAMING_SNAKE_CASE\n+    s.chars().all(|c| c.is_uppercase() || c.is_numeric() || c == '_') || s.chars().all(|c| c.is_lowercase() || c.is_numeric() || c == '_')","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"9135cda5091fe0920fece2be8eb11bb9a1ab9bd5","original_commit_id":"ae50a050e30acc179389c2d3fc6f328774813614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"yes, for serialization we are using snake_case as usual","created_at":"2026-01-19T12:10:20Z","updated_at":"2026-01-19T12:10:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2704507356","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704507356"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2704507356"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704507356/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":133,"side":"RIGHT","in_reply_to_id":2694172364,"author_association":"MEMBER","original_position":133,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704510153","pull_request_review_id":3677792970,"id":2704510153,"node_id":"PRRC_kwDOPaLyBs6hM4zJ","diff_hunk":"@@ -0,0 +1,10 @@\n+// simulated_dir=/hyperspot/modules/some_module/api/rest/dto.rs\n+use serde::{Deserialize, Serialize};\n+\n+#[derive(Serialize, Deserialize)]\n+pub struct BadFieldUppercaseDto {\n+    #[serde(rename = \"UPPERCASE_FIELD\")]","path":"dylint_lints/de08_rest_a
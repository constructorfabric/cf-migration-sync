","original_position":35,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686087408","pull_request_review_id":3655397330,"id":2686087408,"node_id":"PRRC_kwDOPaLyBs6gGnDw","diff_hunk":"@@ -15,14 +16,21 @@ pub struct CitiesService<R: CitiesRepository> {\n     policy_engine: PolicyEngineRef,\n     repo: Arc<R>,\n     db: SecureConn,\n+    resolver: Arc<dyn TenantResolverGatewayClient>,\n }\n \n impl<R: CitiesRepository> CitiesService<R> {","path":"examples/modkit/users_info/users_info/src/domain/service/cities.rs","commit_id":"f3212c2222fa0fbfa9763a87b5bb6f5a293a778d","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"was introduced in https://github.com/hypernetix/hyperspot/pull/215","created_at":"2026-01-13T11:55:16Z","updated_at":"2026-01-13T11:55:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2686087408","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://ap
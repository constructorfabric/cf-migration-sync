p&utm_medium=github","html_url":"https://github.com/apps/coderabbitai","created_at":"2023-06-14T15:47:27Z","updated_at":"2026-03-14T07:58:44Z","permissions":{"actions":"read","checks":"write","contents":"write","discussions":"read","issues":"write","members":"read","metadata":"read","pull_requests":"write","statuses":"write"},"events":["issues","issue_comment","label","organization","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","release","repository"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":271,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/271","source_state":"closed","source_author":"step-security-bot","target_issue_number":null,"title":"[PR #271] [StepSecurity] ci: Harden GitHub Actions","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"chore/GHA-171704-stepsecurity-remediation","pr_head_sha":"262563e904250e4c862e49e51c8d47ddb4c4ae11","pr_base_ref":"main","pr_head_owner":"step-security-bot","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/271","id":3184327486,"node_id":"PR_kwDOPaLyBs69zPs-","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/271","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/271.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/271.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/271","number":271,"state":"closed","locked":false,"title":"[StepSecurity] ci: Harden GitHub Actions","user":{"login":"step-security-bot","id":89328645,"node_id":"MDQ6VXNlcjg5MzI4NjQ1","avatar_url":"https://avatars.githubusercontent.com/u/89328645?v=4","gravatar_id":"","url":"https://api.github.com/users/step-security-bot","html_url":"https://github.com/step-security-bot","followers_url":"https://api.github.com/users/step-security-bot/followers","following_url":"https://api.github.com/users/step-security-bot/following{/other_user}","gists_url":"https://api.github.com/users/step-security-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/step-security-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/step-security-bot/subscriptions","organizations_url":"https://api.github.com/users/step-security-bot/orgs","repos_url":"https://api.github.com/users/step-security-bot/repos","events_url":"https://api.github.com/users/step-security-bot/events{/privacy}","received_events_url":"https://api.github.com/users/step-security-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\n\nThis pull request is created by [StepSecurity](https://app.stepsecurity.io/securerepo) at the request of @MikeFalcon77. Please merge the Pull Request to incorporate the requested changes. Please tag @MikeFalcon77 on your message if you have any questions related to the PR.\n## Security Fixes\n\n### Pinned Dependencies\n\nGitHub Action tags and Docker tags are mutable. This poses a security risk. GitHub's Security Hardening guide recommends pinning actions to full length commit.\n\n- [GitHub Security Guide](https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions)\n- [The Open Source Security Foundation (OpenSSF) Security Guide](https://github.com/ossf/scorecard/blob/main/docs/checks.md#pinned-dependencies)\n\n\n## Feedback\nFor bug reports, feature requests, and general feedback; please email support@stepsecurity.io. To create such PRs, please visit https://app.stepsecurity.io/securerepo.\n\n\nSigned-off-by: StepSecurity Bot <bot@stepsecurity.io>\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Updated CI/CD infrastructure to use pinned action versions for improved build reliability and reproducibility.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-17T17:04:42Z","updated_at":"2026-01-18T11:11:12Z","closed_at":"2026-01-18T11:11:12Z","merged_at":"2026-01-18T11:11:12Z","merge_commit_sha":"0503d35a543a7da1322b745602b26f4e1ce7226d","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/271/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/271/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/271/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/262563e904250e4c862e49e51c8d47ddb4c4ae11","head":{"label":"step-security-bot:chore/GHA-171704-stepsecurity-remediation","ref":"chore/GHA-171704-stepsecurity-remediation","sha":"262563e904250e4c862e49e51c8d47ddb4c4ae11","user":{"login":"step-security-bot","id":89328645,"node_id":"MDQ6VXNlcjg5MzI4NjQ1","avatar_url":"https://avatars.githubusercontent.com/u/89328645?v=4","gravatar_id":"","url":"https://api.github.com/users/step-security-bot","html_url":"https://github.com/step-security-bot","followers_url":"https://api.github.com/users/step-security-bot/followers","following_url":"https://api.github.com/users/step-security-bot/following{/other_user}","gists_url":"https://api.github.com/users/step-security-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/step-security-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/step-security-bot/subscriptions","organizations_url":"https://api.github.com/users/step-security-bot/orgs","repos_url":"https://api.github.com/users/step-security-bot/repos","events_url":"https://api.github.com/users/step-security-bot/events{/privacy}","receive
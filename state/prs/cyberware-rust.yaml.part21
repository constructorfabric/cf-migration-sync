atic str into const so we can have easily mapped in references the:\r\nExtension => MIME\r\nMIME => Extension","created_at":"2026-01-14T17:59:29Z","updated_at":"2026-01-14T18:03:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2691484966","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/236","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691484966"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2691484966"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/236"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691484966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":287,"side":"RIGHT","author_association":"MEMBER","original_position":15,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691489383","pull_request_review_id":3662063530,"id":2691489383,"node_id":"PRRC_kwDOPaLyBs6gbN5n","diff_hunk":"@@ -0,0 +1,164 @@\n+use async_trait::async_trait;\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{DocumentBuilder, ParsedBlock, ParsedSource};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// Image parser that handles standard image formats\n+///\n+/// Treats images as opaque binary payloads and encodes them as base64 data URIs.\n+/// No decoding, resizing, or re-encoding is performed.\n+///\n+/// Supported formats:\n+/// - PNG (.png, image/png)\n+/// - JPEG (.jpg, .jpeg, image/jpeg)\n+/// - WebP (.webp, image/webp)\n+/// - GIF (.gif, image/gif) – static only\n+pub struct ImageParser;\n+\n+impl ImageParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n
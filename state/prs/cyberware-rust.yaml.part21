ps://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653763441","pull_request_review_id":3619148010,"id":2653763441,"node_id":"PRRC_kwDOPaLyBs6eLTdx","diff_hunk":"@@ -0,0 +1,242 @@\n+#![forbid(unsafe_code)]\n+\n+//! Serde support for the `humantime` crate.\n+//!\n+//! Based on [this fork](https://github.com/jean-airoldie/humantime-serde).\n+//!\n+//! Currently `std::time::Duration` is supported.\n+//!\n+//! # Example\n+//! ```\n+//! use serde::{Serialize, Deserialize};\n+//! use std::time::Duration;\n+//!\n+//! #[derive(Serialize, Deserialize)]\n+//! struct Foo {\n+//!     #[serde(with = \"modkit_utils::humantime_serde\")]\n+//!     timeout: Duration,\n+//! }\n+//! ```\n+\n+use std::fmt;\n+use std::time::Duration;\n+\n+use humantime;\n+use serde::{de, Deserializer, Serializer};\n+\n+/// Deserializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `deserialize_with` annotations.\n+/// # Errors\n+/// Returns a `humantime::Error` if string is not a valid Duration\n+pub fn deserialize<'a, D>(d: D) -> Result<Duration, D::Error>\n+where\n+    D: Deserializer<'a>,\n+{\n+    struct V;\n+\n+    impl de::Visitor<'_> for V {\n+        type Value = Duration;\n+\n+        fn expecting(&self, fmt: &mut fmt::Formatter) -> fmt::Result {\n+            fmt.write_str(\"a duration\")\n+        }\n+\n+        fn visit_str<E>(self, v: &str) -> Result<Duration, E>\n+        where\n+            E: de::Error,\n+        {\n+            humantime::parse_duration(v)\n+                .map_err(|_| E::invalid_value(de::Unexpected::Str(v), &self))\n+        }\n+    }\n+\n+    d.deserialize_str(V)\n+}\n+\n+/// Serializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `serialize_with` annotations.\n+/// # Errors\n+/// Returns a `humantime::Error` if string is not a valid Duration\n+pub fn serialize<S>(d: &Duration, s: S) -> Result<S::Ok, S::Error>\n+where\n+    S: Serializer,\n+{\n+    let duration_str = humantime::format_duration(*d).to_string();\n+    s.serialize_str(&duration_str)\n+}\n+\n+pub mod option {\n+    //! Convenience module to allow serialization via `humantime_serde` for `Option`\n+    //!\n+    //! # Example\n+    //!\n+    //! ```\n+    //! use serde::{Serialize, Deserialize};\n+    //! use std::time::Duration;\n+    //!\n+    //! #[derive(Serialize, Deserialize)]\n+    //! struct Foo {\n+    //!     #[serde(with = \"modkit_utils::humantime_serde::option\")]\n+    //!     timeout: Option<Duration>,\n+    //! }\n+    //! ```\n+\n+    use std::time::Duration;\n+\n+    use serde::{Deserialize, Deserializer, Serializer};\n+\n+    /// Serializes an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    /// # Errors\n+    /// Returns a `humantime::Error` if string is not a valid Duration\n+    pub fn serialize<S>(d: &Option<Duration>, s: S) -> Result<S::Ok, S::Error>\n+    where\n+        S: Serializer,\n+    {\n+        match d {\n+            Some(d) => super::serialize(d, s),\n+            None => s.serialize_none(),\n+        }\n+    }\n+\n+    /// Deserialize an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    /// # Errors\n+    /// Returns a `humantime::Error` if string is not a valid Duration\n+    pub fn deserialize<'a, D>(d: D) -> Result<Option<Duration>, D::Error>","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","original_commit_id":"25d8ea97ac2a057c8a2593daf18414b11f0dd1cd","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This deserialize() currently goes through an intermediate String; this adds an unnecessary allocation and bypasses the main deserialize logic (super:: call)","created_at":"2025-12-30T19:50:33Z","updated_at":"2025-12-30T19:50:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653763441","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653763441"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653763441"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653763441/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":119,"original_line":114,"side":"RIGHT","author_association":"MEMBER","original_position":114,"position":119,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655273128","pull_request_review_id":3620752076,"id":2655273128,"node_id":"PRRC_kwDOPaLyBs6eRECo","diff_hunk":"@@ -0,0 +1,269 @@\n+#![forbid(unsafe_code)]\n+\n+//! Serde support for the `humantime` crate.\n+//!\n+//! Based on [this fork](https://github.com/jean-airoldie/humantime-serde).\n+//!\n+//! Currently `std::time::Duration` is supported.\n+//!\n+//! # Example\n+//! ```\n+//! use serde::{Serialize, Deserialize};\n+//! use std::time::Duration;\n+//!\n+//! #[derive(Serialize, Deserialize)]\n+//! struct Foo {\n+//!     #[serde(with = \"modkit_utils::humantime_serde\")]\n+//!     timeout: Duration,\n+//! }\n+//! ```\n+\n+use std::fmt;\n+use std::time::Duration;\n+\n+use humantime;\n+use serde::{de, Deserializer, Serializer};\n+\n+/// Deserializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `deserialize_with` annotations.\n+///\n+/// # Errors\n+///\n+/// Returns an error if the string is not a valid duration.\n+pub fn deserialize<'a, D>(d: D) -> Result<Duration, D::Error>\n+where\n+    D: Deserializer<'a>,\n+{\n+    struct V;\n+\n+    impl de::Visitor<'_> for V {\n+        type Value = Duration;\n+\n+        fn expecting(&self, fmt: &mut fmt::Formatter) -> fmt::Result {\n+            fmt.write_str(\"a duration\")\n+        }\n+\n+        fn visit_str<E>(self, v: &str) -> Result<Duration, E>\n+        where\n+            E: de::Error,\n+        {\n+            humantime::parse_duration(v)\n+                .map_err(|_| E::invalid_value(de::Unexpected::Str(v), &self))\n+        }\n+    }\n+\n+    d.deserialize_str(V)\n+}\n+\n+/// Serializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `serialize_with` annotations.\n+///\n+/// # Errors\n+/// None\n+pub fn serialize<S>(d: &Duration, s: S) -> Result<S::Ok, S::Error>\n+where\n+    S: Serializer,\n+{\n+    s.collect_str(&humantime::format_duration(*d))\n+}\n+\n+pub mod option {\n+    //! Convenience module to allow serialization via `humantime_serde` for `Option`\n+    //!\n+    //! # Example\n+    //!\n+    //! ```\n+    //! use serde::{Serialize, Deserialize};\n+    //! use std::time::Duration;\n+    //!\n+    //! #[derive(Serialize, Deserialize)]\n+    //! struct Foo {\n+    //!     #[serde(with = \"modkit_utils::humantime_serde::option\")]\n+    //!     timeout: Option<Duration>,\n+    //! }\n+    //! ```\n+\n+    use std::time::Duration;\n+\n+    use serde::{Deserialize, Deserializer, Serializer};\n+\n+    /// Serializes an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `serialize_with` annotations.\n+    ///\n+    /// # Errors\n+    /// None\n+    pub fn serialize<S>(d: &Option<Duration>, s: S) -> Result<S::Ok, S::Error>\n+    where\n+        S: Serializer,\n+    {\n+        match d {\n+            Some(d) => super::serialize(d, s),\n+            None => s.serialize_none(),\n+        }\n+    }\n+\n+    /// Deserialize an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if the string is not a valid duration.\n+    pub fn deserialize<'a, D>(d: D) -> Result<Option<Duration>, D::Error>\n+    where\n+        D: Deserializer<'a>,\n+    {\n+        struct Wrapper(Duration);\n+\n+        impl<'de> Deserialize<'de> for Wrapper {\n+            fn deserialize<D>(d: D) -> Result<Self, D::Error>\n+            where\n+                D: Deserializer<'de>,\n+            {\n+                super::deserialize(d).map(Wrapper)\n+            }\n+        }\n+\n+        let v: Option<Wrapper> = Option::deserialize(d)?;\n+        Ok(v.map(|Wrapper(d)| d))\n+    }\n+}\n+\n+#[cfg(test)]\n+mod test {\n+    use serde::{Deserialize, Serialize};\n+\n+    #[test]\n+    fn with() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            time: super::Duration,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, super::Duration::from_secs(15));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+    }\n+\n+    #[test]\n+    fn with_option() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super::option\", default)]\n+            time: Option<super::Duration>,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, Some(super::Duration::from_secs(15)));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+\n+        let json = r#\"{\"time\": null}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":null}\"#);\n+\n+        let json = r\"{}\";\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+    }\n+\n+    #[test]\n+    fn time() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            duration: super::Duration,\n+        }\n+\n+        let json = r#\"{\"duration\": \"10m 10s\"}\"#;","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","original_commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/fo
+                    \"Internal Server Error\",\n+                    \"An internal error occurred\".to_owned(),\n+                )\n+            }\n+        };\n+\n+        let mut problem = Problem::new(status, title, detail)\n+            .with_type(format!(\"https://errors.hyperspot.com/{code}\"))","path":"modules/settings/settings/src/api/rest/error.rs","commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","original_commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We need to use GTS ids for errors, always, not some text code...\nIt first must be finally designed & implemented within  https://github.com/hypernetix/hyperspot/issues/226\n","created_at":"2026-01-12T20:32:13Z","updated_at":"2026-01-12T20:52:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2683819398","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683819398"},"html":{"href":"https://gith
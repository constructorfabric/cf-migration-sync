lly review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n//!\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit/src/domain/mod.rs` around lines 11 - 19, Update the docs example\nfor the User struct to use fully-qualified chrono types: replace DateTime<Utc>\nwith chrono::DateTime<chrono::Utc> in the rust,ignore block so the User struct\nexample (pub struct User { pub id: Uuid, pub email: String, pub created_at: ...\n}) explicitly references chrono and matches the project's documentation style.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-29T08:58:09Z","updated_at":"2026-01-29T08:58:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740602661","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740602661"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740602661"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740602661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":11,"original_start_line":11,"start_side":"RIGHT","line":19,"original_line":19,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":19,"position":19,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740602679","pull_request_review_id":3721452163,"id":2740602679,"node_id":"PRRC_kwDOPaLyBs6jWkc3","diff_hunk":"@@ -0,0 +1,202 @@\n+//! Domain Layer Marker Traits\n+//!\n+//! This module provides marker traits for enforcing domain-driven design boundaries\n+//! at compile time. Types marked with these traits are guaranteed to be free of\n+//! infrastructure dependencies (`sqlx`, `sea_orm`, `http`, `axum`, etc.).\n+//!\n+//! # Usage\n+//!\n+//! Use the `#[domain_model]` attribute macro to mark domain types:\n+//!\n+//! ```rust,ignore\n+//! use modkit_macros::domain_model;\n+//!\n+//! #[domain_model]\n+//! pub struct User {\n+//!     pub id: Uuid,\n+//!     pub email: String,\n+//!     pub created_at: DateTime<Utc>,\n+//! }\n+//! ```\n+//!\n+//! The macro will:\n+//! - Implement `DomainSafe` and `DomainModel` for the type\n+//! - Verify at compile-time that all fields are also `DomainSafe`\n+//!\n+//! # Enforcement\n+//!\n+//! Domain services can use trait bounds to ensure they only work with domain-safe types:\n+//!\n+//! ```rust,ignore\n+//! pub trait UserRepository: Send + Sync {\n+//!     type Model: DomainModel;\n+//!     \n+//!     async fn find(&self, id: Uuid) -> Result<Option<Self::Model>>;\n+//! }\n+//! ```\n+\n+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};\n+use uuid::Uuid;\n+\n+/// Marker trait for types that are safe to use in the domain layer.\n+///\n+/// Types implementing this trait are guaranteed to be free of infrastructure\n+/// dependencies such as:\n+/// - Database types (`sqlx`, `sea_orm`)\n+/// - HTTP types (http, axum, hyper)\n+/// - Framework-specific types\n+///\n+/// # Implementing\n+///\n+/// Do NOT implement this trait manually. Use the `#[domain_model]` attribute macro\n+/// which performs compile-time validation that all fields are also `DomainSafe`.\n+///\n+/// # Blanket Implementations\n+///\n+/// Common standard library and third-party types have blanket implementations:\n+/// - Primitives: `bool`, `i8`..`i128`, `u8`..`u128`, `f32`, `f64`, `char`, `String`, `&str`\n+/// - Collections: `Vec<T>`, `Option<T>`, `Result<T, E>`, `HashMap<K, V>`, etc.\n+/// - Common crates: `uuid::Uuid`, `serde_json::Value`\n+pub trait DomainSafe {}\n+\n+/// Marker trait for domain models (business entities).\n+///\n+/// Domain models represent core business concepts and should:\n+/// - Contain only business-relevant data\n+/// - Be independent of persistence mechanisms\n+/// - Be serializable for transfer between layers\n+///\n+/// # Usage\n+///\n+/// ```rust,ignore\n+/// #[domain_model]\n+/// pub struct Order {\n+///     pub id: Uuid,\n+///     pub customer_id: Uuid,\n+///     pub total: Decimal,\n+///     pub status: OrderStatus,\n+/// }\n+/// ```\n+pub trait DomainModel: DomainSafe + Send + Sync {}\n+\n+/// Marker trait for domain errors.\n+///\n+/// Domain errors represent business rule violations and should not\n+/// contain infrastructure-specific error types.\n+pub trait DomainErrorMarker: DomainSafe + std::error::Error + Send + Sync {}\n+\n+// =============================================================================\n+// Blanket implementations for primitives\n+// =============================================================================\n+\n+impl DomainSafe for () {}\n+impl DomainSafe for bool {}\n+impl DomainSafe for char {}\n+impl DomainSafe for str {}\n+impl DomainSafe for String {}\n+\n+impl DomainSafe for i8 {}\n+impl DomainSafe for i16 {}\n+impl DomainSafe for i32 {}\n+impl DomainSafe for i64 {}\n+impl DomainSafe for i128 {}\n+impl DomainSafe for isize {}\n+\n+impl DomainSafe for u8 {}\n+impl DomainSafe for u16 {}\n+impl DomainSafe for u32 {}\n+impl DomainSafe for u64 {}\n+impl DomainSafe for u128 {}\n+impl DomainSafe for usize {}\n+\n+impl DomainSafe for f32 {}\n+impl DomainSafe for f64 {}\n+\n+// =============================================================================\n+// Blanket implementations for common wrappers\n+// =============================================================================\n+\n+impl<T: DomainSafe> DomainSafe for Option<T> {}\n+impl<T: DomainSafe + ?Sized> DomainSafe for &T {}\n+impl<T: DomainSafe + ?Sized> DomainSafe for &mut T {}\n+impl<T: DomainSafe> DomainSafe for Box<T> {}\n+impl<T: DomainSafe> DomainSafe for std::sync::Arc<T> {}\n+impl<T: DomainSafe> DomainSafe for std::rc::Rc<T> {}\n+impl<T: DomainSafe, E: DomainSafe> DomainSafe for Result<T, E> {}\n+\n+// =============================================================================\n+// Blanket implementations for collections\n+// =============================================================================\n+\n+impl<T: DomainSafe> DomainSafe for Vec<T> {}\n+impl<T: DomainSafe> DomainSafe for [T] {}\n+impl<T: DomainSafe, const N: usize> DomainSafe for [T; N] {}\n+\n+impl<K: DomainSafe, V: DomainSafe, S: std::hash::BuildHasher> DomainSafe for HashMap<K, V, S> {}\n+impl<K: DomainSafe, V: DomainSafe> DomainSafe for BTreeMap<K, V> {}\n+impl<T: DomainSafe, S: std::hash::BuildHasher> DomainSafe for HashSet<T, S> {}\n+impl<T: DomainSafe> DomainSafe for BTreeSet<T> {}","path":"libs/modkit/src/domain/mod.rs","commit_id":"942840c563fc413ebd7368f7fbcff883de73bd29","original_commit_id":"d2ca80a6fd91a4672c0be9ba5ac53622dcfc1806","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Include hasher type in DomainSafe bounds for HashMap/HashSet.**\n\nLine 135 and Line 137 allow `S` to be any `BuildHasher`. That means a non-domain-safe hasher can be embedded, bypassing the “no infra dependencies” guarantee.\n\n\n<details>\n<summary>✅ Proposed fix</summary>\n\n```diff\n-impl<K: DomainSafe, V: DomainSafe, S: std::hash::BuildHasher> DomainSafe for HashMap<K, V, S> {}\n+impl<K: DomainSafe, V: DomainSafe, S: std::hash::BuildHasher + DomainSafe> DomainSafe for HashMap<K, V, S> {}\n\n-impl<T: DomainSafe, S: std::hash::BuildHasher> DomainSafe for HashSet<T, S> {}\n+impl<T: DomainSafe, S: std::hash::BuildHasher + DomainSafe> DomainSafe for HashSet<T, S> {}\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\nimpl<K: DomainSafe, V: DomainSafe, S: std::hash::BuildHasher + DomainSafe> DomainSafe for HashMap<K, V, S> {}\nimpl<K: DomainSafe, V: DomainSafe> DomainSafe for BTreeMap<K, V> {}\nimpl<T: DomainSafe, S: std::hash::BuildHasher + DomainSafe> DomainSafe for HashSet<T, S> {}\nimpl<T: DomainSafe> DomainSafe for BTreeSet<T> {}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit/src/domain/mod.rs` around lines 135 - 138, The impls for HashMap\nand HashSet currently allow any BuildHasher S, letting non-domain-safe hashers\nslip through; update the impl headers for HashMap<K, V, S> and HashSet<T, S> so\nthat S is constrained to be DomainSafe as well (e.g. S: DomainSafe +\nstd::hash::BuildHasher) while keeping K, V, T bounds unchanged; modify the impl\nlines for DomainSafe for HashMap and DomainSafe for HashSet accordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-29T08:58:09Z","updated_at":"2026-01-29T08:58:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740602679","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740602679"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740602679"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740602679/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":135,"start_side":"RIGHT","line":null,"original_line":138,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":138,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670848","pull_request_review_id":3721528131,"id":2740670848,"node_id":"PRRC_kwDOPaLyBs6jW1GA","diff_hunk":"@@ -0,0 +1,132 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+use lint_utils::{is_in_modkit_db_path, is_in_hyperspot_server_path, use_tree_to_strings};","path":"dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs","commit_id":"0ba7182026396bfdcbb70718c26b269dafc9c992","original_commit_id":"0ad50568fe86ac69d56f4eeee63b3429f7ea33fd","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# Search for is_in_contract_module_ast function definition and usage\nrg -n \"is_in_contract_module_ast\" -A 3 -B 1\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1776\n\n---\n\n🏁 Script executed:\n\n```shell\n# Read the target file to understand its current structure\ncat -n dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 4375\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the lint_utils crate to confirm available helpers\nfd \"lint_utils\" -t d | head -5\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 88\n\n---\n\n🏁 Script executed:\n\n```shell\n# Verify the exact parameter types by looking at the helper definition more closely\nrg -n \"pub fn is_in_contract_module_ast\" -A 2 dylint_lints/lint_utils/src/lib.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 235\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the usage example to confirm correct invocation pattern\nrg -n \"is_in_contract_module_ast(cx, item)\" -B 2 -A 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n\n\n</details>\n\n**Skip contract modules using the correct helper signature.**  \nAdd the contract-module guard so contract/ definitions are not linted. The helper takes `EarlyContext` directly, not `cx.sess().source_map()`.\n\n<details>\n<summary>🔧 Proposed fix</summary>\n\n```diff\n-use lint_utils::{is_in_modkit_db_path, is_in_hyperspot_server_path, use_tree_to_strings};\n+use lint_utils::{\n+    is_in_contract_module_ast,\n+    is_in_modkit_db_path,\n+    is_in_hyperspot_server_path,\n+    use_tree_to_strings,\n+};\n\n impl EarlyLintPass for De0706NoDirectSqlx {\n     fn check_item(&mut self, cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+        if is_in_contract_module_ast(cx, item) {\n+            return;\n+        }\n+\n         // Skip libs/modkit-db/ - this is the internal wrapper library\n         // that legitimately uses sqlx to provide the abstraction layer\n         if is_in_modkit_db_path(cx.sess().source_map(), item.span) {\n             return;\n         }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs` at line 8, Add a\nguard to skip contract modules alongside the existing is_in_modkit_db_path and\nis_in_hyperspot_server_path checks so contract/ definitions are not linted, and\nupdate the helper call that currently passes cx.sess().source_map() to instead\npass the EarlyContext directly (the helper expects EarlyContext). Locate the\ncode around use_tree_to_strings and the existing is_in_modkit_db_path /\nis_in_hyperspot_server_path checks, add the contract-module guard there, and\nchange the helper invocation to accept the EarlyContext (cx) rather than\ncx.sess().source_map().\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits cec5300 to 1a7988c","created_at":"2026-01-29T09:16:51Z","updated_at":"2026-02-02T19:52:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740670848","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670848"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740670848"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":8,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670855","pull_request_review_id":3721528131,"id":2740670855,"node_id":"PRRC_kwDOPaLyBs6jW1GH","diff_hunk":"@@ -0,0 +1,132 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+use lint_utils::{is_in_modkit_db_path, is_in_hyperspot_server_path, use_tree_to_strings};\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Prohibits direct usage of the `sqlx` crate. Projects should use Sea-ORM\n+    /// or SecORM abstractions instead for database operations.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Direct sqlx usage bypasses important architectural layers:\n+    /// - Skips security enforcement (SecureConn, AccessScope)\n+    /// - Bypasses query building abstractions and type safety\n+    /// - Makes it harder to maintain consistent patterns across the codebase\n+    /// - Loses automatic audit logging and tenant isolation\n+    ///\n+    /// ### Known Exclusions\n+    ///\n+    /// This lint does NOT apply to `libs/modkit-db/` which is the internal\n+    /// wrapper library that provides the Sea-ORM/SecORM abstraction layer.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - direct sqlx usage\n+    /// use sqlx::PgPool;\n+    /// sqlx::query(\"SELECT * FROM users\").fetch_all(&pool).await?;\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - use Sea-ORM with SecureConn\n+    /// use sea_orm::EntityTrait;\n+    /// UserEntity::find().secure().scope_with(&scope).all(conn).await?;\n+    /// ```\n+    pub DE0706_NO_DIRECT_SQLX,\n+    Deny,\n+    \"direct sqlx usage is prohibited; use Sea-ORM or SecORM instead (DE0706)\"\n+}\n+\n+/// Sqlx crate pattern to detect\n+const SQLX_PATTERN: &str = \"sqlx\";\n+\n+fn starts_with_sqlx(tree: &rustc_ast::UseTree) -> bool {\n+    if let Some(first_seg) = tree.prefix.segments.first() {\n+        return first_seg.ident.name.as_str() == SQLX_PATTERN;\n+    }\n+    false\n+}\n+\n+fn check_use_for_sqlx(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    if starts_with_sqlx(use_tree) {\n+        let paths = use_tree_to_strings(use_tree);\n+        let path_str = paths.first().map(|s| s.as_str()).unwrap_or(\"sqlx\");\n+        cx.span_lint(DE0706_NO_DIRECT_SQLX, item.span, |diag| {\n+            diag.primary_message(format!(\n+                \"direct sqlx import detected: `{}` (DE0706)\",\n+                path_str\n+            ));\n+            diag.help(\"use Sea-ORM EntityTrait or SecORM abstractions instead\");\n+            diag.note(\"sqlx bypasses security enforcement and architectural patterns\");\n+        });\n+    }\n+}","path":"dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs","commit_id":"db886828e584356ee5ed658949981916611c663c","original_commit_id":"0ad50568fe86ac69d56f4eeee63b3429f7ea33fd","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Catch grouped `use` imports to avoid a sqlx bypass.**  \n`starts_with_sqlx` only checks the top-level prefix, so grouped imports like `use {sqlx::PgPool, other};` (empty prefix) can slip through. Consider scanning all paths from `use_tree_to_strings` and matching any path whose first segment is `sqlx`.\n\n<details>\n<summary>🔧 Proposed fix</summary>\n\n```diff\n-fn starts_with_sqlx(tree: &rustc_ast::UseTree) -> bool {\n-    if let Some(first_seg) = tree.prefix.segments.first() {\n-        return first_seg.ident.name.as_str() == SQLX_PATTERN;\n-    }\n-    false\n-}\n+fn find_sqlx_path(tree: &rustc_ast::UseTree) -> Option<String> {\n+    use_tree_to_strings(tree)\n+        .into_iter()\n+        .find(|path| path.split(\"::\").next() == Some(SQLX_PATTERN))\n+}\n\n fn check_use_for_sqlx(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n     let ItemKind::Use(use_tree) = &item.kind else {\n         return;\n     };\n \n-    if starts_with_sqlx(use_tree) {\n-        let paths = use_tree_to_strings(use_tree);\n-        let path_str = paths.first().map(|s| s.as_str()).unwrap_or(\"sqlx\");\n+    if let Some(path_str) = find_sqlx_path(use_tree) {\n         cx.span_lint(DE0706_NO_DIRECT_SQLX, item.span, |diag| {\n             diag.primary_message(format!(\n                 \"direct sqlx import detected: `{}` (DE0706)\",\n                 path_str\n             ));\n             diag.help(\"use Sea-ORM EntityTrait or SecORM abstractions instead\");\n             diag.note(\"sqlx bypasses security enforcement and architectural patterns\");\n         });\n     }\n }\n```\n</details>\n\n\n```web\nrustc_ast UseTree representation for grouped imports like `use {sqlx::PgPool, other};` and whether tree.prefix.segments is empty\n```\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs` around lines 49\n- 76, The current check_use_for_sqlx relies on starts_with_sqlx which inspects\ntree.prefix.segments and misses grouped imports; instead, call\nuse_tree_to_strings(use_tree) inside check_use_for_sqlx and iterate all returned\npath strings, splitting or parsing each path to check whether its first segment\nequals SQLX_PATTERN, and if any match emit DE0706_NO_DIRECT_SQLX with the same\ndiagnostic text; alternatively refactor starts_with_sqlx to accept the vector of\npaths from use_tree_to_strings and return true if any path's first segment ==\nSQLX_PATTERN, then use that helper in check_use_for_sqlx.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 942840c","created_at":"2026-01-29T09:16:51Z","updated_at":"2026-01-29T09:31:21Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740670855","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670855"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740670855"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740670855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":52,"original_start_line":49,"start_side":"RIGHT","line":169,"original_line":76,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":76,"position":169,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740744043","pull_request_review_id":3677253114,"id":2740744043,"node_id":"PRRC_kwDOPaLyBs6jXG9r","diff_hunk":"@@ -0,0 +1,264 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, Ty, TyKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+use lint_utils::{is_in_domain_path, use_tree_to_strings};\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not import infrastructure dependencies.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should contain pure business logic and depend only on abstractions (ports),\n+    /// not concrete implementations. Importing infrastructure code (database, HTTP, external APIs)\n+    /// violates the Dependency Inversion Principle and makes domain logic harder to test.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust\n+    /// // Bad - infrastructure imports in domain\n+    /// mod domain {\n+    ///     use crate::infra::storage::UserRepository;  // ❌ concrete implementation\n+    ///     use sea_orm::*;  // ❌ database framework\n+    ///     use sqlx::*;     // ❌ database driver\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust\n+    /// // Good - domain depends on abstractions\n+    /// mod domain {\n+    ///     use std::sync::Arc;\n+    ///     \n+    ///     pub trait UsersRepository: Send + Sync {\n+    ///         async fn find_by_id(&self, id: Uuid) -> Result<User, DomainError>;\n+    ///     }\n+    ///     \n+    ///     pub struct Service {\n+    ///         repo: Arc<dyn UsersRepository>,  // ✅ trait object\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0301_NO_INFRA_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not import infrastructure dependencies (DE0301)\"\n+}\n+\n+/// Forbidden import patterns for domain layer\n+const INFRA_PATTERNS: &[&str] = &[\n+    // Infrastructure layer\n+    \"crate::infra\",\n+    \"crate::infrastructure\",\n+    // Database frameworks (direct access forbidden, use modkit_db abstractions instead)\n+    \"sea_orm\",\n+    \"sqlx\",\n+    // HTTP/Web frameworks (only used ones: axum, hyper, http)\n+    \"axum\",\n+    \"hyper\",\n+    \"http::\",","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/src/lib.rs","commit_id":"1a7988cf25d027b7bb84d79950dddb0d73e604d7","original_commit_id":"942840c563fc413ebd7368f7fbcff883de73bd29","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"The pattern `\"http::\"` with trailing `::` will NOT match bare imports like `use http;`. This allows developers to bypass the lint by importing the http crate directly without a path qualifier.\n\n```rust\n// Current pattern \"http::\" catches:\nuse http::StatusCode;  // ✓ Caught\n\n// But misses:\nuse http;  // ✗ NOT caught - path_str is \"http\", doesn't start with \"http::\"\nuse http::*;  // ✗ NOT caught - path_str is \"http\"\n```\n\nFix by changing the pattern to:\n```rust\n\"http\",  // without trailing ::\n```\n\nThis will catch all http crate imports including bare `use http;` statements.\n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/253?chatWithGeneratedComment=af778f51-1243-45b9-b3c7-905a0a5b06a8\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-29T09:35:28Z","updated_at":"2026-01-29T09:35:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740744043","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740744043"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2740744043"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740744043/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":64,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":64,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740744101","pull_request_review_id":3677253114,"id":2740744101,"node_id":"PRRC_kwDOPaLyBs6jXG-l","diff_hunk":"@@ -0,0 +1,251 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, Ty, TyKind};\n+use rustc_lint::{EarlyContext, EarlyLintPass, LintContext};\n+use lint_utils::{is_in_domain_path, use_tree_to_strings};\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not reference HTTP types or status codes.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should be transport-agnostic. HTTP is just one possible\n+    /// transport layer. Referencing HTTP types in domain code couples the business\n+    /// logic to a specific transport mechanism.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - HTTP types in domain\n+    /// mod domain {\n+    ///     use http::StatusCode;\n+    ///     \n+    ///     pub fn check_result() -> StatusCode {\n+    ///         StatusCode::OK  // ❌ HTTP-specific\n+    ///     }\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - domain errors converted in API layer\n+    /// mod domain {\n+    ///     pub enum DomainResult {\n+    ///         Success,\n+    ///         NotFound,\n+    ///         InvalidData,\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0308_NO_HTTP_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not reference HTTP types or status codes (DE0308)\"\n+}\n+\n+/// HTTP-related patterns forbidden in domain code\n+/// Only includes frameworks actually used in the project: axum, hyper, http\n+const HTTP_PATTERNS: &[&str] = &[\n+    \"http::\",","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs","commit_id":"1a7988cf25d027b7bb84d79950dddb0d73e604d7","original_commit_id":"942840c563fc413ebd7368f7fbcff883de73bd29","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%
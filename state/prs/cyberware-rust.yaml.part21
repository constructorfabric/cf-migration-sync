rSettings, SimpleUserSettingsPatch};\n+\n+use crate::domain::repo::SettingsRepository;\n+\n+use super::entity::{self, Entity as SettingsEntity};\n+\n+pub struct SeaOrmSettingsRepository {\n+    db: SecureConn,\n+}\n+\n+impl SeaOrmSettingsRepository {\n+    #[must_use]\n+    pub fn new(db: SecureConn) -> Self {\n+        Self { db }\n+    }\n+\n+    async fn upsert(&self, model: entity::ActiveModel) -> anyhow::Result<()> {\n+        SettingsEntity::insert(model)\n+            .on_conflict(\n+                OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n+                    .update_columns([entity::Column::Theme, entity::Column::Language])\n+                    .to_owned(),\n+            )\n+            .exec(self.db.conn())\n+            .await?;\n+        Ok(())\n+    }\n+}\n+\n+#[async_trait]\n+impl SettingsRepository for SeaOrmSettingsRepository {\n+    async fn find_by_user(\n+        &self,\n+        ctx: &SecurityContext,\n+    ) -> anyhow::Result<Option<SimpleUserSettings>> {\n+        let tenant_id = ctx.tenant_id();\n+        let scope = AccessScope::both(vec![tenant_id], vec![ctx.subject_id()]);\n+\n+        let result = self\n+            .db\n+            .find::<SettingsEntity>(&scope)\n+            .one(self.db.conn())\n+            .await?;\n+\n+        Ok(result.map(Into::into))\n+    }\n+\n+    async fn upsert_full(\n+        &self,\n+        ctx: &SecurityContext,\n+        theme: Option<String>,\n+        language: Option<String>,\n+    ) -> anyhow::Result<SimpleUserSettings> {\n+        let user_id = ctx.subject_id();\n+        let tenant_id = ctx.tenant_id();\n+\n+        let active_model = entity::ActiveModel {\n+            tenant_id: ActiveValue::Set(tenant_id),\n+            user_id: ActiveValue::Set(user_id),\n+            theme: ActiveValue::Set(theme.clone()),\n+            language: ActiveValue::Set(language.clone()),\n+        };\n+\n+        self.upsert(active_model).await?;\n+\n+        Ok(SimpleUserSettings {\n+            user_id,\n+            tenant_id,\n+            theme,\n+            language,\n+        })\n+    }\n+\n+    async fn upsert_patch(\n+        &self,\n+        ctx: &SecurityContext,\n+        patch: SimpleUserSettingsPatch,\n+    ) -> anyhow::Result<SimpleUserSettings> {\n+        let user_id = ctx.subject_id();\n+        let tenant_id = ctx.tenant_id();\n+        let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n+\n+        let existing = self","path":"modules/simple-user-settings/simple-user-settings/src/infra/storage/sea_orm_repo.rs","commit_id":"0eb00141e0dbb376fab73e812618ecde0b320974","original_commit_id":"0eb00141e0dbb376fab73e812618ecde0b320974","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"upsert_patch performs a read-before-write (SELECT + UPSERT) for no reason.\r\nAt least it should be done in transaction","created_at":"2026-01-19T14:26:38Z","updated_at":"2026-01-19T14:29:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704993397","pull_request_url":"https://a
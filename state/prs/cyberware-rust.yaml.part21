abric/cyberware-rust/pulls/comments/2693494346"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693494346"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693494346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":32,"side":"RIGHT","author_association":"MEMBER","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693499795","pull_request_review_id":3664519464,"id":2693499795,"node_id":"PRRC_kwDOPaLyBs6gi4uT","diff_hunk":"@@ -0,0 +1,88 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https
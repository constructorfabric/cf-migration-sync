ule_name) {\n+            module_entry.insert(\n+                \"runtime\".to_owned(),\n+                json!({\n+                    \"type\": match runtime_config.mod_type {\n+                        RuntimeKind::Local => \"local\",\n+                        RuntimeKind::Oop => \"oop\",\n+                    }\n+                }),\n+            );\n+        }\n+\n+        // Get module config section (the \"config\" field)\n+        if let Ok(module_config) = parse_module_config(app, module_name) {\n+            if !module_config.config.is_null() {\n+                module_entry.insert(\"config\".to_owned(), module_config.config);\n+            }\n+        }\n+\n+        // Get database configuration (resolved DSN + pool)\n+        if let Ok(Some((dsn, pool))) = build_final_db_for_module(app, module_name, &home_dir) {\n+            // Redact password in DSN\n+            let redacted_dsn = redact_dsn_password(&dsn)?;\n+\n+            let mut db_config = serde_json::Map::new();\n+            db_config.insert(\"dsn\".to_owned(), json!(redacted_dsn));\n+\n+            // Add pool configuration if present\n+            let mut pool_map = serde_json::Map::new();\n+            if let Some(max_conns) = pool.max_conns {\n+                pool_map.insert(\"max_conns\".to_owned(), json!(max_conns));\n+            }\n+            if let Some(min_conns) = pool.min_conns {\n+                pool_map.insert(\"min_conns\".to_owned(), json!(min_conns));\n+            }\n+            if let Some(acquire_timeout) = pool.acquire_timeout {\n+                pool_map.insert(\n+                    \"acquire_timeout\".to_owned(),\n+                    json!(format!(\"{}s\", acquire_timeout.as_secs())),\n+                );\n+            }\n+            if let Some(idle_timeout) = pool.idle_timeout {\n+                pool_map.insert(\n+                    \"idle_timeout\".to_owned(),\n+                    json!(format!(\"{}s\", idle_timeout.as_secs())),\n+                );\n+            }\n+            if let Some(max_lifetime) = pool.max_lifetime {\n+                pool_map.insert(\n+                    \"max_lifetime\".to_owned(),\n+                    json!(format!(\"{}s\", max_lifetime.as_secs())),\n+                );\n+            }\n+            if let Some(test_before_acquire) = pool.test_before_acquire {\n+                pool_map.insert(\"test_before_acquire\".to_owned(), json!(test_before_acquire));\n+            }\n+\n+            if !pool_map.is_empty() {\n+                db_config.insert(\"pool\".to_owned(), json!(pool_map));\n+            }\n+\n+            module_entry.insert(\"database\".to_owned(), json!(db_config));\n+        }","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"48074954f35cfc129a652af967b3c2cf0bfe25e5","original_commit_id":"9c16f61d4db6494b01082cf02efec880f54f3323","user":{"login":"bit8shift","id":253408973,"node_id":"U_kgDODxq2zQ","avatar_url":"https://avatars.githubusercontent.com/u/253408973?v=4","gravatar_id":"","url":"https://api.github.com/users/bit8shift","html_url":"https://github.com/bit8shift","followers_url":"https://api.github.com/users/bit8shift/followers","following_url":"https://api.github.com/users/bit8shift/following{/other_user}","gists_url":"https://api.github.com/users/bit8shift/gists{/gist_id}","starred_url":"https://api.github.com/users/bit8shift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bit8shift/subscriptions","organizations_url":"https://api.github.com/users/bit8shift/orgs","repos_url":"https://api.github.com/users/bit8shift/repos","events_url":"https://api.github.com/users/bit8shift/events{/privacy}","received_events_url":"https://api.github.com/users/bit8shift/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"instead of silently skipping there are two options\r\n```\r\nstrict (fail on first error)\r\nlenient (warn and continue)\r\n```\r\nI will go with `lenient (warn and continue)` instead of silently skipping","created_at":"2026-01-19T10:57:01Z","updated_at":"2026-01-19T10:57:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704259051","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704259051"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704259051"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704259051/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":1198,"start_side":"RIGHT","line":null,"original_line":1265,"side":"RIGHT","in_reply_to_id":2704175470,"author_association":"MEMBER","original_position":113,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704261322","pull_request_review_id":3677489191,"id":2704261322,"node_id":"PRRC_kwDOPaLyBs6hL8DK","diff_hunk":"@@ -1153,6 +1153,173 @@ pub fn module_home(app: &AppConfig, module_name: &str) -> PathBuf {\n     PathBuf::from(&app.server.home_dir).join(module_name)\n }\n \n+// ---- Effective Module Configuration Dump Support ----\n+\n+/// List all module names present in the configuration.\n+///\n+/// Returns a sorted vector of module names that are configured in the `AppConfig`.\n+/// This is useful for discovering available modules before dumping their configuration.\n+///\n+/// # Example\n+/// ```no_run\n+/// use modkit::bootstrap::AppConfig;\n+/// # fn example(config: &AppConfig) {\n+/// let modules = modkit::bootstrap::config::list_module_names(config);\n+/// for module in modules {\n+///     println!(\"Module: {}\", module);\n+/// }\n+/// # }\n+/// ```\n+#[must_use]\n+pub fn list_module_names(app: &AppConfig) -> Vec<String> {\n+    let mut names: Vec<String> = app.modules.keys().cloned().collect();\n+    names.sort();\n+    names\n+}\n+\n+/// Render effective configuration for all loaded modules.\n+///\n+/// This function builds a complete view of the effective runtime configuration\n+/// for each module that is successfully loaded in the `ModuleRegistry`.\n+///\n+/// For each module, it includes:\n+/// - `runtime`: Module runtime type (local/oop) if configured\n+/// - `config`: Module-specific configuration section (as-is from config file)\n+/// - `database`: Final resolved database configuration with redacted DSN (if applicable)\n+///\n+/// # Errors\n+/// Returns an error if configuration parsing or database resolution fails.\n+pub fn render_effective_modules_config(app: &AppConfig) -> Result<serde_json::Value> {\n+    use serde_json::json;\n+\n+    let home_dir = PathBuf::from(&app.server.home_dir);\n+    let mut modules_config = serde_json::Map::new();\n+\n+    // Iterate over all modules in the configuration\n+    for module_name in app.modules.keys() {\n+        let mut module_entry = serde_json::Map::new();\n+\n+        // Get runtime configuration if present\n+        if let Ok(Some(runtime_config)) = get_module_runtime_config(app, module_name) {\n+            module_entry.insert(\n+                \"runtime\".to_owned(),\n+                json!({\n+                    \"type\": match runtime_config.mod_type {\n+                        RuntimeKind::Local => \"local\",\n+                        RuntimeKind::Oop => \"oop\",\n+                    }\n+                }),\n+            );\n+        }\n+\n+        // Get module config section (the \"config\" field)\n+        if let Ok(module_config) = parse_module_config(app, module_name) {\n+            if !module_config.config.is_null() {\n+                module_entry.insert(\"config\".to_owned(), module_config.config);\n+            }\n+        }\n+\n+        // Get database configuration (resolved DSN + pool)\n+        if let Ok(Some((dsn, pool))) = build_final_db_for_module(app, module_name, &home_dir) {\n+            // Redact password in DSN\n+            let redacted_dsn = redact_dsn_password(&dsn)?;\n+\n+            let mut db_config = serde_json::Map::new();\n+            db_config.insert(\"dsn\".to_owned(), json!(redacted_dsn));\n+\n+            // Add pool configuration if present\n+            let mut pool_map = serde_json::Map::new();\n+            if let Some(max_conns) = pool.max_conns {\n+                pool_map.insert(\"max_conns\".to_owned(), json!(max_conns));\n+            }\n+            if let Some(min_conns) = pool.min_conns {\n+                pool_map.insert(\"min_conns\".to_owned(), json!(min_conns));\n+            }\n+            if let Some(acquire_timeout) = pool.acquire_timeout {\n+                pool_map.insert(\n+                    \"acquire_timeout\".to_owned(),\n+                    json!(format!(\"{}s\", acquire_timeout.as_secs())),\n+                );\n+            }\n+            if let Some(idle_timeout) = pool.idle_timeout {\n+                pool_map.insert(\n+                    \"idle_timeout\".to_owned(),\n+                    json!(format!(\"{}s\", idle_timeout.as_secs())),\n+                );\n+            }\n+            if let Some(max_lifetime) = pool.max_lifetime {\n+                pool_map.insert(\n+                    \"max_lifetime\".to_owned(),\n+                    json!(format!(\"{}s\", max_lifetime.as_secs())),\n+                );\n+            }\n+            if let Some(test_before_acquire) = pool.test_before_acquire {\n+                pool_map.insert(\"test_before_acquire\".to_owned(), json!(test_before_acquire));\n+            }\n+\n+            if !pool_map.is_empty() {\n+                db_config.insert(\"pool\".to_owned(), json!(pool_map));\n+            }\n+\n+            module_entry.insert(\"database\".to_owned(), json!(db_config));\n+        }","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"48074954f35cfc129a652af967b3c2cf0bfe25e5","original_commit_id":"9c16f61d4db6494b01082cf02efec880f54f3323","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@bit8shift`, that sounds like a good approach for a diagnostic feature! The lenient strategy will make the dump more robust when individual modules have configuration issues.\n\nFor the implementation, you could use `tracing::warn!` to log errors while continuing:\n\n```rust\n// Get runtime configuration if present\nmatch get_module_runtime_config(app, module_name) {\n    Ok(Some(runtime_config)) => {\n        module_entry.insert(\n            \"runtime\".to_owned(),\n            json!({\n                \"type\": match runtime_config.mod_type {\n                    RuntimeKind::Local => \"local\",\n                    RuntimeKind::Oop => \"oop\",\n                }\n            }),\n        );\n    }\n    Err(e) => {\n        tracing::warn!(\"Failed to get runtime config for module '{}': {}\", module_name, e);\n    }\n    Ok(None) => {} // No runtime config\n}\n```\n\nSimilarly for `parse_module_config` and `build_final_db_for_module`. This way, users will see warnings in logs about problematic modules while still getting partial results from the dump.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: bit8shift\nRepo: hypernetix/hyperspot PR: 277\nFile: libs/modkit/src/bootstrap/config/mod.rs:1198-1265\nTimestamp: 2026-01-19T10:57:35.386Z\nLearning: In libs/modkit/src/bootstrap/config/mod.rs, the render_effective_modules_config function should use lenient error handling (warn and continue) rather than strict fail-fast, to provide partial configuration dumps even when individual modules have issues.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-19T10:57:41Z","updated_at":"2026-01-19T10:57:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704261322","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704261322"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704261322"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704261322/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1198,"start_side":"RIGHT","line":null,"original_line":1265,"side":"RIGHT","in_reply_to_id":2704175470,"author_association":"CONTRIBUTOR","original_position":113,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704414584","pull_request_review_id":3677680567,"id":2704414584,"node_id":"PRRC_kwDOPaLyBs6hMhd4","diff_hunk":"","path":"modules/system/api_gateway/assets/elements/web-components.min.js","commit_id":"41852522b60c7d9a3a0c14ba9930a0254dbd528c","original_commit_id":"17b5ad6cdcc032579866687a94f87147d7eb0da8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Shouldn't be in this PR. Looks like it's cargo fmt --all redundant artefact","created_at":"2026-01-19T11:41:49Z","updated_at":"2026-01-19T12:05:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704414584","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704414584"},"html":{"href":"https://github.com/cyberfabric/cybe
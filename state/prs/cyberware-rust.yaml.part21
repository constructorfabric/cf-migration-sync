5:00:00Z","updated_at":"2026-01-30T15:07:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/218#discussion_r2746694421","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746694421"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/218#discussion_r2746694421"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2746694421/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":12,"original_start_line":12,"start_side":"RIGHT","line":20,"original_line":20,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":20,"position":20,"subject_type":"line"}],"source_reviews":[{"id":3721394965,"node_id":"PRR_kwDOPaLyBs7dz_sV","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 4**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (2)</summary><blockquote>\n> \n> <details>\n> <summary>examples/plugin-modules/tenant_resolver/tenant_resolver-gw/src/module.rs (2)</summary><blockquote>\n> \n> `30-37`: **Hard plugin deps contradict dynamic-discovery note.**\n> \n> Line 30-34 says the gateway does **not** declare hard dependencies, but Line 36-37 now does. This makes plugins mandatory and conflicts with the documented discovery/build model.\n> \n> \n> <details>\n> <summary>🔧 Proposed fix (keep dynamic discovery)</summary>\n> \n> ```diff\n> -    deps = [\"types_registry\", \"types\", \"contoso_tr_plugin\", \"fabrikam_tr_plugin\"],\n> +    deps = [\"types_registry\", \"types\"],\n> ```\n> \n> </details>\n> \n> If the intent is to hard-wire these plugins, please update the doc block to avoid misleading downstream users.\n> \n> ---\n> \n> `56-60`: **Update log module name to match rename.**\n> \n> Line 59 still logs the old module name, which can confuse diagnostics.\n> \n> \n> <details>\n> <summary>🧾 Proposed fix</summary>\n> \n> ```diff\n> -        info!(vendor = %cfg.vendor, \"Initializing tenant_resolver_gateway\");\n> +        info!(vendor = %cfg.vendor, \"Initializing tenant_resolver_gw\");\n> ```\n> \n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit/build.rs`:\n- Line 55: The current build script only prints\nprintln!(\"cargo:rerun-if-changed=schemas/\") which does not detect content\nchanges; update the build.rs logic to walk the schemas directory (e.g., iterate\nover std::fs::read_dir(\"schemas\") or use glob) and emit a separate\nprintln!(\"cargo:rerun-if-changed={}\", path) for each schema file found and also\nemit one for the manifest (e.g., \"Cargo.toml\"); replace or augment the existing\nprintln!(\"cargo:rerun-if-changed=schemas/\") line so each individual file is\nregistered for rerun rather than only the directory.\n\nIn `@libs/modkit/src/gts/schemas.rs`:\n- Around line 20-44: The current loader silently returns an empty Vec when no\n.schema.json files are present; after iterating archive in the function that\nbuilds `schemas` (using `zip_data`, `archive`, loop over `archive.by_index(i)`\nand pushing into `schemas`), add a check after the loop that returns an error\nvia anyhow (e.g., `Err(anyhow::anyhow!(...))`) when `schemas.is_empty()` so the\nfunction fails fast with a clear message like \"no core GTS schemas found in\nembedded archive\".\n\nIn `@modules/system/types-registry/types-registry/src/module.rs`:\n- Around line 26-30: The doc note in types-registry's module.rs incorrectly\nreferences `modkit_framework` for core GTS type registration; update the\nsentence to state that core types (e.g., `BaseModkitPluginV1`) are now\nregistered by the `modules/system/types` module (or simply `types` module) to\nreflect the PR move and avoid confusion about ownership.\n\nIn `@modules/system/types/Cargo.toml`:\n- Around line 1-28: The package currently exposes a single \"types\" crate; split\nit into a public SDK crate and an implementation crate by creating\nmodules/system/types-sdk with public API traits, domain models and error types\n(mirroring the types-registry-sdk pattern) and refactoring modules/system/types\nto depend on types-sdk and implement domain/, infra/, and api/ layers; update\nthe Cargo.toml entries so the workspace contains both a types-sdk crate (exports\nmodels/errors/api traits) and a types crate (path \"src/lib.rs\" -> implementation\nthat depends on types-sdk and on types-registry-sdk, modkit and\nmodkit-security), and move any public type definitions and errors out of the\nexisting types crate into types-sdk while keeping only implementation code in\ntypes.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>libs/modkit/build.rs (1)</summary><blockquote>\n\n`28-50`: **Sort schema entries for deterministic ZIP output.**\n\n`read_dir` order is non-deterministic, which can cause noisy rebuilds and non-reproducible archives. Sorting entries makes the output stable.\n\n<details>\n<summary>♻️ Suggested change</summary>\n\n```diff\n-    if Path::new(schemas_dir).exists() {\n-        for entry in std::fs::read_dir(schemas_dir)? {\n-            let entry = entry?;\n-            let path = entry.path();\n+    if Path::new(schemas_dir).exists() {\n+        let mut entries: Vec<_> = std::fs::read_dir(schemas_dir)?\n+            .collect::<Result<_, _>>()?;\n+        entries.sort_by_key(|e| e.path());\n+        for entry in entries {\n+            let path = entry.path();\n             if path.extension().and_then(|s| s.to_str()) == Some(\"json\")\n                 && path\n                     .file_name()\n                     .and_then(|s| s.to_str())\n                     .is_some_and(|s| s.contains(\".schema.\"))\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/218#pullrequestreview-3721394965","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/218#pullrequestreview-3721394965"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218"}},"submitted_at":"2026-01-29T08:44:57Z","commit_id":"71df33126e5293e3004d91d8ec0144e88da746bc"},{"id":3724044315,"node_id":"PRR_kwDOPaLyBs7d-Ggb","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 2**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@examples/plugin-modules/tenant_resolver/tenant_resolver-gw/src/module.rs`:\n- Around line 35-38: The module attribute for tenant_resolver_gw currently\nhard-codes plugin dependencies in the deps list (specifically\n\"contoso_tr_plugin\" and \"fabrikam_tr_plugin\"), which contradicts the gateway\ndocs that require dynamic plugin discovery; remove those two plugin entries from\nthe deps array in the #[modkit::module(...)] attribute (leave \"types_registry\"\nand \"types\" as needed) so the gateway does not force presence of those plugins,\nor alternatively update module docs/behavior if you intentionally want hard\ncoupling—refer to the #[modkit::module(name = \"tenant_resolver_gw\", deps =\n[...])] declaration to make the change.\n\nIn `@modules/system/types/Cargo.toml`:\n- Around line 1-32: The Cargo manifest for the implementation crate named\n\"types\" is missing the publish safeguard; open the [package] section of the\nCargo.toml for the types crate and add publish = false so the implementation\ncrate cannot be published (leave the SDK crate types-sdk unchanged); update the\n[package] block containing name = \"types\" accordingly.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (2)</summary><blockquote>\n\n<details>\n<summary>libs/modkit/Cargo.toml (1)</summary><blockquote>\n\n`87-88`: **Align `zip` versions between runtime and build deps.**\n\nDifferent versions can pull duplicate crates and diverging APIs/features. Recommend pinning both to the same version.  \n\n\n<details>\n<summary>Proposed diff (align to 2.2)</summary>\n\n```diff\n-zip = { version = \"2.1\", default-features = false, features = [\"deflate\"] }\n+zip = { version = \"2.2\", default-features = false, features = [\"deflate\"] }\n\n [build-dependencies]\n-zip = { version = \"2.2\", default-features = false, features = [\"deflate\"] }\n+zip = { version = \"2.2\", default-features = false, features = [\"deflate\"] }\n```\n</details>\n\n\nAlso applies to: 116-117\n\n</blockquote></details>\n<details>\n<summary>examples/plugin-modules/tenant_resolver/plugins/fabrikam_tr_plugin/Cargo.toml (1)</summary><blockquote>\n\n`17-17`: **Consider using workspace dependency for consistency.**\n\nThe `types` dependency uses a direct path while other dependencies in this file use `{ workspace = true }`. If `types` is already a workspace member, consider adding it to `[workspace.dependencies]` in the root `Cargo.toml` and referencing it here as `types = { workspace = true }` for consistency.\n\n\n<details>\n<summary>♻️ Suggested change</summary>\n\n```diff\n-types = { path = \"../../../../../modules/system/types\" }\n+types = { workspace = true }\n```\n\nThis requires adding the following to the root `Cargo.toml` under `[workspace.dependencies]`:\n```toml\ntypes = { path = \"modules/system/types\" }\n```\n</details>\n\nBased on learnings: \"If the task adds/changes dependencies (Cargo.toml), introduces a new crate... open `@/guidelines/DEPENDENCIES.md`\" — please verify this aligns with the project's dependency guidelines.\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/218#pullrequestreview-3724044315","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/218#pullrequestreview-3724044315"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218"}},"submitted_at":"2026-01-29T17:16:26Z","commit_id":"dab863e0a96e3be53ab8ab92387f6d2aba8328df"},{"id":3728749780,"node_id":"PRR_kwDOPaLyBs7eQDTU","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n<
ne":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740554453","pull_request_review_id":3721394965,"id":2740554453,"node_id":"PRRC_kwDOPaLyBs6jWYrV","diff_hunk":"@@ -0,0 +1,57 @@\n+use std::env;\n+use std::fs::File;\n+use std::io::prelude::*;\n+use std::path::Path;\n+\n+fn main() -> Result<(), Box<dyn std::error::Error>> {\n+    let out_dir = env::var(\"OUT_DIR\")?;\n+    let dest_path = Path::new(&out_dir).join(\"core_gts_schemas.zip\");\n+\n+    // Create ZIP archive containing all schema files\n+    let file = File::create(&dest_path)?;\n+    let mut zip = zip::ZipWriter::new(file);\n+\n+    let schemas_dir = \"schemas\";\n+\n+    // Add manifest.json\n+    let manifest_path = Path::new(schemas_dir).join(\"manifest.json\");\n+    if manifest_path.exists() {\n+        let buffer = std::fs::read(&manifest_path)?;\n+\n+        let options = zip::write::FileOptions::<()>::default()\n+            .compression_method(zip::CompressionMethod::Deflated)\n+            .unix_permissions(0o755);\n+        zip.start_file(\"manifest.json\", options)?;\n+        zip.write_all(&buffer)?;\n+    }\n+\n+    // Add all .schema.json files\n+    if Path::new(schemas_dir).exists() {\n+        for entry in std::fs::read_dir(schemas_dir)? {\n+            let entry = entry?;\n+            let path = entry.path();\n+            if path.extension().and_then(|s| s.to_str()) == Some(\"json\")\n+                && path\n+                    .file_name()\n+                    .and_then(|s| s.to_str())\n+                    .is_some_and(|s| s.contains(\".schema.\"))\n+            {\n+                let buffer = std::fs::read(&path)?;\n+\n+                let Some(file_name) = path.file_name().and_then(|s| s.to_str()) else {\n+                    continue;\n+                };\n+                let options = zip::write::FileOptions::<()>::default()\n+                    .compression_method(zip::CompressionMethod::Deflated)\n+                    .unix_permissions(0o755);\n+                zip.start_file(file_name, options)?;\n+                zip.write_all(&buffer)?;\n+            }\n+        }\n+    }\n+\n+    zip.finish()?;\n+\n+    println!(\"cargo:rerun-if-changed=schemas/\");","path":"libs/modkit/build.rs","commit_id":"71df33126e5293e3004d91d8ec0144e88da746bc","original_commit_id":"71df33126e5293e3004d91d8ec0144e88da746bc","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Rerun trigger should watch schema files, not just the directory.**\n\n`cargo:rerun-if-changed=schemas/` won’t rerun when file contents change (only on entry changes), so the ZIP can become stale. Emit `rerun-if-changed` for each schema file and the manifest.\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n     let manifest_path = Path::new(schemas_dir).join(\"manifest.json\");\n     if manifest_path.exists() {\n         let buffer = std::fs::read(&manifest_path)?;\n+        println!(\"cargo:rerun-if-changed={}\", manifest_path.display());\n \n         let options = zip::write::FileOptions::<()>::default()\n             .compression_method(zip::CompressionMethod::Deflated)\n             .unix_permissions(0o755);\n@@\n             if path.extension().and_then(|s| s.to_str()) == Some(\"json\")\n                 && path\n                     .file_name()\n                     .and_then(|s| s.to_str())\n                     .is_some_and(|s| s.contains(\".schema.\"))\n             {\n+                println!(\"cargo:rerun-if-changed={}\", path.display());\n                 let buffer = std::fs::read(&path)?;\n@@\n     println!(\"cargo:rerun-if-changed=schemas/\");\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit/build.rs` at line 55, The current build script only prints\nprintln!(\"cargo:rerun-if-changed=schemas/\") which does not detect content\nchanges; update the build.rs logic to walk the schemas directory (e.g., iterate\nover std::fs::read_dir(\"schemas\") or use glob) and emit a separate\nprintln!(\"cargo:rerun-if-changed={}\", path) for each schema file found and also\nemit one for the manifest (e.g., \"Cargo.toml\"); replace or augment the existing\nprintln!(\"cargo:rerun-if-changed=schemas/\") line so each individual file is\nregistered for rerun rather than only the directory.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit dab863e","created_at":"2026-01-29T08:44:56Z","updated_at":"2026-01-29T17:09:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/218#discussion_r2740554453","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740554453"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/218#discussion_r2740554453"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740554453/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":55,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":55,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2740554457","pull_request_review_id":3721394965,"id":2740554457,"node_id":"PRRC_kwDOPaLyBs6jWYrZ","diff_hunk":"@@ -1,29 +1,45 @@\n-use crate::gts::BaseModkitPluginV1;\n+use std::io::Read;\n use tracing::info;\n+use zip;\n \n-/// Returns the core GTS schemas provided by the modkit framework.\n+/// Get core GTS schemas provided by the modkit framework.\n ///\n-/// These are base types that other modules' plugin systems depend on\n-///\n-/// This function is called by `types_registry` during initialization to register\n-/// these core types before any dependent modules can register their derived schemas.\n-///\n-/// NOTE: This is temporary logic until <https://github.com/hypernetix/hyperspot/issues/156> is resolved\n+/// These schemas are loaded from an embedded ZIP archive containing JSON schema files.\n+/// The schemas are fundamental types that other modules build upon.\n+/// Examples: `BaseModkitPluginV1` for plugin systems.\n ///\n /// # Errors\n ///\n-/// Returns an error if the schema JSON cannot be parsed.\n+/// Returns an error if the embedded ZIP archive cannot be read or if any schema\n+/// file cannot be parsed as valid JSON.\n pub fn get_core_gts_schemas() -> anyhow::Result<Vec<serde_json::Value>> {\n-    info!(\"Generating core GTS schemas\");\n+    info!(\"Loading core GTS schemas from embedded archive\");\n \n     let mut schemas = Vec::new();\n \n-    // BaseModkitPluginV1 schema (gts.x.core.modkit.plugin.v1~)\n-    // This is the base type for all plugin schemas in the modkit framework.\n-    let schema_str = BaseModkitPluginV1::<()>::gts_schema_with_refs_as_string();\n-    let schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n-    schemas.push(schema_json);\n+    // Load embedded ZIP archive created by build script\n+    let zip_data = include_bytes!(concat!(env!(\"OUT_DIR\"), \"/core_gts_schemas.zip\"));\n+    let cursor = std::io::Cursor::new(zip_data);\n+    let mut archive = zip::ZipArchive::new(cursor)?;\n+\n+    // Extract and parse each schema file\n+    for i in 0..archive.len() {\n+        let mut file = archive.by_index(i)?;\n+        let file_name = file.name().to_owned();\n+\n+        // Skip manifest.json, only process .schema.json files\n+        if file_name.ends_with(\".schema.json\") {\n+            let mut contents = String::new();\n+            file.read_to_string(&mut contents)?;\n+\n+            let schema_json: serde_json::Value = serde_json::from_str(&contents)\n+                .map_err(|e| anyhow::anyhow!(\"Failed to parse schema {file_name}: {e}\"))?;\n+\n+            schemas.push(schema_json);\n+            info!(\"Loaded core GTS schema: {}\", file_name);\n+        }\n+    }\n \n-    info!(\"Core GTS schemas generated: gts.x.core.modkit.plugin.v1~\");\n+    info!(\"Core GTS schemas loaded: {} schemas\", schemas.len());\n     Ok(schemas)","path":"libs/modkit/src/gts/schemas.rs","commit_id":"f2aca5f74683e7fd0fa5e0a0f1dd80b46bbfb3d5","original_commit_id":"71df33126e5293e3004d91d8ec0144e88da746bc","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Fail fast if no core schemas were loaded.**\n\nIf the archive is empty or missing `.schema.json` files, this returns an empty list and core types silently disappear. Consider erroring when zero schemas are found.\n\n\n<details>\n<summary>✅ Proposed fix</summary>\n\n```diff\n-    info!(\"Core GTS schemas loaded: {} schemas\", schemas.len());\n+    if schemas.is_empty() {\n+        return Err(anyhow::anyhow!(\"No core GTS schemas found in embedded archive\"));\n+    }\n+    info!(\"Core GTS schemas loaded: {} schemas\", schemas.len());\n```\n\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    // Load embedded ZIP archive created by build script\n    let zip_data = include_bytes!(concat!(env!(\"OUT_DIR\"), \"/core_gts_schemas.zip\"));\n    let cursor = std::io::Cursor::new(zip_data);\n    let mut archive = zip::ZipArchive::new(cursor)?;\n\n    // Extract and parse each schema file\n    for i in 0..archive.len() {\n        let mut file = archive.by_index(i)?;\n        let file_name = file.name().to_owned();\n\n        // Skip manifest.json, only process .schema.json files\n        if file_name.ends_with(\".schema.json\") {\n            let mut contents = String::new();\n            file.read_to_string(&mut contents)?;\n\n            let schema_json: serde_json::Value = serde_json::from_str(&contents)\n                .map_err(|e| anyhow::anyhow!(\"Failed to parse schema {file_name}: {e}\"))?;\n\n            schemas.push(schema_json);\n            info!(\"Loaded core GTS schema: {}\", file_name);\n        }\n    }\n\n    if schemas.is_empty() {\n        return Err(anyhow::anyhow!(\"No core GTS schemas found in embedded archive\"));\n    }\n    info!(\"Core GTS schemas loaded: {} schemas\", schemas.len());\n    Ok(schemas)\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit/src/gts/schemas.rs` around lines 20 - 44, The current loader\nsilently returns an empty Vec when no .schema.json files are present; after\niterating archive in the function that builds `schemas` (using `zip_data`,\n`archive`, loop over `archive.by_index(i)` and pushing into `schemas`), add a\ncheck after the loop that returns an error via anyhow (e.g.,\n`Err(anyhow::anyhow!(...))`) when `schemas.is_empty()` so the function fails\nfast with a clear message like \"no core GTS schemas found in embedded archive\".\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit dab863e","created_at":"2026-01-29T08:44:56Z","updated_at":"2026-01-29T17:09:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/218#discussion_r2740554457","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/218","_links":{"self":{"href":
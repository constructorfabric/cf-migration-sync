e":"public","site_admin":false},"body":"Done","created_at":"2026-01-19T14:35:21Z","updated_at":"2026-01-19T14:35:21Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705025007","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705025007"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705025007"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705025007/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":69,"side":"RIGHT","in_reply_to_id":2704717612,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705026769","pull_request_review_id":3678397663,"id":2705026769,"node_id":"PRRC_kwDOPaLyBs6hO27R","diff_hunk":"@@ -66,7 +66,7 @@ fmt:\n # |             | - Use 'make dylint-list' to see all available custom lints           |\n # +-------------+----------------------------------------------------------------------+\n \n-.PHONY: clippy kani geiger safety lint dylint dylint-list dylint-test\n+.PHONY: clippy kani geiger safety lint dylint dylint-list dylint-test gts-docs gts-docs-test","path":"Makefile","commit_id":"02345f647f6a27fa459087563548874372849d27","original_commit_id":"30916762ea29f612e2531096a0ce3182ebc73dd8","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@yoskini`, thank you for adding `gts-docs-vendor` to the `.PHONY` declaration! 🎉\n\n<!-- <review_comment_addressed> -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-19T14:35:50Z","updated_at":"2026-01-19T14:35:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705026769","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705026769"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705026769"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705026769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":69,"side":"RIGHT","in_reply_to_id":2704717612,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705044206","pull_request_review_id":3678416344,"id":2705044206,"node_id":"PRRC_kwDOPaLyBs6hO7Lu","diff_hunk":"@@ -0,0 +1,236 @@\n+//! GTS Documentation Validator (DE0903)\n+//!\n+//! This tool validates GTS (Global Type System) identifiers in documentation files\n+//! (.md, .json, .yaml), complementing the Rust-based DE0901 lint that validates\n+//! GTS identifiers in source code.\n+//!\n+//! # Usage\n+//!\n+//! ```bash\n+//! # Validate docs with vendor filter\n+//! gts-docs-validator --vendor x docs modules libs examples\n+//!\n+//! # With exclusions\n+//! gts-docs-validator --vendor x --exclude \"target/*\" --exclude \"docs/api/*\" .\n+//!\n+//! # JSON output\n+//! gts-docs-validator --vendor x --json docs\n+//! ```\n+\n+// CLI tools are expected to print to stdout/stderr\n+#![allow(\n+    clippy::print_stdout,\n+    clippy::print_stderr,\n+    clippy::exit,\n+    clippy::expect_used\n+)]\n+\n+mod scanner;\n+mod validator;\n+\n+use std::path::PathBuf;\n+use std::process::ExitCode;\n+\n+use clap::Parser;\n+use colored::Colorize;\n+\n+use crate::scanner::{find_files, scan_file};\n+use crate::validator::ValidationResult;\n+\n+/// GTS Documentation Validator (DE0903)\n+///\n+/// Validates GTS identifiers in .md, .json, and .yaml files.\n+/// Ensures all GTS IDs follow the correct format and optionally validates\n+/// that they use a specific vendor.\n+#[derive(Parser, Debug)]\n+#[command(name = \"gts-docs-validator\")]\n+#[command(author, version, about, long_about = None)]\n+struct Cli {\n+    /// Paths to scan (files or directories)\n+    /// Defaults to: docs, modules, libs, examples\n+    #[arg(value_name = \"PATH\")]\n+    paths: Vec<PathBuf>,\n+\n+    /// Expected vendor for all GTS IDs (validates vendor matches)\n+    /// Example: --vendor x ensures all IDs use vendor \"x\"\n+    ///\n+    /// Note: Example vendors are always tolerated: acme, globex, example, demo, test, sample, tutorial\n+    #[arg(long, short = 'V')]\n+    vendor: Option<String>,\n+","path":"apps/gts-docs-validator/src/main.rs","commit_id":"e519aa9a47de2acd90fc798a7d8533feee94d5d2","original_commit_id":"30916762ea29f612e2531096a0ce3182ebc73dd8","user":{"login":"yoskini","id":20127030,"node_id":"MDQ6VXNlcjIwMTI3MDMw","avatar_url":"https://avatars.githubusercontent.com/u/20127030?v=4","gravatar_id":"","url":"https://api.github.com/users/yoskini","html_url":"https://github.com/yoskini","followers_url":"https://api.github.com/users/yoskini/followers","following_url":"https://api.github.com/users/yoskini/following{/other_user}","gists_url":"https://api.github.com/users/yoskini/gists{/gist_id}","starred_url":"https://api.github.com/users/yoskini/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yoskini/subscriptions","organizations_url":"https://api.github.com/users/yoskini/orgs","repos_url":"https://api.github.com/users/yoskini/repos","events_url":"https://api.github.com/users/yoskini/events{/privacy}","received_events_url":"https://api.github.com/users/yoskini/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Solved","created_at":"2026-01-19T14:40:44Z","updated_at":"2026-01-19T14:40:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705044206","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705044206"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705044206"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705044206/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":54,"original_start_line":54,"start_side":"RIGHT","line":60,"original_line":60,"side":"RIGHT","in_reply_to_id":2704717555,"author_association":"MEMBER","original_position":60,"position":60,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705045785","pull_request_review_id":3678417960,"id":2705045785,"node_id":"PRRC_kwDOPaLyBs6hO7kZ","diff_hunk":"@@ -0,0 +1,236 @@\n+//! GTS Documentation Validator (DE0903)\n+//!\n+//! This tool validates GTS (Global Type System) identifiers in documentation files\n+//! (.md, .json, .yaml), complementing the Rust-based DE0901 lint that validates\n+//! GTS identifiers in source code.\n+//!\n+//! # Usage\n+//!\n+//! ```bash\n+//! # Validate docs with vendor filter\n+//! gts-docs-validator --vendor x docs modules libs examples\n+//!\n+//! # With exclusions\n+//! gts-docs-validator --vendor x --exclude \"target/*\" --exclude \"docs/api/*\" .\n+//!\n+//! # JSON output\n+//! gts-docs-validator --vendor x --json docs\n+//! ```\n+\n+// CLI tools are expected to print to stdout/stderr\n+#![allow(\n+    clippy::print_stdout,\n+    clippy::print_stderr,\n+    clippy::exit,\n+    clippy::expect_used\n+)]\n+\n+mod scanner;\n+mod validator;\n+\n+use std::path::PathBuf;\n+use std::process::ExitCode;\n+\n+use clap::Parser;\n+use colored::Colorize;\n+\n+use crate::scanner::{find_files, scan_file};\n+use crate::validator::ValidationResult;\n+\n+/// GTS Documentation Validator (DE0903)\n+///\n+/// Validates GTS identifiers in .md, .json, and .yaml files.\n+/// Ensures all GTS IDs follow the correct format and optionally validates\n+/// that they use a specific vendor.\n+#[derive(Parser, Debug)]\n+#[command(name = \"gts-docs-validator\")]\n+#[command(author, version, about, long_about = None)]\n+struct Cli {\n+    /// Paths to scan (files or directories)\n+    /// Defaults to: docs, modules, libs, examples\n+    #[arg(value_name = \"PATH\")]\n+    paths: Vec<PathBuf>,\n+\n+    /// Expected vendor for all GTS IDs (validates vendor matches)\n+    /// Example: --vendor x ensures all IDs use vendor \"x\"\n+    ///\n+    /// Note: Example vendors are always tolerated: acme, globex, example, demo, test, sample, tutorial\n+    #[arg(long, short = 'V')]\n+    vendor: Option<String>,\n+","path":"apps/gts-docs-validator/src/main.rs","commit_id":"e519aa9a47de2acd90fc798a7d8533feee94d5d2","original_commit_id":"30916762ea29f612e2531096a0ce3182ebc73dd8","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@yoskini` Great! Thank you for resolving the `-V` flag conflict. 🎉\n\n<!-- <review_comment_addressed> -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-01-19T14:41:09Z","updated_at":"2026-01-19T14:41:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705045785","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705045785"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705045785"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705045785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":54,"original_start_line":54,"start_side":"RIGHT","line":60,"original_line":60,"side":"RIGHT","in_reply_to_id":2704717555,"author_association":"CONTRIBUTOR","original_position":60,"position":60,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705047146","pull_request_review_id":3678419431,"id":2705047146,"node_id":"PRRC_kwDOPaLyBs6hO75q","diff_hunk":"@@ -0,0 +1,429 @@\n+//! GTS ID validation logic\n+\n+use std::path::PathBuf;\n+\n+use gts::GtsID;\n+use serde::Serialize;\n+\n+/// Represents a single GTS validation error\n+#[derive(Debug, Clone, Serialize)]\n+pub struct GtsError {\n+    pub file: PathBuf,\n+    pub line: usize,\n+    pub column: usize,\n+    pub gts_id: String,\n+    pub error: String,\n+    #[serde(skip_serializing_if = \"String::is_empty\")]\n+    pub context: String,\n+}\n+\n+/// Aggregated validation results\n+#[derive(Debug, Default)]\n+pub struct ValidationResult {\n+    pub errors: Vec<GtsError>,\n+    pub files_scanned: usize,\n+}\n+\n+impl ValidationResult {\n+    #[must_use]\n+    pub fn new(files_scanned: usize) -> Self {\n+        Self {\n+            errors: Vec::new(),\n+            files_scanned,\n+        }\n+    }\n+\n+    pub fn add_errors(&mut self, errors: Vec<GtsError>) {\n+        self.errors.extend(errors);\n+    }\n+\n+    #[must_use]\n+    pub fn is_ok(&self) -> bool {\n+        self.errors.is_empty()\n+    }\n+}\n+\n+/// Contexts where wildcards are allowed (in documentation)\n+const WILDCARD_ALLOWED_CONTEXTS: &[&str] = &[\n+    \"pattern\",\n+    \"filter\",\n+    \"query\",\n+    \"$filter\",\n+    \"starts_with\",\n+    \"with_pattern\",\n+    \"resource_pattern\",\n+    \"discovery\",\n+    \"match\",\n+    \"wildcard\",\n+    \"differs from\",\n+    \"get\",\n+    \"list\",\n+    \"todo\",\n+    \"p1 -\",\n+    \"p2 -\",\n+    \"p3 -\",\n+];\n+\n+/// Contexts that indicate \"bad example\" or intentionally invalid identifiers\n+const SKIP_VALIDATION_CONTEXTS: &[&str] = &[\n+    \"invalid\",\n+    \"wrong\",\n+    \"bad\",\n+    \"reject\",\n+    \"error\",\n+    \"fail\",\n+    \"\\u{274c}\",\n+    \"\\u{2717}\",\n+    \"should not\",\n+    \"must not\",\n+    \"not allowed\",\n+    \"given**\",\n+    \"**given**\",\n+];\n+\n+/// Example vendors used in documentation that are tolerated during vendor validation.\n+/// These are placeholder/example vendors commonly used in docs and tutorials.\n+pub const EXAMPLE_VENDORS: &[&str] = &[\n+    \"acme\",     // Classic example company name\n+    \"globex\",   // Another example company name\n+    \"example\",  // Generic example\n+    \"demo\",     // Demo purposes\n+    \"test\",     // Test purposes\n+    \"sample\",   // Sample code\n+    \"tutorial\", // Tutorial examples\n+];\n+\n+/// Check if a vendor is an example/placeholder vendor that should be tolerated\n+#[must_use]\n+pub fn is_example_vendor(vendor: &str) -> bool {\n+    EXAMPLE_VENDORS.contains(&vendor)\n+}\n+\n+/// Check if the GTS identifier is in a context where wildcards are allowed\n+#[must_use]\n+pub fn is_wildcard_context(line: &str, match_start: usize) -> bool {\n+    // Use get() to safely handle potential mid-codepoint byte offsets\n+    let before = match line.get(..match_start) {\n+        Some(s) => s.to_lowercase(),\n+        None => return false, // Invalid byte offset, assume not wildcard context\n+    };\n+\n+    for ctx in WILDCARD_ALLOWED_CONTEXTS {\n+        if before.contains(ctx) {\n+            return true;\n+        }\n+    }\n+\n+    // Also check for $filter anywhere in the line\n+    if line.to_lowercase().contains(\"$filter\") {\n+        return true;\n+    }\n+\n+    false\n+}\n+\n+/// Check if the GTS identifier is in a \"bad example\" context\n+#[must_use]\n+pub fn is_bad_example_context(line: &str, prev_lines: &[&str]) -> bool {\n+    let line_lower = line.to_lowercase();\n+\n+    // Check current line\n+    for ctx in SKIP_VALIDATION_CONTEXTS {\n+        if line_lower.contains(ctx) {\n+            return true;\n+        }\n+    }\n+\n+    // Check previous lines (last 3)\n+    for prev_line in prev_lines.iter().rev().take(3) {\n+        let prev_lower = prev_line.to_lowercase();\n+        for ctx in SKIP_VALIDATION_CONTEXTS {\n+            if prev_lower.contains(ctx) {\n+                return true;\n+            }\n+        }\n+    }\n+\n+    false\n+}\n+\n+/// Validate a single GTS segment like 'x.core.modkit.plugin.v1'\n+pub fn validate_gts_segment(segment: &str) -> Result<(), String> {\n+    if segment.is_empty() {\n+        return Ok(()); // Empty segments are ok (trailing ~)\n+    }\n+\n+    // Check for invalid characters\n+    if segment.contains('-') {\n+        return Err(format!(\"Hyphen not allowed in segment: '{segment}'\"));\n+    }\n+\n+    let parts: Vec<&str> = segment.split('.').collect();\n+\n+    // Must have 5 components: vendor.org.package.type.version\n+    // But version can be v1, v1.0, v1.2.3, etc.\n+    if parts.len() < 5 {\n+        return Err(format!(\n+            \"Segment must have 5 components (vendor.org.package.type.version), got {}: '{segment}'\",\n+            parts.len()\n+        ));\n+    }\n+\n+    // The 5th component must start with 'v' (version)\n+    if !parts[4].starts_with('v') {\n+        return Err(format!(\n+            \"Version must start with 'v' (e.g., v1, v1.0): '{segment}'\"\n+        ));\n+    }\n+\n+    // Validate version format\n+    let version_part = &parts[4][1..]; // Remove 'v' prefix\n+    if version_part.is_empty() {\n+        return Err(format!(\"Version number missing after 'v': '{segment}'\"));\n+    }\n+\n+    // Version parts must be numeric\n+    let version_components: Vec<&str> = if parts.len() > 5 {\n+        // v1.2.3 case: version spans multiple dot-separated parts\n+        std::iter::once(version_part)\n+            .chain(parts[5..].iter().copied())\n+            .collect()\n+    } else {\n+        vec![version_part]\n+    };\n+\n+    for (i, vc) in version_components.iter().enumerate() {\n+        // First part must be numeric, but could be followed by more segments\n+        if vc.parse::<u32>().is_err() && i == 0 {\n+            return Err(format!(\"Version must be numeric: '{segment}'\"));\n+        }","path":"apps/gts-docs-validator/src/validator.rs","commit_id":"e519aa9a47de2acd90fc798a7d8533feee94d5d2","original_commit_id":"5f43da0a4bacd8148cbbf65662c4a031d7220dd1","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Enforce numeric version components beyond the first.**  \nThe code says “Version parts must be numeric” but only validates the first component; `v1.alpha` currently passes.\n\n<details>\n<summary>🛠️ Proposed fix</summary>\n\n```diff\n-    for (i, vc) in version_components.iter().enumerate() {\n-        // First part must be numeric, but could be followed by more segments\n-        if vc.parse::<u32>().is_err() && i == 0 {\n-            return Err(format!(\"Version must be numeric: '{segment}'\"));\n-        }\n-    }\n+    for vc in &version_components {\n+        if vc.parse::<u32>().is_err() {\n+            return Err(format!(\"Version components must be numeric: '{segment}'\"));\n+        }\n+    }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    // Version parts must be numeric\n    let version_components: Vec<&str> = if parts.len() > 5 {\n        // v1.2.3 case: version spans multiple dot-separated parts\n        std::iter::once(version_part)\n            .chain(parts[5..].iter().copied())\n            .collect()\n    } else {\n        vec![version_part]\n    };\n\n    for vc in &version_components {\n        if vc.parse::<u32>().is_err() {\n            return Err(format!(\"Version components must be numeric: '{segment}'\"));\n        }\n    }\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@apps/gts-docs-validator/src/validator.rs` around lines 185 - 199, The loop\nover version_components currently only enforces numeric on the first segment;\nupdate the validation in the for loop that iterates over version_components (the\nblock using \"for (i, vc) in version_components.iter().enumerate()\") to require\nevery vc.parse::<u32>() to succeed and return Err when any component is\nnon-numeric, and fix the error message to include the offending component (use\nvc or its string) instead of the undefined '{segment}' placeholder so failures\nlike \"v1.alpha\" are rejected.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @yoskini\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-19T14:41:31Z","updated_at":"2026-01-19T14:53:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705047146","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705047146"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/266#discussion_r2705047146"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/266"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705047146/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":185,"original_start_line":185,"start_side":"RIGHT","line":198,"original_line":199,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":199,"position":198,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2705056415","pull_request_review_id":3678000244,"id":2705056415,"node_id":"PRRC_kwDOPaLyBs6hO-Kf","diff_hunk":"@@ -0,0 +1,429 @@\n+//! GTS ID validation logic\n+\n+use std::path::PathBuf;\n+\n+use gts::GtsID;\n+use serde::Serialize;\n+\n+/// Represents a single GTS validation error\n+#[derive(Debug, Clone, Serialize)]\n+pub struct GtsError {\n+    pub file: PathBuf,\n+    pub line: usize,\n+    pub column: usize,\n+    pub gts_id: String,\n+    pub error: String,\n+    #[serde(skip_serializing_if = \"String::is_empty\")]\n+    pub context: String,\n+}\n+\n+/// Aggregated validation results\n+#[derive(Debug, Default)]\n+pub struct ValidationResult {\n+    pub errors: Vec<GtsError>,\n+    pub files_scanned: usize,\n+}\n+\n+impl ValidationResult {\n+    #[must_use]\n+    pub fn new(files_scanned: usize) -> Self {\n+        Self {\n+            errors: Vec::new(),\n+            files_scanned,\n+        }\n+    }\n+\n+    pub fn add_errors(&mut self, errors: Vec<GtsError>) {\n+        self.errors.extend(errors);\n+    }\n+\n+    #[must_use]\n+    pub fn is_ok(&self) -> bool {\n+        self.errors.is_empty()\n+    }\n+}\n+\n+/// Contexts where wildcards are allowed (in documentation)\n+const WILDCARD_ALLOWED_CONTEXTS: &[&str] = &[\n+    \"pattern\",\n+    \"filter\",\n+    \"query\",\n+    \"$filter\",\n+    \"starts_with\",\n+    \"with_pattern\",\n+    \"resource_pattern\",\n+    \"discovery\",\n+    \"match\",\n+    \"wildcard\",\n+    \"differs from\",\n+    \"get\",\n+    \"list\",\n+    \"todo\",\n+    \"p1 -\",\n+    \"p2 -\",\n+    \"p3 -\",\n+];\n+\n+/// Contexts that indicate \"bad example\" or intentionally invalid identifiers\n+const SKIP_VALIDATION_CONTEXTS: &[&str] = &[\n+    \"invalid\",\n+    \"wrong\",\n+    \"bad\",\n+    \"reject\",\n+    \"error\",\n+    \"fail\",\n+    \"\\u{274c}\",\n+    \"\\u{2717}\",\n+    \"should not\",\n+    \"must not\",\n+    \"not allowed\",\n+    \"given**\",\n+    \"**given**\",\n+];\n+\n+/// Example vendors used in documentation that are tolerated during vendor validation.\n+/// These are placeholder/example vendors commonly used in docs and tutorials.\n+pub const EXAMPLE_VENDORS: &[&str] = &[\n+    \"acme\",     // Classic example company name\n+    \"globex\",   // Another example company name\n+    \"example\",  // Generic example\n+    \"demo\",     // Demo purposes\n+    \"test\",     // Test purposes\n+    \"sample\",   // Sample code\n+    \"tutorial\", // Tutorial examples\n+];\n+\n+/// Check if a vendor is an example/placeholder vendor that should be tolerated\n+#[must_use]\n+pub fn is_example_vendor(vendor: &str) -> bool {\n+    EXAMPLE_VENDORS.contains(&vendor)\n+}\n+\n+/// Check if the GTS identifier is in a context where wildcards are allowed\n+#[must_use]\n+pub fn is_wildcard_context(line: &str, match_start: usize) -> bool {\n+    // Use get() to safely handle potential mid-codepoint byte offsets\n+    let before = match line.get(..match_start) {\n+        Some(s) => s.to_lowercase(),\n+        None => return false, // Invalid byte offset, assume not wildcard context\n+    };\n+\n+    for ctx in WILDCARD_ALLOWED_CONTEXTS {\n+        if before.contains(ctx) {\n+            return true;\n+        }\n+    }\n+\n+    // Also check for $filter anywhere in the line\n+    if line.to_lowercase().contains(\"$filter\") {\n+        return true;\n+    }\n+\n+    false\n+}\n+\n+/// Check if the GTS identifier is in a \"bad example\" context\n+#[must_use]\n+pub fn is_bad_example_context(line: &str, prev_lines: &[&str]) -> bool {\n+    let line_lower = line.to_lowercase();\n+\n+    // Check current line\n+    for ctx in SKIP_VALIDATION_CONTEXTS {\n+        if line_lower.contains(ctx) {\n+            return true;\n+        }\n+    }\n+\n+    // Check previous lines (last 3)\n+    for prev_line in prev_lines.iter().rev().take(3) {\n+        let prev_lower = prev_line.to_lowercase();\n+        for ctx in SKIP_VALIDATION_CONTEXTS {\n+            if prev_lower.contains(ctx) {\n+                return true;\n+            }\n+        }\n+    }\n+\n+    false\n+}\n+\n+/// Validate a single GTS segment like 'x.core.modkit.plugin.v1'\n+pub fn validate_gts_segment(segment: &str) -> Result<(), String> {\n+    if segment.is_empty() {\n+        return Ok(()); // Empty segments are ok (trailing ~)\n+    }\n+\n+    // Check for invalid characters\n+    if segment.contains('-') {\n+        return Err(format!(\"Hyphen not allowed in segment: '{segment}'\"));\n+    }\n+\n+    let parts: Vec<&str> = segment.split('.').collect();\n+\n+    // Must have 5 components: vendor.org.package.type.version\n+    // But version can be v1, v1.0, v1.2.3, etc.\n+    if parts.len() < 5 {\n+        return Err(format!(\n+            \"Segment must have 5 components (vendor.org.package.type.version), got {}: '{segment}'\",\n+            parts.len()\n+        ));\n+    }\n+\n+    // The 5th component must start with 'v' (version)\n+    if !parts[4].starts_with('v') {\n+        return Err(format!(\n+            \"Version must start with 'v' (e.g., v1, v1.0): '{segment}'\"\n+        ));\n+    }\n+\n+    // Validate version format\n+    let version_part = &parts[4][1..]; // Remove 'v' prefix\n+    if version_part.is_empty() {\n+        return Err(format!(\"Version number missing after 'v': '{segment}'\"));\n+    }\n+\n+    // Version parts must be numeric\n+    let version_components: Vec<&str> = if parts.len() > 5 {\n+        // v1.2.3 case: version spans multiple dot-separated parts\n+        std::iter::once(version_part)\n+            .chain(parts[5..].iter().copied())\n+            .collect()\n+    } else {\n+        vec![version_part]\n+    };\n+\n+    for (i, vc) in version_components.iter().enumerate() {\n+        // First part must be numeric, but could be followed by more segments\n+        if vc.parse::<u32>().is_err() && i == 0 {\n+            return Err(format!(\"Version must be numeric: '{segment}'\"));\n+        }","path":"apps/gts-docs-validator/src/validator.rs","commit_id":"db935b710789d880f659e21094df1955341e2ad2","original_commit_id":"a5ad52553831166705ad17e55ce7c22db7b04ddd","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"The version validation only checks if the first component is numeric (`i == 0`), but ignores subsequent version parts. For versions like `v1.abc.3`, this would only validate that `1` is numeric but incorrectly allow `abc` as a valid version component.\n\n**Fix:**\n```rust\nfor (i, vc) in version_components.iter().enumerate() {\n    if vc.parse::<u32>().is_err() {\n        return Err(format!(\"Version component must be numeric at position {}: '{}' in '{segment}'\", i, vc));\n    }\n}\n```\n```suggestion\n    for (i, vc) in version_components.iter().enumerate() {\n        if vc.parse::<u32>().is_err() {\n            return Err(format!(\"Version component must be numeric at position {}: '{}' in '{segment}'\", i, vc));\n        }\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/266?chatWithGeneratedComment=861b9028-4a83-4e6b-8046-46addc29f950\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-
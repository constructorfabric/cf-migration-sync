 uses plain text.\n\n<details>\n<summary>🔧 Proposed fix</summary>\n\n```diff\n-nightly-2025-05-01\n+nightly-2025-09-18\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\nnightly-2025-09-18\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de07_security/de0706_no_direct_sqlx/rust-toolchain` at line 1,\nThe rust-toolchain file for de0706 is out of sync: replace the plain-text pin\n\"nightly-2025-05-01\" with the workspace-standard toolchain and format used by\nthe other dylint lints (use \"nightly-2025-09-18\" and convert the file to TOML\nwith a [toolchain] table and the same components/targets entries as the other\nlint rust-toolchain files); ensure the file matches the other lint toolchain\nfiles exactly in structure (including any components like rustfmt/clippy) so the\nlint uses the same nightly and format as the rest of the workspace.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-15T17:49:50Z","updated_at":"2026-01-15T17:49:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2695385978","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385978"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2695385978"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385982","pull_request_review_id":3666862054,"id":2695385982,"node_id":"PRRC_kwDOPaLyBs6gqFN-","diff_hunk":"@@ -0,0 +1,153 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::{is_in_modkit_db_path, is_in_hyperspot_server_path};\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Prohibits direct usage of the `sqlx` crate. Projects should use Sea-ORM\n+    /// or SecORM abstractions instead for database operations.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Direct sqlx usage bypasses important architectural layers:\n+    /// - Skips security enforcement (SecureConn, AccessScope)\n+    /// - Bypasses query building abstractions and type safety\n+    /// - Makes it harder to maintain consistent patterns across the codebase\n+    /// - Loses automatic audit logging and tenant isolation\n+    ///\n+    /// ### Known Exclusions\n+    ///\n+    /// This lint does NOT apply to `libs/modkit-db/` which is the internal\n+    /// wrapper library that provides the Sea-ORM/SecORM abstraction layer.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - direct sqlx usage\n+    /// use sqlx::PgPool;\n+    /// sqlx::query(\"SELECT * FROM users\").fetch_all(&pool).await?;\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - use Sea-ORM with SecureConn\n+    /// use sea_orm::EntityTrait;\n+    /// UserEntity::find().secure().scope_with(&scope).all(conn).await?;\n+    /// ```\n+    pub DE0706_NO_DIRECT_SQLX,\n+    Deny,\n+    \"direct sqlx usage is prohibited; use Sea-ORM or SecORM instead (DE0706)\"\n+}\n+\n+/// Sqlx crate pattern to detect\n+const SQLX_PATTERN: &str = \"sqlx\";\n+\n+fn use_tree_to_string(tree: &UseTree) -> String {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            for (nested_tree, _) in items {\n+                let nested_str = use_tree_to_string(nested_tree);\n+                if !nested_str.is_empty() {\n+                    return format!(\"{}::{}\", prefix, nested_str);\n+                }\n+            }\n+            prefix\n+        }\n+    }\n+}\n+\n+fn starts_with_sqlx(tree: &UseTree) -> bool {\n+    if let Some(first_seg) = tree.prefix.segments.first() {\n+        return first_seg.ident.name.as_str() == SQLX_PATTERN;\n+    }\n+    false\n+}\n+\n+fn check_use_for_sqlx(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    if starts_with_sqlx(use_tree) {\n+        let path_str = use_tree_to_string(use_tree);\n+        cx.span_lint(DE0706_NO_DIRECT_SQLX, item.span, |diag| {\n+            diag.primary_message(format!(\n+                \"direct sqlx import detected: `{}` (DE0706)\",\n+                path_str\n+            ));\n+            diag.help(\"use Sea-ORM EntityTrait or SecORM abstractions instead\");\n+            diag.note(\"sqlx bypasses security enforcement and architectural patterns\");\n+        });\n+    }\n+}\n+\n+impl EarlyLintPass for De0706NoDirectSqlx {\n+    fn check_item(&mut self, cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+        // Skip libs/modkit-db/ - this is the internal wrapper library\n+        // that legitimately uses sqlx to provide the abstraction layer\n+        if is_in_modkit_db_path(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+        \n+        // Skip apps/hyperspot-server/ - it needs sqlx driver linkage workaround\n+        if is_in_hyperspot_server_path(cx.sess().source_map(), item.span) {\n+            return;\n+        }\n+        \n+        // Check use statements for sqlx imports\n+        if matches!(item.kind, ItemKind::Use(_)) {\n+            check_use_for_sqlx(cx, item);\n+        }\n+        \n+        // Check extern crate declarations\n+        if let ItemKind::ExternCrate(name, _ident) = &item.kind {\n+            if let Some(sym) = name {\n+                let sym_str: &str = sym.as_str();\n+                if sym_str == SQLX_PATTERN {\n+                    cx.span_lint(DE0706_NO_DIRECT_SQLX, item.span, |diag| {\n+                        diag.primary_message(\"extern crate sqlx is prohibited (DE0706)\");\n+                        diag.help(\"use Sea-ORM EntityTrait or SecORM abstractions instead\");\n+                        diag.note(\"sqlx bypasses security enforcement and architectural patterns\");\n+                    });\n+                }\n+            }\n+        }","path":"dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs","commit_id":"072f9b8ead8d2f587f07e787b943da0164a19e24","original_commit_id":"072f9b8ead8d2f587f07e787b943da0164a19e24","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# Search for ExternCrate variant definition and usage patterns\nrg \"ItemKind::ExternCrate\" --type rust -A 2 -B 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 569\n\n---\n\n🏁 Script executed:\n\n```shell\n# Also search for ExternCrate definitions in rustc_ast context\nrg \"ExternCrate\\(\" --type rust -B 2 -A 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 569\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there's documentation or tests related to ExternCrate destructuring\nrg \"enum ItemKind\" --type rust -A 50 | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n# Read the file to understand imports and context\ncat -n dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 6265\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for other uses of ItemKind in the repo to see patterns\nrg \"ItemKind::\" --type rust -B 1 | head -50\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 4347\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the Cargo.toml for the lint crate to see rustc version constraints\ncat dylint_lints/de07_security/de0706_no_direct_sqlx/Cargo.toml\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 690\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for Cargo.toml in parent directories to understand rustc dependency\nfind dylint_lints -name \"Cargo.toml\" | head -5 | xargs grep -l rustc\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 435\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check root workspace Cargo.toml\ncat Cargo.toml | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3313\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for ExternCrate in the codebase more broadly, including comments/docs\nrg \"ExternCrate\" --type rust\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 189\n\n---\n\n🌐 Web query:\n\n`rustc_ast ItemKind ExternCrate variant definition`\n\n💡 Result:\n\nIn rustc_ast the AST item-kind for `extern crate` is the ItemKind variant ExternCrate, represented as\n\n- ItemKind::ExternCrate(ItemExternCrate)\n\n(See the rustc_ast module docs.) [1]\n\nFor comparison/usage, parser/AST crates (e.g., syn) expose an ExternCrate item variant for `extern crate foo;`. [2]\n\nSources:\n- rustc_ast::ast (ItemKind / module docs). [1]\n- syn::Item (shows ExternCrate variant). [2]\n\n---\n\n\n\n</details>\n\n**Fix `ItemKind::ExternCrate` destructuring pattern to match rustc_ast API.**\n\nThe pattern `ItemKind::ExternCrate(name, _ident)` is incorrect. The `ExternCrate` variant in rustc_ast takes a single field of type `ItemExternCrate`, not two separate fields. Update the pattern to:\n\n```rust\nif let ItemKind::ExternCrate(extern_crate_item) = &item.kind {\n    // Access the crate name via extern_crate_item fields\n}\n```\n\nThen extract the actual crate name from the `ItemExternCrate` struct as needed for the comparison.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de07_security/de0706_no_direct_sqlx/src/lib.rs` around lines 122\n- 133, The pattern matching for ItemKind::ExternCrate is wrong; change the match\nfrom ItemKind::ExternCrate(name, _ident) to\nItemKind::ExternCrate(extern_crate_item) and then read the crate name from the\nItemExternCrate struct (e.g., extern_crate_item.ident or the appropriate field)\nto compare against SQLX_PATTERN; keep the lint invocation using\nDE0706_NO_DIRECT_SQLX and item.span and call cx.span_lint with the same messages\nif the extracted name equals SQLX_PATTERN.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-15T17:49:50Z","updated_at":"2026-01-15T17:49:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2695385982","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385982"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2695385982"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385982/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":122,"original_start_line":122,"start_side":"RIGHT","line":133,"original_line":133,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":133,"position":133,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695385984","pull_request_review_id":3666862054,"id":2695385984,"node_id":"PRRC_kwDOPaLyBs6gqFOA","diff_hunk":"@@ -0,0 +1,79 @@\n+# DE1107: Public APIs Doc Comments\n+\n+### What it does","path":"dylint_lints/de11_documentatio
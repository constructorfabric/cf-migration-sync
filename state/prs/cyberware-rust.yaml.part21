test with the actual limit from `max_field_length` config\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@testing/e2e/modules/settings/test_settings_update.py` around lines 168 - 194,\nThe test test_update_settings_validation_max_length hard-codes a 200-char\n\"theme\" value which makes the test brittle; change it to derive the over-limit\nvalue dynamically (instead of magic number in update_data) by first querying the\nservice or config for the current max_field_length (e.g., call the settings\nschema or config endpoint using base_url and auth_headers or import the\nmax_field_length constant), then construct update_data[\"theme\"] = \"a\" *\n(max_field_length + 1) (or fallback to a very large sentinel like 10000 if the\nconfig endpoint is unavailable), and keep the existing assertion that the POST\nto f\"{base_url}/simple-user-settings/v1/settings\" returns 422; update references\nto update_data, test_update_settings_validation_max_length, base_url and\nauth_headers accordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit bff26a2","created_at":"2026-01-16T15:51:41Z","updated_at":"2026-01-16T17:05:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2699047648","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2699047648"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2699047648"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2699047648/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":210,"original_start_line":168,"start_side":"RIGHT","line":247,"original_line":194,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":194,"position":247,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704453431","pull_request_review_id":3677728636,"id":2704453431,"node_id":"PRRC_kwDOPaLyBs6hMq83","diff_hunk":"@@ -0,0 +1,40 @@\n+//! `SimpleUserSettingsApi` trait definition.\n+//!\n+//! This trait defines the public API for the settings module.\n+//! All methods require a `SecurityContext` for authorization and access control.\n+\n+use async_trait::async_trait;\n+use modkit_security::SecurityContext;\n+\n+use crate::errors::SettingsError;\n+use crate::models::{SimpleUserSettings, SimpleUserSettingsPatch, SimpleUserSettingsUpdate};\n+\n+/// Public API trait for the settings module.\n+///\n+/// This trait can be consumed by other modules via `ClientHub`.\n+/// All methods require a `SecurityContext` for proper authorization and access control.\n+#[async_trait]\n+pub trait SimpleUserSettingsApi: Send + Sync {","path":"modules/simple-user-settings/simple-user-settings-sdk/src/api.rs","commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","original_commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Should be SimpleUserSettingsClient","created_at":"2026-01-19T11:53:52Z","updated_at":"2026-01-19T12:02:45Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704453431","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704453431"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704453431"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704453431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":17,"side":"RIGHT","author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704460446","pull_request_review_id":3677728636,"id":2704460446,"node_id":"PRRC_kwDOPaLyBs6hMsqe","diff_hunk":"@@ -0,0 +1,170 @@\n+use crate::api::rest::{dto, handlers};\n+use crate::domain::service::Service;\n+use axum::http::StatusCode;\n+use axum::{Extension, Router};\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+enum Resource {\n+    Settings,\n+}\n+\n+enum Action {\n+    Read,\n+    Write,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Resource::Settings => \"simple-user-settings\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Action::Read => \"read\",\n+            Action::Write => \"write\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}","path":"modules/simple-user-settings/simple-user-settings/src/api/rest/routes.rs","commit_id":"f154644beca8697855955fa21f5b6fc95b5eb0bd","original_commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why do we need this here?","created_at":"2026-01-19T11:55:55Z","updated_at":"2026-01-19T12:02:45Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704460446","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704460446"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704460446"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704460446/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":47,"original_line":47,"side":"RIGHT","author_association":"MEMBER","original_position":47,"position":47,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463256","pull_request_review_id":3677739711,"id":2704463256,"node_id":"PRRC_kwDOPaLyBs6hMtWY","diff_hunk":"@@ -0,0 +1,96 @@\n+\"\"\"E2E tests for settings GET endpoint.\"\"\"\n+import httpx\n+import pytest\n+\n+\n+@pytest.mark.asyncio\n+async def test_get_settings_returns_defaults(base_url, auth_headers):\n+    \"\"\"\n+    Test GET /simple-user-settings/v1/settings endpoint returns defaults when settings don't exist.\n+\n+    This test verifies that the endpoint returns empty strings for theme and language\n+    when no settings have been created yet (lazy creation behavior).\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        response = await client.get(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            headers=auth_headers,\n+        )\n+\n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. \"\n+            f\"Response: {response.text}\"\n+        )\n+\n+        settings = response.json()\n+        assert isinstance(settings, dict), \"Response should be a JSON object\"\n+\n+        # Validate structure\n+        assert \"user_id\" in settings\n+        assert \"tenant_id\" in settings\n+        assert \"theme\" in settings\n+        assert \"language\" in settings\n+\n+        # Values should be strings (may be empty on first GET)\n+        assert isinstance(settings[\"theme\"], str)\n+        assert isinstance(settings[\"language\"], str)\n+\n+        assert settings[\"theme\"] == \"\"\n+        assert settings[\"language\"] == \"\"","path":"testing/e2e/modules/settings/test_settings_get.py","commit_id":"fba0482a06467160374901f70dcd01b694005c1f","original_commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Critical mismatch between test expectations and actual implementation. The test expects `theme` and `language` to be empty strings (`\"\"`), but the Rust implementation returns `Option::None` which serializes to JSON `null`.\n\nThe spec at `openspec/specs/user-settings/spec.md:18-24` explicitly states that default settings should return fields as `null`, not empty strings. The Rust DTO has `theme: Option<String>` and `language: Option<String>`, which serialize to `null` when `None`.\n\n**What will break:** These assertions will fail:\n```python\nassert isinstance(settings[\"theme\"], str)  # Fails: settings[\"theme\"] is None\nassert settings[\"theme\"] == \"\"  # Fails: None != \"\"\n```\n\n**Fix:** Change assertions to:\n```python\nassert settings[\"theme\"] is None\nassert settings[\"language\"] is None\n```\n\nOr update the Rust implementation to return empty strings instead of `None` for consistency.\n```suggestion\n        # Values should be None for default settings according to spec\n        assert settings[\"theme\"] is None\n        assert settings[\"language\"] is None\n\n        # No need to check equality with empty strings as they should be None\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/223?chatWithGeneratedComment=b26f501b-6bfa-4ac8-92ac-a0c792958d85\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-19T11:56:45Z","updated_at":"2026-01-19T11:56:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704463256","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463256"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704463256"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463256/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":36,"start_side":"RIGHT","line":null,"original_line":42,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":42,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463337","pull_request_review_id":3677739711,"id":2704463337,"node_id":"PRRC_kwDOPaLyBs6hMtXp","diff_hunk":"@@ -0,0 +1,302 @@\n+\"\"\"E2E tests for settings PATCH (partial update) endpoint.\"\"\"\n+import httpx\n+import pytest\n+\n+\n+@pytest.mark.asyncio\n+async def test_patch_settings_theme_only(base_url, auth_headers):\n+    \"\"\"\n+    Test PATCH /simple-user-settings/v1/settings endpoint updating only theme.\n+\n+    This test verifies partial update behavior - only provided fields are updated.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        # First, set both fields\n+        initial_data = {\n+            \"theme\": \"dark\",\n+            \"language\": \"en\"\n+        }\n+\n+        post_response = await client.post(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=initial_data,\n+            headers=auth_headers,\n+        )\n+\n+        if post_response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert post_response.status_code == 200\n+\n+        # Now patch only theme\n+        patch_data = {\n+            \"theme\": \"light\"\n+        }\n+\n+        patch_response = await client.patch(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=patch_data,\n+            headers=auth_headers,\n+        )\n+\n+        assert patch_response.status_code == 200, (\n+            f\"Expected 200, got {patch_response.status_code}. \"\n+            f\"Response: {patch_response.text}\"\n+        )\n+\n+        settings = patch_response.json()\n+\n+        # Theme should be updated, language should remain unchanged\n+        assert settings[\"theme\"] == \"light\"\n+        assert settings[\"language\"] == \"en\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_patch_settings_language_only(base_url, auth_headers):\n+    \"\"\"\n+    Test PATCH /simple-user-settings/v1/settings endpoint updating only language.\n+\n+    This test verifies partial update behavior for the language field.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        # Set initial values\n+        initial_data = {\n+            \"theme\": \"dark\",\n+            \"language\": \"en\"\n+        }\n+\n+        post_response = await client.post(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=initial_data,\n+            headers=auth_headers,\n+        )\n+\n+        if post_response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert post_response.status_code == 200\n+\n+        # Patch only language\n+        patch_data = {\n+            \"language\": \"fr\"\n+        }\n+\n+        patch_response = await client.patch(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=patch_data,\n+            headers=auth_headers,\n+        )\n+\n+        assert patch_response.status_code == 200\n+        settings = patch_response.json()\n+\n+        # Language should be updated, theme should remain unchanged\n+        assert settings[\"theme\"] == \"dark\"\n+        assert settings[\"language\"] == \"fr\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_patch_settings_both_fields(base_url, auth_headers):\n+    \"\"\"\n+    Test PATCH /simple-user-settings/v1/settings endpoint updating both fields.\n+\n+    This test verifies that PATCH can update multiple fields at once.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        # Set initial values\n+        initial_data = {\n+            \"theme\": \"dark\",\n+            \"language\": \"en\"\n+        }\n+\n+        post_response = await client.post(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=initial_data,\n+            headers=auth_headers,\n+        )\n+\n+        if post_response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert post_response.status_code == 200\n+\n+        # Patch both fields\n+        patch_data = {\n+            \"theme\": \"light\",\n+            \"language\": \"es\"\n+        }\n+\n+        patch_response = await client.patch(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=patch_data,\n+            headers=auth_headers,\n+        )\n+\n+        assert patch_response.status_code == 200\n+        settings = patch_response.json()\n+\n+        # Both should be updated\n+        assert settings[\"theme\"] == \"light\"\n+        assert settings[\"language\"] == \"es\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_patch_settings_empty_patch(base_url, auth_headers):\n+    \"\"\"\n+    Test PATCH /simple-user-settings/v1/settings with empty patch (no fields).\n+\n+    This test verifies behavior when no fields are provided in the patch.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        # Set initial values\n+        initial_data = {\n+            \"theme\": \"dark\",\n+            \"language\": \"en\"\n+        }\n+\n+        post_response = await client.post(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=initial_data,\n+            headers=auth_headers,\n+        )\n+\n+        if post_response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert post_response.status_code == 200\n+\n+        # Patch with empty object\n+        patch_data = {}\n+\n+        patch_response = await client.patch(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=patch_data,\n+            headers=auth_headers,\n+        )\n+\n+        assert patch_response.status_code == 200\n+        settings = patch_response.json()\n+\n+        # Nothing should change\n+        assert settings[\"theme\"] == \"dark\"\n+        assert settings[\"language\"] == \"en\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_patch_settings_creates_if_not_exists(base_url, auth_headers):\n+    \"\"\"\n+    Test PATCH /simple-user-settings/v1/settings creates settings if they don't exist.\n+\n+    This test verifies that PATCH also does upsert (creates on first call).\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        # Patch without prior POST (may create with defaults)\n+        patch_data = {\n+            \"theme\": \"light\"\n+        }\n+\n+        patch_response = await client.patch(\n+            f\"{base_url}/simple-user-settings/v1/settings\",\n+            json=patch_data,\n+            headers=auth_headers,\n+        )\n+\n+        if patch_response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\"Endpoint requires authentication\")\n+\n+        assert patch_response.status_code == 200\n+        settings = patch_response.json()\n+\n+        # Theme should be set, language should be default (empty or set value)\n+        assert settings[\"theme\"] == \"light\"\n+        assert settings.get(\"language\") is None or isinstance(settings.get(\"language\"), str)","path":"testing/e2e/modules/settings/test_settings_patch.py","commit_id":"f154644beca8697855955fa21f5b6fc95b5eb0bd","original_commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Inconsistent null handling. The test allows both `None` and string types for language field, but this doesn't match the stated behavior. When PATCH creates settings with only `theme`, the `language` field will be `None` (per the implementation at `src/domain/service.rs:44-49`).\n\nThe assertion `settings.get(\"language\") is None or isinstance(settings.get(\"language\"), str)` is too permissive and doesn't verify correct behavior.\n\n**Fix:** Be explicit about expected behavior:\n```python\nassert settings[\"theme\"] == \"light\"\nassert settings[\"language\"] is None  # Should be None when not provided in PATCH\n```\n```suggestion\n        # Theme should be set, language should be default (empty or set value)\n        assert settings[\"theme\"] == \"light\"\n        assert settings[\"language\"] is None  # Should be None when not provided in PATCH\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/223?chatWithGeneratedComment=6b15a98c-2d9d-4c1f-91ea-64a98f8c9414\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-19T11:56:46Z","updated_at":"2026-01-19T11:56:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704463337","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463337"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704463337"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704463337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":210,"original_start_line":210,"start_side":"RIGHT","line":212,"original_line":212,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":212,"position":212,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704468426","pull_request_review_id":3677728636,"id":2704468426,"node_id":"PRRC_kwDOPaLyBs6hMunK","dif
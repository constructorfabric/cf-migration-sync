\"\n+path = \"ui/good_domain_0301.rs\"\n+\n+[[example]]\n+name = \"mixed_imports_0301\"\n+path = \"ui/mixed_imports_0301.rs\"\n+\n+[dependencies]\n+clippy_utils.workspace = true\n+dylint_linting.workspace = true\n+lint_utils.workspace = true\n+\n+[dev-dependencies]\n+dylint_testing.workspace = true\n+sea-orm = \"1.0\"\n+sqlx = \"0.8\"\n+axum = \"0.7\"\n+uuid = \"1.0\"","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/Cargo.toml","commit_id":"952488c1b3b742711ba7600bc7caf9a0a7d5cdaf","original_commit_id":"952488c1b3b742711ba7600bc7caf9a0a7d5cdaf","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"there are certain dependencies that can go to the workspace and reference here. We probably are going to reuse them in other lints","created_at":"2026-01-13T09:54:43Z","updated_at":"2026-01-13T09:56:56Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2685672839","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685672839"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2685672839"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685672839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":34,"side":"RIGHT","author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685678616","pull_request_review_id":3654910238,"id":2685678616,"node_id":"PRRC_kwDOPaLyBs6gFDQY","diff_hunk":"@@ -0,0 +1,2 @@\n+[build]\n+target-dir = \"../../target\"","path":"dylint_lints/de03_domain_layer/de0305_no_panics_in_domain/.cargo/config.toml","commit_id":"952488c1b3b742711ba7600bc7caf9a0a7d5cdaf","original_commit_id":"952488c1b3b742711ba7600bc7caf9a0a7d5cdaf","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's missing in all these files:\r\n```toml\r\n[target.'cfg(all())']\r\nrustflags = [\"-C\", \"linker=dylint-link\"]\r\n# The following can be used instead of the rustflags:\r\n# linker = \"dylint-link\"\r\n```\r\n\r\ncheck other lints","created_at":"2026-01-13T09:56:37Z","updated_at":"2026-01-13T10:00:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2685678616","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685678616"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2685678616"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685678616/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2,"side":"RIGHT","author_association":"MEMBER","original_position":2,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686506188","pull_request_review_id":3655880075,"id":2686506188,"node_id":"PRRC_kwDOPaLyBs6gINTM","diff_hunk":"@@ -0,0 +1,39 @@\n+[package]","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/Cargo.toml","commit_id":"072f9b8ead8d2f587f07e787b943da0164a19e24","original_commit_id":"2c8277819853d81e9615bb344a9603e87e99afa2","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Would you please add README.md file in every dylint rule like it was done for others?","created_at":"2026-01-13T13:47:19Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2686506188","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686506188"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2686506188"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686506188/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686519603","pull_request_review_id":3655880075,"id":2686519603,"node_id":"PRRC_kwDOPaLyBs6gIQkz","diff_hunk":"@@ -0,0 +1,21 @@\n+# template","path":"dylint_lints/de07_security/de0703_no_hardcoded_secrets/README.md","commit_id":"2c8277819853d81e9615bb344a9603e87e99afa2","original_commit_id":"2c8277819853d81e9615bb344a9603e87e99afa2","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can you make README.md format aligned with other existing dylints?","created_at":"2026-01-13T13:50:57Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2686519603","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686519603"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2686519603"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686519603/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687878442","pull_request_review_id":3655880075,"id":2687878442,"node_id":"PRRC_kwDOPaLyBs6gNcUq","diff_hunk":"@@ -0,0 +1,67 @@\n+# DE0308: No HTTP in Domain\n+\n+### What it does\n+\n+Checks that domain modules do not reference HTTP types or status codes.\n+\n+### Why is this bad?\n+\n+Domain modules should be transport-agnostic:\n+- **HTTP is just one transport**: Domain logic should work with any protocol (gRPC, WebSockets, CLI)\n+- **Tight coupling**: Domain becomes dependent on web layer\n+- **Harder to reuse**: Cannot use domain logic in non-HTTP contexts\n+- **Violates separation of concerns**: HTTP is a delivery detail, not business logic\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - HTTP types in domain\n+// File: src/domain/validation.rs\n+use http::StatusCode;\n+\n+pub fn check_result() -> StatusCode {\n+    StatusCode::OK  // HTTP-specific\n+}\n+```\n+\n+```rust\n+// ❌ Bad - HTTP status in domain error\n+use http::StatusCode;\n+\n+pub enum DomainError {\n+    NotFound(StatusCode),  // HTTP leaking into domain\n+}\n+```\n+\n+Use instead:\n+\n+```rust\n+// ✅ Good - domain errors converted in API layer\n+// File: src/domain/validation.rs\n+pub enum DomainResult {\n+    Success,\n+    NotFound,\n+    InvalidData,\n+}\n+\n+// File: src/api/rest/handlers.rs\n+impl From<DomainResult> for StatusCode {","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/README.md","commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","original_commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The lint itself is OK, but I believe this is a bit misleading 'good' example, because we do not want to suggest models to use status code mapping like this. See how we do it in 'examples/' folder with module samples. It's better to pick some realistic example I think","created_at":"2026-01-13T19:45:17Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687878442","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687878442"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687878442"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687878442/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":48,"side":"RIGHT","author_association":"MEMBER","original_position":48,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687890145","pull_request_review_id":3655880075,"id":2687890145,"node_id":"PRRC_kwDOPaLyBs6gNfLh","diff_hunk":"@@ -0,0 +1,61 @@\n+# DE0407: No Hardcoded Connection Strings\n+\n+### What it does\n+\n+Detects hardcoded database and service connection strings in source code.\n+\n+### Why is this bad?\n+\n+Hardcoded connection strings are a security and operational risk:\n+- **Exposes credentials**: Connection strings often contain username/password\n+- **Version control exposure**: Secrets are committed to git history\n+- **Environment inflexibility**: Different environments need different connections\n+- **Requires redeployment**: Changes need code modifications and rebuilds\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - hardcoded connection string\n+let db_url = \"postgres://user:password@localhost:5432/mydb\";\n+let cache = \"redis://localhost:6379\";\n+let mongo = \"mongodb://admin:secret@db.example.com/myapp\";\n+```\n+\n+```rust\n+// ❌ Bad - hardcoded with credentials\n+const DATABASE_URL: &str = \"postgresql://app:secretpass@prod.db.internal:5432/production\";\n+```\n+\n+Use instead:\n+\n+```rust\n+// ✅ Good - load from environment\n+let db_url = std::env::var(\"DATABASE_URL\")","path":"dylint_lints/de04_infrastructure/de0407_no_hardcoded_connection_strings/README.md","commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","original_commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Please check how examples get access to DB connection, we should suggest something aligned with our reference implementation, not just abstract 'good' practices","created_at":"2026-01-13T19:48:13Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687890145","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687890145"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687890145"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687890145/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":33,"side":"RIGHT","author_association":"MEMBER","original_position":33,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687903239","pull_request_review_id":3655880075,"id":2687903239,"node_id":"PRRC_kwDOPaLyBs6gNiYH","diff_hunk":"@@ -0,0 +1,72 @@\n+# DE0703: No Hardcoded Secrets\n+\n+### What it does\n+\n+Detects hardcoded secrets such as passwords, API keys, tokens, and private keys in source code.\n+\n+### Why is this bad?\n+\n+Hardcoded secrets create serious security vulnerabilities:\n+\n+- **Version control exposure**: Secrets are permanently in git history\n+- **Public repository risk**: Anyone can access credentials if repository is public\n+- **Difficult rotation**: Changing secrets requires code changes and redeployment\n+- **Compliance violations**: Fails security audits and compliance requirements\n+- **Credential theft**: Attackers can easily extract secrets from binaries\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - hardcoded API key\n+const API_KEY: &str = \"sk_live_abc123def456\";\n+let client = StripeClient::new(API_KEY);\n+```\n+\n+```rust\n+// ❌ Bad - hardcoded password\n+let password = \"MySecretPassword123!\";\n+let connection = connect_db(\"postgres://localhost\", password);\n+```\n+\n+```rust\n+// ❌ Bad - hardcoded JWT secret\n+const JWT_SECRET: &str = \"my-super-secret-jwt-key-2024\";\n+let token = encode(&claims, JWT_SECRET.as_bytes())?;\n+```\n+\n+Use instead:\n+\n+```rust\n+// ✅ Good - load from environment\n+let api_key = std::env::var(\"STRIPE_API_KEY\")\n+    .expect(\"STRIPE_API_KEY must be set\");\n+let client = StripeClient::new(&api_key);\n+```\n+\n+```rust\n+// ✅ Good - load from secure config\n+let config = Config::from_env()?;\n+let connection = connect_db(&config.db_url, &config.db_password);","path":"dylint_lints/de07_security/de0703_no_hardcoded_secrets/README.md","commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","original_commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can you please refer to proper connection string initialization from our 'examples/' ?","created_at":"2026-01-13T19:51:12Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687903239","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687903239"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687903239"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687903239/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":49,"side":"RIGHT","author_association":"MEMBER","original_position":49,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687926043","pull_request_review_id":3655880075,"id":2687926043,"node_id":"PRRC_kwDOPaLyBs6gNn8b","diff_hunk":"@@ -0,0 +1,75 @@\n+# DE0705: No Prebuilt SQL Queries\n+\n+### What it does\n+\n+Detects prebuilt SQL queries where strings are concatenated or formatted instead of using parameterized queries.\n+\n+### Why is this bad?\n+\n+Prebuilt SQL queries create security vulnerabilities:\n+- **SQL injection attacks**: Attackers can inject malicious SQL through user input\n+- **Data breaches**: Can lead to unauthorized data access or deletion\n+- **Authentication bypass**: Attackers can manipulate authentication queries\n+- **Industry standard**: Parameterized queries are the recommended practice\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - prebuilt query with string formatting\n+let query = format!(\"SELECT * FROM users WHERE id = {}\", user_input);\n+conn.execute(&query).await?;\n+```\n+\n+```rust\n+// ❌ Bad - string concatenation with SQL\n+let query = \"SELECT * FROM users WHERE name = '\".to_string() + name + \"'\";\n+db.query(&query).await?;\n+```\n+\n+```rust\n+// ❌ Bad - format! macro with SQL\n+let id = req.param(\"id\");\n+let sql = format!(\"DELETE FROM posts WHERE id = {}\", id);\n+conn.execute(&sql).await?;\n+```\n+\n+Use instead:\n+\n+```rust\n+// ✅ Good - parameterized query with sqlx\n+sqlx::query(\"SELECT * FROM users WHERE id = $1\")","path":"dylint_lints/de07_security/de0705_no_prebuild_sql_queries/README.md","commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","original_commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can you please check/add an example of using raw SQL in our sec orm + sea orm instead of sqlx? Because we do not want to allow to use sqlx","created_at":"2026-01-13T19:56:21Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687926043","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687926043"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687926043"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687926043/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":40,"side":"RIGHT","author_association":"MEMBER","original_position":40,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687928382","pull_request_review_id":3655880075,"id":2687928382,"node_id":"PRRC_kwDOPaLyBs6gNog-","diff_hunk":"@@ -0,0 +1,75 @@\n+# DE0705: No Prebuilt SQL Queries\n+\n+### What it does\n+\n+Detects prebuilt SQL queries where strings are concatenated or formatted instead of using parameterized queries.\n+\n+### Why is this bad?\n+\n+Prebuilt SQL queries create security vulnerabilities:\n+- **SQL injection attacks**: Attackers can inject malicious SQL through user input\n+- **Data breaches**: Can lead to unauthorized data access or deletion\n+- **Authentication bypass**: Attackers can manipulate authentication queries\n+- **Industry standard**: Parameterized queries are the recommended practice\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - prebuilt query with string formatting\n+let query = format!(\"SELECT * FROM users WHERE id = {}\", user_input);\n+conn.execute(&query).await?;\n+```\n+\n+```rust\n+// ❌ Bad - string concatenation with SQL\n+let query = \"SELECT * FROM users WHERE name = '\".to_string() + name + \"'\";\n+db.query(&query).await?;\n+```\n+\n+```rust\n+// ❌ Bad - format! macro with SQL\n+let id = req.param(\"id\");\n+let sql = format!(\"DELETE FROM posts WHERE id = {}\", id);\n+conn.execute(&sql).await?;\n+```\n+\n+Use instead:\n+\n+```rust\n+// ✅ Good - parameterized query with sqlx\n+sqlx::query(\"SELECT * FROM users WHERE id = $1\")\n+    .bind(user_input)","path":"dylint_lints/de07_security/de0705_no_prebuild_sql_queries/README.md","commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","original_commit_id":"5e69dbc933ee9ef194e9693775769b02aa28b3ed","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can you please create another dylint to prohibit use of sqlx and force developers to use SecORM?","created_at":"2026-01-13T19:56:52Z","updated_at":"2026-01-13T19:57:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224#discussion_r2687928382","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2687928382"},"html":{"href":"https://github.c
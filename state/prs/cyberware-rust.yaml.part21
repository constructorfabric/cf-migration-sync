code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3839831435","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#issuecomment-3839831435","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/231","id":3839831435,"node_id":"IC_kwDOPaLyBs7k3y2L","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T08:27:06Z","updated_at":"2026-02-03T08:27:06Z","body":"It's outdated, we have a new version of design","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3839831435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689358108","pull_request_review_id":3659352202,"id":2689358108,"node_id":"PRRC_kwDOPaLyBs6gTFkc","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I propose feature id to be GTS ID always, like:\n\n```\ngts.x.core.lic.feat.v1~a.b.c.d.v1\n```","created_at":"2026-01-14T07:53:26Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689358108","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689358108"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689358108"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689358108/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":29,"side":"RIGHT","author_association":"MEMBER","original_position":29,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689369334","pull_request_review_id":3659352202,"id":2689369334,"node_id":"PRRC_kwDOPaLyBs6gTIT2","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"377247e54af279e48dbf1fb5b21e4870956a115d","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do we really need to mix the license enforcement and usage collection?\n\nIt could be two independent modules as they have different load pattern and maybe storages behind:\n\n1. The 'usage collector' can just store the facts of usage, maybe in a historical way and with aggregates, with API like:\n- GET usage of feature A on tenant B in 2 flavours as of date X - own usage and usage over all the children tenants\n- GET usage of feature A usage type ... (here we assume that features may have separate 'usage type' attributes, so several features can have the same 'usage type') \n- GET quota of feature A on tenant B as of date X ...\n- ...\n \n2. The 'license enforcer' can have an API like:\n- is feature A enabled on tenant B (GET)\n- is feature X enabled on resource Y (GET)\n- acquire feature A on tenant B, or return an error (e.g. feature is not enabled, quota is over) (POST)\n- acquire feature X on resource Y, or return an error (e.g. feature is not enabled, quota is over) (POST)\n- ...\n\nThen, when license enforcer acquires a feature, it can report usage update as some async job (?)","created_at":"2026-01-14T07:58:11Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689369334","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689369334"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689369334"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689369334/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":33,"original_line":23,"side":"RIGHT","author_association":"MEMBER","original_position":23,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689377831","pull_request_review_id":3659352202,"id":2689377831,"node_id":"PRRC_kwDOPaLyBs6gTKYn","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can you please add a domain model diagram to see the objects and their relationship? We have features, quotas, resources, usage types. What else?","created_at":"2026-01-14T08:01:27Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689377831","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689377831"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689377831"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689377831/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":40,"side":"RIGHT","author_association":"MEMBER","original_position":40,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689382859","pull_request_review_id":3659352202,"id":2689382859,"node_id":"PRRC_kwDOPaLyBs6gTLnL","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe HyperSpot must always report usage of 'feature', then the usage collector can store usage for feature and for appropriate usage type","created_at":"2026-01-14T08:02:53Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689382859","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689382859"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689382859"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689382859/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":59,"side":"RIGHT","author_association":"MEMBER","original_position":59,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689384670","pull_request_review_id":3659352202,"id":2689384670,"node_id":"PRRC_kwDOPaLyBs6gTMDe","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.\n+","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"377247e54af279e48dbf1fb5b21e4870956a115d","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"+ the same for global (per-tenant) features, that are not scoped to specific resources\n\nalternatively we can have track usage as:\n```\n- usage_quantity\n- usage_type\n- resource_id\n- resource_tenant\n- resource_type (GTS UUID)\n```\n\nThen for global (per-tenant) feature we can say that resouce_id == resource_tenant and resource_type is `gts.x.core.idp.tenant.v1~`","created_at":"2026-01-14T08:03:33Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689384670","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689384670"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689384670"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689384670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":52,"original_line":60,"side":"RIGHT","author_association":"MEMBER","original_position":60,"position":52,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689385909","pull_request_review_id":3659352202,"id":2689385909,"node_id":"PRRC_kwDOPaLyBs6gTMW1","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.\n+\n+**License policies** - policies tell which **license features** should be enabled for given resource.\n+ \n+Policies are involved in the following interactions:\n+ \n+- HyperSpot creates/updates **license policy** for a resource during provisioning\n+- HyperSpot acquires (activates) **license policy** for a resource during provisioning\n+- HyperSpot releases (revokes) **license policy** when the resource is deleted or policy is revoked","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"+ the same for tenants (?)","created_at":"2026-01-14T08:04:03Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689385909","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689385909"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689385909"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689385909/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":67,"side":"RIGHT","author_association":"MEMBER","original_position":67,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689395964","pull_request_review_id":3659352202,"id":2689395964,"node_id":"PRRC_kwDOPaLyBs6gTOz8","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.\n+\n+**License policies** - policies tell which **license features** should be enabled for given resource.\n+ \n+Policies are involved in the following interactions:\n+ \n+- HyperSpot creates/updates **license policy** for a resource during provisioning\n+- HyperSpot acquires (activates) **license policy** for a resource during provisioning\n+- HyperSpot releases (revokes) **license policy** when the resource is deleted or policy is revoked\n+\n+## Features\n+\n+We need two checks (plugin API), which map to Account Server:\n+\n+1. `list_global_features(security_context) -> [LicensedFeature]`\n+2. `list_resource_features(security_context, licensing_resource_id) -> [LicensedFeature]`","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"yes, we need `list` and plus we need `acquire` and `release` to be implemented by the plugin as well","created_at":"2026-01-14T08:07:37Z","updated_at":"2026-01-14T08:13:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689395964","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689395964"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689395964"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689395964/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":74,"side":"RIGHT","author_association":"MEMBER","original_position":74,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689432793","pull_request_review_id":3659445690,"id":2689432793,"node_id":"PRRC_kwDOPaLyBs6gTXzZ","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's GTS ID on HyperSpot side. On platform side it's CTI, isn't it? That's what I meant by mapping","created_at":"2026-01-14T08:19:38Z","updated_at":"2026-01-14T08:19:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689432793","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689432793"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689432793"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689432793/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":29,"side":"RIGHT","in_reply_to_id":2689358108,"author_association":"MEMBER","original_position":29,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689438827","pull_request_review_id":3659453732,"id":2689438827,"node_id":"PRRC_kwDOPaLyBs6gTZRr","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"377247e54af279e48dbf1fb5b21e4870956a115d","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"They will be likely independent modules. Just in this document I wanted to cover related concepts. I'll update the document to make it explicit what is part of license_enforcer and what should be part of usage_reporter","created_at":"2026-01-14T08:21:13Z","updated_at":"2026-01-14T08:21:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689438827","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689438827"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689438827"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689438827/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":33,"original_line":23,"side":"RIGHT","in_reply_to_id":2689369334,"author_association":"MEMBER","original_position":23,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689443627","pull_request_review_id":3659459933,"id":2689443627,"node_id":"PRRC_kwDOPaLyBs6gTacr","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We don't have usages of features. Features and usages should be decoupled. Feature is a feature flag which says if this is allowed for this tenant/resource. Usage is reported to usage types. Platform unifies features and usage types in offering items, but it's platform concern.","created_at":"2026-01-14T08:23:02Z","updated_at":"2026-01-14T08:23:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689443627","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689443627"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689443627"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689443627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":59,"side":"RIGHT","in_reply_to_id":2689382859,"author_association":"MEMBER","original_position":59,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689468812","pull_request_review_id":3659490902,"id":2689468812,"node_id":"PRRC_kwDOPaLyBs6gTgmM","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.\n+\n+**License policies** - policies tell which **license features** should be enabled for given resource.\n+ \n+Policies are involved in the following interactions:\n+ \n+- HyperSpot creates/updates **license policy** for a resource during provisioning\n+- HyperSpot acquires (activates) **license policy** for a resource during provisioning\n+- HyperSpot releases (revokes) **license policy** when the resource is deleted or policy is revoked\n+\n+## Features\n+\n+We need two checks (plugin API), which map to Account Server:\n+\n+1. `list_global_features(security_context) -> [LicensedFeature]`\n+2. `list_resource_features(security_context, licensing_resource_id) -> [LicensedFeature]`","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Features are not acquired or released. Global features are provided by offering items. Resource-scoped features are provided by resource-policy pair. If we need something acquirable it's resources and policies. Policy tells which features are assigned to resource.","created_at":"2026-01-14T08:32:01Z","updated_at":"2026-01-14T08:32:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689468812","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689468812"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2689468812"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689468812/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":74,"side":"RIGHT","in_reply_to_id":2689395964,"author_association":"MEMBER","original_position":74,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698798806","pull_request_review_id":3671220027,"id":2698798806,"node_id":"PRRC_kwDOPaLyBs6g3GbW","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"377247e54af279e48dbf1fb5b21e4870956a115d","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I explicitly splitted license enforcement and usage reporting into two different modules. This document discuss both for convenience of understanding how these concepts relate","created_at":"2026-01-16T14:46:26Z","updated_at":"2026-01-16T14:46:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2698798806","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698798806"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2698798806"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698798806/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":33,"original_line":23,"side":"RIGHT","in_reply_to_id":2689369334,"author_association":"MEMBER","original_position":23,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698801345","pull_request_review_id":3671223114,"id":2698801345,"node_id":"PRRC_kwDOPaLyBs6g3HDB","diff_hunk":"@@ -0,0 +1,708 @@\n+# Licensing, usage, quotas\n+\n+This document describes how Hyperspot’s `license_enforcer` module should think about licensing in a way that maps to the **platform it integrates with** (named Platform below).\n+\n+## Problem statement\n+\n+A system operator might want to:\n+\n+- restrict access to features based on purchased subscription/offering (trial/paid)\n+- provide different sets of features to different users of given tenant (for example, basic seats, premium seats)\n+- charge tenants based on usage (tokens, premium requests, chats) and/or licensed resources (seats/users)\n+- enforce caps per tenant / per user / per chat\n+- provide auditable explanations (reports) for what a tenant is charged for\n+\n+## What Hyperspot should (and should not) do\n+\n+Hyperspot should **not** implement licensing/charging logic itself.\n+\n+Instead Hyperspot should:\n+\n+- ask Platform **what is enabled** (features)\n+- ask Platform **what is allowed** (quota/usage)\n+- **report usage** to Platform in the shape expected by the configured usage types\n+\n+## Licensing/usage/quotas domain model\n+\n+Licensing domain model is based on:\n+\n+- **Feature**: `feature_id` (can be mapped to/from GTS ID)\n+  - **global (tenant) features** (feature set scoped to specific tenant)\n+  - **resource features** (feature set can depend on which offering item is licensed on a resource)\n+\n+**Features** allow the following interactions:\n+\n+- Platform provides **features**\n+- HyperSpot (application) checks **features**.\n+\n+**Offering**: commercial package that provides features and is associated with one or more **usage types** is NOT part of HyperSpot license enforcer domain model. HyperSpot decouples features, and usages/quotas\n+\n+- **Usage type**: what is metered (e.g., `tokens`, `requests`, `storage`, `seats`, …)\n+- **Quota / usage / overage**:\n+  - `effective_quota` is the effective limit\n+\n+> Hyperspot should **not assume usage is strictly monotonic**: some usage types might be counters (requests), but some are gauges/snapshots (for example, file storage)\n+\n+**Usages** and **quotas** are involved in the following interactions:\n+\n+- HyperSpot requests information about current usages and quotas from Platform. \n+- HyperSpot reports usages\n+\n+**Licensing resource** - resource for which license should be acquired.\n+\n+**Licensing resources** are involved in the following interactions:\n+ \n+- Platform provides **features** scoped to given **resource**\n+- Platform provides usage and quota scoped to given **resource**\n+- HyperSpot can acquire license for **resource**\n+- HyperSpot can release license for **resource**\n+- HyperSpot can report usage to **usage item** scoped to given **resource**.\n+","path":"modules/license_enforcer/docs/DESIGN.md","commit_id":"377247e54af279e48dbf1fb5b21e4870956a115d","original_commit_id":"81fb6eba00eb52490eb9203ec2dc37f5e2cb53c6","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Currently I extracted design docs for phase 1. I believe we don't need resource features and per resource usage reporting for phase 1. Correct me if I am wrong. Phase 1 focuses on global features and global usage","created_at":"2026-01-16T14:47:13Z","updated_at":"2026-01-16T14:47:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2698801345","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698801345"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/231#discussion_r2698801345"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/231"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698801345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original
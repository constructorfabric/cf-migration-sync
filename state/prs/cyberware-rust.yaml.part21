+                check_type_rename_all(cx, &item.attrs);\n+                check_fields(cx, variant_data);\n+            }\n+            ItemKind::Enum(_, _, enum_def) => {\n+                check_type_rename_all(cx, &item.attrs);\n+                for variant in &enum_def.variants {\n+                    check_variant_rename(cx, &variant.attrs);\n+                    check_fields(cx, &variant.data);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n+\n+/// Extracts values from serde attributes matching the given name.\n+///\n+/// Handles both direct forms like `rename = \"value\"` and nested forms like\n+/// `rename(serialize = \"value1\", deserialize = \"value2\")`.\n+///\n+/// Returns spans and string values for all matching attributes.\n+fn find_serde_attribute_value(attrs: &[Attribute], attribute_name: &str) -> Vec<(rustc_span::Span, String)> {\n+    let mut results = Vec::new();\n+    \n+    for attr in attrs {\n+        if !attr.has_name(rustc_span::Symbol::intern(\"serde\")) {\n+            continue;\n+        }\n+\n+        let Some(list) = attr.meta_item_list() else {\n+            continue;\n+        };\n+\n+        for nested in list {\n+            let Some(meta_item) = nested.meta_item() else {\n+                continue;\n+            };\n+\n+            if !meta_item.has_name(rustc_span::Symbol::intern(attribute_name)) {\n+                continue;\n+            }\n+\n+            // Try to get direct value: rename = \"value\"\n+            if let Some(value) = meta_item.value_str() {\n+                results.push((meta_item.span, value.as_str().to_string()));\n+            }\n+            \n+            // Try to get nested list values: rename(serialize = \"value1\", deserialize = \"value2\")\n+            if let Some(inner_list) = meta_item.meta_item_list() {\n+                for inner_nested in inner_list {\n+                    let Some(inner_meta_item) = inner_nested.meta_item() && let Some(inner_value) = inner_meta_item.value_str() {\n+                        results.push((inner_meta_item.span, inner_value.as_str().to_string()));\n+                    }","path":"dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"661307ef3778c4bed8acebabdb09705ae28b7ce1","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\nfind . -path \"*de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs\" -type f\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 137\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n ./dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs | sed -n '75,95p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 973\n\n---\n\n🏁 Script executed:\n\n```shell\ncd ./dylint_lints/de08_rest_api_conventions/de0803_api_snake_case && cargo check 2>&1 | head -50\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 173\n\n---\n\n🏁 Script executed:\n\n```shell\n# Verify Rust syntax validity by examining the pattern\n# In Rust, 'let Some(...) && let Some(...)' is only valid in if-let chains, not in standalone let statements\npython3 << 'EOF'\n# Analyze the syntax\ncode_line = \"let Some(inner_meta_item) = inner_nested.meta_item() && let Some(inner_value) = inner_meta_item.value_str() {\"\n\n# This pattern shows:\n# 1. Starts with 'let' (standalone let statement, not if-let)\n# 2. Contains '&&' with another 'let Some'\n# 3. Ends with '{'\n# This is INVALID - let chains with && are only valid in if-let contexts\n\nprint(\"Analysis of line 85:\")\nprint(f\"Pattern: {code_line}\")\nprint(\"\\nIssue: 'let' chains with '&&' are only valid in 'if let' contexts\")\nprint(\"This is a standalone 'let' statement, which cannot use let chains\")\nprint(\"\\nValid alternatives:\")\nprint(\"1. if let Some(...) && let Some(...) { ... }\")\nprint(\"2. Nested if let blocks\")\nprint(\"\\nConclusion: The syntax is INVALID and will not compile\")\nEOF\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 150\n\n---\n\n🏁 Script executed:\n\n```shell\n# Let's examine more context around the problematic line to understand the intent\ncat -n ./dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs | sed -n '80,92p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 697\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there are any other compilation errors in this file by examining the entire context\nwc -l ./dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 141\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for similar let-chain patterns in the codebase to understand convention\nrg \"let Some.*&&.*let Some\" --type rust -A 2 -B 2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 787\n\n---\n\n\n\n</details>\n\n**Fix invalid `let` statement syntax in nested serde parsing.**\n\nLine 85 uses `let Some(...) && let Some(...)` which is invalid Rust syntax. Let-chains with `&&` are only permitted in `if let` contexts, not standalone `let` statements. Use nested `if let` blocks instead:\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-                    let Some(inner_meta_item) = inner_nested.meta_item() && let Some(inner_value) = inner_meta_item.value_str() {\n-                        results.push((inner_meta_item.span, inner_value.as_str().to_string()));\n-                    }\n+                    if let Some(inner_meta_item) = inner_nested.meta_item() {\n+                        if let Some(inner_value) = inner_meta_item.value_str() {\n+                            results.push((inner_meta_item.span, inner_value.as_str().to_string()));\n+                        }\n+                    }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de08_rest_api_conventions/de0803_api_snake_case/src/lib.rs`\naround lines 82 - 87, The line using \"let Some(inner_meta_item) =\ninner_nested.meta_item() && let Some(inner_value) = inner_meta_item.value_str()\"\nis invalid; replace it with nested conditional pattern matching (e.g., an outer\nif let to extract inner_meta_item from inner_nested.meta_item() and an inner if\nlet to extract inner_value from inner_meta_item.value_str()) so that\nresults.push((inner_meta_item.span, inner_value.as_str().to_string())) only runs\nwhen both are Some; update the block that iterates inner_list (the code handling\nmeta_item_list(), inner_nested, inner_meta_item, inner_value and results.push)\naccordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit c719a8a","created_at":"2026-01-21T14:36:33Z","updated_at":"2026-01-21T14:52:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2712859478","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2712859478"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2712859478"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2712859478/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":82,"original_start_line":82,"start_side":"RIGHT","line":91,"original_line":87,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":87,"position":91,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2716027592","pull_request_review_id":3691437376,"id":2716027592,"node_id":"PRRC_kwDOPaLyBs6h40rI","diff_hunk":"@@ -1061,3 +1062,62 @@ pub fn grpc_client(attr: TokenStream, item: TokenStream) -> TokenStream {\n         Err(e) => TokenStream::from(e.to_compile_error()),\n     }\n }\n+\n+/// Generates API DTO (Data Transfer Object) boilerplate for REST API types.\n+///\n+/// This macro automatically derives the necessary traits and attributes for types\n+/// used in REST API requests and responses, ensuring they follow API conventions.\n+///\n+/// # Arguments\n+///\n+/// - `request` - Marks the type as a request DTO (adds `Deserialize` and `RequestApiDto`)\n+/// - `response` - Marks the type as a response DTO (adds `Serialize` and `ResponseApiDto`)\n+///\n+/// At least one of `request` or `response` must be specified. Both can be used together\n+/// for types that serve as both request and response DTOs.\n+///\n+/// # Generated Code\n+///\n+/// The macro generates:\n+/// - `#[derive(serde::Serialize)]` if `response` is specified\n+/// - `#[derive(serde::Deserialize)]` if `request` is specified\n+/// - `#[derive(utoipa::ToSchema)]` for OpenAPI schema generation\n+/// - `#[serde(rename_all = \"snake_case\")]` to enforce snake_case field naming\n+/// - `impl RequestApiDto` if `request` is specified\n+/// - `impl ResponseApiDto` if `response` is specified\n+///\n+/// # Examples\n+///\n+/// ```ignore\n+/// // Request-only DTO\n+/// #[api_dto(request)]\n+/// pub struct CreateUserRequest {\n+///     pub user_name: String,\n+///     pub email: String,\n+/// }\n+///\n+/// // Response-only DTO\n+/// #[api_dto(response)]\n+/// pub struct UserResponse {\n+///     pub id: String,\n+///     pub user_name: String,\n+/// }\n+///\n+/// // Both request and response\n+/// #[api_dto(request, response)]\n+/// pub struct UserDto {\n+///     pub id: String,\n+///     pub user_name: String,\n+/// }\n+/// ```\n+///\n+/// # Field Naming\n+///\n+/// All fields are automatically converted to snake_case in JSON serialization,\n+/// regardless of the Rust field name.\n+#[proc_macro_attribute]\n+pub fn api_dto(attr: TokenStream, item: TokenStream) -> TokenStream {\n+    let attrs = parse_macro_input!(attr with Punctuated::<Ident, Token![,]>::parse_terminated);\n+    let input = parse_macro_input!(item as DeriveInput);\n+    TokenStream::from(api_dto::expand_api_dto(&attrs, &input))\n+}","path":"libs/modkit-macros/src/lib.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"308f35d1d49bc1425173821472b29b999fc60a00","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Validate api_dto flags to prevent silent typos.**  \nUnknown/duplicate flags are currently ignored, which can silently omit `Serialize`/`ResponseApiDto` on misspellings. Consider validating args and reporting precise errors.\n\n<details>\n<summary>🛠️ Suggested validation (inside <code>api_dto</code>)</summary>\n\n```diff\n #[proc_macro_attribute]\n pub fn api_dto(attr: TokenStream, item: TokenStream) -> TokenStream {\n     let attrs = parse_macro_input!(attr with Punctuated::<Ident, Token![,]>::parse_terminated);\n+    let mut seen_request = false;\n+    let mut seen_response = false;\n+    for id in &attrs {\n+        match id.to_string().as_str() {\n+            \"request\" => {\n+                if std::mem::replace(&mut seen_request, true) {\n+                    return syn::Error::new_spanned(id, \"duplicate `request` flag\")\n+                        .to_compile_error()\n+                        .into();\n+                }\n+            }\n+            \"response\" => {\n+                if std::mem::replace(&mut seen_response, true) {\n+                    return syn::Error::new_spanned(id, \"duplicate `response` flag\")\n+                        .to_compile_error()\n+                        .into();\n+                }\n+            }\n+            other => {\n+                return syn::Error::new_spanned(\n+                    id,\n+                    format!(\"unknown api_dto flag `{other}`; expected `request` and/or `response`\"),\n+                )\n+                .to_compile_error()\n+                .into();\n+            }\n+        }\n+    }\n     let input = parse_macro_input!(item as DeriveInput);\n     TokenStream::from(api_dto::expand_api_dto(&attrs, &input))\n }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\npub fn api_dto(attr: TokenStream, item: TokenStream) -> TokenStream {\n    let attrs = parse_macro_input!(attr with Punctuated::<Ident, Token![,]>::parse_terminated);\n    let mut seen_request = false;\n    let mut seen_response = false;\n    for id in &attrs {\n        match id.to_string().as_str() {\n            \"request\" => {\n                if std::mem::replace(&mut seen_request, true) {\n                    return syn::Error::new_spanned(id, \"duplicate `request` flag\")\n                        .to_compile_error()\n                        .into();\n                }\n            }\n            \"response\" => {\n                if std::mem::replace(&mut seen_response, true) {\n                    return syn::Error::new_spanned(id, \"duplicate `response` flag\")\n                        .to_compile_error()\n                        .into();\n                }\n            }\n            other => {\n                return syn::Error::new_spanned(\n                    id,\n                    format!(\"unknown api_dto flag `{other}`; expected `request` and/or `response`\"),\n                )\n                .to_compile_error()\n                .into();\n            }\n        }\n    }\n    let input = parse_macro_input!(item as DeriveInput);\n    TokenStream::from(api_dto::expand_api_dto(&attrs, &input))\n}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-macros/src/lib.rs` around lines 1119 - 1123, The api_dto macro\ncurrently ignores unknown or duplicate flag idents, so add validation in the\napi_dto function: parse the attrs into idents as you already do, then iterate\nthem to check against an allowed set (e.g., \"Serialize\", \"ResponseApiDto\",\netc.), detect duplicates, and if any unknown or duplicate flags are found return\na compile error by creating a syn::Error (e.g., syn::Error::new_spanned) and\nreturning TokenStream::from(err.to_compile_error()). Update api_dto to perform\nthis validation before calling api_dto::expand_api_dto and pass validated flags\n(or bail early with the compile error) so typos are reported precisely.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-22T09:21:40Z","updated_at":"2026-01-22T09:21:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2716027592","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2716027592"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/247#discussion_r2716027592"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/247"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2716027592/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1119,"original_start_line":1119,"start_side":"RIGHT","line":1123,"original_line":1123,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":70,"position":70,"subject_type":"line
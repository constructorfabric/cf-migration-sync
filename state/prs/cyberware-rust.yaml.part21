-rust/pulls/comments/2716251059","pull_request_review_id":3691695654,"id":2716251059,"node_id":"PRRC_kwDOPaLyBs6h5rOz","diff_hunk":"@@ -0,0 +1,30 @@\n+// simulated_dir=/hyperspot/modules/some_module/contract/\n+#![allow(dead_code)]\n+\n+// Should trigger DE0104 - api_dto in contract\n+#[modkit_macros::api_dto(request, response)]\n+pub struct User {\n+    pub id: String,\n+    pub name: String,\n+}\n+\n+// Should trigger DE0104 - api_dto in contract\n+#[modkit_macros::api_dto(response)]\n+pub struct Product {\n+    pub id: String,\n+    pub price: f64,\n+}\n+\n+// Should trigger DE0104 - api_dto in contract\n+#[modkit_macros::api_dto(request)]\n+pub enum OrderStatus {\n+    Pending,\n+    Completed,\n+}","path":"dylint_lints/de01_contract_layer/de0104_no_api_dto_in_contract/ui/with_api_dto.rs","commit_id":"2686d00b2004648d3fbd1bf68419c111f1f362e6","original_commit_id":"e2e7b31cddb6128bd0c48374455045956f48158b","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Discarded, comments are on the right line","created_at":"2026-01-22T10:22:04Z","updated_at":
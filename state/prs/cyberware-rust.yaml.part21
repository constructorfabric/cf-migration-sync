ub.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"let's move it to separate module. mod.rs is too overcomplicated now.","created_at":"2026-01-19T11:43:47Z","updated_at":"2026-01-19T12:05:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704420750","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704420750"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2704420750"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2704420750/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1185,"side":"RIGHT","author_association":"MEMBER","original_position":248,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710760859","pull_request_review_id":3685126755,"id":2710760859,"node_id":"PRRC_kwDOPaLyBs6hku2b","diff_hunk":"","path":"modules/system/api_gateway/assets/elements/web-components.min.js","commit_id":"41852522b60c7d9a3a0c14ba9930a0254dbd528c","original_commit_id":"17b5ad6cdcc032579866687a94f87147d7eb0da8","user":{"login":"bit8shift","id":253408973,"node_id":"U_kgDODxq2zQ","avatar_url":"https://avatars.githubusercontent.com/u/253408973?v=4","gravatar_id":"","url":"https://api.github.com/users/bit8shift","html_url":"https://github.com/bit8shift","followers_url":"https://api.github.com/users/bit8shift/followers","following_url":"https://api.github.com/users/bit8shift/following{/other_user}","gists_url":"https://api.github.com/users/bit8shift/gists{/gist_id}","starred_url":"https://api.github.com/users/bit8shift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bit8shift/subscriptions","organizations_url":"https://api.github.com/users/bit8shift/orgs","repos_url":"https://api.github.com/users/bit8shift/repos","events_url":"https://api.github.com/users/bit8shift/events{/privacy}","received_events_url":"https://api.github.com/users/bit8shift/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"will remove ","created_at":"2026-01-21T02:47:33Z","updated_at":"2026-01-21T02:47:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2710760859","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710760859"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2710760859"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710760859/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","in_reply_to_id":2704414584,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710770623","pull_request_review_id":3677306706,"id":2710770623,"node_id":"PRRC_kwDOPaLyBs6hkxO_","diff_hunk":"@@ -1153,6 +1182,202 @@ pub fn module_home(app: &AppConfig, module_name: &str) -> PathBuf {\n     PathBuf::from(&app.server.home_dir).join(module_name)\n }\n \n+// ---- Effective Module Configuration Dump Support ----\n+\n+/// List all module names present in the configuration.\n+///\n+/// Returns a sorted vector of module names that are configured in the `AppConfig`.\n+/// This is useful for discovering available modules before dumping their configuration.\n+///\n+/// # Example\n+/// ```no_run\n+/// use modkit::bootstrap::AppConfig;\n+/// # fn example(config: &AppConfig) {\n+/// let modules = modkit::bootstrap::config::list_module_names(config);\n+/// for module in modules {\n+///     println!(\"Module: {}\", module);\n+/// }\n+/// # }\n+/// ```\n+#[must_use]\n+pub fn list_module_names(app: &AppConfig) -> Vec<String> {\n+    let mut names: Vec<String> = app.modules.keys().cloned().collect();\n+    names.sort();\n+    names\n+}\n+\n+/// Render effective configuration for all loaded modules.\n+///\n+/// This function builds a complete view of the effective runtime configuration\n+/// for each module that is successfully loaded in the `ModuleRegistry`.\n+///\n+/// For each module, it includes:\n+/// - `runtime`: Module runtime type (local/oop) if configured\n+/// - `config`: Module-specific configuration section (as-is from config file)\n+/// - `database`: Final resolved database configuration with redacted DSN (if applicable)\n+///\n+/// This is a read-only inspection operation that does not create any directories\n+/// or modify the filesystem.\n+///\n+/// Modules with configuration errors are logged as warnings and skipped,\n+/// allowing inspection of valid modules even when some are misconfigured.\n+///\n+/// # Errors\n+/// Returns an error if a fatal error occurs (e.g., DSN redaction failure).\n+pub fn render_effective_modules_config(app: &AppConfig) -> Result<serde_json::Value> {\n+    use serde_json::json;\n+\n+    let home_dir = PathBuf::from(&app.server.home_dir);\n+    let mut modules_config = serde_json::Map::new();\n+\n+    // Iterate over all modules in the configuration\n+    for module_name in app.modules.keys() {\n+        let mut module_entry = serde_json::Map::new();\n+\n+        // Parse module config once for efficiency\n+        let parsed_config = match parse_module_config(app, module_name) {\n+            Ok(config) => config,\n+            Err(e) => {\n+                tracing::warn!(\n+                    module = %module_name,\n+                    error = %e,\n+                    \"Failed to parse module config, skipping\"\n+                );\n+                continue;\n+            }\n+        };\n+\n+        // Get runtime configuration if present\n+        if let Some(runtime_config) = parsed_config.runtime {\n+            module_entry.insert(\n+                \"runtime\".to_owned(),\n+                json!({\n+                    \"type\": match runtime_config.mod_type {\n+                        RuntimeKind::Local => \"local\",\n+                        RuntimeKind::Oop => \"oop\",\n+                    }\n+                }),\n+            );\n+        }\n+\n+        // Get module config section (the \"config\" field)\n+        if !parsed_config.config.is_null() {\n+            module_entry.insert(\"config\".to_owned(), parsed_config.config);\n+        }\n+\n+        // Get database configuration (resolved DSN + pool) - use dry_run=true\n+        match build_final_db_for_module(app, module_name, &home_dir, true) {\n+            Ok(Some((dsn, pool))) => {\n+                // Redact password in DSN (fatal error if this fails)\n+                let redacted_dsn = redact_dsn_password(&dsn)?;","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"48074954f35cfc129a652af967b3c2cf0bfe25e5","original_commit_id":"48074954f35cfc129a652af967b3c2cf0bfe25e5","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Password redaction error causes entire dump to fail instead of skipping problematic module. If `redact_dsn_password` fails (e.g., malformed URL), it will propagate the error with `?` and abort the entire dump operation, inconsistent with the error handling for `build_final_db_for_module` which logs and continues. This could prevent inspecting valid modules if one has a malformed DSN.\n\n```rust\nmatch build_final_db_for_module(app, module_name, &home_dir, true) {\n    Ok(Some((dsn, pool))) => {\n        // Redact password in DSN, skip module on error\n        let redacted_dsn = match redact_dsn_password(&dsn) {\n            Ok(dsn) => dsn,\n            Err(e) => {\n                tracing::warn!(\n                    module = %module_name,\n                    error = %e,\n                    \"Failed to redact DSN password, skipping\"\n                );\n                continue;\n            }\n        };\n```\n```suggestion\n        match build_final_db_for_module(app, module_name, &home_dir, true) {\n            Ok(Some((dsn, pool))) => {\n                // Redact password in DSN, skip module on error\n                let redacted_dsn = match redact_dsn_password(&dsn) {\n                    Ok(dsn) => dsn,\n                    Err(e) => {\n                        tracing::warn!(\n                            module = %module_name,\n                            error = %e,\n                            \"Failed to redact DSN password, skipping\"\n                        );\n                        continue;\n                    }\n                };\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/277?chatWithGeneratedComment=ec4f2131-88d1-4abc-8656-6a96722f2c6b\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-21T02:53:25Z","updated_at":"2026-01-21T02:53:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2710770623","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710770623"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/277#discussion_r2710770623"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2710770623/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1269,"start_side":"RIGHT","line":null,"original_line":1272,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":335,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/27
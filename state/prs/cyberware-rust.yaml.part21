\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Some files should be sent to the provider in their original format, e.g., images and videos. From my point of view, by default, we should send files without parsing. In cases where parsing is needed, the caller should parse the file via FileParser and send plain text to llm-gateway.","created_at":"2026-01-15T09:07:35Z","updated_at":"2026-01-15T09:07:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693544483","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693544483"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693544483"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693544483/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":32,"side":"RIGHT","in_reply_to_id":2693494346,"author_association":"MEMBER","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693556335","pull_request_review_id":3664594693,"id":2693556335,"node_id":"PRRC_kwDOPaLyBs6gjGhv","diff_hunk":"@@ -0,0 +1,88 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"From a component's perspective, video generation and other types of generation appear identical. We send a request to the provider and receive a file in return.","created_at":"2026-01-15T09:10:31Z","updated_at":"2026-01-15T09:10:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693556335","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693556335"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693556335"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693556335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":18,"original_line":18,"side":"RIGHT","in_reply_to_id":2693499795,"author_association":"MEMBER","original_position":18,"position":18,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693574055","pull_request_review_id":3664617677,"id":2693574055,"node_id":"PRRC_kwDOPaLyBs6gjK2n","diff_hunk":"@@ -0,0 +1,88 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |\n+| [ ] | Pre-call interceptor |\n+| [ ] | Post-response interceptor |\n+| [ ] | Per-tenant budget enforcement |\n+| [ ] | Request cancellation |\n+| [ ] | Rate limiting (tenant/user) |\n+\n+### P3 — Optimization\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Cost-aware routing |\n+| [ ] | Embeddings batching |\n+| [ ] | Usage tracking |\n+\n+### P4 — Enterprise\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Audit events |\n+\n+## Module Structure\n+\n+```\n+modules/llm_gateway/\n+├── llm_gateway-sdk/         # Public API traits, models, errors\n+├── llm_gateway-gw/          # Gateway implementation\n+└── plugins/\n+    ├── openai_plugin/       # OpenAI-compatible providers\n+    ├── anthropic_plugin/    # Claude API\n+    └── ollama_plugin/       # Local models via Ollama\n+```\n+\n+## Documentation\n+\n+- [SCENARIOS.md](docs/SCENARIOS.md) — Usage scenarios with sequence diagrams\n+- [ARCHITECTURE.md](docs/ARCHITECTURE.md) — Gateway + Plugin design, component interactions\n+- [API.md](docs/API.md) — SDK traits, request/response models, errors\n+- [PROVIDERS.md](docs/PROVIDERS.md) — Provider abstraction, capability matrix\n+- [CONFIGURATION.md](docs/CONFIGURATION.md) — Gateway and plugin configuration\n+\n+## Dependencies\n+\n+| Module | Role |\n+|--------|------|\n+| FileStorage | Fetch input media, store generated content |\n+| Credential Resolver | API key management |\n+| Usage Tracker | Token/cost reporting |\n+| Hook System | `llm.pre_call`, `llm.post_response` interceptors |\n+| Audit | Request/response logging |\n+\n+## Consumers\n+\n+| Module | Usage |\n+|--------|-------|\n+| Chat Engine | Response generation |\n+| RAG | Embeddings for semantic search |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"What is this service and what exactly consumes from llm_gateway?\r\nAs far as I understand, RAG should be a feature to be used along with the models.","created_at":"2026-01-15T09:14:54Z","updated_at":"2026-01-15T09:53:29Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693574055","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693574055"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693574055"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693574055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":97,"original_line":88,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":97,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693722217","pull_request_review_id":3664795526,"id":2693722217,"node_id":"PRRC_kwDOPaLyBs6gjvBp","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it's worth noting that the deltas are first stored in the database before sending them back to the user","created_at":"2026-01-15T09:57:03Z","updated_at":"2026-01-15T10:02:40Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693722217","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693722217"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693722217"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693722217/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":131,"side":"RIGHT","author_association":"MEMBER","original_position":131,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693725021","pull_request_review_id":3664795526,"id":2693725021,"node_id":"PRRC_kwDOPaLyBs6gjvtd","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta\n+        GW-->>C: SSE: delta\n+    end\n+    P-->>GW: done + usage\n+    GW-->>C: SSE: done + usage\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"9a18759ffdf8f5214c073effe09f4d428bc8753b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If client disconnects there should be still a background worker fetching the response for when the user returns","created_at":"2026-01-15T09:57:56Z","updated_at":"2026-01-15T10:02:40Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693725021","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693725021"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693725021"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693725021/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":139,"side":"RIGHT","author_association":"MEMBER","original_position":139,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693731565","pull_request_review_id":3664795526,"id":2693731565,"node_id":"PRRC_kwDOPaLyBs6gjxTt","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta\n+        GW-->>C: SSE: delta\n+    end\n+    P-->>GW: done + usage\n+    GW-->>C: SSE: done + usage\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response\n+- Provider timeout → emit error event, close stream\n+\n+---\n+\n+### [ ] S1.3 Embeddings Generation\n+\n+Consumer sends text(s), Gateway returns vector embeddings. Supports single text or batch input.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: embed(model, input[])\n+    GW->>P: Provider embeddings API\n+    P-->>GW: vectors[] + usage","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"store them in the database before sending them back, the time taken can be high to keep that connection open","created_at":"2026-01-15T09:59:47Z","updated_at":"2026-01-15T10:02:40Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693731565","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693731565"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693731565"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693731565/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":156,"side":"RIGHT","author_association":"MEMBER","original_position":156,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693744961","pull_request_review_id":3664824220,"id":2693744961,"node_id":"PRRC_kwDOPaLyBs6gj0lB","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"P1 mentions tool/function calling. Are they part of message content?","created_at":"2026-01-15T10:03:50Z","updated_at":"2026-01-15T10:03:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693744961","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693744961"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693744961"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693744961/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":26,"side":"RIGHT","author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693792912","pull_request_review_id":3664888529,"id":2693792912,"node_id":"PRRC_kwDOPaLyBs6gkASQ","diff_hunk":"@@ -0,0 +1,88 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |\n+| [ ] | Pre-call interceptor |\n+| [ ] | Post-response interceptor |\n+| [ ] | Per-tenant budget enforcement |\n+| [ ] | Request cancellation |\n+| [ ] | Rate limiting (tenant/user) |\n+\n+### P3 — Optimization\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Cost-aware routing |\n+| [ ] | Embeddings batching |\n+| [ ] | Usage tracking |\n+\n+### P4 — Enterprise\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Audit events |\n+\n+## Module Structure\n+\n+```\n+modules/llm_gateway/\n+├── llm_gateway-sdk/         # Public API traits, models, errors\n+├── llm_gateway-gw/          # Gateway implementation\n+└── plugins/\n+    ├── openai_plugin/       # OpenAI-compatible providers\n+    ├── anthropic_plugin/    # Claude API\n+    └── ollama_plugin/       # Local models via Ollama\n+```\n+\n+## Documentation\n+\n+- [SCENARIOS.md](docs/SCENARIOS.md) — Usage scenarios with sequence diagrams\n+- [ARCHITECTURE.md](docs/ARCHITECTURE.md) — Gateway + Plugin design, component interactions\n+- [API.md](docs/API.md) — SDK traits, request/response models, errors\n+- [PROVIDERS.md](docs/PROVIDERS.md) — Provider abstraction, capability matrix\n+- [CONFIGURATION.md](docs/CONFIGURATION.md) — Gateway and plugin configuration\n+\n+## Dependencies\n+\n+| Module | Role |\n+|--------|------|\n+| FileStorage | Fetch input media, store generated content |\n+| Credential Resolver | API key management |\n+| Usage Tracker | Token/cost reporting |\n+| Hook System | `llm.pre_call`, `llm.post_response` interceptors |\n+| Audit | Request/response logging |\n+\n+## Consumers\n+\n+| Module | Usage |\n+|--------|-------|\n+| Chat Engine | Response generation |\n+| RAG | Embeddings for semantic search |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"To perform semantic search, the RAG service must obtain the embedding of the search query. \r\nI think that the llm-gateway should be the only point of integration with llm-providers.","created_at":"2026-01-15T10:18:08Z","updated_at":"2026-01-15T10:18:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693792912","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693792912"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693792912"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693792912/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":97,"original_line":88,"side":"RIGHT","in_reply_to_id":2693574055,"author_association":"MEMBER","original_position":88,"position":97,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693807163","pull_request_review_id":3664904039,"id":2693807163,"node_id":"PRRC_kwDOPaLyBs6gkDw7","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta\n+        GW-->>C: SSE: delta\n+    end\n+    P-->>GW: done + usage\n+    GW-->>C: SSE: done + usage\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response\n+- Provider timeout → emit error event, close stream\n+\n+---\n+\n+### [ ] S1.3 Embeddings Generation\n+\n+Consumer sends text(s), Gateway returns vector embeddings. Supports single text or batch input.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: embed(model, input[])\n+    GW->>P: Provider embeddings API\n+    P-->>GW: vectors[] + usage","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In this case, llm-gateway should have its own vector-db. I'm not sure that we should add such a dependency to llm-gateway. From my perspective, this service should be as stateless as possible.","created_at":"2026-01-15T10:22:14Z","updated_at":"2026-01-15T10:22:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693807163","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693807163"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693807163"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693807163/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":156,"side":"RIGHT","in_reply_to_id":2693731565,"author_association":"MEMBER","original_position":156,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693862587","pull_request_review_id":3664978716,"id":2693862587,"node_id":"PRRC_kwDOPaLyBs6gkRS7","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In this case, we will have some state inside this component. I think such cases should be covered by the chat engine component.","created_at":"2026-01-15T10:39:00Z","updated_at":"2026-01-15T10:39:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693862587","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693862587"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693862587"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693862587/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":131,"side":"RIGHT","in_reply_to_id":2693722217,"author_association":"MEMBER","original_position":131,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693863870","pull_request_review_id":3664980560,"id":2693863870,"node_id":"PRRC_kwDOPaLyBs6gkRm-","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta\n+        GW-->>C: SSE: delta\n+    end\n+    P-->>GW: done + usage\n+    GW-->>C: SSE: done + usage\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"9a18759ffdf8f5214c073effe09f4d428bc8753b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it will be the chat engine's responsibility.","created_at":"2026-01-15T10:39:27Z","updated_at":"2026-01-15T10:39:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693863870","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693863870"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693863870"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693863870/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":139,"side":"RIGHT","in_reply_to_id":2693725021,"author_association":"MEMBER","original_position":139,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693877015","pull_request_review_id":3664995955,"id":2693877015,"node_id":"PRRC_kwDOPaLyBs6gkU0X","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks! Added.","created_at":"2026-01-15T10:43:47Z","updated_at":"2026-01-15T10:43:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693877015","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693877015"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2693877015"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2693877015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":26,"side":"RIGHT","in_reply_to_id":2693744961,"author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694170865","pull_request_review_id":3665342339,"id":2694170865,"node_id":"PRRC_kwDOPaLyBs6glcjx","diff_hunk":"@@ -0,0 +1,832 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+\n+**Input**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider.\n+\n+**Output**: Gateway stores generated media via FileStorage, returns URLs.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Usage Tracker | Token/cost reporting |\n+\n+**Input media**: Consumer uploads to FileStorage independently, provides URLs to Gateway. Gateway fetches content before sending to provider.\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway forwards provider stream events to consumer, emits final usage on completion.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Token chunks\n+        P-->>GW: delta\n+        GW-->>C: SSE: delta\n+    end\n+    P-->>GW: done + usage\n+    GW-->>C: SSE: done + usage\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response\n+- Provider timeout → emit error event, close stream\n+\n+---\n+\n+### [ ] S1.3 Embeddings Generation\n+\n+Consumer sends text(s), Gateway returns vector embeddings. Supports single text or batch input.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: embed(model, input[])\n+    GW->>P: Provider embeddings API\n+    P-->>GW: vectors[] + usage","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"c45c0513e9607ffe3e60bd626baacda72f1288d8","user":{"login":"Qilin101","id":255116568,"node_id":"U_kgDODzTFGA","avatar_url":"https://avatars.githubusercontent.com/u/255116568?v=4","gravatar_id":"","url":"https://api.github.com/users/Qilin101","html_url":"https://github.com/Qilin101","followers_url":"https://api.github.com/users/Qilin101/followers","following_url":"https://api.github.com/users/Qilin101/following{/other_user}","gists_url":"https://api.github.com/users/Qilin101/gists{/gist_id}","starred_url":"https://api.github.com/users/Qilin101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qilin101/subscriptions","organizations_url":"https://api.github.com/users/Qilin101/orgs","repos_url":"https://api.github.com/users/Qilin101/repos","events_url":"https://api.github.com/users/Qilin101/events{/privacy}","received_events_url":"https://api.github.com/users/Qilin101/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"if we want to just store vectors (no search) we can store them in a regular db  \r\nbut imo it makes sense only for async job, embedding is usually reasonably quick","created_at":"2026-01-15T12:20:55Z","updated_at":"2026-01-15T12:20:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694170865","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694170865"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694170865"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694170865/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":156,"side":"RIGHT","in_reply_to_id":2693731565,"author_association":"MEMBER","original_position":156,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694180052","pull_request_review_id":3665352968,"id":2694180052,"node_id":"PRRC_kwDOPaLyBs6glezU","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"Qilin101","id":255116568,"node_id":"U_kgDODzTFGA","avatar_url":"https://avatars.githubusercontent.com/u/255116568?v=4","gravatar_id":"","url":"https://api.github.com/users/Qilin101","html_url":"https://github.com/Qilin101","followers_url":"https://api.github.com/users/Qilin101/followers","following_url":"https://api.github.com/users/Qilin101/following{/other_user}","gists_url":"https://api.github.com/users/Qilin101/gists{/gist_id}","starred_url":"https://api.github.com/users/Qilin101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qilin101/subscriptions","organizations_url":"https://api.github.com/users/Qilin101/orgs","repos_url":"https://api.github.com/users/Qilin101/repos","events_url":"https://api.github.com/users/Qilin101/events{/privacy}","received_events_url":"https://api.github.com/users/Qilin101/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"who is managing available models? are models configured in this component somehow?","created_at":"2026-01-15T12:24:11Z","updated_at":"2026-01-15T12:33:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694180052","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694180052"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694180052"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694180052/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694183221","pull_request_review_id":3665352968,"id":2694183221,"node_id":"PRRC_kwDOPaLyBs6glfk1","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |\n+| [ ] | Pre-call interceptor |\n+| [ ] | Post-response interceptor |\n+| [ ] | Per-tenant budget enforcement |\n+| [ ] | Request cancellation |\n+| [ ] | Rate limiting (tenant/user) |\n+\n+### P3 — Optimization\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Cost-aware routing |\n+| [ ] | Embeddings batching |\n+| [ ] | Usage tracking |","path":"modules/llm_gateway/README.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"Qilin101","id":255116568,"node_id":"U_kgDODzTFGA","avatar_url":"https://avatars.githubusercontent.com/u/255116568?v=4","gravatar_id":"","url":"https://api.github.com/users/Qilin101","html_url":"https://github.com/Qilin101","followers_url":"https://api.github.com/users/Qilin101/followers","following_url":"https://api.github.com/users/Qilin101/following{/other_user}","gists_url":"https://api.github.com/users/Qilin101/gists{/gist_id}","starred_url":"https://api.github.com/users/Qilin101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qilin101/subscriptions","organizations_url":"https://api.github.com/users/Qilin101/orgs","repos_url":"https://api.github.com/users/Qilin101/repos","events_url":"https://api.github.com/users/Qilin101/events{/privacy}","received_events_url":"https://api.github.com/users/Qilin101/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"usage tracking is essential and should probably not be under \"optimization\"","created_at":"2026-01-15T12:25:15Z","updated_at":"2026-01-15T12:33:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694183221","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694183221"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694183221"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694183221/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":45,"side":"RIGHT","author_association":"MEMBER","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694186563","pull_request_review_id":3665352968,"id":2694186563,"node_id":"PRRC_kwDOPaLyBs6glgZD","diff_hunk":"@@ -0,0 +1,852 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider. Generated media stored via FileStorage, URLs returned.","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"Qilin101","id":255116568,"node_id":"U_kgDODzTFGA","avatar_url":"https://avatars.githubusercontent.com/u/255116568?v=4","gravatar_id":"","url":"https://api.github.com/users/Qilin101","html_url":"https://github.com/Qilin101","followers_url":"https://api.github.com/users/Qilin101/followers","following_url":"https://api.github.com/users/Qilin101/following{/other_user}","gists_url":"https://api.github.com/users/Qilin101/gists{/gist_id}","starred_url":"https://api.github.com/users/Qilin101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qilin101/subscriptions","organizations_url":"https://api.github.com/users/Qilin101/orgs","repos_url":"https://api.github.com/users/Qilin101/repos","events_url":"https://api.github.com/users/Qilin101/events{/privacy}","received_events_url":"https://api.github.com/users/Qilin101/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"almost all providers support data urls (data:image/png;base64,...) maybe we should consider this too","created_at":"2026-01-15T12:26:17Z","updated_at":"2026-01-15T12:33:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694186563","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694186563"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694186563"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694186563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":36,"side":"RIGHT","author_association":"MEMBER","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694204270","pull_request_review_id":3665352968,"id":2694204270,"node_id":"PRRC_kwDOPaLyBs6glktu","diff_hunk":"@@ -0,0 +1,852 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider. Generated media stored via FileStorage, URLs returned.\n+\n+**Tools**: Consumer defines tools via GTS Schema ID. Gateway resolves schema before sending to provider.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"Qilin101","id":255116568,"node_id":"U_kgDODzTFGA","avatar_url":"https://avatars.githubusercontent.com/u/255116568?v=4","gravatar_id":"","url":"https://api.github.com/users/Qilin101","html_url":"https://github.com/Qilin101","followers_url":"https://api.github.com/users/Qilin101/followers","following_url":"https://api.github.com/users/Qilin101/following{/other_user}","gists_url":"https://api.github.com/users/Qilin101/gists{/gist_id}","starred_url":"https://api.github.com/users/Qilin101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qilin101/subscriptions","organizations_url":"https://api.github.com/users/Qilin101/orgs","repos_url":"https://api.github.com/users/Qilin101/repos","events_url":"https://api.github.com/users/Qilin101/events{/privacy}","received_events_url":"https://api.github.com/users/Qilin101/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"are we trying to make unified interface for all providers or not?  \r\ndoes user of this module need to know which provider they are calling?\r\n\r\ne.g. when calling llm with tools in streaming model different providers will return tools in different format, different order, with or without text content, many tools at once or in sequence, with full usage as last message or with usage diffs in every chunk, etc.  \r\nwhen i call an llm with tools using this module is it my responsibility to known that i called, let's say anthropic, and expect anthopic tool/usage format?","created_at":"2026-01-15T12:32:09Z","updated_at":"2026-01-15T12:33:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694204270","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694204270"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694204270"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694204270/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":57,"side":"RIGHT","author_association":"MEMBER","original_position":57,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694502759","pull_request_review_id":3665778093,"id":2694502759,"node_id":"PRRC_kwDOPaLyBs6gmtln","diff_hunk":"@@ -0,0 +1,852 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider. Generated media stored via FileStorage, URLs returned.\n+\n+**Tools**: Consumer defines tools via GTS Schema ID. Gateway resolves schema before sending to provider.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'd suggest to add Outbound API gateway. Why, because:\n- we want to maintain global routes there \n- implement per-tenant limits & throttling\n- implement retry, circuit breaker and other common transport logic\n- limit the amount of services getting access to outbound API endpoints secrets/credentials\n- route all outbound traffic through single component to reduce the SSRF attack surface\n- have common place to audit and log all the traffic\n\nThere is a prototype of such OAGW module:\nhttps://github.com/hypernetix/hyperspot/pull/220\n\nThe idea is that llm_gateway then doesn't work with Cred Store directly, but only with outbound gateway","created_at":"2026-01-15T13:58:51Z","updated_at":"2026-01-16T13:32:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694502759","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694502759"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694502759"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694502759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":49,"side":"RIGHT","author_association":"MEMBER","original_position":49,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694751101","pull_request_review_id":3666072801,"id":2694751101,"node_id":"PRRC_kwDOPaLyBs6gnqN9","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Model instances should be created in the tenant context.\r\nThis component should provide an api for model creation.","created_at":"2026-01-15T15:04:12Z","updated_at":"2026-01-15T15:04:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694751101","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694751101"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694751101"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694751101/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","in_reply_to_id":2694180052,"author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840699","pull_request_review_id":3666181141,"id":2694840699,"node_id":"PRRC_kwDOPaLyBs6goAF7","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |\n+| [ ] | Pre-call interceptor |\n+| [ ] | Post-response interceptor |\n+| [ ] | Per-tenant budget enforcement |\n+| [ ] | Request cancellation |\n+| [ ] | Rate limiting (tenant/user) |\n+\n+### P3 — Optimization\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Cost-aware routing |\n+| [ ] | Embeddings batching |\n+| [ ] | Usage tracking |","path":"modules/llm_gateway/README.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Agreed, thanks!","created_at":"2026-01-15T15:26:49Z","updated_at":"2026-01-15T15:26:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694840699","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840699"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694840699"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":45,"side":"RIGHT","in_reply_to_id":2694183221,"author_association":"MEMBER","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840997","pull_request_review_id":3666181485,"id":2694840997,"node_id":"PRRC_kwDOPaLyBs6goAKl","diff_hunk":"@@ -0,0 +1,852 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider. Generated media stored via FileStorage, URLs returned.","path":"modules/llm_gateway/docs/SCENARIOS.md","commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"added","created_at":"2026-01-15T15:26:53Z","updated_at":"2026-01-15T15:26:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694840997","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840997"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694840997"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694840997/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":36,"side":"RIGHT","in_reply_to_id":2694186563,"author_association":"MEMBER","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694848564","pull_request_review_id":3666190834,"id":2694848564,"node_id":"PRRC_kwDOPaLyBs6goCA0","diff_hunk":"@@ -0,0 +1,852 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media**: Consumer uploads to FileStorage, provides URLs. Gateway fetches content before sending to provider. Generated media stored via FileStorage, URLs returned.\n+\n+**Tools**: Consumer defines tools via GTS Schema ID. Gateway resolves schema before sending to provider.\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"1684f3907b2143d2484158961d8b0c4bc948e40c","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"llm-gateway should normalize everything to our contract. I added this section to the document.","created_at":"2026-01-15T15:28:33Z","updated_at":"2026-01-15T15:28:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694848564","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694848564"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694848564"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694848564/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":2694204270,"author_association":"MEMBER","original_position":57,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859378","pull_request_review_id":3666204708,"id":2694859378,"node_id":"PRRC_kwDOPaLyBs6goEpy","diff_hunk":"@@ -0,0 +1,1042 @@\n+# LLM Gateway Scenarios\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", schema_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, schema_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media input**:\n+- FileStorage URL — Gateway fetches content before sending to provider\n+- Data URL (`data:<mime>;base64,...`) — Gateway passes directly to provider\n+\n+**Media output**: Gateway stores via FileStorage, returns URL.\n+\n+**Tools**: Consumer defines tools via GTS Schema ID. Gateway resolves schema before sending to provider.\n+\n+---\n+\n+## Response Format\n+\n+Gateway fully normalizes `chat_completion` responses to a unified format. Other endpoints (`embed`, `list_models`, `get_job`) have endpoint-specific response structures.\n+\n+```plaintext\n+response: {\n+  content: [...],           // normalized content blocks\n+  usage: {                  // normalized usage\n+    prompt_tokens: 100,\n+    completion_tokens: 50,\n+    total_tokens: 150\n+  },\n+  metadata: {               // normalized metadata\n+    model: \"gpt-4\",\n+    provider: \"openai\",\n+    latency_ms: 234,\n+    request_id: \"req_abc123\"\n+  },\n+  extensions: {             // provider-specific data (optional)\n+    \"openai\": { ... },\n+    \"anthropic\": { ... }\n+  }\n+}\n+```\n+\n+### Normalization Guarantees\n+\n+| Field | Guarantee |\n+|-------|-----------|\n+| `content` | Always present, unified block format |\n+| `usage` | Always present, consistent field names |\n+| `metadata.model` | Always present, model ID used |\n+| `metadata.provider` | Always present, identifies source |\n+| `metadata.latency_ms` | Always present, request duration |\n+| `metadata.request_id` | Always present, for tracing |\n+| `metadata.fallback_used` | Optional, true if fallback was triggered |\n+| `metadata.original_model` | Optional, requested model before fallback |\n+| `extensions` | Optional, provider-keyed |\n+\n+### Extensions\n+\n+Provider-specific data that doesn't fit the normalized schema goes into `extensions`. Consumers should not depend on extensions for core functionality.\n+\n+**Response extensions** (examples):\n+```plaintext\n+extensions: {\n+  \"anthropic\": {\n+    stop_reason: \"end_turn\",\n+    cache_creation_input_tokens: 1000,\n+    cache_read_input_tokens: 500\n+  },\n+  \"openai\": {\n+    system_fingerprint: \"fp_abc123\",\n+    logprobs: [...]\n+  }\n+}\n+```\n+\n+**Request extensions** (provider hints):\n+```plaintext\n+provider_hints: {\n+  \"anthropic\": {\n+    cache_control: { type: \"ephemeral\" }\n+  },\n+  \"openai\": {\n+    logprobs: true,\n+    top_logprobs: 5\n+  }\n+}\n+```\n+\n+**Principles**:\n+- Extensions are optional — consumers can ignore them\n+- Extensions are type-safe — keyed by provider name\n+- Extensions don't affect Gateway logic — pass-through only\n+- Model Discovery (S1.12) advertises available extensions per model\n+\n+---\n+\n+## Streaming Format\n+\n+Gateway normalizes streaming events to a unified SSE format.\n+\n+**Event types**:\n+| Event | Description |\n+|-------|-------------|\n+| `delta` | Content chunk (text, tool_call) |\n+| `usage` | Final usage metrics (last event before done) |\n+| `done` | Stream completion |\n+| `error` | Error occurred |\n+\n+**Delta event**:\n+```plaintext\n+event: delta\n+data: {\n+  type: \"text_delta\" | \"tool_call_delta\",\n+  index: 0,           // content block index\n+  text?: \"...\",       // for text_delta\n+  tool_call?: {...}   // for tool_call_delta\n+}\n+```\n+\n+**Usage event** (always emitted before done):\n+```plaintext\n+event: usage\n+data: {\n+  prompt_tokens: 100,\n+  completion_tokens: 50,\n+  total_tokens: 150\n+}\n+```\n+\n+**Done event**:\n+```plaintext\n+event: done\n+data: {\n+  finish_reason: \"stop\" | \"tool_calls\" | \"length\" | \"content_filter\",\n+  metadata: { model: \"gpt-4\", provider: \"openai\", latency_ms: 234, request_id: \"...\" },\n+  extensions: { ... }\n+}\n+```\n+\n+**Normalization**:\n+- All providers mapped to same event types\n+- `tool_calls` always streamed after text (consistent ordering)\n+- `usage` always in final chunk (not deltas)\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |\n+| Hook System | `llm.pre_call`, `llm.post_response` interceptors |\n+| Audit | Request/response logging |\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job mappings are stored temporarily until job completion/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway normalizes provider events to unified format (see Streaming Format section).\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Content chunks\n+        P-->>GW: provider delta\n+        GW-->>C: SSE: delta (normalized)\n+    end\n+    P-->>GW: completion\n+    GW-->>C: SSE: usage\n+    GW-->>C: SSE: done\n+```\n+\n+**Edge cases**:\n+- Client disconnect → persist partial response\n+- Provider timeout → emit error event, close stream\n+","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"9a18759ffdf8f5214c073effe09f4d428bc8753b","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify client disconnect handling in streaming.**\n\nLine 278 states \"Client disconnect → persist partial response,\" but past discussions indicate that persisting responses should be the Chat Engine's responsibility to maintain the Gateway's stateless design. This edge case description seems inconsistent with the design principle (line 190) that \"Gateway does not store conversation history.\"\n\nConsider either removing this edge case or clarifying that persistence happens outside the Gateway's scope.\n\nBased on learnings and past review comments.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/llm_gateway/docs/SCENARIOS.md` around lines 234 - 280, The S1.2\n\"Client disconnect → persist partial response\" edge case contradicts the\nGateway's stateless design; update the scenario to remove or reword it so\npersistence is explicitly delegated to the Chat Engine or another downstream\ncomponent. Specifically, in the S1.2 Streaming Chat Completion section (and any\nother streaming edge case lists), replace or clarify the client-disconnect\nbullet to state that the Gateway will stop streaming and emit an appropriate SSE\nerror/close event, and that any persistence of partial responses must be handled\nby the Chat Engine (or a named downstream service) rather than the Gateway.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit aa038d9","created_at":"2026-01-15T15:31:02Z","updated_at":"2026-01-15T15:38:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694859378","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859378"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694859378"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":234,"start_side":"RIGHT","line":null,"original_line":280,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":280,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859382","pull_request_review_id":3666204708,"id":2694859382,"node_id":"PRRC_kwDOPaLyBs6goEp2","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+| [ ] | Usage tracking |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |\n+| [ ] | Pre-call interceptor |\n+| [ ] | Post-response interceptor |\n+| [ ] | Per-tenant budget enforcement |\n+| [ ] | Request cancellation |\n+| [ ] | Rate limiting (tenant/user) |\n+\n+### P3 — Optimization\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Cost-aware routing |\n+| [ ] | Embeddings batching |\n+\n+### P4 — Enterprise\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Audit events |\n+\n+## Module Structure\n+\n+```\n+modules/llm_gateway/\n+├── llm_gateway-sdk/         # Public API traits, models, errors\n+├── llm_gateway-gw/          # Gateway implementation\n+└── plugins/\n+    ├── openai_plugin/       # OpenAI-compatible providers\n+    ├── anthropic_plugin/    # Claude API\n+    └── ollama_plugin/       # Local models via Ollama\n+```\n+\n+## Documentation\n+\n+- [SCENARIOS.md](docs/SCENARIOS.md) — Usage scenarios with sequence diagrams\n+- [ARCHITECTURE.md](docs/ARCHITECTURE.md) — Gateway + Plugin design, component interactions\n+- [API.md](docs/API.md) — SDK traits, request/response models, errors\n+- [PROVIDERS.md](docs/PROVIDERS.md) — Provider abstraction, capability matrix\n+- [CONFIGURATION.md](docs/CONFIGURATION.md) — Gateway and plugin configuration","path":"modules/llm_gateway/README.md","commit_id":"aa038d978f23408610e53e037d80674d2c7a52ba","original_commit_id":"9a18759ffdf8f5214c073effe09f4d428bc8753b","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Document links reference non-existent files.**\n\nFour of the five documentation links (ARCHITECTURE.md, API.md, PROVIDERS.md, CONFIGURATION.md) reference files not included in this PR and likely don't exist yet. Consider either adding TODO markers or removing these links until the files are created to avoid broken references.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/llm_gateway/README.md` around lines 67 - 71, The README currently\nlinks to ARCHITECTURE.md, API.md, PROVIDERS.md, and CONFIGURATION.md which are\nnot present in this PR; update modules/llm_gateway/README.md to either remove\nthese broken links or replace them with TODO placeholders (e.g.,\n\"ARCHITECTURE.md — TODO: add architecture doc\") for each missing file so the\nREADME does not contain dead references; ensure the remaining valid link\nSCENARIOS.md stays unchanged.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits e8b1742 to 329c72d","created_at":"2026-01-15T15:31:02Z","updated_at":"2026-01-16T10:33:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694859382","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859382"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2694859382"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694859382/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":67,"start_side":"RIGHT","line":null,"original_line":71,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":71,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538687","pull_request_review_id":3670893819,"id":2698538687,"node_id":"PRRC_kwDOPaLyBs6g2G6_","diff_hunk":"@@ -0,0 +1,1098 @@\n+# LLM Gateway PRD\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", tool_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, tool_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media input**:\n+- FileStorage URL — Gateway fetches content before sending to provider\n+- Data URL (`data:<mime>;base64,...`) — Gateway passes directly to provider\n+\n+**Media output**: Gateway stores via FileStorage, returns URL.","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for FileStorage error handling patterns in the PRD\nrg -n -C3 -i 'filestorage.*(error|fail|unavailable|invalid|missing|404|503)' modules/llm_gateway/docs/PRD.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Also search for general FileStorage mentions to understand coverage\nrg -n 'FileStorage' modules/llm_gateway/docs/PRD.md | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1365\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for scenarios S1.4, S1.6, S1.8, S1.13 and check their content for error handling\nrg -n 'S1\\.[4681]|S1\\.13' modules/llm_gateway/docs/PRD.md\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 824\n\n---\n\n\n\n</details>\n\n**Add FileStorage error handling specifications to the PRD.**\n\nLines 36–40 describe media input/output via FileStorage, but the PRD contains no documented error handling for FileStorage failures. FileStorage is referenced across scenarios S1.4, S1.6, S1.8, and S1.13 without specifying what happens when:\n- FileStorage service is unavailable (503)\n- URL is invalid or file not found (404)\n- File size exceeds limits\n- Network fetch fails\n\nAdd error handling specifications covering:\n- Expected HTTP status codes for each failure mode\n- Response structure when FileStorage operations fail\n- Retry behavior, if any\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/llm_gateway/docs/PRD.md` around lines 36 - 40, Update the PRD section\ndescribing Media input/output (around the FileStorage descriptions) to add\nexplicit FileStorage error handling: for service unavailable return 503 with a\nstandard error JSON {error, code:\"filestorage_unavailable\", message}, for not\nfound return 404 with {error, code:\"file_not_found\", message}, for file too\nlarge return 413 with {error, code:\"file_too_large\", message, maxAllowedBytes},\nand for network/fetch failures return 502 with {error,\ncode:\"filestorage_bad_gateway\", message, upstreamError}; document that Gateway\nwill not retry client-supplied FileStorage URLs automatically except for\ntransient 503/502 with an exponential backoff capped at 2 retries (log each\nattempt) and that scenarios S1.4, S1.6, S1.8, and S1.13 should reference this\nbehavior and response schema so callers can handle errors uniformly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-16T13:35:50Z","updated_at":"2026-01-16T13:35:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538687","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538687"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538687"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":36,"start_side":"RIGHT","line":null,"original_line":40,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":40,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538695","pull_request_review_id":3670893819,"id":2698538695,"node_id":"PRRC_kwDOPaLyBs6g2G7H","diff_hunk":"@@ -0,0 +1,1098 @@\n+# LLM Gateway PRD\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", tool_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, tool_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media input**:\n+- FileStorage URL — Gateway fetches content before sending to provider\n+- Data URL (`data:<mime>;base64,...`) — Gateway passes directly to provider\n+\n+**Media output**: Gateway stores via FileStorage, returns URL.\n+\n+---\n+\n+## Tools Format\n+\n+Consumer defines tools via reference or inline GTS schema:\n+\n+```plaintext\n+tools: [\n+  // Option 1: Reference to Type Registry\n+  { schema_id: \"gts.hx.core.faas.func.v1~acme.crm.contacts.search.v1\" },\n+\n+  // Option 2: Inline GTS schema\n+  {\n+    $id: \"dynamic_search\",\n+    title: \"Dynamic Search\",\n+    description: \"Search with dynamic parameters\",\n+    params: {\n+      type: \"object\",\n+      properties: {\n+        query: { type: \"string\" }\n+      },\n+      required: [\"query\"]\n+    },\n+    returns: {\n+      type: \"array\",\n+      items: { type: \"object\" }\n+    }\n+  }\n+]\n+```\n+\n+| Format | When to use |\n+|--------|-------------|\n+| `schema_id` | Registered tools, governance required |\n+| Inline schema | Ad-hoc tools, dynamic generation, testing |\n+\n+**Gateway behavior**:\n+- `schema_id` → resolve from Type Registry, convert to provider format\n+- Inline schema → use directly, convert to provider format\n+\n+**Response `tool_call.tool_id`**: Returns `schema_id` or inline `$id` (whichever was used in request).\n+\n+---\n+\n+## Response Format\n+\n+Gateway fully normalizes `chat_completion` responses to a unified format. Other endpoints (`embed`, `list_models`, `get_job`) have endpoint-specific response structures.\n+\n+```plaintext\n+response: {\n+  content: [...],           // normalized content blocks\n+  usage: {                  // normalized usage\n+    prompt_tokens: 100,\n+    completion_tokens: 50,\n+    total_tokens: 150\n+  },\n+  metadata: {               // normalized metadata\n+    model: \"gpt-4\",\n+    provider: \"openai\",\n+    latency_ms: 234,\n+    request_id: \"req_abc123\"\n+  },\n+  extensions: {             // provider-specific data (optional)\n+    \"openai\": { ... },\n+    \"anthropic\": { ... }\n+  }\n+}\n+```\n+\n+### Normalization Guarantees\n+\n+| Field | Guarantee |\n+|-------|-----------|\n+| `content` | Always present, unified block format |\n+| `usage` | Always present, consistent field names |\n+| `metadata.model` | Always present, model ID used |\n+| `metadata.provider` | Always present, identifies source |\n+| `metadata.latency_ms` | Always present, request duration |\n+| `metadata.request_id` | Always present, for tracing |\n+| `metadata.fallback_used` | Optional, true if fallback was triggered |\n+| `metadata.original_model` | Optional, requested model before fallback |\n+| `extensions` | Optional, provider-keyed |\n+\n+### Extensions\n+\n+Provider-specific data that doesn't fit the normalized schema goes into `extensions`. Consumers should not depend on extensions for core functionality.\n+\n+**Response extensions** (examples):\n+```plaintext\n+extensions: {\n+  \"anthropic\": {\n+    stop_reason: \"end_turn\",\n+    cache_creation_input_tokens: 1000,\n+    cache_read_input_tokens: 500\n+  },\n+  \"openai\": {\n+    system_fingerprint: \"fp_abc123\",\n+    logprobs: [...]\n+  }\n+}\n+```\n+\n+**Request extensions** (provider hints):\n+```plaintext\n+provider_hints: {\n+  \"anthropic\": {\n+    cache_control: { type: \"ephemeral\" }\n+  },\n+  \"openai\": {\n+    logprobs: true,\n+    top_logprobs: 5\n+  }\n+}\n+```\n+\n+**Principles**:\n+- Extensions are optional — consumers can ignore them\n+- Extensions are type-safe — keyed by provider name\n+- Extensions don't affect Gateway logic — pass-through only\n+- Model Discovery (S1.12) advertises available extensions per model\n+\n+---\n+\n+## Streaming Format\n+\n+Gateway normalizes streaming events to a unified SSE format.\n+\n+**Event types**:\n+\n+| Event | Description |\n+|-------|-------------|\n+| `delta` | Content chunk (text, tool_call) |\n+| `usage` | Final usage metrics (last event before done) |\n+| `done` | Stream completion |\n+| `error` | Error occurred |\n+\n+**Delta event**:\n+```plaintext\n+event: delta\n+data: {\n+  type: \"text_delta\" | \"tool_call_delta\",\n+  index: 0,           // content block index\n+  text?: \"...\",       // for text_delta\n+  tool_call?: {...}   // for tool_call_delta\n+}\n+```\n+\n+**Usage event** (always emitted before done):\n+```plaintext\n+event: usage\n+data: {\n+  prompt_tokens: 100,\n+  completion_tokens: 50,\n+  total_tokens: 150\n+}\n+```\n+\n+**Done event**:\n+```plaintext\n+event: done\n+data: {\n+  finish_reason: \"stop\" | \"tool_calls\" | \"length\" | \"content_filter\",\n+  metadata: { model: \"gpt-4\", provider: \"openai\", latency_ms: 234, request_id: \"...\" },\n+  extensions: { ... }\n+}\n+```\n+\n+**Normalization**:\n+- All providers mapped to same event types\n+- `tool_calls` always streamed after text (consistent ordering)\n+- `usage` always in final chunk (not deltas)\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |\n+| Hook System | `llm.pre_call`, `llm.post_response` interceptors |\n+| Audit | Request/response logging |\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job state (ID mappings and cached results for sync providers) is stored temporarily until retrieval/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway normalizes provider events to unified format (see Streaming Format section).\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Content chunks\n+        P-->>GW: provider delta\n+        GW-->>C: SSE: delta (normalized)\n+    end\n+    P-->>GW: completion\n+    GW-->>C: SSE: usage\n+    GW-->>C: SSE: done\n+```\n+\n+**Edge cases**:\n+- Client disconnect → close provider connection, no persistence (consumer responsibility)\n+- Provider timeout → emit error event, close stream\n+\n+---\n+\n+### [ ] S1.3 Embeddings Generation\n+\n+Consumer sends text(s), Gateway returns vector embeddings. Supports single text or batch input.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: embed(model, input[])\n+    GW->>P: Provider embeddings API\n+    P-->>GW: vectors[] + usage\n+    GW-->>C: vectors[] + usage\n+```\n+\n+---\n+\n+### [ ] S1.4 Vision (Image Analysis)\n+\n+Consumer uploads images to FileStorage, then sends message with image URLs. Gateway routes to vision-capable model.\n+\n+**Request example**:\n+```plaintext\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"What's in these images?\" },\n+    { type: \"image\", url: \"https://storage.example.com/img1.jpg\" },\n+    { type: \"image\", url: \"https://storage.example.com/img2.jpg\" }\n+  ]\n+}]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload images\n+    FS-->>C: URLs\n+    C->>GW: chat_completion(model, messages with URLs)\n+    GW->>GW: Validate model supports vision\n+    GW->>FS: Fetch images by URLs\n+    FS-->>GW: image content[]\n+    GW->>P: Request with image content\n+    P-->>GW: Text response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+**Multiple images**: supported in single message\n+\n+---\n+\n+### [ ] S1.5 Image Generation\n+\n+Consumer sends text prompt to image generation model. Gateway generates image, stores via FileStorage, returns URL.\n+\n+**Request example**:\n+```plaintext\n+model: \"dall-e-3\"\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"A sunset over mountains, oil painting style\" }\n+  ]\n+}]\n+params: { size: \"1024x1024\", quality: \"hd\" }\n+```\n+\n+**Response example**:\n+```plaintext\n+content: [\n+  { type: \"image\", url: \"https://storage.example.com/generated/abc123.png\" }\n+]\n+usage: { ... }\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+    participant FS as FileStorage\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Validate model supports image generation\n+    GW->>P: Generation request\n+    P-->>GW: Image (base64 or provider URL)\n+    GW->>FS: Store image\n+    FS-->>GW: stored_url\n+    GW-->>C: Response with image URL + usage\n+```\n+\n+**Parameters**: size, quality, style, count (via request params)\n+\n+---\n+\n+### [ ] S1.6 Speech-to-Text (Transcription)\n+\n+Consumer uploads audio to FileStorage, then sends message with audio URL. Gateway returns transcribed text.\n+\n+**Request example**:\n+```plaintext\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"Transcribe this audio\" },\n+    { type: \"audio\", url: \"https://storage.example.com/recording.mp3\" }\n+  ]\n+}]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload audio\n+    FS-->>C: URL\n+    C->>GW: chat_completion(model, messages with URL)\n+    GW->>GW: Validate model supports speech-to-text\n+    GW->>FS: Fetch audio by URL\n+    FS-->>GW: audio content\n+    GW->>P: Audio content\n+    P-->>GW: Transcription + usage\n+    GW-->>C: Text response + usage\n+```\n+\n+**Parameters**: language hint, timestamps, word-level timing (via request params)\n+\n+---\n+\n+### [ ] S1.7 Text-to-Speech (Synthesis)\n+\n+Consumer sends text to TTS model. Gateway synthesizes audio, stores via FileStorage, returns URL.\n+\n+**Request example**:\n+```plaintext\n+model: \"tts-1-hd\"\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"Hello, welcome to our platform.\" }\n+  ]\n+}]\n+params: { voice: \"alloy\", speed: 1.0 }\n+```\n+\n+**Response example**:\n+```plaintext\n+content: [\n+  { type: \"audio\", url: \"https://storage.example.com/generated/xyz789.mp3\" }\n+]\n+usage: { ... }\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+    participant FS as FileStorage\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Validate model supports text-to-speech\n+    GW->>P: Text payload\n+    P-->>GW: Audio (base64 or provider URL)\n+    GW->>FS: Store audio\n+    FS-->>GW: stored_url\n+    GW-->>C: Response with audio URL + usage\n+```\n+\n+**Parameters**: voice, speed, pitch (via request params)\n+\n+**Streaming**: for real-time synthesis, stream audio chunks directly (no storage)","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify streaming TTS transport protocol.**\n\nLine 503 mentions \"stream audio chunks directly (no storage)\" for real-time synthesis, but the delivery mechanism is unspecified. This was flagged in past reviews.\n\nSpecify:\n- Transport protocol: SSE (like S1.2 chat streaming) or WebSocket (like S1.15 realtime audio)?\n- Event/message format for audio chunks (binary, base64-encoded?)\n- Final message structure (metadata fields: duration, sample_rate, format)\n- Whether a storage URL is optionally provided or explicitly null\n\nExample clarification:\n> **Streaming**: Uses SSE (like S1.2). Each `data:` event contains base64-encoded audio chunk. Final `done` event includes metadata (`duration`, `sample_rate`, `format`, `stored_url: null`).\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/llm_gateway/docs/PRD.md` at line 503, Update the \"Streaming\" sentence\nto explicitly specify the transport and payload format: state whether streaming\nuses SSE (S1.2-style) or WebSocket (S1.15-style), define that each audio chunk\nevent contains base64-encoded audio frames (or binary if using WebSocket), and\ndescribe the final \"done\" event/message structure including metadata fields\n(duration, sample_rate, format) and a stored_url field that is either a URL or\nnull; reference the existing \"Streaming\" line/section so the PRD entry replaces\n\"stream audio chunks directly (no storage)\" with this concrete protocol, chunk\nencoding, final metadata, and stored_url behavior.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-16T13:35:50Z","updated_at":"2026-01-16T13:35:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538695","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538695"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538695"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":503,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":503,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538699","pull_request_review_id":3670893819,"id":2698538699,"node_id":"PRRC_kwDOPaLyBs6g2G7L","diff_hunk":"@@ -0,0 +1,1098 @@\n+# LLM Gateway PRD\n+\n+## Notation\n+\n+- `[ ]` — not implemented\n+- `[x]` — implemented\n+\n+---\n+\n+## Content Format\n+\n+Message content is an array of typed blocks:\n+\n+```plaintext\n+content: [\n+  { type: \"text\", text: \"...\" },\n+  { type: \"image\", url: \"...\" },\n+  { type: \"audio\", url: \"...\" },\n+  { type: \"video\", url: \"...\" },\n+  { type: \"document\", url: \"...\" },\n+  { type: \"tool_call\", id: \"...\", tool_id: \"...\", arguments: {...} },\n+  { type: \"tool_result\", tool_call_id: \"...\", result: {...} }\n+]\n+```\n+\n+| Type | Fields | Direction |\n+|------|--------|-----------|\n+| text | text | input/output |\n+| image | url | input/output |\n+| audio | url | input/output |\n+| video | url | input/output |\n+| document | url | input/output |\n+| tool_call | id, tool_id, arguments | output |\n+| tool_result | tool_call_id, result | input |\n+\n+**Media input**:\n+- FileStorage URL — Gateway fetches content before sending to provider\n+- Data URL (`data:<mime>;base64,...`) — Gateway passes directly to provider\n+\n+**Media output**: Gateway stores via FileStorage, returns URL.\n+\n+---\n+\n+## Tools Format\n+\n+Consumer defines tools via reference or inline GTS schema:\n+\n+```plaintext\n+tools: [\n+  // Option 1: Reference to Type Registry\n+  { schema_id: \"gts.hx.core.faas.func.v1~acme.crm.contacts.search.v1\" },\n+\n+  // Option 2: Inline GTS schema\n+  {\n+    $id: \"dynamic_search\",\n+    title: \"Dynamic Search\",\n+    description: \"Search with dynamic parameters\",\n+    params: {\n+      type: \"object\",\n+      properties: {\n+        query: { type: \"string\" }\n+      },\n+      required: [\"query\"]\n+    },\n+    returns: {\n+      type: \"array\",\n+      items: { type: \"object\" }\n+    }\n+  }\n+]\n+```\n+\n+| Format | When to use |\n+|--------|-------------|\n+| `schema_id` | Registered tools, governance required |\n+| Inline schema | Ad-hoc tools, dynamic generation, testing |\n+\n+**Gateway behavior**:\n+- `schema_id` → resolve from Type Registry, convert to provider format\n+- Inline schema → use directly, convert to provider format\n+\n+**Response `tool_call.tool_id`**: Returns `schema_id` or inline `$id` (whichever was used in request).\n+\n+---\n+\n+## Response Format\n+\n+Gateway fully normalizes `chat_completion` responses to a unified format. Other endpoints (`embed`, `list_models`, `get_job`) have endpoint-specific response structures.\n+\n+```plaintext\n+response: {\n+  content: [...],           // normalized content blocks\n+  usage: {                  // normalized usage\n+    prompt_tokens: 100,\n+    completion_tokens: 50,\n+    total_tokens: 150\n+  },\n+  metadata: {               // normalized metadata\n+    model: \"gpt-4\",\n+    provider: \"openai\",\n+    latency_ms: 234,\n+    request_id: \"req_abc123\"\n+  },\n+  extensions: {             // provider-specific data (optional)\n+    \"openai\": { ... },\n+    \"anthropic\": { ... }\n+  }\n+}\n+```\n+\n+### Normalization Guarantees\n+\n+| Field | Guarantee |\n+|-------|-----------|\n+| `content` | Always present, unified block format |\n+| `usage` | Always present, consistent field names |\n+| `metadata.model` | Always present, model ID used |\n+| `metadata.provider` | Always present, identifies source |\n+| `metadata.latency_ms` | Always present, request duration |\n+| `metadata.request_id` | Always present, for tracing |\n+| `metadata.fallback_used` | Optional, true if fallback was triggered |\n+| `metadata.original_model` | Optional, requested model before fallback |\n+| `extensions` | Optional, provider-keyed |\n+\n+### Extensions\n+\n+Provider-specific data that doesn't fit the normalized schema goes into `extensions`. Consumers should not depend on extensions for core functionality.\n+\n+**Response extensions** (examples):\n+```plaintext\n+extensions: {\n+  \"anthropic\": {\n+    stop_reason: \"end_turn\",\n+    cache_creation_input_tokens: 1000,\n+    cache_read_input_tokens: 500\n+  },\n+  \"openai\": {\n+    system_fingerprint: \"fp_abc123\",\n+    logprobs: [...]\n+  }\n+}\n+```\n+\n+**Request extensions** (provider hints):\n+```plaintext\n+provider_hints: {\n+  \"anthropic\": {\n+    cache_control: { type: \"ephemeral\" }\n+  },\n+  \"openai\": {\n+    logprobs: true,\n+    top_logprobs: 5\n+  }\n+}\n+```\n+\n+**Principles**:\n+- Extensions are optional — consumers can ignore them\n+- Extensions are type-safe — keyed by provider name\n+- Extensions don't affect Gateway logic — pass-through only\n+- Model Discovery (S1.12) advertises available extensions per model\n+\n+---\n+\n+## Streaming Format\n+\n+Gateway normalizes streaming events to a unified SSE format.\n+\n+**Event types**:\n+\n+| Event | Description |\n+|-------|-------------|\n+| `delta` | Content chunk (text, tool_call) |\n+| `usage` | Final usage metrics (last event before done) |\n+| `done` | Stream completion |\n+| `error` | Error occurred |\n+\n+**Delta event**:\n+```plaintext\n+event: delta\n+data: {\n+  type: \"text_delta\" | \"tool_call_delta\",\n+  index: 0,           // content block index\n+  text?: \"...\",       // for text_delta\n+  tool_call?: {...}   // for tool_call_delta\n+}\n+```\n+\n+**Usage event** (always emitted before done):\n+```plaintext\n+event: usage\n+data: {\n+  prompt_tokens: 100,\n+  completion_tokens: 50,\n+  total_tokens: 150\n+}\n+```\n+\n+**Done event**:\n+```plaintext\n+event: done\n+data: {\n+  finish_reason: \"stop\" | \"tool_calls\" | \"length\" | \"content_filter\",\n+  metadata: { model: \"gpt-4\", provider: \"openai\", latency_ms: 234, request_id: \"...\" },\n+  extensions: { ... }\n+}\n+```\n+\n+**Normalization**:\n+- All providers mapped to same event types\n+- `tool_calls` always streamed after text (consistent ordering)\n+- `usage` always in final chunk (not deltas)\n+\n+---\n+\n+## Dependencies\n+\n+| Dependency | Role |\n+|------------|------|\n+| FileStorage | Fetch input media by URL, store generated content |\n+| Credential Resolver | API keys for providers |\n+| Type Registry | Read GTS schemas by ID (tool definitions) |\n+| Usage Tracker | Token/cost reporting |\n+| Hook System | `llm.pre_call`, `llm.post_response` interceptors |\n+| Audit | Request/response logging |\n+\n+---\n+\n+## Design Principles\n+\n+**Stateless**: Gateway does not store conversation history. Consumer provides full message history with each request. Conversation state is managed by a separate component (Chat Engine). Exception: async job state (ID mappings and cached results for sync providers) is stored temporarily until retrieval/expiry.\n+\n+**Pass-through**: Gateway normalizes requests/responses but does not interpret content. Tool execution, response parsing — consumer responsibility.\n+\n+---\n+\n+## Errors\n+\n+All errors follow RFC 9457 Problem Details format with GTS error codes.\n+\n+**Code pattern**: `gts.hx.core.errors.err.v1~hx.llm_gateway.<error>.v1`\n+\n+| Code | Status | Description |\n+|------|--------|-------------|\n+| `model_not_found` | 404 | Requested model not available |\n+| `job_not_found` | 404 | Async job ID not found |\n+| `job_expired` | 410 | Async job expired (TTL) |\n+| `validation_error` | 422 | Invalid request parameters |\n+| `capability_not_supported` | 422 | Model doesn't support requested capability |\n+| `schema_validation_failed` | 422 | Response doesn't match requested JSON schema |\n+| `budget_exceeded` | 429 | Tenant budget exhausted |\n+| `rate_limited` | 429 | Rate limit exceeded (tenant or user level) |\n+| `request_blocked` | 403 | Blocked by pre-call interceptor |\n+| `response_blocked` | 403 | Blocked by post-response interceptor |\n+| `provider_error` | 502 | Provider returned error |\n+| `provider_timeout` | 504 | Provider request timed out |\n+\n+**Response example**:\n+```json\n+{\n+  \"type\": \"https://errors.hyperspot.io/gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"title\": \"Rate Limited\",\n+  \"status\": 429,\n+  \"code\": \"gts.hx.core.errors.err.v1~hx.llm_gateway.rate_limited.v1\",\n+  \"detail\": \"User rate limit exceeded\",\n+  \"instance\": \"/api/llm-gateway/v1/chat/completions\",\n+  \"trace_id\": \"abc123\"\n+}\n+```\n+\n+---\n+\n+## P1 — Core\n+\n+### [ ] S1.1 Chat Completion\n+\n+Consumer sends chat completion request. Gateway resolves provider based on model, executes request, returns response with usage metrics.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant CR as Credential Resolver\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Resolve provider for model\n+    GW->>CR: Get API credentials\n+    CR-->>GW: Credentials\n+    GW->>P: Provider API call\n+    P-->>GW: Response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.2 Streaming Chat Completion\n+\n+Same as S1.1, but response is streamed via SSE. Gateway normalizes provider events to unified format (see Streaming Format section).\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(stream=true)\n+    GW->>P: Provider streaming call\n+    loop Content chunks\n+        P-->>GW: provider delta\n+        GW-->>C: SSE: delta (normalized)\n+    end\n+    P-->>GW: completion\n+    GW-->>C: SSE: usage\n+    GW-->>C: SSE: done\n+```\n+\n+**Edge cases**:\n+- Client disconnect → close provider connection, no persistence (consumer responsibility)\n+- Provider timeout → emit error event, close stream\n+\n+---\n+\n+### [ ] S1.3 Embeddings Generation\n+\n+Consumer sends text(s), Gateway returns vector embeddings. Supports single text or batch input.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: embed(model, input[])\n+    GW->>P: Provider embeddings API\n+    P-->>GW: vectors[] + usage\n+    GW-->>C: vectors[] + usage\n+```\n+\n+---\n+\n+### [ ] S1.4 Vision (Image Analysis)\n+\n+Consumer uploads images to FileStorage, then sends message with image URLs. Gateway routes to vision-capable model.\n+\n+**Request example**:\n+```plaintext\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"What's in these images?\" },\n+    { type: \"image\", url: \"https://storage.example.com/img1.jpg\" },\n+    { type: \"image\", url: \"https://storage.example.com/img2.jpg\" }\n+  ]\n+}]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload images\n+    FS-->>C: URLs\n+    C->>GW: chat_completion(model, messages with URLs)\n+    GW->>GW: Validate model supports vision\n+    GW->>FS: Fetch images by URLs\n+    FS-->>GW: image content[]\n+    GW->>P: Request with image content\n+    P-->>GW: Text response + usage\n+    GW-->>C: Response + usage\n+```\n+\n+**Multiple images**: supported in single message\n+\n+---\n+\n+### [ ] S1.5 Image Generation\n+\n+Consumer sends text prompt to image generation model. Gateway generates image, stores via FileStorage, returns URL.\n+\n+**Request example**:\n+```plaintext\n+model: \"dall-e-3\"\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"A sunset over mountains, oil painting style\" }\n+  ]\n+}]\n+params: { size: \"1024x1024\", quality: \"hd\" }\n+```\n+\n+**Response example**:\n+```plaintext\n+content: [\n+  { type: \"image\", url: \"https://storage.example.com/generated/abc123.png\" }\n+]\n+usage: { ... }\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+    participant FS as FileStorage\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Validate model supports image generation\n+    GW->>P: Generation request\n+    P-->>GW: Image (base64 or provider URL)\n+    GW->>FS: Store image\n+    FS-->>GW: stored_url\n+    GW-->>C: Response with image URL + usage\n+```\n+\n+**Parameters**: size, quality, style, count (via request params)\n+\n+---\n+\n+### [ ] S1.6 Speech-to-Text (Transcription)\n+\n+Consumer uploads audio to FileStorage, then sends message with audio URL. Gateway returns transcribed text.\n+\n+**Request example**:\n+```plaintext\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"Transcribe this audio\" },\n+    { type: \"audio\", url: \"https://storage.example.com/recording.mp3\" }\n+  ]\n+}]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload audio\n+    FS-->>C: URL\n+    C->>GW: chat_completion(model, messages with URL)\n+    GW->>GW: Validate model supports speech-to-text\n+    GW->>FS: Fetch audio by URL\n+    FS-->>GW: audio content\n+    GW->>P: Audio content\n+    P-->>GW: Transcription + usage\n+    GW-->>C: Text response + usage\n+```\n+\n+**Parameters**: language hint, timestamps, word-level timing (via request params)\n+\n+---\n+\n+### [ ] S1.7 Text-to-Speech (Synthesis)\n+\n+Consumer sends text to TTS model. Gateway synthesizes audio, stores via FileStorage, returns URL.\n+\n+**Request example**:\n+```plaintext\n+model: \"tts-1-hd\"\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"Hello, welcome to our platform.\" }\n+  ]\n+}]\n+params: { voice: \"alloy\", speed: 1.0 }\n+```\n+\n+**Response example**:\n+```plaintext\n+content: [\n+  { type: \"audio\", url: \"https://storage.example.com/generated/xyz789.mp3\" }\n+]\n+usage: { ... }\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+    participant FS as FileStorage\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Validate model supports text-to-speech\n+    GW->>P: Text payload\n+    P-->>GW: Audio (base64 or provider URL)\n+    GW->>FS: Store audio\n+    FS-->>GW: stored_url\n+    GW-->>C: Response with audio URL + usage\n+```\n+\n+**Parameters**: voice, speed, pitch (via request params)\n+\n+**Streaming**: for real-time synthesis, stream audio chunks directly (no storage)\n+\n+---\n+\n+### [ ] S1.8 Video Understanding\n+\n+Consumer uploads video to FileStorage, then sends message with video URL. Gateway returns analysis.\n+\n+**Request example**:\n+```plaintext\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"Describe what happens in this video\" },\n+    { type: \"video\", url: \"https://storage.example.com/clip.mp4\" }\n+  ]\n+}]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload video\n+    FS-->>C: URL\n+    C->>GW: chat_completion(model, messages with URL)\n+    GW->>GW: Validate model supports video\n+    GW->>FS: Fetch video by URL\n+    FS-->>GW: video content\n+    GW->>P: Request with video content\n+    P-->>GW: Analysis + usage\n+    GW-->>C: Text response + usage\n+```\n+\n+**Considerations**:\n+- Provider-specific duration/size limits\n+\n+---\n+\n+### [ ] S1.9 Video Generation\n+\n+Consumer sends text prompt to video generation model. Gateway generates video, stores via FileStorage, returns URL.\n+\n+**Request example**:\n+```plaintext\n+model: \"sora-1\"\n+messages: [{\n+  role: \"user\",\n+  content: [\n+    { type: \"text\", text: \"A cat playing piano in a jazz club\" }\n+  ]\n+}]\n+params: { duration: 10, resolution: \"1080p\" }\n+```\n+\n+**Response example**:\n+```plaintext\n+content: [\n+  { type: \"video\", url: \"https://storage.example.com/generated/vid456.mp4\" }\n+]\n+usage: { ... }\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+    participant FS as FileStorage\n+\n+    C->>GW: chat_completion(model, messages, params)\n+    GW->>GW: Validate model supports video generation\n+    GW->>P: Generation request\n+    P-->>GW: Video (URL or chunks)\n+    GW->>FS: Store video\n+    FS-->>GW: stored_url\n+    GW-->>C: Response with video URL + usage\n+```\n+\n+**Parameters**: duration, resolution, aspect_ratio (via request params)\n+\n+**Async mode**: Video generation is often long-running. Use `async=true` to get job_id immediately and poll for result (see S1.14 Async Jobs).\n+\n+---\n+\n+### [ ] S1.10 Tool/Function Calling\n+\n+Consumer sends request with tools (via reference or inline). Gateway resolves/converts schemas, forwards to provider. Model may return tool calls. Consumer executes tools, sends results back.\n+\n+**Tool definition** (see Tools Format section):\n+- `schema_id` — reference to Type Registry\n+- Inline GTS schema — full spec with `$id`, `params`, `returns`\n+\n+**Request example**:\n+```plaintext\n+tools: [\n+  // Reference\n+  { schema_id: \"gts.hx.core.faas.func.v1~acme.crm.contacts.search.v1\" },\n+\n+  // Inline\n+  {\n+    $id: \"dynamic_filter\",\n+    title: \"Dynamic Filter\",\n+    params: { type: \"object\", properties: { field: { type: \"string\" } } },\n+    returns: { type: \"array\" }\n+  }\n+]\n+```\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant TR as Type Registry\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, tools)\n+    GW->>GW: Separate schema_id refs from inline\n+    GW->>TR: Get schemas by IDs (if any)\n+    TR-->>GW: GTS schemas\n+    GW->>GW: Merge with inline schemas\n+    GW->>GW: Convert all to provider format\n+    GW->>P: Request with provider-specific tools\n+    P-->>GW: tool_calls[]\n+    GW-->>C: Response with tool_calls[] (tool_id preserved)\n+    Note over C: Consumer executes tools\n+    C->>GW: chat_completion(messages + tool_results)\n+    GW->>P: Request with tool results\n+    P-->>GW: Final response\n+    GW-->>C: Response\n+```\n+\n+**Gateway role**:\n+- Resolves `schema_id` references from Type Registry\n+- Uses inline schemas directly\n+- Converts all to provider-specific format (OpenAI functions, Anthropic tools, etc.)\n+- Does not execute tools — consumer handles execution\n+\n+---\n+\n+### [ ] S1.11 Structured Output\n+\n+Consumer requests JSON output with schema validation. Gateway passes schema to provider, validates response.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>GW: chat_completion(model, messages, response_format)\n+    GW->>P: Request with JSON schema\n+    P-->>GW: JSON response\n+    GW->>GW: Validate against schema\n+    GW-->>C: Validated JSON + usage\n+```\n+\n+**response_format**: `{ type: \"json_schema\", schema: {...} }`\n+\n+**Validation failure**: Return `schema_validation_failed` with raw response in Problem extensions.\n+\n+---\n+\n+### [ ] S1.12 Model Discovery\n+\n+Consumer queries available models and their capabilities.\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant GW as LLM Gateway\n+\n+    C->>GW: list_models(filter?)\n+    GW->>GW: Aggregate from configured providers\n+    GW-->>C: models[]\n+```\n+\n+**Model info**:\n+- id, name, provider\n+- capabilities: chat, vision, audio, video, embeddings, tools, json_mode\n+- context_window, max_output_tokens\n+- pricing (per 1M tokens)\n+- supported_extensions: provider-specific features available for this model\n+\n+**Example**:\n+```plaintext\n+{\n+  id: \"claude-3-5-sonnet\",\n+  name: \"Claude 3.5 Sonnet\",\n+  provider: \"anthropic\",\n+  capabilities: [\"chat\", \"vision\", \"tools\", \"json_mode\"],\n+  context_window: 200000,\n+  max_output_tokens: 8192,\n+  pricing: { prompt: 3.0, completion: 15.0 },\n+  supported_extensions: {\n+    \"anthropic\": [\"cache_control\", \"extended_thinking\"]\n+  }\n+}\n+```\n+\n+---\n+\n+### [ ] S1.13 Document Understanding\n+\n+Consumer uploads document to FileStorage, sends URL. Gateway fetches document, passes to capable model.\n+\n+**Supported formats**: Provider-dependent (typically PDF, images)\n+\n+```mermaid\n+sequenceDiagram\n+    participant C as Consumer\n+    participant FS as FileStorage\n+    participant GW as LLM Gateway\n+    participant P as Provider\n+\n+    C->>FS: Upload document\n+    FS-->>C: URL\n+    C->>GW: chat_completion(model, messages with document URL)\n+    GW->>GW: Validate model supports documents\n+    GW->>FS: Fetch document\n+    FS-->>GW: document content\n+    GW->>P: Request with document content\n+    P-->>GW: Analysis + usage\n+    GW-->>C: Response + usage\n+```\n+\n+---\n+\n+### [ ] S1.14 Async Jobs\n+\n+Consumer explicitly requests async mode via `async=true`. Gateway abstracts provider behavior — consumer always gets consistent response type.\n+\n+**Behavior matrix**:\n+\n+| Request | Provider | Gateway action |\n+|---------|----------|----------------|\n+| `async=false` (default) | sync | Return result immediately |\n+| `async=false` (default) | async | Poll internally, return result when done |\n+| `async=true` | sync | Simulate job (execute, store result, return job_id) |\n+| `async=true` | async | Return job_id, consumer polls |\n+","path":"modules/llm_gateway/docs/PRD.md","commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","original_commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Specify timeout for internal async provider polling.**\n\nThe behavior matrix (lines 740-746) states that when `async=false` and the provider is async, the Gateway \"Poll internally, return result when done\" (line 743). This could lead to long-hanging connections if the provider job takes extended time.\n\nDocument:\n- Maximum wait time before returning a timeout error\n- Whether Gateway switches to returning a job_id if polling exceeds a threshold\n- Connection timeout enforcement to prevent resource exhaustion\n\nExample approach:\n> When `async=false` and provider is async, Gateway polls for up to 30s. If incomplete, returns `provider_timeout` error with suggestion to retry with `async=true`.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/llm_gateway/docs/PRD.md` around lines 740 - 746, Update the PRD\nmatrix and surrounding text for the Gateway's handling of provider-side async\njobs (the \"async=false\" + \"provider async\" case) to specify a maximum internal\npolling timeout (e.g., 30s), the returned error when exceeded (e.g.,\n\"provider_timeout\" with guidance to retry using async=true), and that the\nGateway enforces a connection/polling timeout to avoid resource exhaustion; also\nstate whether the Gateway will automatically switch to returning a job_id after\nthe threshold (explicitly specify it will not auto-switch but will return the\ntimeout error unless configured otherwise) so readers know polling behavior,\nretry suggestion, and enforced connection timeout policy.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-16T13:35:50Z","updated_at":"2026-01-16T13:35:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538699","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538699"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2698538699"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698538699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":740,"start_side":"RIGHT","line":null,"original_line":746,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":746,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702344807","pull_request_review_id":3675428517,"id":2702344807,"node_id":"PRRC_kwDOPaLyBs6hEoJn","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+| [ ] | Usage tracking |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'd move it to dedicated OAGW module, or explicitly explain why not. (e.g. tokens limit or so)","created_at":"2026-01-18T11:40:17Z","updated_at":"2026-01-26T23:48:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2702344807","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702344807"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2702344807"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/245"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702344807/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":32,"original_line":32,"side":"RIGHT","author_association":"MEMBER","original_position":32,"position":32,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2702345117","pull_request_review_id":3675428793,"id":2702345117,"node_id":"PRRC_kwDOPaLyBs6hEoOd","diff_hunk":"@@ -0,0 +1,89 @@\n+# LLM Gateway\n+\n+Unified interface for LLM inference across providers. Stateless, pass-through design.\n+\n+## Capabilities\n+\n+### P1 — Core\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Chat completion (sync and streaming) |\n+| [ ] | Embeddings generation |\n+| [ ] | Vision (image analysis) |\n+| [ ] | Image generation |\n+| [ ] | Speech-to-text (transcription) |\n+| [ ] | Text-to-speech (synthesis) |\n+| [ ] | Video understanding |\n+| [ ] | Video generation |\n+| [ ] | Document understanding |\n+| [ ] | Tool/function calling |\n+| [ ] | Structured output (JSON mode) |\n+| [ ] | Model discovery |\n+| [ ] | Async jobs (long-running operations) |\n+| [ ] | Realtime audio (WebSocket) |\n+| [ ] | Usage tracking |\n+\n+### P2 — Reliability & Governance\n+\n+| Done | Capability |\n+|------|------------|\n+| [ ] | Provider fallback |\n+| [ ] | Retry with backoff |\n+| [ ] | Timeout enforcement |","path":"modules/llm_gateway/README.md","commit_id":"10ead9a75b24501956b240af80221e57ccc0c971","original_commit_id":"77141627cc1b39e5c7e71bc096b2b1615deed89b","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We can keep policy (definition) here, but more enforcement to OAGW","created_at":"2026-01-18T11:40:52Z","updated_at":"2026-01-18T11:40:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/245#discussion_r2702345117","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberw
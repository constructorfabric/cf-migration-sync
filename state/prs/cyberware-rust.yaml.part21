thor_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3705971647/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653011286","pull_request_review_id":3618237336,"id":2653011286,"node_id":"PRRC_kwDOPaLyBs6eIb1W","diff_hunk":"@@ -0,0 +1,302 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Integration tests for the nodes registry domain layer\n+//!\n+//! These tests verify the behavior of the service and its interaction with storage.\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::service::Service;\n+\n+#[test]\n+fn test_multiple_service_instances_have_independent_storage() {\n+    let service1 = Service::new();\n+    let service2 = Service::new();\n+\n+    let nodes1 = service1.list_nodes();\n+    let nodes2 = service2.list_nodes();\n+\n+    // Each service should have its own current node\n+    assert_eq!(nodes1.len(), 1);","path":"modules/nodes_registry/tests/domain_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's not clear how does it mean that storages are independent","created_at":"2025-12-30T13:27:16Z","updated_at":"2025-12-30T13:27:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653011286","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653011286"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653011286"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653011286/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":19,"side":"RIGHT","author_association":"MEMBER","original_position":19,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653015240","pull_request_review_id":3618242073,"id":2653015240,"node_id":"PRRC_kwDOPaLyBs6eIczI","diff_hunk":"@@ -0,0 +1,302 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Integration tests for the nodes registry domain layer\n+//!\n+//! These tests verify the behavior of the service and its interaction with storage.\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::service::Service;\n+\n+#[test]\n+fn test_multiple_service_instances_have_independent_storage() {\n+    let service1 = Service::new();\n+    let service2 = Service::new();\n+\n+    let nodes1 = service1.list_nodes();\n+    let nodes2 = service2.list_nodes();\n+\n+    // Each service should have its own current node\n+    assert_eq!(nodes1.len(), 1);\n+    assert_eq!(nodes2.len(), 1);\n+}\n+\n+#[test]\n+fn test_custom_syscap_persists_across_syscap_refreshes() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Set custom capability\n+    let custom_cap = vec![SysCap {\n+        key: \"custom.persistent\".to_owned(),\n+        category: \"custom\".to_owned(),\n+        name: \"persistent\".to_owned(),\n+        display_name: \"Persistent Feature\".to_owned(),\n+        present: true,\n+        version: Some(\"1.0.0\".to_owned()),\n+        amount: None,\n+        amount_dimension: None,\n+        details: None,\n+        cache_ttl_secs: 3600,\n+        fetched_at_secs: chrono::Utc::now().timestamp(),\n+    }];\n+\n+    service.set_custom_syscap(node_id, custom_cap).unwrap();\n+\n+    // Force refresh of syscap\n+    let syscap_before = service.get_node_syscap(node_id, true).unwrap();\n+\n+    // Custom capability should still be present\n+    let has_custom = syscap_before\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key == \"custom.persistent\");\n+    assert!(has_custom, \"Custom capability should persist after refresh\");\n+\n+    // Refresh again\n+    let syscap_after = service.get_node_syscap(node_id, true).unwrap();\n+    let has_custom = syscap_after\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key == \"custom.persistent\");\n+    assert!(\n+        has_custom,\n+        \"Custom capability should still persist after second refresh\"\n+    );\n+}\n+\n+#[test]\n+fn test_sysinfo_collection_is_idempotent() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Collect sysinfo multiple times\n+    let result1 = service.get_node_sysinfo(node_id);\n+    let result2 = service.get_node_sysinfo(node_id);\n+    let result3 = service.get_node_sysinfo(node_id);\n+\n+    assert!(result1.is_ok());\n+    assert!(result2.is_ok());\n+    assert!(result3.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+    let sysinfo3 = result3.unwrap();\n+\n+    // All should return the same cached data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo2.node_id, sysinfo3.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+    assert_eq!(sysinfo2.collected_at, sysinfo3.collected_at);\n+}\n+\n+#[test]\n+fn test_service_handles_many_custom_syscaps() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Add many custom capabilities\n+    let mut custom_caps = Vec::new();\n+    for i in 0..100 {\n+        custom_caps.push(SysCap {\n+            key: format!(\"custom.test.{i}\"),\n+            category: \"custom\".to_owned(),\n+            name: format!(\"test_{i}\"),\n+            display_name: format!(\"Test {i}\"),\n+            present: true,\n+            version: Some(format!(\"1.0.{i}\")),\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        });\n+    }\n+\n+    let result = service.set_custom_syscap(node_id, custom_caps);\n+    assert!(result.is_ok());\n+\n+    // Get all syscaps\n+    let syscap = service.get_node_syscap(node_id, false).unwrap();\n+\n+    // Should have system caps + 100 custom caps\n+    let custom_count = syscap\n+        .capabilities\n+        .iter()\n+        .filter(|c| c.key.starts_with(\"custom.test.\"))\n+        .count();\n+    assert_eq!(custom_count, 100, \"Should have all 100 custom capabilities\");\n+}\n+\n+#[test]\n+fn test_removing_nonexistent_custom_syscap_keys_succeeds() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Try to remove keys that don't exist\n+    let result = service.remove_custom_syscap(\n+        node_id,\n+        vec![\"custom.nonexistent1\".to_owned(), \"custom.nonexistent2\".to_owned()],\n+    );\n+\n+    assert!(","path":"modules/nodes_registry/tests/domain_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can we test not only that result is ok, but also that nothing is removed?","created_at":"2025-12-30T13:29:42Z","updated_at":"2025-12-30T13:29:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653015240","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653015240"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653015240"},"pull_request":{"href":"https://a
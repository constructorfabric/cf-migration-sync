,"url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\r\n    Postcard(#[from] PostcardError),\r\n```\r\nSame comment than previous","created_at":"2026-01-14T16:02:03Z","updated_at":"2026-01-14T16:07:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691066195","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691066195"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691066195"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691066195/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":28,"side":"RIGHT","author_association":"MEMBER","original_position":31,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691087344","pull_request_review_id":3661513188,"id":2691087344,"node_id":"PRRC_kwDOPaLyBs6gZrvw","diff_hunk":"@@ -26,42 +25,42 @@ pub enum SecCtxDecodeError {\n     UnsupportedVersion(u8),\n \n     #[error(\"security context deserialization failed: {0:?}\")]\n-    Bincode(DecodeError),\n+    Postcard(PostcardError),\n }\n \n-impl From<DecodeError> for SecCtxDecodeError {\n-    fn from(err: DecodeError) -> Self {\n-        SecCtxDecodeError::Bincode(err)\n+impl From<PostcardError> for SecCtxDecodeError {\n+    fn from(err: PostcardError) -> Self {\n+        SecCtxDecodeError::Postcard(err)\n     }\n }\n \n-const fn secctx_config() -> impl Config {\n-    standard().with_fixed_int_encoding().with_little_endian()\n-}\n-\n-/// Encode `SecurityCtx` into a versioned binary blob.\n+/// Encode `SecurityContext` into a versioned binary blob using `postcard`.\n /// This does not do any signing or encryption, it is just a transport format.\n ///\n /// # Errors\n-/// Returns `SecCtxEncodeError` if bincode serialization fails.\n-pub fn encode_bin(ctx: &SecurityCtx) -> Result<Vec<u8>, SecCtxEncodeError> {\n+/// Returns `SecCtxEncodeError` if postcard serialization fails.\n+pub fn encode_bin(ctx: &SecurityContext) -> Result<Vec<u8>, SecCtxEncodeError> {\n     let mut buf = Vec::with_capacity(64);\n     buf.push(SECCTX_BIN_VERSION);\n \n-    let cfg = secctx_config();\n-    let payload = bincode::serde::encode_to_vec(ctx, cfg)?;\n-    buf.extend_from_slice(&payload);\n+    // Use a temporary buffer for postcard::to_slice to avoid requiring postcard's\n+    // `alloc`/`std` features (postcard may be compiled with heapless output).\n+    // 4 KiB should be enough for a typical SecurityContext; if it's larger, callers\n+    // will get a serialization error and we can revisit.\n+    let mut tmp = vec![0u8; 4 * 1024];\n+    let payload_slice = postcard::to_slice(ctx, &mut tmp)?;","path":"libs/modkit-security/src/bin_codec.rs","commit_id":"e44a66edacdc43f5b4cfa56fab55fc2026e03dde","original_commit_id":"e44a66edacdc43f5b4cfa56fab55fc2026e03dde","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"you are allocating a Vec already, so you are going with the heap already as you are not using a slice of bytes.\r\nWhy not using `to_allocvec` so we don't need to care about heap/stack allocations? (always heap)","created_at":"2026-01-14T16:07:28Z","updated_at":"2026-01-14T16:07:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691087344","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691087344"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691087344"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691087344/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":51,"side":"RIGHT","author_association":"MEMBER","original_position":67,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691165981","pull_request_review_id":3661633165,"id":2691165981,"node_id":"PRRC_kwDOPaLyBs6gZ-8d","diff_hunk":"@@ -26,42 +25,42 @@ pub enum SecCtxDecodeError {\n     UnsupportedVersion(u8),\n \n     #[error(\"security context deserialization failed: {0:?}\")]\n-    Bincode(DecodeError),\n+    Postcard(PostcardError),\n }\n \n-impl From<DecodeError> for SecCtxDecodeError {\n-    fn from(err: DecodeError) -> Self {\n-        SecCtxDecodeError::Bincode(err)\n+impl From<PostcardError> for SecCtxDecodeError {\n+    fn from(err: PostcardError) -> Self {\n+        SecCtxDecodeError::Postcard(err)\n     }\n }\n \n-const fn secctx_config() -> impl Config {\n-    standard().with_fixed_int_encoding().with_little_endian()\n-}\n-\n-/// Encode `SecurityCtx` into a versioned binary blob.\n+/// Encode `SecurityContext` into a versioned binary blob using `postcard`.\n /// This does not do any signing or encryption, it is just a transport format.\n ///\n /// # Errors\n-/// Returns `SecCtxEncodeError` if bincode serialization fails.\n-pub fn encode_bin(ctx: &SecurityCtx) -> Result<Vec<u8>, SecCtxEncodeError> {\n+/// Returns `SecCtxEncodeError` if postcard serialization fails.\n+pub fn encode_bin(ctx: &SecurityContext) -> Result<Vec<u8>, SecCtxEncodeError> {\n     let mut buf = Vec::with_capacity(64);\n     buf.push(SECCTX_BIN_VERSION);\n \n-    let cfg = secctx_config();\n-    let payload = bincode::serde::encode_to_vec(ctx, cfg)?;\n-    buf.extend_from_slice(&payload);\n+    // Use a temporary buffer for postcard::to_slice to avoid requiring postcard's\n+    // `alloc`/`std` features (postcard may be compiled with heapless output).\n+    // 4 KiB should be enough for a typical SecurityContext; if it's larger, callers\n+    // will get a serialization error and we can revisit.\n+    let mut tmp = vec![0u8; 4 * 1024];\n+    let payload_slice = postcard::to_slice(ctx, &mut tmp)?;","path":"libs/modkit-security/src/bin_codec.rs","commit_id":"e44a66edacdc43f5b4cfa56fab55fc2026e03dde","original_commit_id":"e44a66edacdc43f5b4cfa56fab55fc2026e03dde","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"thx, fixed.","created_at":"2026-01-14T16:28:25Z","updated_at":"2026-01-14T16:28:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691165981","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691165981"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/241#discussion_r2691165981"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/241"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2691165981/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eye
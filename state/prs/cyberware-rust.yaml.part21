i>()?;\n-/// let user = client.get_user(&ctx, user_id).await?;\n-/// ```\n-///\n-/// All methods require a `SecurityContext` for proper authorization and access control.\n-#[async_trait]\n-pub trait UsersInfoApi: Send + Sync {\n-    /// Get a user by ID.\n-    async fn get_user(&self, ctx: &SecurityContext, id: Uuid) -> Result<User, UsersInfoError>;\n-\n-    /// List users with cursor-based pagination.\n-    async fn list_users(\n-        &self,\n-        ctx: &SecurityContext,\n-        query: ODataQuery,\n-    ) -> Result<Page<User>, UsersInfoError>;\n+use crate::models::{\n+    Address, City, Language, NewAddress, NewCity, NewLanguage, NewUser, UpdateAddressRequest,\n+    UpdateCityRequest, UpdateLanguageRequest, UpdateUserRequest, User,\n+};\n+\n+#[cfg(feature = \"odata\")]\n+use crate::odata::{AddressSchema, CitySchema, LanguageSchema, UserSchema};\n+\n+/// Boxed stream type returned by streaming client facades.\n+pub type UsersInfoStream<T> =\n+    Pin<Box<dyn Stream<Item = Result<T, UsersInfoError>> + Send + 'static>>;\n+\n+/// Object-safe client for inter-module consumption (`ClientHub` registered).\n+pub trait UsersInfoClient: Send + Sync {\n+    fn users(&self) -> Box<dyn UsersStreamingClient>;\n+    fn cities(&self) -> Box<dyn CitiesStreamingClient>;\n+    fn languages(&self) -> Box<dyn LanguagesStreamingClient>;\n+    fn addresses(&self) -> Box<dyn AddressesStreamingClient>;\n+\n+    // ==================== Single-Item Operations ====================\n+\n+    /// Get a single user by ID.\n+    fn get_user(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<User, UsersInfoError>>;\n+\n+    /// Get a single city by ID.\n+    fn get_city(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<City, UsersInfoError>>;\n+\n+    /// Get a single language by ID.\n+    fn get_language(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<Language, UsersInfoError>>;\n+\n+    /// Get a single address by ID.\n+    fn get_address(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<Address, UsersInfoError>>;\n+\n+    /// Get address by user ID (1-to-1 relationship).\n+    fn get_address_by_user(\n+        &self,\n+        ctx: SecurityContext,\n+        user_id: Uuid,\n+    ) -> BoxFuture<'static, Result<Option<Address>, UsersInfoError>>;\n+\n+    // ==================== Mutation Operations ====================\n \n     /// Create a new user.\n-    async fn create_user(\n+    fn create_user(\n         &self,\n-        ctx: &SecurityContext,\n+        ctx: SecurityContext,\n         new_user: NewUser,\n-    ) -> Result<User, UsersInfoError>;\n+    ) -> BoxFuture<'static, Result<User, UsersInfoError>>;\n \n-    /// Update a user with partial data.\n-    async fn update_user(\n+    /// Update an existing user.\n+    fn update_user(\n         &self,\n-        ctx: &SecurityContext,\n+        ctx: SecurityContext,\n         req: UpdateUserRequest,\n-    ) -> Result<User, UsersInfoError>;\n+    ) -> BoxFuture<'static, Result<User, UsersInfoError>>;\n \n     /// Delete a user by ID.\n-    async fn delete_user(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), UsersInfoError>;\n+    fn delete_user(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    /// Create a new city.\n+    fn create_city(\n+        &self,\n+        ctx: SecurityContext,\n+        new_city: NewCity,\n+    ) -> BoxFuture<'static, Result<City, UsersInfoError>>;\n+\n+    /// Update an existing city.\n+    fn update_city(\n+        &self,\n+        ctx: SecurityContext,\n+        req: UpdateCityRequest,\n+    ) -> BoxFuture<'static, Result<City, UsersInfoError>>;\n+\n+    /// Delete a city by ID.\n+    fn delete_city(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    /// Create a new language.\n+    fn create_language(\n+        &self,\n+        ctx: SecurityContext,\n+        new_language: NewLanguage,\n+    ) -> BoxFuture<'static, Result<Language, UsersInfoError>>;\n+\n+    /// Update an existing language.\n+    fn update_language(\n+        &self,\n+        ctx: SecurityContext,\n+        req: UpdateLanguageRequest,\n+    ) -> BoxFuture<'static, Result<Language, UsersInfoError>>;\n+\n+    /// Delete a language by ID.\n+    fn delete_language(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    /// Create a new address.\n+    fn create_address(\n+        &self,\n+        ctx: SecurityContext,\n+        new_address: NewAddress,\n+    ) -> BoxFuture<'static, Result<Address, UsersInfoError>>;\n+\n+    /// Update an existing address.\n+    fn update_address(\n+        &self,\n+        ctx: SecurityContext,\n+        req: UpdateAddressRequest,\n+    ) -> BoxFuture<'static, Result<Address, UsersInfoError>>;\n+\n+    /// Delete an address by ID.\n+    fn delete_address(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    // ==================== Relationship Operations ====================\n+\n+    /// Assign a language to a user (many-to-many).\n+    fn assign_language_to_user(\n+        &self,\n+        ctx: SecurityContext,\n+        user_id: Uuid,\n+        language_id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    /// Remove a language from a user.\n+    fn remove_language_from_user(\n+        &self,\n+        ctx: SecurityContext,\n+        user_id: Uuid,\n+        language_id: Uuid,\n+    ) -> BoxFuture<'static, Result<(), UsersInfoError>>;\n+\n+    /// List all languages assigned to a user.\n+    fn list_user_languages(\n+        &self,\n+        ctx: SecurityContext,\n+        user_id: Uuid,\n+    ) -> BoxFuture<'static, Result<Vec<Language>, UsersInfoError>>;\n+}\n+\n+/// Streaming interface for users.\n+pub trait UsersStreamingClient: Send + Sync {\n+    fn stream(\n+        &self,\n+        ctx: SecurityContext,\n+        query: QueryBuilder<UserSchema>,\n+    ) -> UsersInfoStream<User>;\n+}\n+\n+/// Streaming interface for cities.\n+pub trait CitiesStreamingClient: Send + Sync {\n+    fn stream(\n+        &self,\n+        ctx: SecurityContext,\n+        query: QueryBuilder<CitySchema>,\n+    ) -> UsersInfoStream<City>;","path":"examples/modkit/users_info/user_info-sdk/src/api.rs","commit_id":"b850e8de7ef95cea73f9f7998e222088a746623a","original_commit_id":"b850e8de7ef95cea73f9f7998e222088a746623a","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Will most of modules expose streaming APIs for sdks? What I see currently in draft requirements is returning `Result<Page<T>, Error>`","created_at":"2026-01-08T21:09:12Z","updated_at":"2026-01-08T21:09:12Z","html_url":"https://github.com/cyberfabric/cyberwa
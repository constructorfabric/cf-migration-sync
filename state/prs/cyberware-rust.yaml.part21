lowercase checks in ExcelFormat::from_filename; change the\nconstruction of default_filename to yield a lowercase extension that matches\nfrom_filename (e.g., use the Display/to_string() value or call to_lowercase() on\nit, or better, use an explicit extension helper/extension() method if\nExcelFormat provides one) so that default_filename, filename, and the subsequent\nExcelFormat::from_filename(filename) behave correctly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits 0ba7182 to 9512644","created_at":"2026-02-02T17:01:01Z","updated_at":"2026-02-02T18:13:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2755353385","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755353385"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2755353385"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755353385/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":157,"start_side":"RIGHT","line":null,"original_line":164,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":204,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2755353390","pull_request_review_id":3740766395,"id":2755353390,"node_id":"PRRC_kwDOPaLyBs6kO1su","diff_hunk":"@@ -122,13 +177,21 @@ impl FileParserBackend for XlsxParser {\n     async fn parse_bytes(\n         &self,\n         filename_hint: Option<&str>,\n-        content_type: Option<&str>,\n+        _content_type: Option<&str>,\n         bytes: by
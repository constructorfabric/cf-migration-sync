 }\n+    }\n+}\n+\n+pub struct Service {\n+    repo: Arc<dyn SettingsRepository>,\n+    config: ServiceConfig,\n+}\n+\n+impl Service {\n+    pub fn new(repo: Arc<dyn SettingsRepository>, config: ServiceConfig) -> Self {\n+        Self { repo, config }\n+    }\n+\n+    pub async fn get_settings(&self, ctx: &SecurityContext) -> Result<Settings, DomainError> {\n+        let scope = AccessScope::both(vec![ctx.tenant_id()], vec![ctx.subject_id()]);\n+\n+        if let Some(settings) = self.repo.find_by_user(&scope).await? {\n+            Ok(settings)\n+        } else {\n+            let user_id = ctx.subject_id();\n+            let tenant_id = ctx.tenant_id();\n+\n+            Ok(Settings {\n+                user_id,\n+                tenant_id,\n+                theme: String::new(),\n+                language: String::new(),\n+            })\n+        }\n+    }\n+\n+    pub async fn update_settings(\n+        &self,\n+        ctx: &SecurityContext,\n+        theme: String,\n+        language: String,\n+    ) -> Result<Settings, DomainError> {\n+        self.validate_field(\"theme\", &theme)?;\n+        self.validate_field(\"language\", &language)?;","path":"modules/settings/settings/src/domain/service.rs","commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","original_commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/use
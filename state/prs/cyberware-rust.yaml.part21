erfabric/cyberware-rust/pull/229"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/229"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/229/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/229/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/229/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/36a2e2b65e79b7ab44cc25117e00b128abb3e72f"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":224,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/224","source_state":"closed","source_author":"KvizadSaderah","target_issue_number":null,"title":"[PR #224] feat(dylint): add top-10 new lints","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/dylint-top10","pr_head_sha":"072f9b8ead8d2f587f07e787b943da0164a19e24","pr_base_ref":"main","pr_head_owner":"KvizadSaderah","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224","id":3163828049,"node_id":"PR_kwDOPaLyBs68lC9R","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/224","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/224.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/224.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/224","number":224,"state":"closed","locked":false,"title":"feat(dylint): add top-10 new lints","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\n\nCloses #68 (task: \"prepare PRs with top-10 new dylints @KvizadSaderah\")\n\nThis PR adds 10 new dylint linters:\n\n### Domain Layer (de03)\n- **DE0301** - No infrastructure dependencies in domain layer\n- **DE0305** - No panics in domain layer  \n- **DE0308** - No HTTP types in domain layer\n\n### Infrastructure Layer (de04)\n- **DE0407** - No hardcoded database connection strings\n- **DE0409** - No secrets in migration files\n\n### Security (de07)\n- **DE0701** - No `.unwrap()` usage\n- **DE0702** - No `.expect()` usage\n- **DE0703** - No hardcoded secrets (API keys, passwords, tokens)\n- **DE0705** - No SQL injection vectors\n\n### Documentation (de11)\n- **DE1107** - Public APIs require doc comments\n\n## Test plan\n- [x] All UI tests pass (`cargo test`)\n- [x] Build succeeds without errors\n- [x] No example name collisions in workspace\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n## Release Notes\n\n* **New Features**\n  * Added 8 new Rust linting rules: Domain layer architecture enforcement (no infrastructure, no HTTP), Infrastructure security checks (hardcoded connection strings, secrets in migrations), Security rules (hardcoded secrets, prebuilt SQL queries, direct sqlx usage), and Documentation requirements (public APIs must have doc comments).\n\n* **Chores**\n  * Modernized security and registry APIs with updated type names and method signatures.\n  * Updated module capability traits to align with new architectural patterns.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-11T20:22:11Z","updated_at":"2026-01-15T18:16:31Z","closed_at":"2026-01-15T18:16:31Z","merged_at":null,"merge_commit_sha":"626876e11da86a63d25c66feaebbef061a05dd26","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/224/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/224/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/072f9b8ead8d2f587f07e787b943da0164a19e24","head":{"label":"KvizadSaderah:feature/dylint-top10","ref":"feature/dylint-top10","sha":"072f9b8ead8d2f587f07e787b943da0164a19e24","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users
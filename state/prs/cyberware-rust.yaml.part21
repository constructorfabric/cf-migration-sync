"original_start_line":null,"start_side":null,"line":109,"original_line":83,"side":"RIGHT","author_association":"MEMBER","original_position":83,"position":109,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689441643","pull_request_review_id":3659416956,"id":2689441643,"node_id":"PRRC_kwDOPaLyBs6gTZ9r","diff_hunk":"@@ -0,0 +1,164 @@\n+use async_trait::async_trait;\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{DocumentBuilder, ParsedBlock, ParsedSource};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// Image parser that handles standard image formats\n+///\n+/// Treats images as opaque binary payloads and encodes them as base64 data URIs.\n+/// No decoding, resizing, or re-encoding is performed.\n+///\n+/// Supported formats:\n+/// - PNG (.png, image/png)\n+/// - JPEG (.jpg, .jpeg, image/jpeg)\n+/// - WebP (.webp, image/webp)\n+/// - GIF (.gif, image/gif) – static only\n+pub struct ImageParser;\n+\n+impl ImageParser {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Determine MIME type from file extension\n+    fn mime_type_from_extension(extension: &str) -> Option<&'static str> {\n+        match extension.to_lowercase().as_str() {\n+            \"png\" => Some(\"image/png\"),\n+            \"jpg\" | \"jpeg\" => Some(\"image/jpeg\"),\n+            \"webp\" => Some(\"image/webp\"),\n+            \"gif\" => Some(\"image/gif\"),\n+            _ => None,\n+        }\n+    }\n+\n+    /// Determine MIME type from filename or provided content type\n+    fn determine_mime_type(\n+        filename_hint: Option<&str>,\n+        content_type: Option<&str>,\n+    ) -> Result<String, DomainError> {\n+        // Priority 1: Use provided content-type if it's an image type\n+        if let Some(ct) = content_type {\n+            if ct.starts_with(\"image/\") {\n+                return Ok(ct.to_owned());\n+            }\n+        }\n+\n+        // Priority 2: Infer from filename extension\n+        if let Some(filename) = filename_hint {\n+            if let Some(ext) = Path::new(filename).extension().and_then(|s| s.to_str()) {\n+                if let Some(mime) = Self::mime_type_from_extension(ext) {\n+                    return Ok(mime.to_owned());\n+                }\n+            }\n+        }\n+\n+        Err(DomainError::unsupported_file_type(\n+            \"Unable to determine image MIME type\",\n+        ))\n+    }\n+\n+    /// Build a data URI from raw image bytes\n+    fn build_data_uri(mime_type: &str, bytes: &[u8]) -> String {\n+        use base64::Engine;\n+        let encoded = base64::engine::general_purpose::STANDARD.encode(bytes);\n+        format!(\"data:{mime_type};base64,{encoded}\")\n+    }\n+}\n+\n+impl Default for ImageParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for ImageParser {\n+    fn id(&self) -> &'static str {\n+        \"image\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"png\", \"jpg\", \"jpeg\", \"webp\", \"gif\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        // Read file bytes\n+        let bytes = tokio::fs::read(path)","path":"modules/file_parser/src/infra/parsers/image_parser.rs","commit_id":"8c9ba754af9845107dcdc2d647409eb59d73598e","original_commit_id":"0be296c2f9c1fbc5794b0ea237b86f0dd83f9614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We must limit the file size for both the API (this is likely already enforced at the API gateway layer please check) and local files.\r\n\r\nIf a user uploads a 1 GB file, it will cause problems.\r\nI suggest introducing a max_file_size parameter in the module configuration. Let's set it 10Mb by default.\r\n\r\n","created_at":"2026-01-14T08:22:14Z","updated_at":"2026-01-14T08:22:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2689441643","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/236","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689441643"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2689441643"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/236"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689441643/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":131,"original_line":92,"side":"RIGHT","author_association":"MEMBER","original_position":92,"position":131,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689568412","pull_request_review_id":3659610352,"id":2689568412,"node_id":"PRRC_kwDOPaLyBs6gT46c","diff_hunk":"","path":"modules/file_parser/src/infra/parsers/image_parser.rs","commit_id":"8c9ba754af9845107dcdc2d647409eb59d73598e","original_commit_id":"0be296c2f9c1fbc5794b0ea237b86f0dd83f9614","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is not the topic of this particular PR, but I suggest moving the entire parsers module to the src/infra folder. A specific parser implementation is not part of the domain in our DDD-light design.\r\n\r\nAt the same time, the FileParserBackend trait and the IR should remain in the domain layer, as they do now.","created_at":"2026-01-14T09:02:47Z","updated_at":"2026-01-14T09:02:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2689568412","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/236","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2689568412"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/236#discussion_r2689568412"},"pull_request":{"href":"https://api.git
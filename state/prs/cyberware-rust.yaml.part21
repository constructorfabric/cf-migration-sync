.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@yoskini , the server actually has the `/docs` API where we have all the API methods and parameters and also 'try now' button to see live response\n\nShall we still keep this examples here or better just to mention that '/docs' endpoint?","created_at":"2026-01-26T20:39:43Z","updated_at":"2026-01-26T20:39:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/251#discussion_r2729172061","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/251","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729172061"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/251#discussion_r2729172061"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/251"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729172061/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2737227942","pull_request_review_id":3717410704,"id":2737227942,"node_id":"PRRC_kwDOPaLyBs6jJsim","diff_hunk":"@@ -78,6 +79,52 @@ modules/<your-module>/\n             └─ migrations/      # SeaORM migrations\n ```\n \n+### Module Documentation: QUICKSTART.md\n+\n+Every module with REST endpoints MUST include a `QUICKSTART.md` file with:\n+\n+1. **Module description** - One-line summary of what the module does\n+2. **Link to /docs** - Prominent reference to interactive API documentation\n+3. **1-2 minimal examples** - Basic curl commands showing typical usage\n+4. **\"More Examples\" section** - Directing users to `/docs` for complete API reference\n+\n+> **Important:** Keep examples minimal to avoid maintenance burden. The interactive documentation at `/docs` is the authoritative and always up-to-date API reference.\n+\n+**Template:**\n+\n+    # <Module Name> - Quickstart\n+    \n+    <One-line description of what the module does.>\n+    \n+    > **Full API Documentation:** <http://127.0.0.1:8087/docs> - Interactive docs with all endpoints, parameters, and \"Try it out\" buttons.\n+    \n+    ## Quick Example\n+    \n+    ### List Resources\n+    \n+    ```bash\n+    curl -s http://127.0.0.1:8087/<module>/v1/resource | python3 -m json.tool\n+    ```\n+    \n+    **Output:**\n+    ```json\n+    {\n+        \"items\": [...]\n+    }\n+    ```\n+    \n+    ## More Examples\n+    \n+    For additional endpoints, see the interactive documentation at <http://127.0.0.1:8087/docs>.","path":"guidelines/NEW_MODULE.md","commit_id":"bd185298b9a7ee451401ff3a457c0b9bf3ce001e","original_commit_id":"a99251a8a6a9d0fb64240364088bc724d846b343","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Use fenced code block for the QUICKSTART template to satisfy MD046.**\n\nThe template is indented and triggers markdownlint MD046. Switch it to a fenced block to keep consistent style and lint clean.  \n\n\n<details>\n<summary>📝 Proposed fix</summary>\n\n```diff\n-    # <Module Name> - Quickstart\n-    \n-    <One-line description of what the module does.>\n-    \n-    > **Full API Documentation:** <http://127.0.0.1:8087/docs> - Interactive docs with all endpoints, parameters, and \"Try it out\" buttons.\n-    \n-    ## Quick Example\n-    \n-    ### List Resources\n-    \n-    ```bash\n-    curl -s http://127.0.0.1:8087/<module>/v1/resource | python3 -m json.tool\n-    ```\n-    \n-    **Output:**\n-    ```json\n-    {\n-        \"items\": [...]\n-    }\n-    ```\n-    \n-    ## More Examples\n-    \n-    For additional endpoints, see the interactive documentation at <http://127.0.0.1:8087/docs>.\n+```text\n+# <Module Name> - Quickstart\n+\n+<One-line description of what the module does.>\n+\n+> **Full API Documentation:** <http://127.0.0.1:8087/docs> - Interactive docs with all endpoints, parameters, and \"Try it out\" buttons.\n+\n+## Quick Example\n+\n+### List Resources\n+\n+```bash\n+curl -s http://127.0.0.1:8087/<module>/v1/resource | python3 -m json.tool\n+```\n+\n+**Output:**\n+```json\n+{\n+    \"items\": [...]\n+}\n+```\n+\n+## More Examples\n+\n+For additional endpoints, see the interactive documentation at <http://127.0.0.1:8087/docs>.\n+```\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.18.1)</summary>\n\n95-95: Code block style\nExpected: fenced; Actual: indented\n\n(MD046, code-block-style)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n````\nIn `@guidelines/NEW_MODULE.md` around lines 95 - 118, The quickstart template is\nindented and triggers markdownlint MD046; wrap the entire Quickstart section\n(starting at the \"# <Module Name> - Quickstart\" heading through the \"For\nadditional endpoints...\" line) in a single fenced code block (use ```text ...\n```), preserving the internal fenced blocks for the bash example and JSON output\n(the inner ```bash and ```json blocks must remain unchanged) so the curl example\nline \"curl -s http://127.0.0.1:8087/<module>/v1/resource | python3 -m json.tool\"\nand the JSON output block are inside the outer fenced block; update opening and\nclosing fences accordingly to remove indentation and satisfy MD046.\n````\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit bd18529","created_at":"2026-01-28T15:36:00Z","updated_at":"2026-01-28T15:45:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/251#discussion_r2737227942","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/251","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2737227942"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/251#discussion_r2737227942"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/251"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2737227942/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":95,"start_side":"RIGHT","line":null,"original_line":118,"side":"RIGHT","author_association":"CONTRIBUTOR","original_p
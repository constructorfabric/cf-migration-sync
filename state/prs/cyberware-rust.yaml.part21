n77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"it looks like a candidate for tracing layer or whatever but I have no good solution how it could be implemented now. Let's leave ThrottledLog as small utility for simplicity.\r\nreference: https://docs.rs/tracing-throttle/latest/tracing_throttle/","created_at":"2026-01-20T01:16:33Z","updated_at":"2026-01-20T01:33:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/278#discussion_r2706436609","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2706436609"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/278#discussion_r2706436609"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2706436609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":47,"original_line":47,"side":"RIGHT","author_association":"MEMBER","original_position":51,"position":51,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2706441639","pull_request_review_id":3679986438,"id":2706441639,"node_id":"PRRC_kwDOPaLyBs6hUQWn","diff_hunk":"@@ -0,0 +1,207 @@\n+use std::future::Future;\n+use std::sync::Arc;\n+\n+use parking_lot::RwLock;\n+use tokio::sync::Mutex;\n+\n+/// A resettable, allocation-friendly selector for GTS plugin instance IDs.\n+///\n+/// Uses a single-flight pattern to ensure that the resolve function is called\n+/// at most once even under concurrent callers. The selected instance ID is\n+/// cached as `Arc<str>` to avoid allocations on the happy path.\n+pub struct GtsPluginSelector {\n+    /// Cached selected instance ID (sync lock for fast access and sync reset).\n+    cached: RwLock<Option<Arc<str>>>,\n+    /// Mutex to ensure single-flight resolution.\n+    resolve_lock: Mutex<()>,\n+}\n+\n+impl Default for GtsPluginSelector {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+impl GtsPluginSelector {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self {\n+            cached: RwLock::new(None),\n+            resolve_lock: Mutex::new(()),\n+        }\n+    }\n+\n+    /// Returns the cached instance ID, or resolves it using the provided function.\n+    ///\n+    /// Uses a single-flight pattern: even under concurrent callers, the resolve\n+    /// function is called at most once. Returns `Arc<str>` to avoid allocations\n+    /// on the happy path.\n+    /// # Errors\n+    ///\n+    /// Returns `Err(E)` if the provided `resolve` future fails.\n+    pub async fn get_or_init<F, Fut, E>(&self, resolve: F) -> Result<Arc<str>, E>\n+    where\n+        F: FnOnce() -> Fut,\n+        Fut: Future<Output = Result<String, E>>,\n+    {\n+        // Fast path: check if already cached (sync lock, no await)\n+        {\n+            let guard = self.cached.read();\n+            if let Some(ref id) = *guard {\n+                return Ok(Arc::clone(id));\n+            }\n+        }\n+\n+        // Slow path: acquire resolve lock for single-flight\n+        let _resolve_guard = self.resolve_lock.lock().await;\n+\n+        // Re-check after acquiring resolve lock (another caller may have resolved)\n+        {\n+            let guard = self.cached.read();\n+            if let Some(ref id) = *guard {\n+                return Ok(Arc::clone(id));\n+            }\n+        }\n+\n+        // Resolve and cache\n+        let id_string = resolve().await?;\n+        let id: Arc<str> = id_string.into();\n+\n+        {\n+            let mut guard = self.cached.write();\n+            *guard = Some(Arc::clone(&id));\n+        }\n+\n+        Ok(id)\n+    }\n+\n+    /// Clears the cached selected instance ID.\n+    ///\n+    /// Returns `true` if there was a cached value, `false` otherwise.\n+    pub fn reset(&self) -> bool {\n+        let mut guard = self.cached.write();\n+        guard.take().is_some()","path":"libs/modkit/src/plugins/mod.rs","commit_id":"80f11a458f72b44d826ed2cffa6ec8312956f3ba","original_commit_id":"a3a31e31700c502ccac78a788bc90fe06dfee735","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, let's look at the actual code in the file\ncat -n libs/modkit/src/plugins/mod.rs | head -100\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3718\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for all call sites of reset() method\nrg -n --type=rust \"\\.reset\\(\\)\" -B2 -A2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 375\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for the GtsPluginSelector struct and its usage\nrg -n --type=rust \"GtsPluginSelector|reset\\(\\)\" -B3 -A3\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 9011\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the broader context of the file to understand the struct definition\nfd \"mod.rs\" | xargs rg -l \"GtsPluginSelector\"\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 94\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for all reset() calls across the entire codebase\nrg -n \"\\.reset\\(\" --type=rust -B2 -A2\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 375\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there are any method calls on selector in the Service struct\nrg -n \"selector\\.\" modules/system/tenant_resolver/tenant_resolver-gw/src/domain/service.rs examples/plugin-modules/tenant_resolver/tenant_resolver-gw/src/domain/service.rs\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 394\n\n---\n\n\n\n</details>\n\n**Make `reset()` async to prevent concurrent repopulation of cleared cache.**\n\n`reset()` doesn't synchronize with `resolve_lock`, so a concurrent `get_or_init()` in its slow path can cache a stale value after `reset()` returns. Under concurrent use, `reset()` becomes non-deterministic and cannot reliably clear the cache.\n\nThe proposed fix is sound: make `reset()` async and acquire `resolve_lock` to serialize with in-flight resolutions. The only call site (test at line 147) is already in an async context, so making this change is straightforward.\n\n<details>\n<summary>🔧 Recommended fix: serialize reset with the resolve lock</summary>\n\n```diff\n-    pub fn reset(&self) -> bool {\n-        let mut guard = self.cached.write();\n-        guard.take().is_some()\n-    }\n+    pub async fn reset(&self) -> bool {\n+        let _resolve_guard = self.resolve_lock.lock().await;\n+        let mut guard = self.cached.write();\n+        guard.take().is_some()\n+    }\n```\n</details>\n\nThe test call site will need to `await` this change.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit/src/plugins/mod.rs` around lines 55 - 83, Make reset() async and\nserialize it with the resolve path by acquiring the same resolve_lock used in\nget_or_init(): change fn reset(&self) -> bool to async fn reset(&self) -> bool,\nawait self.resolve_lock.lock().await before taking the write lock on\nself.cached, perform guard.take().is_some(), and return the result; update the\ntest call site to await reset() so reset() cannot race with in-flight\nget_or_init() resolutions and reliably clears the cache.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-20T01:19:54Z","updated_at":"2026-01-20T01:19:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/278#discussion_r2706441639","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2706441639"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/278#discussion_r2706441639"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2706441639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":55,"original_start_line":55,"start_side":"RIGHT","line":84,"original_line":83,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":83,"position":84,"subject_type":"line"}],"source_reviews":[{"id":3679986438,"node_id":"PRR_kwDOPaLyBs7bWCMG","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit/src/plugins/mod.rs`:\n- Around line 55-83: Make reset() async and serialize it with the resolve path\nby acquiring the same resolve_lock used in get_or_init(): change fn reset(&self)\n-> bool to async fn reset(&self) -> bool, await self.resolve_lock.lock().await\nbefore taking the write lock on self.cached, perform guard.take().is_some(), and\nreturn the result; update the test call site to await reset() so reset() cannot\nrace with in-flight get_or_init() resolutions and reliably clears the cache.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>libs/modkit/src/client_hub.rs (1)</summary><blockquote>\n\n`370-387`: **Consider adding a type mismatch test case.**\n\nThe tests cover hit and miss scenarios well. For completeness, consider adding a test that verifies `try_get_scoped` returns `None` when a client is registered under one type but retrieved as another (the type mismatch path in line 233).\n\n\n<details>\n<summary>🧪 Optional test for type mismatch</summary>\n\n```rust\n#[test]\nfn try_get_scoped_returns_none_on_type_mismatch() {\n    let hub = ClientHub::new();\n    let scope = ClientScope::gts_id(\"gts.test\");\n    hub.register_scoped::<str>(scope.clone(), Arc::from(\"value\"));\n\n    // Try to retrieve as a different type\n    let got = hub.try_get_scoped::<i32>(&scope);\n    assert!(got.is_none());\n}\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/278#pullrequestreview-3679986438","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/278#pullrequestreview-3679986438"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/278"}},"submitted_at":"2026-01-20T01:19:55Z","commit_id":"a3a31e31700c502ccac78a788bc90fe06dfee735"}]},{"source_pr_number":277,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/277","source_state":"closed","source_author":"bit8shift","target_issue_number":null,"title":"[PR #277] feat(modkit): add CLI flags to dump effective per-module configuration","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/dump-config-file-cli","pr_head_sha":"c302c16e714d2f6d5a16407e919469a1780d1718","pr_base_ref":"main","pr_head_owner":"bit8shift","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277","id":3187144121,"node_id":"PR_kwDOPaLyBs699_W5","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/277","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/277.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/277.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/277","number":277,"state":"closed","locked":false,"title":"feat(modkit): add CLI flags to dump effective per-module configuration","user":{"login":"bit8shift","id":253408973,"node_id":"U_kgDODxq2zQ","avatar_url":"https://avatars.githubusercontent.com/u/253408973?v=4","gravatar_id":"","url":"https://api.github.com/users/bit8shift","html_url":"https://github.com/bit8shift","followers_url":"https://api.github.com/users/bit8shift/followers","following_url":"https://api.github.com/users/bit8shift/following{/other_user}","gists_url":"https://api.github.com/users/bit8shift/gists{/gist_id}","starred_url":"https://api.github.com/users/bit8shift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bit8shift/subscriptions","organizations_url":"https://api.github.com/users/bit8shift/orgs","repos_url":"https://api.github.com/users/bit8shift/repos","events_url":"https://api.github.com/users/bit8shift/events{/privacy}","received_events_url":"https://api.github.com/users/bit8shift/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Implements ADR requirement to expose module configuration inspection. \r\nAdds `--list-modules`, `--dump-modules-config-yaml`, and `--dump-modules-config-json` flags to hyperspot-server CLI. \r\nConfiguration includes runtime type, config sections, and database settings with redacted passwords.\r\n\r\n- Add list_module_names() to list all configured modules\r\n- Add render_effective_modules_config() to build config JSON structure\r\n- Add dump functions for YAML and JSON serialization\r\n- Add password redaction in DSN using ***REDACTED*** placeholder\r\n- Add 11 unit tests in modkit and 7 E2E tests in hyperspot-server\r\n- Add serde_yaml dependency for YAML serialization support\r\n\r\nSample output from the 3 commands\r\n`--list-modules`\r\n```\r\nConfigured modules (7):\r\n  - api_gateway\r\n  - contoso_tr_plugin\r\n  - fabrikam_tr_plugin\r\n  - grpc_hub\r\n  - module_orchestrator\r\n  - tenant_resolver_gateway\r\n  - users_info\r\n  ```\r\n\r\n`--dump-modules-config-yaml`\r\n```\r\napi_gateway:\r\n  config:\r\n    audience: api-gateway\r\n    auth_disabled: true\r\n    bind_addr: 127.0.0.1:8087\r\n    cors_enabled: false\r\n    defaults:\r\n      body_limit_bytes: 64000000\r\n      rate_limit:\r\n        burst: 200\r\n        in_flight: 64\r\n        rps: 1000\r\n    enable_docs: true\r\n    issuer: http://localhost:8080/realms/dev\r\n    jwks_uri: http://localhost:8080/realms/dev/protocol/openid-connect/certs\r\n    openapi:\r\n      description: HyperSpot Server API Documentation\r\n      title: HyperSpot API\r\n      version: 0.1.0\r\n    require_auth_by_default: true\r\ncontoso_tr_plugin:\r\n  config: {}\r\nfabrikam_tr_plugin:\r\n  config:\r\n    priority: 20\r\n    tenants:\r\n    - id: '00000000000000000000000000000001'\r\n      is_accessible_by_parent: true\r\n      status: ACTIVE\r\n    - id: '00000000000000000000000000000010'\r\n      is_accessible_by_parent: true\r\n      parent_id: '00000000000000000000000000000001'\r\n      status: ACTIVE\r\n    - id: '00000000000000000000000000000011'\r\n      is_accessible_by_parent: true\r\n      parent_id: '00000000000000000000000000000001'\r\n      status: ACTIVE\r\n    - id: '00000000000000000000000000000100'\r\n      is_accessible_by_parent: true\r\n      parent_id: '00000000000000000000000000000010'\r\n      status: ACTIVE\r\n    - id: '00000000000000000000000000000101'\r\n      is_accessible_by_parent: false\r\n      parent_id: '00000000000000000000000000000010'\r\n      status: SOFT_DELETED\r\n    - id: '00000000000000000000000000000110'\r\n      is_accessible_by_parent: true\r\n      parent_id: '00000000000000000000000000000011'\r\n      status: ACTIVE\r\n    vendor: Fabrikam\r\ngrpc_hub:\r\n  config:\r\n    listen_addr: uds:///tmp/hyperspot-grpc\r\nmodule_orchestrator:\r\n  config: {}\r\ntenant_resolver_gateway:\r\n  config:\r\n    vendor: Fabrikam\r\nusers_info:\r\n  config:\r\n    default_page_size: 5\r\n    max_page_size: 100\r\n  database:\r\n    dsn: sqlite:///root/.hyperspot/users_info/users_info.db\r\n    pool:\r\n      acquire_timeout: 30s\r\n      max_conns: 5\r\n```\r\n\r\n`--dump-modules-config-json`\r\n```\r\n{\r\n  \"api_gateway\": {\r\n    \"config\": {\r\n      \"audience\": \"api-gateway\",\r\n      \"auth_disabled\": true,\r\n      \"bind_addr\": \"127.0.0.1:8087\",\r\n      \"cors_enabled\": false,\r\n      \"defaults\": {\r\n        \"body_limit_bytes\": 64000000,\r\n        \"rate_limit\": {\r\n          \"burst\": 200,\r\n          \"in_flight\": 64,\r\n          \"rps\": 1000\r\n        }\r\n      },\r\n      \"enable_docs\": true,\r\n      \"issuer\": \"http://localhost:8080/realms/dev\",\r\n      \"jwks_uri\": \"http://localhost:8080/realms/dev/protocol/openid-connect/certs\",\r\n      \"openapi\": {\r\n        \"description\": \"HyperSpot Server API Documentation\",\r\n        \"title\": \"HyperSpot API\",\r\n        \"version\": \"0.1.0\"\r\n      },\r\n      \"require_auth_by_default\": true\r\n    }\r\n  },\r\n  \"contoso_tr_plugin\": {\r\n    \"config\": {}\r\n  },\r\n  \"fabrikam_tr_plugin\": {\r\n    \"config\": {\r\n      \"priority\": 20,\r\n      \"tenants\": [\r\n        {\r\n          \"id\": \"00000000000000000000000000000001\",\r\n          \"is_accessible_by_parent\": true,\r\n          \"status\": \"ACTIVE\"\r\n        },\r\n        {\r\n          \"id\": \"00000000000000000000000000000010\",\r\n          \"is_accessible_by_parent\": true,\r\n          \"parent_id\": \"00000000000000000000000000000001\",\r\n          \"status\": \"ACTIVE\"\r\n        },\r\n        {\r\n          \"id\": \"00000000000000000000000000000011\",\r\n          \"is_accessible_by_parent\": true,\r\n          \"parent_id\": \"00000000000000000000000000000001\",\r\n          \"status\": \"ACTIVE\"\r\n        },\r\n        {\r\n          \"id\": \"00000000000000000000000000000100\",\r\n          \"is_accessible_by_parent\": true,\r\n          \"parent_id\": \"00000000000000000000000000000010\",\r\n          \"status\": \"ACTIVE\"\r\n        },\r\n        {\r\n          \"id\": \"00000000000000000000000000000101\",\r\n          \"is_accessible_by_parent\": false,\r\n          \"parent_id\": \"00000000000000000000000000000010\",\r\n          \"status\": \"SOFT_DELETED\"\r\n        },\r\n        {\r\n          \"id\": \"00000000000000000000000000000110\",\r\n          \"is_accessible_by_parent\": true,\r\n          \"parent_id\": \"00000000000000000000000000000011\",\r\n          \"status\": \"ACTIVE\"\r\n        }\r\n      ],\r\n      \"vendor\": \"Fabrikam\"\r\n    }\r\n  },\r\n  \"grpc_hub\": {\r\n    \"config\": {\r\n      \"listen_addr\": \"uds:///tmp/hyperspot-grpc\"\r\n    }\r\n  },\r\n  \"module_orchestrator\": {\r\n    \"config\": {}\r\n  },\r\n  \"tenant_resolver_gateway\": {\r\n    \"config\": {\r\n      \"vendor\": \"Fabrikam\"\r\n    }\r\n  },\r\n  \"users_info\": {\r\n    \"config\": {\r\n      \"default_page_size\": 5,\r\n      \"max_page_size\": 100\r\n    },\r\n    \"database\": {\r\n      \"dsn\": \"sqlite:///root/.hyperspot/users_info/users_info.db\",\r\n      \"pool\": {\r\n        \"acquire_timeout\": \"30s\",\r\n        \"max_conns\": 5\r\n      }\r\n    }\r\n  }\r\n}\r\n```\r\n\r\nUpdates:\r\n- `--mock` override fix - Applied before all dump commands\r\n- `dry_run` implementation - Prevents directory creation during read-only inspection\r\n- Lenient error handling - Warns and continues for failed modules, shows partial results\r\n- 3 new E2E tests - Verifying --mock works with all dump commands\r\n\r\nCloses #206\r\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * CLI flags to list modules and dump effective module configs (YAML/JSON); outputs redact DB passwords and honor a dry-run mode that avoids filesystem mutations. Added --mock override for inspection/testing.\n\n* **Documentation**\n  * Renamed directory client API references for clarity in docs and examples.\n\n* **Tests**\n  * Extensive CLI tests for listing, dumps, redaction, mock behavior, config precedence, and output validation.\n\n* **Chores**\n  * Added YAML support dependency and updated CI workflow.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-19T10:08:06Z","updated_at":"2026-01-21T13:06:36Z","closed_at":"2026-01-21T13:06:36Z","merged_at":"2026-01-21T13:06:36Z","merge_commit_sha":"cf0449c56ed200afd35843bd462f2349eb9ea77a","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/277/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/277/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/c302c16e714d2f6d5a16407e919469a1780d1718","head":{"label":"bit8shift:feature/dump-config-file-cli","ref":"feature/dump-config-file-cli","sha":"c302c16e714d2f6d5a16407e919469a1780d1718","user":{"login":"bit8shift","id":253408973,"node_id":"U_kgDODxq2zQ","avatar_url":"https://avatars.githubusercontent.com/u/253408973?v=4","gravatar_id":"","url":"https://api.github.com/users/bit8shift","html_url":"https://github.com/bit8shift","followers_url":"https://api.github.com/users/bit8shift/followers","following_url":"https://api.github.com/users/bit8shift/following{/other_user}","gists_url":"https://api.github.com/users/bit8shift/gists{/gist_id}","starred_url":"https://api.github.com/users/bit8shift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bit8shift/subscriptions","organizations_url":"https://api.github.com/users/bit8shift/orgs","repos_url":"https://api.github.com/users/bit8shift/repos","events_url":"https://api.github.com/users/bit8shift/events{/privacy}","received_events_url":"https://api.github.com/users/bit8shift/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1130083757,"node_id":"R_kgDOQ1u1rQ","name":"cyberfabric-core","full_name":"bit8shift/cyberfabric-core","private":false,"owner":{"login":"bit8shift","id":253408973,"node_id":"U_kgDODxq2zQ","avatar_url":"https://avatars.githubusercontent.com/u/253408973?v=4","gravatar_id":"","url":"https://api.github.com/users/bit8shift","html_url":"https://github.com/bit8shift","followers_url":"https://api.github.com/users/bit8shift/followers","following_url":"https://api.github.com/users/bit8shift/following{/other_user}","gists_url":"https://api.github.com/users/bit8shift/gists{/gist_id}","starred_url":"https://api.github.com/users/bit8shift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bit8shift/subscriptions","organizations_url":"https://api.github.com/users/bit8shift/orgs","repos_url":"https://api.github.com/users/bit8shift/repos","events_url":"https://api.github.com/users/bit8shift/events{/privacy}","received_events_url":"https://api.github.com/users/bit8shift/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/bit8shift/cyberfabric-core","description":"All-in-one open-source services development platform with integrated LLMs manager, chat, benchmarks, and semantic search.","fork":true,"url":"https://api.github.com/repos/bit8shift/cyberfabric-core","forks_url":"https://api.github.com/repos/bit8shift/cyberfabric-core/forks","keys_url":"https://api.github.com/repos/bit8shift/cyberfabric-core
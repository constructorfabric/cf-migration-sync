ithub.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"use workspace version","created_at":"2025-12-30T14:00:24Z","updated_at":"2025-12-30T14:06:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653071426","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653071426"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653071426"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653071426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":18,"side":"RIGHT","author_association":"MEMBER","original_position":18,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653076681","pull_request_review_id":3618326748,"id":2653076681,"node_id":"PRRC_kwDOPaLyBs6eIrzJ","diff_hunk":"@@ -0,0 +1,235 @@\n+#![forbid(unsafe_code)]\n+\n+//! Serde support for the `humantime` crate.\n+//!\n+//! Based on [this fork](https://github.com/jean-airoldie/humantime-serde).\n+//!\n+//! Currently `std::time::Duration` is supported.\n+//!\n+//! # Example\n+//! ```\n+//! use serde::{Serialize, Deserialize};\n+//! use std::time::Duration;\n+//!\n+//! #[derive(Serialize, Deserialize)]\n+//! struct Foo {\n+//!     #[serde(with = \"modkit_utils::humantime_serde\")]\n+//!     timeout: Duration,\n+//! }\n+//! ```\n+\n+/// Reexport module.\n+pub mod re {","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"8e7f5ce72ca06aa4bbb95a769ac25b8e983d4a53","original_commit_id":"8e7f5ce72ca06aa4bbb95a769ac25b8e983d4a53","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not entirely sure if this is neccesary in our workspace. If you want to keep it, we can put it inside `lib.rs` (without re)","created_at":"2025-12-30T14:03:05Z","updated_at":"2025-12-30T14:06:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653076681","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653076681"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653076681"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653076681/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653080504","pull_request_review_id":3618326748,"id":2653080504,"node_id":"PRRC_kwDOPaLyBs6eIsu4","diff_hunk":"@@ -0,0 +1,235 @@\n+#![forbid(unsafe_code)]\n+\n+//! Serde support for the `humantime` crate.\n+//!\n+//! Based on [this fork](https://github.com/jean-airoldie/humantime-serde).\n+//!\n+//! Currently `std::time::Duration` is supported.\n+//!\n+//! # Example\n+//! ```\n+//! use serde::{Serialize, Deserialize};\n+//! use std::time::Duration;\n+//!\n+//! #[derive(Serialize, Deserialize)]\n+//! struct Foo {\n+//!     #[serde(with = \"modkit_utils::humantime_serde\")]\n+//!     timeout: Duration,\n+//! }\n+//! ```\n+\n+/// Reexport module.\n+pub mod re {\n+    pub use humantime;\n+}\n+\n+use std::fmt;\n+use std::time::Duration;\n+\n+use humantime;\n+use serde::{de, Deserializer, Serializer};\n+\n+/// Deserializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `deserialize_with` annotations.\n+/// # Errors\n+/// Returns a `humantime::Error` if string is not a valid Duration\n+pub fn deserialize<'a, D>(d: D) -> Result<Duration, D::Error>\n+where\n+    D: Deserializer<'a>,\n+{\n+    struct V;\n+\n+    impl de::Visitor<'_> for V {\n+        type Value = Duration;\n+\n+        fn expecting(&self, fmt: &mut fmt::Formatter) -> fmt::Result {\n+            fmt.write_str(\"a duration\")\n+        }\n+\n+        fn visit_str<E>(self, v: &str) -> Result<Duration, E>\n+        where\n+            E: de::Error,\n+        {\n+            humantime::parse_duration(v)\n+                .map_err(|_| E::invalid_value(de::Unexpected::Str(v), &self))\n+        }\n+    }\n+\n+    d.deserialize_str(V)\n+}\n+\n+/// Serializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `serialize_with` annotations.\n+/// # Errors\n+/// Returns a `humantime::Error` if string is not a valid Duration\n+pub fn serialize<S>(d: &Duration, s: S) -> Result<S::Ok, S::Error>\n+where\n+    S: Serializer,\n+{\n+    let duration_str = humantime::format_duration(*d).to_string();\n+    s.serialize_str(&duration_str)\n+}\n+\n+pub mod option {\n+    //! Convenience module to allow serialization via `humantime_serde` for `Option`\n+    //!\n+    //! # Example\n+    //!\n+    //! ```\n+    //! use serde::{Serialize, Deserialize};\n+    //! use std::time::Duration;\n+    //!\n+    //! #[derive(Serialize, Deserialize)]\n+    //! struct Foo {\n+    //!     #[serde(with = \"modkit_utils::humantime_serde::option\")]\n+    //!     timeout: Option<Duration>,\n+    //! }\n+    //! ```\n+\n+    use std::time::Duration;\n+\n+    use serde::{Deserialize, Deserializer, Serializer};\n+\n+    /// Serializes an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    /// # Errors\n+    /// Returns a `humantime::Error` if string is not a valid Duration\n+    pub fn serialize<S>(d: &Option<Duration>, s: S) -> Result<S::Ok, S::Error>\n+    where\n+        S: Serializer,\n+    {\n+        match d {\n+            Some(d) => super::serialize(d, s),\n+            None => s.serialize_none(),\n+        }\n+    }\n+\n+    /// Deserialize an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    /// # Errors\n+    /// Returns a `humantime::Error` if string is not a valid Duration\n+    pub fn deserialize<'a, D>(d: D) -> Result<Option<Duration>, D::Error>\n+    where\n+        D: Deserializer<'a>,\n+    {\n+        Option::deserialize(d).and_then(|opt: Option<String>| {\n+            opt.map(|s| humantime::parse_duration(&s).map_err(serde::de::Error::custom))\n+                .transpose()\n+        })\n+    }\n+}\n+\n+#[cfg(test)]\n+mod test {\n+    use super::*;","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"8e7f5ce72ca06aa4bbb95a769ac25b8e983d4a53","original_commit_id":"8e7f5ce72ca06aa4bbb95a769ac25b8e983d4a53","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"having this glob import and specifying later `super` in the tests it's confusing, for these tests it's better to explicitly mention super, as we are using modules or super module in serde ","created_at":"2025-12-30T14:05:09Z","updated_at":"2025-12-30T14:06:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2653080504","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":
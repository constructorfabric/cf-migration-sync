sult<SimpleUserSettings> {\n+        let user_id = ctx.subject_id();\n+        let tenant_id = ctx.tenant_id();\n+\n+        let active_model = entity::ActiveModel {\n+            tenant_id: ActiveValue::Set(tenant_id),\n+            user_id: ActiveValue::Set(user_id),\n+            theme: ActiveValue::Set(theme.clone()),\n+            language: ActiveValue::Set(language.clone()),\n+        };\n+\n+        SettingsEntity::insert(active_model)\n+            .on_conflict(\n+                OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n+                    .update_columns([entity::Column::Theme, entity::Column::Language])\n+                    .to_owned(),\n+            )\n+            .exec(self.db.conn())\n+            .await?;\n+\n+        let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n+        let model = self\n+            .db\n+            .find::<SettingsEntity>(&scope)\n+            .one(self.db.conn())\n+            .await?\n+            .ok_or_else(|| anyhow::anyhow!(\"Record should exist after upsert\"))?;\n+\n+        Ok(model.into())\n+    }\n+\n+    async fn upsert_patch(\n+        &self,\n+        ctx: &SecurityContext,\n+        patch: SimpleUserSettingsPatch,\n+    ) -> anyhow::Result<SimpleUserSettings> {\n+        let user_id = ctx.subject_id();\n+        let tenant_id = ctx.tenant_id();\n+        let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n+\n+        let existing = self\n+            .db\n+            .find::<SettingsEntity>(&scope)\n+            .one(self.db.conn())\n+            .await?;\n+\n+        let model = if let Some(existing) = existing {\n+            let mut columns_to_update = Vec::new();\n+            let mut active_model = entity::ActiveModel {\n+                tenant_id: ActiveValue::Set(tenant_id),\n+                user_id: ActiveValue::Set(user_id),\n+                theme: ActiveValue::Set(existing.theme.clone()),\n+                language: ActiveValue::Set(existing.language.clone()),\n+            };\n+\n+            if let Some(theme) = patch.theme {\n+                active_model.theme = ActiveValue::Set(Some(theme));\n+                columns_to_update.push(entity::Column::Theme);\n+            }\n+            if let Some(language) = patch.language {\n+                active_model.language = ActiveValue::Set(Some(language));\n+                columns_to_update.push(entity::Column::Language);\n+            }\n+\n+            if !columns_to_update.is_empty() {","path":"modules/simple-user-settings/simple-user-settings/src/infra/storage/sea_orm_repo.rs","commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","original_commit_id":"bff26a2e7fe973c3c03470f7f0ba719c518a0a5f","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If we are using upsert here why do we need check entity existence first? upsert_full() works w/o this check.\r\n","created_at":"2026-01-19T12:02:27Z","updated_at":"2026-01-19T12:12:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/223#discussion_r2704481715","pull_
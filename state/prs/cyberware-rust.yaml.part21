ruct Foo {\n+    //!     #[serde(with = \"modkit_utils::humantime_serde::option\")]\n+    //!     timeout: Option<Duration>,\n+    //! }\n+    //! ```\n+\n+    use std::time::Duration;\n+\n+    use serde::{Deserialize, Deserializer, Serializer};\n+\n+    /// Serializes an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `serialize_with` annotations.\n+    ///\n+    /// # Errors\n+    /// None\n+    pub fn serialize<S>(d: &Option<Duration>, s: S) -> Result<S::Ok, S::Error>\n+    where\n+        S: Serializer,\n+    {\n+        match d {\n+            Some(d) => super::serialize(d, s),\n+            None => s.serialize_none(),\n+        }\n+    }\n+\n+    /// Deserialize an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if the string is not a valid duration.\n+    pub fn deserialize<'a, D>(d: D) -> Result<Option<Duration>, D::Error>\n+    where\n+        D: Deserializer<'a>,\n+    {\n+        struct Wrapper(Duration);\n+\n+        impl<'de> Deserialize<'de> for Wrapper {\n+            fn deserialize<D>(d: D) -> Result<Self, D::Error>\n+            where\n+                D: Deserializer<'de>,\n+            {\n+                super::deserialize(d).map(Wrapper)\n+            }\n+        }\n+\n+        let v: Option<Wrapper> = Option::deserialize(d)?;\n+        Ok(v.map(|Wrapper(d)| d))\n+    }\n+}\n+\n+#[cfg(test)]\n+mod test {\n+    use serde::{Deserialize, Serialize};\n+\n+    #[test]\n+    fn with() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            time: super::Duration,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, super::Duration::from_secs(15));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+    }\n+\n+    #[test]\n+    fn with_option() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super::option\", default)]\n+            time: Option<super::Duration>,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, Some(super::Duration::from_secs(15)));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+\n+        let json = r#\"{\"time\": null}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":null}\"#);\n+\n+        let json = r\"{}\";\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+    }\n+\n+    #[test]\n+    fn time() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            duration: super::Duration,\n+        }\n+\n+        let json = r#\"{\"duration\": \"10m 10s\"}\"#;","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","original_commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, just checked locally, but the serialization converts the deserialized duration back to `10m 10s` with the space, FYI, that's how the humanize library works. We could strip all the spaces during serialization if we prefer the duration without spaces.","created_at":"2025-12-31T11:52:38Z","updated_at":"2025-12-31T11:52:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2655277608","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655277608"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2655277608"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655277608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":191,"original_line":191,"side":"RIGHT","in_reply_to_id":2655273128,"author_association":"MEMBER","original_position":191,"position":191,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655286578","pull_request_review_id":3620767616,"id":2655286578,"node_id":"PRRC_kwDOPaLyBs6eRHUy","diff_hunk":"@@ -0,0 +1,269 @@\n+#![forbid(unsafe_code)]\n+\n+//! Serde support for the `humantime` crate.\n+//!\n+//! Based on [this fork](https://github.com/jean-airoldie/humantime-serde).\n+//!\n+//! Currently `std::time::Duration` is supported.\n+//!\n+//! # Example\n+//! ```\n+//! use serde::{Serialize, Deserialize};\n+//! use std::time::Duration;\n+//!\n+//! #[derive(Serialize, Deserialize)]\n+//! struct Foo {\n+//!     #[serde(with = \"modkit_utils::humantime_serde\")]\n+//!     timeout: Duration,\n+//! }\n+//! ```\n+\n+use std::fmt;\n+use std::time::Duration;\n+\n+use humantime;\n+use serde::{de, Deserializer, Serializer};\n+\n+/// Deserializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `deserialize_with` annotations.\n+///\n+/// # Errors\n+///\n+/// Returns an error if the string is not a valid duration.\n+pub fn deserialize<'a, D>(d: D) -> Result<Duration, D::Error>\n+where\n+    D: Deserializer<'a>,\n+{\n+    struct V;\n+\n+    impl de::Visitor<'_> for V {\n+        type Value = Duration;\n+\n+        fn expecting(&self, fmt: &mut fmt::Formatter) -> fmt::Result {\n+            fmt.write_str(\"a duration\")\n+        }\n+\n+        fn visit_str<E>(self, v: &str) -> Result<Duration, E>\n+        where\n+            E: de::Error,\n+        {\n+            humantime::parse_duration(v)\n+                .map_err(|_| E::invalid_value(de::Unexpected::Str(v), &self))\n+        }\n+    }\n+\n+    d.deserialize_str(V)\n+}\n+\n+/// Serializes a `Duration` via the humantime crate.\n+///\n+/// This function can be used with `serde_derive`'s `with` and\n+/// `serialize_with` annotations.\n+///\n+/// # Errors\n+/// None\n+pub fn serialize<S>(d: &Duration, s: S) -> Result<S::Ok, S::Error>\n+where\n+    S: Serializer,\n+{\n+    s.collect_str(&humantime::format_duration(*d))\n+}\n+\n+pub mod option {\n+    //! Convenience module to allow serialization via `humantime_serde` for `Option`\n+    //!\n+    //! # Example\n+    //!\n+    //! ```\n+    //! use serde::{Serialize, Deserialize};\n+    //! use std::time::Duration;\n+    //!\n+    //! #[derive(Serialize, Deserialize)]\n+    //! struct Foo {\n+    //!     #[serde(with = \"modkit_utils::humantime_serde::option\")]\n+    //!     timeout: Option<Duration>,\n+    //! }\n+    //! ```\n+\n+    use std::time::Duration;\n+\n+    use serde::{Deserialize, Deserializer, Serializer};\n+\n+    /// Serializes an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `serialize_with` annotations.\n+    ///\n+    /// # Errors\n+    /// None\n+    pub fn serialize<S>(d: &Option<Duration>, s: S) -> Result<S::Ok, S::Error>\n+    where\n+        S: Serializer,\n+    {\n+        match d {\n+            Some(d) => super::serialize(d, s),\n+            None => s.serialize_none(),\n+        }\n+    }\n+\n+    /// Deserialize an `Option<Duration>`\n+    ///\n+    /// This function can be used with `serde_derive`'s `with` and\n+    /// `deserialize_with` annotations.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if the string is not a valid duration.\n+    pub fn deserialize<'a, D>(d: D) -> Result<Option<Duration>, D::Error>\n+    where\n+        D: Deserializer<'a>,\n+    {\n+        struct Wrapper(Duration);\n+\n+        impl<'de> Deserialize<'de> for Wrapper {\n+            fn deserialize<D>(d: D) -> Result<Self, D::Error>\n+            where\n+                D: Deserializer<'de>,\n+            {\n+                super::deserialize(d).map(Wrapper)\n+            }\n+        }\n+\n+        let v: Option<Wrapper> = Option::deserialize(d)?;\n+        Ok(v.map(|Wrapper(d)| d))\n+    }\n+}\n+\n+#[cfg(test)]\n+mod test {\n+    use serde::{Deserialize, Serialize};\n+\n+    #[test]\n+    fn with() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            time: super::Duration,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, super::Duration::from_secs(15));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+    }\n+\n+    #[test]\n+    fn with_option() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super::option\", default)]\n+            time: Option<super::Duration>,\n+        }\n+\n+        let json = r#\"{\"time\": \"15 seconds\"}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, Some(super::Duration::from_secs(15)));\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":\"15s\"}\"#);\n+\n+        let json = r#\"{\"time\": null}\"#;\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+        let reverse = serde_json::to_string(&foo).unwrap();\n+        assert_eq!(reverse, r#\"{\"time\":null}\"#);\n+\n+        let json = r\"{}\";\n+        let foo = serde_json::from_str::<Foo>(json).unwrap();\n+        assert_eq!(foo.time, None);\n+    }\n+\n+    #[test]\n+    fn time() {\n+        #[derive(Serialize, Deserialize)]\n+        struct Foo {\n+            #[serde(with = \"super\")]\n+            duration: super::Duration,\n+        }\n+\n+        let json = r#\"{\"duration\": \"10m 10s\"}\"#;","path":"libs/modkit-utils/src/humantime_serde.rs","commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","original_commit_id":"3a22c9781abe3b7612710cbc2288d7492f7e6689","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"There seems to be a [crate](https://docs.rs/iso8601-duration/latest/iso8601_duration/) we could use, but `10m10s` is not ISO-8601 compliant, it would be `PT10M10S` from what I've seen.","created_at":"2025-12-31T11:59:03Z","updated_at":"2025-12-31T11:59:04Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2655286578","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655286578"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/184#discussion_r2655286578"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/184"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655286578/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":191,"original_line":191,"side":"RIGHT","in_reply_to_id":2655273128,"author_association":"MEMBER","original_position":191,"position":191,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":183,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/183","source_state":"closed","source_author":"ziqwerty","target_issue_number":null,"title":"[PR #183] Add code coverage for nodes_registry module #49","status":"exp
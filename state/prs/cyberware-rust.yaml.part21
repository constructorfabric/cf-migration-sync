 authenticated user\")\n+        .tag(\"Settings\")\n+        .public()\n+        .handler(handlers::get_settings)\n+        .json_response_with_schema::<dto::SettingsDto>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Settings retrieved\",\n+        )\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    router = OperationBuilder::post(\"/settings/v1/settings\")\n+        .operation_id(\"settings.update_settings\")\n+        .summary(\"Update user settings\")\n+        .description(\"Full update of user settings (POST semantics)\")\n+        .tag(\"Settings\")\n+        .public()\n+        .json_request::<dto::UpdateSettingsRequest>(openapi, \"Settings update data\")\n+        .handler(handlers::update_settings)\n+        .json_response_with_schema::<dto::SettingsDto>(openapi, StatusCode::OK, \"Settings updated\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    router = OperationBuilder::patch(\"/settings/v1/settings\")\n+        .operation_id(\"settings.patch_settings\")\n+        .summary(\"Partially update user settings\")\n+        .description(\"Partial update of user settings (PATCH semantics)\")\n+        .tag(\"Settings\")\n+        .public()","path":"modules/settings/settings/src/api/rest/routes.rs","commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","original_commit_id":"cd3560d012515a729e477df3d0cf8578d976ff02","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/u
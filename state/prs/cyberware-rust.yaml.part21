ure\",\n+    // Database frameworks","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/src/lib.rs","commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"sqlx and sea_orm only, the others are not used","created_at":"2026-01-15T18:34:20Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695519678","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695519678"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695519678"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695519678/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":59,"side":"RIGHT","author_association":"MEMBER","original_position":59,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695522333","pull_request_review_id":3667011848,"id":2695522333,"node_id":"PRRC_kwDOPaLyBs6gqmgd","diff_hunk":"@@ -0,0 +1,149 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_domain_path;\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not import infrastructure dependencies.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should contain pure business logic and depend only on abstractions (ports),\n+    /// not concrete implementations. Importing infrastructure code (database, HTTP, external APIs)\n+    /// violates the Dependency Inversion Principle and makes domain logic harder to test.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust\n+    /// // Bad - infrastructure imports in domain\n+    /// mod domain {\n+    ///     use crate::infra::storage::UserRepository;  // ❌ concrete implementation\n+    ///     use sea_orm::*;  // ❌ database framework\n+    ///     use sqlx::*;     // ❌ database driver\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust\n+    /// // Good - domain depends on abstractions\n+    /// mod domain {\n+    ///     use std::sync::Arc;\n+    ///     \n+    ///     pub trait UsersRepository: Send + Sync {\n+    ///         async fn find_by_id(&self, id: Uuid) -> Result<User, DomainError>;\n+    ///     }\n+    ///     \n+    ///     pub struct Service {\n+    ///         repo: Arc<dyn UsersRepository>,  // ✅ trait object\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0301_NO_INFRA_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not import infrastructure dependencies (DE0301)\"\n+}\n+\n+/// Forbidden import patterns for domain layer\n+const INFRA_PATTERNS: &[&str] = &[\n+    // Infrastructure layer\n+    \"crate::infra\",\n+    \"crate::infrastructure\",\n+    // Database frameworks\n+    \"sea_orm\",\n+    \"sqlx\",\n+    \"diesel\",\n+    \"tokio_postgres\",\n+    \"rusqlite\",\n+    // HTTP/Web frameworks\n+    \"axum\",\n+    \"actix\",\n+    \"actix_web\",\n+    \"warp\",\n+    \"rocket\",\n+    \"hyper\",\n+    \"http::\",\n+    // API layer\n+    \"crate::api\",\n+    // External service clients  \n+    \"reqwest\",\n+    \"tonic\",\n+    // File system (should be abstracted)\n+    \"std::fs\",\n+    \"tokio::fs\",\n+];\n+\n+fn use_tree_to_string(tree: &UseTree) -> String {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            for (nested_tree, _) in items {\n+                let nested_str = use_tree_to_string(nested_tree);\n+                if !nested_str.is_empty() {\n+                    return format!(\"{}::{}\", prefix, nested_str);\n+                }\n+            }\n+            prefix\n+        }\n+    }\n+}\n+\n+fn check_use_in_domain(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    let path_str = use_tree_to_string(use_tree);\n+    for pattern in INFRA_PATTERNS {\n+        if path_str.contains(pattern) {","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/src/lib.rs","commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"contains or starts_with?","created_at":"2026-01-15T18:35:03Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695522333","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695522333"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695522333"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695522333/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":115,"side":"RIGHT","author_association":"MEMBER","original_position":115,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695524566","pull_request_review_id":3667011848,"id":2695524566,"node_id":"PRRC_kwDOPaLyBs6gqnDW","diff_hunk":"@@ -0,0 +1,133 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_domain_path;\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not reference HTTP types or status codes.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should be transport-agnostic. HTTP is just one possible\n+    /// transport layer. Referencing HTTP types in domain code couples the business\n+    /// logic to a specific transport mechanism.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - HTTP types in domain\n+    /// mod domain {\n+    ///     use http::StatusCode;\n+    ///     \n+    ///     pub fn check_result() -> StatusCode {\n+    ///         StatusCode::OK  // ❌ HTTP-specific\n+    ///     }\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - domain errors converted in API layer\n+    /// mod domain {\n+    ///     pub enum DomainResult {\n+    ///         Success,\n+    ///         NotFound,\n+    ///         InvalidData,\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0308_NO_HTTP_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not reference HTTP types or status codes (DE0308)\"\n+}\n+\n+/// HTTP-related patterns forbidden in domain code\n+const HTTP_PATTERNS: &[&str] = &[\n+    \"http::\",\n+    \"http::StatusCode\",\n+    \"http::Method\",\n+    \"http::HeaderMap\",\n+    \"http::Request\",\n+    \"http::Response\",\n+    \"axum::http\",\n+    \"hyper::StatusCode\",\n+    \"hyper::Method\",\n+    \"actix_web::http\",\n+    \"reqwest::StatusCode\",\n+];\n+\n+fn use_tree_to_string(tree: &UseTree) -> String {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            for (nested_tree, _) in items {\n+                let nested_str = use_tree_to_string(nested_tree);\n+                if !nested_str.is_empty() {\n+                    return format!(\"{}::{}\", prefix, nested_str);\n+                }\n+            }\n+            prefix\n+        }\n+    }\n+}\n+\n+fn check_use_in_domain(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    let path_str = use_tree_to_string(use_tree);\n+    for pattern in HTTP_PATTERNS {\n+        if path_str.contains(pattern) {","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs","commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"contains or starts_with?","created_at":"2026-01-15T18:35:50Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695524566","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695524566"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695524566"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695524566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":99,"side":"RIGHT","author_association":"MEMBER","original_position":99,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695529065","pull_request_review_id":3667011848,"id":2695529065,"node_id":"PRRC_kwDOPaLyBs6gqoJp","diff_hunk":"@@ -0,0 +1,56 @@\n+# DE0301: No Infrastructure in Domain\n+\n+### What it does\n+\n+Checks that domain modules do not import infrastructure dependencies.\n+\n+### Why is this bad?\n+\n+Domain modules should contain pure business logic and depend only on abstractions (ports), not concrete implementations:\n+- **Violates Dependency Inversion Principle**: Domain depends on low-level details\n+- **Harder to test**: Requires infrastructure setup for domain tests\n+- **Tight coupling**: Changes to infrastructure affect domain logic\n+- **Prevents portability**: Cannot easily swap infrastructure implementations\n+\n+### Example\n+\n+```rust\n+// ❌ Bad - infrastructure imports in domain\n+// File: src/domain/users.rs\n+use crate::infra::storage::UserRepository;  // concrete implementation\n+use sea_orm::*;  // database framework\n+use sqlx::*;     // database driver","path":"dylint_lints/de03_domain_layer/de0301_no_infra_in_domain/README.md","commit_id":"db886828e584356ee5ed658949981916611c663c","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"actually this lint will collide with the other that forbids specifically sqlx","created_at":"2026-01-15T18:37:30Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695529065","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695529065"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695529065"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695529065/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695530313","pull_request_review_id":3667011848,"id":2695530313,"node_id":"PRRC_kwDOPaLyBs6gqodJ","diff_hunk":"","path":"dylint_lints/de07_security/de0706_no_direct_sqlx/rust-toolchain","commit_id":"db886828e584356ee5ed658949981916611c663c","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"this file misses:\r\n[toolchain]\r\nchannel = \"nightly-2025-09-18\"\r\ncomponents = [\"llvm-tools-preview\", \"rustc-dev\"]","created_at":"2026-01-15T18:37:57Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695530313","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695530313"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695530313"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695530313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695533255","pull_request_review_id":3667011848,"id":2695533255,"node_id":"PRRC_kwDOPaLyBs6gqpLH","diff_hunk":"@@ -29,6 +29,23 @@ pub fn is_in_module_folder(source_map: &SourceMap, span: Span) -> bool {\n     check_span_path(source_map, span, \"/modules/\")\n }\n \n+/// Check if span is within libs/modkit-db/ - the internal sqlx wrapper library\n+/// This path is excluded from sqlx restrictions as it provides the abstraction layer\n+pub fn is_in_modkit_db_path(source_map: &SourceMap, span: Span) -> bool {\n+    // Try both with and without leading slash for compatibility\n+    check_span_path(source_map, span, \"/libs/modkit-db/\") \n+        || check_span_path(source_map, span, \"libs/modkit-db/\")\n+        || check_span_path(source_map, span, \"modkit-db/src/\")\n+}\n+\n+/// Check if span is within apps/hyperspot-server - the main server binary\n+/// This path is excluded from sqlx restrictions as it needs driver linkage workaround\n+pub fn is_in_hyperspot_server_path(source_map: &SourceMap, span: Span) -> bool {\n+    check_span_path(source_map, span, \"/apps/hyperspot-server/\") \n+        || check_span_path(source_map, span, \"apps/hyperspot-server/\")","path":"dylint_lints/lint_utils/src/lib.rs","commit_id":"db886828e584356ee5ed658949981916611c663c","original_commit_id":"bfa85efde9203c80a25c3ab58d5c97e06a97dab4","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why this \"or\" operations?","created_at":"2026-01-15T18:38:57Z","updated_at":"2026-01-15T18:39:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695533255","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695533255"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2695533255"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695533255/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":223,"original_line":45,"side":"RIGHT","author_association":"MEMBER","original_position":17,"position":46,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697533634","pull_request_review_id":3669602845,"id":2697533634,"node_id":"PRRC_kwDOPaLyBs6gyRjC","diff_hunk":"@@ -0,0 +1,133 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_domain_path;\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not reference HTTP types or status codes.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should be transport-agnostic. HTTP is just one possible\n+    /// transport layer. Referencing HTTP types in domain code couples the business\n+    /// logic to a specific transport mechanism.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - HTTP types in domain\n+    /// mod domain {\n+    ///     use http::StatusCode;\n+    ///     \n+    ///     pub fn check_result() -> StatusCode {\n+    ///         StatusCode::OK  // ❌ HTTP-specific\n+    ///     }\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - domain errors converted in API layer\n+    /// mod domain {\n+    ///     pub enum DomainResult {\n+    ///         Success,\n+    ///         NotFound,\n+    ///         InvalidData,\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0308_NO_HTTP_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not reference HTTP types or status codes (DE0308)\"\n+}\n+\n+/// HTTP-related patterns forbidden in domain code\n+/// Only includes frameworks actually used in the project: axum, hyper, http\n+const HTTP_PATTERNS: &[&str] = &[\n+    \"http::\",\n+    \"http::StatusCode\",\n+    \"http::Method\",\n+    \"http::HeaderMap\",\n+    \"http::Request\",\n+    \"http::Response\",\n+    \"axum::http\",\n+    \"hyper::StatusCode\",\n+    \"hyper::Method\",\n+    \"reqwest::StatusCode\",\n+];\n+\n+fn use_tree_to_string(tree: &UseTree) -> String {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            for (nested_tree, _) in items {\n+                let nested_str = use_tree_to_string(nested_tree);\n+                if !nested_str.is_empty() {\n+                    return format!(\"{}::{}\", prefix, nested_str);\n+                }\n+            }\n+            prefix\n+        }\n+    }\n+}\n+\n+fn check_use_in_domain(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    let path_str = use_tree_to_string(use_tree);\n+    for pattern in HTTP_PATTERNS {\n+        if path_str.starts_with(pattern) {\n+            cx.span_lint(DE0308_NO_HTTP_IN_DOMAIN, item.span, |diag| {\n+                diag.primary_message(\n+                    \"domain module imports HTTP type (DE0308)\"\n+                );\n+                diag.help(\"domain should be transport-agnostic; handle HTTP in api/ layer\");\n+            });\n+            break;\n+        }\n+    }\n+}","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs","commit_id":"322f1c99efd6b6cc2bbe6eec1887672150fe8916","original_commit_id":"322f1c99efd6b6cc2bbe6eec1887672150fe8916","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Handle all nested `use` items to avoid false negatives.**\n\n`use_tree_to_string` returns only the first nested path, so `use crate::{Foo, http::StatusCode};` (or any later nested HTTP import) won’t be detected. This makes the lint miss violations. Consider returning all nested paths (or recursively matching) and checking each.\n\n\n<details>\n<summary>🔧 Proposed fix (collect all paths and scan each)</summary>\n\n```diff\n-fn use_tree_to_string(tree: &UseTree) -> String {\n+fn use_tree_to_strings(tree: &UseTree) -> Vec<String> {\n     match &tree.kind {\n         UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n-            tree.prefix.segments.iter()\n+            vec![tree.prefix.segments.iter()\n                 .map(|seg| seg.ident.name.as_str())\n                 .collect::<Vec<_>>()\n-                .join(\"::\")\n+                .join(\"::\")]\n         }\n         UseTreeKind::Nested { items, .. } => {\n             let prefix = tree.prefix.segments.iter()\n                 .map(|seg| seg.ident.name.as_str())\n                 .collect::<Vec<_>>()\n                 .join(\"::\");\n-            \n-            for (nested_tree, _) in items {\n-                let nested_str = use_tree_to_string(nested_tree);\n-                if !nested_str.is_empty() {\n-                    return format!(\"{}::{}\", prefix, nested_str);\n-                }\n-            }\n-            prefix\n+            let mut paths = Vec::new();\n+            for (nested_tree, _) in items {\n+                for nested_str in use_tree_to_strings(nested_tree) {\n+                    if nested_str.is_empty() {\n+                        paths.push(prefix.clone());\n+                    } else {\n+                        paths.push(format!(\"{}::{}\", prefix, nested_str));\n+                    }\n+                }\n+            }\n+            if paths.is_empty() { vec![prefix] } else { paths }\n         }\n     }\n }\n \n fn check_use_in_domain(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n     let ItemKind::Use(use_tree) = &item.kind else {\n         return;\n     };\n \n-    let path_str = use_tree_to_string(use_tree);\n-    for pattern in HTTP_PATTERNS {\n-        if path_str.starts_with(pattern) {\n-            cx.span_lint(DE0308_NO_HTTP_IN_DOMAIN, item.span, |diag| {\n-                diag.primary_message(\n-                    \"domain module imports HTTP type (DE0308)\"\n-                );\n-                diag.help(\"domain should be transport-agnostic; handle HTTP in api/ layer\");\n-            });\n-            break;\n-        }\n-    }\n+    for path_str in use_tree_to_strings(use_tree) {\n+        for pattern in HTTP_PATTERNS {\n+            if path_str.starts_with(pattern) {\n+                cx.span_lint(DE0308_NO_HTTP_IN_DOMAIN, item.span, |diag| {\n+                    diag.primary_message(\n+                        \"domain module imports HTTP type (DE0308)\"\n+                    );\n+                    diag.help(\"domain should be transport-agnostic; handle HTTP in api/ layer\");\n+                });\n+                return;\n+            }\n+        }\n+    }\n }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs` around\nlines 67 - 109, use_tree_to_string currently returns only the first nested path\ncausing missed HTTP imports; change it to collect and return all possible import\npath strings (e.g., Vec<String>) by recursively traversing UseTreeKind::Nested\nand concatenating prefix with every nested result, then update\ncheck_use_in_domain to iterate over all returned paths and check each against\nHTTP_PATTERNS and emit DE0308_NO_HTTP_IN_DOMAIN when any match is found;\nreference functions use_tree_to_string and check_use_in_domain and constants\nHTTP_PATTERNS and DE0308_NO_HTTP_IN_DOMAIN to locate where to change the return\ntype and the scan logic.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 7a6c64a","created_at":"2026-01-16T08:50:08Z","updated_at":"2026-01-16T09:23:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2697533634","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697533634"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2697533634"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697533634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":67,"start_side":"RIGHT","line":null,"original_line":109,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":109,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697671532","pull_request_review_id":3669778193,"id":2697671532,"node_id":"PRRC_kwDOPaLyBs6gyzNs","diff_hunk":"@@ -0,0 +1,138 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_domain_path;\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not reference HTTP types or status codes.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should be transport-agnostic. HTTP is just one possible\n+    /// transport layer. Referencing HTTP types in domain code couples the business\n+    /// logic to a specific transport mechanism.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - HTTP types in domain\n+    /// mod domain {\n+    ///     use http::StatusCode;\n+    ///     \n+    ///     pub fn check_result() -> StatusCode {\n+    ///         StatusCode::OK  // ❌ HTTP-specific\n+    ///     }\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - domain errors converted in API layer\n+    /// mod domain {\n+    ///     pub enum DomainResult {\n+    ///         Success,\n+    ///         NotFound,\n+    ///         InvalidData,\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0308_NO_HTTP_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not reference HTTP types or status codes (DE0308)\"\n+}\n+\n+/// HTTP-related patterns forbidden in domain code\n+/// Only includes frameworks actually used in the project: axum, hyper, http\n+const HTTP_PATTERNS: &[&str] = &[\n+    \"http::\",\n+    \"http::StatusCode\",\n+    \"http::Method\",\n+    \"http::HeaderMap\",\n+    \"http::Request\",\n+    \"http::Response\",\n+    \"axum::http\",\n+    \"hyper::StatusCode\",\n+    \"hyper::Method\",\n+    \"reqwest::StatusCode\",\n+];\n+\n+fn use_tree_to_strings(tree: &UseTree) -> Vec<String> {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            vec![tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")]\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            let mut paths = Vec::new();\n+            for (nested_tree, _) in items {\n+                for nested_str in use_tree_to_strings(nested_tree) {\n+                    if nested_str.is_empty() {\n+                        paths.push(prefix.clone());\n+                    } else {\n+                        paths.push(format!(\"{}::{}\", prefix, nested_str));\n+                    }","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs","commit_id":"544c3d0d3f498a5f1023874578df5ab762f78cc1","original_commit_id":"7a6c64a8fea5869215f188fe8986c3dc001ea1ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Normalize empty prefixes in nested `use` trees to avoid false negatives.**\n\nFor `use {http::StatusCode, ...};`, `prefix` is empty and the current join yields `::http::StatusCode`, which won't match `starts_with(\"http::\")`. Handle empty prefixes explicitly to avoid missed violations.\n\n\n\n<details>\n<summary>🩹 Proposed fix</summary>\n\n```diff\n-                    if nested_str.is_empty() {\n-                        paths.push(prefix.clone());\n-                    } else {\n-                        paths.push(format!(\"{}::{}\", prefix, nested_str));\n-                    }\n+                    if nested_str.is_empty() {\n+                        paths.push(prefix.clone());\n+                    } else if prefix.is_empty() {\n+                        paths.push(nested_str);\n+                    } else {\n+                        paths.push(format!(\"{}::{}\", prefix, nested_str));\n+                    }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs` around\nlines 75 - 88, The code in UseTreeKind::Nested builds paths with a leading \"::\"\nwhen prefix is empty, causing strings like \"::http::StatusCode\" to miss\nstarts_with(\"http::\") checks; update the loop in UseTreeKind::Nested (the block\nthat computes prefix and pushes into paths in use_tree_to_strings) to explicitly\nhandle empty prefix: if nested_str.is_empty() push prefix.clone(); else if\nprefix.is_empty() push nested_str.clone(); otherwise push format!(\"{}::{}\",\nprefix, nested_str) so no leading :: is produced and empty-prefix cases are\nnormalized.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits 809df75 to 542cfcc","created_at":"2026-01-16T09:28:05Z","updated_at":"2026-01-16T11:25:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2697671532","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697671532"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/253#discussion_r2697671532"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/253"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2697671532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":75,"start_side":"RIGHT","line":null,"original_line":88,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":88,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698188338","pull_request_review_id":3670476855,"id":2698188338,"node_id":"PRRC_kwDOPaLyBs6g0xYy","diff_hunk":"@@ -0,0 +1,206 @@\n+#![feature(rustc_private)]\n+#![warn(unused_extern_crates)]\n+\n+extern crate rustc_ast;\n+\n+use rustc_ast::{Item, ItemKind, UseTree, UseTreeKind, Ty, TyKind};\n+use rustc_lint::{EarlyLintPass, LintContext};\n+\n+use lint_utils::is_in_domain_path;\n+\n+dylint_linting::declare_early_lint! {\n+    /// ### What it does\n+    ///\n+    /// Checks that domain modules do not reference HTTP types or status codes.\n+    ///\n+    /// ### Why is this bad?\n+    ///\n+    /// Domain modules should be transport-agnostic. HTTP is just one possible\n+    /// transport layer. Referencing HTTP types in domain code couples the business\n+    /// logic to a specific transport mechanism.\n+    ///\n+    /// ### Example\n+    ///\n+    /// ```rust,ignore\n+    /// // Bad - HTTP types in domain\n+    /// mod domain {\n+    ///     use http::StatusCode;\n+    ///     \n+    ///     pub fn check_result() -> StatusCode {\n+    ///         StatusCode::OK  // ❌ HTTP-specific\n+    ///     }\n+    /// }\n+    /// ```\n+    ///\n+    /// Use instead:\n+    ///\n+    /// ```rust,ignore\n+    /// // Good - domain errors converted in API layer\n+    /// mod domain {\n+    ///     pub enum DomainResult {\n+    ///         Success,\n+    ///         NotFound,\n+    ///         InvalidData,\n+    ///     }\n+    /// }\n+    /// ```\n+    pub DE0308_NO_HTTP_IN_DOMAIN,\n+    Deny,\n+    \"domain modules should not reference HTTP types or status codes (DE0308)\"\n+}\n+\n+/// HTTP-related patterns forbidden in domain code\n+/// Only includes frameworks actually used in the project: axum, hyper, http\n+const HTTP_PATTERNS: &[&str] = &[\n+    \"http::\",\n+    \"http::StatusCode\",\n+    \"http::Method\",\n+    \"http::HeaderMap\",\n+    \"http::Request\",\n+    \"http::Response\",\n+    \"axum::http\",\n+    \"hyper::StatusCode\",\n+    \"hyper::Method\",\n+    \"reqwest::StatusCode\",\n+];\n+\n+fn use_tree_to_strings(tree: &UseTree) -> Vec<String> {\n+    match &tree.kind {\n+        UseTreeKind::Simple(..) | UseTreeKind::Glob => {\n+            vec![tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\")]\n+        }\n+        UseTreeKind::Nested { items, .. } => {\n+            let prefix = tree.prefix.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            \n+            let mut paths = Vec::new();\n+            for (nested_tree, _) in items {\n+                for nested_str in use_tree_to_strings(nested_tree) {\n+                    if nested_str.is_empty() {\n+                        paths.push(prefix.clone());\n+                    } else if prefix.is_empty() {\n+                        paths.push(nested_str);\n+                    } else {\n+                        paths.push(format!(\"{}::{}\", prefix, nested_str));\n+                    }\n+                }\n+            }\n+            if paths.is_empty() { vec![prefix] } else { paths }\n+        }\n+    }\n+}\n+\n+fn check_use_in_domain(cx: &rustc_lint::EarlyContext<'_>, item: &Item) {\n+    let ItemKind::Use(use_tree) = &item.kind else {\n+        return;\n+    };\n+\n+    for path_str in use_tree_to_strings(use_tree) {\n+        for pattern in HTTP_PATTERNS {\n+            if path_str.starts_with(pattern) {\n+                cx.span_lint(DE0308_NO_HTTP_IN_DOMAIN, item.span, |diag| {\n+                    diag.primary_message(\n+                        \"domain module imports HTTP type (DE0308)\"\n+                    );\n+                    diag.help(\"domain should be transport-agnostic; handle HTTP in api/ layer\");\n+                });\n+                return;\n+            }\n+        }\n+    }\n+}\n+\n+fn type_to_string(ty: &Ty) -> Option<String> {\n+    match &ty.kind {\n+        TyKind::Path(_, path) => {\n+            let path_str = path.segments.iter()\n+                .map(|seg| seg.ident.name.as_str())\n+                .collect::<Vec<_>>()\n+                .join(\"::\");\n+            Some(path_str)\n+        }\n+        _ => None,\n+    }\n+}\n+\n+fn check_type_in_domain(cx: &rustc_lint::EarlyContext<'_>, ty: &Ty) {\n+    if let Some(type_path) = type_to_string(ty) {\n+        for pattern in HTTP_PATTERNS {\n+            if type_path.starts_with(pattern) {\n+                cx.span_lint(DE0308_NO_HTTP_IN_DOMAIN, ty.span, |diag| {\n+                    diag.primary_message(\n+                        format!(\"domain module uses HTTP type `{}` (DE0308)\", type_path)\n+                    );\n+                    diag.help(\"domain should be transport-agnostic; handle HTTP in api/ layer\");\n+                });\n+                return;\n+            }\n+        }\n+    }\n+}","path":"dylint_lints/de03_domain_layer/de0308_no_http_in_domain/src/lib.rs","commit_id":"542cfcc53fad8a56282ebf7b644132720052e188","original_commit_id":"542cfcc53fad8a56282ebf7b644132720052e188","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, let's examine the full implementation of the lint file\nfd \"de0308_no_http_in_domain\" -t d\n```\n\nRepository: hypernetix/hyperspo
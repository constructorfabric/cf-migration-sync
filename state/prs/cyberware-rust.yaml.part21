l":"https://github.com/cyberfabric/cyberware-rust.git","svn_url":"https://github.com/cyberfabric/cyberware-rust","homepage":"https://www.cyberfabric.org","size":28496,"stargazers_count":32,"watchers_count":32,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":19,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":263,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["account-management","agentic-ai","ai","benchmarks","cloud","genai","llm","microservices","middleware","modkit","multi-tenancy","multi-tier","rust","saas","security","serverless","xaas"],"visibility":"private","forks":19,"open_issues":263,"watchers":32,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/189"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/189/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/1968d9f2fea9e55895540f42ed283585e6b8a647"}},"author_association":"MEMBER","auto_merge":null,"assignee":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"active_lock_reason":null},"source_issue_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3708615347","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#issuecomment-3708615347","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/189","id":3708615347,"node_id":"IC_kwDOPaLyBs7dDPqz","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T00:59:24Z","updated_at":"2026-01-05T00:59:24Z","body":"Finally good set of documents. Only one common comment.\r\n\r\nWe are mixing \"strong guarantees\" language: \"MUST\", \"can not be bypassed\", \"single public entry point\" with “target architecture” disclaimers. Probbly we should select one style per section:\r\n\r\n- if it's current behavior, cite code and avoid overpromising\r\n- if it's target, keep MUSTs but tag everything with status markers and don't call it \"actual\"\r\n\r\nRight now it oscillates, which is where contradictions are born.\r\n\r\nProbably we need to discuss it verbally.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3708615347/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657954854","pull_request_review_id":3623402238,"id":2657954854,"node_id":"PRRC_kwDOPaLyBs6ebSwm","diff_hunk":"@@ -198,51 +225,91 @@ HyperSpot uses a **monorepo** approach with multiple crates:\n ```\n hyperspot/\n ├── apps/              # Executable applications (hyperspot-server)\n+├── config/            # Configuration files\n+├── docs/              # Architecture and development guides\n+├── dylint_lints/      # Project-specific lints (see `make dylint`)\n+├── examples/          # Example modules and usage patterns\n+├── guidelines/        # Coding standards and best practices for LLMs\n ├── libs/              # Shared libraries (modkit, modkit-db, modkit-auth, etc.)\n ├── modules/           # Business logic modules (api_ingress, directory_service, etc.)\n-├── examples/          # Example modules and usage patterns\n-├── testing/           # E2E and integration tests\n-├── docs/              # Architecture and development guides\n-├── guidelines/        # Coding standards and best practices\n-└── config/            # Configuration files\n+├── scripts/           # Custom scripts for build, testing, etc.\n+└── testing/           # E2E and integration tests (pytest)\n ```\n \n ### 5.2. External Integration\n \n-The 'main' crates can be located in separate repositories and use HyperSpot modules as dependencies via Cargo. This allows:\n-- Custom applications built on HyperSpot\n-- Private modules not in the main repo\n-- Vendor-specific extensions\n+ The 'main' crates can be located in separate repositories and use HyperSpot modules as dependencies via Cargo. This allows:\n+ - Custom applications built on HyperSpot by choosing only needed modules\n+ - Private modules not in the main repo\n+ - Vendor-specific extensions (modules, plugins, adapters)\n \n ### 5.3. Module Layout (DDD-Light)\n \n-Every module follows a **Domain-Driven Design (DDD-light)** structure:\n+ Every module follows a **Domain-Driven Design (DDD-light)** structure:\n \n ```\n modules/<module-name>/\n+├── Cargo.toml\n ├── src/\n-│   ├── lib.rs           # Public exports\n-│   ├── module.rs        # Module declaration and traits\n-│   ├── config.rs        # Typed configuration\n-│   ├── api/             # Transport adapters (REST, gRPC)\n-│   │   └── rest/        # HTTP handlers, DTOs, routes\n-│   ├── contract/        # Public API for other modules\n-│   │   ├── client.rs    # ClientHub traits\n-│   │   ├── model.rs     # Transport-agnostic models\n-│   │   └── error.rs     # Domain errors\n-│   ├── domain/          # Business logic\n-│   │   ├── service.rs   # Orchestration and rules\n-│   │   └── events.rs    # Domain events\n-│   └── infra/           # Infrastructure (database, external APIs)\n-│       └── storage/     # Database entities and repositories\n-└── Cargo.toml\n+│   ├── lib.rs                        # Public exports\n+│   ├── module.rs                     # Module struct + #[modkit::module(...)] (some modules keep this in lib.rs)\n+│   ├── config.rs                     # Typed module config\n+│   ├── local_client.rs               # Local adapter implementing an SDK API trait (optional)\n+│   ├── api/\n+│   │   └── rest/\n+│   │       ├── dto.rs                # REST-only DTOs (serde + ToSchema)\n+│   │       ├── handlers.rs           # Thin HTTP handlers\n+│   │       ├── routes.rs             # Route + OpenAPI registration (OperationBuilder)\n+│   │       ├── error.rs              # DomainError -> Problem mapping\n+│   │       └── mappers.rs            # DTO <-> domain mapping\n+│   ├── domain/                       # Business logic\n+│   └── infra/                        # Infrastructure adapters (optional)\n+├── tests/                            # Optional\n+└── (optional extras: gts/, openspec/, build.rs, etc.)\n+\n+# SDK pattern (used by e.g. `modules/types-registry/` and `examples/modkit/users_info/`)\n+modules/<module-dir>/\n+├── <module-name>-sdk/\n+│   ├── Cargo.toml\n+│   └── src/\n+│       ├── lib.rs                    # Re-exports\n+│       ├── api.rs                    # ClientHub API trait (methods take &SecurityCtx)\n+│       ├── models.rs                 # Transport-agnostic models (no serde)","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe it's worth mentioning optional proto/ and wiring.rs (also optional) for OOP modules via gRPC, as this seems to be the only transport-specific part of sdk crate","created_at":"2026-01-02T15:56:16Z","updated_at":"2026-01-02T19:45:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2657954854","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657954854"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2657954854"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657954854/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":276,"original_line":277,"side":"RIGHT","author_association":"MEMBER","original_position":261,"position":264,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659788942","pull_request_review_id":3625087578,"id":2659788942,"node_id":"PRRC_kwDOPaLyBs6eiSiO","diff_hunk":"@@ -195,9 +87,15 @@ server:\n \n # Database configuration\n database:\n-  url: \"sqlite://database/database.db\"","path":"README.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why is it deleted?","created_at":"2026-01-04T16:47:30Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659788942","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659788942"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659788942"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659788942/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":198,"original_line":198,"side":"LEFT","author_association":"MEMBER","original_position":190,"position":161,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659790468","pull_request_review_id":3625087578,"id":2659790468,"node_id":"PRRC_kwDOPaLyBs6eiS6E","diff_hunk":"@@ -239,144 +147,45 @@ cargo test -p modkit\n \n # Integration tests with database\n cargo test --test integration\n+\n+# Unit tests code coverage\n+make coverage-unit\n ```\n \n ### CI / Development Commands\n \n-HyperSpot uses a unified, cross-platform Python CI script. Ensure you have Python 3.9+ installed.","path":"README.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The Python-based option works on Windows. If we rely only on a Makefile, we need to add a prerequisite that make (via MinGW or Cygwin) must be installed","created_at":"2026-01-04T16:49:38Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659790468","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659790468"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659790468"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659790468/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":246,"original_line":246,"side":"LEFT","author_association":"MEMBER","original_position":250,"position":222,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891236","pull_request_review_id":3625087578,"id":2659891236,"node_id":"PRRC_kwDOPaLyBs6eirgk","diff_hunk":"@@ -15,39 +17,97 @@ HyperSpot is a **modular, high-performance AI services platform** built in Rust.\n - **Universal Deployment**: Single codebase runs on cloud, on-prem Windows/Linux workstation, or mobile\n - **Developer Friendly**: AI-assisted code generation, automatic OpenAPI docs, DDD-light structure, and type-safe APIs\n \n+## Non-goals\n+\n+1. HyperSpot doesn't optimize for **minimalism** or the lowest barrier to entry\n+\n+HyperSpot does not aim to be the simplest or smallest framework for building SaaS or AI applications. It intentionally prioritizes explicit structure, governance, composability, and long-term evolvability over quick-start simplicity or minimal configuration.\n+\n+2. HyperSpot doesn't Provide a **rich catalog of end-user services** out of the box\n+\n+HyperSpot does not aim to ship a comprehensive set of ready-made, end-user SaaS services (e.g. CRM, ticketing, billing products) as part of its core. Its primary focus is the foundational layer—runtime, control plane, GenAI capabilities, workflows, and extensibility—on top of which vendors and product teams build their own complete SaaS offerings.\n+\n+3. HyperSpot doesn't attempt to replace **cloud infrastructure or PaaS layers**\n+\n+HyperSpot is not a replacement for cloud providers or infrastructure platforms such as AWS, Azure, GCP, or on-prem orchestration stacks. It does not offer physical infrastructure, networking, container orchestration, or low-level resource scheduling. Instead, HyperSpot intentionally positions itself above IaaS/PaaS and below vendor-developed SaaS, focusing on application-level services, governance, and GenAI enablement.\n+\n+## Why Rust and why Monorepo?\n+\n+Rust and a monorepo are intentional choices to optimize **recurring engineering work**,especially the feedback loop required for safe and high-throughput **LLM-assisted development**. The goal is to maximize how quickly generated code can be validated (build, lint, test, run, debug) *before* it is committed.\n+\n+### Why Rust (recurring benefits)\n+\n+- **Compile-time safety for memory and concurrency**.\n+  Rust's ownership model prevents data races and memory safety issues by construction. It removes entire categories of runtime failures (null pointer dereference, use-after-free, iterator invalidation) by design—critical for a multi-tenant platform handling concurrent requests.\n+\n+- **Faster debugging of complex, cross-cutting scenarios (human + LLM)**.\n+  Strong typing, structured errors, and deterministic build artifacts make failures easier to localize. This improves troubleshooting for complex, multi-module behaviors and makes it easier for LLMs to propose minimal, correct fixes based on compiler diagnostics, test failures, and traces.\n+\n+- **Deep static analysis as a platform feature**.\n+  Rust's compiler and tooling ecosystem enable strong static inspection (AST/HIR/MIR-level analysis). Over time, recurring code review feedback and internal guidelines can be converted into custom project-specific lints (see [dylint_lints](../dylint_lints)), preventing bad patterns *before* they reach code review or production.\n+\n+- **Low footprint + performance enable “whole subsystem locally” workflows**.\n+  A fast, resource-efficient stack makes it realistic for developers (and LLM-based code generators) to:\n+  - build and run large subsystems locally (e.g. via Docker Compose),\n+  - run end-to-end tests locally,\n+  - reproduce issues with full logs + source access without relying on remote environments.\n+\n+- **Fearless refactoring**.\n+  Strong type system and exhaustive pattern matching mean large-scale refactors (e.g., changing a contract used by 20 modules) are caught at compile time, not in production.\n+\n+### Why a monorepo (recurring benefits)\n+\n+- **Atomic changes across modules and contracts**.\n+  HyperSpot is modular, but the contracts between modules evolve. A monorepo allows changing a contract and all its consumers in one PR.\n+\n+- **Short, controllable feedback loops for LLM-generated changes**.\n+  When generation touches multiple crates, the monorepo makes it practical to run build + lints + targeted tests + E2E in a single workspace context. This reduces \"partial correctness\" changes and enables rapid iteration on generated patches until the full system is green.\n+\n+- **Single source of truth for tooling and quality gates**.\n+  Consistent formatting, linting, security checks, and test entry points are easier to enforce when everything shares the same CI and build system.\n+\n+- **Realistic local builds and end-to-end testing**.\n+  When the code is together, it is much easier to run “the full actual system” locally, which is a prerequisite for fast debugging and reliable local E2E.\n+\n+- **Avoid version skew between internal crates/services**.\n+  Multi-repos often introduce dependency pinning, release choreography, and integration lag. A monorepo keeps internal APIs aligned by default.\n+\n+Monorepo is not dogma: it has to be kept while it improves velocity and correctness. If a part of the system grows to the point where independent versioning, release cadence, or access control is required, it can be extracted behind stable contracts.\n+\n ---\n \n ## 1. Modular Architecture\n \n ### 1.1. What is a Module?\n \n A **Module** is a logical component that provides a specific set of functionality. In HyperSpot:\n-- Everything MUST be a module (no exceptions)\n+- Every logical component must be a module\n - Each module is a Rust crate library\n - Modules are self-contained with their own configuration, API, and business logic\n - Modules are discovered automatically via the `inventory` crate\n - Modules can depend on each other\n-- A module can implement a common API gateway, while workers can be implemented as separate modules (for example Search gateway that provides agnostic API for search using different engines like Qdrant, Weaviate, etc.)\n+- Modules can have plugins - plugins are not exposed their own Public REST API, depend on the main module and just implement certain contract defined by their host module. Plugins typically are runtime components that can be loaded dynamically\n \n **Example modules:**\n - `api_ingress` - HTTP server and routing\n - `directory_service` - User and tenant management","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"No. It's not about users and tenants but for service discovery by grpc interface references ot GTS-references (future) Also it monitors OoP modules health.","created_at":"2026-01-04T19:56:28Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659891236","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891236"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659891236"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891236/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":93,"side":"RIGHT","author_association":"MEMBER","original_position":89,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891682","pull_request_review_id":3625087578,"id":2659891682,"node_id":"PRRC_kwDOPaLyBs6eirni","diff_hunk":"@@ -15,39 +17,97 @@ HyperSpot is a **modular, high-performance AI services platform** built in Rust.\n - **Universal Deployment**: Single codebase runs on cloud, on-prem Windows/Linux workstation, or mobile\n - **Developer Friendly**: AI-assisted code generation, automatic OpenAPI docs, DDD-light structure, and type-safe APIs\n \n+## Non-goals\n+\n+1. HyperSpot doesn't optimize for **minimalism** or the lowest barrier to entry\n+\n+HyperSpot does not aim to be the simplest or smallest framework for building SaaS or AI applications. It intentionally prioritizes explicit structure, governance, composability, and long-term evolvability over quick-start simplicity or minimal configuration.\n+\n+2. HyperSpot doesn't Provide a **rich catalog of end-user services** out of the box\n+\n+HyperSpot does not aim to ship a comprehensive set of ready-made, end-user SaaS services (e.g. CRM, ticketing, billing products) as part of its core. Its primary focus is the foundational layer—runtime, control plane, GenAI capabilities, workflows, and extensibility—on top of which vendors and product teams build their own complete SaaS offerings.\n+\n+3. HyperSpot doesn't attempt to replace **cloud infrastructure or PaaS layers**\n+\n+HyperSpot is not a replacement for cloud providers or infrastructure platforms such as AWS, Azure, GCP, or on-prem orchestration stacks. It does not offer physical infrastructure, networking, container orchestration, or low-level resource scheduling. Instead, HyperSpot intentionally positions itself above IaaS/PaaS and below vendor-developed SaaS, focusing on application-level services, governance, and GenAI enablement.\n+\n+## Why Rust and why Monorepo?\n+\n+Rust and a monorepo are intentional choices to optimize **recurring engineering work**,especially the feedback loop required for safe and high-throughput **LLM-assisted development**. The goal is to maximize how quickly generated code can be validated (build, lint, test, run, debug) *before* it is committed.\n+\n+### Why Rust (recurring benefits)\n+\n+- **Compile-time safety for memory and concurrency**.\n+  Rust's ownership model prevents data races and memory safety issues by construction. It removes entire categories of runtime failures (null pointer dereference, use-after-free, iterator invalidation) by design—critical for a multi-tenant platform handling concurrent requests.\n+\n+- **Faster debugging of complex, cross-cutting scenarios (human + LLM)**.\n+  Strong typing, structured errors, and deterministic build artifacts make failures easier to localize. This improves troubleshooting for complex, multi-module behaviors and makes it easier for LLMs to propose minimal, correct fixes based on compiler diagnostics, test failures, and traces.\n+\n+- **Deep static analysis as a platform feature**.\n+  Rust's compiler and tooling ecosystem enable strong static inspection (AST/HIR/MIR-level analysis). Over time, recurring code review feedback and internal guidelines can be converted into custom project-specific lints (see [dylint_lints](../dylint_lints)), preventing bad patterns *before* they reach code review or production.\n+\n+- **Low footprint + performance enable “whole subsystem locally” workflows**.\n+  A fast, resource-efficient stack makes it realistic for developers (and LLM-based code generators) to:\n+  - build and run large subsystems locally (e.g. via Docker Compose),\n+  - run end-to-end tests locally,\n+  - reproduce issues with full logs + source access without relying on remote environments.\n+\n+- **Fearless refactoring**.\n+  Strong type system and exhaustive pattern matching mean large-scale refactors (e.g., changing a contract used by 20 modules) are caught at compile time, not in production.\n+\n+### Why a monorepo (recurring benefits)\n+\n+- **Atomic changes across modules and contracts**.\n+  HyperSpot is modular, but the contracts between modules evolve. A monorepo allows changing a contract and all its consumers in one PR.\n+\n+- **Short, controllable feedback loops for LLM-generated changes**.\n+  When generation touches multiple crates, the monorepo makes it practical to run build + lints + targeted tests + E2E in a single workspace context. This reduces \"partial correctness\" changes and enables rapid iteration on generated patches until the full system is green.\n+\n+- **Single source of truth for tooling and quality gates**.\n+  Consistent formatting, linting, security checks, and test entry points are easier to enforce when everything shares the same CI and build system.\n+\n+- **Realistic local builds and end-to-end testing**.\n+  When the code is together, it is much easier to run “the full actual system” locally, which is a prerequisite for fast debugging and reliable local E2E.\n+\n+- **Avoid version skew between internal crates/services**.\n+  Multi-repos often introduce dependency pinning, release choreography, and integration lag. A monorepo keeps internal APIs aligned by default.\n+\n+Monorepo is not dogma: it has to be kept while it improves velocity and correctness. If a part of the system grows to the point where independent versioning, release cadence, or access control is required, it can be extracted behind stable contracts.\n+\n ---\n \n ## 1. Modular Architecture\n \n ### 1.1. What is a Module?\n \n A **Module** is a logical component that provides a specific set of functionality. In HyperSpot:\n-- Everything MUST be a module (no exceptions)\n+- Every logical component must be a module\n - Each module is a Rust crate library\n - Modules are self-contained with their own configuration, API, and business logic\n - Modules are discovered automatically via the `inventory` crate\n - Modules can depend on each other\n-- A module can implement a common API gateway, while workers can be implemented as separate modules (for example Search gateway that provides agnostic API for search using different engines like Qdrant, Weaviate, etc.)\n+- Modules can have plugins - plugins are not exposed their own Public REST API, depend on the main module and just implement certain contract defined by their host module. Plugins typically are runtime components that can be loaded dynamically\n \n **Example modules:**\n - `api_ingress` - HTTP server and routing","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This module (and directory_service) is `system` and I am not sure it's an example.\r\nBut technically it cuold be repalced with own implmentation","created_at":"2026-01-04T19:57:20Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659891682","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891682"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659891682"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659891682/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":92,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659893237","pull_request_review_id":3625087578,"id":2659893237,"node_id":"PRRC_kwDOPaLyBs6eir_1","diff_hunk":"@@ -198,51 +225,91 @@ HyperSpot uses a **monorepo** approach with multiple crates:\n ```\n hyperspot/\n ├── apps/              # Executable applications (hyperspot-server)\n+├── config/            # Configuration files\n+├── docs/              # Architecture and development guides\n+├── dylint_lints/      # Project-specific lints (see `make dylint`)\n+├── examples/          # Example modules and usage patterns\n+├── guidelines/        # Coding standards and best practices for LLMs\n ├── libs/              # Shared libraries (modkit, modkit-db, modkit-auth, etc.)\n ├── modules/           # Business logic modules (api_ingress, directory_service, etc.)","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"business logic and system modules (we woul liek to move all system modules to ./modules/system subfolder","created_at":"2026-01-04T20:00:16Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659893237","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659893237"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659893237"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659893237/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":234,"side":"RIGHT","author_association":"MEMBER","original_position":193,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659895420","pull_request_review_id":3625087578,"id":2659895420,"node_id":"PRRC_kwDOPaLyBs6eish8","diff_hunk":"@@ -198,51 +225,91 @@ HyperSpot uses a **monorepo** approach with multiple crates:\n ```\n hyperspot/\n ├── apps/              # Executable applications (hyperspot-server)\n+├── config/            # Configuration files\n+├── docs/              # Architecture and development guides\n+├── dylint_lints/      # Project-specific lints (see `make dylint`)\n+├── examples/          # Example modules and usage patterns\n+├── guidelines/        # Coding standards and best practices for LLMs\n ├── libs/              # Shared libraries (modkit, modkit-db, modkit-auth, etc.)\n ├── modules/           # Business logic modules (api_ingress, directory_service, etc.)\n-├── examples/          # Example modules and usage patterns\n-├── testing/           # E2E and integration tests\n-├── docs/              # Architecture and development guides\n-├── guidelines/        # Coding standards and best practices\n-└── config/            # Configuration files\n+├── scripts/           # Custom scripts for build, testing, etc.\n+└── testing/           # E2E and integration tests (pytest)\n ```\n \n ### 5.2. External Integration\n \n-The 'main' crates can be located in separate repositories and use HyperSpot modules as dependencies via Cargo. This allows:\n-- Custom applications built on HyperSpot\n-- Private modules not in the main repo\n-- Vendor-specific extensions\n+ The 'main' crates can be located in separate repositories and use HyperSpot modules as dependencies via Cargo. This allows:\n+ - Custom applications built on HyperSpot by choosing only needed modules\n+ - Private modules not in the main repo\n+ - Vendor-specific extensions (modules, plugins, adapters)\n \n ### 5.3. Module Layout (DDD-Light)\n \n-Every module follows a **Domain-Driven Design (DDD-light)** structure:\n+ Every module follows a **Domain-Driven Design (DDD-light)** structure:\n \n ```\n modules/<module-name>/\n+├── Cargo.toml\n ├── src/\n-│   ├── lib.rs           # Public exports\n-│   ├── module.rs        # Module declaration and traits\n-│   ├── config.rs        # Typed configuration\n-│   ├── api/             # Transport adapters (REST, gRPC)\n-│   │   └── rest/        # HTTP handlers, DTOs, routes\n-│   ├── contract/        # Public API for other modules\n-│   │   ├── client.rs    # ClientHub traits\n-│   │   ├── model.rs     # Transport-agnostic models\n-│   │   └── error.rs     # Domain errors\n-│   ├── domain/          # Business logic\n-│   │   ├── service.rs   # Orchestration and rules\n-│   │   └── events.rs    # Domain events\n-│   └── infra/           # Infrastructure (database, external APIs)\n-│       └── storage/     # Database entities and repositories\n-└── Cargo.toml\n+│   ├── lib.rs                        # Public exports\n+│   ├── module.rs                     # Module struct + #[modkit::module(...)] (some modules keep this in lib.rs)\n+│   ├── config.rs                     # Typed module config\n+│   ├── local_client.rs               # Local adapter implementing an SDK API trait (optional)\n+│   ├── api/\n+│   │   └── rest/\n+│   │       ├── dto.rs                # REST-only DTOs (serde + ToSchema)\n+│   │       ├── handlers.rs           # Thin HTTP handlers\n+│   │       ├── routes.rs             # Route + OpenAPI registration (OperationBuilder)\n+│   │       ├── error.rs              # DomainError -> Problem mapping\n+│   │       └── mappers.rs            # DTO <-> domain mapping\n+│   ├── domain/                       # Business logic\n+│   └── infra/                        # Infrastructure adapters (optional)\n+├── tests/                            # Optional\n+└── (optional extras: gts/, openspec/, build.rs, etc.)\n+\n+# SDK pattern (used by e.g. `modules/types-registry/` and `examples/modkit/users_info/`)\n+modules/<module-dir>/\n+├── <module-name>-sdk/\n+│   ├── Cargo.toml\n+│   └── src/\n+│       ├── lib.rs                    # Re-exports\n+│       ├── api.rs                    # ClientHub API trait (methods take &SecurityCtx)\n+│       ├── models.rs                 # Transport-agnostic models (no serde)\n+│       └── error.rs|errors.rs         # Transport-agnostic errors\n+└── <module-name>/\n+    ├── Cargo.toml\n+    └── src/\n+        ├── lib.rs                    # Re-exports SDK + module struct\n+        ├── module.rs                 # Module struct + #[modkit::module(...)]\n+        ├── config.rs\n+        ├── local_client.rs\n+        ├── api/\n+        ├── domain/\n+        └── infra/\n ```\n \n-**Layer responsibilities:**\n-- **API**: Translates HTTP/gRPC requests to domain commands\n-- **Contract**: Public interface for inter-module communication\n-- **Domain**: Core business logic, independent of infrastructure\n-- **Infra**: Database, external services, system interactions\n+Additional common patterns (see `examples/`):\n+\n+- **Gateway + plugins pattern** (pluggable workers via `ClientHub` scopes):\n+  - Gateway crate: `<module>-gw/`\n+  - SDK crate: `<module>-sdk/`\n+  - Plugin crates: `plugins/<vendor>_<plugin>/`","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I am not sure that we should stritcly require <vendor>_<plugin> for plugins:\r\n# Some vendor may have few plugins\r\n# plugins may be splitted by features\r\nand etc","created_at":"2026-01-04T20:04:14Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659895420","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659895420"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659895420"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659895420/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":297,"original_line":296,"side":"RIGHT","author_association":"MEMBER","original_position":285,"position":290,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659898379","pull_request_review_id":3625087578,"id":2659898379,"node_id":"PRRC_kwDOPaLyBs6eitQL","diff_hunk":"@@ -0,0 +1,1465 @@\n+> NOTE: this document describes target architecture and the current state of the codebase. Some components and scenarios are not yet implemented.\n+\n+# CONVENTIONS\n+\n+## Versioning conventions\n+\n+This document describes the HyperSpot Server components and their roles in typical scenarios. Every feature or scenario step has an inline indicator of the priority/phase tag (p1-p5) and implementation status of given functionality:\n+\n+- [ ] - not implemented\n+- [x] - implemented\n+\n+The objective of such notation is to provide a clear overview of the current state of the codebase and the next priorities of selected scenarios.\n+\n+## Type System\n+\n+HyperSpot uses the [Global Type System](https://github.com/GlobalTypeSystem/gts-rust) ([specification](https://github.com/GlobalTypeSystem/gts-spec)) to implement a powerful **extension point architecture** where virtually everything in the system can be extended without modifying core code.\n+\n+The GTS naming conventions provide simple, human-readable, globally unique identifier and referencing system for data type definitions (e.g., JSON Schemas) and global data instances (e.g., JSON objects).\n+\n+# ARCHITECTURE\n+\n+## Detailed Overview\n+\n+![architecture.drawio.png](img/architecture.drawio.png)\n+\n+The diagram above illustrates the principal HyperSpot module architecture. The deployed component set depends on the target environment and build configuration; for example it can be a single executable for the desktop build or multiple containers for a cloud server.\n+\n+Each module encapsulates a well-defined piece of business logic and exposes **versioned contracts** to its consumers via Rust-native interfaces, HTTP APIs, or gRPC. In addition, modules can define their own **plugin interfaces** that allow pluggable implementations of processing and storage concerns, enabling extensibility without coupling core logic to concrete backends. Additionally, modules can define **adapter interfaces** for compile-time selection of an implementation.\n+\n+All interaction between modules and between modules and their plugins happens strictly through these versioned public interfaces. No module or plugin is allowed to depend on another module’s internal structures or implementation details. This enforces loose coupling, enables independent evolution and versioning, and allows modules or plugin implementations to be replaced without impacting the rest of the system.\n+\n+## Modules Categories\n+\n+All modules can be divided into several categories:\n+- **Business Logic Modules** - modules implementing main SaaS service logic that can be build on top of HyperSpot\n+- **Shared Modules** - these are the building blocks for supporting functionality for SaaS services development, including Generative AI and Shared Control Plane modules\n+- **Core Platform Integration Modules** - interfaces for other modules and adapters for real Core Platform services (see below)\n+- **Core Platform Services** - external services that implement Core Platform functionality, such as tenancy management, access policies, licensing, etc.\n+\n+The **Core Platform Integration Modules** layer abstracts integration with core platform services, such as IdP, policy management, licensing, and credentials management that is out of scope of HyperSpot. This keeps HyperSpot reusable: it can run as a standalone platform, or it can integrate into an existing enterprise platform by wiring adapters to the platform’s services.\n+\n+## Dependency rules\n+- Authentication and authorization is built-in in every module and can not be bypassed (zero-trust architecture)\n+- Generative AI Modules MAY depend on Shared Control Plane Modules\n+- Generative AI Modules MUST NOT depend on Core Platform Services directly\n+- Control Plane Modules MUST NOT depend on GenAI Modules\n+- Only integration/adapters talk to external components\n+- No “cross-category sideways” deps except through contracts.\n+- No circular dependencies allowed\n+\n+## API Ingress Modules\n+\n+API Ingress is the single public entry point into HyperSpot for all external clients. It terminates protocols, exposes versioned REST APIs with OpenAPI documentation, and applies a consistent middleware stack for authentication, authorization hooks, rate limiting, validation, and observability. API Ingress is responsible for request shaping and policy enforcement, but contains no business logic.\n+\n+Once a request is validated, it is routed to the appropriate module via stable contracts. All domain decisions and state changes occur downstream, allowing ingress to remain simple, auditable, and scalable while internal modules evolve independently.\n+\n+Every external request MUST pass through:\n+API Ingress → Auth Resolver → Policy Engine → License Resolver → Execution Module → Tenancy Check → Audit/Usage → Response\n+\n+### API gateway","path":"docs/MODULES.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"ote: need to rename api_ingress module to api_gateway.\r\n","created_at":"2026-01-04T20:09:24Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659898379","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659898379"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2659898379"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2659898379/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":60,"original_line":60,"side":"RIGHT","author_association":"MEMBER","original_position":60,"position":60,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660054945","pull_request_review_id":3625087578,"id":2660054945,"node_id":"PRRC_kwDOPaLyBs6ejTeh","diff_hunk":"@@ -1,6 +1,8 @@\n # HyperSpot Architecture Manifest\n \n-> **Welcome to HyperSpot!** This document serves as your architectural compass, explaining the core ideas, design principles, and rules that guide HyperSpot's development. Whether you're a newcomer or contributor, understanding these concepts will help you navigate and extend the platform effectively.\n+> **Welcome to HyperSpot!** This document serves as your architectural and technical reference, explaining the core ideas, design principles, and rules that guide HyperSpot's development. Whether you're a newcomer or contributor, understanding these concepts will help you navigate and extend the platform effectively.\n+\n+HyperSpot is a modular Rust-based foundation for building SaaS products where Generative AI capabilities are first-class, alongside enterprise-grade SaaS requirements such as multi-tenancy, access control, governance, auditability, and usage tracking. It is designed to sit between cloud infrastructure (IaaS/PaaS) and vendor-developed SaaS applications, providing reusable building blocks that product teams can assemble into complete end-to-end services.","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"1968d9f2fea9e55895540f42ed283585e6b8a647","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Should we add a short “current vs target” marker early, like you did in MODULES.md?","created_at":"2026-01-05T00:50:26Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660054945","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660054945"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660054945"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660054945/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":7,"original_line":5,"side":"RIGHT","author_association":"MEMBER","original_position":6,"position":8,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660057244","pull_request_review_id":3625087578,"id":2660057244,"node_id":"PRRC_kwDOPaLyBs6ejUCc","diff_hunk":"@@ -0,0 +1,1465 @@\n+> NOTE: this document describes target architecture and the current state of the codebase. Some components and scenarios are not yet implemented.\n+\n+# CONVENTIONS\n+\n+## Versioning conventions\n+\n+This document describes the HyperSpot Server components and their roles in typical scenarios. Every feature or scenario step has an inline indicator of the priority/phase tag (p1-p5) and implementation status of given functionality:\n+\n+- [ ] - not implemented\n+- [x] - implemented\n+\n+The objective of such notation is to provide a clear overview of the current state of the codebase and the next priorities of selected scenarios.\n+\n+## Type System\n+\n+HyperSpot uses the [Global Type System](https://github.com/GlobalTypeSystem/gts-rust) ([specification](https://github.com/GlobalTypeSystem/gts-spec)) to implement a powerful **extension point architecture** where virtually everything in the system can be extended without modifying core code.\n+\n+The GTS naming conventions provide simple, human-readable, globally unique identifier and referencing system for data type definitions (e.g., JSON Schemas) and global data instances (e.g., JSON objects).\n+\n+# ARCHITECTURE\n+\n+## Detailed Overview\n+\n+![architecture.drawio.png](img/architecture.drawio.png)\n+\n+The diagram above illustrates the principal HyperSpot module architecture. The deployed component set depends on the target environment and build configuration; for example it can be a single executable for the desktop build or multiple containers for a cloud server.\n+\n+Each module encapsulates a well-defined piece of business logic and exposes **versioned contracts** to its consumers via Rust-native interfaces, HTTP APIs, or gRPC. In addition, modules can define their own **plugin interfaces** that allow pluggable implementations of processing and storage concerns, enabling extensibility without coupling core logic to concrete backends. Additionally, modules can define **adapter interfaces** for compile-time selection of an implementation.\n+\n+All interaction between modules and between modules and their plugins happens strictly through these versioned public interfaces. No module or plugin is allowed to depend on another module’s internal structures or implementation details. This enforces loose coupling, enables independent evolution and versioning, and allows modules or plugin implementations to be replaced without impacting the rest of the system.\n+\n+## Modules Categories\n+\n+All modules can be divided into several categories:\n+- **Business Logic Modules** - modules implementing main SaaS service logic that can be build on top of HyperSpot\n+- **Shared Modules** - these are the building blocks for supporting functionality for SaaS services development, including Generative AI and Shared Control Plane modules\n+- **Core Platform Integration Modules** - interfaces for other modules and adapters for real Core Platform services (see below)\n+- **Core Platform Services** - external services that implement Core Platform functionality, such as tenancy management, access policies, licensing, etc.\n+\n+The **Core Platform Integration Modules** layer abstracts integration with core platform services, such as IdP, policy management, licensing, and credentials management that is out of scope of HyperSpot. This keeps HyperSpot reusable: it can run as a standalone platform, or it can integrate into an existing enterprise platform by wiring adapters to the platform’s services.\n+\n+## Dependency rules\n+- Authentication and authorization is built-in in every module and can not be bypassed (zero-trust architecture)","path":"docs/MODULES.md","commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\"zero-trust\" is too absolute now. For example in-process calls can bypass middlewares. We provide real guarantee that all external HTTP goes through api_ingress middleware and all secure orm access is scoped by SecurityCtx. Probably we should say it.","created_at":"2026-01-05T00:53:34Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660057244","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660057244"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660057244"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660057244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":43,"side":"RIGHT","author_association":"MEMBER","original_position":43,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660057877","pull_request_review_id":3625087578,"id":2660057877,"node_id":"PRRC_kwDOPaLyBs6ejUMV","diff_hunk":"@@ -385,17 +390,16 @@ An **extension point** is a well-defined interface where new functionality can b\n \n **Example Use Cases:**\n \n-- A company adds a proprietary chat extension for it's competitive solution\n-- A researcher implements a new benchmark suite as a module worker\n+- A vendor adds a proprietary chat extension for it's competitive solutio","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","original_commit_id":"16ab61a49613891be66a5c45db2f4adbc3b94ec5","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"typo.","created_at":"2026-01-05T00:54:34Z","updated_at":"2026-01-05T00:59:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660057877","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2660057877"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/189#discussion_r2660057877"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/189"}},"reactions
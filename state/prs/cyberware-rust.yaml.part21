ded specs, design, onboarding guides, tasks, and E2E README.\n\n<sub>✏️ Tip: You can customize this high-level summary in your review settings.</sub>\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-01-09T13:33:26Z","updated_at":"2026-01-20T08:41:27Z","closed_at":"2026-01-20T08:41:27Z","merged_at":"2026-01-20T08:41:27Z","merge_commit_sha":"21c315dc0ff2b1f0799d8a0a75615f32a0069a49","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/223/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/223/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/f154644beca8697855955fa21f5b6fc95b5eb0bd","head":{"label":"alizid10:feat/settings","ref":"feat/settings","sha":"f154644beca8697855955fa21f5b6fc95b5eb0bd","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/
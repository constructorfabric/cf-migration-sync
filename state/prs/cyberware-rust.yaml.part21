url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This looks very similar to previous test (and does not really test that list returns all nodes if there are more than one node).","created_at":"2025-12-30T13:32:44Z","updated_at":"2025-12-30T13:32:45Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653020940","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653020940"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653020940"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653020940/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653027634","pull_request_review_id":3618259725,"id":2653027634,"node_id":"PRRC_kwDOPaLyBs6eIf0y","diff_hunk":"@@ -0,0 +1,508 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Unit tests for the nodes registry service layer\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::error::DomainError;\n+use nodes_registry::domain::service::Service;\n+use uuid::Uuid;\n+\n+#[test]\n+fn test_service_initialization_creates_current_node() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert_eq!(nodes.len(), 1, \"Service should initialize with current node\");\n+\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty(), \"Node should have a hostname\");\n+}\n+\n+#[test]\n+fn test_list_nodes_returns_all_nodes() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert!(!nodes.is_empty(), \"Should have at least the current node\");\n+\n+    // Verify node has required fields\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty());\n+    assert!(node.ip_address.is_some());\n+}\n+\n+#[test]\n+fn test_get_node_returns_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node(node_id);\n+    assert!(result.is_ok(), \"Should successfully get existing node\");\n+\n+    let retrieved_node = result.unwrap();\n+    assert_eq!(retrieved_node.id, node_id);\n+    assert_eq!(retrieved_node.hostname, nodes[0].hostname);\n+}\n+\n+#[test]\n+fn test_get_node_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node(nonexistent_id);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_sysinfo(node_id);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect sysinfo for existing node\"\n+    );\n+\n+    let sysinfo = result.unwrap();\n+    assert_eq!(sysinfo.node_id, node_id);\n+    assert!(!sysinfo.os.name.is_empty(), \"Should have OS information\");\n+    assert!(!sysinfo.cpu.model.is_empty(), \"Should have CPU information\");\n+    assert!(sysinfo.memory.total_bytes > 0, \"Should have memory information\");\n+    assert!(!sysinfo.host.hostname.is_empty(), \"Should have host information\");\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_sysinfo(node_id);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data\n+    let result2 = service.get_node_sysinfo(node_id);\n+    assert!(result2.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+\n+    // Both should have the same data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node_sysinfo(nonexistent_id);\n+    assert!(\n+        result.is_err(),\n+        \"Should return error for nonexistent node sysinfo\"\n+    );\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_syscap_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_syscap(node_id, false);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect syscap for existing node\"\n+    );\n+\n+    let syscap = result.unwrap();\n+    assert_eq!(syscap.node_id, node_id);\n+    assert!(\n+        !syscap.capabilities.is_empty(),\n+        \"Should have system capabilities\"\n+    );\n+}\n+\n+#[test]\n+fn test_get_node_syscap_caches_result() {","path":"modules/nodes_registry/tests/service_tests.rs","commit_id":"9cca28f6f7a0ca038ed32bf45a960cd752a1e54f","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It does not test that result is cached, it tests that two gets in a row return the same result. Not sure, if the test is valueable","created_at":"2025-12-30T13:36:18Z","updated_at":"2025-12-30T13:36:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653027634","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653027634"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653027634"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653027634/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":117,"original_line":146,"side":"RIGHT","author_association":"MEMBER","original_position":146,"position":117,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653029113","pull_request_review_id":3618262311,"id":2653029113,"node_id":"PRRC_kwDOPaLyBs6eIgL5","diff_hunk":"@@ -0,0 +1,508 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Unit tests for the nodes registry service layer\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::error::DomainError;\n+use nodes_registry::domain::service::Service;\n+use uuid::Uuid;\n+\n+#[test]\n+fn test_service_initialization_creates_current_node() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert_eq!(nodes.len(), 1, \"Service should initialize with current node\");\n+\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty(), \"Node should have a hostname\");\n+}\n+\n+#[test]\n+fn test_list_nodes_returns_all_nodes() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert!(!nodes.is_empty(), \"Should have at least the current node\");\n+\n+    // Verify node has required fields\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty());\n+    assert!(node.ip_address.is_some());\n+}\n+\n+#[test]\n+fn test_get_node_returns_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node(node_id);\n+    assert!(result.is_ok(), \"Should successfully get existing node\");\n+\n+    let retrieved_node = result.unwrap();\n+    assert_eq!(retrieved_node.id, node_id);\n+    assert_eq!(retrieved_node.hostname, nodes[0].hostname);\n+}\n+\n+#[test]\n+fn test_get_node_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node(nonexistent_id);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_sysinfo(node_id);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect sysinfo for existing node\"\n+    );\n+\n+    let sysinfo = result.unwrap();\n+    assert_eq!(sysinfo.node_id, node_id);\n+    assert!(!sysinfo.os.name.is_empty(), \"Should have OS information\");\n+    assert!(!sysinfo.cpu.model.is_empty(), \"Should have CPU information\");\n+    assert!(sysinfo.memory.total_bytes > 0, \"Should have memory information\");\n+    assert!(!sysinfo.host.hostname.is_empty(), \"Should have host information\");\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_sysinfo(node_id);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data\n+    let result2 = service.get_node_sysinfo(node_id);\n+    assert!(result2.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+\n+    // Both should have the same data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node_sysinfo(nonexistent_id);\n+    assert!(\n+        result.is_err(),\n+        \"Should return error for nonexistent node sysinfo\"\n+    );\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_syscap_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_syscap(node_id, false);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect syscap for existing node\"\n+    );\n+\n+    let syscap = result.unwrap();\n+    assert_eq!(syscap.node_id, node_id);\n+    assert!(\n+        !syscap.capabilities.is_empty(),\n+        \"Should have system capabilities\"\n+    );\n+}\n+\n+#[test]\n+fn test_get_node_syscap_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_syscap(node_id, false);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data (unless TTL expired)\n+    let result2 = service.get_node_syscap(node_id, false);\n+    assert!(result2.is_ok());\n+\n+    let syscap1 = result1.unwrap();\n+    let syscap2 = result2.unwrap();\n+\n+    // Both should have the same node_id\n+    assert_eq!(syscap1.node_id, syscap2.node_id);\n+}\n+\n+#[test]\n+fn test_get_node_syscap_force_refresh() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call\n+    let result1 = service.get_node_syscap(node_id, false);\n+    assert!(result1.is_ok());\n+\n+    // Force refresh\n+    let result2 = service.get_node_syscap(node_id, true);\n+    assert!(result2.is_ok());\n+\n+    let syscap1 = result1.unwrap();\n+    let syscap2 = result2.unwrap();\n+\n+    // Should have collected new data (timestamps might differ)\n+    assert_eq!(syscap1.node_id, syscap2.node_id);\n+    assert!(syscap2.collected_at >= syscap1.collected_at);","path":"modules/nodes_registry/tests/service_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I suggest to remove the previous test and leave this, as this looks more meaningful","created_at":"2025-12-30T13:37:05Z","updated_at":"2025-12-30T13:37:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653029113","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653029113"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653029113"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653029113/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":185,"side":"RIGHT","author_association":"MEMBER","original_position":185,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653033962","pull_request_review_id":3618270732,"id":2653033962,"node_id":"PRRC_kwDOPaLyBs6eIhXq","diff_hunk":"@@ -0,0 +1,508 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Unit tests for the nodes registry service layer\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::error::DomainError;\n+use nodes_registry::domain::service::Service;\n+use uuid::Uuid;\n+\n+#[test]\n+fn test_service_initialization_creates_current_node() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert_eq!(nodes.len(), 1, \"Service should initialize with current node\");\n+\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty(), \"Node should have a hostname\");\n+}\n+\n+#[test]\n+fn test_list_nodes_returns_all_nodes() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert!(!nodes.is_empty(), \"Should have at least the current node\");\n+\n+    // Verify node has required fields\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty());\n+    assert!(node.ip_address.is_some());\n+}\n+\n+#[test]\n+fn test_get_node_returns_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node(node_id);\n+    assert!(result.is_ok(), \"Should successfully get existing node\");\n+\n+    let retrieved_node = result.unwrap();\n+    assert_eq!(retrieved_node.id, node_id);\n+    assert_eq!(retrieved_node.hostname, nodes[0].hostname);\n+}\n+\n+#[test]\n+fn test_get_node_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node(nonexistent_id);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_sysinfo(node_id);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect sysinfo for existing node\"\n+    );\n+\n+    let sysinfo = result.unwrap();\n+    assert_eq!(sysinfo.node_id, node_id);\n+    assert!(!sysinfo.os.name.is_empty(), \"Should have OS information\");\n+    assert!(!sysinfo.cpu.model.is_empty(), \"Should have CPU information\");\n+    assert!(sysinfo.memory.total_bytes > 0, \"Should have memory information\");\n+    assert!(!sysinfo.host.hostname.is_empty(), \"Should have host information\");\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_sysinfo(node_id);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data\n+    let result2 = service.get_node_sysinfo(node_id);\n+    assert!(result2.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+\n+    // Both should have the same data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node_sysinfo(nonexistent_id);\n+    assert!(\n+        result.is_err(),\n+        \"Should return error for nonexistent node sysinfo\"\n+    );\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_syscap_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_syscap(node_id, false);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect syscap for existing node\"\n+    );\n+\n+    let syscap = result.unwrap();\n+    assert_eq!(syscap.node_id, node_id);\n+    assert!(\n+        !syscap.capabilities.is_empty(),\n+        \"Should have system capabilities\"\n+    );\n+}\n+\n+#[test]\n+fn test_get_node_syscap_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_syscap(node_id, false);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data (unless TTL expired)\n+    let result2 = service.get_node_syscap(node_id, false);\n+    assert!(result2.is_ok());\n+\n+    let syscap1 = result1.unwrap();\n+    let syscap2 = result2.unwrap();\n+\n+    // Both should have the same node_id\n+    assert_eq!(syscap1.node_id, syscap2.node_id);\n+}\n+\n+#[test]\n+fn test_get_node_syscap_force_refresh() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call\n+    let result1 = service.get_node_syscap(node_id, false);\n+    assert!(result1.is_ok());\n+\n+    // Force refresh\n+    let result2 = service.get_node_syscap(node_id, true);\n+    assert!(result2.is_ok());\n+\n+    let syscap1 = result1.unwrap();\n+    let syscap2 = result2.unwrap();\n+\n+    // Should have collected new data (timestamps might differ)\n+    assert_eq!(syscap1.node_id, syscap2.node_id);\n+    assert!(syscap2.collected_at >= syscap1.collected_at);\n+}\n+\n+#[test]\n+fn test_get_node_syscap_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node_syscap(nonexistent_id, false);\n+    assert!(\n+        result.is_err(),\n+        \"Should return error for nonexistent node syscap\"\n+    );\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_set_custom_syscap_adds_capabilities() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let custom_caps = vec![\n+        SysCap {\n+            key: \"custom.test.feature\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"test_feature\".to_owned(),\n+            display_name: \"Test Feature\".to_owned(),\n+            present: true,\n+            version: Some(\"1.0.0\".to_owned()),\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+        SysCap {\n+            key: \"custom.another.feature\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"another_feature\".to_owned(),\n+            display_name: \"Another Feature\".to_owned(),\n+            present: false,\n+            version: None,\n+            amount: Some(42.0),\n+            amount_dimension: Some(\"units\".to_owned()),\n+            details: None,\n+            cache_ttl_secs: 7200,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+    ];\n+\n+    let result = service.set_custom_syscap(node_id, custom_caps.clone());\n+    assert!(result.is_ok(), \"Should successfully set custom syscap\");\n+\n+    // Verify custom capabilities are merged\n+    let syscap = service.get_node_syscap(node_id, false).unwrap();\n+    let custom_keys: Vec<String> = custom_caps.iter().map(|c| c.key.clone()).collect();\n+\n+    let found_custom_count = syscap\n+        .capabilities\n+        .iter()\n+        .filter(|c| custom_keys.contains(&c.key))\n+        .count();\n+\n+    assert_eq!(\n+        found_custom_count,\n+        2,\n+        \"Should have both custom capabilities\"\n+    );\n+}\n+\n+#[test]\n+fn test_set_custom_syscap_overwrites_existing() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Set initial custom cap\n+    let cap_v1 = vec![SysCap {\n+        key: \"custom.updatable\".to_owned(),\n+        category: \"custom\".to_owned(),\n+        name: \"updatable\".to_owned(),\n+        display_name: \"Updatable Feature\".to_owned(),\n+        present: true,\n+        version: Some(\"1.0.0\".to_owned()),\n+        amount: None,\n+        amount_dimension: None,\n+        details: None,\n+        cache_ttl_secs: 3600,\n+        fetched_at_secs: chrono::Utc::now().timestamp(),\n+    }];\n+\n+    service.set_custom_syscap(node_id, cap_v1).unwrap();\n+\n+    // Update with new version\n+    let cap_v2 = vec![SysCap {\n+        key: \"custom.updatable\".to_owned(),\n+        category: \"custom\".to_owned(),\n+        name: \"updatable\".to_owned(),\n+        display_name: \"Updatable Feature\".to_owned(),\n+        present: true,\n+        version: Some(\"2.0.0\".to_owned()),\n+        amount: None,\n+        amount_dimension: None,\n+        details: None,\n+        cache_ttl_secs: 3600,\n+        fetched_at_secs: chrono::Utc::now().timestamp(),\n+    }];\n+\n+    service.set_custom_syscap(node_id, cap_v2).unwrap();\n+\n+    // Verify it was updated\n+    let syscap = service.get_node_syscap(node_id, false).unwrap();\n+    let custom_cap = syscap\n+        .capabilities\n+        .iter()\n+        .find(|c| c.key == \"custom.updatable\")\n+        .expect(\"Should find custom capability\");\n+\n+    assert_eq!(custom_cap.version, Some(\"2.0.0\".to_owned()));\n+}\n+\n+#[test]\n+fn test_set_custom_syscap_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let custom_caps = vec![SysCap {\n+        key: \"custom.test\".to_owned(),\n+        category: \"custom\".to_owned(),\n+        name: \"test\".to_owned(),\n+        display_name: \"Test\".to_owned(),\n+        present: true,\n+        version: None,\n+        amount: None,\n+        amount_dimension: None,\n+        details: None,\n+        cache_ttl_secs: 3600,\n+        fetched_at_secs: chrono::Utc::now().timestamp(),\n+    }];\n+\n+    let result = service.set_custom_syscap(nonexistent_id, custom_caps);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_remove_custom_syscap_removes_specified_keys() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Set multiple custom caps\n+    let custom_caps = vec![\n+        SysCap {\n+            key: \"custom.keep\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"keep\".to_owned(),\n+            display_name: \"Keep This\".to_owned(),\n+            present: true,\n+            version: None,\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+        SysCap {\n+            key: \"custom.remove\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"remove\".to_owned(),\n+            display_name: \"Remove This\".to_owned(),\n+            present: true,\n+            version: None,\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+    ];\n+\n+    service.set_custom_syscap(node_id, custom_caps).unwrap();\n+\n+    // Remove one key\n+    let result = service.remove_custom_syscap(node_id, vec![\"custom.remove\".to_owned()]);\n+    assert!(result.is_ok(), \"Should successfully remove custom syscap\");\n+\n+    // Verify only one remains\n+    let syscap = service.get_node_syscap(node_id, false).unwrap();\n+    let has_keep = syscap.capabilities.iter().any(|c| c.key == \"custom.keep\");\n+    let has_remove = syscap\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key == \"custom.remove\");\n+\n+    assert!(has_keep, \"Should still have 'keep' capability\");\n+    assert!(!has_remove, \"Should not have 'remove' capability\");\n+}\n+\n+#[test]\n+fn test_remove_custom_syscap_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.remove_custom_syscap(nonexistent_id, vec![\"custom.test\".to_owned()]);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_clear_custom_syscap_removes_all_custom_capabilities() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Get initial syscap count (system capabilities)\n+    let initial_syscap = service.get_node_syscap(node_id, false).unwrap();\n+    let initial_count = initial_syscap.capabilities.len();\n+\n+    // Set custom caps\n+    let custom_caps = vec![\n+        SysCap {\n+            key: \"custom.one\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"one\".to_owned(),\n+            display_name: \"One\".to_owned(),\n+            present: true,\n+            version: None,\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+        SysCap {\n+            key: \"custom.two\".to_owned(),\n+            category: \"custom\".to_owned(),\n+            name: \"two\".to_owned(),\n+            display_name: \"Two\".to_owned(),\n+            present: true,\n+            version: None,\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        },\n+    ];\n+\n+    service.set_custom_syscap(node_id, custom_caps).unwrap();\n+\n+    // Verify custom caps were added\n+    let with_custom = service.get_node_syscap(node_id, false).unwrap();\n+    assert_eq!(\n+        with_custom.capabilities.len(),\n+        initial_count + 2,\n+        \"Should have added 2 custom capabilities\"\n+    );\n+\n+    // Clear all custom caps\n+    let result = service.clear_custom_syscap(node_id);\n+    assert!(result.is_ok(), \"Should successfully clear custom syscap\");\n+\n+    // Verify only system caps remain\n+    let after_clear = service.get_node_syscap(node_id, false).unwrap();\n+    assert_eq!(\n+        after_clear.capabilities.len(),\n+        initial_count,\n+        \"Should only have system capabilities after clear\"\n+    );\n+\n+    let has_custom = after_clear\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key.starts_with(\"custom.\"));\n+    assert!(!has_custom, \"Should not have any custom capabilities\");\n+}\n+\n+#[test]\n+fn test_clear_custom_syscap_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.clear_custom_syscap(nonexistent_id);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_service_default_is_equivalent_to_new() {\n+    let service1 = Service::new();\n+    let service2 = Service::default();\n+\n+    let nodes1 = service1.list_nodes();\n+    let nodes2 = service2.list_nodes();\n+\n+    assert_eq!(nodes1.len(), nodes2.len());","path":"modules/nodes_registry/tests/service_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If there's a single node, let's initialize only default Service and assert that there's a single node. We already have test for Service::new()","created_at":"2025-12-30T13:39:50Z","updated_at":"2025-12-30T13:39:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653033962","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653033962"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2653033962"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2653033962/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":506,"side":"RIGHT","author_association":"MEMBER","original_position":506,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166263","pull_request_review_id":3622543467,"id":2657166263,"node_id":"PRRC_kwDOPaLyBs6eYSO3","diff_hunk":"@@ -0,0 +1,508 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Unit tests for the nodes registry service layer\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::error::DomainError;\n+use nodes_registry::domain::service::Service;\n+use uuid::Uuid;\n+\n+#[test]\n+fn test_service_initialization_creates_current_node() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert_eq!(nodes.len(), 1, \"Service should initialize with current node\");\n+\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty(), \"Node should have a hostname\");\n+}\n+\n+#[test]\n+fn test_list_nodes_returns_all_nodes() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert!(!nodes.is_empty(), \"Should have at least the current node\");\n+\n+    // Verify node has required fields\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty());\n+    assert!(node.ip_address.is_some());\n+}\n+\n+#[test]\n+fn test_get_node_returns_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node(node_id);\n+    assert!(result.is_ok(), \"Should successfully get existing node\");\n+\n+    let retrieved_node = result.unwrap();\n+    assert_eq!(retrieved_node.id, node_id);\n+    assert_eq!(retrieved_node.hostname, nodes[0].hostname);\n+}\n+\n+#[test]\n+fn test_get_node_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node(nonexistent_id);\n+    assert!(result.is_err(), \"Should return error for nonexistent node\");\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_sysinfo(node_id);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect sysinfo for existing node\"\n+    );\n+\n+    let sysinfo = result.unwrap();\n+    assert_eq!(sysinfo.node_id, node_id);\n+    assert!(!sysinfo.os.name.is_empty(), \"Should have OS information\");\n+    assert!(!sysinfo.cpu.model.is_empty(), \"Should have CPU information\");\n+    assert!(sysinfo.memory.total_bytes > 0, \"Should have memory information\");\n+    assert!(!sysinfo.host.hostname.is_empty(), \"Should have host information\");\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_caches_result() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // First call - collects fresh data\n+    let result1 = service.get_node_sysinfo(node_id);\n+    assert!(result1.is_ok());\n+\n+    // Second call - should use cached data\n+    let result2 = service.get_node_sysinfo(node_id);\n+    assert!(result2.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+\n+    // Both should have the same data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+}\n+\n+#[test]\n+fn test_get_node_sysinfo_returns_error_for_nonexistent_node() {\n+    let service = Service::new();\n+    let nonexistent_id = Uuid::new_v4();\n+\n+    let result = service.get_node_sysinfo(nonexistent_id);\n+    assert!(\n+        result.is_err(),\n+        \"Should return error for nonexistent node sysinfo\"\n+    );\n+\n+    match result.unwrap_err() {\n+        DomainError::NodeNotFound(id) => {\n+            assert_eq!(id, nonexistent_id);\n+        }\n+        _ => panic!(\"Expected NodeNotFound error\"),\n+    }\n+}\n+\n+#[test]\n+fn test_get_node_syscap_succeeds_for_existing_node() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    let result = service.get_node_syscap(node_id, false);\n+    assert!(\n+        result.is_ok(),\n+        \"Should successfully collect syscap for existing node\"\n+    );\n+\n+    let syscap = result.unwrap();\n+    assert_eq!(syscap.node_id, node_id);\n+    assert!(\n+        !syscap.capabilities.is_empty(),\n+        \"Should have system capabilities\"\n+    );\n+}\n+\n+#[test]\n+fn test_get_node_syscap_caches_result() {","path":"modules/nodes_registry/tests/service_tests.rs","commit_id":"9cca28f6f7a0ca038ed32bf45a960cd752a1e54f","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"updated test with proper check for cached result.","created_at":"2026-01-02T09:16:46Z","updated_at":"2026-01-02T09:16:46Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2657166263","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166263"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2657166263"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166263/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":117,"original_line":146,"side":"RIGHT","in_reply_to_id":2653027634,"author_association":"MEMBER","original_position":146,"position":117,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166877","pull_request_review_id":3622544050,"id":2657166877,"node_id":"PRRC_kwDOPaLyBs6eYSYd","diff_hunk":"@@ -0,0 +1,508 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Unit tests for the nodes registry service layer\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::error::DomainError;\n+use nodes_registry::domain::service::Service;\n+use uuid::Uuid;\n+\n+#[test]\n+fn test_service_initialization_creates_current_node() {\n+    let service = Service::new();\n+\n+    let nodes = service.list_nodes();\n+    assert_eq!(nodes.len(), 1, \"Service should initialize with current node\");\n+\n+    let node = &nodes[0];\n+    assert!(!node.hostname.is_empty(), \"Node should have a hostname\");\n+}\n+\n+#[test]\n+fn test_list_nodes_returns_all_nodes() {","path":"modules/nodes_registry/tests/service_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"removed test.","created_at":"2026-01-02T09:16:51Z","updated_at":"2026-01-02T09:16:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2657166877","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166877"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2657166877"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/183"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657166877/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","in_reply_to_id":2653020940,"author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2657167524","pull_request_review_id":3622544664,"id":2657167524,"node_id":"PRRC_kwDOPaLyBs6eYSik","diff_hunk":"@@ -0,0 +1,302 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+//! Integration tests for the nodes registry domain layer\n+//!\n+//! These tests verify the behavior of the service and its interaction with storage.\n+\n+use nodes_registry::contract::SysCap;\n+use nodes_registry::domain::service::Service;\n+\n+#[test]\n+fn test_multiple_service_instances_have_independent_storage() {\n+    let service1 = Service::new();\n+    let service2 = Service::new();\n+\n+    let nodes1 = service1.list_nodes();\n+    let nodes2 = service2.list_nodes();\n+\n+    // Each service should have its own current node\n+    assert_eq!(nodes1.len(), 1);\n+    assert_eq!(nodes2.len(), 1);\n+}\n+\n+#[test]\n+fn test_custom_syscap_persists_across_syscap_refreshes() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Set custom capability\n+    let custom_cap = vec![SysCap {\n+        key: \"custom.persistent\".to_owned(),\n+        category: \"custom\".to_owned(),\n+        name: \"persistent\".to_owned(),\n+        display_name: \"Persistent Feature\".to_owned(),\n+        present: true,\n+        version: Some(\"1.0.0\".to_owned()),\n+        amount: None,\n+        amount_dimension: None,\n+        details: None,\n+        cache_ttl_secs: 3600,\n+        fetched_at_secs: chrono::Utc::now().timestamp(),\n+    }];\n+\n+    service.set_custom_syscap(node_id, custom_cap).unwrap();\n+\n+    // Force refresh of syscap\n+    let syscap_before = service.get_node_syscap(node_id, true).unwrap();\n+\n+    // Custom capability should still be present\n+    let has_custom = syscap_before\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key == \"custom.persistent\");\n+    assert!(has_custom, \"Custom capability should persist after refresh\");\n+\n+    // Refresh again\n+    let syscap_after = service.get_node_syscap(node_id, true).unwrap();\n+    let has_custom = syscap_after\n+        .capabilities\n+        .iter()\n+        .any(|c| c.key == \"custom.persistent\");\n+    assert!(\n+        has_custom,\n+        \"Custom capability should still persist after second refresh\"\n+    );\n+}\n+\n+#[test]\n+fn test_sysinfo_collection_is_idempotent() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Collect sysinfo multiple times\n+    let result1 = service.get_node_sysinfo(node_id);\n+    let result2 = service.get_node_sysinfo(node_id);\n+    let result3 = service.get_node_sysinfo(node_id);\n+\n+    assert!(result1.is_ok());\n+    assert!(result2.is_ok());\n+    assert!(result3.is_ok());\n+\n+    let sysinfo1 = result1.unwrap();\n+    let sysinfo2 = result2.unwrap();\n+    let sysinfo3 = result3.unwrap();\n+\n+    // All should return the same cached data\n+    assert_eq!(sysinfo1.node_id, sysinfo2.node_id);\n+    assert_eq!(sysinfo2.node_id, sysinfo3.node_id);\n+    assert_eq!(sysinfo1.collected_at, sysinfo2.collected_at);\n+    assert_eq!(sysinfo2.collected_at, sysinfo3.collected_at);\n+}\n+\n+#[test]\n+fn test_service_handles_many_custom_syscaps() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Add many custom capabilities\n+    let mut custom_caps = Vec::new();\n+    for i in 0..100 {\n+        custom_caps.push(SysCap {\n+            key: format!(\"custom.test.{i}\"),\n+            category: \"custom\".to_owned(),\n+            name: format!(\"test_{i}\"),\n+            display_name: format!(\"Test {i}\"),\n+            present: true,\n+            version: Some(format!(\"1.0.{i}\")),\n+            amount: None,\n+            amount_dimension: None,\n+            details: None,\n+            cache_ttl_secs: 3600,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        });\n+    }\n+\n+    let result = service.set_custom_syscap(node_id, custom_caps);\n+    assert!(result.is_ok());\n+\n+    // Get all syscaps\n+    let syscap = service.get_node_syscap(node_id, false).unwrap();\n+\n+    // Should have system caps + 100 custom caps\n+    let custom_count = syscap\n+        .capabilities\n+        .iter()\n+        .filter(|c| c.key.starts_with(\"custom.test.\"))\n+        .count();\n+    assert_eq!(custom_count, 100, \"Should have all 100 custom capabilities\");\n+}\n+\n+#[test]\n+fn test_removing_nonexistent_custom_syscap_keys_succeeds() {\n+    let service = Service::new();\n+    let nodes = service.list_nodes();\n+    let node_id = nodes[0].id;\n+\n+    // Try to remove keys that don't exist\n+    let result = service.remove_custom_syscap(\n+        node_id,\n+        vec![\"custom.nonexistent1\".to_owned(), \"custom.nonexistent2\".to_owned()],\n+    );\n+\n+    assert!(","path":"modules/nodes_registry/tests/domain_tests.rs","commit_id":"dd900d124af2e19756775737e455b4e4f308b232","original_commit_id":"dd900d124af2e19756775737e455b4e4f308b232","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"added extra step to verify existing items are still present.","created_at":"2026-01-02T09:16:58Z","updated_at":"2026-01-02T09:16:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/183#discussion_r2657167524","pull_request_url":"https://api.github.com/r
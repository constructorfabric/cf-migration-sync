lugin/src/module.rs](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None#diff-bW9kdWxlcy9zeXN0ZW0vdGVuYW50X3Jlc29sdmVyL3BsdWdpbnMvc2luZ2xlX3RlbmFudF90cl9wbHVnaW4vc3JjL21vZHVsZS5ycw==) | 54.54% | [5 Missing :warning: ](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None) |\n| [libs/modkit-db/src/secure/cond.rs](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None#diff-bGlicy9tb2RraXQtZGIvc3JjL3NlY3VyZS9jb25kLnJz) | 50.00% | [1 Missing :warning: ](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None) |\n| [...m/tenant\\_resolver/tenant\\_resolver-gw/src/module.rs](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None#diff-bW9kdWxlcy9zeXN0ZW0vdGVuYW50X3Jlc29sdmVyL3RlbmFudF9yZXNvbHZlci1ndy9zcmMvbW9kdWxlLnJz) | 83.33% | [1 Missing :warning: ](https://app.codecov.io/gh/hypernetix/hyperspot/pull/217?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None) |\n\n:loudspeaker: Thoughts on this report? [Let us know!](https://github.com/codecov/feedback/issues/255)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3724123040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2682165332","pull_request_review_id":3650642695,"id":2682165332,"node_id":"PRRC_kwDOPaLyBs6f3phU","diff_hunk":"@@ -0,0 +1,248 @@\n+//! Single-tenant resolver plugin module.\n+\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use hs_tenant_resolver_sdk::{\n+    AccessOptions, TenantFilter, TenantId, TenantInfo, TenantResolverError,\n+    TenantResolverPluginClient, TenantResolverPluginSpecV1, TenantStatus,\n+};\n+use modkit::client_hub::ClientScope;\n+use modkit::context::ModuleCtx;\n+use modkit::gts::BaseModkitPluginV1;\n+use modkit::Module;\n+use modkit_security::SecurityContext;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryApi;\n+\n+/// Hardcoded vendor name for GTS instance registration.\n+const VENDOR: &str = \"hyperspot\";\n+\n+/// Hardcoded priority (higher value = lower priority).\n+/// Set to 1000 so `static_tr_plugin` (priority 100) wins when both are enabled.\n+const PRIORITY: i16 = 1000;\n+\n+// Tenant name for single-tenant mode.\n+const TENANT_NAME: &str = \"Default\";\n+\n+/// Single-tenant resolver plugin module.\n+///\n+/// Zero-configuration plugin for single-tenant deployments.\n+/// Returns the tenant from security context as the only accessible tenant.\n+#[modkit::module(\n+    name = \"single_tenant_tr_plugin\",\n+    deps = [\"types_registry\"]\n+)]\n+pub struct SingleTenantTrPlugin;\n+\n+impl Default for SingleTenantTrPlugin {\n+    fn default() -> Self {\n+        Self\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for SingleTenantTrPlugin {\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        info!(\"Initializing single_tenant_tr_plugin\");\n+\n+        // Generate plugin instance ID\n+        let instance_id = TenantResolverPluginSpecV1::gts_make_instance_id(\n+            \"hyperspot.builtin.single_tenant_resolver.plugin.v1\",\n+        );\n+\n+        // Register plugin instance in types-registry\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryApi>()?;\n+        let instance = BaseModkitPluginV1::<TenantResolverPluginSpecV1> {\n+            id: instance_id.clone(),\n+            vendor: VENDOR.to_owned(),\n+            priority: PRIORITY,\n+            properties: TenantResolverPluginSpecV1,\n+        };\n+        let instance_json = serde_json::to_value(&instance)?;\n+\n+        let _ = registry.register(vec![instance_json]).await?;\n+\n+        // Create service and register scoped client in ClientHub\n+        let service = Arc::new(Service);\n+        let api: Arc<dyn TenantResolverPluginClient> = service;\n+        ctx.client_hub()\n+            .register_scoped::<dyn TenantResolverPluginClient>(\n+                ClientScope::gts_id(&instance_id),\n+                api,\n+            );\n+\n+        info!(\n+            instance_id = %instance_id,\n+            vendor = VENDOR,\n+            priority = PRIORITY,\n+            \"Single-tenant plugin initialized\"\n+        );\n+        Ok(())\n+    }\n+}\n+\n+/// Single-tenant resolver service.\n+///\n+/// Implements `TenantResolverPluginClient` with single-tenant semantics:\n+/// - Only the tenant from security context is accessible\n+/// - Cross-tenant access is never allowed\n+/// - Tenant name is always \"Default\"\n+struct Service;\n+\n+#[async_trait]\n+impl TenantResolverPluginClient for Service {\n+    async fn get_tenant(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: TenantId,\n+    ) -> Result<TenantInfo, TenantResolverError> {\n+        // Only return tenant info if ID matches security context\n+        if id == ctx.tenant_id() {\n+            Ok(TenantInfo {\n+                id,\n+                name: TENANT_NAME.to_owned(),\n+                status: TenantStatus::Active,\n+                tenant_type: None,\n+            })\n+        } else {\n+            Err(TenantResolverError::TenantNotFound { tenant_id: id })\n+        }\n+    }\n+\n+    async fn can_access(\n+        &self,\n+        ctx: &SecurityContext,\n+        target: TenantId,\n+        _options: Option<&AccessOptions>,\n+    ) -> Result<bool, TenantResolverError> {\n+        // In single-tenant mode, only self-access is valid\n+        if target == ctx.tenant_id() {\n+            return Ok(true);\n+        }\n+        // Other tenants don't exist\n+        Err(TenantResolverError::TenantNotFound { tenant_id: target })\n+    }\n+\n+    async fn get_accessible_tenants(\n+        &self,\n+        ctx: &SecurityContext,\n+        filter: Option<&TenantFilter>,\n+        _options: Option<&AccessOptions>,\n+    ) -> Result<Vec<TenantInfo>, TenantResolverError> {","path":"modules/system/tenant_resolver/plugins/single_tenant_tr_plugin/src/module.rs","commit_id":"e5c8180d2952b228d394949c258337b4d3ae1090","original_commit_id":"e2779778048fe0310686a5f911f24ea6c246d3de","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is the only implementation of the trait that it's not a mock and it always return a Vec, it can't error. What's the idea of returning a Result then?","created_at":"2026-01-12T12:55:59Z","updated_at":"2026-01-12T18:08:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2682165332","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2682165332"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2682165332"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2682165332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":132,"side":"RIGHT","author_association":"MEMBER","original_position":132,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683851252","pull_request_review_id":3652680861,"id":2683851252,"node_id":"PRRC_kwDOPaLyBs6f-FH0","diff_hunk":"@@ -0,0 +1,248 @@\n+//! Single-tenant resolver plugin module.\n+\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use hs_tenant_resolver_sdk::{\n+    AccessOptions, TenantFilter, TenantId, TenantInfo, TenantResolverError,\n+    TenantResolverPluginClient, TenantResolverPluginSpecV1, TenantStatus,\n+};\n+use modkit::client_hub::ClientScope;\n+use modkit::context::ModuleCtx;\n+use modkit::gts::BaseModkitPluginV1;\n+use modkit::Module;\n+use modkit_security::SecurityContext;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryApi;\n+\n+/// Hardcoded vendor name for GTS instance registration.\n+const VENDOR: &str = \"hyperspot\";\n+\n+/// Hardcoded priority (higher value = lower priority).\n+/// Set to 1000 so `static_tr_plugin` (priority 100) wins when both are enabled.\n+const PRIORITY: i16 = 1000;\n+\n+// Tenant name for single-tenant mode.\n+const TENANT_NAME: &str = \"Default\";\n+\n+/// Single-tenant resolver plugin module.\n+///\n+/// Zero-configuration plugin for single-tenant deployments.\n+/// Returns the tenant from security context as the only accessible tenant.\n+#[modkit::module(\n+    name = \"single_tenant_tr_plugin\",\n+    deps = [\"types_registry\"]\n+)]\n+pub struct SingleTenantTrPlugin;\n+\n+impl Default for SingleTenantTrPlugin {\n+    fn default() -> Self {\n+        Self\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for SingleTenantTrPlugin {\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        info!(\"Initializing single_tenant_tr_plugin\");\n+\n+        // Generate plugin instance ID\n+        let instance_id = TenantResolverPluginSpecV1::gts_make_instance_id(\n+            \"hyperspot.builtin.single_tenant_resolver.plugin.v1\",\n+        );\n+\n+        // Register plugin instance in types-registry\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryApi>()?;\n+        let instance = BaseModkitPluginV1::<TenantResolverPluginSpecV1> {\n+            id: instance_id.clone(),\n+            vendor: VENDOR.to_owned(),\n+            priority: PRIORITY,\n+            properties: TenantResolverPluginSpecV1,\n+        };\n+        let instance_json = serde_json::to_value(&instance)?;\n+\n+        let _ = registry.register(vec![instance_json]).await?;\n+\n+        // Create service and register scoped client in ClientHub\n+        let service = Arc::new(Service);\n+        let api: Arc<dyn TenantResolverPluginClient> = service;\n+        ctx.client_hub()\n+            .register_scoped::<dyn TenantResolverPluginClient>(\n+                ClientScope::gts_id(&instance_id),\n+                api,\n+            );\n+\n+        info!(\n+            instance_id = %instance_id,\n+            vendor = VENDOR,\n+            priority = PRIORITY,\n+            \"Single-tenant plugin initialized\"\n+        );\n+        Ok(())\n+    }\n+}\n+\n+/// Single-tenant resolver service.\n+///\n+/// Implements `TenantResolverPluginClient` with single-tenant semantics:\n+/// - Only the tenant from security context is accessible\n+/// - Cross-tenant access is never allowed\n+/// - Tenant name is always \"Default\"\n+struct Service;\n+\n+#[async_trait]\n+impl TenantResolverPluginClient for Service {\n+    async fn get_tenant(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: TenantId,\n+    ) -> Result<TenantInfo, TenantResolverError> {\n+        // Only return tenant info if ID matches security context\n+        if id == ctx.tenant_id() {\n+            Ok(TenantInfo {\n+                id,\n+                name: TENANT_NAME.to_owned(),\n+                status: TenantStatus::Active,\n+                tenant_type: None,\n+            })\n+        } else {\n+            Err(TenantResolverError::TenantNotFound { tenant_id: id })\n+        }\n+    }\n+\n+    async fn can_access(\n+        &self,\n+        ctx: &SecurityContext,\n+        target: TenantId,\n+        _options: Option<&AccessOptions>,\n+    ) -> Result<bool, TenantResolverError> {\n+        // In single-tenant mode, only self-access is valid\n+        if target == ctx.tenant_id() {\n+            return Ok(true);\n+        }\n+        // Other tenants don't exist\n+        Err(TenantResolverError::TenantNotFound { tenant_id: target })\n+    }\n+\n+    async fn get_accessible_tenants(\n+        &self,\n+        ctx: &SecurityContext,\n+        filter: Option<&TenantFilter>,\n+        _options: Option<&AccessOptions>,\n+    ) -> Result<Vec<TenantInfo>, TenantResolverError> {","path":"modules/system/tenant_resolver/plugins/single_tenant_tr_plugin/src/module.rs","commit_id":"e5c8180d2952b228d394949c258337b4d3ae1090","original_commit_id":"e2779778048fe0310686a5f911f24ea6c246d3de","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`single_tenant_tr_plugin` implementation never errors here. However, the `Result` return type is defined at the trait level (`TenantResolverPluginClient`), which must accommodate all possible plugin implementations. The fact that this specific implementation always succeeds is an implementation detail - the caller doesn't know (or shouldn't need to know) which plugin is being used.","created_at":"2026-01-12T20:44:33Z","updated_at":"2026-01-12T20:44:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2683851252","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683851252"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2683851252"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683851252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":132,"side":"RIGHT","in_reply_to_id":2682165332,"author_association":"MEMBER","original_position":132,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683947245","pull_request_review_id":3652785662,"id":2683947245,"node_id":"PRRC_kwDOPaLyBs6f-cjt","diff_hunk":"@@ -55,15 +51,14 @@ where\n         }\n     }\n \n-    let cond = match parts.as_slice() {\n+    match parts.as_slice() {","path":"libs/modkit-db/src/secure/cond.rs","commit_id":"f3212c2222fa0fbfa9763a87b5bb6f5a293a778d","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not your change but about build_scope_condition(): looks like we don't need Vec<> here at all :) \r\nAlso unreachable!() is questionable in security filters. (panic)\r\n","created_at":"2026-01-12T21:20:29Z","updated_at":"2026-01-13T13:46:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2683947245","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683947245"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2683947245"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2683947245/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":54,"original_line":54,"side":"RIGHT","author_association":"MEMBER","original_position":32,"position":32,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685390633","pull_request_review_id":3654535700,"id":2685390633,"node_id":"PRRC_kwDOPaLyBs6gD88p","diff_hunk":"@@ -15,14 +16,21 @@ pub struct CitiesService<R: CitiesRepository> {\n     policy_engine: PolicyEngineRef,\n     repo: Arc<R>,\n     db: SecureConn,\n+    resolver: Arc<dyn TenantResolverGatewayClient>,\n }\n \n impl<R: CitiesRepository> CitiesService<R> {","path":"examples/modkit/users_info/users_info/src/domain/service/cities.rs","commit_id":"f3212c2222fa0fbfa9763a87b5bb6f5a293a778d","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why this impl is separated?","created_at":"2026-01-13T08:32:02Z","updated_at":"2026-01-13T09:17:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685390633","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685390633"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685390633"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685390633/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":15,"position":15,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685393045","pull_request_review_id":3652785662,"id":2685393045,"node_id":"PRRC_kwDOPaLyBs6gD9iV","diff_hunk":"@@ -0,0 +1,248 @@\n+//! Single-tenant resolver plugin module.\n+\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use hs_tenant_resolver_sdk::{\n+    AccessOptions, TenantFilter, TenantId, TenantInfo, TenantResolverError,\n+    TenantResolverPluginClient, TenantResolverPluginSpecV1, TenantStatus,\n+};\n+use modkit::client_hub::ClientScope;\n+use modkit::context::ModuleCtx;\n+use modkit::gts::BaseModkitPluginV1;\n+use modkit::Module;\n+use modkit_security::SecurityContext;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryApi;\n+\n+/// Hardcoded vendor name for GTS instance registration.\n+const VENDOR: &str = \"hyperspot\";\n+\n+/// Hardcoded priority (higher value = lower priority).\n+/// Set to 1000 so `static_tr_plugin` (priority 100) wins when both are enabled.\n+const PRIORITY: i16 = 1000;\n+\n+// Tenant name for single-tenant mode.\n+const TENANT_NAME: &str = \"Default\";\n+\n+/// Single-tenant resolver plugin module.\n+///\n+/// Zero-configuration plugin for single-tenant deployments.\n+/// Returns the tenant from security context as the only accessible tenant.\n+#[modkit::module(\n+    name = \"single_tenant_tr_plugin\",\n+    deps = [\"types_registry\"]\n+)]\n+pub struct SingleTenantTrPlugin;\n+\n+impl Default for SingleTenantTrPlugin {\n+    fn default() -> Self {\n+        Self\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for SingleTenantTrPlugin {\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        info!(\"Initializing single_tenant_tr_plugin\");\n+\n+        // Generate plugin instance ID\n+        let instance_id = TenantResolverPluginSpecV1::gts_make_instance_id(\n+            \"hyperspot.builtin.single_tenant_resolver.plugin.v1\",\n+        );\n+\n+        // Register plugin instance in types-registry\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryApi>()?;\n+        let instance = BaseModkitPluginV1::<TenantResolverPluginSpecV1> {\n+            id: instance_id.clone(),\n+            vendor: VENDOR.to_owned(),\n+            priority: PRIORITY,\n+            properties: TenantResolverPluginSpecV1,\n+        };\n+        let instance_json = serde_json::to_value(&instance)?;\n+\n+        let _ = registry.register(vec![instance_json]).await?;\n+\n+        // Create service and register scoped client in ClientHub\n+        let service = Arc::new(Service);\n+        let api: Arc<dyn TenantResolverPluginClient> = service;\n+        ctx.client_hub()\n+            .register_scoped::<dyn TenantResolverPluginClient>(\n+                ClientScope::gts_id(&instance_id),\n+                api,\n+            );\n+\n+        info!(\n+            instance_id = %instance_id,\n+            vendor = VENDOR,\n+            priority = PRIORITY,\n+            \"Single-tenant plugin initialized\"\n+        );\n+        Ok(())\n+    }\n+}\n+\n+/// Single-tenant resolver service.\n+///\n+/// Implements `TenantResolverPluginClient` with single-tenant semantics:\n+/// - Only the tenant from security context is accessible\n+/// - Cross-tenant access is never allowed\n+/// - Tenant name is always \"Default\"\n+struct Service;\n+\n+#[async_trait]\n+impl TenantResolverPluginClient for Service {","path":"modules/system/tenant_resolver/plugins/single_tenant_tr_plugin/src/module.rs","commit_id":"e5c8180d2952b228d394949c258337b4d3ae1090","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I suggest to move this client +tests to separate module (client.rs)","created_at":"2026-01-13T08:32:46Z","updated_at":"2026-01-13T13:46:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685393045","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685393045"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685393045"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685393045/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":94,"side":"RIGHT","author_association":"MEMBER","original_position":94,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685395864","pull_request_review_id":3654535700,"id":2685395864,"node_id":"PRRC_kwDOPaLyBs6gD-OY","diff_hunk":"@@ -33,9 +41,10 @@ impl<R: CitiesRepository> CitiesService<R> {\n     pub async fn get_city(&self, ctx: &SecurityContext, id: Uuid) -> Result<City, DomainError> {\n         debug!(\"Getting city by id\");\n \n+        let tenant_ids = super::resolve_accessible_tenants(&*self.resolver, ctx).await?;","path":"examples/modkit/users_info/users_info/src/domain/service/cities.rs","commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why this deref and ref again?","created_at":"2026-01-13T08:33:28Z","updated_at":"2026-01-13T09:17:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685395864","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685395864"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685395864"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685395864/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":44,"side":"RIGHT","author_association":"MEMBER","original_position":35,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685411587","pull_request_review_id":3654535700,"id":2685411587,"node_id":"PRRC_kwDOPaLyBs6gECED","diff_hunk":"@@ -0,0 +1,24 @@\n+//! Single-Tenant Resolver Plugin\n+//!\n+//! Zero-configuration plugin for single-tenant deployments.\n+//! Always returns the tenant from the security context as the only accessible tenant.\n+//!\n+//! ## Behavior\n+//!\n+//! - `get_tenant`: Returns tenant info (name: \"Default\") only if ID matches security context\n+//! - `can_access`: Always returns `false` (cross-tenant access not allowed; self-access handled by gateway)\n+//! - `get_accessible_tenants`: Returns empty list (gateway adds self-tenant automatically)\n+//!\n+//! ## Configuration\n+//!\n+//! No configuration required. The plugin registers itself automatically with:\n+//! - Vendor: `hyperspot`\n+//! - Priority: `1000` (lower than static plugin, so static wins when both are enabled)\n+\n+#![cfg_attr(coverage_nightly, feature(coverage_attribute))]\n+#![forbid(unsafe_code)]","path":"modules/system/tenant_resolver/plugins/single_tenant_tr_plugin/src/lib.rs","commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The forbid and deny rust_2018_idioms I've seen it everywhere but it's enforced at linting Cargo.toml workspace level","created_at":"2026-01-13T08:38:05Z","updated_at":"2026-01-13T09:17:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685411587","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685411587"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685411587"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685411587/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":19,"side":"RIGHT","author_association":"MEMBER","original_position":19,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685554033","pull_request_review_id":3654535700,"id":2685554033,"node_id":"PRRC_kwDOPaLyBs6gEk1x","diff_hunk":"@@ -0,0 +1,304 @@\n+# Tenant Resolver\n+\n+Tenant information and access resolution for HyperSpot's security layer.\n+\n+## Overview\n+\n+The **tenant_resolver** module answers two fundamental questions:\n+\n+1. **What is this tenant?** — Retrieve tenant metadata (name, status)\n+2. **Can I access this tenant's data?** — Resolve access relationships from the current security context\n+\n+The module is **topology-agnostic** — it makes no assumptions about tenant hierarchy structure. Whether the integrating system uses flat tenants, tree hierarchies, DAGs (directed acyclic graph) with multiple parents, or arbitrary graphs, the API remains the same.\n+\n+## Architecture\n+\n+```\n+modules/system/tenant_resolver/\n+├── tenant_resolver-sdk/         # Public API traits and models\n+├── tenant_resolver-gw/          # Gateway module (routes to plugins)\n+└── plugins/\n+    ├── static_tr_plugin/        # Config-based multi-tenant plugin\n+    └── single_tenant_tr_plugin/ # Zero-config single-tenant plugin\n+```\n+\n+| Layer | Responsibility |\n+|-------|----------------|\n+| **SDK** | Public API, plugin API, models |\n+| **Gateway** | Plugin discovery via GTS, request routing |\n+| **Plugins** | Actual tenant data and access rule implementations |\n+\n+## Public API\n+\n+The gateway registers [`TenantResolverGatewayClient`](tenant_resolver-sdk/src/api.rs) in ClientHub:\n+\n+- `get_tenant(ctx, id)` — Retrieve tenant by ID\n+- `can_access(ctx, target, options)` — Check if current tenant can access target\n+- `get_accessible_tenants(ctx, filter, options)` — List accessible tenants\n+\n+Source tenant is always taken from `ctx.tenant_id()`.\n+\n+> [!IMPORTANT]\n+> All API methods require a valid tenant in the security context. Calls with an\n+> empty/anonymous context (nil tenant ID) will return `Unauthorized` error.\n+\n+### Access Rules\n+\n+- **Non-transitive**: A→B and B→C does NOT imply A→C\n+- **Non-symmetric**: A→B does NOT imply B→A\n+\n+> [!NOTE]\n+> Self-access behavior is plugin-determined. The built-in plugins allow full self-access,\n+> but custom plugins can implement restrictions (e.g., a tenant cannot delete itself,\n+> or a suspended tenant may have restricted functionality).\n+\n+### TenantFilter\n+\n+`TenantFilter` is used only in `get_accessible_tenants` to filter the returned list:\n+\n+```rust\n+// No filter (all tenants)\n+let tenants = resolver.get_accessible_tenants(&ctx, None, None).await?;","path":"modules/system/tenant_resolver/README.md","commit_id":"f3212c2222fa0fbfa9763a87b5bb6f5a293a778d","original_commit_id":"1dc824aca8429faae0dafd0c1396ebc8e9d77701","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As we are iterating, I'm not sure if putting code in the README is going to be a good idea but to refer to an examples folder","created_at":"2026-01-13T09:15:00Z","updated_at":"2026-01-13T09:17:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685554033","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685554033"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2685554033"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/217"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2685554033/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":61,"original_line":61,"side":"RIGHT","author_association":"MEMBER","original_position":61,"position":61,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2686072674","pull_request_review_id":3655382334,"id":2686072674,"node_id":"PRRC_kwDOPaLyBs6gGjdi","diff_hunk":"@@ -33,9 +41,10 @@ impl<R: CitiesRepository> CitiesService<R> {\n     pub async fn get_city(&self, ctx: &SecurityContext, id: Uuid) -> Result<City, DomainError> {\n         debug!(\"Getting city by id\");\n \n+        let tenant_ids = super::resolve_accessible_tenants(&*self.resolver, ctx).await?;","path":"examples/modkit/users_info/users_info/src/domain/service/cities.rs","commit_id":"1dc824
 client wrapping the gateway service.\n+///\n+/// Registered in `ClientHub` by the gateway module during `init()`.\n+pub struct TenantResolverGwLocalClient {\n+    svc: Arc<Service>,\n+}\n+\n+impl TenantResolverGwLocalClient {\n+    #[must_use]\n+    pub fn new(svc: Arc<Service>) -> Self {\n+        Self { svc }\n+    }\n+}\n+\n+#[async_trait]\n+impl TenantResolverGatewayClient for TenantResolverGwLocalClient {","path":"modules/system/tenant_resolver/tenant_resolver-gw/src/domain/local_client.rs","commit_id":"f3212c2222fa0fbfa9763a87b5bb6f5a293a778d","original_commit_id":"e5c8180d2952b228d394949c258337b4d3ae1090","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it will be good if we will follow to regular module layout here. I mean client implementations should be placed in src/infra/clients or src/infra/local_client","created_at":"2026-01-13T13:43:21Z","updated_at":"2026-01-13T13:46:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/217#discussion_r2686491057","pull_request_url":"https://api.github.com/repos/cybe
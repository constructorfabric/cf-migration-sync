ub.com/repos/cyberfabric/cyber-insight/pulls/550"},"html":{"href":"https://github.com/cyberfabric/cyber-insight/pull/550"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/550"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/550/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/550/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/550/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/statuses/8e9e3b8a35d94ebc8ec5dfb4c0c1fe23c2a3a72e"}},"author_association":"MEMBER","auto_merge":null,"assignee":{"login":"Gregory91G","id":17801775,"node_id":"MDQ6VXNlcjE3ODAxNzc1","avatar_url":"https://avatars.githubusercontent.com/u/17801775?v=4","gravatar_id":"","url":"https://api.github.com/users/Gregory91G","html_url":"https://github.com/Gregory91G","followers_url":"https://api.github.com/users/Gregory91G/followers","following_url":"https://api.github.com/users/Gregory91G/following{/other_user}","gists_url":"https://api.github.com/users/Gregory91G/gists{/gist_id}","starred_url":"https://api.github.com/users/Gregory91G/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Gregory91G/subscriptions","organizations_url":"https://api.github.com/users/Gregory91G/orgs","repos_url":"https://api.github.com/users/Gregory91G/repos","events_url":"https://api.github.com/users/Gregory91G/events{/privacy}","received_events_url":"https://api.github.com/users/Gregory91G/received_events","type":"User","user_view_type":"public","site_admin":false},"active_lock_reason":null},"source_issue_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4538057284","html_url":"https://github.com/cyberfabric/cyber-insight/pull/550#issuecomment-4538057284","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/550","id":4538057284,"node_id":"IC_kwDORRWv8s8AAAABDn1CRA","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2026-05-25T23:37:41Z","updated_at":"2026-05-26T00:30:06Z","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\n<details>\n<summary>ℹ️ Recent review info</summary>\n\n<details>\n<summary>⚙️ Run configuration</summary>\n\n**Configuration used**: defaults\n\n**Review profile**: CHILL\n\n**Plan**: Free\n\n**Run ID**: `9e07385f-6fde-4c19-94d7-c1ddf52d5e47`\n\n</details>\n\n<details>\n<summary>📥 Commits</summary>\n\nReviewing files that changed from the base of the PR and between 36b7f22df1b8065790e4000b49d30427df4d5e32 and 8e9e3b8a35d94ebc8ec5dfb4c0c1fe23c2a3a72e.\n\n</details>\n\n<details>\n<summary>📒 Files selected for processing (19)</summary>\n\n* `src/backend/services/identity/src/Insight.Identity.Api/Auth/CallerAdminCheck.cs`\n* `src/backend/services/identity/src/Insight.Identity.Api/Auth/HeaderCallerContext.cs`\n* `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/PersonRolesEndpoints.cs`\n* `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/PersonsEndpoints.cs`\n* `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/SubchartEndpoints.cs`\n* `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/VisibilityEndpoints.cs`\n* `src/backend/services/identity/src/Insight.Identity.Domain/Services/IPersonRolesReader.cs`\n* `src/backend/services/identity/src/Insight.Identity.Domain/Services/IPersonsReader.cs`\n* `src/backend/services/identity/src/Insight.Identity.Domain/Services/IVisibilityReader.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/PersonsRepository.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/RolesRepository.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Auth.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Roles.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Visibility.cs`\n* `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/VisibilityRepository.cs`\n* `src/backend/services/identity/tests/Insight.Identity.Tests.Integration/JwtCallerResolveTests.cs`\n* `src/backend/services/identity/tests/Insight.Identity.Tests.Unit/CallerAdminCheckTests.cs`\n* `src/backend/services/identity/tests/Insight.Identity.Tests.Unit/HeaderCallerContextTests.cs`\n* `src/backend/services/identity/tests/Insight.Identity.Tests.Unit/ProfileLookupServiceTests.cs`\n\n</details>\n\n<details>\n<summary>✅ Files skipped from review due to trivial changes (1)</summary>\n\n* src/backend/services/identity/src/Insight.Identity.Api/Endpoints/SubchartEndpoints.cs\n\n</details>\n\n</details>\n\n---\n<!-- walkthrough_start -->\n\n<details>\n<summary>📝 Walkthrough</summary>\n\n## Walkthrough\n\nMigrates caller resolution from synchronous to async with staged fallback: X-Insight-Person-Id header → JWT account-id mapping via account_person_map → JWT email lookup. Updates DI lifetimes, repository SQL/tenant scoping, endpoints, migrations, and adds unit and integration tests.\n\n## Changes\n\n**Async JWT-Based Caller Identity Resolution**\n\n|Layer / File(s)|Summary|\n|---|---|\n|**Async contract and DI foundation** <br> `src/backend/services/identity/src/Insight.Identity.Api/Auth/ICallerContext.cs`, `src/backend/services/identity/src/Insight.Identity.Api/Program.cs`, `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/EndpointHelpers.cs`|Convert `ICallerContext.Resolve` → `ResolveAsync` with `CancellationToken`; add `EndpointHelpers.ResolveCallerAsync`; disable JWT inbound claim remapping (`MapInboundClaims = false`); switch `ICallerContext` and `CallerAdminCheck` to scoped DI.|\n|**Header and JWT resolution implementation** <br> `src/backend/services/identity/src/Insight.Identity.Api/Auth/HeaderCallerContext.cs`, `src/backend/services/identity/src/Insight.Identity.Api/Auth/CallerAdminCheck.cs`|Implement `HeaderCallerContext.ResolveAsync` with per-request caching and staged fallback: header GUID (reject Guid.Empty) → account-id lookup via `ResolvePersonIdByAccountIdAsync` using JWT `oid`/`sub` → email lookup via `ResolvePersonIdsByEmailAsync` (`email`, `preferred_username`, `upn`) with ambiguity logging; update `CallerAdminCheck` to await resolver.|\n|**Domain and repository layer for JWT mapping** <br> `src/backend/services/identity/src/Insight.Identity.Domain/Services/IPersonsReader.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/PersonsRepository.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Auth.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/Migrations/010_account_person_map_idx_by_account.sql`|Add `IPersonsReader.ResolvePersonIdByAccountIdAsync` and implement it in `PersonsRepository` using new `SqlAuth.ResolvePersonIdByAccountId` SQL; introduce `SqlAuth` to hold tenant-scoped identity SQL constants; add migration creating `idx_by_account` on `account_person_map`.|\n|**Repository scoping for roles & visibility** <br> `src/backend/services/identity/src/Insight.Identity.Domain/Services/IPersonRolesReader.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/RolesRepository.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Roles.cs`, `src/backend/services/identity/src/Insight.Identity.Domain/Services/IVisibilityReader.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/Sql.Visibility.cs`, `src/backend/services/identity/src/Insight.Identity.Infrastructure/MariaDb/VisibilityRepository.cs`|Enforce tenant scoping on person-role and visibility reads/soft-deletes by adding `tenantId` parameters, updating repository bindings, and constraining SQL queries with `insight_tenant_id = `@tenant_id``.|\n|**Endpoint integration** <br> `src/backend/services/identity/src/Insight.Identity.Api/Endpoints/*`|Replace synchronous caller resolution with awaited `ResolveAsync`/`ResolveCallerAsync` across PersonRoles, Persons, Roles, Subchart, and Visibility endpoints; scope follow-up reads by `tenantId` where applicable; maintain previous HTTP responses and audit metadata usage.|\n|**Tests and fixtures** <br> `src/backend/services/identity/tests/*`|Update unit tests and test doubles to async API; extend `MariaDbFixture` to create/clear `account_person_map`; add `JwtCallerResolveTests` integration suite covering header precedence, account-id (oid/sub) mapping, email/preferred_username/upn lookup, and negative/unmapped cases; add helpers for seeding and unsigned JWT construction.|\n\n## Sequence Diagram(s)\n\n```mermaid\nsequenceDiagram\n    participant Client as HTTP Client\n    participant Endpoint as Endpoint Handler\n    participant Resolver as HeaderCallerContext\n    participant Reader as IPersonsReader\n    participant DB as MariaDB\n\n    Client->>Endpoint: HTTP Request\n    Endpoint->>Resolver: ResolveAsync(http, ct)\n\n    alt Header X-Insight-Person-Id present\n        Resolver->>Resolver: Parse GUID from header\n        Resolver->>Endpoint: Return person_id\n    else Check JWT oid/sub claims\n        Resolver->>Reader: ResolvePersonIdByAccountIdAsync(tenantId, oid/sub)\n        Reader->>DB: SELECT person_id FROM account_person_map\n        DB-->>Reader: person_id\n        Reader-->>Resolver: person_id\n        Resolver->>Endpoint: Return person_id\n    else Check JWT email claims\n        Resolver->>Reader: ResolvePersonIdsByEmailAsync(tenantId, email)\n        Reader->>DB: SELECT person_id FROM persons (CTE)\n        DB-->>Reader: person_id list\n        Reader-->>Resolver: first person_id (if single)\n        Resolver->>Endpoint: Return person_id\n    else No credentials found\n        Resolver->>Endpoint: Return null\n    end\n\n    alt person_id resolved\n        Endpoint-->>Client: 200 OK\n    else person_id is null\n        Endpoint-->>Client: 401 Unauthorized (caller_unresolved)\n    end\n```\n\n## Estimated code review effort\n\n🎯 3 (Moderate) | ⏱️ ~25 minutes\n\n## Poem\n\n> 🐰 A caller once knocked on the door,  \n> With headers and JWTs galore!  \n> Async now flows through the code,  \n> Fallback paths light the road,  \n> From header to account to email's core! 🔐\n\n</details>\n\n<!-- walkthrough_end -->\n<!-- tips_start -->\n\n---\n\n> [!NOTE]\n> <details>\n> <summary>🎁 Summarized by CodeRabbit Free</summary>\n> \n> Your organization is on the Free plan. CodeRabbit will generate a high-level summary and a walkthrough for each pull request. For a comprehensive line-by-line review, please upgrade your subscription to CodeRabbit Pro by visiting <https://app.coderabbit.ai/login>.\n> \n> </details>\n\n\n<sub>Comment `@coderabbitai help` to get the list of available commands and usage tips.</sub>\n\n<!-- tips_end -->\n<!-- internal state start -->\n\n\n<!--  -->\n\n<!-- internal state end -->","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4538057284/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":347564,"client_id":"Iv1.6aaafe4fe882736b","slug":"coderabbitai","node_id":"A_kwHOB96YWc4ABU2s","owner":{"login":"coderabbitai","id":132028505,"node_id":"O_kgDOB96YWQ","avatar_url":"https://avatars.githubusercontent.com/u/132028505?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai","html_url":"https://github.com/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai/followers","following_url":"https://api.github.com/users/coderabbitai/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai/orgs","repos_url":"https://api.github.com/users/coderabbitai/repos","events_url":"https://api.github.com/users/coderabbitai/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"coderabbitai","description":"# Transforming Code Reviews with AI\r\n\r\n## Features\r\n\r\n**Automated Reviews**: Continuous reviews of the pull requests including incremental commits. \r\n\r\n**Summarization**: Generates high-level summary and a technical walkthrough of the PR changes. \r\n\r\n**Line-by-line review**: Provides line-by-line suggestions committable with one click.\r\n\r\n**Codebase verification**:  Verifies the impact on the overall codebase and identifies missing changes.\r\n\r\n**Insights into your code**:  Ask any questions on your codebase within the pull request \r\n\r\n**Chat about your code** : Chat with the bot around your code. The more you chat, the smarter it gets.\r\n\r\n**Issue Validation**:  Validates the PR against the linked issues and identifies other related issues \r\n\r\n\r\n\r\n","external_url":"https://coderabbit.ai?utm_source=cr_app&utm_medium=github","html_url":"https://github.com/apps/coderabbitai","created_at":"2023-06-14T15:47:27Z","updated_at":"2026-03-14T07:58:44Z","permissions":{"actions":"read","checks":"write","contents":"write","discussions":"read","issues":"write","members":"read","metadata":"read","pull_requests":"write","statuses":"write"},"events":["issues","issue_comment","label","organization","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","release","repository"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":549,"source_url":"https://github.com/cyberfabric/cyber-insight/pull/549","source_state":"closed","source_author":"mitasovr","target_issue_number":null,"title":"[PR #549] fix(chart): render reconcile-loop CronWorkflow with schedules[] (Argo >=3.5)","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"claude/chart-cronworkflow-schedules","pr_head_sha":"de10b934c62c59e987d4ee29495ad6f1b8db7b56","pr_base_ref":"main","pr_head_owner":"mitasovr","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/549","id":3743661273,"node_id":"PR_kwDORRWv8s7fI7zZ","html_url":"https://github.com/cyberfabric/cyber-insight/pull/549","diff_url":"https://github.com/cyberfabric/cyber-insight/pull/549.diff","patch_url":"https://github.com/cyberfabric/cyber-insight/pull/549.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/549","number":549,"state":"closed","locked":false,"title":"fix(chart): render reconcile-loop CronWorkflow with schedules[] (Argo >=3.5)","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\n\n- Render `CronWorkflow.spec.schedules` (array) instead of `.spec.schedule` (singular) in `charts/insight/templates/ingestion/reconcile-cron.yaml`.\n- Public values API stays unchanged — `ingestion.reconcile.schedule` continues to accept a single cron expression. The template wraps it in a one-element array at render time.\n\n## Why\n\nArgo Workflows ≥3.5 dropped the singular `schedule` field from the `CronWorkflow` CRD's openAPI schema in favour of `schedules` (array of strings, to support multiple schedules per cron). Server-side apply against a cluster running the newer CRD rejects the rendered manifest with:\n\n```\nfailed to create typed patch object (...; argoproj.io/v1alpha1, Kind=CronWorkflow):\n  .spec.schedule: field not declared in schema\n```\n\nThis blocks `ingestion.templates.enabled=true` on any cluster with the modern Argo CRD installed.\n\nHit on the virtuozzo cluster while deploying chart 0.1.14 into a side-by-side `insight-v2` namespace; the gitops overlay had to set `ingestion.templates.enabled=false` as a workaround. Same break applies to any new install of the chart against current Argo versions.\n\n## Compatibility\n\n- Argo Workflows ≥3.5: ✅ works (uses `schedules[]`).\n- Argo Workflows ≤3.4: ✗ would break (only accepted `schedule`). The dev/local/virtuozzo install paths in this repo target ≥3.5, so this isn't a regression for any supported topology.\n\nIf broader back-compat is desired, the template could `lookup` the CRD schema and conditionally render the singular or array form — happy to follow up if that path is preferred.\n\n## Test plan\n\n- [ ] `helm template` on the chart with `ingestion.templates.enabled=true` and a sample schedule produces `schedules: [\"*/15 * * * *\"]` (verified locally — see diff).\n- [ ] Apply the rendered CronWorkflow to a cluster with the new Argo CRD (server-side apply succeeds, no schema rejection).\n- [ ] Argo workflow-controller picks up the CronWorkflow and `lastScheduledTime` populates on the first tick.\n\n## Context\n\nDiscovered during virtuozzo customer cluster bring-up (side-by-side `insight-v2` rollout). The gitops overlay carrying the `templates.enabled=false` workaround will be cleaned up once this lands and the umbrella is bumped.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Updated scheduling configuration for improved compatibility with newer versions.\n\n<!-- review_stack_entry_start -->\n\n[![Review Change Stack](https://storage.googleapis.com/coderabbit_public_assets/review-stack-in-coderabbit-ui.svg)](https://app.coderabbit.ai/change-stack/cyberfabric/cyber-insight/pull/549?utm_source=github_walkthrough&utm_medium=github&utm_campaign=change_stack)\n\n<!-- review_stack_entry_end -->\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-05-25T18:46:40Z","updated_at":"2026-05-26T13:38:09Z","closed_at":"2026-05-26T13:38:08Z"
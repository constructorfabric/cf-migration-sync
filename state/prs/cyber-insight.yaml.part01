ight/issues/comments/4555646295/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":347564,"client_id":"Iv1.6aaafe4fe882736b","slug":"coderabbitai","node_id":"A_kwHOB96YWc4ABU2s","owner":{"login":"coderabbitai","id":132028505,"node_id":"O_kgDOB96YWQ","avatar_url":"https://avatars.githubusercontent.com/u/132028505?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai","html_url":"https://github.com/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai/followers","following_url":"https://api.github.com/users/coderabbitai/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai/orgs","repos_url":"https://api.github.com/users/coderabbitai/repos","events_url":"https://api.github.com/users/coderabbitai/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"coderabbitai","description":"# Transforming Code Reviews with AI\r\n\r\n## Features\r\n\r\n**Automated Reviews**: Continuous reviews of the pull requests including incremental commits. \r\n\r\n**Summarization**: Generates high-level summary and a technical walkthrough of the PR changes. \r\n\r\n**Line-by-line review**: Provides line-by-line suggestions committable with one click.\r\n\r\n**Codebase verification**:  Verifies the impact on the overall codebase and identifies missing changes.\r\n\r\n**Insights into your code**:  Ask any questions on your codebase within the pull request \r\n\r\n**Chat about your code** : Chat with the bot around your code. The more you chat, the smarter it gets.\r\n\r\n**Issue Validation**:  Validates the PR against the linked issues and identifies other related issues \r\n\r\n\r\n\r\n","external_url":"https://coderabbit.ai?utm_source=cr_app&utm_medium=github","html_url":"https://github.com/apps/coderabbitai","created_at":"2023-06-14T15:47:27Z","updated_at":"2026-03-14T07:58:44Z","permissions":{"actions":"read","checks":"write","contents":"write","discussions":"read","issues":"write","members":"read","metadata":"read","pull_requests":"write","statuses":"write"},"events":["issues","issue_comment","label","organization","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","release","repository"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":567,"source_url":"https://github.com/cyberfabric/cyber-insight/pull/567","source_state":"closed","source_author":"mitasovr","target_issue_number":null,"title":"[PR #567] chore(release): umbrella 0.1.23 (frontend backend-OIDC #68)","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"claude/release-0.1.23","pr_head_sha":"96aaa00d1f5fc53926c424091d616c3a82c77651","pr_base_ref":"main","pr_head_owner":"mitasovr","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/567","id":3755291466,"node_id":"PR_kwDORRWv8s7f1TNK","html_url":"https://github.com/cyberfabric/cyber-insight/pull/567","diff_url":"https://github.com/cyberfabric/cyber-insight/pull/567.diff","patch_url":"https://github.com/cyberfabric/cyber-insight/pull/567.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/567","number":567,"state":"closed","locked":false,"title":"chore(release): umbrella 0.1.23 (frontend backend-OIDC #68)","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\n\nBumps frontend subchart appVersion to a build of `main @ 59c303b`, which includes **#68** \"fetch OIDC config from backend instead of injecting JS\". Releases umbrella **0.1.23**.\n\n## Why\n\n#68 removes the runtime `/oidc-config.js` file entirely — the SPA now fetches OIDC config from the api-gateway `/auth-info` endpoint. This fixes a real production bug:\n\n- frontend #35 (security hardening) moved OIDC config into a standalone `/oidc-config.js` (strict CSP) **and** put `Cache-Control: public, immutable, max-age=1y` on all `.js`.\n- `/oidc-config.js` is runtime config, but got cached as immutable static. On virtuozzo, Cloudflare/browsers cached the **empty** pre-cutover version for a year — after cutover the new frontend served a filled file, but the CDN kept serving the stale empty one → login broke.\n\n#68's backend-fetch approach sidesteps caching entirely.\n\n## Image\n\n- `ghcr.io/cyberfabric/cyber-insight-front:2026.05.27.16.30-59c303b` (amd64, built on host).\n\nNo other images changed.\n\nUmbrella chart packaged + pushed to `oci://ghcr.io/cyberfabric/charts/insight:0.1.23`.\n\n## Chart bumps\n\n- `src/frontend/helm/Chart.yaml`: appVersion → `2026.05.27.16.30-59c303b`\n- `charts/insight/Chart.yaml`: version `0.1.22 → 0.1.23`, appVersion → new tag\n- `docs/deploy/.insight-version`: `0.1.22 → 0.1.23`\n\n## Test plan\n\n- [ ] `helm pull ...:0.1.23` → frontend appVersion = `...59c303b`. ✅ verified post-push.\n- [ ] Deploy → SPA fetches OIDC from /auth-info (no /oidc-config.js), login works behind CDN without cache purge.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n## Release Notes\n\n* **Chores**\n  * Updated deployment configuration and version metadata to align with the latest application build.\n\n<!-- review_stack_entry_start -->\n\n[![Review Change Stack](https://storage.googleapis.com/coderabbit_public_assets/review-stack-in-coderabbit-ui.svg)](https://app.coderabbit.ai/change-stack/cyberfabric/cyber-insight/pull/567?utm_source=github_walkthrough&utm_medium=github&utm_campaign=change_stack)\n\n<!-- review_stack_entry_end -->\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-05-27T13:13:55Z","updated_at":"2026-05-27T13:15:50Z","closed_at":"2026-05-27T13:15:49Z","merged_at":"2026-05-27T13:15:49Z","merge_commit_sha":"8b3f6b9a1e0454587223b2bd56023cfbd839c5e8","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/567/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/567/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/567/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyber-insight/statuses/96aaa00d1f5fc53926c424091d616c3a82c77651","head":{"label":"mitasovr:claude/release-0.1.23","ref":"claude/release-0.1.23","sha":"96aaa00d1f5fc53926c424091d616c3a82c77651","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","av
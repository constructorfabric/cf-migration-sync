tions/gh/cyberfabric/integrations/provider)</sub>\n<sub>`TIP` This summary will be updated as you push new changes.</sub>\n\n<!-- a1b2c3d4-e5f6-7890-abcd-ef1234567890 -->","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4346327524/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":56611,"client_id":"Iv1.4a97e692dda8878b","slug":"codacy-production","node_id":"MDM6QXBwNTY2MTE=","owner":{"login":"codacy","id":1834093,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE4MzQwOTM=","avatar_url":"https://avatars.githubusercontent.com/u/1834093?v=4","gravatar_id":"","url":"https://api.github.com/users/codacy","html_url":"https://github.com/codacy","followers_url":"https://api.github.com/users/codacy/followers","following_url":"https://api.github.com/users/codacy/following{/other_user}","gists_url":"https://api.github.com/users/codacy/gists{/gist_id}","starred_url":"https://api.github.com/users/codacy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codacy/subscriptions","organizations_url":"https://api.github.com/users/codacy/orgs","repos_url":"https://api.github.com/users/codacy/repos","events_url":"https://api.github.com/users/codacy/events{/privacy}","received_events_url":"https://api.github.com/users/codacy/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"Codacy Production","description":"We need these permissions to access your repositories in order to provide you with the best experience possible. We will be setting up commit hooks to analyze every commit and pull request faster. Don’t worry, we don’t modify any of your code!\r\n\r\n[Learn more about the required permissions](https://docs.codacy.com/getting-started/which-permissions-does-codacy-need-from-my-account/#github-cloud)","external_url":"https://www.codacy.com","html_url":"https://github.com/apps/codacy-production","created_at":"2020-03-06T11:23:10Z","updated_at":"2026-04-16T09:41:21Z","permissions":{"checks":"write","contents":"read","emails":"read","issues":"write","members":"read","merge_queues":"read","metadata":"read","organization_custom_properties":"read","organization_hooks":"write","pull_requests":"write","repository_custom_properties":"read","repository_hooks":"write","statuses":"write"},"events":["custom_property","custom_property_values","merge_group","organization","repository"]}},{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4371306095","html_url":"https://github.com/cyberfabric/cyber-insight/pull/248#issuecomment-4371306095","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/248","id":4371306095,"node_id":"IC_kwDORRWv8s8AAAABBIzWbw","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-04T13:10:22Z","updated_at":"2026-05-04T13:10:22Z","body":"These changes must be tested with missing permissions","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4371306095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[],"source_reviews":[{"id":4219401795,"node_id":"PRR_kwDORRWv8s77fvZD","user":{"login":"cyberantonz","id":270971350,"node_id":"U_kgDOECax1g","avatar_url":"https://avatars.githubusercontent.com/u/270971350?v=4","gravatar_id":"","url":"https://api.github.com/users/cyberantonz","html_url":"https://github.com/cyberantonz","followers_url":"https://api.github.com/users/cyberantonz/followers","following_url":"https://api.github.com/users/cyberantonz/following{/other_user}","gists_url":"https://api.github.com/users/cyberantonz/gists{/gist_id}","starred_url":"https://api.github.com/users/cyberantonz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cyberantonz/subscriptions","organizations_url":"https://api.github.com/users/cyberantonz/orgs","repos_url":"https://api.github.com/users/cyberantonz/repos","events_url":"https://api.github.com/users/cyberantonz/events{/privacy}","received_events_url":"https://api.github.com/users/cyberantonz/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It is ok for me.","state":"APPROVED","html_url":"https://github.com/cyberfabric/cyber-insight/pull/248#pullrequestreview-4219401795","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/248","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/cyberfabric/cyber-insight/pull/248#pullrequestreview-4219401795"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/248"}},"submitted_at":"2026-05-04T10:59:18Z","commit_id":"3ca4f3c5681a64e35de5acbdeacff2e700a4473d"},{"id":4273821107,"node_id":"PRR_kwDORRWv8s7-vVWz","user":{"login":"mozhaev-dev","id":78955917,"node_id":"MDQ6VXNlcjc4OTU1OTE3","avatar_url":"https://avatars.githubusercontent.com/u/78955917?u=c0fa8510cf74dda9280af147e747ccdc69383323&v=4","gravatar_id":"","url":"https://api.github.com/users/mozhaev-dev","html_url":"https://github.com/mozhaev-dev","followers_url":"https://api.github.com/users/mozhaev-dev/followers","following_url":"https://api.github.com/users/mozhaev-dev/following{/other_user}","gists_url":"https://api.github.com/users/mozhaev-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/mozhaev-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mozhaev-dev/subscriptions","organizations_url":"https://api.github.com/users/mozhaev-dev/orgs","repos_url":"https://api.github.com/users/mozhaev-dev/repos","events_url":"https://api.github.com/users/mozhaev-dev/events{/privacy}","received_events_url":"https://api.github.com/users/mozhaev-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Permission failure mode — explicit `error_handler` needed for the two new streams\n\n**Context (for committers)**: in production, `Calendars.Read` (Application, admin consent) will not be granted to us in the foreseeable future — the client's security team will not approve it. Consequently `/users/{id}/calendarView` will always return 403. We need to make sure the connector **fails loudly** on the `calendar_events` stream (with an actionable message) rather than silently emitting zero rows or surfacing a generic error.\n\n### Current behavior (without changes)\n\nI checked — the m365 `connector.yaml` currently has **zero `error_handler` blocks**, neither at stream level nor under `definitions/linked`. The CDK default behavior applies:\n\n- 429 → retry with backoff\n- Other 4xx (including 401/403) → **fail at stream level** with a generic «HTTP 403» message + the first 200 bytes of the response body\n- 5xx → retry with backoff, then fail\n\nSo **technically the stream will fail** on 403, and other m365 streams (teams_activity, sharepoint, onedrive…) will keep working. That part is already fine.\n\n**Problems with the current default**:\n\n1. The log message is a generic «HTTP 403», without mentioning that `Calendars.Read` is required. Ops/SRE handling the page lose time on body inspection.\n2. The `users` stream is the parent for `calendar_events`. If it lacks `User.Read.All` (probably already granted, but we have not recorded that anywhere), it will also 403. By default → fail. The `calendar_events` substream then never runs (parent partitions = 0). And if `users` somehow returns an empty result without an error, `calendar_events` produces 0 rows silently — a potential silent miss.\n3. Operator deploy-time check — none. We wire up the connector → first sync in ~6 hours → 403 → page.\n\n### Recommendation — add `error_handler` with explicit 401/403 FAIL + actionable message\n\nAdd an `error_handler` block under each of the two new `requester:` blocks:\n\n#### Stream `users` (parent)\n\n```suggestion\n      requester:\n        type: HttpRequester\n        http_method: GET\n        authenticator:\n          type: SessionTokenAuthenticator\n          login_requester:\n            type: HttpRequester\n            url: >-\n              https://login.microsoftonline.com/{{ config['azure_tenant_id']\n              }}/oauth2/v2.0/token\n            http_method: GET\n            request_body:\n              $ref: \"#/definitions/linked/HttpRequester/request_body\"\n          session_token_path:\n            - access_token\n          expiration_duration: PT1H\n          request_authentication:\n            type: Bearer\n        request_parameters:\n          $select: id,userPrincipalName,displayName,mail,accountEnabled\n          $filter: accountEnabled eq true\n        url: https://graph.microsoft.com/v1.0/users\n        error_handler:\n          type: DefaultErrorHandler\n          backoff_strategies:\n            - type: WaitTimeFromHeader\n              header: Retry-After\n          response_filters:\n            - type: HttpResponseFilter\n              action: RATE_LIMITED\n              http_codes: [429]\n            - type: HttpResponseFilter\n              action: RETRY\n              http_codes: [503]\n            - type: HttpResponseFilter\n              action: FAIL\n              http_codes: [403]\n              error_message: >-\n                HTTP 403 from GET /users — the Azure AD app lacks the\n                `User.Read.All` Application permission (admin consent\n                required). The calendar_events substream depends on\n                this directory and will not run until the scope is\n                granted. Fix: Azure AD → App registrations → <this\n                app> → API permissions → Microsoft Graph → Application\n                permissions → User.Read.All → Grant admin consent.\n            - type: HttpResponseFilter\n              action: FAIL\n              http_codes: [401]\n              error_message: >-\n                HTTP 401 from GET /users — token rejected. Check\n                azure_client_id / azure_client_secret in the connector\n                Secret, and verify azure_tenant_id matches the tenant\n                that issued the app registration.\n```\n\n#### Stream `calendar_events` (substream of users)\n\n```suggestion\n      requester:\n        type: HttpRequester\n        http_method: GET\n        authenticator:\n          type: SessionTokenAuthenticator\n          login_requester:\n            type: HttpRequester\n            url: >-\n              https://login.microsoftonline.com/{{ config['azure_tenant_id']\n              }}/oauth2/v2.0/token\n            http_method: GET\n            request_body:\n              $ref: \"#/definitions/linked/HttpRequester/request_body\"\n          session_token_path:\n            - access_token\n          expiration_duration: PT1H\n          request_authentication:\n            type: Bearer\n        request_parameters:\n          startDateTime: \"{{ stream_slice.start_time }}T00:00:00Z\"\n          endDateTime: \"{{ stream_slice.end_time }}T00:00:00Z\"\n          $select: id,subject,start,end,organizer,attendees,isOnlineMeeting,onlineMeetingProvider,onlineMeeting,location,bodyPreview,webLink,isCancelled,showAs,sensitivity,seriesMasterId,type\n          $top: '200'\n        url: >-\n          https://graph.microsoft.com/v1.0/users/{{ stream_partition.user_id\n          }}/calendarView\n        error_handler:\n          type: DefaultErrorHandler\n          backoff_strategies:\n            - type: WaitTimeFromHeader\n              header: Retry-After\n          response_filters:\n            - type: HttpResponseFilter\n              action: RATE_LIMITED\n              http_codes: [429]\n            - type: HttpResponseFilter\n              action: RETRY\n              http_codes: [503]\n            - type: HttpResponseFilter\n              action: FAIL\n              http_codes: [403]\n              error_message: >-\n                HTTP 403 from GET /users/{id}/calendarView — the Azure\n                AD app lacks the `Calendars.Read` Application permission\n                (admin consent required). This stream cannot run without\n                it; other m365 streams are unaffected. Fix: Azure AD →\n                App registrations → <this app> → API permissions →\n                Microsoft Graph → Application permissions →\n                Calendars.Read → Grant admin consent. Note for ops:\n                many security teams will NOT approve this scope (it\n                grants tenant-wide read of every user's calendar) — if\n                that is the case, disable the calendar_events stream in\n                the configured catalog rather than letting it fail every\n                sync. The downstream silver classes class_meeting_invite\n                and class_meeting / class_meeting_attendance (calendar\n                joins) will then produce zero rows, which is the\n                intended graceful degradation.\n            - type: HttpResponseFilter\n              action: FAIL\n              http_codes: [401]\n              error_message: >-\n                HTTP 401 from GET /users/{id}/calendarView — token\n                rejected. Same root cause as for the users stream\n                (auth misconfig). Check azure_client_id /\n                azure_client_secret and azure_tenant_id.\n```\n\n### Also: document the \"scope-not-granted\" path in README\n\nIn `src/ingestion/connectors/collaboration/m365/README.md`, make this explicit:\n\n```\n## Permissions\n\nThe connector reads the following Microsoft Graph application permissions:\n\n| Scope               | Required by streams                | If not granted     |\n|---------------------|------------------------------------|---------------------|\n| `Reports.Read.All`  | teams_activity, sharepoint, ...    | most streams fail  |\n| `User.Read.All`     | users, calendar_events (parent)    | both streams fail  |\n| `Calendars.Read`    | calendar_events                    | only calendar_events fails; disable the stream in the catalog if the scope is not approved by security |\n```\n\nAnd in the configured catalog, ship `calendar_events` with status `disabled` by default — the operator enables it explicitly after verifying the scope was granted.\n\n### TL;DR\n\n1. ✅ With the current default, the stream will fail on 403 — no silent miss\n2. ❌ The error message is generic — we need an explicit `error_handler` with an actionable message naming the specific scope\n3. 📋 Document in the README that `Calendars.Read` will often be rejected by the client's security team — in that case the operator should disable the stream in the catalog\n\nHappy to send a patch on our side — I can open a PR onto your branch. Issue tracking:\n- Closes #414 (m365 calendar connector implementation)\n- Makes progress on #412 (silver: calendar) but does not close it — Teams event-grain via callRecords is separate","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyber-insight/pull/248#pullrequestreview-4273821107","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/248","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/cyberfabric/cyber-insight/pull/248#pullrequestreview-4273821107"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/248"}},"submitted_at":"2026-05-12T15:30:40Z","commit_id":"3ca4f3c5681a64e35de5acbdeacff2e700a4473d"}]},{"source_pr_number":230,"source_url":"https://github.com/cyberfabric/cyber-insight/pull/230","source_state":"open","source_author":"mitasovr","target_issue_number":null,"title":"[PR #230] docs(plugins): PRD for unified plugin system","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"claude/plugin-spec","pr_head_sha":"e2f1cd71f36ccf48fb191b0ecaf70f2a17043ae4","pr_base_ref":"main","pr_head_owner":"mitasovr","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/230","id":3578314735,"node_id":"PR_kwDORRWv8s7VSL_v","html_url":"https://github.com/cyberfabric/cyber-insight/pull/230","diff_url":"https://github.com/cyberfabric/cyber-insight/pull/230.diff","patch_url":"https://github.com/cyberfabric/cyber-insight/pull/230.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/230","number":230,"state":"open","locked":false,"title":"docs(plugins): PRD for unified plugin system","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\n\nIntroduces a PRD for the **Plugin System** — the extension mechanism that lets tenants, enterprise customers, and third-party authors add new data sources, silver transformations, and dashboard widgets to a running Insight instance without rebuilding the product.\n\n**This is a docs-only PR.** The DESIGN artifact and subsequent implementation PRs will follow this spec.\n\n## Key design decisions captured\n\n- **Unified plugin model**: one plugin type (not three), OCI-packaged, reverse-DNS identity, SemVer. A single plugin may compose any subset of `connector` / `silver` / `widget` capabilities.\n- **Distribution**: central Insight catalog + ad-hoc URL install from any OCI registry.\n- **Install lifecycle**: per-tenant, multi-version coexistence, explicit admin-driven dependency resolution, no auto-upgrade, no \"legacy\" compatibility mode.\n- **Data policy**: bronze is sacred (preserved across upgrades and uninstalls unless admin explicitly deletes); silver and widget state are re-derivable and not snapshotted.\n- **Airbyte transition**: connector capability accepts the Airbyte source protocol and reuses the existing Airbyte ClickHouse destination, so the current connector fleet migrates into the plugin model without rewrites.\n- **Widget model**: runtime-loaded microfrontend, data resolved by the host app and passed in via a stable interface — widget does not query the data store directly.\n\n## What is deferred (DESIGN / ADR / v2)\n\n- Exact manifest YAML schema and capability extension points (DESIGN)\n- Per-tenant isolation mechanism — row-level `tenant_id` + RLS vs schema-per-install (DESIGN)\n- Native Insight Connector Protocol (ADR, post-v1 if possible)\n- Installed-inventory data model (DESIGN)\n- Plugin-authoring SDK / CLI — docs + reference plugins for v1, CLI for v2\n- Catalog governance for third-party plugins (policy)\n- Integration-testing approach when the customer's source is behind a firewall — recorded traces, opt-in collector, mock servers are all open options\n\n## Validation\n\n- `cpt --json validate --artifact docs/domain/plugins/specs/PRD.md` → **PASS**, 0 errors, 0 warnings\n- `cpt --json validate-toc docs/domain/plugins/specs/PRD.md` → **PASS**\n- 45 priority-marked `cpt-plugin-*` identifiers across FRs / NFRs / interfaces / contracts / actors / use cases\n\n## Related / dependencies\n\n- Depends on the Insight umbrella + canonical installer work (cyberfabric/insight#224) for distribution plumbing\n- Intersects with the Metric Catalog PRD (cyberfabric/insight#225) — the metric catalog is orthogonal to plugins in v1 but may eventually be expressed as plugin capabilities\n\n## Test plan\n\n- [ ] Product team confirms the unified-plugin model (one type with composable capabilities) matches product intent\n- [ ] Backend tech lead accepts the deferred Open Questions and commits to resolving them in DESIGN\n- [ ] Ingestion tech lead confirms Airbyte-protocol reuse is acceptable for v1 and that a native protocol can be deferred\n- [ ] Frontend tech lead confirms the widget microfrontend assumption is compatible with the in-flight microfrontend technology\n- [ ] Customer Success weighs in on the catalog-governance policy before third-party publish opens\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **Documentation**\n  * Added a comprehensive Plugin System PRD: OCI-packaged plugins with reverse-DNS IDs and SemVer, declarative per-plugin manifests, capability types (connector/silver/widget) and contracts, tenant-scoped install lifecycle with admin-controlled dependency resolution, concurrent versions per tenant, shadow-deploy upgrade flow, data-layer semantics (preserved bronze, re-derivable outputs), isolated transform projects, runtime microfrontend widgets, observability and dependency-graph requirements, acceptance criteria and changelog.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-04-24T09:33:16Z","updated_at":"2026-05-12T12:12:04Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[{"login":"dzarlax","id":1673513,"node_id":"MDQ6VXNlcjE2NzM1MTM=","avatar_url":"https://avatars.githubusercontent.com/u/1673513?v=4","gravatar_id":"","url":"https://api.github.com/users/dzarlax","html_url":"https://github.com/dzarlax","followers_url":"https://api.github.com/users/dzarlax/followers","following_url":"https://api.github.com/users/dzarlax/following{/other_user}","gists_url":"https://api.github.com/users/dzarlax/gists{/gist_id}","starred_url":"https://api.github.com/users/dzarlax/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dzarlax/subscriptions","organizations_url":"https://api.github.com/users/dzarlax/orgs","repos_url":"https://api.github.com/users/dzarlax/repos","events_url":"https://api.github.com/users/dzarlax/events{/privacy}","received_events_url":"https://api.github.com/users/dzarlax/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[{"id":10779017141,"node_id":"LA_kwDORRWv8s8AAAACgnq_tQ","url":"https://api.github.com/repos/cyberfabric/cyber-insight/labels/Specs","name":"Specs","color":"0b40a0","default":false,"description":""}],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/230/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/230/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/230/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyber-insight/statuses/e2f1cd71f36ccf48fb191b0ecaf70f2a17043ae4","head":{"label":"mitasovr:claude/plugin-spec","ref":"claude/plugin-spec","sha":"e2f1cd71f36ccf48fb191b0ecaf70f2a17043ae4","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1160245648,"node_id":"R_kgDORSfxkA","name":"insight-spec","full_name":"mitasovr/insight-spec","private":false,"owner":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/mitasovr/insight-spec","description":null,"fork":true,"url":"https://api.github.com/repos/mitasovr/insight-spec","forks_url":"https://api.github.com/repos/mitasovr/insight-spec/forks","keys_url":"https://api.github.com/repos/mitasovr/insight-spec/keys{/key_id}","collaborators_url":"https://api.github.com/repos/mitasovr/insight-spec/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/mitasovr/insight-spec/teams","hooks_url":"https://api.github.com/repos/mitasovr/insight-spec/hooks","issue_events_url":"https://api.github.com/repos/mitasovr/insight-spec/issues/events{/number}","events_url":"https://api.github.com/repos/mitasovr/insight-spec/events","assignees_url":"https://api.github.com/repos/mitasovr/insight-spec/assignees{/user}","branches_url":"https://api.github.com/repos/mitasovr/insight-spec/branches{/branch}","tags_url":"https://api.github.com/repos/mitasovr/insight-spec/tags","blobs_url":"https://api.github.com/repos/mitasovr/insight-spec/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/mitasovr/insight-spec/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/mitasovr/insight-spec/git/refs{/sha}","trees_url":"https://api.github.com/repos/mitasovr/insight-spec/git/trees{/sha}","statuses_url":"https://api.github.com/repos/mitasovr/insight-spec/statuses/{sha}","languages_url":"https://api.github.com/repos/mitasovr/insight-spec/languages","stargazers_url":"https://api.github.com/repos/mitasovr/insight-spec/stargazers","contributors_url":"https://api.github.com/repos/mitasovr/insight-spec/contributors","subscribers_url":"https://api.github.com/repos/mitasovr/insight-spec/subscribers","subscription_url":"https://api.github.com/repos/mitasovr/insight-spec/subscription","commits_url":"https://api.github.com/repos/mitasovr/insight-spec/commits{/sha}","git_commits_url":"https://api.github.com/repos/mitasovr/insight-spec/git/commits{/sha}","comments_url":"https://api.github.com/repos/mitasovr/insight-spec/comments{/number}","issue_comment_url":"https://api.github.com/repos/mitasovr/insight-spec/issues/comments{/number}","contents_url":"https://api.github.com/repos/mitasovr/insight-spec/contents/{+path}","compare_url":"https://api.github.com/repos/mitasovr/insight-spec/compare/{base}...{head}","merges_url":"https://api.github.com/repos/mitasovr/insight-spec/merges","archive_url":"https://api.github.com/repos/mitasovr/insight-spec/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/mitasovr/insight-spec/downloads","issues_url":"https://api.github.com/repos/mitasovr/insight-spec/issues{/number}","pulls_url":"https://api.github.com/repos/mitasovr/insight-spec/pulls{/number}","milestones_url":"https://api.github.com/repos/mitasovr/insight-spec/milestones{/number}","notifications_url":"https://api.github.com/repos/mitasovr/insight-spec/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/mitasovr/insight-spec/labels{/name}","releases_url":"https://api.github.com/repos/mitasovr/insight-spec/releases{/id}","deployments_url":"https://api.github.com/repos/mitasovr/insight-spec/deployments","created_at":"2026-02-17T17:59:19Z","updated_at":"2026-05-11T18:11:31Z","pushed_at":"2026-05-12T13:25:16Z","git_url":"git://github.com/mitasovr/insight-spec.git","ssh_url":"git@github.com:mitasovr/insight-spec.git","clone_url":"https://github.com/mitasovr/insight-spec.git","svn_url":"https://github.com/mitasovr/insight-spec","homepage":null,"size":6179,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":false,"has_projects":true,"has_downloa
s://api.github.com/repos/cyberfabric/cyber-insight/issues/comments/4583957784/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":347564,"client_id":"Iv1.6aaafe4fe882736b","slug":"coderabbitai","node_id":"A_kwHOB96YWc4ABU2s","owner":{"login":"coderabbitai","id":132028505,"node_id":"O_kgDOB96YWQ","avatar_url":"https://avatars.githubusercontent.com/u/132028505?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai","html_url":"https://github.com/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai/followers","following_url":"https://api.github.com/users/coderabbitai/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai/orgs","repos_url":"https://api.github.com/users/coderabbitai/repos","events_url":"https://api.github.com/users/coderabbitai/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"coderabbitai","description":"# Transforming Code Reviews with AI\r\n\r\n## Features\r\n\r\n**Automated Reviews**: Continuous reviews of the pull requests including incremental commits. \r\n\r\n**Summarization**: Generates high-level summary and a technical walkthrough of the PR changes. \r\n\r\n**Line-by-line review**: Provides line-by-line suggestions committable with one click.\r\n\r\n**Codebase verification**:  Verifies the impact on the overall codebase and identifies missing changes.\r\n\r\n**Insights into your code**:  Ask any questions on your codebase within the pull request \r\n\r\n**Chat about your code** : Chat with the bot around your code. The more you chat, the smarter it gets.\r\n\r\n**Issue Validation**:  Validates the PR against the linked issues and identifies other related issues \r\n\r\n\r\n\r\n","external_url":"https://coderabbit.ai?utm_source=cr_app&utm_medium=github","html_url":"https://github.com/apps/coderabbitai","created_at":"2023-06-14T15:47:27Z","updated_at":"2026-03-14T07:58:44Z","permissions":{"actions":"read","checks":"write","contents":"write","discussions":"read","issues":"write","members":"read","metadata":"read","pull_requests":"write","statuses":"write"},"events":["issues","issue_comment","label","organization","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","release","repository"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":594,"source_url":"https://github.com/cyberfabric/cyber-insight/pull/594","source_state":"closed","source_author":"mitasovr","target_issue_number":null,"title":"[PR #594] fix(hubspot): sync deal amount_home + acv/tcv/arr (completes #585)","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"fix/hubspot-deal-amount-props","pr_head_sha":"afcc296939f287f4c7e0675e2e81fae0732c31e1","pr_base_ref":"main","pr_head_owner":"mitasovr","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/594","id":3774636318,"node_id":"PR_kwDORRWv8s7g_GEe","html_url":"https://github.com/cyberfabric/cyber-insight/pull/594","diff_url":"https://github.com/cyberfabric/cyber-insight/pull/594.diff","patch_url":"https://github.com/cyberfabric/cyber-insight/pull/594.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/594","number":594,"state":"closed","locked":false,"title":"fix(hubspot): sync deal amount_home + acv/tcv/arr (completes #585)","user":{"login":"mitasovr","id":370538,"node_id":"MDQ6VXNlcjM3MDUzOA==","avatar_url":"https://avatars.githubusercontent.com/u/370538?v=4","gravatar_id":"","url":"https://api.github.com/users/mitasovr","html_url":"https://github.com/mitasovr","followers_url":"https://api.github.com/users/mitasovr/followers","following_url":"https://api.github.com/users/mitasovr/following{/other_user}","gists_url":"https://api.github.com/users/mitasovr/gists{/gist_id}","starred_url":"https://api.github.com/users/mitasovr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mitasovr/subscriptions","organizations_url":"https://api.github.com/users/mitasovr/orgs","repos_url":"https://api.github.com/users/mitasovr/repos","events_url":"https://api.github.com/users/mitasovr/events{/privacy}","received_events_url":"https://api.github.com/users/mitasovr/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\nCompletes #585. The HubSpot CRM deals staging model (`hubspot__crm_deals`) selects several standard deal properties that were **not** in the connector's `ALLOWED_PROPERTIES_BY_OBJECT[\"deals\"]` allowlist, so they never synced into `bronze_hubspot.deals` and dbt fails with `Code 47 UNKNOWN_IDENTIFIER`.\n\nAdded to the deals allowlist:\n- **`amount_in_home_currency`** → `amount_home` — the currency-normalized deal value that **every** deal-value aggregate in the sales dashboard sums (closed value, avg deal size, pipeline value). Critical.\n- `hs_acv`, `hs_tcv`, `hs_arr` → `acv`/`tcv`/`arr` — contract rollups the staging model exposes to silver.\n\n## Evidence (dev)\nAfter deploying #585's connector image and re-syncing, dbt `tag:hubspot+` now builds activities/contacts/accounts/users (staging + silver) successfully, but `hubspot__crm_deals` still errors:\n\n```\nCode: 47. DB::Exception: Unknown expression or function identifier\n`properties_amount_in_home_currency` ... FROM bronze_hubspot.deals\n```\n\n`silver.class_crm_deals` is then SKIPPED, so all deal-based dashboard metrics (Deal Flow, win rate, cycle time, avg deal size, deals opened, pipeline value) stay empty.\n\n## After merge\nSame rollout as #585/#587: rebuild `source-hubspot-insight` image → bump descriptor (MAJOR, full-refresh) → rebuild toolbox → umbrella release → deploy → HubSpot full re-sync → `dbt --full-refresh tag:hubspot+`. Then `silver.class_crm_deals` builds and the CRM gold views resolve.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * HubSpot connector now syncs three additional deal revenue metrics: Annual Contract Value (ACV), Total Contract Value (TCV), and Annual Recurring Revenue (ARR). These fields are now available for use in workflows and reporting.\n\n<!-- review_stack_entry_start -->\n\n[![Review Change Stack](https://storage.googleapis.com/coderabbit_public_assets/review-stack-in-coderabbit-ui.svg)](https://app.coderabbit.ai/change-stack/cyberfabric/cyber-insight/pull/594?utm_source=github_walkthrough&utm_medium=github&utm_campaign=change_stack)\n\n<!-- review_stack_entry_end -->\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-05-30T18:46:39Z","updated_at":"2026-05-30T18:47:19Z","closed_at":"2026-05-30T18:47:18Z","merged_at":"2026-05-30T18:47:18Z","merge_commit_sha":"885b1e23cea11e1796354a1087078c016d9d26a5","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/594/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/594/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyber-insight/issues/594/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyber-insight/statuses/afcc296939f287f4c7e0675e2e81fae0732c31e1","head":{"label":"mitasovr:fix/hubspot-deal-amount-props","ref":"fix/hubspot-deal-amount-props","sha":"afcc296939f287f4c7e0675e2e81fae0732c31e1","user":{"log
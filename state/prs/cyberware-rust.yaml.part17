r","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'd call it external_module_names, because they can be even remote","created_at":"2026-02-10T20:23:07Z","updated_at":"2026-02-10T20:23:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790104140","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790104140"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790104140"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790104140/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":30,"side":"RIGHT","author_association":"MEMBER","original_position":20,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790107045","pull_request_review_id":3781385318,"id":2790107045,"node_id":"PRRC_kwDOPaLyBs6mTael","diff_hunk":"@@ -0,0 +1,295 @@\n+use std::collections::HashSet;\n+use std::sync::Arc;\n+\n+use modkit::registry::ModuleRegistrySnapshot;\n+use modkit::runtime::ModuleManager;\n+\n+use super::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Service that assembles module information from registry snapshot and runtime data.\n+pub struct ModulesService {\n+    registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+    module_manager: Arc<ModuleManager>,\n+    oop_module_names: Arc<HashSet<String>>,\n+}\n+\n+impl ModulesService {\n+    pub fn new(\n+        registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+        module_manager: Arc<ModuleManager>,\n+        oop_module_names: Arc<HashSet<String>>,\n+    ) -> Self {\n+        Self {\n+            registry_snapshot,\n+            module_manager,\n+            oop_module_names,\n+        }\n+    }\n+\n+    /// List all registered modules, merging compile-time registry data with runtime instances.\n+    pub fn list_modules(&self) -> Vec<ModuleInfo> {\n+        let mut modules = Vec::new();\n+        let mut seen_names = HashSet::new();\n+\n+        // 1. Emit all compiled-in modules from the registry snapshot.\n+        //    If a module is also in oop_module_names, it means the config overrides\n+        //    it to run out-of-process.\n+        for snapshot in &self.registry_snapshot.modules {\n+            seen_names.insert(snapshot.name.clone());\n+\n+            let deployment_mode = if self.oop_module_names.contains(&snapshot.name) {\n+                DeploymentMode::OutOfProcess\n+            } else {\n+                DeploymentMode::CompiledIn\n+            };\n+\n+            let instances = self.instances_for_module(&snapshot.name);\n+\n+            modules.push(ModuleInfo {\n+                name: snapshot.name.clone(),\n+                capabilities: snapshot.capability_labels.clone(),\n+                dependencies: snapshot.deps.clone(),\n+                deployment_mode,\n+                instances,\n+            });\n+        }\n+\n+        // 2. Add OoP modules from config that haven't been seen yet\n+        //    (they may or may not have registered instances)\n+        for oop_name in self.oop_module_names.iter() {\n+            if seen_names.contains(oop_name) {\n+                continue;\n+            }\n+            seen_names.insert(oop_name.clone());\n+\n+            let instances = self.instances_for_module(oop_name);\n+\n+            modules.push(ModuleInfo {\n+                name: oop_name.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // 3. Add any dynamically registered modules from ModuleManager\n+        //    that are not in the registry or OoP config\n+        for instance in self.module_manager.all_instances() {\n+            if seen_names.contains(&instance.module) {\n+                continue;\n+            }\n+            seen_names.insert(instance.module.clone());\n+\n+            let instances = self.instances_for_module(&instance.module);\n+\n+            modules.push(ModuleInfo {\n+                name: instance.module.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // Sort by name for deterministic output\n+        modules.sort_by(|a, b| a.name.cmp(&b.name));\n+\n+        modules\n+    }\n+\n+    fn instances_for_module(&self, module_name: &str) -> Vec<InstanceInfo> {","path":"modules/system/module_orchestrator/src/domain/service.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"16dd46807de8f750af32427b683483659e334770","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.githu
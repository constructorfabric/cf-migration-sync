_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"> Skipped: comment is from another GitHub bot.\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T10:43:30Z","updated_at":"2026-02-10T10:43:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787197974","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787197974"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787197974"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787197974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":108,"original_start_line":109,"start_side":"RIGHT","line":119,"original_line":120,"side":"RIGHT","in_reply_to_id":2785622427,"author_association":"CONTRIBUTOR","original_position":120,"position":119,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787274992","pull_request_review_id":3778257622,"id":2787274992,"node_id":"PRRC_kwDOPaLyBs6mInDw","diff_hunk":"@@ -0,0 +1,273 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+// ── Layer ────────────────────────────────────────────────────────────────────\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+// ── Service ──────────────────────────────────────────────────────────────────\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());\n+                match HeaderValue::from_str(&raw) {\n+                    Ok(v) => v,\n+                    Err(e) => return Box::pin(async { Err(HttpError::InvalidHeaderValue(e)) }),\n+                }\n+            }\n+            Err(e) => {\n+                return Box::pin(async { Err(HttpError::Transport(Box::new(e))) });\n+            }\n+        };\n+\n+        req.headers_mut()\n+            .insert(self.header_name.clone(), bearer_value);\n+","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"619e6e5b19da655053fe65f9e0ec3e21f6ddef35","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We have it in I layer.rs but not int source. It requires set_header_value. Not for this PR","created_at":"2026-02-10T10:59:04Z","updated_at":"2026-02-10T10:59:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787274992","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787274992"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787274992"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787274992/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":81,"original_start_line":85,"start_side":"RIGHT","line":98,"original_line":101,"side":"RIGHT","in_reply_to_id":2785512346,"author_association":"MEMBER","original_position":101,"position":98,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319386","pull_request_review_id":3778301492,"id":2787319386,"node_id":"PRRC_kwDOPaLyBs6mIx5a","diff_hunk":"@@ -0,0 +1,793 @@\n+# Implementation Plan — Outbound OAuth2 Client Credentials\n+\n+Reference: [0002-modkit-auth-client.md](./0002-modkit-auth-client.md)\n+Required reading: [ModKit unified system](/docs/modkit_unified_system/README.md)\n+\n+Crate: `libs/modkit-auth`\n+\n+## Existing code to reuse\n+\n+Before starting, review the existing JWKS provider at\n+`libs/modkit-auth/src/providers/jwks.rs`. It is the closest analog to the OAuth2\n+token source and establishes patterns that must be followed:\n+\n+| Concern | JWKS (existing) | OAuth2 (new) |\n+|---------|----------------|--------------|\n+| HTTP client | `HttpClient::builder().timeout().retry(None).build()` | `HttpClientConfig::token_endpoint()` |\n+| Lock-free cache | `Arc<ArcSwap<HashMap<String,DecodingKey>>>` | `ArcSwap<TokenInner>` |\n+| Background refresh | `run_jwks_refresh_task` + `CancellationToken` | `aliri_tokens` watcher |\n+| Backoff | Manual exponential in `calculate_backoff()` | Delegated to `aliri_tokens` |\n+| Error mapping | `map_http_error(HttpError) -> ClaimsError` | Extract shared `map_http_error` or create parallel `map_http_error(HttpError) -> TokenError` |\n+| Test scaffold | `httpmock` + `allow_insecure_http()` | Same pattern |\n+\n+Key reuse points:\n+\n+1. **`map_http_error`** — `jwks.rs:417-473` maps every `HttpError` variant.\n+   Extract it into a shared helper `src/providers/http_error_mapping.rs` or\n+   duplicate the pattern for `TokenError`. Extraction is preferred to keep the\n+   exhaustive match in one place (HttpError is `#[non_exhaustive]`).\n+2. **`ArcSwap` lock-free read pattern** — `jwks.rs` uses `keys.load()` for\n+   reads and `keys.store(Arc::new(...))` for writes. Token must follow the\n+   same pattern.\n+3. **`HttpClient` construction** — `jwks.rs:86-89` builds a client with no\n+   retries (JWKS handles its own). OAuth source uses\n+   `HttpClientConfig::token_endpoint()` instead (retries are appropriate for\n+   token acquisition).\n+4. **Test pattern** — `jwks.rs:482-499` (`test_provider_with_http`) shows\n+   how to build a test `HttpClient` with `allow_insecure_http()` for\n+   `httpmock`. Reuse the same approach.\n+5. **Dependencies already available** — `modkit-auth/Cargo.toml` already has\n+   `arc-swap`, `modkit-http`, `tokio-util`, `httpmock` (dev). Only\n+   `aliri_tokens` needs to be added.\n+\n+---\n+\n+## Phase 0 — Extract shared HTTP error mapping\n+\n+**Goal:** Extract `map_http_error` from JWKS into a reusable utility so both JWKS and OAuth2 can use it without duplicating the exhaustive match.\n+\n+### Prompt\n+\n+```\n+Extract the HTTP error mapping function from the JWKS provider into a shared\n+utility in libs/modkit-auth.\n+\n+Current state: `libs/modkit-auth/src/providers/jwks.rs` lines 417-473 contain\n+`fn map_http_error(e: modkit_http::HttpError) -> ClaimsError` that exhaustively\n+maps every HttpError variant. This pattern will be needed by the OAuth2 token\n+source as well.\n+\n+1. Create `src/http_error.rs` with a generic mapping function:\n+\n+   pub fn format_http_error(e: &modkit_http::HttpError, prefix: &str) -> String\n+\n+   This function takes an HttpError reference and a context prefix (e.g. \"JWKS\",\n+   \"OAuth2 token\") and returns a human-readable error message string. It must\n+   handle every variant of HttpError (which is #[non_exhaustive]) with a\n+   catch-all `_ =>` arm at the end.\n+\n+   Replicate the exact mapping logic from jwks.rs:417-473, but replace the\n+   hardcoded \"JWKS\" prefix with the `prefix` parameter.\n+\n+2. Update `src/providers/jwks.rs`:\n+   - Replace the local `map_http_error` function with a call to the shared one:\n+\n+     fn map_http_error(e: modkit_http::HttpError) -> ClaimsError {\n+         ClaimsError::JwksFetchFailed(crate::http_error::format_http_error(&e, \"JWKS\"))\n+     }\n+\n+   - Delete the old exhaustive match from jwks.rs.\n+\n+3. Wire `pub mod http_error` into src/lib.rs.\n+\n+4. Run `cargo test -p modkit-auth` — all existing JWKS tests must pass unchanged.\n+\n+The OAuth2 token source (Phase 2) will use the same shared function:\n+    TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 0 (shared HTTP error mapping) in libs/modkit-auth.\n+\n+Check every item:\n+\n+1. FILE EXISTS: src/http_error.rs with pub fn format_http_error.\n+\n+2. EXHAUSTIVE MATCH: format_http_error handles these HttpError variants:\n+   HttpStatus, Json, Timeout, DeadlineExceeded, Transport, BodyTooLarge,\n+   Tls, RequestBuild, InvalidHeaderName, InvalidHeaderValue, FormEncode,\n+   Overloaded, ServiceClosed, InvalidUri, InvalidScheme, plus a `_ =>` arm.\n+\n+3. PREFIX USED: Every match arm includes the prefix parameter in its output.\n+   e.g. \"{prefix} HTTP {status}\" not \"JWKS HTTP {status}\".\n+\n+4. JWKS UNCHANGED: jwks.rs now calls format_http_error(&e, \"JWKS\").\n+   The local exhaustive match is removed.\n+   Run `cargo test -p modkit-auth` — all 11 existing JWKS tests pass.\n+\n+5. NO SECRET LEAKS: format_http_error never includes request body, auth\n+   headers, or token values — only status codes, error messages, and URLs.\n+\n+6. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+```\n+\n+---\n+\n+## Phase 1 — Foundation types\n+\n+**Goal:** Define configuration, error, and response types. No async code yet.\n+\n+### Prompt\n+\n+```\n+Implement foundation types for outbound OAuth2 client credentials in\n+libs/modkit-auth.\n+\n+Create a new module `src/oauth2/` with:\n+\n+1. `src/oauth2/mod.rs` — re-exports.\n+\n+2. `src/oauth2/config.rs` — `OAuthClientConfig`:\n+   - `token_endpoint: Option<Url>` (direct endpoint)\n+   - `issuer_url: Option<Url>` (for OIDC discovery, Phase 6)\n+   - Exactly one of `token_endpoint` or `issuer_url` must be set; validate in a\n+     `fn validate(&self) -> Result<(), TokenError>` method.\n+   - `client_id: String`\n+   - `client_secret: SecretString` (use the SecretString from this module)\n+   - `scopes: Vec<String>`\n+   - `auth_method: ClientAuthMethod` enum { Basic, Form } (default Basic)\n+   - `extra_headers: Vec<(String, String)>` (default empty)\n+   - `refresh_offset: Duration` (default 30 min)\n+   - `jitter_max: Duration` (default 5 min)\n+   - `min_refresh_period: Duration` (default 10 sec)\n+   - `default_ttl: Duration` (default 5 min — used when expires_in missing)\n+   - `http_config: Option<modkit_http::HttpClientConfig>` (override for token\n+     endpoint client; defaults to HttpClientConfig::token_endpoint())\n+   All durations use `std::time::Duration`. Derive `Clone`. Do NOT derive `Debug`\n+   for the whole struct — implement `Debug` manually, redacting `client_secret`.\n+\n+3. `src/oauth2/error.rs` — `TokenError` enum (thiserror):\n+   - `Http(String)` — transport/status errors (store formatted message, not\n+     the raw HttpError, to avoid leaking internals; use the shared\n+     `format_http_error` from Phase 0 when constructing)\n+   - `InvalidResponse(String)` — malformed token response\n+   - `UnsupportedTokenType(String)` — token_type is not Bearer\n+   - `ConfigError(String)` — invalid config (e.g. both endpoints set)\n+   - `Unavailable(String)` — watcher not ready / shutdown\n+   Mark `#[non_exhaustive]`. Implement Display via thiserror. Ensure no variant\n+   can ever contain secret values.\n+   Follow the same pattern as `AuthError` in src/errors.rs.\n+\n+4. `src/oauth2/types.rs`:\n+   - `SecretString` — newtype over `String` with `Debug` printing \"[REDACTED]\",\n+     `Display` printing \"[REDACTED]\", `Clone`, and `Drop` that zeroizes the\n+     inner buffer (use `unsafe { core::ptr::write_bytes }` on the Vec<u8>\n+     backing buffer, or the `zeroize` crate if available in workspace).\n+     Provide `fn expose(&self) -> &str` for controlled access.\n+   - `TokenResponse` (serde `Deserialize`):\n+     - `access_token: String`\n+     - `expires_in: Option<u64>`\n+     - `token_type: Option<String>`\n+     Deserialize only — never derive Serialize. Use `#[serde(default)]` for\n+     optional fields.\n+   - `ClientAuthMethod` enum { Basic, Form } with `Default` = Basic.\n+\n+Wire `mod oauth2` into `src/lib.rs` and re-export `OAuthClientConfig`,\n+`TokenError`, `SecretString`, `ClientAuthMethod` from the crate root\n+(Token will be re-exported in Phase 3).\n+\n+Follow existing patterns in modkit-auth: thiserror for errors, no unwrap in\n+library code, #[non_exhaustive] on public enums.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 1 (foundation types) of the OAuth2 client credentials\n+implementation in libs/modkit-auth/src/oauth2/.\n+\n+Check every item:\n+\n+1. FILES EXIST: mod.rs, config.rs, error.rs, types.rs under src/oauth2/.\n+   `mod oauth2` is declared in src/lib.rs.\n+\n+2. SecretString:\n+   - Debug and Display both print \"[REDACTED]\", never the inner value.\n+   - `expose(&self) -> &str` is the only way to access the inner value.\n+   - Clone is implemented.\n+   - Drop zeroizes the buffer (write_bytes or zeroize).\n+   - Write a unit test: create a SecretString, format with Debug and Display,\n+     assert neither contains the original value. Assert expose() returns it.\n+\n+3. OAuthClientConfig:\n+   - Has all fields from the design (token_endpoint, issuer_url, client_id,\n+     client_secret, scopes, auth_method, extra_headers, refresh_offset,\n+     jitter_max, min_refresh_period, default_ttl, http_config).\n+   - Does NOT derive Debug — has manual Debug impl that redacts client_secret.\n+   - validate() returns error if both token_endpoint and issuer_url are set,\n+     or if neither is set.\n+   - Write a unit test for validate() with both, neither, and exactly-one.\n+\n+4. TokenError:\n+   - Is #[non_exhaustive].\n+   - Has variants: Http, InvalidResponse, UnsupportedTokenType, ConfigError,\n+     Unavailable.\n+   - Display output for Http variant does NOT leak secrets.\n+   - Write a test: format a TokenError::ConfigError, assert it renders.\n+\n+5. TokenResponse:\n+   - Deserializes `{\"access_token\":\"x\",\"expires_in\":3600,\"token_type\":\"Bearer\"}`.\n+   - Deserializes `{\"access_token\":\"x\"}` (optional fields missing).\n+   - Does NOT implement Serialize.\n+   - Write tests for both cases.\n+\n+6. ClientAuthMethod: Default is Basic.\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+\n+8. TESTS: `cargo test -p modkit-auth` — all new AND existing tests pass.\n+\n+9. NO SECRETS IN DEBUG: grep all new files for `impl Debug` — every manual\n+   impl redacts client_secret / token values. No `#[derive(Debug)]` on types\n+   containing secrets.\n+```\n+\n+---\n+\n+## Phase 2 — Token source\n+\n+**Goal:** Implement `AsyncTokenSource` for `aliri_tokens` using `modkit-http::HttpClient`.\n+\n+### Prompt\n+\n+```\n+Implement the OAuth2 token source in libs/modkit-auth/src/oauth2/source.rs.\n+\n+This struct implements aliri_tokens::AsyncTokenSource and performs the actual\n+OAuth2 client credentials exchange using modkit-http::HttpClient.\n+\n+REFERENCE: Study libs/modkit-auth/src/providers/jwks.rs for the established\n+patterns — especially how it constructs HttpClient (lines 86-89), how it calls\n+client.get().send().await (lines 131-139), and how it maps errors via the\n+shared format_http_error (Phase 0).\n+\n+1. Add `aliri_tokens` to modkit-auth/Cargo.toml:\n+   aliri_tokens = { version = \"0.3\", default-features = false, features = [\"rand\"] }\n+   Verify it does NOT pull reqwest (no oauth2 feature).\n+\n+2. Create `src/oauth2/source.rs` with struct `OAuthTokenSource`:\n+   - Fields:\n+     - `client: modkit_http::HttpClient` (built once from config)\n+     - `token_endpoint: Url`\n+     - `client_id: String`\n+     - `client_secret: SecretString`\n+     - `scopes: Option<String>` (pre-joined with spaces, None if empty)\n+     - `auth_method: ClientAuthMethod`\n+     - `extra_headers: Vec<(String, String)>`\n+     - `default_ttl: Duration`\n+\n+   - Constructor `fn new(config: &OAuthClientConfig) -> Result<Self, TokenError>`:\n+     - Build HttpClient from config.http_config (if set) or\n+       HttpClientConfig::token_endpoint() (default).\n+       Map the HttpError from build via format_http_error (Phase 0):\n+       `TokenError::Http(format_http_error(&e, \"OAuth2 token\"))`\n+     - For now, require config.token_endpoint to be Some (OIDC discovery is\n+       Phase 6). Return TokenError::ConfigError if missing.\n+     - Pre-join scopes into a space-separated string.\n+\n+   COMPARE with JWKS: JwksKeyProvider::new() builds the client at lines 86-89\n+   with custom timeout and no retries. Here we use token_endpoint() config\n+   which INCLUDES retries (appropriate for token POST, which is idempotent\n+   for client_credentials).\n+\n+3. Implement `aliri_tokens::AsyncTokenSource` for `OAuthTokenSource`:\n+   - `async fn request_token(&self) -> Result<TokenWithLifetime, BoxError>`:\n+     a. Build form fields: grant_type=client_credentials, optional scope.\n+     b. Build request via `self.client.post(url).form(&fields)?`\n+        COMPARE with JWKS: jwks.rs uses `self.client.get(&self.jwks_uri).send()`\n+        at line 131. Here we use POST with form body.\n+     c. If auth_method is Basic: add Authorization header with\n+        base64(client_id:client_secret) via .header().\n+        If Form: add client_id and client_secret to form fields instead.\n+     d. Add extra_headers via .header().\n+     e. Call .send().await, then error_for_status().\n+     f. Parse response as TokenResponse via .json().\n+        COMPARE with JWKS: jwks.rs at line 139 does the same `.json().await`.\n+     g. Validate: if token_type is Some and != \"Bearer\" (case-insensitive),\n+        return Err(UnsupportedTokenType).\n+     h. Compute lifetime: Duration::from_secs(expires_in) if present,\n+        else self.default_ttl.\n+     i. Return TokenWithLifetime { token: access_token, lifetime }.\n+\n+   - Map HttpError using format_http_error(&e, \"OAuth2 token\") (Phase 0).\n+     Never include client_secret in error messages.\n+\n+4. Wire source.rs into src/oauth2/mod.rs. OAuthTokenSource is pub(crate) —\n+   it is an internal implementation detail used by Token (Phase 3).\n+\n+DO NOT add:\n+- Manual retry logic (HttpClient retries via RetryLayer).\n+- Manual tracing spans (HttpClient traces via OtelLayer).\n+- Manual timeout logic (HttpClient has request_timeout).\n+- Manual TLS configuration (HttpClient enforces TLS-only).\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 2 (token source) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. DEPENDENCY: `aliri_tokens` in modkit-auth/Cargo.toml with\n+   `default-features = false, features = [\"rand\"]`.\n+   Run: `cargo tree -p cf-modkit-auth | grep reqwest` — must return NOTHING.\n+\n+2. OAuthTokenSource: all fields private. Visibility is pub(crate).\n+\n+3. Constructor:\n+   - Builds HttpClient from HttpClientConfig::token_endpoint() by default.\n+   - Accepts http_config override from OAuthClientConfig.\n+   - Maps HttpError from client build via format_http_error.\n+   - Returns TokenError::ConfigError if token_endpoint is None.\n+\n+4. AsyncTokenSource::request_token():\n+   - Form body includes grant_type=client_credentials.\n+   - Scope included only when non-empty.\n+   - Basic auth: header is \"Basic {base64(id:secret)}\".\n+   - Form auth: client_id + client_secret in form body, no Authorization header.\n+   - Extra headers applied.\n+   - error_for_status() called before json().\n+   - token_type validation case-insensitive.\n+   - Missing expires_in falls back to default_ttl.\n+   - Returned lifetime is Duration, not zero.\n+\n+5. SECRET SAFETY:\n+   - grep source.rs for \"client_secret\" — only in struct field and\n+     form body / Authorization header construction. Never in error messages,\n+     tracing, or Debug output.\n+   - access_token is never logged.\n+\n+6. ERROR MAPPING uses shared format_http_error from Phase 0\n+   (not a local exhaustive match).\n+\n+7. NO DUPLICATE CONCERNS:\n+   - No manual retry logic.\n+   - No manual tracing spans.\n+   - No manual timeout logic.\n+   - No manual TLS configuration.\n+\n+8. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+9. TESTS (use httpmock + allow_insecure_http, same pattern as\n+   jwks.rs test_provider_with_http at line 482):\n+   - Mock server returns valid token response → assert access_token + lifetime.\n+   - Mock returns response without expires_in → assert default_ttl used.\n+   - Mock returns token_type: \"mac\" → assert error.\n+   - Empty scopes → assert scope param absent from request body.\n+   - Basic auth → assert Authorization header present in mock request.\n+   - Form auth → assert client_id in form body, no Authorization header.\n+```\n+\n+---\n+\n+## Phase 3 — Token handle (watcher + invalidate)\n+\n+**Goal:** Implement the public `Token` struct that wraps `aliri_tokens` watcher with `ArcSwap`-based invalidation.\n+\n+### Prompt\n+\n+```\n+Implement the public Token handle in libs/modkit-auth/src/oauth2/token.rs.\n+\n+This is the public API that modules use to get bearer tokens. It wraps an\n+aliri_tokens watcher and supports invalidation via ArcSwap rotation.\n+\n+REFERENCE: Study the ArcSwap usage in libs/modkit-auth/src/providers/jwks.rs:\n+- jwks.rs:41 — `keys: Arc<ArcSwap<HashMap<String, DecodingKey>>>`\n+- jwks.rs:190 — `self.keys.store(Arc::new(new_keys))` for atomic swap\n+- jwks.rs:299 — `let keys = self.keys.load()` for lock-free read\n+The Token handle follows the same pattern but swaps the entire watcher.\n+\n+1. Create `src/oauth2/token.rs` with:\n+\n+   struct TokenInner {\n+       watcher: aliri_tokens::TokenWatcher<String>,\n+   }\n+\n+   #[derive(Clone)]\n+   pub struct Token {\n+       inner: Arc<ArcSwap<TokenInner>>,\n+       source_factory: Arc<dyn Fn() -> Result<OAuthTokenSource, TokenError> + Send + Sync>,\n+       watcher_config: Arc<WatcherConfig>,\n+   }\n+\n+   struct WatcherConfig {\n+       refresh_offset: Duration,\n+       jitter_max: Duration,\n+       min_refresh_period: Duration,\n+   }\n+\n+2. Constructor `Token::new(config: OAuthClientConfig) -> Result<Self, TokenError>`:\n+   - Call config.validate().\n+   - Create OAuthTokenSource::new(&config).\n+   - Create aliri_tokens watcher from the source with the refresh parameters.\n+   - Store a source_factory closure that captures the config and can\n+     recreate the source for invalidation.\n+   - Wrap the watcher in TokenInner, then Arc, then ArcSwap.\n+\n+3. `pub async fn get(&self) -> Result<SecretString, TokenError>`:\n+   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n+   - Call `guard.watcher.token().await` to get the cached/refreshed token.\n+   - Wrap the raw String in SecretString immediately.\n+   - Map aliri_tokens errors to TokenError::Unavailable.","path":"libs/modkit-auth/docs/modkit-auth-client-impl.md","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Documentation incorrectly describes `get()` as async.**\n\nLine 423 states `guard.watcher.token().await` but `TokenWatcher::token()` is synchronous and `Token::get()` is implemented as a sync method (line 109 in token.rs). The documentation should be updated to reflect the actual non-async signature.\n\n\n\n<details>\n<summary>📝 Suggested fix</summary>\n\n```diff\n-3. `pub async fn get(&self) -> Result<SecretString, TokenError>`:\n-   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n-   - Call `guard.watcher.token().await` to get the cached/refreshed token.\n+3. `pub fn get(&self) -> Result<SecretString, TokenError>`:\n+   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n+   - Call `guard.watcher.token()` to get the cached/refreshed token (synchronous).\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/modkit-auth-client-impl.md` around lines 421 - 425, The\ndocumentation incorrectly describes get() as async and calling\nguard.watcher.token().await; update the doc for the method `get()` to show it's\nsynchronous (remove \"pub async fn\" and any mention of `.await`), state that it\nuses a lock-free read via `self.inner.load()` and calls the synchronous\n`TokenWatcher::token()` to obtain the token, immediately wraps the returned raw\nString in `SecretString`, and maps aliri_tokens errors to\n`TokenError::Unavailable`; reference `get()` and `TokenWatcher::token()` so\nreaders can find the actual implementations in the code.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T11:07:38Z","updated_at":"2026-02-10T16:57:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319386","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319386"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319386"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":421,"original_start_line":421,"start_side":"RIGHT","line":425,"original_line":425,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":425,"position":425,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319390","pull_request_review_id":3778301492,"id":2787319390,"node_id":"PRRC_kwDOPaLyBs6mIx5e","diff_hunk":"@@ -0,0 +1,793 @@\n+# Implementation Plan — Outbound OAuth2 Client Credentials\n+\n+Reference: [0002-modkit-auth-client.md](./0002-modkit-auth-client.md)\n+Required reading: [ModKit unified system](/docs/modkit_unified_system/README.md)\n+\n+Crate: `libs/modkit-auth`\n+\n+## Existing code to reuse\n+\n+Before starting, review the existing JWKS provider at\n+`libs/modkit-auth/src/providers/jwks.rs`. It is the closest analog to the OAuth2\n+token source and establishes patterns that must be followed:\n+\n+| Concern | JWKS (existing) | OAuth2 (new) |\n+|---------|----------------|--------------|\n+| HTTP client | `HttpClient::builder().timeout().retry(None).build()` | `HttpClientConfig::token_endpoint()` |\n+| Lock-free cache | `Arc<ArcSwap<HashMap<String,DecodingKey>>>` | `ArcSwap<TokenInner>` |\n+| Background refresh | `run_jwks_refresh_task` + `CancellationToken` | `aliri_tokens` watcher |\n+| Backoff | Manual exponential in `calculate_backoff()` | Delegated to `aliri_tokens` |\n+| Error mapping | `map_http_error(HttpError) -> ClaimsError` | Extract shared `map_http_error` or create parallel `map_http_error(HttpError) -> TokenError` |\n+| Test scaffold | `httpmock` + `allow_insecure_http()` | Same pattern |\n+\n+Key reuse points:\n+\n+1. **`map_http_error`** — `jwks.rs:417-473` maps every `HttpError` variant.\n+   Extract it into a shared helper `src/providers/http_error_mapping.rs` or\n+   duplicate the pattern for `TokenError`. Extraction is preferred to keep the\n+   exhaustive match in one place (HttpError is `#[non_exhaustive]`).\n+2. **`ArcSwap` lock-free read pattern** — `jwks.rs` uses `keys.load()` for\n+   reads and `keys.store(Arc::new(...))` for writes. Token must follow the\n+   same pattern.\n+3. **`HttpClient` construction** — `jwks.rs:86-89` builds a client with no\n+   retries (JWKS handles its own). OAuth source uses\n+   `HttpClientConfig::token_endpoint()` instead (retries are appropriate for\n+   token acquisition).\n+4. **Test pattern** — `jwks.rs:482-499` (`test_provider_with_http`) shows\n+   how to build a test `HttpClient` with `allow_insecure_http()` for\n+   `httpmock`. Reuse the same approach.\n+5. **Dependencies already available** — `modkit-auth/Cargo.toml` already has\n+   `arc-swap`, `modkit-http`, `tokio-util`, `httpmock` (dev). Only\n+   `aliri_tokens` needs to be added.\n+\n+---\n+\n+## Phase 0 — Extract shared HTTP error mapping\n+\n+**Goal:** Extract `map_http_error` from JWKS into a reusable utility so both JWKS and OAuth2 can use it without duplicating the exhaustive match.\n+\n+### Prompt\n+\n+```\n+Extract the HTTP error mapping function from the JWKS provider into a shared\n+utility in libs/modkit-auth.\n+\n+Current state: `libs/modkit-auth/src/providers/jwks.rs` lines 417-473 contain\n+`fn map_http_error(e: modkit_http::HttpError) -> ClaimsError` that exhaustively\n+maps every HttpError variant. This pattern will be needed by the OAuth2 token\n+source as well.\n+\n+1. Create `src/http_error.rs` with a generic mapping function:\n+\n+   pub fn format_http_error(e: &modkit_http::HttpError, prefix: &str) -> String\n+\n+   This function takes an HttpError reference and a context prefix (e.g. \"JWKS\",\n+   \"OAuth2 token\") and returns a human-readable error message string. It must\n+   handle every variant of HttpError (which is #[non_exhaustive]) with a\n+   catch-all `_ =>` arm at the end.\n+\n+   Replicate the exact mapping logic from jwks.rs:417-473, but replace the\n+   hardcoded \"JWKS\" prefix with the `prefix` parameter.\n+\n+2. Update `src/providers/jwks.rs`:\n+   - Replace the local `map_http_error` function with a call to the shared one:\n+\n+     fn map_http_error(e: modkit_http::HttpError) -> ClaimsError {\n+         ClaimsError::JwksFetchFailed(crate::http_error::format_http_error(&e, \"JWKS\"))\n+     }\n+\n+   - Delete the old exhaustive match from jwks.rs.\n+\n+3. Wire `pub mod http_error` into src/lib.rs.\n+\n+4. Run `cargo test -p modkit-auth` — all existing JWKS tests must pass unchanged.\n+\n+The OAuth2 token source (Phase 2) will use the same shared function:\n+    TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 0 (shared HTTP error mapping) in libs/modkit-auth.\n+\n+Check every item:\n+\n+1. FILE EXISTS: src/http_error.rs with pub fn format_http_error.\n+\n+2. EXHAUSTIVE MATCH: format_http_error handles these HttpError variants:\n+   HttpStatus, Json, Timeout, DeadlineExceeded, Transport, BodyTooLarge,\n+   Tls, RequestBuild, InvalidHeaderName, InvalidHeaderValue, FormEncode,\n+   Overloaded, ServiceClosed, InvalidUri, InvalidScheme, plus a `_ =>` arm.\n+\n+3. PREFIX USED: Every match arm includes the prefix parameter in its output.\n+   e.g. \"{prefix} HTTP {status}\" not \"JWKS HTTP {status}\".\n+\n+4. JWKS UNCHANGED: jwks.rs now calls format_http_error(&e, \"JWKS\").\n+   The local exhaustive match is removed.\n+   Run `cargo test -p modkit-auth` — all 11 existing JWKS tests pass.\n+\n+5. NO SECRET LEAKS: format_http_error never includes request body, auth\n+   headers, or token values — only status codes, error messages, and URLs.\n+\n+6. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+```\n+\n+---\n+\n+## Phase 1 — Foundation types\n+\n+**Goal:** Define configuration, error, and response types. No async code yet.\n+\n+### Prompt\n+\n+```\n+Implement foundation types for outbound OAuth2 client credentials in\n+libs/modkit-auth.\n+\n+Create a new module `src/oauth2/` with:\n+\n+1. `src/oauth2/mod.rs` — re-exports.\n+\n+2. `src/oauth2/config.rs` — `OAuthClientConfig`:\n+   - `token_endpoint: Option<Url>` (direct endpoint)\n+   - `issuer_url: Option<Url>` (for OIDC discovery, Phase 6)\n+   - Exactly one of `token_endpoint` or `issuer_url` must be set; validate in a\n+     `fn validate(&self) -> Result<(), TokenError>` method.\n+   - `client_id: String`\n+   - `client_secret: SecretString` (use the SecretString from this module)\n+   - `scopes: Vec<String>`\n+   - `auth_method: ClientAuthMethod` enum { Basic, Form } (default Basic)\n+   - `extra_headers: Vec<(String, String)>` (default empty)\n+   - `refresh_offset: Duration` (default 30 min)\n+   - `jitter_max: Duration` (default 5 min)\n+   - `min_refresh_period: Duration` (default 10 sec)\n+   - `default_ttl: Duration` (default 5 min — used when expires_in missing)\n+   - `http_config: Option<modkit_http::HttpClientConfig>` (override for token\n+     endpoint client; defaults to HttpClientConfig::token_endpoint())\n+   All durations use `std::time::Duration`. Derive `Clone`. Do NOT derive `Debug`\n+   for the whole struct — implement `Debug` manually, redacting `client_secret`.\n+\n+3. `src/oauth2/error.rs` — `TokenError` enum (thiserror):\n+   - `Http(String)` — transport/status errors (store formatted message, not\n+     the raw HttpError, to avoid leaking internals; use the shared\n+     `format_http_error` from Phase 0 when constructing)\n+   - `InvalidResponse(String)` — malformed token response\n+   - `UnsupportedTokenType(String)` — token_type is not Bearer\n+   - `ConfigError(String)` — invalid config (e.g. both endpoints set)\n+   - `Unavailable(String)` — watcher not ready / shutdown\n+   Mark `#[non_exhaustive]`. Implement Display via thiserror. Ensure no variant\n+   can ever contain secret values.\n+   Follow the same pattern as `AuthError` in src/errors.rs.\n+\n+4. `src/oauth2/types.rs`:\n+   - `SecretString` — newtype over `String` with `Debug` printing \"[REDACTED]\",\n+     `Display` printing \"[REDACTED]\", `Clone`, and `Drop` that zeroizes the\n+     inner buffer (use `unsafe { core::ptr::write_bytes }` on the Vec<u8>\n+     backing buffer, or the `zeroize` crate if available in workspace).\n+     Provide `fn expose(&self) -> &str` for controlled access.\n+   - `TokenResponse` (serde `Deserialize`):\n+     - `access_token: String`\n+     - `expires_in: Option<u64>`\n+     - `token_type: Option<String>`\n+     Deserialize only — never derive Serialize. Use `#[serde(default)]` for\n+     optional fields.\n+   - `ClientAuthMethod` enum { Basic, Form } with `Default` = Basic.\n+\n+Wire `mod oauth2` into `src/lib.rs` and re-export `OAuthClientConfig`,\n+`TokenError`, `SecretString`, `ClientAuthMethod` from the crate root\n+(Token will be re-exported in Phase 3).\n+\n+Follow existing patterns in modkit-auth: thiserror for errors, no unwrap in\n+library code, #[non_exhaustive] on public enums.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 1 (foundation types) of the OAuth2 client credentials\n+implementation in libs/modkit-auth/src/oauth2/.\n+\n+Check every item:\n+\n+1. FILES EXIST: mod.rs, config.rs, error.rs, types.rs under src/oauth2/.\n+   `mod oauth2` is declared in src/lib.rs.\n+\n+2. SecretString:\n+   - Debug and Display both print \"[REDACTED]\", never the inner value.\n+   - `expose(&self) -> &str` is the only way to access the inner value.\n+   - Clone is implemented.\n+   - Drop zeroizes the buffer (write_bytes or zeroize).\n+   - Write a unit test: create a SecretString, format with Debug and Display,\n+     assert neither contains the original value. Assert expose() returns it.\n+\n+3. OAuthClientConfig:\n+   - Has all fields from the design (token_endpoint, issuer_url, client_id,\n+     client_secret, scopes, auth_method, extra_headers, refresh_offset,\n+     jitter_max, min_refresh_period, default_ttl, http_config).\n+   - Does NOT derive Debug — has manual Debug impl that redacts client_secret.\n+   - validate() returns error if both token_endpoint and issuer_url are set,\n+     or if neither is set.\n+   - Write a unit test for validate() with both, neither, and exactly-one.\n+\n+4. TokenError:\n+   - Is #[non_exhaustive].\n+   - Has variants: Http, InvalidResponse, UnsupportedTokenType, ConfigError,\n+     Unavailable.\n+   - Display output for Http variant does NOT leak secrets.\n+   - Write a test: format a TokenError::ConfigError, assert it renders.\n+\n+5. TokenResponse:\n+   - Deserializes `{\"access_token\":\"x\",\"expires_in\":3600,\"token_type\":\"Bearer\"}`.\n+   - Deserializes `{\"access_token\":\"x\"}` (optional fields missing).\n+   - Does NOT implement Serialize.\n+   - Write tests for both cases.\n+\n+6. ClientAuthMethod: Default is Basic.\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+\n+8. TESTS: `cargo test -p modkit-auth` — all new AND existing tests pass.\n+\n+9. NO SECRETS IN DEBUG: grep all new files for `impl Debug` — every manual\n+   impl redacts client_secret / token values. No `#[derive(Debug)]` on types\n+   containing secrets.\n+```\n+\n+---\n+\n+## Phase 2 — Token source\n+\n+**Goal:** Implement `AsyncTokenSource` for `aliri_tokens` using `modkit-http::HttpClient`.\n+\n+### Prompt\n+\n+```\n+Implement the OAuth2 token source in libs/modkit-auth/src/oauth2/source.rs.\n+\n+This struct implements aliri_tokens::AsyncTokenSource and performs the actual\n+OAuth2 client credentials exchange using modkit-http::HttpClient.\n+\n+REFERENCE: Study libs/modkit-auth/src/providers/jwks.rs for the established\n+patterns — especially how it constructs HttpClient (lines 86-89), how it calls\n+client.get().send().await (lines 131-139), and how it maps errors via the\n+shared format_http_error (Phase 0).\n+\n+1. Add `aliri_tokens` to modkit-auth/Cargo.toml:\n+   aliri_tokens = { version = \"0.3\", default-features = false, features = [\"rand\"] }\n+   Verify it does NOT pull reqwest (no oauth2 feature).\n+\n+2. Create `src/oauth2/source.rs` with struct `OAuthTokenSource`:\n+   - Fields:\n+     - `client: modkit_http::HttpClient` (built once from config)\n+     - `token_endpoint: Url`\n+     - `client_id: String`\n+     - `client_secret: SecretString`\n+     - `scopes: Option<String>` (pre-joined with spaces, None if empty)\n+     - `auth_method: ClientAuthMethod`\n+     - `extra_headers: Vec<(String, String)>`\n+     - `default_ttl: Duration`\n+\n+   - Constructor `fn new(config: &OAuthClientConfig) -> Result<Self, TokenError>`:\n+     - Build HttpClient from config.http_config (if set) or\n+       HttpClientConfig::token_endpoint() (default).\n+       Map the HttpError from build via format_http_error (Phase 0):\n+       `TokenError::Http(format_http_error(&e, \"OAuth2 token\"))`\n+     - For now, require config.token_endpoint to be Some (OIDC discovery is\n+       Phase 6). Return TokenError::ConfigError if missing.\n+     - Pre-join scopes into a space-separated string.\n+\n+   COMPARE with JWKS: JwksKeyProvider::new() builds the client at lines 86-89\n+   with custom timeout and no retries. Here we use token_endpoint() config\n+   which INCLUDES retries (appropriate for token POST, which is idempotent\n+   for client_credentials).\n+\n+3. Implement `aliri_tokens::AsyncTokenSource` for `OAuthTokenSource`:\n+   - `async fn request_token(&self) -> Result<TokenWithLifetime, BoxError>`:\n+     a. Build form fields: grant_type=client_credentials, optional scope.\n+     b. Build request via `self.client.post(url).form(&fields)?`\n+        COMPARE with JWKS: jwks.rs uses `self.client.get(&self.jwks_uri).send()`\n+        at line 131. Here we use POST with form body.\n+     c. If auth_method is Basic: add Authorization header with\n+        base64(client_id:client_secret) via .header().\n+        If Form: add client_id and client_secret to form fields instead.\n+     d. Add extra_headers via .header().\n+     e. Call .send().await, then error_for_status().\n+     f. Parse response as TokenResponse via .json().\n+        COMPARE with JWKS: jwks.rs at line 139 does the same `.json().await`.\n+     g. Validate: if token_type is Some and != \"Bearer\" (case-insensitive),\n+        return Err(UnsupportedTokenType).\n+     h. Compute lifetime: Duration::from_secs(expires_in) if present,\n+        else self.default_ttl.\n+     i. Return TokenWithLifetime { token: access_token, lifetime }.\n+\n+   - Map HttpError using format_http_error(&e, \"OAuth2 token\") (Phase 0).\n+     Never include client_secret in error messages.\n+\n+4. Wire source.rs into src/oauth2/mod.rs. OAuthTokenSource is pub(crate) —\n+   it is an internal implementation detail used by Token (Phase 3).\n+\n+DO NOT add:\n+- Manual retry logic (HttpClient retries via RetryLayer).\n+- Manual tracing spans (HttpClient traces via OtelLayer).\n+- Manual timeout logic (HttpClient has request_timeout).\n+- Manual TLS configuration (HttpClient enforces TLS-only).\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 2 (token source) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. DEPENDENCY: `aliri_tokens` in modkit-auth/Cargo.toml with\n+   `default-features = false, features = [\"rand\"]`.\n+   Run: `cargo tree -p cf-modkit-auth | grep reqwest` — must return NOTHING.\n+\n+2. OAuthTokenSource: all fields private. Visibility is pub(crate).\n+\n+3. Constructor:\n+   - Builds HttpClient from HttpClientConfig::token_endpoint() by default.\n+   - Accepts http_config override from OAuthClientConfig.\n+   - Maps HttpError from client build via format_http_error.\n+   - Returns TokenError::ConfigError if token_endpoint is None.\n+\n+4. AsyncTokenSource::request_token():\n+   - Form body includes grant_type=client_credentials.\n+   - Scope included only when non-empty.\n+   - Basic auth: header is \"Basic {base64(id:secret)}\".\n+   - Form auth: client_id + client_secret in form body, no Authorization header.\n+   - Extra headers applied.\n+   - error_for_status() called before json().\n+   - token_type validation case-insensitive.\n+   - Missing expires_in falls back to default_ttl.\n+   - Returned lifetime is Duration, not zero.\n+\n+5. SECRET SAFETY:\n+   - grep source.rs for \"client_secret\" — only in struct field and\n+     form body / Authorization header construction. Never in error messages,\n+     tracing, or Debug output.\n+   - access_token is never logged.\n+\n+6. ERROR MAPPING uses shared format_http_error from Phase 0\n+   (not a local exhaustive match).\n+\n+7. NO DUPLICATE CONCERNS:\n+   - No manual retry logic.\n+   - No manual tracing spans.\n+   - No manual timeout logic.\n+   - No manual TLS configuration.\n+\n+8. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+9. TESTS (use httpmock + allow_insecure_http, same pattern as\n+   jwks.rs test_provider_with_http at line 482):\n+   - Mock server returns valid token response → assert access_token + lifetime.\n+   - Mock returns response without expires_in → assert default_ttl used.\n+   - Mock returns token_type: \"mac\" → assert error.\n+   - Empty scopes → assert scope param absent from request body.\n+   - Basic auth → assert Authorization header present in mock request.\n+   - Form auth → assert client_id in form body, no Authorization header.\n+```\n+\n+---\n+\n+## Phase 3 — Token handle (watcher + invalidate)\n+\n+**Goal:** Implement the public `Token` struct that wraps `aliri_tokens` watcher with `ArcSwap`-based invalidation.\n+\n+### Prompt\n+\n+```\n+Implement the public Token handle in libs/modkit-auth/src/oauth2/token.rs.\n+\n+This is the public API that modules use to get bearer tokens. It wraps an\n+aliri_tokens watcher and supports invalidation via ArcSwap rotation.\n+\n+REFERENCE: Study the ArcSwap usage in libs/modkit-auth/src/providers/jwks.rs:\n+- jwks.rs:41 — `keys: Arc<ArcSwap<HashMap<String, DecodingKey>>>`\n+- jwks.rs:190 — `self.keys.store(Arc::new(new_keys))` for atomic swap\n+- jwks.rs:299 — `let keys = self.keys.load()` for lock-free read\n+The Token handle follows the same pattern but swaps the entire watcher.\n+\n+1. Create `src/oauth2/token.rs` with:\n+\n+   struct TokenInner {\n+       watcher: aliri_tokens::TokenWatcher<String>,\n+   }\n+\n+   #[derive(Clone)]\n+   pub struct Token {\n+       inner: Arc<ArcSwap<TokenInner>>,\n+       source_factory: Arc<dyn Fn() -> Result<OAuthTokenSource, TokenError> + Send + Sync>,\n+       watcher_config: Arc<WatcherConfig>,\n+   }\n+\n+   struct WatcherConfig {\n+       refresh_offset: Duration,\n+       jitter_max: Duration,\n+       min_refresh_period: Duration,\n+   }\n+\n+2. Constructor `Token::new(config: OAuthClientConfig) -> Result<Self, TokenError>`:\n+   - Call config.validate().\n+   - Create OAuthTokenSource::new(&config).\n+   - Create aliri_tokens watcher from the source with the refresh parameters.\n+   - Store a source_factory closure that captures the config and can\n+     recreate the source for invalidation.\n+   - Wrap the watcher in TokenInner, then Arc, then ArcSwap.\n+\n+3. `pub async fn get(&self) -> Result<SecretString, TokenError>`:\n+   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n+   - Call `guard.watcher.token().await` to get the cached/refreshed token.\n+   - Wrap the raw String in SecretString immediately.\n+   - Map aliri_tokens errors to TokenError::Unavailable.\n+\n+4. `pub async fn invalidate(&self)`:\n+   - Call source_factory() to create a new OAuthTokenSource.\n+   - Create a new watcher with same WatcherConfig.\n+   - `self.inner.store(Arc::new(TokenInner { watcher }))` — atomic swap\n+     (compare jwks.rs:190).\n+   - Old watcher is dropped when last reference is released.\n+   - If source_factory fails: log warning via `tracing::warn!`, do NOT swap,\n+     do NOT panic.\n+\n+5. Re-export Token from src/oauth2/mod.rs and from the crate root.\n+\n+Use arc-swap from workspace (already in Cargo.toml).\n+Token must be Clone + Send + Sync.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 3 (Token handle) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. Token is Clone + Send + Sync:\n+   - Write a compile-time assertion:\n+     fn _assert_token_traits() {\n+         fn assert_send_sync_clone<T: Send + Sync + Clone>() {}\n+         assert_send_sync_clone::<Token>();\n+     }\n+\n+2. Token::new():\n+   - Calls config.validate().\n+   - Creates OAuthTokenSource.\n+   - Creates aliri_tokens watcher with refresh_offset, jitter_max,\n+     min_refresh_period from config.\n+   - Returns Result, not panics.\n+\n+3. Token::get():\n+   - Returns SecretString (not raw String).\n+   - Uses self.inner.load() (lock-free read, same as jwks.rs:299).\n+   - Maps watcher errors to TokenError::Unavailable.\n+\n+4. Token::invalidate():\n+   - Creates a NEW watcher (does not reuse the old one).\n+   - Uses self.inner.store() for atomic swap (same as jwks.rs:190).\n+   - If source_factory fails: logs warning, does NOT swap, does NOT panic.\n+   - Old watcher is eventually dropped (no leak).\n+\n+5. SECRET SAFETY:\n+   - Token::get() wraps the raw token string in SecretString immediately.\n+   - The raw String is never stored in Token or TokenInner beyond the watcher.\n+   - No Debug impl on Token or TokenInner prints token values.\n+\n+6. ArcSwap PATTERN matches JWKS:\n+   - Uses ArcSwap<TokenInner> (not RwLock).\n+   - get() uses .load() (lock-free read).\n+   - invalidate() uses .store() (atomic swap).\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+8. TESTS (same httpmock pattern as JWKS tests):\n+   - Token::new() with valid config succeeds.\n+   - Token::new() with invalid config (both endpoints) returns Err.\n+   - Token::get() returns SecretString whose expose() matches mock token.\n+   - Token::invalidate() causes next get() to re-fetch (verify mock hit\n+     count increments after invalidate).\n+   - Two concurrent get() calls do not deadlock.\n+```\n+\n+---\n+\n+## Phase 4 — Tower auth layer\n+\n+**Goal:** Implement `BearerAuthLayer` / `BearerAuthService` that injects `Authorization: Bearer <token>` on every request.\n+\n+### Prompt\n+\n+```\n+Implement the outbound bearer auth tower layer in\n+libs/modkit-auth/src/oauth2/layer.rs.\n+\n+REFERENCE: Follow the exact tower Layer + Service pattern used by modkit-http:\n+- libs/modkit-http/src/layers/otel.rs — OtelLayer + OtelService (simplest async layer)\n+- libs/modkit-http/src/layers/user_agent.rs — UserAgentLayer + UserAgentService\n+  (synchronous header injection, closest conceptual match, but our layer needs\n+  async because token.get() is async)\n+\n+NOTE: The existing bearer token EXTRACTION (inbound) is in\n+libs/modkit-auth/src/axum_ext.rs:221-227 (extract_bearer_token). Our layer does\n+the INVERSE — it INJECTS a bearer token into outbound requests.\n+\n+1. `BearerAuthLayer`:\n+   - Fields:\n+     - `token: Token`\n+     - `header_name: http::header::HeaderName` (default: AUTHORIZATION)\n+   - Constructors:\n+     - `fn new(token: Token) -> Self` (uses AUTHORIZATION)\n+     - `fn with_header_name(token: Token, header_name: HeaderName) -> Self`\n+   - Implement `tower::Layer<S>` producing `BearerAuthService<S>`.\n+   - Derive Clone.\n+\n+2. `BearerAuthService<S>`:\n+   - Fields: inner: S, token: Token, header_name: HeaderName\n+   - Derive Clone.\n+   - Implement `tower::Service<http::Request<B>>` where\n+     S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>:\n+     - poll_ready: delegate to inner.\n+     - call: return a boxed future (Pin<Box<dyn Future + Send>>) that:\n+       a. Calls self.token.get().await.\n+       b. On success: set header `{header_name}: Bearer {token.expose()}`\n+          on the request. The expose() value must NOT be bound to a long-lived\n+          variable.\n+       c. On error: map TokenError to HttpError. Since HttpError is\n+          #[non_exhaustive] and lives in modkit-http, map via\n+          `HttpError::Transport(Box::new(token_error))` — this preserves the\n+          error chain without modifying modkit-http's error enum.\n+       d. Forward request to inner service.\n+\n+   Compare with OtelService (otel.rs) which also uses a boxed async future\n+   in call() to handle async tracing operations.\n+\n+3. Re-export BearerAuthLayer from src/oauth2/mod.rs and the crate root.\n+\n+IMPORTANT: token.expose() is used only transiently for header value\n+construction. Do not store it in any struct field or log it.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 4 (tower auth layer) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. LAYER PATTERN matches modkit-http conventions:\n+   - BearerAuthLayer implements tower::Layer<S>.\n+   - BearerAuthService<S> implements tower::Service<Request<B>>.\n+   - Both derive Clone.\n+\n+2. HEADER INJECTION:\n+   - Default header is AUTHORIZATION.\n+   - Value format is \"Bearer {token}\" (with space, no extra whitespace).\n+   - with_header_name allows custom header (e.g. \"X-Api-Key\").\n+   - Header set BEFORE calling inner service.\n+\n+3. ASYNC HANDLING:\n+   - call() returns a boxed future that is Send + 'static.\n+   - token.get().await called inside the future (not synchronously in call()).\n+   - poll_ready only checks inner readiness.\n+\n+4. ERROR HANDLING:\n+   - TokenError mapped to HttpError::Transport(Box::new(token_error)).\n+   - If token.get() fails, request is NOT forwarded to inner service.\n+   - Error does not contain the token value.\n+\n+5. SECRET SAFETY:\n+   - token.expose() called only in header value construction.\n+   - grep layer.rs for \"tracing\" / \"debug!\" / \"info!\" / \"warn!\" — if present,\n+     must NOT include the token value.\n+\n+6. INVERSE OF EXTRACTION: compare with axum_ext.rs:221 extract_bearer_token\n+   which strips \"Bearer \" prefix for inbound. Our layer adds \"Bearer \" prefix\n+   for outbound. Format is consistent.\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+8. TESTS:\n+   - Mock inner service captures request headers.\n+   - Wrap with BearerAuthLayer, send request → assert Authorization header\n+     is \"Bearer {expected}\".\n+   - Custom header name → assert custom header set.\n+   - Token error → assert request not forwarded, error returned.\n+```\n+\n+---\n+\n+## Phase 5 — HttpClientBuilder integration\n+\n+**Goal:** Add `.with_bearer_auth(token)` to `HttpClientBuilder` so the auth layer is part of the composed tower stack.\n+\n+### Prompt\n+\n+```\n+Add bearer auth support to modkit-http's HttpClientBuilder.\n+\n+REFERENCE: Read libs/modkit-http/src/builder.rs to understand the current tower\n+stack composition. The stack order is:\n+\n+  Buffer → OTel → LoadShed/Concurrency → Retry → Timeout → UserAgent → Decompress → Redirect → hyper\n+\n+The auth layer must be inserted INSIDE retry but OUTSIDE timeout:\n+\n+  Buffer → OTel → LoadShed/Concurrency → Retry → **BearerAuth** → Timeout → UserAgent → ...\n+\n+This ensures: (a) retries re-acquire the token on each attempt, (b) token\n+acquisition time counts toward the per-request timeout.\n+\n+1. Add modkit-auth as an OPTIONAL dependency of modkit-http behind a feature flag.\n+\n+   In libs/modkit-http/Cargo.toml:\n+   [features]\n+   oauth = [\"dep:modkit-auth\"]\n+\n+   [dependencies]\n+   modkit-auth = { workspace = true, optional = true }\n+\n+2. In builder.rs, add field (feature-gated):\n+   #[cfg(feature = \"oauth\")]\n+   bearer_auth: Option<modkit_auth::oauth2::BearerAuthLayer>,\n+\n+   Initialize to None in HttpClientBuilder::new().\n+\n+3. Add builder methods (feature-gated):\n+   #[cfg(feature = \"oauth\")]\n+   pub fn with_bearer_auth(mut self, token: modkit_auth::Token) -> Self\n+   #[cfg(feature = \"oauth\")]\n+   pub fn with_bearer_auth_header(mut self, token: modkit_auth::Token, header_name: HeaderName) -> Self\n+\n+4. In build(), insert BearerAuthLayer conditionally.\n+   Use tower::util::option_layer or manual Either wrapping.\n+   The layer goes between RetryLayer and TimeoutLayer in the ServiceBuilder chain.\n+\n+   When oauth feature is disabled: no changes to build() at all (use #[cfg]).\n+   When oauth feature is enabled but bearer_auth is None: layer is a passthrough.\n+\n+IMPORTANT: When the `oauth` feature is not enabled, there must be ZERO impact\n+on compilation, binary size, or API surface. All oauth code behind\n+#[cfg(feature = \"oauth\")].\n+```","path":"libs/modkit-auth/docs/modkit-auth-client-impl.md","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Phase 5 documentation diverges from actual implementation.**\n\nThe documentation describes a feature-gated `oauth` integration with `with_bearer_auth()` method and `BearerAuthLayer` field in `modkit-http`. The actual implementation provides a generic `with_auth_layer()` hook without feature flags.\n\nThe implemented design is better: `modkit-http` provides a generic auth layer hook, and `modkit-auth` uses an extension trait (`HttpClientBuilderExt`) to provide `with_bearer_auth()`. This avoids circular dependencies and allows any auth layer type.\n\nConsider updating the documentation to reflect the actual decoupled architecture.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/modkit-auth-client-impl.md` around lines 602 - 654,\nUpdate the Phase 5 docs to reflect the actual decoupled implementation: remove\ninstructions about adding an oauth feature and a bearer_auth field on\nHttpClientBuilder, and instead describe the existing generic hook\nHttpClientBuilder::with_auth_layer and the extension trait\nmodkit_auth::HttpClientBuilderExt that provides with_bearer_auth and\nwith_bearer_auth_header; explain that modkit-auth implements the bearer layer\nand exposes the extension trait so no workspace dependency or feature flag is\nadded to modkit-http and that all oauth-specific code lives in modkit-auth (no\nchanges to build() in builder.rs).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T11:07:38Z","updated_at":"2026-02-10T11:07:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319390","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319390"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319390"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319390/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":602,"original_start_line":602,"start_side":"RIGHT","line":654,"original_line":654,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":654,"position":654,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319394","pull_request_review_id":3778301492,"id":2787319394,"node_id":"PRRC_kwDOPaLyBs6mIx5i","diff_hunk":"@@ -0,0 +1,283 @@\n+#![allow(clippy::use_debug)]\n+#![allow(clippy::non_ascii_literal)]\n+#![allow(clippy::expect_used)] // example code, not production\n+#![allow(dead_code)] // IDP-dependent examples are commented out in main()\n+\n+/// Outbound `OAuth2` client credentials -- usage examples.\n+///\n+/// This is the Rust equivalent of the Go pattern:\n+///\n+/// ```go\n+/// tokenProvider, _ := tokenprovider.New(idpURL, clientID, clientSecret, ...)\n+/// resolverClient, _ := tenantsresolver.NewClient(address, tokenProvider, ...)\n+/// ```\n+///\n+/// NOTE: This example requires a running IDP and target API to work.\n+///       It is meant as a reference for how the API is used, not as a\n+///       runnable demo.\n+///\n+/// Run with: `cargo run --example oauth2_client_usage`\n+use modkit_auth::{\n+    ClientAuthMethod, HttpClientBuilderExt, OAuthClientConfig, SecretString, Token, TokenError,\n+};\n+use modkit_http::HttpClientBuilder;\n+\n+// ---------------------------------------------------------------------------\n+// Example 1: Direct token endpoint (simplest case)\n+//\n+// Go equivalent:\n+//   tp, _ := tokenprovider.New(tokenURL, clientID, clientSecret, ...)\n+//   client := &http.Client{Transport: authTransport(tp)}\n+// ---------------------------------------------------------------------------\n+async fn direct_token_endpoint() -> Result<(), Box<dyn std::error::Error>> {\n+    println!(\"\\n=== Example 1: Direct token endpoint ===\");\n+\n+    // Step 1 -- create token provider (like tokenprovider.New in Go)\n+    let token = Token::new(OAuthClientConfig {\n+        token_endpoint: Some(\"https://idp.example.com/oauth/token\".parse()?),\n+        client_id: \"my-service\".into(),\n+        client_secret: SecretString::new(\"my-secret\"),\n+        scopes: vec![\"tenants.read\".into(), \"tenants.write\".into()],\n+        ..Default::default()\n+    })\n+    .await?;\n+\n+    // Step 2 -- create HTTP client with automatic Bearer injection\n+    // (like tenantsresolver.NewClient(addr, tokenProvider, ...) in Go)\n+    let client = HttpClientBuilder::new().with_bearer_auth(token).build()?;\n+\n+    // Step 3 -- every request gets Authorization: Bearer <token> automatically\n+    let _resp = client\n+        .get(\"https://resolver.example.com/api/v1/tenants\")\n+        .send()\n+        .await?;\n+\n+    println!(\"  Request sent with auto-injected Bearer token\");\n+    Ok(())\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Example 2: OIDC discovery (issuer URL -> .well-known -> token_endpoint)\n+//\n+// Go equivalent:\n+//   tp, _ := tokenprovider.New(issuerURL, clientID, clientSecret, ...)\n+//   // internally calls fetchTokenURL -> /.well-known/openid-configuration\n+// ---------------------------------------------------------------------------\n+async fn oidc_discovery() -> Result<(), Box<dyn std::error::Error>> {\n+    println!(\"\\n=== Example 2: OIDC discovery ===\");\n+\n+    // Only provide the issuer URL -- the token endpoint is resolved\n+    // automatically via {issuer_url}/.well-known/openid-configuration\n+    let token = Token::new(OAuthClientConfig {\n+        issuer_url: Some(\"https://idp.example.com\".parse()?),\n+        client_id: \"my-service\".into(),\n+        client_secret: SecretString::new(\"my-secret\"),\n+        ..Default::default()\n+    })\n+    .await?;\n+\n+    let client = HttpClientBuilder::new().with_bearer_auth(token).build()?;\n+\n+    let _resp = client.get(\"https://api.example.com/data\").send().await?;\n+\n+    println!(\"  Token endpoint discovered and token acquired\");\n+    Ok(())\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Example 3: Shared token across multiple service clients\n+//\n+// Go equivalent:\n+//   tp, _ := tokenprovider.New(...)\n+//   resolverClient := tenantsresolver.NewClient(addr1, tp, ...)\n+//   registryClient := typesregistry.NewClient(addr2, tp, ...)\n+// ---------------------------------------------------------------------------\n+async fn shared_token() -> Result<(), Box<dyn std::error::Error>> {\n+    println!(\"\\n=== Example 3: Shared token across clients ===\");\n+\n+    // One token provider -- shared via Clone (Arc inside, cheap)\n+    let token = Token::new(OAuthClientConfig {\n+        token_endpoint: Some(\"https://idp.example.com/oauth/token\".parse()?),\n+        client_id: \"my-service\".into(),\n+        client_secret: SecretString::new(\"my-secret\"),\n+        scopes: vec![\"api\".into()],\n+        ..Default::default()\n+    })\n+    .await?;\n+\n+    // Multiple clients reuse the same token\n+    let resolver_client = HttpClientBuilder::new()\n+        .with_bearer_auth(token.clone()) // cheap Arc clone\n+        .build()?;\n+\n+    let registry_client = HttpClientBuilder::new()\n+        .with_bearer_auth(token) // same token, same background refresh\n+        .build()?;\n+\n+    let _r1 = resolver_client\n+        .get(\"https://resolver.example.com/tenants\")\n+        .send()\n+        .await?;\n+    let _r2 = registry_client\n+        .get(\"https://registry.example.com/types\")\n+        .send()\n+        .await?;\n+\n+    println!(\"  Both clients used the same token provider\");\n+    Ok(())\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Example 4: Token invalidation on 401 (force refresh)\n+//\n+// Go equivalent:\n+//   resp := client.Do(req)\n+//   if resp.StatusCode == 401 { tp.Invalidate() }\n+// ---------------------------------------------------------------------------\n+async fn invalidation_on_401() -> Result<(), Box<dyn std::error::Error>> {\n+    println!(\"\\n=== Example 4: Invalidation on 401 ===\");\n+\n+    let token = Token::new(OAuthClientConfig {\n+        token_endpoint: Some(\"https://idp.example.com/oauth/token\".parse()?),\n+        client_id: \"my-service\".into(),\n+        client_secret: SecretString::new(\"my-secret\"),\n+        ..Default::default()\n+    })\n+    .await?;\n+\n+    let client = HttpClientBuilder::new()\n+        .with_bearer_auth(token.clone())\n+        .build()?;\n+\n+    let resp = client.get(\"https://api.example.com/resource\").send().await;\n+\n+    // If downstream returns 401, force-refresh the token\n+    if let Err(modkit_http::HttpError::HttpStatus { status, .. }) = &resp\n+        && *status == http::StatusCode::UNAUTHORIZED\n+    {\n+        println!(\"  Got 401 -- invalidating token...\");\n+        token.invalidate().await;\n+        // Retry with a fresh token (the client re-reads automatically)\n+        let _retry = client\n+            .get(\"https://api.example.com/resource\")\n+            .send()\n+            .await?;\n+        println!(\"  Retry succeeded with new token\");\n+    }","path":"libs/modkit-auth/examples/oauth2_client_usage.rs","commit_id":"0ec2170a051416844105f4975506c2722c101a10","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, locate and examine the modkit_http library\nfind . -type f -name \"*.rs\" -path \"*/modkit-http/*\" | head -20\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 598\n\n---\n\n🏁 Script executed:\n\n```shell\n# Examine the oauth2_client_usage.rs file to see the full context\ncat -n libs/modkit-auth/examples/oauth2_client_usage.rs | sed -n '145,175p'\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1401\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for HttpClient::send implementation and its return type\nrg -n \"async fn send\" libs/modkit-http/src -A 5\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 476\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for HttpError definition to understand error variants\nrg -n \"enum HttpError\" libs/modkit-http/src -A 15\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1138\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check for error_for_status method\nrg -n \"error_for_status\" libs/modkit-http/src -A 3\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 7081\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for response type and status method\nrg -n \"fn status\" libs/modkit-http/src -A 2\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 257\n\n---\n\n\n\n</details>\n\n**Fix 401 detection—pattern match on `HttpStatus` will never fire from `send()`.**\n\n`send()` returns `Ok(response)` for all non-2xx status codes, including 401. The `HttpStatus` error variant is only created by calling `error_for_status()`, never by `send()` itself. Your current pattern match at lines 155–157 is unreachable. Extract the status directly from the response and check for 401; propagate other errors:\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-    let resp = client.get(\"https://api.example.com/resource\").send().await;\n-\n-    // If downstream returns 401, force-refresh the token\n-    if let Err(modkit_http::HttpError::HttpStatus { status, .. }) = &resp\n-        && *status == http::StatusCode::UNAUTHORIZED\n-    {\n+    let resp = client.get(\"https://api.example.com/resource\").send().await?;\n+\n+    // If downstream returns 401, force-refresh the token\n+    if resp.status() == http::StatusCode::UNAUTHORIZED {\n         println!(\"  Got 401 -- invalidating token...\");\n         token.invalidate().await;\n         // Retry with a fresh token (the client re-reads automatically)\n         let _retry = client\n             .get(\"https://api.example.com/resource\")\n             .send()\n             .await?;\n         println!(\"  Retry succeeded with new token\");\n     }\n```\n\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    let resp = client.get(\"https://api.example.com/resource\").send().await?;\n\n    // If downstream returns 401, force-refresh the token\n    if resp.status() == http::StatusCode::UNAUTHORIZED {\n        println!(\"  Got 401 -- invalidating token...\");\n        token.invalidate().await;\n        // Retry with a fresh token (the client re-reads automatically)\n        let _retry = client\n            .get(\"https://api.example.com/resource\")\n            .send()\n            .await?;\n        println!(\"  Retry succeeded with new token\");\n    }\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/examples/oauth2_client_usage.rs` around lines 152 - 166, The\ncurrent pattern matching on modkit_http::HttpError::HttpStatus after calling\nclient.get(...).send().await is unreachable because send() returns Ok(response)\nfor 401; change the logic to first match the send() result (e.g., let resp =\nclient.get(...).send().await), propagate any Err(e) immediately, then inspect\nresp.status() and if it equals http::StatusCode::UNAUTHORIZED call\ntoken.invalidate().await and retry the request (or call resp.error_for_status()\nto convert non-2xx into HttpError where appropriate); keep references to the\nresp variable, token.invalidate().await, and error_for_status() when\nimplementing the fix.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T11:07:38Z","updated_at":"2026-02-10T11:07:40Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319394","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319394"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787319394"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787319394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":152,"start_side":"RIGHT","line":null,"original_line":166,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":166,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787688264","pull_request_review_id":3778666810,"id":2787688264,"node_id":"PRRC_kwDOPaLyBs6mKL9I","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`refresh_offset` (default 30 min) is passed as `min_staleness_period` to `aliri_tokens::TokenLifetimeConfig::new(0.75, ...)`. The stale time formula is `stale = issued + max(lifetime * 0.75, min_st    aleness_period)`. For tokens with lifetime shorter than `refresh_offset` (e.g., a 20-minute token), stale time exceeds expiry time, so the refresh won't trigger until after the token has expired.\n\nMany identity providers issue short-lived tokens (5-15 minutes) as a security best practice. These tokens would be served expired to callers, causing downstream 401 errors.\n\nI believe we should use much smaller fixed `min_staleness_period` as a lower bound.","created_at":"2026-02-10T12:31:49Z","updated_at":"2026-02-10T12:31:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787688264","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787688264"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787688264"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787688264/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":79,"side":"RIGHT","author_association":"MEMBER","original_position":79,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789106119","pull_request_review_id":3776061858,"id":2789106119,"node_id":"PRRC_kwDOPaLyBs6mPmHH","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let mut bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"0ec2170a051416844105f4975506c2722c101a10","original_commit_id":"0ec2170a051416844105f4975506c2722c101a10","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Security Issue: Unprotected secret in memory**\n\nThe bearer token is temporarily stored in an unprotected `String` (`raw`) which is not zeroed when dropped. This leaves the secret exposed in memory and vulnerable to extraction via memory dumps or side-channel attacks.\n\n**Fix:**\n```rust\nuse zeroize::Zeroizing;\n\nlet raw = Zeroizing::new(format!(\"Bearer {}\", secret.expose()));\nmatch HeaderValue::from_str(&raw) {\n```\n\nThis pattern is already used correctly in `source.rs` lines 100 and 111-116 for protecting `client_secret`. The same protection should be applied here for the access token.\n```suggestion\n                let raw = zeroize::Zeroizing::new(format!(\"Bearer {}\", secret.expose()));\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=cyberfabric&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/cyberfabric/cyberfabric-core/535?chatWithGeneratedComment=083081a2-0921-412c-995f-52b14884f0d9\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-10T16:46:49Z","updated_at":"2026-02-10T16:46:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789106119","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789106119"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789106119"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789106119/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":84,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":84,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789158358","pull_request_review_id":3780330956,"id":2789158358,"node_id":"PRRC_kwDOPaLyBs6mPy3W","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks. done","created_at":"2026-02-10T16:56:49Z","updated_at":"2026-02-10T16:56:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789158358","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789158358"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789158358"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789158358/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":79,"side":"RIGHT","in_reply_to_id":2787688264,"author_association":"MEMBER","original_position":79,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789163086","pull_request_review_id":3780336457,"id":2789163086,"node_id":"PRRC_kwDOPaLyBs6mP0BO","diff_hunk":"@@ -0,0 +1,793 @@\n+# Implementation Plan — Outbound OAuth2 Client Credentials\n+\n+Reference: [0002-modkit-auth-client.md](./0002-modkit-auth-client.md)\n+Required reading: [ModKit unified system](/docs/modkit_unified_system/README.md)\n+\n+Crate: `libs/modkit-auth`\n+\n+## Existing code to reuse\n+\n+Before starting, review the existing JWKS provider at\n+`libs/modkit-auth/src/providers/jwks.rs`. It is the closest analog to the OAuth2\n+token source and establishes patterns that must be followed:\n+\n+| Concern | JWKS (existing) | OAuth2 (new) |\n+|---------|----------------|--------------|\n+| HTTP client | `HttpClient::builder().timeout().retry(None).build()` | `HttpClientConfig::token_endpoint()` |\n+| Lock-free cache | `Arc<ArcSwap<HashMap<String,DecodingKey>>>` | `ArcSwap<TokenInner>` |\n+| Background refresh | `run_jwks_refresh_task` + `CancellationToken` | `aliri_tokens` watcher |\n+| Backoff | Manual exponential in `calculate_backoff()` | Delegated to `aliri_tokens` |\n+| Error mapping | `map_http_error(HttpError) -> ClaimsError` | Extract shared `map_http_error` or create parallel `map_http_error(HttpError) -> TokenError` |\n+| Test scaffold | `httpmock` + `allow_insecure_http()` | Same pattern |\n+\n+Key reuse points:\n+\n+1. **`map_http_error`** — `jwks.rs:417-473` maps every `HttpError` variant.\n+   Extract it into a shared helper `src/providers/http_error_mapping.rs` or\n+   duplicate the pattern for `TokenError`. Extraction is preferred to keep the\n+   exhaustive match in one place (HttpError is `#[non_exhaustive]`).\n+2. **`ArcSwap` lock-free read pattern** — `jwks.rs` uses `keys.load()` for\n+   reads and `keys.store(Arc::new(...))` for writes. Token must follow the\n+   same pattern.\n+3. **`HttpClient` construction** — `jwks.rs:86-89` builds a client with no\n+   retries (JWKS handles its own). OAuth source uses\n+   `HttpClientConfig::token_endpoint()` instead (retries are appropriate for\n+   token acquisition).\n+4. **Test pattern** — `jwks.rs:482-499` (`test_provider_with_http`) shows\n+   how to build a test `HttpClient` with `allow_insecure_http()` for\n+   `httpmock`. Reuse the same approach.\n+5. **Dependencies already available** — `modkit-auth/Cargo.toml` already has\n+   `arc-swap`, `modkit-http`, `tokio-util`, `httpmock` (dev). Only\n+   `aliri_tokens` needs to be added.\n+\n+---\n+\n+## Phase 0 — Extract shared HTTP error mapping\n+\n+**Goal:** Extract `map_http_error` from JWKS into a reusable utility so both JWKS and OAuth2 can use it without duplicating the exhaustive match.\n+\n+### Prompt\n+\n+```\n+Extract the HTTP error mapping function from the JWKS provider into a shared\n+utility in libs/modkit-auth.\n+\n+Current state: `libs/modkit-auth/src/providers/jwks.rs` lines 417-473 contain\n+`fn map_http_error(e: modkit_http::HttpError) -> ClaimsError` that exhaustively\n+maps every HttpError variant. This pattern will be needed by the OAuth2 token\n+source as well.\n+\n+1. Create `src/http_error.rs` with a generic mapping function:\n+\n+   pub fn format_http_error(e: &modkit_http::HttpError, prefix: &str) -> String\n+\n+   This function takes an HttpError reference and a context prefix (e.g. \"JWKS\",\n+   \"OAuth2 token\") and returns a human-readable error message string. It must\n+   handle every variant of HttpError (which is #[non_exhaustive]) with a\n+   catch-all `_ =>` arm at the end.\n+\n+   Replicate the exact mapping logic from jwks.rs:417-473, but replace the\n+   hardcoded \"JWKS\" prefix with the `prefix` parameter.\n+\n+2. Update `src/providers/jwks.rs`:\n+   - Replace the local `map_http_error` function with a call to the shared one:\n+\n+     fn map_http_error(e: modkit_http::HttpError) -> ClaimsError {\n+         ClaimsError::JwksFetchFailed(crate::http_error::format_http_error(&e, \"JWKS\"))\n+     }\n+\n+   - Delete the old exhaustive match from jwks.rs.\n+\n+3. Wire `pub mod http_error` into src/lib.rs.\n+\n+4. Run `cargo test -p modkit-auth` — all existing JWKS tests must pass unchanged.\n+\n+The OAuth2 token source (Phase 2) will use the same shared function:\n+    TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 0 (shared HTTP error mapping) in libs/modkit-auth.\n+\n+Check every item:\n+\n+1. FILE EXISTS: src/http_error.rs with pub fn format_http_error.\n+\n+2. EXHAUSTIVE MATCH: format_http_error handles these HttpError variants:\n+   HttpStatus, Json, Timeout, DeadlineExceeded, Transport, BodyTooLarge,\n+   Tls, RequestBuild, InvalidHeaderName, InvalidHeaderValue, FormEncode,\n+   Overloaded, ServiceClosed, InvalidUri, InvalidScheme, plus a `_ =>` arm.\n+\n+3. PREFIX USED: Every match arm includes the prefix parameter in its output.\n+   e.g. \"{prefix} HTTP {status}\" not \"JWKS HTTP {status}\".\n+\n+4. JWKS UNCHANGED: jwks.rs now calls format_http_error(&e, \"JWKS\").\n+   The local exhaustive match is removed.\n+   Run `cargo test -p modkit-auth` — all 11 existing JWKS tests pass.\n+\n+5. NO SECRET LEAKS: format_http_error never includes request body, auth\n+   headers, or token values — only status codes, error messages, and URLs.\n+\n+6. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+```\n+\n+---\n+\n+## Phase 1 — Foundation types\n+\n+**Goal:** Define configuration, error, and response types. No async code yet.\n+\n+### Prompt\n+\n+```\n+Implement foundation types for outbound OAuth2 client credentials in\n+libs/modkit-auth.\n+\n+Create a new module `src/oauth2/` with:\n+\n+1. `src/oauth2/mod.rs` — re-exports.\n+\n+2. `src/oauth2/config.rs` — `OAuthClientConfig`:\n+   - `token_endpoint: Option<Url>` (direct endpoint)\n+   - `issuer_url: Option<Url>` (for OIDC discovery, Phase 6)\n+   - Exactly one of `token_endpoint` or `issuer_url` must be set; validate in a\n+     `fn validate(&self) -> Result<(), TokenError>` method.\n+   - `client_id: String`\n+   - `client_secret: SecretString` (use the SecretString from this module)\n+   - `scopes: Vec<String>`\n+   - `auth_method: ClientAuthMethod` enum { Basic, Form } (default Basic)\n+   - `extra_headers: Vec<(String, String)>` (default empty)\n+   - `refresh_offset: Duration` (default 30 min)\n+   - `jitter_max: Duration` (default 5 min)\n+   - `min_refresh_period: Duration` (default 10 sec)\n+   - `default_ttl: Duration` (default 5 min — used when expires_in missing)\n+   - `http_config: Option<modkit_http::HttpClientConfig>` (override for token\n+     endpoint client; defaults to HttpClientConfig::token_endpoint())\n+   All durations use `std::time::Duration`. Derive `Clone`. Do NOT derive `Debug`\n+   for the whole struct — implement `Debug` manually, redacting `client_secret`.\n+\n+3. `src/oauth2/error.rs` — `TokenError` enum (thiserror):\n+   - `Http(String)` — transport/status errors (store formatted message, not\n+     the raw HttpError, to avoid leaking internals; use the shared\n+     `format_http_error` from Phase 0 when constructing)\n+   - `InvalidResponse(String)` — malformed token response\n+   - `UnsupportedTokenType(String)` — token_type is not Bearer\n+   - `ConfigError(String)` — invalid config (e.g. both endpoints set)\n+   - `Unavailable(String)` — watcher not ready / shutdown\n+   Mark `#[non_exhaustive]`. Implement Display via thiserror. Ensure no variant\n+   can ever contain secret values.\n+   Follow the same pattern as `AuthError` in src/errors.rs.\n+\n+4. `src/oauth2/types.rs`:\n+   - `SecretString` — newtype over `String` with `Debug` printing \"[REDACTED]\",\n+     `Display` printing \"[REDACTED]\", `Clone`, and `Drop` that zeroizes the\n+     inner buffer (use `unsafe { core::ptr::write_bytes }` on the Vec<u8>\n+     backing buffer, or the `zeroize` crate if available in workspace).\n+     Provide `fn expose(&self) -> &str` for controlled access.\n+   - `TokenResponse` (serde `Deserialize`):\n+     - `access_token: String`\n+     - `expires_in: Option<u64>`\n+     - `token_type: Option<String>`\n+     Deserialize only — never derive Serialize. Use `#[serde(default)]` for\n+     optional fields.\n+   - `ClientAuthMethod` enum { Basic, Form } with `Default` = Basic.\n+\n+Wire `mod oauth2` into `src/lib.rs` and re-export `OAuthClientConfig`,\n+`TokenError`, `SecretString`, `ClientAuthMethod` from the crate root\n+(Token will be re-exported in Phase 3).\n+\n+Follow existing patterns in modkit-auth: thiserror for errors, no unwrap in\n+library code, #[non_exhaustive] on public enums.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 1 (foundation types) of the OAuth2 client credentials\n+implementation in libs/modkit-auth/src/oauth2/.\n+\n+Check every item:\n+\n+1. FILES EXIST: mod.rs, config.rs, error.rs, types.rs under src/oauth2/.\n+   `mod oauth2` is declared in src/lib.rs.\n+\n+2. SecretString:\n+   - Debug and Display both print \"[REDACTED]\", never the inner value.\n+   - `expose(&self) -> &str` is the only way to access the inner value.\n+   - Clone is implemented.\n+   - Drop zeroizes the buffer (write_bytes or zeroize).\n+   - Write a unit test: create a SecretString, format with Debug and Display,\n+     assert neither contains the original value. Assert expose() returns it.\n+\n+3. OAuthClientConfig:\n+   - Has all fields from the design (token_endpoint, issuer_url, client_id,\n+     client_secret, scopes, auth_method, extra_headers, refresh_offset,\n+     jitter_max, min_refresh_period, default_ttl, http_config).\n+   - Does NOT derive Debug — has manual Debug impl that redacts client_secret.\n+   - validate() returns error if both token_endpoint and issuer_url are set,\n+     or if neither is set.\n+   - Write a unit test for validate() with both, neither, and exactly-one.\n+\n+4. TokenError:\n+   - Is #[non_exhaustive].\n+   - Has variants: Http, InvalidResponse, UnsupportedTokenType, ConfigError,\n+     Unavailable.\n+   - Display output for Http variant does NOT leak secrets.\n+   - Write a test: format a TokenError::ConfigError, assert it renders.\n+\n+5. TokenResponse:\n+   - Deserializes `{\"access_token\":\"x\",\"expires_in\":3600,\"token_type\":\"Bearer\"}`.\n+   - Deserializes `{\"access_token\":\"x\"}` (optional fields missing).\n+   - Does NOT implement Serialize.\n+   - Write tests for both cases.\n+\n+6. ClientAuthMethod: Default is Basic.\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+\n+8. TESTS: `cargo test -p modkit-auth` — all new AND existing tests pass.\n+\n+9. NO SECRETS IN DEBUG: grep all new files for `impl Debug` — every manual\n+   impl redacts client_secret / token values. No `#[derive(Debug)]` on types\n+   containing secrets.\n+```\n+\n+---\n+\n+## Phase 2 — Token source\n+\n+**Goal:** Implement `AsyncTokenSource` for `aliri_tokens` using `modkit-http::HttpClient`.\n+\n+### Prompt\n+\n+```\n+Implement the OAuth2 token source in libs/modkit-auth/src/oauth2/source.rs.\n+\n+This struct implements aliri_tokens::AsyncTokenSource and performs the actual\n+OAuth2 client credentials exchange using modkit-http::HttpClient.\n+\n+REFERENCE: Study libs/modkit-auth/src/providers/jwks.rs for the established\n+patterns — especially how it constructs HttpClient (lines 86-89), how it calls\n+client.get().send().await (lines 131-139), and how it maps errors via the\n+shared format_http_error (Phase 0).\n+\n+1. Add `aliri_tokens` to modkit-auth/Cargo.toml:\n+   aliri_tokens = { version = \"0.3\", default-features = false, features = [\"rand\"] }\n+   Verify it does NOT pull reqwest (no oauth2 feature).\n+\n+2. Create `src/oauth2/source.rs` with struct `OAuthTokenSource`:\n+   - Fields:\n+     - `client: modkit_http::HttpClient` (built once from config)\n+     - `token_endpoint: Url`\n+     - `client_id: String`\n+     - `client_secret: SecretString`\n+     - `scopes: Option<String>` (pre-joined with spaces, None if empty)\n+     - `auth_method: ClientAuthMethod`\n+     - `extra_headers: Vec<(String, String)>`\n+     - `default_ttl: Duration`\n+\n+   - Constructor `fn new(config: &OAuthClientConfig) -> Result<Self, TokenError>`:\n+     - Build HttpClient from config.http_config (if set) or\n+       HttpClientConfig::token_endpoint() (default).\n+       Map the HttpError from build via format_http_error (Phase 0):\n+       `TokenError::Http(format_http_error(&e, \"OAuth2 token\"))`\n+     - For now, require config.token_endpoint to be Some (OIDC discovery is\n+       Phase 6). Return TokenError::ConfigError if missing.\n+     - Pre-join scopes into a space-separated string.\n+\n+   COMPARE with JWKS: JwksKeyProvider::new() builds the client at lines 86-89\n+   with custom timeout and no retries. Here we use token_endpoint() config\n+   which INCLUDES retries (appropriate for token POST, which is idempotent\n+   for client_credentials).\n+\n+3. Implement `aliri_tokens::AsyncTokenSource` for `OAuthTokenSource`:\n+   - `async fn request_token(&self) -> Result<TokenWithLifetime, BoxError>`:\n+     a. Build form fields: grant_type=client_credentials, optional scope.\n+     b. Build request via `self.client.post(url).form(&fields)?`\n+        COMPARE with JWKS: jwks.rs uses `self.client.get(&self.jwks_uri).send()`\n+        at line 131. Here we use POST with form body.\n+     c. If auth_method is Basic: add Authorization header with\n+        base64(client_id:client_secret) via .header().\n+        If Form: add client_id and client_secret to form fields instead.\n+     d. Add extra_headers via .header().\n+     e. Call .send().await, then error_for_status().\n+     f. Parse response as TokenResponse via .json().\n+        COMPARE with JWKS: jwks.rs at line 139 does the same `.json().await`.\n+     g. Validate: if token_type is Some and != \"Bearer\" (case-insensitive),\n+        return Err(UnsupportedTokenType).\n+     h. Compute lifetime: Duration::from_secs(expires_in) if present,\n+        else self.default_ttl.\n+     i. Return TokenWithLifetime { token: access_token, lifetime }.\n+\n+   - Map HttpError using format_http_error(&e, \"OAuth2 token\") (Phase 0).\n+     Never include client_secret in error messages.\n+\n+4. Wire source.rs into src/oauth2/mod.rs. OAuthTokenSource is pub(crate) —\n+   it is an internal implementation detail used by Token (Phase 3).\n+\n+DO NOT add:\n+- Manual retry logic (HttpClient retries via RetryLayer).\n+- Manual tracing spans (HttpClient traces via OtelLayer).\n+- Manual timeout logic (HttpClient has request_timeout).\n+- Manual TLS configuration (HttpClient enforces TLS-only).\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 2 (token source) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. DEPENDENCY: `aliri_tokens` in modkit-auth/Cargo.toml with\n+   `default-features = false, features = [\"rand\"]`.\n+   Run: `cargo tree -p cf-modkit-auth | grep reqwest` — must return NOTHING.\n+\n+2. OAuthTokenSource: all fields private. Visibility is pub(crate).\n+\n+3. Constructor:\n+   - Builds HttpClient from HttpClientConfig::token_endpoint() by default.\n+   - Accepts http_config override from OAuthClientConfig.\n+   - Maps HttpError from client build via format_http_error.\n+   - Returns TokenError::ConfigError if token_endpoint is None.\n+\n+4. AsyncTokenSource::request_token():\n+   - Form body includes grant_type=client_credentials.\n+   - Scope included only when non-empty.\n+   - Basic auth: header is \"Basic {base64(id:secret)}\".\n+   - Form auth: client_id + client_secret in form body, no Authorization header.\n+   - Extra headers applied.\n+   - error_for_status() called before json().\n+   - token_type validation case-insensitive.\n+   - Missing expires_in falls back to default_ttl.\n+   - Returned lifetime is Duration, not zero.\n+\n+5. SECRET SAFETY:\n+   - grep source.rs for \"client_secret\" — only in struct field and\n+     form body / Authorization header construction. Never in error messages,\n+     tracing, or Debug output.\n+   - access_token is never logged.\n+\n+6. ERROR MAPPING uses shared format_http_error from Phase 0\n+   (not a local exhaustive match).\n+\n+7. NO DUPLICATE CONCERNS:\n+   - No manual retry logic.\n+   - No manual tracing spans.\n+   - No manual timeout logic.\n+   - No manual TLS configuration.\n+\n+8. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+9. TESTS (use httpmock + allow_insecure_http, same pattern as\n+   jwks.rs test_provider_with_http at line 482):\n+   - Mock server returns valid token response → assert access_token + lifetime.\n+   - Mock returns response without expires_in → assert default_ttl used.\n+   - Mock returns token_type: \"mac\" → assert error.\n+   - Empty scopes → assert scope param absent from request body.\n+   - Basic auth → assert Authorization header present in mock request.\n+   - Form auth → assert client_id in form body, no Authorization header.\n+```\n+\n+---\n+\n+## Phase 3 — Token handle (watcher + invalidate)\n+\n+**Goal:** Implement the public `Token` struct that wraps `aliri_tokens` watcher with `ArcSwap`-based invalidation.\n+\n+### Prompt\n+\n+```\n+Implement the public Token handle in libs/modkit-auth/src/oauth2/token.rs.\n+\n+This is the public API that modules use to get bearer tokens. It wraps an\n+aliri_tokens watcher and supports invalidation via ArcSwap rotation.\n+\n+REFERENCE: Study the ArcSwap usage in libs/modkit-auth/src/providers/jwks.rs:\n+- jwks.rs:41 — `keys: Arc<ArcSwap<HashMap<String, DecodingKey>>>`\n+- jwks.rs:190 — `self.keys.store(Arc::new(new_keys))` for atomic swap\n+- jwks.rs:299 — `let keys = self.keys.load()` for lock-free read\n+The Token handle follows the same pattern but swaps the entire watcher.\n+\n+1. Create `src/oauth2/token.rs` with:\n+\n+   struct TokenInner {\n+       watcher: aliri_tokens::TokenWatcher<String>,\n+   }\n+\n+   #[derive(Clone)]\n+   pub struct Token {\n+       inner: Arc<ArcSwap<TokenInner>>,\n+       source_factory: Arc<dyn Fn() -> Result<OAuthTokenSource, TokenError> + Send + Sync>,\n+       watcher_config: Arc<WatcherConfig>,\n+   }\n+\n+   struct WatcherConfig {\n+       refresh_offset: Duration,\n+       jitter_max: Duration,\n+       min_refresh_period: Duration,\n+   }\n+\n+2. Constructor `Token::new(config: OAuthClientConfig) -> Result<Self, TokenError>`:\n+   - Call config.validate().\n+   - Create OAuthTokenSource::new(&config).\n+   - Create aliri_tokens watcher from the source with the refresh parameters.\n+   - Store a source_factory closure that captures the config and can\n+     recreate the source for invalidation.\n+   - Wrap the watcher in TokenInner, then Arc, then ArcSwap.\n+\n+3. `pub async fn get(&self) -> Result<SecretString, TokenError>`:\n+   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n+   - Call `guard.watcher.token().await` to get the cached/refreshed token.\n+   - Wrap the raw String in SecretString immediately.\n+   - Map aliri_tokens errors to TokenError::Unavailable.","path":"libs/modkit-auth/docs/modkit-auth-client-impl.md","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Non-relevant","created_at":"2026-02-10T16:57:47Z","updated_at":"2026-02-10T16:57:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789163086","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789163086"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789163086"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789163086/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":421,"original_start_line":421,"start_side":"RIGHT","line":425,"original_line":425,"side":"RIGHT","in_reply_to_id":2787319386,"author_association":"MEMBER","original_position":425,"position":425,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789164926","pull_request_review_id":3780338698,"id":2789164926,"node_id":"PRRC_kwDOPaLyBs6mP0d-","diff_hunk":"@@ -0,0 +1,793 @@\n+# Implementation Plan — Outbound OAuth2 Client Credentials\n+\n+Reference: [0002-modkit-auth-client.md](./0002-modkit-auth-client.md)\n+Required reading: [ModKit unified system](/docs/modkit_unified_system/README.md)\n+\n+Crate: `libs/modkit-auth`\n+\n+## Existing code to reuse\n+\n+Before starting, review the existing JWKS provider at\n+`libs/modkit-auth/src/providers/jwks.rs`. It is the closest analog to the OAuth2\n+token source and establishes patterns that must be followed:\n+\n+| Concern | JWKS (existing) | OAuth2 (new) |\n+|---------|----------------|--------------|\n+| HTTP client | `HttpClient::builder().timeout().retry(None).build()` | `HttpClientConfig::token_endpoint()` |\n+| Lock-free cache | `Arc<ArcSwap<HashMap<String,DecodingKey>>>` | `ArcSwap<TokenInner>` |\n+| Background refresh | `run_jwks_refresh_task` + `CancellationToken` | `aliri_tokens` watcher |\n+| Backoff | Manual exponential in `calculate_backoff()` | Delegated to `aliri_tokens` |\n+| Error mapping | `map_http_error(HttpError) -> ClaimsError` | Extract shared `map_http_error` or create parallel `map_http_error(HttpError) -> TokenError` |\n+| Test scaffold | `httpmock` + `allow_insecure_http()` | Same pattern |\n+\n+Key reuse points:\n+\n+1. **`map_http_error`** — `jwks.rs:417-473` maps every `HttpError` variant.\n+   Extract it into a shared helper `src/providers/http_error_mapping.rs` or\n+   duplicate the pattern for `TokenError`. Extraction is preferred to keep the\n+   exhaustive match in one place (HttpError is `#[non_exhaustive]`).\n+2. **`ArcSwap` lock-free read pattern** — `jwks.rs` uses `keys.load()` for\n+   reads and `keys.store(Arc::new(...))` for writes. Token must follow the\n+   same pattern.\n+3. **`HttpClient` construction** — `jwks.rs:86-89` builds a client with no\n+   retries (JWKS handles its own). OAuth source uses\n+   `HttpClientConfig::token_endpoint()` instead (retries are appropriate for\n+   token acquisition).\n+4. **Test pattern** — `jwks.rs:482-499` (`test_provider_with_http`) shows\n+   how to build a test `HttpClient` with `allow_insecure_http()` for\n+   `httpmock`. Reuse the same approach.\n+5. **Dependencies already available** — `modkit-auth/Cargo.toml` already has\n+   `arc-swap`, `modkit-http`, `tokio-util`, `httpmock` (dev). Only\n+   `aliri_tokens` needs to be added.\n+\n+---\n+\n+## Phase 0 — Extract shared HTTP error mapping\n+\n+**Goal:** Extract `map_http_error` from JWKS into a reusable utility so both JWKS and OAuth2 can use it without duplicating the exhaustive match.\n+\n+### Prompt\n+\n+```\n+Extract the HTTP error mapping function from the JWKS provider into a shared\n+utility in libs/modkit-auth.\n+\n+Current state: `libs/modkit-auth/src/providers/jwks.rs` lines 417-473 contain\n+`fn map_http_error(e: modkit_http::HttpError) -> ClaimsError` that exhaustively\n+maps every HttpError variant. This pattern will be needed by the OAuth2 token\n+source as well.\n+\n+1. Create `src/http_error.rs` with a generic mapping function:\n+\n+   pub fn format_http_error(e: &modkit_http::HttpError, prefix: &str) -> String\n+\n+   This function takes an HttpError reference and a context prefix (e.g. \"JWKS\",\n+   \"OAuth2 token\") and returns a human-readable error message string. It must\n+   handle every variant of HttpError (which is #[non_exhaustive]) with a\n+   catch-all `_ =>` arm at the end.\n+\n+   Replicate the exact mapping logic from jwks.rs:417-473, but replace the\n+   hardcoded \"JWKS\" prefix with the `prefix` parameter.\n+\n+2. Update `src/providers/jwks.rs`:\n+   - Replace the local `map_http_error` function with a call to the shared one:\n+\n+     fn map_http_error(e: modkit_http::HttpError) -> ClaimsError {\n+         ClaimsError::JwksFetchFailed(crate::http_error::format_http_error(&e, \"JWKS\"))\n+     }\n+\n+   - Delete the old exhaustive match from jwks.rs.\n+\n+3. Wire `pub mod http_error` into src/lib.rs.\n+\n+4. Run `cargo test -p modkit-auth` — all existing JWKS tests must pass unchanged.\n+\n+The OAuth2 token source (Phase 2) will use the same shared function:\n+    TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 0 (shared HTTP error mapping) in libs/modkit-auth.\n+\n+Check every item:\n+\n+1. FILE EXISTS: src/http_error.rs with pub fn format_http_error.\n+\n+2. EXHAUSTIVE MATCH: format_http_error handles these HttpError variants:\n+   HttpStatus, Json, Timeout, DeadlineExceeded, Transport, BodyTooLarge,\n+   Tls, RequestBuild, InvalidHeaderName, InvalidHeaderValue, FormEncode,\n+   Overloaded, ServiceClosed, InvalidUri, InvalidScheme, plus a `_ =>` arm.\n+\n+3. PREFIX USED: Every match arm includes the prefix parameter in its output.\n+   e.g. \"{prefix} HTTP {status}\" not \"JWKS HTTP {status}\".\n+\n+4. JWKS UNCHANGED: jwks.rs now calls format_http_error(&e, \"JWKS\").\n+   The local exhaustive match is removed.\n+   Run `cargo test -p modkit-auth` — all 11 existing JWKS tests pass.\n+\n+5. NO SECRET LEAKS: format_http_error never includes request body, auth\n+   headers, or token values — only status codes, error messages, and URLs.\n+\n+6. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+```\n+\n+---\n+\n+## Phase 1 — Foundation types\n+\n+**Goal:** Define configuration, error, and response types. No async code yet.\n+\n+### Prompt\n+\n+```\n+Implement foundation types for outbound OAuth2 client credentials in\n+libs/modkit-auth.\n+\n+Create a new module `src/oauth2/` with:\n+\n+1. `src/oauth2/mod.rs` — re-exports.\n+\n+2. `src/oauth2/config.rs` — `OAuthClientConfig`:\n+   - `token_endpoint: Option<Url>` (direct endpoint)\n+   - `issuer_url: Option<Url>` (for OIDC discovery, Phase 6)\n+   - Exactly one of `token_endpoint` or `issuer_url` must be set; validate in a\n+     `fn validate(&self) -> Result<(), TokenError>` method.\n+   - `client_id: String`\n+   - `client_secret: SecretString` (use the SecretString from this module)\n+   - `scopes: Vec<String>`\n+   - `auth_method: ClientAuthMethod` enum { Basic, Form } (default Basic)\n+   - `extra_headers: Vec<(String, String)>` (default empty)\n+   - `refresh_offset: Duration` (default 30 min)\n+   - `jitter_max: Duration` (default 5 min)\n+   - `min_refresh_period: Duration` (default 10 sec)\n+   - `default_ttl: Duration` (default 5 min — used when expires_in missing)\n+   - `http_config: Option<modkit_http::HttpClientConfig>` (override for token\n+     endpoint client; defaults to HttpClientConfig::token_endpoint())\n+   All durations use `std::time::Duration`. Derive `Clone`. Do NOT derive `Debug`\n+   for the whole struct — implement `Debug` manually, redacting `client_secret`.\n+\n+3. `src/oauth2/error.rs` — `TokenError` enum (thiserror):\n+   - `Http(String)` — transport/status errors (store formatted message, not\n+     the raw HttpError, to avoid leaking internals; use the shared\n+     `format_http_error` from Phase 0 when constructing)\n+   - `InvalidResponse(String)` — malformed token response\n+   - `UnsupportedTokenType(String)` — token_type is not Bearer\n+   - `ConfigError(String)` — invalid config (e.g. both endpoints set)\n+   - `Unavailable(String)` — watcher not ready / shutdown\n+   Mark `#[non_exhaustive]`. Implement Display via thiserror. Ensure no variant\n+   can ever contain secret values.\n+   Follow the same pattern as `AuthError` in src/errors.rs.\n+\n+4. `src/oauth2/types.rs`:\n+   - `SecretString` — newtype over `String` with `Debug` printing \"[REDACTED]\",\n+     `Display` printing \"[REDACTED]\", `Clone`, and `Drop` that zeroizes the\n+     inner buffer (use `unsafe { core::ptr::write_bytes }` on the Vec<u8>\n+     backing buffer, or the `zeroize` crate if available in workspace).\n+     Provide `fn expose(&self) -> &str` for controlled access.\n+   - `TokenResponse` (serde `Deserialize`):\n+     - `access_token: String`\n+     - `expires_in: Option<u64>`\n+     - `token_type: Option<String>`\n+     Deserialize only — never derive Serialize. Use `#[serde(default)]` for\n+     optional fields.\n+   - `ClientAuthMethod` enum { Basic, Form } with `Default` = Basic.\n+\n+Wire `mod oauth2` into `src/lib.rs` and re-export `OAuthClientConfig`,\n+`TokenError`, `SecretString`, `ClientAuthMethod` from the crate root\n+(Token will be re-exported in Phase 3).\n+\n+Follow existing patterns in modkit-auth: thiserror for errors, no unwrap in\n+library code, #[non_exhaustive] on public enums.\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 1 (foundation types) of the OAuth2 client credentials\n+implementation in libs/modkit-auth/src/oauth2/.\n+\n+Check every item:\n+\n+1. FILES EXIST: mod.rs, config.rs, error.rs, types.rs under src/oauth2/.\n+   `mod oauth2` is declared in src/lib.rs.\n+\n+2. SecretString:\n+   - Debug and Display both print \"[REDACTED]\", never the inner value.\n+   - `expose(&self) -> &str` is the only way to access the inner value.\n+   - Clone is implemented.\n+   - Drop zeroizes the buffer (write_bytes or zeroize).\n+   - Write a unit test: create a SecretString, format with Debug and Display,\n+     assert neither contains the original value. Assert expose() returns it.\n+\n+3. OAuthClientConfig:\n+   - Has all fields from the design (token_endpoint, issuer_url, client_id,\n+     client_secret, scopes, auth_method, extra_headers, refresh_offset,\n+     jitter_max, min_refresh_period, default_ttl, http_config).\n+   - Does NOT derive Debug — has manual Debug impl that redacts client_secret.\n+   - validate() returns error if both token_endpoint and issuer_url are set,\n+     or if neither is set.\n+   - Write a unit test for validate() with both, neither, and exactly-one.\n+\n+4. TokenError:\n+   - Is #[non_exhaustive].\n+   - Has variants: Http, InvalidResponse, UnsupportedTokenType, ConfigError,\n+     Unavailable.\n+   - Display output for Http variant does NOT leak secrets.\n+   - Write a test: format a TokenError::ConfigError, assert it renders.\n+\n+5. TokenResponse:\n+   - Deserializes `{\"access_token\":\"x\",\"expires_in\":3600,\"token_type\":\"Bearer\"}`.\n+   - Deserializes `{\"access_token\":\"x\"}` (optional fields missing).\n+   - Does NOT implement Serialize.\n+   - Write tests for both cases.\n+\n+6. ClientAuthMethod: Default is Basic.\n+\n+7. COMPILATION: `cargo check -p modkit-auth` succeeds with no warnings.\n+\n+8. TESTS: `cargo test -p modkit-auth` — all new AND existing tests pass.\n+\n+9. NO SECRETS IN DEBUG: grep all new files for `impl Debug` — every manual\n+   impl redacts client_secret / token values. No `#[derive(Debug)]` on types\n+   containing secrets.\n+```\n+\n+---\n+\n+## Phase 2 — Token source\n+\n+**Goal:** Implement `AsyncTokenSource` for `aliri_tokens` using `modkit-http::HttpClient`.\n+\n+### Prompt\n+\n+```\n+Implement the OAuth2 token source in libs/modkit-auth/src/oauth2/source.rs.\n+\n+This struct implements aliri_tokens::AsyncTokenSource and performs the actual\n+OAuth2 client credentials exchange using modkit-http::HttpClient.\n+\n+REFERENCE: Study libs/modkit-auth/src/providers/jwks.rs for the established\n+patterns — especially how it constructs HttpClient (lines 86-89), how it calls\n+client.get().send().await (lines 131-139), and how it maps errors via the\n+shared format_http_error (Phase 0).\n+\n+1. Add `aliri_tokens` to modkit-auth/Cargo.toml:\n+   aliri_tokens = { version = \"0.3\", default-features = false, features = [\"rand\"] }\n+   Verify it does NOT pull reqwest (no oauth2 feature).\n+\n+2. Create `src/oauth2/source.rs` with struct `OAuthTokenSource`:\n+   - Fields:\n+     - `client: modkit_http::HttpClient` (built once from config)\n+     - `token_endpoint: Url`\n+     - `client_id: String`\n+     - `client_secret: SecretString`\n+     - `scopes: Option<String>` (pre-joined with spaces, None if empty)\n+     - `auth_method: ClientAuthMethod`\n+     - `extra_headers: Vec<(String, String)>`\n+     - `default_ttl: Duration`\n+\n+   - Constructor `fn new(config: &OAuthClientConfig) -> Result<Self, TokenError>`:\n+     - Build HttpClient from config.http_config (if set) or\n+       HttpClientConfig::token_endpoint() (default).\n+       Map the HttpError from build via format_http_error (Phase 0):\n+       `TokenError::Http(format_http_error(&e, \"OAuth2 token\"))`\n+     - For now, require config.token_endpoint to be Some (OIDC discovery is\n+       Phase 6). Return TokenError::ConfigError if missing.\n+     - Pre-join scopes into a space-separated string.\n+\n+   COMPARE with JWKS: JwksKeyProvider::new() builds the client at lines 86-89\n+   with custom timeout and no retries. Here we use token_endpoint() config\n+   which INCLUDES retries (appropriate for token POST, which is idempotent\n+   for client_credentials).\n+\n+3. Implement `aliri_tokens::AsyncTokenSource` for `OAuthTokenSource`:\n+   - `async fn request_token(&self) -> Result<TokenWithLifetime, BoxError>`:\n+     a. Build form fields: grant_type=client_credentials, optional scope.\n+     b. Build request via `self.client.post(url).form(&fields)?`\n+        COMPARE with JWKS: jwks.rs uses `self.client.get(&self.jwks_uri).send()`\n+        at line 131. Here we use POST with form body.\n+     c. If auth_method is Basic: add Authorization header with\n+        base64(client_id:client_secret) via .header().\n+        If Form: add client_id and client_secret to form fields instead.\n+     d. Add extra_headers via .header().\n+     e. Call .send().await, then error_for_status().\n+     f. Parse response as TokenResponse via .json().\n+        COMPARE with JWKS: jwks.rs at line 139 does the same `.json().await`.\n+     g. Validate: if token_type is Some and != \"Bearer\" (case-insensitive),\n+        return Err(UnsupportedTokenType).\n+     h. Compute lifetime: Duration::from_secs(expires_in) if present,\n+        else self.default_ttl.\n+     i. Return TokenWithLifetime { token: access_token, lifetime }.\n+\n+   - Map HttpError using format_http_error(&e, \"OAuth2 token\") (Phase 0).\n+     Never include client_secret in error messages.\n+\n+4. Wire source.rs into src/oauth2/mod.rs. OAuthTokenSource is pub(crate) —\n+   it is an internal implementation detail used by Token (Phase 3).\n+\n+DO NOT add:\n+- Manual retry logic (HttpClient retries via RetryLayer).\n+- Manual tracing spans (HttpClient traces via OtelLayer).\n+- Manual timeout logic (HttpClient has request_timeout).\n+- Manual TLS configuration (HttpClient enforces TLS-only).\n+```\n+\n+### Guard\n+\n+```\n+Verify Phase 2 (token source) of the OAuth2 client credentials implementation.\n+\n+Check every item:\n+\n+1. DEPENDENCY: `aliri_tokens` in modkit-auth/Cargo.toml with\n+   `default-features = false, features = [\"rand\"]`.\n+   Run: `cargo tree -p cf-modkit-auth | grep reqwest` — must return NOTHING.\n+\n+2. OAuthTokenSource: all fields private. Visibility is pub(crate).\n+\n+3. Constructor:\n+   - Builds HttpClient from HttpClientConfig::token_endpoint() by default.\n+   - Accepts http_config override from OAuthClientConfig.\n+   - Maps HttpError from client build via format_http_error.\n+   - Returns TokenError::ConfigError if token_endpoint is None.\n+\n+4. AsyncTokenSource::request_token():\n+   - Form body includes grant_type=client_credentials.\n+   - Scope included only when non-empty.\n+   - Basic auth: header is \"Basic {base64(id:secret)}\".\n+   - Form auth: client_id + client_secret in form body, no Authorization header.\n+   - Extra headers applied.\n+   - error_for_status() called before json().\n+   - token_type validation case-insensitive.\n+   - Missing expires_in falls back to default_ttl.\n+   - Returned lifetime is Duration, not zero.\n+\n+5. SECRET SAFETY:\n+   - grep source.rs for \"client_secret\" — only in struct field and\n+     form body / Authorization header construction. Never in error messages,\n+     tracing, or Debug output.\n+   - access_token is never logged.\n+\n+6. ERROR MAPPING uses shared format_http_error from Phase 0\n+   (not a local exhaustive match).\n+\n+7. NO DUPLICATE CONCERNS:\n+   - No manual retry logic.\n+   - No manual tracing spans.\n+   - No manual timeout logic.\n+   - No manual TLS configuration.\n+\n+8. COMPILATION: `cargo check -p modkit-auth` succeeds.\n+\n+9. TESTS (use httpmock + allow_insecure_http, same pattern as\n+   jwks.rs test_provider_with_http at line 482):\n+   - Mock server returns valid token response → assert access_token + lifetime.\n+   - Mock returns response without expires_in → assert default_ttl used.\n+   - Mock returns token_type: \"mac\" → assert error.\n+   - Empty scopes → assert scope param absent from request body.\n+   - Basic auth → assert Authorization header present in mock request.\n+   - Form auth → assert client_id in form body, no Authorization header.\n+```\n+\n+---\n+\n+## Phase 3 — Token handle (watcher + invalidate)\n+\n+**Goal:** Implement the public `Token` struct that wraps `aliri_tokens` watcher with `ArcSwap`-based invalidation.\n+\n+### Prompt\n+\n+```\n+Implement the public Token handle in libs/modkit-auth/src/oauth2/token.rs.\n+\n+This is the public API that modules use to get bearer tokens. It wraps an\n+aliri_tokens watcher and supports invalidation via ArcSwap rotation.\n+\n+REFERENCE: Study the ArcSwap usage in libs/modkit-auth/src/providers/jwks.rs:\n+- jwks.rs:41 — `keys: Arc<ArcSwap<HashMap<String, DecodingKey>>>`\n+- jwks.rs:190 — `self.keys.store(Arc::new(new_keys))` for atomic swap\n+- jwks.rs:299 — `let keys = self.keys.load()` for lock-free read\n+The Token handle follows the same pattern but swaps the entire watcher.\n+\n+1. Create `src/oauth2/token.rs` with:\n+\n+   struct TokenInner {\n+       watcher: aliri_tokens::TokenWatcher<String>,\n+   }\n+\n+   #[derive(Clone)]\n+   pub struct Token {\n+       inner: Arc<ArcSwap<TokenInner>>,\n+       source_factory: Arc<dyn Fn() -> Result<OAuthTokenSource, TokenError> + Send + Sync>,\n+       watcher_config: Arc<WatcherConfig>,\n+   }\n+\n+   struct WatcherConfig {\n+       refresh_offset: Duration,\n+       jitter_max: Duration,\n+       min_refresh_period: Duration,\n+   }\n+\n+2. Constructor `Token::new(config: OAuthClientConfig) -> Result<Self, TokenError>`:\n+   - Call config.validate().\n+   - Create OAuthTokenSource::new(&config).\n+   - Create aliri_tokens watcher from the source with the refresh parameters.\n+   - Store a source_factory closure that captures the config and can\n+     recreate the source for invalidation.\n+   - Wrap the watcher in TokenInner, then Arc, then ArcSwap.\n+\n+3. `pub async fn get(&self) -> Result<SecretString, TokenError>`:\n+   - `let guard = self.inner.load();` — lock-free read (compare jwks.rs:299).\n+   - Call `guard.watcher.token().await` to get the cached/refreshed token.\n+   - Wrap the raw String in SecretString immediately.\n+   - Map aliri_tokens errors to TokenError::Unavailable.","path":"libs/modkit-auth/docs/modkit-auth-client-impl.md","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"45e06a1385a337f130c243d4ab10d2a6efd9beee","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@MikeFalcon77`, understood—I'll leave this as-is.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: MikeFalcon77\nRepo: cyberfabric/cyberfabric-core PR: 535\nFile: libs/modkit-auth/src/oauth2/source.rs:109-120\nTimestamp: 2026-02-10T10:43:04.968Z\nLearning: In modkit-auth OAuth2 client credentials flow, the project deliberately skips RFC 6749 Section 2.3.1 percent-encoding (form-urlencoded) for Basic auth credentials before base64-encoding. Rationale: most OAuth2 libraries (including Go's SetBasicAuth) don't encode, applying it can break IdPs that don't expect %XX-encoded credentials, and the project's Go codebase doesn't encode either (maintaining parity).\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T16:58:13Z","updated_at":"2026-02-10T16:58:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789164926","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789164926"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789164926"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789164926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":421,"original_start_line":421,"start_side":"RIGHT","line":425,"original_line":425,"side":"RIGHT","in_reply_to_id":2787319386,"author_association":"CONTRIBUTOR","original_position":425,"position":425,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789350357","pull_request_review_id":3780538170,"id":2789350357,"node_id":"PRRC_kwDOPaLyBs6mQhvV","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let mut bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"0ec2170a051416844105f4975506c2722c101a10","original_commit_id":"0ec2170a051416844105f4975506c2722c101a10","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fix it already","created_at":"2026-02-10T17:38:52Z","updated_at":"2026-02-10T17:38:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789350357","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789350357"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789350357"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789350357/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":84,"side":"RIGHT","in_reply_to_id":2789106119,"author_association":"MEMBER","original_position":84,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789353167","pull_request_review_id":3780541281,"id":2789353167,"node_id":"PRRC_kwDOPaLyBs6mQibP","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let mut bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"0ec2170a051416844105f4975506c2722c101a10","original_commit_id":"0ec2170a051416844105f4975506c2722c101a10","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"## Code Implementation :hammer_and_wrench: \n\n\n**Implementation:** Import `zeroize::Zeroizing` and use it directly when formatting the bearer token string so the temporary formatted value is zeroed on drop before building the `HeaderValue`.\n\n\n```suggestion\nuse std::future::Future;\nuse std::pin::Pin;\nuse std::task::{Context, Poll};\n\nuse http::header::{AUTHORIZATION, HeaderName};\nuse http::{HeaderValue, Request, Response};\nuse tower::{Layer, Service};\nuse zeroize::Zeroizing;\n\nuse super::token::Token;\nuse modkit_http::HttpError;\n\nfn call(&mut self, mut req: Request<B>) -> Self::Future {\n    let mut bearer_value = match self.token.get() {\n        Ok(secret) => {\n            let raw: Zeroizing<String> = Zeroizing::new(format!(\"Bearer {}\", secret.expose()));\n            match HeaderValue::from_str(&raw) {\n                Ok(v) => v,\n                Err(e) => return Box::pin(async { Err(HttpError::InvalidHeaderValue(e)) }),\n            }\n        }\n        Err(e) => return Box::pin(async { Err(HttpError::Transport(Box::new(e))) }),\n    };\n    bearer_value.set_sensitive(true);\n\n    req.headers_mut()\n        .insert(self.header_name.clone(), bearer_value);\n```\nSee review comment [here](https://github.com/cyberfabric/cyberfabric-core/pull/535#discussion_r2789106119)\n\n","created_at":"2026-02-10T17:39:30Z","updated_at":"2026-02-10T17:39:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789353167","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789353167"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789353167"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789353167/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":84,"side":"RIGHT","in_reply_to_id":2789106119,"author_association":"NONE","original_position":84,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789923960","pull_request_review_id":3781193137,"id":2789923960,"node_id":"PRRC_kwDOPaLyBs6mStx4","diff_hunk":"","path":"libs/modkit-auth/examples/oauth2_client_usage.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I would split the examples in different files, having all together here is overwhelming","created_at":"2026-02-10T19:48:15Z","updated_at":"2026-02-10T19:53:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789923960","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789923960"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789923960"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789923960/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789926291","pull_request_review_id":3781193137,"id":2789926291,"node_id":"PRRC_kwDOPaLyBs6mSuWT","diff_hunk":"@@ -21,6 +21,10 @@ workspace = true\n name = \"dispatcher_usage\"\n path = \"examples/dispatcher_usage.rs\"\n \n+[[example]]","path":"libs/modkit-auth/Cargo.toml","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"no need to specify the examples here, they are auto-discovered by cargo","created_at":"2026-02-10T19:48:41Z","updated_at":"2026-02-10T19:53:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789926291","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789926291"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789926291"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789926291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":24,"original_line":24,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789941677","pull_request_review_id":3781193137,"id":2789941677,"node_id":"PRRC_kwDOPaLyBs6mSyGt","diff_hunk":"@@ -0,0 +1,120 @@\n+/// Format an [`modkit_http::HttpError`] into a human-readable message with a\n+/// context prefix.\n+///\n+/// The prefix identifies the caller context (e.g. `\"JWKS\"`, `\"OAuth2 token\"`)\n+/// and is prepended to every message so log output is immediately attributable.\n+///\n+/// This function is the single place that handles the exhaustive (plus\n+/// `#[non_exhaustive]` catch-all) match on `HttpError`, shared by JWKS key\n+/// fetching, `OAuth2` token acquisition, and any future HTTP-based provider.\n+///\n+/// # Security\n+///\n+/// `HttpStatus` errors include only the status code — the response body is\n+/// deliberately excluded to prevent server-side diagnostics from leaking\n+/// into logs or error messages.\n+#[must_use]\n+pub fn format_http_error(e: &modkit_http::HttpError, prefix: &str) -> String {\n+    use modkit_http::HttpError;\n+\n+    match e {\n+        HttpError::HttpStatus { status, .. } => {\n+            format!(\"{prefix} HTTP {status}\")\n+        }\n+        HttpError::Json(err) => format!(\"{prefix} JSON parse failed: {err}\"),\n+        HttpError::Timeout(duration) => {\n+            format!(\"{prefix} request timed out after {duration:?}\")\n+        }\n+        HttpError::DeadlineExceeded(duration) => {\n+            format!(\"{prefix} total deadline exceeded after {duration:?}\")\n+        }\n+        HttpError::Transport(err) => format!(\"{prefix} transport error: {err}\"),\n+        HttpError::BodyTooLarge { limit, actual } => {\n+            format!(\"{prefix} response too large: limit {limit} bytes, got {actual} bytes\")\n+        }\n+        HttpError::Tls(err) => format!(\"{prefix} TLS error: {err}\"),\n+        HttpError::RequestBuild(err) => format!(\"{prefix} request build failed: {err}\"),\n+        HttpError::InvalidHeaderName(err) => format!(\"{prefix} invalid header name: {err}\"),\n+        HttpError::InvalidHeaderValue(err) => format!(\"{prefix} invalid header value: {err}\"),\n+        HttpError::FormEncode(err) => format!(\"{prefix} form encode error: {err}\"),\n+        HttpError::Overloaded => format!(\"{prefix} request rejected: service overloaded\"),\n+        HttpError::ServiceClosed => format!(\"{prefix} service unavailable\"),\n+        HttpError::InvalidUri { url, reason, .. } => {\n+            format!(\"{prefix} invalid URL '{url}': {reason}\")\n+        }\n+        HttpError::InvalidScheme { scheme, reason } => {\n+            format!(\"{prefix} invalid scheme '{scheme}': {reason}\")\n+        }\n+        // Future variants (HttpError is #[non_exhaustive]) — omit detail\n+        // to avoid leaking sensitive data from unknown Display impls.\n+        _ => format!(\"{prefix} request failed\"),","path":"libs/modkit-auth/src/http_error.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This can hide future problems, I would remove this one.\nAlthough leaving commented for the future, in case we want to use it","created_at":"2026-02-10T19:52:12Z","updated_at":"2026-02-10T19:53:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789941677","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789941677"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2789941677"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2789941677/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":50,"original_line":50,"side":"RIGHT","author_association":"MEMBER","original_position":50,"position":50,"subject_type":"line"}],"source_reviews":[{"id":3776090243,"node_id":"PRR_kwDOPaLyBs7hEpCD","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 2**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@docs/ARCHITECTURE_MANIFEST.md`:\n- Around line 322-323: Update docs/modkit_unified_system/README.md by adding\nentries for modkit-http and modkit-auth to the \"Task → Document routing\" table\nand the \"File overview\" section: list modkit-http with its responsibilities\n(HTTP client: TLS, retries, timeouts, concurrency limiting, decompression, OTel\ntracing, extensible auth hook) and link to\nadrs/modkit/0001-modkit-hyper-tower-http-client.md, and list modkit-auth with\nits responsibilities (inbound JWT/OIDC route policies and outbound OAuth2 client\ncredentials with automatic token refresh/Authorization: Bearer injection) and\nlink to adrs/modkit/0002-modkit-auth-client-with-aliri.md so the unified system\nguide points to where these components are documented.\n\nIn `@libs/modkit-auth/src/oauth2/config.rs`:\n- Around line 101-117: The Debug impl for OAuthClientConfig currently prints\nfull extra_headers values; change the fmt::Debug implementation (impl fmt::Debug\nfor OAuthClientConfig) to redact header values by transforming\nself.extra_headers into a display-friendly structure that only shows header\nnames or maps each value to \"[REDACTED]\" before calling\nf.debug_struct().field(\"extra_headers\", ...). Ensure the rest of the fields\nremain unchanged and the redaction handles whichever type extra_headers is\n(e.g., HashMap or HeaderMap) by iterating its keys and replacing values with a\nconstant redaction string.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (3)</summary><blockquote>\n\n<details>\n<summary>libs/modkit-auth/src/oauth2/discovery.rs (1)</summary><blockquote>\n\n`58-62`: **Consider removing the unused parameter.**\n\nThe `_server` parameter in `build_client` is unused. While this doesn't affect functionality, removing it would be cleaner.\n\n\n\n<details>\n<summary>🔧 Suggested change</summary>\n\n```diff\n-    fn build_client(_server: &MockServer) -> modkit_http::HttpClient {\n+    fn build_client() -> modkit_http::HttpClient {\n         modkit_http::HttpClientBuilder::with_config(modkit_http::HttpClientConfig::for_testing())\n             .build()\n             .unwrap()\n     }\n```\n\nThen update call sites:\n```diff\n-        let client = build_client(&server);\n+        let client = build_client();\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/config.rs (1)</summary><blockquote>\n\n`61-78`: **Fail fast on missing client credentials.**\n\n`validate` only checks endpoint vs issuer. Empty `client_id` / `client_secret` will surface later as opaque token errors. Consider validating non-empty values here for clearer config failures.  \n\n\n<details>\n<summary>✅ Add credential checks to validate()</summary>\n\n```diff\n pub fn validate(&self) -> Result<(), TokenError> {\n+    if self.client_id.trim().is_empty() {\n+        return Err(TokenError::ConfigError(\"client_id must be set\".into()));\n+    }\n+    if self.client_secret.expose().is_empty() {\n+        return Err(TokenError::ConfigError(\"client_secret must be set\".into()));\n+    }\n     match (&self.token_endpoint, &self.issuer_url) {\n         (Some(_), Some(_)) => Err(TokenError::ConfigError(\n             \"token_endpoint and issuer_url are mutually exclusive\".into(),\n         )),\n         (None, None) => Err(TokenError::ConfigError(\n             \"one of token_endpoint or issuer_url must be set\".into(),\n         )),\n         _ => Ok(()),\n     }\n }\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/source.rs (1)</summary><blockquote>\n\n`111-118`: **Consider zeroizing the final Authorization header value.**\n\nThe raw credentials and base64-encoded intermediates are correctly wrapped in `Zeroizing`, but the final `format!(\"Basic {}\", &*encoded)` string is not. This leaves the base64-encoded credentials (which can be trivially decoded) in memory until the String is dropped.\n\n\n\n<details>\n<summary>🔒 Proposed improvement to zeroize the header value</summary>\n\n```diff\n if self.auth_method == ClientAuthMethod::Basic {\n     let credentials = Zeroizing::new(format!(\n         \"{}:{}\",\n         self.client_id,\n         self.client_secret.expose()\n     ));\n     let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n-    builder = builder.header(AUTHORIZATION.as_str(), &format!(\"Basic {}\", &*encoded));\n+    let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+    builder = builder.header(AUTHORIZATION.as_str(), &*header_value);\n }\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776090243","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776090243"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"submitted_at":"2026-02-10T00:18:51Z","commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119"},{"id":3776357382,"node_id":"PRR_kwDOPaLyBs7hFqQG","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 2**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit-auth/src/oauth2/source.rs`:\n- Around line 85-172: The code currently forces the token lifetime to be at\nleast self.default_ttl by computing lifetime_secs from\ntoken_resp.expires_in.unwrap_or(self.default_ttl.as_secs()).max(self.default_ttl.as_secs()),\nwhich can extend a server-provided short expires_in and cause refreshes after\nexpiry; change this so default_ttl is only a fallback: compute lifetime_secs as\ntoken_resp.expires_in.unwrap_or(self.default_ttl.as_secs()) (remove the\n.max(...) floor) so the server-sent expires_in is honored when present (refer to\ntoken_resp.expires_in, default_ttl, lifetime_secs in request_token).\n- Around line 36-83: Add an explicit precondition comment to\nOAuthTokenSource::new() stating that token_endpoint must already be resolved\n(e.g., via Token::new() calling discover_token_endpoint()) so callers know\ndiscovery happens earlier; alternatively, if you prefer a clearer API, rename\nOAuthTokenSource::new() to new_with_endpoint() (and update all call-sites such\nas Token::new() accordingly) to signal that a resolved token_endpoint is\nrequired. Ensure the docstring mentions the expected caller flow (Token::new() →\ndiscover_token_endpoint() → OAuthTokenSource::new()/new_with_endpoint()) and any\ninvariants about token_endpoint being Some.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (6)</summary><blockquote>\n\n<details>\n<summary>libs/modkit-auth/src/oauth2/mod.rs (1)</summary><blockquote>\n\n`6-20`: **Visibility polish: make `discover_token_endpoint` `pub(crate)` (or explain why it’s `pub`).**\n\n`pub(crate) mod discovery;` means external users can’t call discovery anyway, but the function inside is `pub`. Tightening it to `pub(crate)` reduces the chance of accidentally expanding API surface later if module visibility changes.\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/config.rs (1)</summary><blockquote>\n\n`61-90`: **Nice: config validation covers the key mutual-exclusion invariant; consider HTTPS-only validation as a defense-in-depth toggle.**\n\n`validate()` correctly enforces:\n- non-empty `client_id`\n- non-empty `client_secret`\n- exactly one of `token_endpoint` / `issuer_url`\n\nFor outbound auth flows, it may be worth optionally rejecting non-`https` endpoints by default (with an explicit “allow http” escape hatch for tests/dev), since sending client secrets over plain HTTP would be catastrophic.\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/lib.rs (1)</summary><blockquote>\n\n`7-53`: **Exports look coherent; consider feature-gating outbound OAuth2 if you want to keep default surface minimal.**\n\nRe-exporting the outbound OAuth2 pieces from `modkit-auth` is convenient. If binary footprint / dependency graph sensitivity is a concern for some consumers, a `feature = \"oauth2\"` gate around `pub mod oauth2;` + re-exports might be worth considering (totally optional, depends on crate goals).\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/discovery.rs (1)</summary><blockquote>\n\n`25-50`: **Prefer `Url` joining over string concatenation for discovery URL construction.**\n\n`issuer_url.as_str().trim_end_matches('/')` + `format!(\"{base}/.well-known/openid-configuration\")` works for the happy path, but it can behave oddly if `issuer_url` ever contains query/fragment components (or needs percent-encoding rules). Using `Url` APIs avoids subtle URL composition bugs.\n\nAlso: the final `InvalidResponse` for an invalid `token_endpoint` URL drops the `\"OIDC discovery\"` prefix—consider adding it for consistency with other errors.\n\n \n<details>\n<summary>Proposed refactor</summary>\n\n```diff\n pub async fn discover_token_endpoint(\n     client: &modkit_http::HttpClient,\n     issuer_url: &Url,\n ) -> Result<Url, TokenError> {\n-    let base = issuer_url.as_str().trim_end_matches('/');\n-    let discovery_url = format!(\"{base}/.well-known/openid-configuration\");\n+    let mut base = issuer_url.clone();\n+    // Normalize: trim trailing slash in the path (not via string concat)\n+    if base.path().ends_with('/') && base.path() != \"/\" {\n+        let trimmed = base.path().trim_end_matches('/');\n+        base.set_path(trimmed);\n+    }\n+    let discovery_url = base\n+        .join(\"/.well-known/openid-configuration\")\n+        .map_err(|e| TokenError::InvalidResponse(format!(\"OIDC discovery invalid issuer URL: {e}\")))?;\n\n     let doc: OidcDiscoveryDoc = client\n-        .get(&discovery_url)\n+        .get(discovery_url.as_str())\n         .send()\n         .await\n         .map_err(|e| TokenError::Http(crate::http_error::format_http_error(&e, \"OIDC discovery\")))?\n         .error_for_status()\n         .map_err(|e| TokenError::Http(crate::http_error::format_http_error(&e, \"OIDC discovery\")))?\n         .json()\n         .await\n         .map_err(|e| {\n             TokenError::InvalidResponse(crate::http_error::format_http_error(&e, \"OIDC discovery\"))\n         })?;\n\n     Url::parse(&doc.token_endpoint).map_err(|e| {\n         TokenError::InvalidResponse(format!(\n-            \"invalid token_endpoint URL in discovery document: {e}\"\n+            \"OIDC discovery invalid token_endpoint URL in discovery document: {e}\"\n         ))\n     })\n }\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/builder_ext.rs (1)</summary><blockquote>\n\n`1-2`: **Unused import: `tower::ServiceExt`**\n\nThe `ServiceExt` import on line 2 does not appear to be used in this file. The `boxed_clone()` method is called on the result of `tower::ServiceBuilder::new().layer(...).service(...)`, but `boxed_clone()` comes from `tower::util::ServiceExt` which is implicitly available via the `tower` prelude or re-exports.\n\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n use http::header::HeaderName;\n-use tower::ServiceExt;\n \n use super::layer::BearerAuthLayer;\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/oauth2/token.rs (1)</summary><blockquote>\n\n`145-154`: **Subsecond jitter precision is lost.**\n\n`DurationSecs` only accepts whole seconds, so `config.jitter_max.as_secs()` discards any subsecond component. For production use with multi-minute jitter windows this is fine, but the test config uses `Duration::from_millis(0)` which works correctly (0 seconds). Consider documenting this behavior or using a jitter type that supports finer granularity if sub-second jitter becomes relevant.\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776357382","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776357382"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"submitted_at":"2026-02-10T02:19:41Z","commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d"},{"id":3776442126,"node_id":"PRR_kwDOPaLyBs7hF-8O","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit-auth/src/oauth2/layer.rs`:\n- Around line 85-101: The bearer header inserted in the Layer::call\nimplementation should be marked sensitive to avoid token leakage: make the\ncreated HeaderValue mutable (bearer_value), call\nbearer_value.set_sensitive(true) after constructing it from\nHeaderValue::from_str, and then insert it into the request headers using\nself.header_name.clone(); update the match arm that builds bearer_value (and the\nvariable binding) in the call method so the HeaderValue is mutable and\nset_sensitive(true) is invoked before req.headers_mut().insert(...).\n```\n\n</details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776442126","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776442126"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"submitted_at":"2026-02-10T02:47:11Z","commit_id":"619e6e5b19da655053fe65f9e0ec3e21f6ddef35"},{"id":3776550609,"node_id":"PRR_kwDOPaLyBs7hGZbR","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 3**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/design.md`:\n- Around line 127-132: Update the design text that describes auth-layer\nplacement so it matches the actual builder behavior: change the description that\ncurrently says the auth layer sits “between OTel and retry” to state that\nHttpClientBuilder.with_bearer_auth inserts the auth layer inside the retry layer\n(i.e., between retry and timeout), so each retry will re-acquire the token;\nreference the HttpClientBuilder and with_bearer_auth in the prose to make the\nimplementation alignment explicit.\n\nIn `@libs/modkit-auth/docs/modkit-auth-client-impl.md`:\n- Around line 24-27: The docs reference for the shared HTTP error helper is\ninconsistent—`map_http_error` is suggested to be extracted to\nsrc/providers/http_error_mapping.rs but elsewhere the plan refers to\nsrc/http_error.rs; standardize to a single path and update code and docs\naccordingly. Pick one canonical module name (e.g.,\nsrc/providers/http_error_mapping.rs) and move or create the helper there (the\nfunction map_http_error and any TokenError mappings), then update all references\nin docs and code to import from that single module (replace any imports/usages\npointing to src/http_error.rs or alternative paths to the chosen module) so the\nexhaustive HttpError mapping is centralized and reused by both map_http_error\nand TokenError handling.\n\nIn `@libs/modkit-auth/src/oauth2/source.rs`:\n- Around line 109-120: Replace the current raw credential concatenation in the\nBasic branch (where self.auth_method == ClientAuthMethod::Basic, client_id,\nclient_secret, Zeroizing, encoded, header_value,\nbuilder.header(AUTHORIZATION.as_str(), &header_value)) with RFC 6749-compliant\nsteps: percent-encode client_id and client_secret separately using an\nx-www-form-urlencoded encoder, join them with \":\" to form the credential octet\nstring, base64-encode that result, wrap all plaintext in Zeroizing as before,\nset the Authorization header to \"Basic <base64>\" and ensure the resulting header\nis marked sensitive (so it cannot be accidentally logged or exposed).\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (2)</summary><blockquote>\n\n<details>\n<summary>libs/modkit-auth/docs/modkit-auth-client-impl.md (1)</summary><blockquote>\n\n`1-12`: **Add the ModKit architecture doc reference called out in learnings.**  \nThis plan touches ModKit/module architecture but doesn’t point to `@/docs/modkit_unified_system/README.md`. Please add a short “Required reading” link near the top. Based on learnings: “Open `@/docs/modkit_unified_system/README.md` when the task touches ModKit/module architecture including modules layout, `@/lib/modkit*`, plugins, REST wiring, ClientHub, OpenAPI, lifecycle/stateful tasks, SSE, or standardized HTTP errors”.\n\n</blockquote></details>\n<details>\n<summary>libs/modkit-auth/src/http_error.rs (1)</summary><blockquote>\n\n`17-50`: **Guard the fallback branch against future sensitive error details.**\n\nThe `_` arm currently formats `{e}`, which could expose sensitive data if future `HttpError` variants include body/headers in their `Display`. The function already demonstrates security awareness by explicitly excluding `body_preview` from `HttpStatus` errors; extend this pattern to the fallback by removing the error detail.\n\n<details>\n<summary>Proposed safer fallback</summary>\n\n```diff\n-        _ => format!(\"{prefix} request failed: {e}\"),\n+        _ => format!(\"{prefix} request failed\"),\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776550609","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3776550609"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"submitted_at":"2026-02-10T03:37:48Z","commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847"},{"id":3778301492,"node_id":"PRR_kwDOPaLyBs7hNE40","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 3**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/modkit-auth-client-impl.md`:\n- Around line 602-654: Update the Phase 5 docs to reflect the actual decoupled\nimplementation: remove instructions about adding an oauth feature and a\nbearer_auth field on HttpClientBuilder, and instead describe the existing\ngeneric hook HttpClientBuilder::with_auth_layer and the extension trait\nmodkit_auth::HttpClientBuilderExt that provides with_bearer_auth and\nwith_bearer_auth_header; explain that modkit-auth implements the bearer layer\nand exposes the extension trait so no workspace dependency or feature flag is\nadded to modkit-http and that all oauth-specific code lives in modkit-auth (no\nchanges to build() in builder.rs).\n- Around line 421-425: The documentation incorrectly describes get() as async\nand calling guard.watcher.token().await; update the doc for the method `get()`\nto show it's synchronous (remove \"pub async fn\" and any mention of `.await`),\nstate that it uses a lock-free read via `self.inner.load()` and calls the\nsynchronous `TokenWatcher::token()` to obtain the token, immediately wraps the\nreturned raw String in `SecretString`, and maps aliri_tokens errors to\n`TokenError::Unavailable`; reference `get()` and `TokenWatcher::token()` so\nreaders can find the actual implementations in the code.\n\nIn `@libs/modkit-auth/examples/oauth2_client_usage.rs`:\n- Around line 152-166: The current pattern matching on\nmodkit_http::HttpError::HttpStatus after calling client.get(...).send().await is\nunreachable because send() returns Ok(response) for 401; change the logic to\nfirst match the send() result (e.g., let resp = client.get(...).send().await),\npropagate any Err(e) immediately, then inspect resp.status() and if it equals\nhttp::StatusCode::UNAUTHORIZED call token.invalidate().await and retry the\nrequest (or call resp.error_for_status() to convert non-2xx into HttpError where\nappropriate); keep references to the resp variable, token.invalidate().await,\nand error_for_status() when implementing the fix.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>libs/modkit-http/src/builder.rs (1)</summary><blockquote>\n\n`278-300`: **Consider updating the stack order diagram to include the optional auth layer.**\n\nThe comment block documents the tower layer stack order but doesn't mention the optional auth layer. Adding a note would help developers understand where authentication fits.\n\n\n\n<details>\n<summary>📝 Suggested documentation update</summary>\n\n```diff\n         // Request flow (outer → inner):\n-        //   Buffer → OtelLayer → LoadShed/Concurrency → RetryLayer →\n-        //   ErrorMapping → Timeout → UserAgent → Decompression → FollowRedirect → hyper_client\n+        //   Buffer → OtelLayer → LoadShed/Concurrency → RetryLayer → [AuthLayer?] →\n+        //   Timeout → UserAgent → Decompression → FollowRedirect → hyper_client\n+        //\n+        // Note: AuthLayer (if set via with_auth_layer) sits inside the retry loop\n+        // so each retry attempt re-acquires credentials (e.g., refreshed bearer token).\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#pullrequestreview-3778301492","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","author_association":"CONTRIBUT
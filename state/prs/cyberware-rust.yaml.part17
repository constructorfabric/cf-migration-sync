ctions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329619","pull_request_review_id":3782734446,"id":2791329619,"node_id":"PRRC_kwDOPaLyBs6mYE9T","diff_hunk":"@@ -590,6 +590,12 @@ impl modkit::contracts::ApiGatewayCapability for ApiGateway {\n             router = self.add_openapi_routes(router)?;\n         }\n \n+        // Nest all routes under the configured prefix (e.g. \"/chat\")\n+        let prefix = self.prefix();\n+        if !prefix.is_empty() {\n+            router = axum::Router::new().nest(&prefix, router);\n+        }","path":"modules/system/api-gateway/src/module.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"303c2266fb45c4dcbe360265775943f991f55109","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n1\\. Unvalidated <b><i>prefix</i></b> used in <b><i>nest()</i></b> <code>📘 Rule violation</code> <code>⛨ Security</code>\n\n<pre>\nThe configured <b><i>prefix</i></b> is used directly in <b><i>Router::nest()</i></b> without validation/normalization, so\nmisconfigured values (e.g., missing leading <b><i>/</i></b>, trailing <b><i>/</i></b>, or unsafe segments) may cause runtime\npanics or unexpected route exposure. This violates requirements to validate external inputs and\nhandle edge cases gracefully.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\n`ApiGatewayConfig.prefix` is an externally-supplied configuration string and is used directly in `axum::Router::nest(&prefix, router)` without validation. Invalid prefixes (e.g., missing leading `/`, trailing `/`, `//`, whitespace, or unsafe segments like `..`) can cause runtime panics or unintended route layouts.\n\n## Issue Context\nThe PR introduces a configurable prefix intended for nesting routes (e.g. `/chat`). Since config is an external input, the gateway should normalize/validate it and fail fast with a clear error message if it is invalid.\n\n## Fix Focus Areas\n- modules/system/api-gateway/src/module.rs[593-597]\n- modules/system/api-gateway/src/config.rs[11-27]ضمون\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T04:12:27Z","updated_at":"2026-02-11T04:12:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329619","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329619"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329619"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":597,"original_start_line":593,"start_side":"RIGHT","line":601,"original_line":597,"side":"RIGHT","author_association":"NONE","original_position":17,"position":17,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329622","pull_request_review_id":3782734446,"id":2791329622,"node_id":"PRRC_kwDOPaLyBs6mYE9W","diff_hunk":"@@ -413,6 +413,8 @@ impl HostRuntime {\n                     source,\n                 })?;\n \n+        let mut base_router = Router::new();\n+\n         // 2) Register all REST providers (in the current discovery order)\n         for e in self.registry.modules() {\n             if let Some(rest) = e.caps.query::<RestApiCap>() {","path":"libs/modkit/src/runtime/host_runtime.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"303c2266fb45c4dcbe360265775943f991f55109","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n2\\. Health routes not served <code>🐞 Bug</code> <code>⛯ Reliability</code>\n\n<pre>\nHostRuntime now calls rest_finalize on a different Router than the one passed through rest_prepare,\nbut ApiGateway::rest_finalize stores the router it receives for serving. This drops /health and\n/healthz (and any other rest_prepare wiring) from the router actually used by the HTTP server.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n### Issue description\n`HostRuntime::run_rest_phase` currently calls `rest_prepare` on one router and `rest_finalize` on another. Because `ApiGateway::rest_finalize` stores the router it receives for `serve()`, the server will start without the `rest_prepare` routes (e.g. `/health`, `/healthz`).\n\n### Issue Context\nThe current composition (`router` + separate `base_router` + merge) happens after the gateway stores the finalized router. This breaks the intended contract that prepare + register + finalize produce the served router.\n\n### Fix Focus Areas\n- libs/modkit/src/runtime/host_runtime.rs[408-446]\n- modules/system/api-gateway/src/module.rs[563-607]\n- modules/system/api-gateway/src/module.rs[398-409]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T04:12:27Z","updated_at":"2026-02-11T04:12:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329622","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329622"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329622"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329622/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":416,"original_start_line":416,"start_side":"RIGHT","line":420,"original_line":420,"side":"RIGHT","author_association":"NONE","original_position":8,"position":8,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329624","pull_request_review_id":3782734446,"id":2791329624,"node_id":"PRRC_kwDOPaLyBs6mYE9Y","diff_hunk":"@@ -590,6 +590,12 @@ impl modkit::contracts::ApiGatewayCapability for ApiGateway {\n             router = self.add_openapi_routes(router)?;\n         }\n \n+        // Nest all routes under the configured prefix (e.g. \"/chat\")\n+        let prefix = self.prefix();\n+        if !prefix.is_empty() {\n+            router = axum::Router::new().nest(&prefix, router);\n+        }","path":"modules/system/api-gateway/src/module.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"303c2266fb45c4dcbe360265775943f991f55109","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n3\\. Auth policy bypassed <code>🐞 Bug</code> <code>⛨ Security</code>\n\n<pre>\nAfter nesting all routes under a prefix, the auth middleware resolves requirements using the full\nrequest path (including the prefix), but the GatewayRoutePolicy matchers are built from unprefixed\noperation paths. This can cause secured routes to be treated as having no specific security\nrequirement, potentially making them public when require_auth_by_default=false or weakening\nauthorization checks.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n### Issue description\nAfter nesting under a prefix, auth policy matching uses `/chat/...` request paths but the policy matchers are keyed by unprefixed spec paths like `/tenant-resolver/v1/...`. This can cause protected endpoints to become effectively public or lose authorization requirements.\n\n### Issue Context\n`modkit-auth` calls `RoutePolicy::resolve(request.method(), request.uri().path())`. The gateway currently builds matchers from operation specs without incorporating the configured prefix.\n\n### Fix Focus Areas\n- modules/system/api-gateway/src/module.rs[115-160]\n- modules/system/api-gateway/src/module.rs[582-607]\n- libs/modkit-auth/src/axum_ext.rs[138-148]\n- modules/system/api-gateway/src/auth.rs[123-147]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T04:12:27Z","updated_at":"2026-02-11T04:12:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329624","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329624"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329624"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329624/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":597,"original_start_line":593,"start_side":"RIGHT","line":601,"original_line":597,"side":"RIGHT","author_association":"NONE","original_position":17,"position":17,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329626","pull_request_review_id":3782734446,"id":2791329626,"node_id":"PRRC_kwDOPaLyBs6mYE9a","diff_hunk":"@@ -590,6 +590,12 @@ impl modkit::contracts::ApiGatewayCapability for ApiGateway {\n             router = self.add_openapi_routes(router)?;\n         }\n \n+        // Nest all routes under the configured prefix (e.g. \"/chat\")\n+        let prefix = self.prefix();\n+        if !prefix.is_empty() {\n+            router = axum::Router::new().nest(&prefix, router);\n+        }","path":"modules/system/api-gateway/src/module.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"303c2266fb45c4dcbe360265775943f991f55109","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n4\\. Docs ui broken <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\nThe docs HTML hardcodes absolute paths (e.g. &quot;/openapi.json&quot;, &quot;/docs/assets/...&quot;), but routes are\nnow nested under &quot;/chat&quot;. Browsers will request the root paths and get 404, breaking the interactive\ndocs page.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n### Issue description\nThe docs page HTML uses absolute URLs (`/openapi.json`, `/docs/assets/...`). After nesting under `/chat`, those absolute URLs point to non-existent routes, breaking the docs UI.\n\n### Issue Context\nRoutes are nested with `Router::nest(&prefix, router)`, shifting docs/OpenAPI under the prefix.\n\n### Fix Focus Areas\n- modules/system/api-gateway/src/web.rs[30-65]\n- modules/system/api-gateway/src/module.rs[582-607]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T04:12:27Z","updated_at":"2026-02-11T04:12:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329626","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329626"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329626"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329626/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":597,"original_start_line":593,"start_side":"RIGHT","line":601,"original_line":597,"side":"RIGHT","author_association":"NONE","original_position":17,"position":17,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329627","pull_request_review_id":3782734446,"id":2791329627,"node_id":"PRRC_kwDOPaLyBs6mYE9b","diff_hunk":"@@ -8,6 +8,10 @@ fn default_body_limit_bytes() -> usize {\n     16 * 1024 * 1024\n }\n \n+fn default_prefix() -> String {\n+    \"/chat\".to_owned()\n+}\n+\n /// API gateway configuration - reused from `api_gateway` module\n #[derive(Debug, Clone, Deserialize, Serialize, Default)]\n #[serde(deny_unknown_fields)]","path":"modules/system/api-gateway/src/config.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"303c2266fb45c4dcbe360265775943f991f55109","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n5\\. Gateway tests will fail <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\nApi-gateway tests assert root routes like &quot;/openapi.json&quot; and unprefixed operation paths, but\ndefault config now applies prefix &quot;/chat&quot;. Tests need updating (or must explicitly set prefix=&quot;&quot;) to\navoid 404s.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n### Issue description\nApi-gateway tests currently assume routes are rooted at `/`, but config now defaults to nesting under `/chat`. This will cause deterministic 404s in tests that call `/openapi.json` or other unprefixed endpoints.\n\n### Issue Context\nSerde default for `prefix` is `/chat`, and `rest_finalize` nests routes when `prefix` is non-empty.\n\n### Fix Focus Areas\n- modules/system/api-gateway/src/config.rs[11-26]\n- modules/system/api-gateway/src/module.rs[582-607]\n- modules/system/api-gateway/tests/auth_middleware.rs[300-334]\n- modules/system/api-gateway/tests/middleware_order.rs[90-110]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T04:12:27Z","updated_at":"2026-02-11T04:12:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329627","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329627"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791329627"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791329627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":11,"original_start_line":11,"start_side":"RIGHT","line":17,"original_line":17,"side":"RIGHT","author_association":"NONE","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791507828","pull_request_review_id":3
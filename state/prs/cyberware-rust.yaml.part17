ct ModKit's Extension<Arc<Service>> (or\nthe concrete Extension wrapper used in the repo) and pull the control plane from\nthat Extension in the same place where REST handlers use Extension<Arc<Service>>\n(see the ModKit unified system docs). Update the ADR example to use the concrete\nsymbol Extension<Arc<Service>> (or your project's Extension wrapper) and the\nappropriate service type so the control-plane injection is consistent with\nexisting DI usage.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654566","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654566"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654566"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1503,"original_start_line":1503,"start_side":"RIGHT","line":1505,"original_line":1505,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1551,"position":1551,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654570","pull_request_review_id":3777599335,"id":2786654570,"node_id":"PRRC_kwDOPaLyBs6mGPlq","diff_hunk":"@@ -352,145 +1393,343 @@ impl From<String> for Body {\n pub enum ClientError {\n     #[error(\"Request build error: {0}\")]\n     BuildError(String),\n-    \n+\n     #[error(\"Connection error: {0}\")]\n     Connection(String),\n-    \n+\n     #[error(\"Timeout: {0}\")]\n     Timeout(String),\n-    \n+\n     #[error(\"TLS error: {0}\")]\n     Tls(String),\n-    \n+\n     #[error(\"Protocol error: {0}\")]\n     Protocol(String),\n-    \n+\n     #[error(\"Connection closed\")]\n     ConnectionClosed,\n-    \n+\n     #[error(\"Invalid response: {0}\")]\n     InvalidResponse(String),\n-    \n+\n     #[error(\"I/O error: {0}\")]\n     Io(#[from] std::io::Error),\n-    \n+\n     #[error(\"HTTP error: {status}\")]\n     Http { status: StatusCode, body: Bytes },\n }\n ```\n \n-### Client Implementations\n+### Client Implementations\n+\n+#### Public API (Deployment-Agnostic)\n+\n+```rust\n+/// Main client type - works in both shared-process and remote modes\n+pub struct OagwClient {\n+    inner: OagwClientImpl,\n+}\n+\n+enum OagwClientImpl {\n+    SharedProcess(SharedProcessClient),\n+    RemoteProxy(RemoteProxyClient),\n+}\n+\n+impl OagwClient {\n+    /// Create client from configuration\n+    pub fn from_config(config: OagwClientConfig) -> Result<Self, ClientError> {\n+        let inner = match config.mode {\n+            ClientMode::SharedProcess { control_plane } => {\n+                OagwClientImpl::SharedProcess(SharedProcessClient::new(control_plane)?)\n+            }\n+            ClientMode::RemoteProxy { base_url, auth_token, timeout } => {\n+                OagwClientImpl::RemoteProxy(RemoteProxyClient::new(\n+                    base_url,\n+                    auth_token,\n+                    timeout,\n+                )?)\n+            }\n+        };\n+        Ok(Self { inner })\n+    }\n+\n+    /// Execute HTTP request through OAGW\n+    /// Response can be consumed as buffered or streaming\n+    pub async fn execute(&self, alias: &str, request: Request) -> Result<Response, ClientError> {\n+        match &self.inner {\n+            OagwClientImpl::SharedProcess(c) => c.execute(alias, request).await,\n+            OagwClientImpl::RemoteProxy(c) => c.execute(alias, request).await,\n+        }\n+    }\n+\n+    /// Establish WebSocket connection through OAGW\n+    pub async fn websocket(\n+        &self,\n+        alias: &str,\n+        request: Request,\n+    ) -> Result<WebSocketConn, ClientError> {\n+        match &self.inner {\n+            OagwClientImpl::SharedProcess(c) => c.websocket(alias, request).await,\n+            OagwClientImpl::RemoteProxy(c) => c.websocket(alias, request).await,\n+        }\n+    }\n+}\n+\n+/// Configuration for OagwClient\n+pub struct OagwClientConfig {\n+    pub mode: ClientMode,\n+    pub default_timeout: Duration,\n+}\n+\n+pub enum ClientMode {\n+    /// OAGW in same process - direct function calls (zero serialization)\n+    SharedProcess {\n+        control_plane: Arc<dyn ControlPlaneService>,\n+    },\n+    /// OAGW in separate process - HTTP calls to proxy endpoint\n+    RemoteProxy {\n+        base_url: String,\n+        auth_token: String,\n+        timeout: Duration,\n+    },\n+}\n+\n+impl OagwClientConfig {\n+    /// Automatically detect mode from environment\n+    pub fn from_env() -> Result<Self, ClientError> {\n+        // Check for OAGW_MODE environment variable\n+        match std::env::var(\"OAGW_MODE\").as_deref() {\n+            Ok(\"shared\") => {\n+                // In shared-process mode, control plane is injected by modkit\n+                let control_plane = get_control_plane_from_di()?;\n+                Ok(Self {\n+                    mode: ClientMode::SharedProcess { control_plane },\n+                    default_timeout: Duration::from_secs(30),\n+                })\n+            }\n+            Ok(\"remote\") | Ok(_) | Err(_) => {\n+                // Default to remote mode\n+                let base_url = std::env::var(\"OAGW_BASE_URL\")\n+                    .unwrap_or_else(|_| \"https://oagw.internal.cf\".to_string());\n+                let auth_token = std::env::var(\"OAGW_AUTH_TOKEN\")?;\n+                Ok(Self {\n+                    mode: ClientMode::RemoteProxy {\n+                        base_url,\n+                        auth_token,\n+                        timeout: Duration::from_secs(30),\n+                    },\n+                    default_timeout: Duration::from_secs(30),\n+                })\n+            }\n+        }\n+    }\n+}\n+```\n+\n+#### Shared-Process Client (Internal Implementation)\n \n-#### In-Process Client (DirectClient)\n+**Used when**: Internal module and OAGW run in the same process (development, single-executable deployment).\n \n ```rust\n-pub struct DirectClient {\n-    inner: reqwest::Client,\n+struct SharedProcessClient {\n+    control_plane: Arc<dyn ControlPlaneService>,\n     metrics: Arc<Metrics>,\n-    config: ClientConfig,\n-}\n-\n-pub struct ClientConfig {\n-    pub timeout: Duration,\n-    pub connect_timeout: Duration,\n-    pub pool_idle_timeout: Duration,\n-    pub pool_max_idle_per_host: usize,\n-    pub http2_prior_knowledge: bool,\n-    pub http2_adaptive_window: bool,\n-}\n-\n-impl DirectClient {\n-    pub fn new(config: ClientConfig) -> Result<Self, ClientError> {\n-        let inner = reqwest::Client::builder()\n-            .timeout(config.timeout)\n-            .connect_timeout(config.connect_timeout)\n-            .pool_idle_timeout(config.pool_idle_timeout)\n-            .pool_max_idle_per_host(config.pool_max_idle_per_host)\n-            .http2_prior_knowledge(config.http2_prior_knowledge)\n-            .http2_adaptive_window(config.http2_adaptive_window)\n-            .build()\n-            .map_err(|e| ClientError::BuildError(e.to_string()))?;\n-        \n+}\n+\n+impl SharedProcessClient {\n+    fn new(control_plane: Arc<dyn ControlPlaneService>) -> Result<Self, ClientError> {\n         Ok(Self {\n-            inner,\n+            control_plane,\n             metrics: Arc::new(Metrics::default()),\n-            config,\n         })\n     }\n-}\n \n-#[async_trait]\n-impl HttpClient for DirectClient {\n-    async fn execute(&self, request: Request) -> Result<Response, ClientError> {\n+    async fn execute(&self, alias: &str, request: Request) -> Result<Response, ClientError> {\n         let start = Instant::now();\n         self.metrics.requests_in_flight.inc();\n-        \n-        let req = self.build_reqwest_request(request)?;\n-        let resp = self.inner.execute(req).await\n-            .map_err(|e| self.map_reqwest_error(e))?;\n-        \n-        let status = resp.status();\n-        let headers = resp.headers().clone();\n-        let body = resp.bytes().await\n-            .map_err(|e| ClientError::Io(std::io::Error::new(\n-                std::io::ErrorKind::Other, \n-                e\n-            )))?;\n-        \n+\n+        // Direct function call to Control Plane (zero serialization overhead)\n+        let proxy_request = ProxyRequest {\n+            alias: alias.to_string(),\n+            method: request.method().clone(),\n+            path: request.path().to_string(),\n+            headers: request.headers().clone(),\n+            body: request.into_body(),\n+        };\n+\n+        let proxy_response = self.control_plane.proxy_request(proxy_request).await\n+            .map_err(|e| ClientError::Connection(e.to_string()))?;\n+\n         self.metrics.requests_in_flight.dec();\n         self.metrics.request_duration.observe(start.elapsed().as_secs_f64());\n-        self.metrics.requests_total.with_label_values(&[status.as_str()]).inc();\n-        \n+\n+        // Parse X-OAGW-Error-Source header\n+        let error_source = proxy_response.headers\n+            .get(\"x-oagw-error-source\")\n+            .and_then(|v| v.to_str().ok())\n+            .map(|s| match s {\n+                \"gateway\" => ErrorSource::Gateway,\n+                \"upstream\" => ErrorSource::Upstream,\n+                _ => ErrorSource::Unknown,\n+            })\n+            .unwrap_or(ErrorSource::Unknown);\n+\n+        // Response body can be buffered or streaming\n+        // Control Plane determines this based on upstream response\n+        let body = if proxy_response.is_streaming {\n+            ResponseBody::Streaming(proxy_response.body_stream)\n+        } else {\n+            ResponseBody::Buffered(proxy_response.body)\n+        };\n+\n         Ok(Response {\n-            status,\n-            headers,\n+            status: proxy_response.status,\n+            headers: proxy_response.headers,\n             body,\n+            error_source,\n             extensions: Extensions::default(),\n         })\n     }\n-    \n-    async fn execute_streaming(&self, request: Request) -> Result<StreamingResponse, ClientError> {\n-        let req = self.build_reqwest_request(request)?;\n-        let resp = self.inner.execute(req).await\n+\n+    async fn websocket(&self, alias: &str, request: Request) -> Result<WebSocketConn, ClientError> {\n+        let proxy_request = ProxyRequest {\n+            alias: alias.to_string(),\n+            method: request.method().clone(),\n+            path: request.path().to_string(),\n+            headers: request.headers().clone(),\n+            body: request.into_body(),\n+        };\n+\n+        let ws_conn = self.control_plane.proxy_websocket(proxy_request).await\n+            .map_err(|e| ClientError::Connection(e.to_string()))?;\n+\n+        Ok(ws_conn)\n+    }\n+}\n+```\n+\n+#### Remote OAGW Client (Internal Implementation)\n+\n+**Used when**: Internal module and OAGW run in separate processes (production, microservice deployment).\n+\n+```rust\n+struct RemoteProxyClient {\n+    oagw_base_url: String,      // e.g., \"https://oagw.internal.cf\"\n+    http_client: reqwest::Client,\n+    auth_token: String,\n+    metrics: Arc<Metrics>,\n+}\n+\n+impl RemoteProxyClient {\n+    fn new(\n+        base_url: String,\n+        auth_token: String,\n+        timeout: Duration,\n+    ) -> Result<Self, ClientError> {\n+        let http_client = reqwest::Client::builder()\n+            .timeout(timeout)\n+            .connect_timeout(Duration::from_secs(5))\n+            .build()\n+            .map_err(|e| ClientError::BuildError(e.to_string()))?;\n+\n+        Ok(Self {\n+            oagw_base_url: base_url,\n+            http_client,\n+            auth_token,\n+            metrics: Arc::new(Metrics::default()),\n+        })\n+    }\n+\n+    async fn execute(&self, alias: &str, request: Request) -> Result<Response, ClientError> {\n+        let start = Instant::now();\n+        self.metrics.requests_in_flight.inc();\n+\n+        // Build URL: https://oagw.internal.cf/api/oagw/v1/proxy/{alias}{path}\n+        let url = format!(\"{}/api/oagw/v1/proxy/{}{}\",\n+            self.oagw_base_url, alias, request.path());\n+\n+        let mut req_builder = self.http_client.request(request.method().clone(), &url)\n+            .header(\"Authorization\", format!(\"Bearer {}\", self.auth_token));\n+\n+        // Forward all headers from original request\n+        for (name, value) in request.headers() {\n+            req_builder = req_builder.header(name, value);\n+        }\n+\n+        // Set body\n+        match request.into_body() {\n+            Body::Empty => {}\n+            Body::Bytes(b) => {\n+                req_builder = req_builder.body(b.to_vec());\n+            }\n+            Body::Stream(_) => {\n+                return Err(ClientError::BuildError(\n+                    \"Streaming body not supported for plain requests\".into()\n+                ));\n+            }\n+        }\n+\n+        let resp = req_builder.send().await\n             .map_err(|e| self.map_reqwest_error(e))?;\n-        \n+\n         let status = resp.status();\n         let headers = resp.headers().clone();\n-        \n-        // Convert reqwest::Response to async stream\n+\n+        // Parse X-OAGW-Error-Source header\n+        let error_source = headers\n+            .get(\"x-oagw-error-source\")\n+            .and_then(|v| v.to_str().ok())\n+            .map(|s| match s {\n+                \"gateway\" => ErrorSource::Gateway,\n+                \"upstream\" => ErrorSource::Upstream,\n+                _ => ErrorSource::Unknown,\n+            })\n+            .unwrap_or(ErrorSource::Unknown);\n+\n+        // Always return as streaming - consumer decides if they want to buffer\n+        // This allows flexibility: .bytes() for buffered, .into_stream() for streaming\n         let stream = resp.bytes_stream()\n             .map_err(|e| ClientError::Io(std::io::Error::new(\n                 std::io::ErrorKind::Other,\n                 e\n             )));\n-        \n-        Ok(StreamingResponse {\n+\n+        self.metrics.requests_in_flight.dec();\n+        self.metrics.request_duration.observe(start.elapsed().as_secs_f64());\n+\n+        Ok(Response {\n             status,\n             headers,\n-            body: Box::pin(stream),\n+            body: ResponseBody::Streaming(Box::pin(stream)),\n+            error_source,\n+            extensions: Extensions::default(),\n         })\n     }\n-    \n-    async fn websocket(&self, request: Request) -> Result<WebSocketConn, ClientError> {\n-        // WebSocket upgrade using tokio-tungstenite\n-        let uri = request.uri().to_string();\n+\n+    async fn websocket(&self, alias: &str, request: Request) -> Result<WebSocketConn, ClientError> {\n+        // Build WebSocket URL: wss://oagw.internal.cf/api/oagw/v1/proxy/{alias}{path}\n+        let ws_url = self.oagw_base_url\n+            .replace(\"https://\", \"wss://\")\n+            .replace(\"http://\", \"ws://\");\n+        let url = format!(\"{}/api/oagw/v1/proxy/{}{}\", ws_url, alias, request.path());\n+\n         let req = tokio_tungstenite::tungstenite::http::Request::builder()\n-            .uri(&uri)\n+            .uri(&url)\n+            .header(\"Authorization\", format!(\"Bearer {}\", self.auth_token))\n             .header(\"Connection\", \"Upgrade\")\n             .header(\"Upgrade\", \"websocket\")\n             .header(\"Sec-WebSocket-Version\", \"13\")\n             .header(\"Sec-WebSocket-Key\", generate_ws_key())\n             .body(())\n             .map_err(|e| ClientError::BuildError(e.to_string()))?;","path":"modules/system/oagw/docs/adr-rust-abi-client-library.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**WebSocket path ignores `Request` headers.**\n\n`request.headers()` are never forwarded for WebSocket upgrades, so subprotocols or custom auth headers are silently dropped. Mirror the HTTP path behavior and explicitly filter hop‑by‑hop headers.  \n\n\n<details>\n<summary>🔧 Suggested fix (forward request headers safely)</summary>\n\n```diff\n-        let req = tokio_tungstenite::tungstenite::http::Request::builder()\n+        let mut req_builder = tokio_tungstenite::tungstenite::http::Request::builder()\n             .uri(&url)\n             .header(\"Authorization\", format!(\"Bearer {}\", self.auth_token))\n             .header(\"Connection\", \"Upgrade\")\n             .header(\"Upgrade\", \"websocket\")\n             .header(\"Sec-WebSocket-Version\", \"13\")\n             .header(\"Sec-WebSocket-Key\", generate_ws_key())\n-            .body(())\n+            ;\n+        for (name, value) in request.headers() {\n+            if name != reqwest::header::AUTHORIZATION\n+                && name.as_str().to_ascii_lowercase() != \"connection\"\n+                && name.as_str().to_ascii_lowercase() != \"upgrade\"\n+                && name.as_str().to_ascii_lowercase() != \"sec-websocket-key\"\n+                && name.as_str().to_ascii_lowercase() != \"sec-websocket-version\"\n+            {\n+                req_builder = req_builder.header(name, value);\n+            }\n+        }\n+        let req = req_builder.body(())\n             .map_err(|e| ClientError::BuildError(e.to_string()))?;\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/docs/adr-rust-abi-client-library.md` around lines 1716 -\n1724, The WebSocket Request builder currently only sets a few headers\n(Authorization, Connection, Upgrade, Sec-WebSocket-*) and thus ignores and drops\nincoming request.headers(); fix by iterating over the original request.headers()\nand forwarding them into the websocket Request builder (the same builder that\nproduces req) while explicitly skipping hop-by-hop headers (e.g., \"connection\",\n\"upgrade\", \"sec-websocket-key\", \"sec-websocket-version\", \"sec-websocket-accept\",\n\"keep-alive\", \"proxy-authenticate\", \"proxy-authorization\", \"te\", \"trailers\") and\navoiding duplicate headers you already set (like Authorization/Upgrade); use the\nsame conversion used elsewhere for header name/value (to_str or proper\nHeaderValue creation) and preserve subprotocols so Sec-WebSocket-Protocol is\nforwarded when present, and keep mapping build errors to ClientError::BuildError\nas before.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654570","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654570"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654570"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654570/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1716,"original_start_line":1716,"start_side":"RIGHT","line":1724,"original_line":1724,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1835,"position":1835,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654578","pull_request_review_id":3777599335,"id":2786654578,"node_id":"PRRC_kwDOPaLyBs6mGPly","diff_hunk":"@@ -875,116 +1895,289 @@ pub struct WebTransportStream {\n #[cfg(test)]\n mod tests {\n     use super::*;\n-    \n+\n+    // Helper to create client for tests\n+    fn create_test_client() -> OagwClient {\n+        let config = OagwClientConfig {\n+            mode: ClientMode::RemoteProxy {\n+                base_url: \"https://oagw.internal.cf\".to_string(),\n+                auth_token: \"test-token\".to_string(),\n+                timeout: Duration::from_secs(30),\n+            },\n+            default_timeout: Duration::from_secs(30),\n+        };\n+        OagwClient::from_config(config).unwrap()\n+    }\n+\n     #[tokio::test]\n-    async fn test_plain_request() {\n-        let client = DirectClient::new(ClientConfig::default()).unwrap();\n-        \n+    async fn test_buffered_response() {\n+        // Buffer entire response (default consumption pattern)\n+        let client = create_test_client();\n+\n         let request = Request::builder()\n-            .method(Method::GET)\n-            .uri(\"https://httpbin.org/get\")\n+            .method(Method::POST)\n+            .path(\"/v1/chat/completions\")\n+            .json(&json!({\"model\": \"gpt-4\", \"messages\": []}))\n+            .unwrap()\n             .build()\n             .unwrap();\n-        \n-        let response = client.execute(request).await.unwrap();\n+\n+        let response = client.execute(\"openai\", request).await.unwrap();\n+\n         assert_eq!(response.status(), StatusCode::OK);\n+        assert_eq!(response.error_source(), ErrorSource::Upstream);\n+\n+        // Consume as JSON (buffers automatically)\n+        let data = response.json::<ChatResponse>().await.unwrap();\n+        assert!(!data.choices.is_empty());\n     }\n-    \n+\n     #[tokio::test]\n     async fn test_streaming_response() {\n-        let client = DirectClient::new(ClientConfig::default()).unwrap();\n-        \n+        // Stream response (for SSE)\n+        let client = create_test_client();\n+\n         let request = Request::builder()\n-            .method(Method::GET)\n-            .uri(\"https://httpbin.org/stream/3\")\n+            .method(Method::POST)\n+            .path(\"/v1/chat/completions\")\n+            .json(&json!({\"model\": \"gpt-4\", \"messages\": [], \"stream\": true}))\n+            .unwrap()\n             .build()\n             .unwrap();\n-        \n-        let mut response = client.execute_streaming(request).await.unwrap();\n-        \n+\n+        let response = client.execute(\"openai\", request).await.unwrap();\n+\n+        assert_eq!(response.status(), StatusCode::OK);\n+        assert_eq!(response.error_source(), ErrorSource::Upstream);\n+\n+        // Consume as stream\n+        let mut stream = response.into_stream();\n         let mut chunks = 0;\n-        while let Some(chunk) = response.body_stream().next().await {\n+        while let Some(chunk) = stream.next().await {\n             chunk.unwrap();\n             chunks += 1;\n         }\n-        \n+\n         assert!(chunks > 0);\n     }\n-    \n+\n+    #[tokio::test]\n+    async fn test_sse_streaming() {\n+        // Server-Sent Events consumption\n+        let client = create_test_client();\n+\n+        let request = Request::builder()\n+            .method(Method::POST)\n+            .path(\"/v1/chat/completions\")\n+            .json(&json!({\"model\": \"gpt-4\", \"messages\": [], \"stream\": true}))\n+            .unwrap()\n+            .build()\n+            .unwrap();\n+\n+        let response = client.execute(\"openai\", request).await.unwrap();\n+\n+        // Consume as SSE events\n+        let mut sse = response.into_sse_stream();\n+        while let Some(event) = sse.next_event().await.unwrap() {\n+            println!(\"SSE event: {}\", event.data);\n+            if event.data.contains(\"[DONE]\") {\n+                break;\n+            }\n+        }\n+    }\n+\n     #[tokio::test]\n     async fn test_websocket() {\n-        let client = DirectClient::new(ClientConfig::default()).unwrap();\n-        \n+        let client = create_test_client();\n+\n         let request = Request::builder()\n-            .uri(\"wss://echo.websocket.org\")\n+            .method(Method::GET)\n+            .path(\"/ws\")\n             .build()\n             .unwrap();\n-        \n-        let mut conn = client.websocket(request).await.unwrap();\n-        \n+\n+        let mut conn = client.websocket(\"echo-service\", request).await.unwrap();\n+\n         conn.send(WsMessage::Text(\"hello\".into())).await.unwrap();\n         let msg = conn.recv().await.unwrap().unwrap();\n-        \n+\n         match msg {\n             WsMessage::Text(s) => assert_eq!(s, \"hello\"),\n             _ => panic!(\"Expected text message\"),\n         }\n     }\n+\n+    #[tokio::test]\n+    async fn test_error_source_gateway() {\n+        let client = create_test_client();\n+\n+        let request = Request::builder()\n+            .method(Method::GET)\n+            .path(\"/nonexistent\")\n+            .build()\n+            .unwrap();\n+\n+        let response = client.execute(\"invalid-alias\", request).await.unwrap();\n+\n+        // OAGW returns 404 for unknown alias\n+        assert_eq!(response.status(), StatusCode::NOT_FOUND);\n+        assert_eq!(response.error_source, ErrorSource::Gateway);\n+    }","path":"modules/system/oagw/docs/adr-rust-abi-client-library.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Use the public accessor for `error_source`.**\n\nThe example reads the private field directly; the struct exposes `error_source()` for this.  \n\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n-        assert_eq!(response.error_source, ErrorSource::Gateway);\n+        assert_eq!(response.error_source(), ErrorSource::Gateway);\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/docs/adr-rust-abi-client-library.md` around lines 2022 -\n2025, The test is accessing the private field directly on the response; replace\nthe direct field access with the public accessor method by calling\nresponse.error_source() in the assertion so it compares the returned ErrorSource\nagainst ErrorSource::Gateway (keep the assert_eq! for StatusCode::NOT_FOUND\nas-is). Ensure you reference the response variable and the error_source() method\nrather than response.error_source.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits cff4866 to 9f1410f","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T12:43:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654578","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654578"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654578"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654578/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":2022,"original_start_line":2022,"start_side":"RIGHT","line":2025,"original_line":2025,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":2427,"position":2427,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654583","pull_request_review_id":3777599335,"id":2786654583,"node_id":"PRRC_kwDOPaLyBs6mGPl3","diff_hunk":"@@ -0,0 +1,10 @@\n+[package]\n+name = \"cf-oagw-sdk\"\n+version.workspace = true\n+edition.workspace = true\n+\n+[lib]\n+name = \"oagw_sdk\"\n+path = \"src/lib.rs\"\n+\n+[dependencies]","path":"modules/system/oagw/oagw-sdk/Cargo.toml","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# Check the root Cargo.toml for workspace members\nrg -A 50 '\\[workspace\\]' Cargo.toml | head -100\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2073\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if cf-oagw-sdk or oagw-sdk is listed in workspace members\nrg -n 'oagw' Cargo.toml\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 54\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check the structure of the oagw module directory\nfd -t f Cargo.toml modules/system/oagw | head -20\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 301\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if DEPENDENCIES.md and NEW_MODULE.md exist\nfd -t f 'DEPENDENCIES.md|NEW_MODULE.md' guidelines\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 123\n\n---\n\n🏁 Script executed:\n\n```shell\nhead -50 guidelines/DEPENDENCIES.md guidelines/NEW_MODULE.md\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 4165\n\n---\n\n\n\n</details>\n\n**Add `modules/system/oagw/oagw-sdk` to the root workspace members.**\n\nThe `cf-oagw-sdk` crate exists but is not registered in the root `Cargo.toml` workspace members list. This prevents the crate from building as part of the workspace. Add `\"modules/system/oagw/oagw-sdk\"` to the members array in the root `Cargo.toml`, following the pattern used by similar SDK crates like `modules/system/nodes_registry/nodes_registry-sdk`.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/oagw-sdk/Cargo.toml` around lines 1 - 10, The new crate\n\"cf-oagw-sdk\" (lib name oagw_sdk) in modules/system/oagw/oagw-sdk is not listed\nin the root workspace members, so it won't build as part of the workspace;\nupdate the root Cargo.toml's members array to include\n\"modules/system/oagw/oagw-sdk\" (following the pattern used for\nmodules/system/nodes_registry/nodes_registry-sdk) so the cf-oagw-sdk crate is\npicked up by the workspace build.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654583","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654583"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654583"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654583/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":10,"original_line":10,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654589","pull_request_review_id":3777599335,"id":2786654589,"node_id":"PRRC_kwDOPaLyBs6mGPl9","diff_hunk":"@@ -0,0 +1,438 @@\n+# Cache Invalidation Flow\n+\n+## Overview\n+\n+Cache invalidation ensures consistency across Data Plane and Control Plane caches when configuration changes. Writes trigger immediate invalidation in DP L1/L2, followed by CP L1\n+notification.\n+\n+## Cache Architecture\n+\n+### Data Plane Caches\n+\n+- **L1 (In-Memory)**: LRU cache, 10k entries, <1μs access\n+- **L2 (Redis, Optional)**: Shared across DP instances, ~1-2ms access\n+- **Database**: Source of truth, ~5-10ms access\n+\n+### Control Plane Cache\n+\n+- **L1 (In-Memory)**: LRU cache, 1000 entries, <1μs access\n+- **No L2**: CP depends on DP for config resolution\n+\n+## Invalidation Trigger: Config Write\n+\n+When a management operation modifies configuration (upstream, route, plugin), invalidation flows through multiple layers.\n+\n+## Scenario 1: Update Upstream Config\n+\n+### Initial State\n+\n+**CP L1 cache**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (cached 5 minutes ago)\n+```\n+\n+**DP L1 cache**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (cached 10 minutes ago)\n+```\n+\n+**DP L2 cache (Redis)**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (TTL: 3 minutes remaining)\n+```","path":"modules/system/oagw/scenarios/cache-invalidation.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Add language tags to fenced blocks (markdownlint MD040).**  \nMultiple code fences lack a language tag, which triggers MD040. Please add tags (e.g., `text`, `http`, `json`) consistently.\n\n\n<details>\n<summary>Example fix (apply across all fences)</summary>\n\n```diff\n- ```\n+ ```text\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n**CP L1 cache**:\n\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.20.0)</summary>\n\n[warning] 31-31: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n---\n\n[warning] 37-37: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n---\n\n[warning] 43-43: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n````\nIn `@modules/system/oagw/scenarios/cache-invalidation.md` around lines 29 - 45,\nAdd explicit language tags to all fenced code blocks in\nmodules/system/oagw/scenarios/cache-invalidation.md to satisfy markdownlint\nMD040; for the three caches shown (the CP L1, DP L1 and DP L2 fenced blocks that\ncurrently start with ```), update each fence to include a language like \"text\"\n(e.g., change ``` to ```text) so they become ```text ... ``` consistently across\nthe file.\n````\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654589","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654589"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654589"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654589/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":29,"original_start_line":29,"start_side":"RIGHT","line":45,"original_line":45,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":45,"position":45,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654594","pull_request_review_id":3777599335,"id":2786654594,"node_id":"PRRC_kwDOPaLyBs6mGPmC","diff_hunk":"@@ -0,0 +1,438 @@\n+# Cache Invalidation Flow\n+\n+## Overview\n+\n+Cache invalidation ensures consistency across Data Plane and Control Plane caches when configuration changes. Writes trigger immediate invalidation in DP L1/L2, followed by CP L1\n+notification.\n+\n+## Cache Architecture\n+\n+### Data Plane Caches\n+\n+- **L1 (In-Memory)**: LRU cache, 10k entries, <1μs access\n+- **L2 (Redis, Optional)**: Shared across DP instances, ~1-2ms access\n+- **Database**: Source of truth, ~5-10ms access\n+\n+### Control Plane Cache\n+\n+- **L1 (In-Memory)**: LRU cache, 1000 entries, <1μs access\n+- **No L2**: CP depends on DP for config resolution\n+\n+## Invalidation Trigger: Config Write\n+\n+When a management operation modifies configuration (upstream, route, plugin), invalidation flows through multiple layers.\n+\n+## Scenario 1: Update Upstream Config\n+\n+### Initial State\n+\n+**CP L1 cache**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (cached 5 minutes ago)\n+```\n+\n+**DP L1 cache**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (cached 10 minutes ago)\n+```\n+\n+**DP L2 cache (Redis)**:\n+\n+```\n+upstream:{tenant_id}:openai → {...config...} (TTL: 3 minutes remaining)\n+```\n+\n+### Management Request\n+\n+```http\n+PUT /api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679... HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"server\": {\n+    \"endpoints\": [\n+      { \"scheme\": \"https\", \"host\": \"api.openai.com\", \"port\": 443 }\n+    ]\n+  },\n+  \"protocol\": \"gts.x.core.oagw.protocol.v1~x.core.http.v1\",\n+  \"alias\": \"openai\",\n+  \"rate_limit\": {\n+    \"sustained\": { \"rate\": 50, \"window\": \"minute\" }\n+  }\n+}\n+```\n+\n+### Invalidation Flow\n+\n+```\n+Client → API Handler\n+  ↓\n+API Handler → Data Plane\n+  ↓\n+┌─────────────────────────────────────┐\n+│ Data Plane Processing               │\n+├─────────────────────────────────────┤\n+│ 1. Validate request                 │\n+│ 2. Write to database                │\n+│    UPDATE oagw_upstream             │\n+│    SET config = ...                 │\n+│    WHERE id = ...                   │\n+│                                     │\n+│ 3. Invalidate DP L1 cache           │\n+│    DELETE upstream:{tenant}:openai  │\n+│                                     │\n+│ 4. Invalidate DP L2 cache (Redis)  │\n+│    DEL upstream:{tenant}:openai     │\n+│                                     │\n+│ 5. Return success                   │\n+└─────────────────────────────────────┘\n+  ↓\n+API Handler receives success\n+  ↓\n+API Handler → Control Plane (notification)\n+  ↓\n+┌─────────────────────────────────────┐\n+│ Control Plane Processing            │\n+├─────────────────────────────────────┤\n+│ 1. Receive invalidation message     │\n+│    {                                │\n+│      \"cache_key\": \"upstream:...\",   │\n+│      \"tenant_id\": \"...\",            │\n+│      \"upstream_id\": \"...\"           │\n+│    }                                │\n+│                                     │\n+│ 2. Invalidate CP L1 cache           │\n+│    DELETE upstream:{tenant}:openai  │\n+│                                     │\n+│ 3. Acknowledge                      │\n+└─────────────────────────────────────┘\n+  ↓\n+API Handler → Client (200 OK)\n+```\n+\n+### Post-Invalidation State\n+\n+**CP L1 cache**:\n+\n+```\n+(empty - invalidated)\n+```\n+\n+**DP L1 cache**:\n+\n+```\n+(empty - invalidated)\n+```\n+\n+**DP L2 cache (Redis)**:\n+\n+```\n+(empty - invalidated)\n+```\n+\n+**Database**:\n+\n+```\n+upstream config = updated value (source of truth)\n+```\n+\n+### Next Proxy Request\n+\n+```\n+Client → API Handler → Control Plane\n+  ↓\n+CP checks L1 cache: MISS\n+  ↓\n+CP calls DP.resolve_upstream(\"openai\")\n+  ↓\n+DP checks L1 cache: MISS\n+  ↓\n+DP checks L2 cache: MISS\n+  ↓\n+DP queries database: HIT (fresh config)\n+  ↓\n+DP populates L1 and L2 with fresh config\n+  ↓\n+DP returns to CP\n+  ↓\n+CP populates L1 with fresh config\n+  ↓\n+CP uses fresh config for request\n+```\n+\n+**Result**: Next request uses updated rate limit (50/min instead of 100/min).\n+\n+## Scenario 2: Create New Route\n+\n+### Management Request\n+\n+```http\n+POST /api/oagw/v1/routes HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"upstream_id\": \"gts.x.core.oagw.upstream.v1~7c9e6679...\",\n+  \"match\": {\n+    \"http\": {\n+      \"methods\": [\"POST\"],\n+      \"path\": \"/v1/completions\"\n+    }\n+  }\n+}\n+```\n+\n+### Invalidation Flow\n+\n+```\n+Data Plane:\n+  1. Insert into oagw_route table\n+  2. No cache to invalidate (new resource)\n+  3. Return 201 Created\n+\n+No CP notification needed (route not cached yet)\n+```\n+\n+**Result**: Next request matching this route will query DP, get fresh route, cache it.\n+\n+## Scenario 3: Delete Upstream (with cascade)\n+\n+### Management Request\n+\n+```http\n+DELETE /api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679...?cascade=true HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+```\n+\n+### Invalidation Flow\n+\n+```\n+Data Plane:\n+  1. Find all routes for upstream\n+     SELECT id FROM oagw_route WHERE upstream_id = ...\n+     Result: [route1, route2, route3]\n+\n+  2. Delete routes (cascade)\n+     DELETE FROM oagw_route WHERE upstream_id = ...\n+\n+  3. Delete upstream\n+     DELETE FROM oagw_upstream WHERE id = ...\n+\n+  4. Invalidate all affected cache keys:\n+     DP L1/L2:\n+       - upstream:{tenant}:openai\n+       - route:{upstream_id}:POST:/v1/chat/completions\n+       - route:{upstream_id}:POST:/v1/completions\n+       - route:{upstream_id}:GET:/v1/models\n+\n+  5. Return 204 No Content\n+\n+API Handler:\n+  Notify CP to invalidate all affected keys\n+```\n+\n+**Result**: All cached config for this upstream and its routes invalidated.\n+\n+## Scenario 4: Multi-Instance Environment\n+\n+### Setup\n+\n+3 Data Plane instances behind load balancer, shared Redis L2 cache.\n+2 Control Plane instances.\n+\n+### Update Flow\n+\n+```\n+Client → API Handler → DP Instance 1\n+  ↓\n+DP1:\n+  1. Write to database (shared)\n+  2. Flush DP1 L1 cache (local)\n+  3. Flush Redis L2 cache (shared)\n+  4. Return success\n+  ↓\n+API Handler → Broadcast to all CP instances\n+  ↓\n+CP1: Flush L1 cache (local)\n+CP2: Flush L1 cache (local)\n+```\n+\n+### Next Request to Different Instance\n+\n+```\n+Client → API Handler → CP2\n+  ↓\n+CP2 L1: MISS (just flushed)\n+  ↓\n+CP2 → DP Instance 2 (load balanced)\n+  ↓\n+DP2 L1: MISS (different instance)\n+  ↓\n+DP2 L2 (Redis): MISS (shared, was flushed)\n+  ↓\n+DP2 Database: HIT (shared, has fresh data)\n+  ↓\n+DP2 populates L1 and L2\n+  ↓\n+DP2 → CP2\n+  ↓\n+CP2 populates L1\n+  ↓\n+Fresh config used\n+```\n+\n+**Result**: Invalidation works across multiple instances via shared L2 and DB.\n+\n+## Invalidation Timing\n+\n+| Event               | Latency         |\n+|---------------------|-----------------|\n+| DP L1 flush         | <1ms (local)    |\n+| DP L2 flush (Redis) | 1-2ms (network) |\n+| CP notification     | 10-50ms (async) |\n+| CP L1 flush         | <1ms (local)    |\n+\n+**Total window**: ~50-100ms from write to all caches invalidated.\n+\n+**Staleness window**: Worst case 100ms for CP to receive notification and flush.\n+\n+## Consistency Guarantees\n+\n+### Strong Consistency in DP\n+\n+- L1 flush before returning success\n+- L2 flush before returning success\n+- Next DP read sees fresh data\n+\n+### Eventual Consistency in CP\n+\n+- Notification is asynchronous\n+- CP may serve stale data for ~50-100ms\n+- Acceptable for MVP (config changes are rare)\n+\n+### Future: Immediate Consistency\n+\n+For strict consistency requirements:\n+\n+1. CP waits for DP write + invalidation to complete\n+2. CP synchronously flushes its L1 before proxy call\n+3. Adds latency, only enable if needed\n+\n+## Cache Key Patterns\n+\n+### Upstream\n+\n+```\n+upstream:{tenant_id}:{alias}\n+```\n+\n+Invalidated on:\n+\n+- `PUT /upstreams/{id}`\n+- `DELETE /upstreams/{id}`\n+\n+### Route\n+\n+```\n+route:{upstream_id}:{method}:{path}\n+```\n+\n+Invalidated on:\n+\n+- `PUT /routes/{id}`\n+- `DELETE /routes/{id}`\n+- `DELETE /upstreams/{id}` (cascade)\n+\n+### Plugin\n+\n+```\n+plugin:{plugin_id}\n+```","path":"modules/system/oagw/scenarios/cache-invalidation.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Include tenant_id in route/plugin cache keys to avoid cross-tenant bleed.**  \nRoute/plugin keys are tenant-agnostic; if IDs aren’t globally unique or if matching is tenant-scoped, caches can cross-pollinate. Align with upstream keying by adding `{tenant_id}` or explicitly documenting global uniqueness.\n\n\n<details>\n<summary>Suggested doc adjustment</summary>\n\n```diff\n- route:{upstream_id}:{method}:{path}\n+ route:{tenant_id}:{upstream_id}:{method}:{path}\n\n- plugin:{plugin_id}\n+ plugin:{tenant_id}:{plugin_id}\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.20.0)</summary>\n\n[warning] 331-331: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n---\n\n[warning] 342-342: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n---\n\n[warning] 354-354: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/scenarios/cache-invalidation.md` around lines 327 - 356,\nThe route and plugin cache key patterns are missing tenant scoping which can\ncause cross-tenant cache bleed; update the route key pattern\n\"route:{upstream_id}:{method}:{path}\" to include tenant context (e.g.,\n\"route:{tenant_id}:{upstream_id}:{method}:{path}\") and update the plugin key\n\"plugin:{plugin_id}\" to include tenant_id (e.g.,\n\"plugin:{tenant_id}:{plugin_id}\") or explicitly state that plugin_id/upstream_id\nare globally unique; change any invalidation rules that reference these keys\n(e.g., invalidations on PUT/DELETE for routes/plugins and cascade on DELETE\n/upstreams/{id}) to use the new tenant-scoped key format so cache invalidation\nremains correct per tenant.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654594","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654594"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654594"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654594/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":327,"original_start_line":327,"start_side":"RIGHT","line":356,"original_line":356,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":356,"position":356,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654601","pull_request_review_id":3777599335,"id":2786654601,"node_id":"PRRC_kwDOPaLyBs6mGPmJ","diff_hunk":"@@ -0,0 +1,74 @@\n+# List upstreams includes disabled resources\n+\n+## Step 1: Create enabled upstream\n+\n+```http\n+POST /api/oagw/v1/upstreams HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"server\": {\n+    \"endpoints\": [\n+      { \"scheme\": \"https\", \"host\": \"api.enabled.com\", \"port\": 443 }\n+    ]\n+  },\n+  \"protocol\": \"gts.x.core.oagw.protocol.v1~x.core.http.v1\",\n+  \"alias\": \"api.enabled.com\"\n+}\n+```\n+\n+Expected: `201 Created` with `enabled: true` (default).\n+\n+## Step 2: Create disabled upstream\n+\n+```http\n+POST /api/oagw/v1/upstreams HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"server\": {\n+    \"endpoints\": [\n+      { \"scheme\": \"https\", \"host\": \"api.disabled.com\", \"port\": 443 }\n+    ]\n+  },\n+  \"protocol\": \"gts.x.core.oagw.protocol.v1~x.core.http.v1\",\n+  \"alias\": \"api.disabled.com\",\n+  \"enabled\": false\n+}\n+```\n+\n+Expected: `201 Created` with `enabled: false`.\n+\n+## Step 3: List all upstreams\n+\n+```http\n+GET /api/oagw/v1/upstreams HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+```\n+\n+## Expected response\n+\n+- `200 OK`\n+- Response contains both upstreams:\n+  - `api.enabled.com` with `enabled: true`\n+  - `api.disabled.com` with `enabled: false`\n+- Each resource includes `enabled` field explicitly\n+\n+## Step 4: Filter to enabled only (optional OData)\n+\n+```http\n+GET /api/oagw/v1/upstreams?$filter=enabled%20eq%20true HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+```\n+\n+## Expected response\n+\n+- `200 OK`\n+- Response contains only `api.enabled.com`\n+- `api.disabled.com` is excluded","path":"modules/system/oagw/scenarios/management-api/upstreams/positive-2.12-list-upstreams-includes-disabled-resources.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Avoid duplicate “Expected response” heading (MD024).**  \nRename the second heading to clarify it refers to the filtered list.\n\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-## Expected response\n+## Expected response (filtered)\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n## Expected response (filtered)\n\n- `200 OK`\n- Response contains only `api.enabled.com`\n- `api.disabled.com` is excluded\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.20.0)</summary>\n\n[warning] 70-70: Multiple headings with the same content\n\n(MD024, no-duplicate-heading)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn\n`@modules/system/oagw/scenarios/management-api/upstreams/positive-2.12-list-upstreams-includes-disabled-resources.md`\naround lines 70 - 74, The file contains a duplicate \"Expected response\" heading\n(MD024); rename the second heading (the one before the bullet list that\ndescribes `200 OK` and included/excluded hosts) to a unique, descriptive title\nsuch as \"Expected filtered response\" or \"Filtered list\" and update any internal\nreferences to that section accordingly so the duplicate-heading rule is\nsatisfied; look for the second \"Expected response\" heading in the markdown\naround the example response and replace it with the new heading.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:45Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654601","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654601"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654601"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654601/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":70,"original_start_line":70,"start_side":"RIGHT","line":74,"original_line":74,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":74,"position":74,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654614","pull_request_review_id":3777599335,"id":2786654614,"node_id":"PRRC_kwDOPaLyBs6mGPmW","diff_hunk":"@@ -0,0 +1,236 @@\n+# Management Operations Flow\n+\n+## Overview\n+\n+Management operations (CRUD for upstreams, routes, plugins) are routed directly from API Handler to Data Plane. This document describes the request flow and cache invalidation behavior.\n+\n+## Request Flow\n+\n+```\n+Client Request\n+  → API Handler (auth, rate limit)\n+    → Data Plane (validate, write DB, invalidate cache)\n+      → Response\n+```\n+\n+## Component Responsibilities\n+\n+### API Handler\n+- Validates Bearer token\n+- Applies inbound rate limiting\n+- Routes request to Data Plane based on path pattern:\n+  - `/api/oagw/v1/upstreams/*` → DP\n+  - `/api/oagw/v1/routes/*` → DP\n+  - `/api/oagw/v1/plugins/*` → DP\n+\n+### Data Plane\n+- Validates request payload against schema\n+- Checks tenant authorization (via SecureConn scoping)\n+- Writes to database\n+- Invalidates affected cache entries (L1 and L2)\n+- Returns success/error response\n+\n+## Example: Create Upstream\n+\n+### Request\n+\n+```http\n+POST /api/oagw/v1/upstreams HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"server\": {\n+    \"endpoints\": [\n+      { \"scheme\": \"https\", \"host\": \"api.openai.com\", \"port\": 443 }\n+    ]\n+  },\n+  \"protocol\": \"gts.x.core.oagw.protocol.v1~x.core.http.v1\",\n+  \"alias\": \"openai\"\n+}\n+```\n+\n+### Flow Steps\n+\n+1. **API Handler** receives request\n+   - Validates Bearer token → 401 if invalid\n+   - Checks `oagw:upstream:create` permission → 403 if denied\n+   - Routes to Data Plane\n+\n+2. **Data Plane** processes request\n+   - Validates JSON schema\n+   - Checks alias uniqueness within tenant\n+   - Writes to `oagw_upstream` table (scoped to tenant)\n+   - Returns `201 Created` with upstream ID\n+\n+3. **No cache invalidation** (new resource, nothing cached yet)\n+\n+### Response\n+\n+```http\n+HTTP/1.1 201 Created\n+Content-Type: application/json\n+Location: /api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679...\n+\n+{\n+  \"id\": \"gts.x.core.oagw.upstream.v1~7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n+  \"tenant_id\": \"...\",\n+  \"alias\": \"openai\",\n+  \"server\": { ... },\n+  \"enabled\": true,\n+  \"created_at\": \"2026-02-09T12:00:00Z\"\n+}\n+```\n+\n+## Example: Update Upstream\n+\n+### Request\n+\n+```http\n+PUT /api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679... HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+Content-Type: application/json\n+\n+{\n+  \"server\": {\n+    \"endpoints\": [\n+      { \"scheme\": \"https\", \"host\": \"api.openai.com\", \"port\": 443 }\n+    ]\n+  },\n+  \"protocol\": \"gts.x.core.oagw.protocol.v1~x.core.http.v1\",\n+  \"alias\": \"openai\",\n+  \"rate_limit\": {\n+    \"sustained\": { \"rate\": 100, \"window\": \"minute\" }\n+  }\n+}\n+```\n+\n+### Flow Steps\n+\n+1. **API Handler** validates and routes to DP\n+\n+2. **Data Plane** processes update\n+   - Loads existing upstream (tenant-scoped)\n+   - Validates changes\n+   - Writes to database\n+   - **Invalidates caches**:\n+     - DP L1: `upstream:{tenant_id}:openai`\n+     - DP L2 (Redis): `upstream:{tenant_id}:openai`\n+   - Notifies API Handler to notify CP instances\n+\n+3. **API Handler** notifies Control Plane\n+   - Sends cache invalidation message to CP instances\n+   - CP flushes its L1 cache for this upstream\n+\n+4. **Response** returned\n+\n+### Cache Invalidation Flow\n+\n+```\n+DP writes to DB\n+  → DP flushes L1 cache\n+  → DP flushes L2 cache (Redis)\n+  → DP returns success to API Handler\n+  → API Handler notifies CP to flush L1 cache\n+```\n+\n+### Response\n+\n+```http\n+HTTP/1.1 200 OK\n+Content-Type: application/json\n+\n+{\n+  \"id\": \"gts.x.core.oagw.upstream.v1~7c9e6679...\",\n+  \"tenant_id\": \"...\",\n+  \"alias\": \"openai\",\n+  \"rate_limit\": {\n+    \"sustained\": { \"rate\": 100, \"window\": \"minute\" }\n+  },\n+  \"updated_at\": \"2026-02-09T12:05:00Z\"\n+}\n+```\n+\n+## Example: Delete Upstream\n+\n+### Request\n+\n+```http\n+DELETE /api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679... HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <tenant-token>\n+```\n+\n+### Flow Steps\n+\n+1. **API Handler** validates and routes to DP\n+\n+2. **Data Plane** processes deletion\n+   - Checks if upstream has dependent routes\n+   - If `cascade=true`: deletes routes first\n+   - If `cascade=false` and routes exist: returns `409 Conflict`\n+   - Deletes upstream from database\n+   - Invalidates all related cache entries:\n+     - Upstream config\n+     - All routes for this upstream\n+\n+3. **Cache invalidation** propagates to CP\n+\n+### Response (success)\n+\n+```http\n+HTTP/1.1 204 No Content\n+```\n+\n+### Response (conflict)\n+\n+```http\n+HTTP/1.1 409 Conflict\n+Content-Type: application/problem+json\n+\n+{\n+  \"type\": \"gts.x.core.errors.err.v1~x.oagw.config.upstream_has_routes.v1\",\n+  \"title\": \"Upstream Has Dependent Routes\",\n+  \"status\": 409,\n+  \"detail\": \"Cannot delete upstream with active routes. Use cascade=true or delete routes first.\",\n+  \"instance\": \"/api/oagw/v1/upstreams/gts.x.core.oagw.upstream.v1~7c9e6679...\",\n+  \"route_count\": 3\n+}\n+```\n+\n+## Cache Keys Affected\n+\n+Management operations invalidate these cache keys:\n+\n+### Upstream Operations\n+- DP L1/L2: `upstream:{tenant_id}:{alias}`\n+- CP L1: Same key (notified by API Handler)\n+\n+### Route Operations\n+- DP L1/L2: `route:{upstream_id}:{method}:{path}`\n+- CP L1: Same key (notified by API Handler)\n+\n+### Plugin Operations\n+- DP L1/L2: `plugin:{plugin_id}`\n+- CP L1: Same key (if plugin was cached)","path":"modules/system/oagw/scenarios/management-operations.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Plugin cache key missing `tenant_id` — potential cross-tenant cache leakage.**\n\nThe plugin cache key `plugin:{plugin_id}` does not include `tenant_id`, unlike upstream and route keys. This conflicts with RISK-05 from the security review which recommends including `tenant_id` in all cache keys to prevent cross-tenant leaks.\n\n\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n ### Plugin Operations\n-- DP L1/L2: `plugin:{plugin_id}`\n+- DP L1/L2: `plugin:{tenant_id}:{plugin_id}`\n - CP L1: Same key (if plugin was cached)\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n### Plugin Operations\n- DP L1/L2: `plugin:{tenant_id}:{plugin_id}`\n- CP L1: Same key (if plugin was cached)\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/scenarios/management-operations.md` around lines 215 -\n217, The plugin cache key \"plugin:{plugin_id}\" omits tenant_id and can cause\ncross-tenant cache leakage; update all places that set or read the plugin cache\n(the DP L1/L2 and CP L1 flows that use the key \"plugin:{plugin_id}\") to include\ntenant_id (e.g., \"plugin:{tenant_id}:{plugin_id}\") so the cache is namespaced\nper tenant, and adjust any cache get/set/delete calls or helpers that build the\nkey to accept/derive tenant_id accordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T08:53:46Z","updated_at":"2026-02-10T08:53:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654614","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654614"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2786654614"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654614/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":215,"original_start_line":215,"start_side":"RIGHT","line":217,"original_line":217,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":217,"position":217,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2786654620","pull_request_review_id":3777599335,"id":2786654620,"node_id":"PRRC_kwDOPaLyBs6mGPmc","diff_hunk":"@@ -0,0 +1,339 @@\n+# Proxy Operations Flow\n+\n+## Overview\n+\n+Proxy operations execute API calls to external services. Requests are routed from API Handler → Control Plane → Data Plane (config resolution) → Control Plane (execution).\n+","path":"modules/system/oagw/scenarios/proxy-operations.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"c4001447ea4b5a7a1747d7b00479084589d01bd9","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubuse
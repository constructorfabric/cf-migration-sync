rabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Fix the Rust example (typo and likely incorrect `contains` usage).**  \nThe snippet shows `& &` and `contains(\"*\")`, which is invalid and potentially misleading for `Vec<String>`.  \n\n<details>\n<summary>Suggested doc fix</summary>\n\n```diff\n-if config.allow_credentials & & config.allowed_origins.contains(\"*\") {\n-  return Err(\"Cannot use allow_credentials with wildcard origin\");\n-}\n+if config.allow_credentials && config.allowed_origins.iter().any(|o| o == \"*\") {\n+  return Err(\"Cannot use allow_credentials with wildcard origin\");\n+}\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/docs/adr-cors.md` around lines 353 - 356, Fix the typo\nand incorrect contains usage in the Rust example: replace the stray \"& &\" with\nthe logical operator \"&&\", and change the wildcard check from\nconfig.allowed_origins.contains(\"*\") to a valid Vec<String> check such as\nconfig.allowed_origins.contains(&\"*\".to_string()) or\nconfig.allowed_origins.iter().any(|o| o == \"*\"); keep the rest of the\nconditional using config.allow_credentials and return Err(...) as shown.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T13:44:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715675","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715675"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715675"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715675/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":353,"original_start_line":353,"start_side":"RIGHT","line":356,"original_line":356,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":296,"position":296,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715679","pull_request_review_id":3773384752,"id":2782715679,"node_id":"PRRC_kwDOPaLyBs6l3N8f","diff_hunk":"@@ -424,53 +431,53 @@ impl HttpClient for DirectClient {\n     async fn execute(&self, request: Request) -> Result<Response, ClientError> {\n         let start = Instant::now();\n         self.metrics.requests_in_flight.inc();\n-        \n+\n         let req = self.build_reqwest_request(request)?;\n         let resp = self.inner.execute(req).await\n             .map_err(|e| self.map_reqwest_error(e))?;\n-        \n+\n         let status = resp.status();\n         let headers = resp.headers().clone();\n         let body = resp.bytes().await\n             .map_err(|e| ClientError::Io(std::io::Error::new(\n-                std::io::ErrorKind::Other, \n+                std::io::ErrorKind::Other,\n                 e\n             )))?;\n-        \n+\n         self.metrics.requests_in_flight.dec();\n         self.metrics.request_duration.observe(start.elapsed().as_secs_f64());\n         self.metrics.requests_total.with_label_values(&[status.as_str()]).inc();","path":"modules/system/oagw/docs/adr-rust-abi-client-library.md","commit_id":"59ec3ad08935366fc94a9dbd6274bddd9d00dd06","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Ensure `requests_in_flight` is decremented on all error paths.**  \n`requests_in_flight.inc()` occurs before `build_reqwest_request` and `execute`, but the snippet never decrements on early returns from those fallible calls, which will inflate in-flight metrics and hide stuck counters. Consider a scope guard or explicit decrement in each error path.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/docs/adr-rust-abi-client-library.md` around lines 432 -\n449, The requests_in_flight counter is incremented before fallible calls\n(build_reqwest_request, self.inner.execute, and resp.bytes().await) but only\ndecremented on the successful path; ensure it is decremented on every early\nreturn by adding a scope guard or explicit decrements in each map_err/err\nbranch. Specifically, ensure requests_in_flight.dec() runs if\nbuild_reqwest_request returns Err, if self.inner.execute(...) fails\n(map_reqwest_error closure), and if resp.bytes().await fails (the\nClientError::Io branch), so the counter is always decremented before returning\nan Err; you can implement this by using a RAII guard that calls\nrequests_in_flight.dec() on Drop or by calling\nself.metrics.requests_in_flight.dec() inside each error-mapping closure and\nbefore constructing the ClientError::Io in the bytes() error path.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T13:44:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715679","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715679"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715679"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715679/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":432,"start_side":"RIGHT","line":null,"original_line":449,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":205,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715682","pull_request_review_id":3773384752,"id":2782715682,"node_id":"PRRC_kwDOPaLyBs6l3N8i","diff_hunk":"@@ -0,0 +1,161 @@\n+# ADR: State Management\n+\n+- **Status**: Accepted\n+- **Date**: 2026-02-09\n+- **Deciders**: OAGW Team\n+\n+## Context\n+\n+With Control Plane (CP) calling Data Plane (DP) for config resolution, we need to decide how state is managed:\n+\n+- Should CP cache frequently-accessed configs?\n+- Where should rate limiters live?\n+- How do we balance performance vs consistency?\n+\n+## Decision\n+\n+**CP has its own L1 cache** for hot configs + **rate limiters** owned by CP.\n+\n+### CP State\n+\n+```rust\n+pub struct CPState {\n+    // Small L1 cache for hot configs (1000 entries, LRU)\n+    hot_cache: Arc<Mutex<LruCache<CacheKey, ConfigValue>>>,\n+\n+    // Connection to Data Plane\n+    dp_client: Arc<dyn DataPlaneService>,\n+\n+    // HTTP client for external services\n+    http_client: Arc<HttpClient>,\n+\n+    // Rate limiters (per-upstream, per-route)\n+    rate_limiters: Arc<RateLimiterRegistry>,\n+}\n+```\n+\n+### DP State\n+\n+```rust\n+pub struct DPState {\n+    // L1: In-memory cache (10k entries, LRU)\n+    l1_cache: Arc<Mutex<LruCache<CacheKey, ConfigValue>>>,\n+\n+    // L2: Optional Redis (shared across instances)\n+    l2_cache: Option<Arc<RedisClient>>,\n+\n+    // Database connection pool\n+    db_pool: Arc<DbConnectionPool>,\n+}\n+```\n+\n+### Request Flow with Caching\n+\n+```\n+CP receives proxy request\n+├─ Check CP L1 cache for upstream config\n+│  ├─ Hit: Use cached config (<1μs)\n+│  └─ Miss: Call DP.resolve_upstream()\n+│           ├─ DP checks L1 cache\n+│           ├─ DP checks L2 cache (if enabled)\n+│           ├─ DP queries DB\n+│           └─ CP caches result in L1\n+│\n+├─ Check CP L1 cache for route config\n+│  ├─ Hit: Use cached config\n+│  └─ Miss: Call DP.resolve_route()\n+│\n+├─ Execute auth plugin\n+├─ Check rate limiter (CP-owned)\n+├─ Execute guard plugins\n+├─ Execute transform plugins\n+├─ HTTP call to external service\n+└─ Return response\n+```\n+\n+### Cache Invalidation\n+\n+On config write (e.g., `PUT /upstreams/{id}`):\n+\n+1. DP writes to database\n+2. DP flushes own L1 and L2 caches\n+3. DP returns success\n+4. API Handler notifies CP to flush its L1 cache (or CP periodically syncs)\n+\n+### CP Cache Size\n+\n+- Max 1000 entries (small, focused on hot paths)\n+- LRU eviction\n+- No TTL (relies on explicit invalidation)\n+- Configurable via environment variable","path":"modules/system/oagw/docs/adr-state-management.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify TTL vs “short‑lived” cache entries.**\n\nThis section states “No TTL,” but the mitigation calls out “short‑lived cache entries,” which implies TTLs. Please reconcile the policy (either add TTLs or remove the short‑lived wording).  \n\n<details>\n<summary>💡 Possible doc tweak</summary>\n\n```diff\n-**Mitigation**: Explicit cache invalidation from DP, short-lived cache entries.\n+**Mitigation**: Explicit cache invalidation from DP (no TTLs in MVP).\n```\n</details>\n\n\nAlso applies to: 137-139\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/docs/adr-state-management.md` around lines 87 - 90, The\ndoc is inconsistent: the bullets state \"No TTL\" but elsewhere mention\n\"short‑lived cache entries\"; update the ADR to be consistent by either (A)\nremoving any \"short‑lived\" wording and clarifying that cache relies solely on\nLRU + explicit invalidation (keep \"No TTL\"), or (B) introduce a TTL policy\n(e.g., default TTL, configurable via env var) and update bullets to reflect\n\"Optional TTL for short‑lived entries\" plus how it interacts with LRU and\ninvalidation; edit the phrases \"No TTL\" and any occurrences of \"short‑lived\ncache entries\" to match the chosen option and include the config symbol name\nused for TTL if you add it.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T13:44:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715682","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715682"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715682"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715682/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":87,"original_start_line":87,"start_side":"RIGHT","line":90,"original_line":90,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":90,"position":90,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715695","pull_request_review_id":3773384752,"id":2782715695,"node_id":"PRRC_kwDOPaLyBs6l3N8v","diff_hunk":"@@ -44,13 +45,25 @@\n \n OAGW manages all outbound API requests from CyberFabric to external services.\n \n+**Component Architecture**: OAGW is composed of three distinct components that work together:\n+- **API Handler**: Entry point for all requests, handles incoming auth/rate limiting, routes to CP or DP\n+- **Control Plane (CP)**: Orchestrates proxy requests, executes calls to external services\n+- **Data Plane (DP)**: Manages configuration data (upstreams/routes/plugins) with multi-layer caching\n+","path":"modules/system/oagw/PRD.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify rate‑limiting ownership (API Handler vs CP).**\n\nOverview states the API Handler handles rate limiting, while later sections/ADRs describe CP‑owned rate limiters for proxy flow. Please clarify the scope (e.g., ingress authz throttling vs outbound per‑upstream/route limiting) to avoid conflicting interpretations.  \n\n\n\nAlso applies to: 175-181\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/PRD.md` around lines 48 - 52, Clarify the rate‑limiting\nownership by stating that the \"API Handler\" is responsible for ingress-level\nconcerns (authentication/authorization throttling and global per-client ingress\nrequest limits), while the \"Control Plane (CP)\" owns proxy/outbound rate\nlimiting (per-upstream, per-route, and per-plugin limits) and is responsible for\nconfiguring and distributing those rate-limiting policies to the Data Plane\n(DP); update the OAGW component list and any ADR sections that mention rate\nlimiting (including the CP proxy flow descriptions) to explicitly map ingress vs\noutbound responsibilities and note that DP enforces CP-distributed limits at\nruntime.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit d4f1c80","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T14:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715695","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715695"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715695"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":49,"original_start_line":48,"start_side":"RIGHT","line":53,"original_line":52,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":16,"position":43,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715700","pull_request_review_id":3773384752,"id":2782715700,"node_id":"PRRC_kwDOPaLyBs6l3N80","diff_hunk":"@@ -299,15 +334,15 @@ Legend (used in checks):\n - What to check:\n   - Parent `rate_limit.sharing=enforce` still constrains child effective limit.\n \n-### [x] 6.3 Justification: Multi-endpoint common-suffix alias requires `Host` header\n-- Scenario: [`negative-6.3-multi-endpoint-common-suffix-alias-requires-host-header.md`](proxy-api/alias-resolution/negative-6.3-multi-endpoint-common-suffix-alias-requires-host-header.md)\n+### [x] 6.3 Justification: Multi-endpoint common-suffix alias requires `X-OAGW-Target-Host` header\n+- Scenario: [`negative-6.3-multi-endpoint-common-suffix-alias-requires-host-header.md`](proxy-api/alias-resolution/negative-6.3-multi-endpoint-common-suffix-alias-requires-host-header.md) *(superseded by section 6.5)*\n - Why it matters:\n   - Avoid ambiguous endpoint selection and SSRF-by-host-header tricks.\n - What to check:\n   - For alias `vendor.com` backed by endpoints `us.vendor.com`, `eu.vendor.com`:\n-    - Missing inbound `Host` yields `400 HOST_HEADER_REQUIRED` (or defined error), `ESrc=gateway`.\n-    - With `Host: us.vendor.com` routes to that endpoint.\n-    - With `Host` not in pool rejects.\n+    - Missing routing header yields `400` error, `ESrc=gateway`.\n+    - With valid routing header routes to that endpoint.\n+    - With routing header not in pool rejects.","path":"modules/system/oagw/scenarios/INDEX.md","commit_id":"d4f1c8004fe311de47399a46fa8d4c332a32b7ae","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Align scenario naming with X-OAGW-Target-Host.**\n\nThe 6.3 scenario title/filename still says “host header” while the content and 6.5 section use `X-OAGW-Target-Host`. Consider renaming the scenario (or adding an explicit deprecation note) to avoid confusion for test implementers.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/oagw/scenarios/INDEX.md` around lines 337 - 345, Rename the\n6.3 scenario title/filename and any internal references from “host header” to\n“X-OAGW-Target-Host” (e.g., update the scenario title and the filename\nnegative-6.3-multi-endpoint-common-suffix-alias-requires-host-header.md and its\ntitle/header text) or add a clear deprecation note at the top stating that “host\nheader” is superseded by X-OAGW-Target-Host; ensure all mentions in INDEX.md and\nthe scenario markdown refer to X-OAGW-Target-Host consistently so implementers\naren’t confused.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit d4f1c80","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T14:06:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715700","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715700"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715700"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":337,"start_side":"RIGHT","line":null,"original_line":345,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":66,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715704","pull_request_review_id":3773384752,"id":2782715704,"node_id":"PRRC_kwDOPaLyBs6l3N84","diff_hunk":"@@ -0,0 +1,47 @@\n+# Unknown X-OAGW-Target-Host not in endpoint list\n+\n+## Setup\n+\n+- Upstream `vendor.com` with multiple endpoints:\n+  - `endpoints`: `[{\"scheme\": \"https\", \"host\": \"us.vendor.com\", \"port\": 443}, {\"scheme\": \"https\", \"host\": \"eu.vendor.com\", \"port\": 443}]`\n+  - `alias`: `vendor.com`\n+\n+## Request\n+\n+```http\n+POST /api/oagw/v1/proxy/vendor.com/v1/api/resource HTTP/1.1\n+Host: oagw.example.com\n+Authorization: Bearer <token>\n+X-OAGW-Target-Host: apac.vendor.com\n+Content-Type: application/json\n+\n+{\"key\": \"value\"}\n+```\n+\n+## Expected behavior\n+\n+- Request is rejected with `400 Bad Request`\n+- Error response:\n+\n+```http\n+HTTP/1.1 400 Bad Request\n+X-OAGW-Error-Source: gateway\n+Content-Type: application/problem+json\n+\n+{\n+  \"type\": \"gts.x.core.errors.err.v1~x.oagw.routing.unknown_target_host.v1\",\n+  \"title\": \"Unknown Target Host\",\n+  \"status\": 400,\n+  \"detail\": \"X-OAGW-Target-Host 'apac.vendor.com' does not match any configured endpoint. Valid hosts: [us.vendor.com, eu.vendor.com]\",\n+  \"instance\": \"/api/oagw/v1/proxy/vendor.com/v1/api/resource\",\n+  \"upstream_id\": \"gts.x.core.oagw.upstream.v1~...\",\n+  \"invalid_value\": \"apac.vendor.com\",\n+  \"valid_hosts\": [\"us.vendor.com\", \"eu.vendor.com\"]\n+}","path":"modules/system/oagw/scenarios/proxy-api/custom-header-routing/negative-2.1-unknown-host.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Consider whether exposing `valid_hosts` should be configurable.**\n\nReturning the full allowlist can leak upstream topology in some deployments; consider documenting/guarding it behind a debug or non‑prod setting if that’s a concern.  \n\n\n\nAlso applies to: 45-47\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn\n`@modules/system/oagw/scenarios/proxy-api/custom-header-routing/negative-2.1-unknown-host.md`\naround lines 35 - 40, The error payload currently returns a \"valid_hosts\" array\n(and \"invalid_value\"/\"detail\") which can leak upstream topology; change the\nerror-generation logic that emits this unknown-host response to make inclusion\nof the \"valid_hosts\" field configurable (e.g., via a boolean flag like\nshow_valid_hosts_in_errors or expose_valid_hosts) and default it to false for\nproduction, only enabling it for debug/non‑prod environments; update the\nunknown-host error builder to omit \"valid_hosts\" unless the flag is true (apply\nthe same change for the other referenced unknown-host responses that include\nlines similar to \"valid_hosts\" / \"invalid_value\" / \"detail\").\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-09T13:44:00Z","updated_at":"2026-02-09T13:44:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782715704","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782715704"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#di
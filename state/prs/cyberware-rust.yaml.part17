{\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@MikeFalcon77` Fair points—you're right that for a `pub(crate)` type with a single internal caller and a clear error path, the existing docstring is sufficient. The fail-fast behavior and error message already communicate the requirement, and adding more ceremony for an internal API would indeed be churn without practical benefit. Thanks for the context!\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T02:32:43Z","updated_at":"2026-02-10T02:32:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785474789","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785474789"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785474789"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785474789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":37,"original_start_line":36,"start_side":"RIGHT","line":82,"original_line":83,"side":"RIGHT","in_reply_to_id":2785440223,"author_association":"CONTRIBUTOR","original_position":83,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785474803","pull_request_review_id":3776397580,"id":2785474803,"node_id":"PRRC_kwDOPaLyBs6mBvjz","diff_hunk":"@@ -0,0 +1,464 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"### Question: \nThe docstring on line 41 already says Returns TokenError::ConfigError if token_endpoint is None — that's the precondition. OAuthTokenSource is pub(crate) (the module source is pub(crate) in mod.rs), so it's not part of the public API. Only Token::new() calls it internally. Renaming to new_with_endpoint() would touch 17+ call sites (mostly tests) for zero functional benefit on a crate-internal type. The existing code already fails fast with a clear error if token_endpoint is None. This is a nice to have comment that adds churn without real value. I'd skip it.\n\n### Answer:\nTo reduce “nice-to-have” churn like renaming crate-internal APIs or adding doc-only comments when the code already fails fast, add a repo-level instruction for the `/improve` suggestions to bias toward functional issues and avoid refactors/docs for non-public items.\n\nAdd this to your `.pr_agent.toml` (or wiki config):\n\n```toml\n[pr_code_suggestions]\nextra_instructions=\"\"\"\\\n- Prioritize functional correctness, bugs, security, and test failures.\n- Avoid suggestions that only add/modify docstrings or comments unless they clarify a public API contract.\n- Do not suggest renaming symbols (functions/types/constructors) unless it fixes a bug or significantly reduces a real ambiguity in the public API.\n- Treat `pub(crate)`/crate-internal items as non-public: avoid “API clarity” changes (renames/extra docs) unless multiple call-sites outside a single module are impacted or a real bug is likely.\n- If an invariant is already enforced via explicit error handling (e.g., returns ConfigError when a field is None), do not suggest “document the precondition” as a standalone change.\n\"\"\"\n```\n\nIf you want the tool even more “problems only”, keep (or ensure) this default stays enabled:\n\n```toml\n[pr_code_suggestions]\nfocus_only_on_problems = true\n```\n\nIf you share which platform you’re running on (GitHub App vs Action vs CLI) and whether this suggestion came from `/improve` or another tool, I can tailor where to place this config and how to scope it (global vs repo vs wiki).\n\n#### Relevant Sources:\n\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions-and-best-practices\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#configuration-options\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/faq/index\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/configuration_options#local-configuration-file\n","created_at":"2026-02-10T02:32:44Z","updated_at":"2026-02-10T02:32:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785474803","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785474803"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785474803"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785474803/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":37,"original_start_line":36,"start_side":"RIGHT","line":82,"original_line":83,"side":"RIGHT","in_reply_to_id":2785440223,"author_association":"NONE","original_position":83,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785475025","pull_request_review_id":3776397795,"id":2785475025,"node_id":"PRRC_kwDOPaLyBs6mBvnR","diff_hunk":"@@ -0,0 +1,464 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"> Skipped: comment is from another GitHub bot.\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T02:32:50Z","updated_at":"2026-02-10T02:32:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785475025","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785475025"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785475025"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785475025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":37,"original_start_line":36,"start_side":"RIGHT","line":82,"original_line":83,"side":"RIGHT","in_reply_to_id":2785440223,"author_association":"CONTRIBUTOR","original_position":83,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785477374","pull_request_review_id":3776400840,"id":2785477374,"node_id":"PRRC_kwDOPaLyBs6mBwL-","diff_hunk":"@@ -0,0 +1,464 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }\n+\n+        // Apply vendor-specific extra headers.\n+        for (name, value) in &self.extra_headers {\n+            builder = builder.header(name, value);\n+        }\n+\n+        let response = builder\n+            .form(fields.as_slice())\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .send()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- check status, then parse response ------------------------------------\n+        let token_resp: super::types::TokenResponse = response\n+            .error_for_status()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .json()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- validate token_type -------------------------------------------------\n+        if let Some(ref tt) = token_resp.token_type\n+            && !tt.eq_ignore_ascii_case(\"bearer\")\n+        {\n+            return Err(TokenError::UnsupportedTokenType(tt.clone()));\n+        }\n+\n+        // -- compute lifetime ----------------------------------------------------\n+        let lifetime_secs = token_resp\n+            .expires_in\n+            .unwrap_or(self.default_ttl.as_secs())\n+            .max(self.default_ttl.as_secs());\n+\n+        let access_token = AccessToken::new(token_resp.access_token);\n+        let token = self.lifetime_config.create_token(\n+            &access_token,\n+            None::<&IdToken>,\n+            DurationSecs(lifetime_secs),\n+        );\n+\n+        Ok(token)\n+    }\n+}","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/user
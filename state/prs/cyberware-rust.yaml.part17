do Capabilities\r\n- ## Automated PR Analysis\r\n  - Reviews every pull request automatically\r\n  - No manual trigger required\r\n\r\n- ## Context-Aware Code Review\r\n  - Understands cross-file changes\r\n  - Detects architectural inconsistencies\r\n\r\n- ## Actionable Suggestions\r\n  - Concrete code fixes\r\n  - Clear explanations\r\n  - Prioritized feedback\r\n\r\n- ## Security & Reliability Checks\r\n  - Identifies risky patterns\r\n  - Reduces attack surface area","external_url":"https://www.qodo.ai/","html_url":"https://github.com/apps/qodo-code-review","created_at":"2023-11-16T16:18:38Z","updated_at":"2026-05-06T15:53:40Z","permissions":{"actions":"read","checks":"read","contents":"write","discussions":"write","issues":"write","metadata":"read","pull_requests":"write"},"events":["check_run","check_suite","discussion_comment","issue_comment","pull_request","pull_request_review_comment","push"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":571,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/571","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #571] docs: update CONTRIBUTING.md and write docs/pr-review/README.md to explain the best code review practices","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"dd9f173ee86514eb05d9f3bd99a075082785d2f6","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/571","id":3273649422,"node_id":"PR_kwDOPaLyBs7DH-0O","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/571","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/571.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/571.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/571","number":571,"state":"closed","locked":false,"title":"docs: update CON
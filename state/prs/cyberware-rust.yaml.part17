header required. Valid hosts: {[ep.host for ep in selected.endpoints]}\"\n+            )","path":"modules/system/oagw/DESIGN.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"484dbf65efad76bd5da70776fa1647ae1f526174","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"wrong place for validation logic","created_at":"2026-02-09T13:53:57Z","updated_at":"2026-02-09T13:53:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782774828","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782774828"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2782774828"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782774828/reactions","tota
GHT","author_association":"MEMBER","original_position":11,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801448282","pull_request_review_id":3793937773,"id":2801448282,"node_id":"PRRC_kwDOPaLyBs6m-rVa","diff_hunk":"@@ -0,0 +1,81 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{\n+    OpenApiRegistry, OperationBuilder,\n+    operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature},\n+};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+enum Resource {\n+    Modules,\n+}\n+\n+enum Action {\n+    Read,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Resource::Modules => \"module_orchestrator\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Action::Read => \"read\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the module orchestrator\n+#[allow(clippy::needless_pass_by_value)]\n+pub fn register_routes(","path":"modules/system/module-orchestrator/src/api/rest/routes.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I see some mixing responsibilities here. module_orchestrator exists to do one thing: service discovery (DirectoryClient + gRPC). Adding a REST \"list modules\" endpoint turns internal plumbing into an external-facing admin API. nodes-registry and types-registry have REST because that's their primary purpose; for module_orchestrator it's a bolted-on side feature.","created_at":"2026-02-12T22:58:02Z","updated_at":"2026-02-12T23:01:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801448282","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801448282"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801448282"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801448282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":12,"original_line":53,"side":"RIGHT","author_association":"MEMBER","original_position":53,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801450644","pull_request_review_id":3793937773,"id":2801450644,"node_id":"PRRC_kwDOPaLyBs6m-r6U","diff_hunk":"@@ -28,11 +36,15 @@ impl SystemContext {\n         instance_id: Uuid,\n         module_manager: Arc<ModuleManager>,\n         grpc_installers: Arc<GrpcInstallerStore>,\n+        module_catalog: Arc<ModuleRegistryCatalog>,","path":"libs/modkit/src/runtime/system_context.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It looks like a SystemContext pollution. module_catalog and external_module_names are only used by module_orchestrator, but every system module now receives them in pre_init/init. \n\nSee the forced boilerplate in grpc-hub tests — constructing empty catalog/hashset just to satisfy the new signature. Framework-level structs shouldn't grow for a single consumer.","created_at":"2026-02-12T22:58:50Z","updated_at":"2026-02-12T23:01:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801450644","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801450644"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801450644"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801450644/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":39,"side":"RIGHT","author_association":"MEMBER","original_position":28,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801454585","pull_request_review_id":3793937773,"id":2801454585,"node_id":"PRRC_kwDOPaLyBs6m-s35","diff_hunk":"@@ -663,6 +701,52 @@ impl RegistryBuilder {\n     }\n }\n \n+// ============================================================================\n+// Module Catalog (for introspection APIs)\n+// ============================================================================\n+\n+/// A descriptor of a single module entry from the registry.\n+///\n+/// This captures the static compile-time info about a module for introspection.\n+#[derive(Debug, Clone)]\n+pub struct ModuleDescriptor {","path":"libs/modkit/src/registry.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This entity (and ModuleRegistryCatalog too) are owned-copy DTOs for one endpoint, not framework primitives. \nModuleEntry already holds this data. If a catalog snapshot is needed, it should live in module_orchestrator's domain layer, not in libs/modkit/src/registry.rs.","created_at":"2026-02-12T23:00:17Z","updated_at":"2026-02-12T23:01:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801454585","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801454585"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801454585"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801454585/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":712,"side":"RIGHT","author_association":"MEMBER","original_position":64,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801458774","pull_request_review_id":3793937773,"id":2801458774,"node_id":"PRRC_kwDOPaLyBs6m-t5W","diff_hunk":"@@ -0,0 +1,81 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{\n+    OpenApiRegistry, OperationBuilder,\n+    operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature},\n+};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+enum Resource {\n+    Modules,\n+}\n+\n+enum Action {\n+    Read,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Resource::Modules => \"module_orchestrator\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Action::Read => \"read\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the module orchestrator\n+#[allow(clippy::needless_pass_by_value)]\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /modules/v1/modules/active - List all active registered modules\n+    router = OperationBuilder::get(\"/modules/v1/modules/active\")","path":"modules/system/module-orchestrator/src/api/rest/routes.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I am not sure that /modules/v1/modules/active is well-placed name for these purposes. \nreads as \"module named modules listing modules\" - confusing a bit. Either keep the module's actual name (/module-orchestrator/v1/...) or pick a distinct resource noun.","created_at":"2026-02-12T23:01:32Z","updated_at":"2026-02-12T23:01:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801458774","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801458774"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2801458774"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801458774/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":59,"side":"RIGHT","author_association":"MEMBER","original_position":59,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803692090","pull_request_review_id":3796710458,"id":2803692090,"node_id":"PRRC_kwDOPaLyBs6nHPI6","diff_hunk":"@@ -0,0 +1,81 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{\n+    OpenApiRegistry, OperationBuilder,\n+    operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature},\n+};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+enum Resource {\n+    Modules,\n+}\n+\n+enum Action {\n+    Read,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Resource::Modules => \"module_orchestrator\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Action::Read => \"read\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the module orchestrator\n+#[allow(clippy::needless_pass_by_value)]\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /modules/v1/modules/active - List all active registered modules\n+    router = OperationBuilder::get(\"/modules/v1/modules/active\")\n+        .operation_id(\"modules.list_active\")\n+        .summary(\"List all active registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .require_auth(&Resource::Modules, &Action::Read)\n+        .require_license_features::<License>([])","path":"modules/system/module-orchestrator/src/api/rest/routes.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Removed the fake `License` struct entirely. Added `no_license_required()` to `OperationBuilder` — it explicitly transitions the type-state from `LicenseNotSet` to `LicenseSet` without attaching any license requirement.\n\nWe needed this because auth-without-license had no clean path in the builder otherwise (the only alternative was `require_license_features::<DummyType>([])` which is essentially what you flagged). Is this approach acceptable, or would you prefer a different solution?","created_at":"2026-02-13T11:15:15Z","updated_at":"2026-02-13T11:15:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2803692090","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803692090"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2803692090"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803692090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":68,"side":"RIGHT","in_reply_to_id":2801281075,"author_association":"MEMBER","original_position":68,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803692854","pull_request_review_id":3796711196,"id":2803692854,"node_id":"PRRC_kwDOPaLyBs6nHPU2","diff_hunk":"@@ -155,6 +155,24 @@ impl CapabilitySet {\n         Self { caps: Vec::new() }\n     }\n \n+    /// Returns a list of human-readable capability labels.\n+    #[must_use]\n+    pub fn labels(&self) -> Vec<&'static str> {\n+        self.caps\n+            .iter()\n+            .map(|cap| match cap {\n+                #[cfg(feature = \"db\")]\n+                Capability::Database(_) => \"db\",","path":"libs/modkit/src/registry.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subsc
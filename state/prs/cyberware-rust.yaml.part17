d by adding entries for modkit-http and\nmodkit-auth to the \"Task → Document routing\" table and the \"File overview\"\nsection: list modkit-http with its responsibilities (HTTP client: TLS, retries,\ntimeouts, concurrency limiting, decompression, OTel tracing, extensible auth\nhook) and link to adrs/modkit/0001-modkit-hyper-tower-http-client.md, and list\nmodkit-auth with its responsibilities (inbound JWT/OIDC route policies and\noutbound OAuth2 client credentials with automatic token refresh/Authorization:\nBearer injection) and link to adrs/modkit/0002-modkit-auth-client-with-aliri.md\nso the unified system guide points to where these components are documented.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Addressed in commit a15960c","created_at":"2026-02-10T00:18:50Z","updated_at":"2026-02-10T02:11:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785168253","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785168253"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785168253"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785168253/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":322,"start_side":"RIGHT","line":null,"original_line":323,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785168256","pull_request_review_id":3776090243,"id":2785168256,"node_id":"PRRC_kwDOPaLyBs6mAkuA","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::fmt;\n+use std::time::Duration;\n+use url::Url;\n+\n+use super::error::TokenError;\n+use super::types::{ClientAuthMethod, SecretString};\n+\n+/// Configuration for an outbound `OAuth2` client credentials flow.\n+///\n+/// Exactly one of [`token_endpoint`](Self::token_endpoint) or\n+/// [`issuer_url`](Self::issuer_url) must be set.  Call\n+/// [`validate`](Self::validate) to enforce this constraint.\n+///\n+/// `Debug` is manually implemented to redact [`client_secret`](Self::client_secret).\n+pub struct OAuthClientConfig {\n+    // ---- endpoint resolution ------------------------------------------------\n+    /// Direct token endpoint URL (mutually exclusive with `issuer_url`).\n+    pub token_endpoint: Option<Url>,\n+\n+    /// OIDC issuer URL for discovery (mutually exclusive with `token_endpoint`).\n+    /// The actual token endpoint is resolved via\n+    /// `{issuer_url}/.well-known/openid-configuration`.\n+    pub issuer_url: Option<Url>,\n+\n+    // ---- credentials --------------------------------------------------------\n+    /// `OAuth2` client identifier.\n+    pub client_id: String,\n+\n+    /// `OAuth2` client secret (redacted in `Debug` output).\n+    pub client_secret: SecretString,\n+\n+    /// Requested scopes (normalized once, stable order).\n+    pub scopes: Vec<String>,\n+\n+    /// How client credentials are transmitted to the token endpoint.\n+    pub auth_method: ClientAuthMethod,\n+\n+    /// Extra headers attached to every token request (vendor quirks).\n+    pub extra_headers: Vec<(String, String)>,\n+\n+    // ---- refresh policy -----------------------------------------------------\n+    /// How far before expiry the token should be refreshed (default: 30 min).\n+    pub refresh_offset: Duration,\n+\n+    /// Maximum random jitter added to the refresh offset (default: 5 min).\n+    pub jitter_max: Duration,\n+\n+    /// Minimum period between consecutive refresh attempts (default: 10 s).\n+    pub min_refresh_period: Duration,\n+\n+    /// Fallback TTL when the token endpoint omits `expires_in` (default: 5 min).\n+    pub default_ttl: Duration,\n+\n+    // ---- HTTP client --------------------------------------------------------\n+    /// Override for the internal HTTP client configuration.\n+    /// When `None`, [`HttpClientConfig::token_endpoint()`](modkit_http::HttpClientConfig::token_endpoint)\n+    /// is used.\n+    pub http_config: Option<modkit_http::HttpClientConfig>,\n+}\n+\n+impl OAuthClientConfig {\n+    /// Validate that the configuration is self-consistent.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if:\n+    /// - both `token_endpoint` and `issuer_url` are set, or\n+    /// - neither is set.\n+    pub fn validate(&self) -> Result<(), TokenError> {\n+        match (&self.token_endpoint, &self.issuer_url) {\n+            (Some(_), Some(_)) => Err(TokenError::ConfigError(\n+                \"token_endpoint and issuer_url are mutually exclusive\".into(),\n+            )),\n+            (None, None) => Err(TokenError::ConfigError(\n+                \"one of token_endpoint or issuer_url must be set\".into(),\n+            )),\n+            _ => Ok(()),\n+        }\n+    }\n+}\n+\n+impl Clone for OAuthClientConfig {\n+    fn clone(&self) -> Self {\n+        Self {\n+            token_endpoint: self.token_endpoint.clone(),\n+            issuer_url: self.issuer_url.clone(),\n+            client_id: self.client_id.clone(),\n+            client_secret: self.client_secret.clone(),\n+            scopes: self.scopes.clone(),\n+            auth_method: self.auth_method,\n+            extra_headers: self.extra_headers.clone(),\n+            refresh_offset: self.refresh_offset,\n+            jitter_max: self.jitter_max,\n+            min_refresh_period: self.min_refresh_period,\n+            default_ttl: self.default_ttl,\n+            http_config: self.http_config.clone(),\n+        }\n+    }\n+}\n+\n+/// `Debug` redacts `client_secret` to prevent accidental exposure in logs.\n+impl fmt::Debug for OAuthClientConfig {\n+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n+        f.debug_struct(\"OAuthClientConfig\")\n+            .field(\"token_endpoint\", &self.token_endpoint)\n+            .field(\"issuer_url\", &self.issuer_url)\n+            .field(\"client_id\", &self.client_id)\n+            .field(\"client_secret\", &\"[REDACTED]\")\n+            .field(\"scopes\", &self.scopes)\n+            .field(\"auth_method\", &self.auth_method)\n+            .field(\"extra_headers\", &self.extra_headers)\n+            .field(\"refresh_offset\", &self.refresh_offset)\n+            .field(\"jitter_max\", &self.jitter_max)\n+            .field(\"min_refresh_period\", &self.min_refresh_period)\n+            .field(\"default_ttl\", &self.default_ttl)\n+            .field(\"http_config\", &self.http_config)\n+            .finish()","path":"libs/modkit-auth/src/oauth2/config.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Redact `extra_headers` values in `Debug`.**\n\n`extra_headers` can carry API keys or vendor secrets; the current `Debug` prints full values. Consider redacting values (or only showing header names) to avoid accidental leakage in logs.  \n\n\n<details>\n<summary>🔒 Suggested redaction tweak</summary>\n\n```diff\n impl fmt::Debug for OAuthClientConfig {\n     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n+        let redacted_headers: Vec<_> = self\n+            .extra_headers\n+            .iter()\n+            .map(|(k, _)| (k, \"[REDACTED]\"))\n+            .collect();\n         f.debug_struct(\"OAuthClientConfig\")\n             .field(\"token_endpoint\", &self.token_endpoint)\n             .field(\"issuer_url\", &self.issuer_url)\n             .field(\"client_id\", &self.client_id)\n             .field(\"client_secret\", &\"[REDACTED]\")\n             .field(\"scopes\", &self.scopes)\n             .field(\"auth_method\", &self.auth_method)\n-            .field(\"extra_headers\", &self.extra_headers)\n+            .field(\"extra_headers\", &redacted_headers)\n             .field(\"refresh_offset\", &self.refresh_offset)\n             .field(\"jitter_max\", &self.jitter_max)\n             .field(\"min_refresh_period\", &self.min_refresh_period)\n             .field(\"default_ttl\", &self.default_ttl)\n             .field(\"http_config\", &self.http_config)\n             .finish()\n     }\n }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n/// `Debug` redacts `client_secret` to prevent accidental exposure in logs.\nimpl fmt::Debug for OAuthClientConfig {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        let redacted_headers: Vec<_> = self\n            .extra_headers\n            .iter()\n            .map(|(k, _)| (k, \"[REDACTED]\"))\n            .collect();\n        f.debug_struct(\"OAuthClientConfig\")\n            .field(\"token_endpoint\", &self.token_endpoint)\n            .field(\"issuer_url\", &self.issuer_url)\n            .field(\"client_id\", &self.client_id)\n            .field(\"client_secret\", &\"[REDACTED]\")\n            .field(\"scopes\", &self.scopes)\n            .field(\"auth_method\", &self.auth_method)\n            .field(\"extra_headers\", &redacted_headers)\n            .field(\"refresh_offset\", &self.refresh_offset)\n            .field(\"jitter_max\", &self.jitter_max)\n            .field(\"min_refresh_period\", &self.min_refresh_period)\n            .field(\"default_ttl\", &self.default_ttl)\n            .field(\"http_config\", &self.http_config)\n            .finish()\n    }\n}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/src/oauth2/config.rs` around lines 101 - 117, The Debug impl\nfor OAuthClientConfig currently prints full extra_headers values; change the\nfmt::Debug implementation (impl fmt::Debug for OAuthClientConfig) to redact\nheader values by transforming self.extra_headers into a display-friendly\nstructure that only shows header names or maps each value to \"[REDACTED]\" before\ncalling f.debug_struct().field(\"extra_headers\", ...). Ensure the rest of the\nfields remain unchanged and the redaction handles whichever type extra_headers\nis (e.g., HashMap or HeaderMap) by iterating its keys and replacing values with\na constant redaction string.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Addressed in commit a15960c","created_at":"2026-02-10T00:18:50Z","updated_at":"2026-02-10T02:11:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785168256","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785168256"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785168256"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785168256/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":112,"original_start_line":101,"start_side":"RIGHT","line":133,"original_line":117,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":117,"position":133,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421534","pull_request_review_id":3776339615,"id":2785421534,"node_id":"PRRC_kwDOPaLyBs6mBije","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::fmt;\n+use std::time::Duration;\n+use url::Url;\n+\n+use super::error::TokenError;\n+use super::types::{ClientAuthMethod, SecretString};\n+\n+/// Configuration for an outbound `OAuth2` client credentials flow.\n+///\n+/// Exactly one of [`token_endpoint`](Self::token_endpoint) or\n+/// [`issuer_url`](Self::issuer_url) must be set.  Call\n+/// [`validate`](Self::validate) to enforce this constraint.\n+///\n+/// `Debug` is manually implemented to redact [`client_secret`](Self::client_secret).\n+pub struct OAuthClientConfig {\n+    // ---- endpoint resolution ------------------------------------------------\n+    /// Direct token endpoint URL (mutually exclusive with `issuer_url`).\n+    pub token_endpoint: Option<Url>,\n+\n+    /// OIDC issuer URL for discovery (mutually exclusive with `token_endpoint`).\n+    /// The actual token endpoint is resolved via\n+    /// `{issuer_url}/.well-known/openid-configuration`.\n+    pub issuer_url: Option<Url>,\n+\n+    // ---- credentials --------------------------------------------------------\n+    /// `OAuth2` client identifier.\n+    pub client_id: String,\n+\n+    /// `OAuth2` client secret (redacted in `Debug` output).\n+    pub client_secret: SecretString,\n+\n+    /// Requested scopes (normalized once, stable order).\n+    pub scopes: Vec<String>,\n+\n+    /// How client credentials are transmitted to the token endpoint.\n+    pub auth_method: ClientAuthMethod,\n+\n+    /// Extra headers attached to every token request (vendor quirks).\n+    pub extra_headers: Vec<(String, String)>,\n+\n+    // ---- refresh policy -----------------------------------------------------\n+    /// How far before expiry the token should be refreshed (default: 30 min).\n+    pub refresh_offset: Duration,\n+\n+    /// Maximum random jitter added to the refresh offset (default: 5 min).\n+    pub jitter_max: Duration,\n+\n+    /// Minimum period between consecutive refresh attempts (default: 10 s).\n+    pub min_refresh_period: Duration,\n+\n+    /// Fallback TTL when the token endpoint omits `expires_in` (default: 5 min).\n+    pub default_ttl: Duration,\n+\n+    // ---- HTTP client --------------------------------------------------------\n+    /// Override for the internal HTTP client configuration.\n+    /// When `None`, [`HttpClientConfig::token_endpoint()`](modkit_http::HttpClientConfig::token_endpoint)\n+    /// is used.\n+    pub http_config: Option<modkit_http::HttpClientConfig>,\n+}\n+\n+impl OAuthClientConfig {\n+    /// Validate that the configuration is self-consistent.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if:\n+    /// - both `token_endpoint` and `issuer_url` are set, or\n+    /// - neither is set.\n+    pub fn validate(&self) -> Result<(), TokenError> {\n+        match (&self.token_endpoint, &self.issuer_url) {\n+            (Some(_), Some(_)) => Err(TokenError::ConfigError(\n+                \"token_endpoint and issuer_url are mutually exclusive\".into(),\n+            )),\n+            (None, None) => Err(TokenError::ConfigError(\n+                \"one of token_endpoint or issuer_url must be set\".into(),\n+            )),\n+            _ => Ok(()),\n+        }\n+    }","path":"libs/modkit-auth/src/oauth2/config.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed: added `client_id` and `client_secret` non-empty checks in `validate()`, with tests for empty and whitespace-only values.","created_at":"2026-02-10T02:11:07Z","updated_at":"2026-02-10T02:11:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421534","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421534"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421534"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421534/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":70,"original_start_line":69,"start_side":"RIGHT","line":90,"original_line":79,"side":"RIGHT","in_reply_to_id":2785164731,"author_association":"MEMBER","original_position":79,"position":90,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421597","pull_request_review_id":3776339687,"id":2785421597,"node_id":"PRRC_kwDOPaLyBs6mBikd","diff_hunk":"@@ -0,0 +1,441 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            builder = builder.header(AUTHORIZATION.as_str(), &format!(\"Basic {}\", &*encoded));\n+        }\n+\n+        // Apply vendor-specific extra headers.\n+        for (name, value) in &self.extra_headers {\n+            builder = builder.header(name, value);\n+        }\n+\n+        let response = builder\n+            .form(fields.as_slice())\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .send()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- check status, then parse response ------------------------------------\n+        let token_resp: super::types::TokenResponse = response\n+            .error_for_status()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .json()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- validate token_type -------------------------------------------------\n+        if let Some(ref tt) = token_resp.token_type\n+            && !tt.eq_ignore_ascii_case(\"bearer\")\n+        {\n+            return Err(TokenError::UnsupportedTokenType(tt.clone()));\n+        }\n+\n+        // -- compute lifetime ----------------------------------------------------\n+        let lifetime_secs = token_resp.expires_in.unwrap_or(self.default_ttl.as_secs());\n+\n+        let access_token = AccessToken::new(token_resp.access_token);\n+        let token = self.lifetime_config.create_token(\n+            &access_token,\n+            None::<&IdToken>,\n+            DurationSecs(lifetime_secs),\n+        );\n+","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed: `expires_in` is now clamped to at least `default_ttl` via `.max()`, preventing zero-lifetime refresh loops. Test added.","created_at":"2026-02-10T02:11:09Z","updated_at":"2026-02-10T02:11:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421597","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421597"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421597"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421597/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":156,"original_start_line":156,"start_side":"RIGHT","line":174,"original_line":165,"side":"RIGHT","in_reply_to_id":2785164732,"author_association":"MEMBER","original_position":165,"position":174,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421675","pull_request_review_id":3776339772,"id":2785421675,"node_id":"PRRC_kwDOPaLyBs6mBilr","diff_hunk":"@@ -0,0 +1,273 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+// ── Layer ────────────────────────────────────────────────────────────────────\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+// ── Service ──────────────────────────────────────────────────────────────────\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());\n+                match HeaderValue::from_str(&raw) {\n+                    Ok(v) => v,\n+                    Err(e) => return Box::pin(async { Err(HttpError::InvalidHeaderValue(e)) }),\n+                }\n+            }\n+            Err(e) => {\n+                return Box::pin(async { Err(HttpError::Transport(Box::new(e))) });\n+            }\n+        };\n+\n+        req.headers_mut()\n+            .insert(self.header_name.clone(), bearer_value);\n+\n+        // Clone-swap pattern (Tower Service contract).\n+        let clone = self.inner.clone();\n+        let mut inner = std::mem::replace(&mut self.inner, clone);\n+\n+        Box::pin(inner.call(req))\n+    }","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed: changed to `Box::pin(async move { inner.call(req).await })` to match the `OtelService`/`AuthPolicyService` pattern and avoid implicit `'static` constraint on `S::Future`.","created_at":"2026-02-10T02:11:11Z","updated_at":"2026-02-10T02:11:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421675","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421675"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421675"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421675/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":75,"original_start_line":79,"start_side":"RIGHT","line":104,"original_line":107,"side":"RIGHT","in_reply_to_id":2785164735,"author_association":"MEMBER","original_position":107,"position":104,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421745","pull_request_review_id":3776339847,"id":2785421745,"node_id":"PRRC_kwDOPaLyBs6mBimx","diff_hunk":"@@ -319,7 +319,8 @@ Every HyperSpot module uses the **ModKit** framework, which provides:\n  **Key ModKit libraries:**\n  - `modkit` - Core module framework: lifecycle, REST host/contracts, OpenAPI registry, ClientHub, tracing helpers\n  - `modkit-macros` - Procedural macros for module registration (`#[modkit::module(...)]`)\n- - `modkit-auth` - Authn/z plumbing for gateway and route policies\n+ - `modkit-http` - First-party HTTP client (`hyper + tower`): TLS, retries, timeouts, concurrency limiting, decompression, OTel tracing, and extensible auth layer hook ([ADR](adrs/modkit/0001-modkit-hyper-tower-http-client.md))\n+ - `modkit-auth` - Authentication and authorization: inbound JWT/OIDC validation with route policies, outbound OAuth2 client credentials with automatic token refresh and `Authorization: Bearer` injection ([ADR](adrs/modkit/0002-modkit-auth-client-with-aliri.md))","path":"docs/ARCHITECTURE_MANIFEST.md","commit_id":"1d092060dcd4a934580f7a862264dc3d778409fd","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed: added modkit-http and modkit-auth entries to the task routing table and file overview in `docs/modkit_unified_system/README.md`, with ADR links.","created_at":"2026-02-10T02:11:13Z","updated_at":"2026-02-10T02:11:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421745","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421745"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421745"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421745/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":322,"start_side":"RIGHT","line":null,"original_line":323,"side":"RIGHT","in_reply_to_id":2785168253,"author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421801","pull_request_review_id":3776339906,"id":2785421801,"node_id":"PRRC_kwDOPaLyBs6mBinp","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::fmt;\n+use std::time::Duration;\n+use url::Url;\n+\n+use super::error::TokenError;\n+use super::types::{ClientAuthMethod, SecretString};\n+\n+/// Configuration for an outbound `OAuth2` client credentials flow.\n+///\n+/// Exactly one of [`token_endpoint`](Self::token_endpoint) or\n+/// [`issuer_url`](Self::issuer_url) must be set.  Call\n+/// [`validate`](Self::validate) to enforce this constraint.\n+///\n+/// `Debug` is manually implemented to redact [`client_secret`](Self::client_secret).\n+pub struct OAuthClientConfig {\n+    // ---- endpoint resolution ------------------------------------------------\n+    /// Direct token endpoint URL (mutually exclusive with `issuer_url`).\n+    pub token_endpoint: Option<Url>,\n+\n+    /// OIDC issuer URL for discovery (mutually exclusive with `token_endpoint`).\n+    /// The actual token endpoint is resolved via\n+    /// `{issuer_url}/.well-known/openid-configuration`.\n+    pub issuer_url: Option<Url>,\n+\n+    // ---- credentials --------------------------------------------------------\n+    /// `OAuth2` client identifier.\n+    pub client_id: String,\n+\n+    /// `OAuth2` client secret (redacted in `Debug` output).\n+    pub client_secret: SecretString,\n+\n+    /// Requested scopes (normalized once, stable order).\n+    pub scopes: Vec<String>,\n+\n+    /// How client credentials are transmitted to the token endpoint.\n+    pub auth_method: ClientAuthMethod,\n+\n+    /// Extra headers attached to every token request (vendor quirks).\n+    pub extra_headers: Vec<(String, String)>,\n+\n+    // ---- refresh policy -----------------------------------------------------\n+    /// How far before expiry the token should be refreshed (default: 30 min).\n+    pub refresh_offset: Duration,\n+\n+    /// Maximum random jitter added to the refresh offset (default: 5 min).\n+    pub jitter_max: Duration,\n+\n+    /// Minimum period between consecutive refresh attempts (default: 10 s).\n+    pub min_refresh_period: Duration,\n+\n+    /// Fallback TTL when the token endpoint omits `expires_in` (default: 5 min).\n+    pub default_ttl: Duration,\n+\n+    // ---- HTTP client --------------------------------------------------------\n+    /// Override for the internal HTTP client configuration.\n+    /// When `None`, [`HttpClientConfig::token_endpoint()`](modkit_http::HttpClientConfig::token_endpoint)\n+    /// is used.\n+    pub http_config: Option<modkit_http::HttpClientConfig>,\n+}\n+\n+impl OAuthClientConfig {\n+    /// Validate that the configuration is self-consistent.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if:\n+    /// - both `token_endpoint` and `issuer_url` are set, or\n+    /// - neither is set.\n+    pub fn validate(&self) -> Result<(), TokenError> {\n+        match (&self.token_endpoint, &self.issuer_url) {\n+            (Some(_), Some(_)) => Err(TokenError::ConfigError(\n+                \"token_endpoint and issuer_url are mutually exclusive\".into(),\n+            )),\n+            (None, None) => Err(TokenError::ConfigError(\n+                \"one of token_endpoint or issuer_url must be set\".into(),\n+            )),\n+            _ => Ok(()),\n+        }\n+    }\n+}\n+\n+impl Clone for OAuthClientConfig {\n+    fn clone(&self) -> Self {\n+        Self {\n+            token_endpoint: self.token_endpoint.clone(),\n+            issuer_url: self.issuer_url.clone(),\n+            client_id: self.client_id.clone(),\n+            client_secret: self.client_secret.clone(),\n+            scopes: self.scopes.clone(),\n+            auth_method: self.auth_method,\n+            extra_headers: self.extra_headers.clone(),\n+            refresh_offset: self.refresh_offset,\n+            jitter_max: self.jitter_max,\n+            min_refresh_period: self.min_refresh_period,\n+            default_ttl: self.default_ttl,\n+            http_config: self.http_config.clone(),\n+        }\n+    }\n+}\n+\n+/// `Debug` redacts `client_secret` to prevent accidental exposure in logs.\n+impl fmt::Debug for OAuthClientConfig {\n+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n+        f.debug_struct(\"OAuthClientConfig\")\n+            .field(\"token_endpoint\", &self.token_endpoint)\n+            .field(\"issuer_url\", &self.issuer_url)\n+            .field(\"client_id\", &self.client_id)\n+            .field(\"client_secret\", &\"[REDACTED]\")\n+            .field(\"scopes\", &self.scopes)\n+            .field(\"auth_method\", &self.auth_method)\n+            .field(\"extra_headers\", &self.extra_headers)\n+            .field(\"refresh_offset\", &self.refresh_offset)\n+            .field(\"jitter_max\", &self.jitter_max)\n+            .field(\"min_refresh_period\", &self.min_refresh_period)\n+            .field(\"default_ttl\", &self.default_ttl)\n+            .field(\"http_config\", &self.http_config)\n+            .finish()","path":"libs/modkit-auth/src/oauth2/config.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed: `extra_headers` values are now redacted in the `Debug` impl (only header names shown). Test added.","created_at":"2026-02-10T02:11:15Z","updated_at":"2026-02-10T02:11:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421801","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421801"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785421801"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785421801/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":112,"original_start_line":101,"start_side":"RIGHT","line":133,"original_line":117,"side":"RIGHT","in_reply_to_id":2785168256,"author_association":"MEMBER","original_position":117,"position":133,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785422714","pull_request_review_id":3776340785,"id":2785422714,"node_id":"PRRC_kwDOPaLyBs6mBi16","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::fmt;\n+use std::time::Duration;\n+use url::Url;\n+\n+use super::error::TokenError;\n+use super::types::{ClientAuthMethod, SecretString};\n+\n+/// Configuration for an outbound `OAuth2` client credentials flow.\n+///\n+/// Exactly one of [`token_endpoint`](Self::token_endpoint) or\n+/// [`issuer_url`](Self::issuer_url) must be set.  Call\n+/// [`validate`](Self::validate) to enforce this constraint.\n+///\n+/// `Debug` is manually implemented to redact [`client_secret`](Self::client_secret).\n+pub struct OAuthClientConfig {\n+    // ---- endpoint resolution ------------------------------------------------\n+    /// Direct token endpoint URL (mutually exclusive with `issuer_url`).\n+    pub token_endpoint: Option<Url>,\n+\n+    /// OIDC issuer URL for discovery (mutually exclusive with `token_endpoint`).\n+    /// The actual token endpoint is resolved via\n+    /// `{issuer_url}/.well-known/openid-configuration`.\n+    pub issuer_url: Option<Url>,\n+\n+    // ---- credentials --------------------------------------------------------\n+    /// `OAuth2` client identifier.\n+    pub client_id: String,\n+\n+    /// `OAuth2` client secret (redacted in `Debug` output).\n+    pub client_secret: SecretString,\n+\n+    /// Requested scopes (normalized once, stable order).\n+    pub scopes: Vec<String>,\n+\n+    /// How client credentials are transmitted to the token endpoint.\n+    pub auth_method: ClientAuthMethod,\n+\n+    /// Extra headers attached to every token request (vendor quirks).\n+    pub extra_headers: Vec<(String, String)>,\n+\n+    // ---- refresh policy -----------------------------------------------------\n+    /// How far before expiry the token should be refreshed (default: 30 min).\n+    pub refresh_offset: Duration,\n+\n+    /// Maximum random jitter added to the refresh offset (default: 5 min).\n+    pub jitter_max: Duration,\n+\n+    /// Minimum period between consecutive refresh attempts (default: 10 s).\n+    pub min_refresh_period: Duration,\n+\n+    /// Fallback TTL when the token endpoint omits `expires_in` (default: 5 min).\n+    pub default_ttl: Duration,\n+\n+    // ---- HTTP client --------------------------------------------------------\n+    /// Override for the internal HTTP client configuration.\n+    /// When `None`, [`HttpClientConfig::token_endpoint()`](modkit_http::HttpClientConfig::token_endpoint)\n+    /// is used.\n+    pub http_config: Option<modkit_http::HttpClientConfig>,\n+}\n+\n+impl OAuthClientConfig {\n+    /// Validate that the configuration is self-consistent.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if:\n+    /// - both `token_endpoint` and `issuer_url` are set, or\n+    /// - neither is set.\n+    pub fn validate(&self) -> Result<(), TokenError> {\n+        match (&self.token_endpoint, &self.issuer_url) {\n+            (Some(_), Some(_)) => Err(TokenError::ConfigError(\n+                \"token_endpoint and issuer_url are mutually exclusive\".into(),\n+            )),\n+            (None, None) => Err(TokenError::ConfigError(\n+                \"one of token_endpoint or issuer_url must be set\".into(),\n+            )),\n+            _ => Ok(()),\n+        }\n+    }\n+}\n+\n+impl Clone for OAuthClientConfig {\n+    fn clone(&self) -> Self {\n+        Self {\n+            token_endpoint: self.token_endpoint.clone(),\n+            issuer_url: self.issuer_url.clone(),\n+            client_id: self.client_id.clone(),\n+            client_secret: self.client_secret.clone(),\n+            scopes: self.scopes.clone(),\n+            auth_method: self.auth_method,\n+            extra_headers: self.extra_headers.clone(),\n+            refresh_offset: self.refresh_offset,\n+            jitter_max: self.jitter_max,\n+            min_refresh_period: self.min_refresh_period,\n+            default_ttl: self.default_ttl,\n+            http_config: self.http_config.clone(),\n+        }\n+    }\n+}\n+\n+/// `Debug` redacts `client_secret` to prevent accidental exposure in logs.\n+impl fmt::Debug for OAuthClientConfig {\n+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n+        f.debug_struct(\"OAuthClientConfig\")\n+            .field(\"token_endpoint\", &self.token_endpoint)\n+            .field(\"issuer_url\", &self.issuer_url)\n+            .field(\"client_id\", &self.client_id)\n+            .field(\"client_secret\", &\"[REDACTED]\")\n+            .field(\"scopes\", &self.scopes)\n+            .field(\"auth_method\", &self.auth_method)\n+            .field(\"extra_headers\", &self.extra_headers)\n+            .field(\"refresh_offset\", &self.refresh_offset)\n+            .field(\"jitter_max\", &self.jitter_max)\n+            .field(\"min_refresh_period\", &self.min_refresh_period)\n+            .field(\"default_ttl\", &self.default_ttl)\n+            .field(\"http_config\", &self.http_config)\n+            .finish()","path":"libs/modkit-auth/src/oauth2/config.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"230e97719711844b492ea9e46842dcd2d2ba4119","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5
iew_id":3796097882,"id":2803208430,"node_id":"PRRC_kwDOPaLyBs6nFZDu","diff_hunk":"@@ -14,12 +14,20 @@ pub type MimeValidationMap = Arc<DashMap<(Method, String), Vec<&'static str>>>;\n \n /// Build MIME validation map from operation specs\n #[must_use]\n-pub fn build_mime_validation_map(specs: &[OperationSpec]) -> MimeValidationMap {\n+pub fn build_mime_validation_map(specs: &[OperationSpec], prefix_path: &str) -> MimeValidationMap {\n     let map = DashMap::new();\n \n     for spec in specs {\n         if let Some(ref allowed) = spec.allowed_request_content_types {\n-            let key = (spec.method.clone(), spec.path.clone());\n+            let prefix_path = prefix_path.trim_end_matches('/');\n+\n+            let path = if prefix_path.is_empty() {\n+                spec.path.clone()\n+            } else {\n+                format!(\"{}{}\", prefix_path, spec.path)\n+            };","path":"modules/system/api-gateway/src/middleware/mime_validation.rs","commit_id":"7b3640886b8cf1a308f3a3a0aad9d9e6acca7165","original_commit_id":"7b3640886b8cf1a308f3a3a0aad9d9e6acca7165","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Inconsistent prefix normalization compared to license_validation.rs.**\n\n`mime_validation.rs` only trims trailing slashes but doesn't ensure a leading slash. If `prefix_path` is `\"chat\"` (without leading slash), this produces keys like `\"chat/path\"` while `license_validation.rs` would produce `\"/chat/path\"`. Since both middlewares use `MatchedPath` for lookups (which always has a leading slash), MIME validation will fail to match and be bypassed.\n\nApply the same normalization logic used in `license_validation.rs`:\n\n\n<details>\n<summary>🐛 Proposed fix</summary>\n\n```diff\n pub fn build_mime_validation_map(specs: &[OperationSpec], prefix_path: &str) -> MimeValidationMap {\n     let map = DashMap::new();\n\n     for spec in specs {\n         if let Some(ref allowed) = spec.allowed_request_content_types {\n-            let prefix_path = prefix_path.trim_end_matches('/');\n-\n-            let path = if prefix_path.is_empty() {\n+            let raw_prefix = prefix_path.trim_end_matches('/');\n+            let prefix = if raw_prefix.is_empty() {\n+                String::new()\n+            } else if raw_prefix.starts_with('/') {\n+                raw_prefix.to_owned()\n+            } else {\n+                format!(\"/{raw_prefix}\")\n+            };\n+\n+            let path = if prefix.is_empty() {\n                 spec.path.clone()\n             } else {\n-                format!(\"{}{}\", prefix_path, spec.path)\n+                format!(\"{}{}\", prefix, spec.path)\n             };\n\n             let key = (spec.method.clone(), path.clone());\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n            let raw_prefix = prefix_path.trim_end_matches('/');\n            let prefix = if raw_prefix.is_empty() {\n                String::new()\n            } else if raw_prefix.starts_with('/') {\n                raw_prefix.to_owned()\n            } else {\n                format!(\"/{raw_prefix}\")\n            };\n\n            let path = if prefix.is_empty() {\n                spec.path.clone()\n            } else {\n                format!(\"{}{}\", prefix, spec.path)\n            };\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/mime_validation.rs` around lines 22\n- 28, The prefix normalization in mime_validation.rs is incomplete: update the\nlogic that builds `path` (using `prefix_path` and `spec.path`) to mirror\nlicense_validation.rs by trimming trailing slashes from `prefix_path`, ensuring\na single leading slash is present (so keys become \"/chat/path\" not \"chat/path\"),\nand leaving empty prefix as before; modify the code around the `prefix_path`\nvariable and the block that computes `path` so it normalizes leading slash\nconsistently with `MatchedPath` lookups and `license_validation.rs`.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Addressed in commit 7cba14e","created_at":"2026-02-13T09:31:41Z","updated_at":"2026-02-13T09:35:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/602#discussion_r2803208430","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/602","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803208430"},"html":{"href":"https://github.com/cyberfabric/cyberware
tring>,\n+    /// Module dependencies (other module names)\n+    pub dependencies: Vec<String>,\n+    /// Whether the module is compiled-in or out-of-process\n+    pub deployment_mode: DeploymentModeDto,\n+    /// Running instances of this module\n+    pub instances: Vec<ModuleInstanceDto>,\n+}\n+\n+/// Response DTO for a running module instance\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleInstanceDto {\n+    /// Unique instance ID\n+    pub instance_id: Uuid,\n+    /// Module version (if reported during registration)\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+    /// Current instance state (e.g., \"registered\", \"healthy\", \"quarantined\")\n+    pub state: String,\n+    /// gRPC services provided by this instance (service name -> endpoint URI)\n+    pub grpc_services: HashMap<String, String>,\n+}\n+\n+impl From<&ModuleInfo> for ModuleDto {\n+    fn from(info: &ModuleInfo) -> Self {","path":"modules/system/module_orchestrator/src/api/rest/dto.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"16dd46807de8f750af32427b683483659e334770","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/
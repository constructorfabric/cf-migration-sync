alse},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-05-05T14:51:38Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787734097","pull_request_review_id":3778714147,"id":2787734097,"node_id":"PRRC_kwDOPaLyBs6mKXJR","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::collections::HashSet;\n+use std::sync::Arc;\n+\n+use modkit::registry::ModuleRegistrySnapshot;\n+use modkit::runtime::{InstanceState, ModuleManager};\n+\n+use super::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Service that assembles module information from registry snapshot and runtime data.\n+pub struct ModulesService {\n+    registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+    module_manager: Arc<ModuleManager>,\n+    oop_module_names: Arc<HashSet<String>>,\n+}\n+\n+impl ModulesService {\n+    pub fn new(\n+        registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+        module_manager: Arc<ModuleManager>,\n+        oop_module_names: Arc<HashSet<String>>,\n+    ) -> Self {\n+        Self {\n+            registry_snapshot,\n+            module_manager,\n+            oop_module_names,\n+        }\n+    }\n+\n+    /// List all registered modules, merging compile-time registry data with runtime instances.\n+    pub fn list_modules(&self) -> Vec<ModuleInfo> {\n+        let mut result = Vec::new();\n+        let mut seen_names = HashSet::new();\n+\n+        // 1. Emit all compiled-in modules from the registry snapshot.\n+        //    If a module is also in oop_module_names, it means the config overrides\n+        //    it to run out-of-process.\n+        for snapshot in &self.registry_snapshot.modules {\n+            seen_names.insert(snapshot.name.clone());\n+\n+            let deployment_mode = if self.oop_module_names.contains(&snapshot.name) {\n+                DeploymentMode::OutOfProcess\n+            } else {\n+                DeploymentMode::CompiledIn\n+            };\n+\n+            let instances = self.instances_for_module(&snapshot.name);\n+\n+            result.push(ModuleInfo {\n+                name: snapshot.name.clone(),\n+                capabilities: snapshot.capability_labels.clone(),\n+                dependencies: snapshot.deps.clone(),\n+                deployment_mode,\n+                instances,\n+            });\n+        }\n+\n+        // 2. Add OoP modules from config that haven't been seen yet\n+        //    (they may or may not have registered instances)\n+        for oop_name in self.oop_module_names.iter() {\n+            if seen_names.contains(oop_name) {\n+                continue;\n+            }\n+            seen_names.insert(oop_name.clone());\n+\n+            let instances = self.instances_for_module(oop_name);\n+\n+            result.push(ModuleInfo {\n+                name: oop_name.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // 3. Add any dynamically registered modules from ModuleManager\n+        //    that are not in the registry or OoP config\n+        for instance in self.module_manager.all_instances() {\n+            if seen_names.contains(&instance.module) {\n+                continue;\n+            }\n+            seen_names.insert(instance.module.clone());\n+\n+            let instances = self.instances_for_module(&instance.module);\n+\n+            result.push(ModuleInfo {\n+                name: instance.module.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // Sort by name for deterministic output\n+        result.sort_by(|a, b| a.name.cmp(&b.name));\n+\n+        result\n+    }","path":"modules/system/module_orchestrator/src/domain/service.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Module/plugin versions & plugins are still missing from the response.**\n\n`list_modules` only surfaces instance versions; compiled‑in modules without instances expose no module version, and there’s no path to include plugin metadata. This doesn’t meet issue `#500`’s requirement to include module + plugin versions and plugins. Consider extending `ModuleRegistrySnapshot` / `ModuleInfo` to carry module version + plugin data and populate them here.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/module_orchestrator/src/domain/service.rs` around lines 29 -\n99, list_modules currently only fills instance-level versions and leaves\ncompiled-in modules and OoP/dynamic modules without module/version and plugin\nmetadata; update ModuleInfo (and ModuleRegistrySnapshot if needed) to include\nmodule_version and plugins, then populate those fields inside list_modules: when\niterating registry_snapshot.modules use snapshot.version and snapshot.plugins\n(or snapshot.metadata) to set ModuleInfo.module_version and ModuleInfo.plugins;\nfor OoP entries in self.oop_module_names and dynamic entries from\nself.module_manager.all_instances(), resolve module metadata by looking up the\nname in registry_snapshot (or calling a new ModuleManager/Registry method like\nget_module_metadata) and set module_version/plugins accordingly, defaulting to\nempty values when unknown so all ModuleInfo entries include module + plugin\nversion data.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T12:41:55Z","updated_at":"2026-02-10T12:46:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787734097","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787734097"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787734097"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787734097/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":29,"start_side":"RIGHT","line":null,"original_line":99,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":99,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739760","pull_request_review_id":3778720371,"id":2787739760,"node_id":"PRRC_kwDOPaLyBs6mKYhw","diff_hunk":"@@ -0,0 +1,38 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{Missing, OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+/// Register all REST routes for the module orchestrator\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /module-orchestrator/v1/modules - List all registered modules\n+    router = OperationBuilder::<Missing, Missing, ()>::get(\"/module-orchestrator/v1/modules\")\n+        .operation_id(\"module_orchestrator.list_modules\")\n+        .summary(\"List all registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .public()\n+        .handler(handlers::list_modules)","path":"modules/system/module_orchestrator/src/api/rest/routes.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n1\\. Modules route marked <b><i>public()</i></b> <code>📘 Rule violation</code> <code>⛨ Security</code>\n\n<pre>\nThe new <b><i>GET /module-orchestrator/v1/modules</i></b> endpoint is explicitly registered as public, exposing\ninternal runtime/module inventory (including instance gRPC endpoints) without any visible authz\nguard. This violates the requirement to implement authentication/authorization checks for external\ninputs and sensitive system metadata exposure.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nThe `GET /module-orchestrator/v1/modules` route is registered as `.public()`, which can expose internal module inventory and instance endpoint URIs to unauthenticated callers.\n\n## Issue Context\nCompliance requires authentication/authorization checks for externally accessible endpoints that return sensitive system metadata.\n\n## Fix Focus Areas\n- modules/system/module_orchestrator/src/api/rest/routes.rs[17-26]\n- modules/system/module_orchestrator/src/api/rest/dto.rs[42-46]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-10T12:43:10Z","updated_at":"2026-02-10T12:43:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787739760","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739760"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787739760"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739760/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":17,"start_side":"RIGHT","line":null,"original_line":26,"side":"RIGHT","author_association":"NONE","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739766","pull_request_review_id":3778720371,"id":2787739766,"node_id":"PRRC_kwDOPaLyBs6mKYh2","diff_hunk":"@@ -0,0 +1,83 @@\n+use std::collections::HashMap;\n+use uuid::Uuid;\n+\n+use crate::domain::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Deployment mode of a module\n+#[derive(Debug, Clone)]\n+#[modkit_macros::api_dto(response)]\n+pub enum DeploymentModeDto {\n+    /// Module is compiled into the host binary\n+    CompiledIn,\n+    /// Module runs as a separate process\n+    OutOfProcess,\n+}\n+\n+/// Response DTO for a single registered module\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleDto {\n+    /// Module name\n+    pub name: String,\n+    /// Declared capabilities (e.g., \"rest\", \"grpc\", \"system\", \"db\")\n+    pub capabilities: Vec<String>,\n+    /// Module dependencies (other module names)\n+    pub dependencies: Vec<String>,\n+    /// Whether the module is compiled-in or out-of-process\n+    pub deployment_mode: DeploymentModeDto,\n+    /// Running instances of this module\n+    pub instances: Vec<ModuleInstanceDto>,\n+    /// Plugins provided by this module (not yet populated; reserved for follow-up)\n+    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n+    pub plugins: Vec<PluginDto>,\n+}\n+\n+/// Response DTO for a running module instance\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleInstanceDto {\n+    /// Unique instance ID\n+    pub instance_id: Uuid,\n+    /// Module version (if reported during registration)\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+    /// Current instance state (e.g., \"registered\", \"healthy\", \"quarantined\")\n+    pub state: String,\n+    /// gRPC services provided by this instance (service name -> endpoint URI)\n+    pub grpc_services: HashMap<String, String>,\n+}\n+\n+/// Response DTO for a plugin (reserved for follow-up implementation)\n+#[modkit_macros::api_dto(response)]\n+pub struct PluginDto {\n+    /// Plugin GTS identifier\n+    pub gts_id: String,\n+    /// Plugin version\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+}\n+\n+impl From<&ModuleInfo> for ModuleDto {\n+    fn from(info: &ModuleInfo) -> Self {\n+        Self {\n+            name: info.name.clone(),\n+            capabilities: info.capabilities.clone(),\n+            dependencies: info.dependencies.clone(),\n+            deployment_mode: match info.deployment_mode {\n+                DeploymentMode::CompiledIn => DeploymentModeDto::CompiledIn,\n+                DeploymentMode::OutOfProcess => DeploymentModeDto::OutOfProcess,\n+            },\n+            instances: info.instances.iter().map(ModuleInstanceDto::from).collect(),\n+            plugins: vec![],\n+        }","path":"modules/system/module-orchestrator/src/api/rest/dto.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n2\\. Modules api lacks plugin data <code>📎 Requirement gap</code> <code>✓ Correctness</code>\n\n<pre>\nThe modules listing response does not populate plugins and can omit the <b><i>plugins</i></b> field entirely,\nand it also lacks a module-level version field (only per-instance optional version exists). This\nviolates the requirement that module/plugins and their version metadata be included and populated in\nthe response.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nThe modules listing contract required by compliance is incomplete: plugins are always empty and may be omitted from JSON, and there is no module-level version field (only per-instance optional version).\n\n## Issue Context\nCompliance requires: (1) plugins included/listed, (2) module and plugin version fields present and populated, and (3) execution type indicated (already present via `deployment_mode`).\n\n## Fix Focus Areas\n- modules/system/module_orchestrator/src/api/rest/dto.rs[16-71]\n- modules/system/module_orchestrator/src/domain/model.rs[11-28]\n- modules/system/module_orchestrator/src/domain/service.rs[29-99]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-10T12:43:11Z","updated_at":"2026-02-10T12:43:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787739766","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739766"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787739766"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787739766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":18,"original_start_line":16,"start_side":"RIGHT","line":86,"original_line":70,"side":"RIGHT","author_association":"NONE","original_position":70,"position":86,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787752505","pull_request_review_id":3778733757,"id":2787752505,"node_id":"PRRC_kwDOPaLyBs6mKbo5","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::collections::HashSet;\n+use std::sync::Arc;\n+\n+use modkit::registry::ModuleRegistrySnapshot;\n+use modkit::runtime::{InstanceState, ModuleManager};\n+\n+use super::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Service that assembles module information from registry snapshot and runtime data.\n+pub struct ModulesService {\n+    registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+    module_manager: Arc<ModuleManager>,\n+    oop_module_names: Arc<HashSet<String>>,\n+}\n+\n+impl ModulesService {\n+    pub fn new(\n+        registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+        module_manager: Arc<ModuleManager>,\n+        oop_module_names: Arc<HashSet<String>>,\n+    ) -> Self {\n+        Self {\n+            registry_snapshot,\n+            module_manager,\n+            oop_module_names,\n+        }\n+    }\n+\n+    /// List all registered modules, merging compile-time registry data with runtime instances.\n+    pub fn list_modules(&self) -> Vec<ModuleInfo> {\n+        let mut result = Vec::new();\n+        let mut seen_names = HashSet::new();\n+\n+        // 1. Emit all compiled-in modules from the registry snapshot.\n+        //    If a module is also in oop_module_names, it means the config overrides\n+        //    it to run out-of-process.\n+        for snapshot in &self.registry_snapshot.modules {\n+            seen_names.insert(snapshot.name.clone());\n+\n+            let deployment_mode = if self.oop_module_names.contains(&snapshot.name) {\n+                DeploymentMode::OutOfProcess\n+            } else {\n+                DeploymentMode::CompiledIn\n+            };\n+\n+            let instances = self.instances_for_module(&snapshot.name);\n+\n+            result.push(ModuleInfo {\n+                name: snapshot.name.clone(),\n+                capabilities: snapshot.capability_labels.clone(),\n+                dependencies: snapshot.deps.clone(),\n+                deployment_mode,\n+                instances,\n+            });\n+        }\n+\n+        // 2. Add OoP modules from config that haven't been seen yet\n+        //    (they may or may not have registered instances)\n+        for oop_name in self.oop_module_names.iter() {\n+            if seen_names.contains(oop_name) {\n+                continue;\n+            }\n+            seen_names.insert(oop_name.clone());\n+\n+            let instances = self.instances_for_module(oop_name);\n+\n+            result.push(ModuleInfo {\n+                name: oop_name.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // 3. Add any dynamically registered modules from ModuleManager\n+        //    that are not in the registry or OoP config\n+        for instance in self.module_manager.all_instances() {\n+            if seen_names.contains(&instance.module) {\n+                continue;\n+            }\n+            seen_names.insert(instance.module.clone());\n+\n+            let instances = self.instances_for_module(&instance.module);\n+\n+            result.push(ModuleInfo {\n+                name: instance.module.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // Sort by name for deterministic output\n+        result.sort_by(|a, b| a.name.cmp(&b.name));\n+\n+        result\n+    }","path":"modules/system/module_orchestrator/src/domain/service.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Valid point. This is an intentional limitation of this PR, not an oversight.\n\n**Module-level version**: Currently not stored for compiled-in modules — the `#[modkit::module]` macro doesn't capture a version field, and `ModuleEntry` has no version attribute. Adding it requires changes to the macro and `ModuleRegistry` internals, which is out of scope for this \"good first issue\".\n\n**Plugins**: The module→plugin association doesn't exist in the current architecture. `TypesRegistry` tracks types/schemas but not which module registered them. Populating this field requires a new cross-registry lookup mechanism.\n\nBoth are tracked for follow-up. The `plugins` field and per-instance `version` are included in the response contract now so that future PRs can populate them without breaking the API.","created_at":"2026-02-10T12:45:50Z","updated_at":"2026-02-10T12:45:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787752505","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787752505"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787752505"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787752505/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":29,"start_side":"RIGHT","line":null,"original_line":99,"side":"RIGHT","in_reply_to_id":2787734097,"author_association":"MEMBER","original_position":99,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787753306","pull_request_review_id":3778734735,"id":2787753306,"node_id":"PRRC_kwDOPaLyBs6mKb1a","diff_hunk":"@@ -0,0 +1,38 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{Missing, OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+/// Register all REST routes for the module orchestrator\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /module-orchestrator/v1/modules - List all registered modules\n+    router = OperationBuilder::<Missing, Missing, ()>::get(\"/module-orchestrator/v1/modules\")\n+        .operation_id(\"module_orchestrator.list_modules\")\n+        .summary(\"List all registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .public()\n+        .handler(handlers::list_modules)","path":"modules/system/module_orchestrator/src/api/rest/routes.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is consistent with the existing pattern in the codebase — all `nodes_registry` endpoints are also `.public()`. The platform currently does not have an authentication layer for system introspection endpoints.\n\nThat said, the concern is valid in principle: gRPC endpoint URIs and module names could be considered sensitive in a production deployment. This should be revisited when an auth/RBAC system is implemented platform-wide. For now, this endpoint follows the same access pattern as other system module APIs.","created_at":"2026-02-10T12:45:58Z","updated_at":"2026-02-10T12:45:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787753306","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787753306"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787753306"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787753306/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":17,"start_side":"RIGHT","line":null,"original_line":26,"side":"RIGHT","in_reply_to_id":2787739760,"author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787754082","pull_request_review_id":3778735586,"id":2787754082,"node_id":"PRRC_kwDOPaLyBs6mKcBi","diff_hunk":"@@ -0,0 +1,83 @@\n+use std::collections::HashMap;\n+use uuid::Uuid;\n+\n+use crate::domain::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Deployment mode of a module\n+#[derive(Debug, Clone)]\n+#[modkit_macros::api_dto(response)]\n+pub enum DeploymentModeDto {\n+    /// Module is compiled into the host binary\n+    CompiledIn,\n+    /// Module runs as a separate process\n+    OutOfProcess,\n+}\n+\n+/// Response DTO for a single registered module\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleDto {\n+    /// Module name\n+    pub name: String,\n+    /// Declared capabilities (e.g., \"rest\", \"grpc\", \"system\", \"db\")\n+    pub capabilities: Vec<String>,\n+    /// Module dependencies (other module names)\n+    pub dependencies: Vec<String>,\n+    /// Whether the module is compiled-in or out-of-process\n+    pub deployment_mode: DeploymentModeDto,\n+    /// Running instances of this module\n+    pub instances: Vec<ModuleInstanceDto>,\n+    /// Plugins provided by this module (not yet populated; reserved for follow-up)\n+    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n+    pub plugins: Vec<PluginDto>,\n+}\n+\n+/// Response DTO for a running module instance\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleInstanceDto {\n+    /// Unique instance ID\n+    pub instance_id: Uuid,\n+    /// Module version (if reported during registration)\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+    /// Current instance state (e.g., \"registered\", \"healthy\", \"quarantined\")\n+    pub state: String,\n+    /// gRPC services provided by this instance (service name -> endpoint URI)\n+    pub grpc_services: HashMap<String, String>,\n+}\n+\n+/// Response DTO for a plugin (reserved for follow-up implementation)\n+#[modkit_macros::api_dto(response)]\n+pub struct PluginDto {\n+    /// Plugin GTS identifier\n+    pub gts_id: String,\n+    /// Plugin version\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+}\n+\n+impl From<&ModuleInfo> for ModuleDto {\n+    fn from(info: &ModuleInfo) -> Self {\n+        Self {\n+            name: info.name.clone(),\n+            capabilities: info.capabilities.clone(),\n+            dependencies: info.dependencies.clone(),\n+            deployment_mode: match info.deployment_mode {\n+                DeploymentMode::CompiledIn => DeploymentModeDto::CompiledIn,\n+                DeploymentMode::OutOfProcess => DeploymentModeDto::OutOfProcess,\n+            },\n+            instances: info.instances.iter().map(ModuleInstanceDto::from).collect(),\n+            plugins: vec![],\n+        }","path":"modules/system/module-orchestrator/src/api/rest/dto.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged — this is a known limitation, same as the CodeRabbit finding above.\n\n**Module-level version**: The `#[modkit::module]` macro and `ModuleEntry` don't capture a module version today. Adding it requires macro + registry changes that are out of scope here.\n\n**Plugins**: There is no module→plugin association in the current architecture. `TypesRegistry` tracks schemas but doesn't link them back to the originating module.\n\nThe `plugins` field is included in the DTO contract (with `skip_serializing_if = \"Vec::is_empty\"`) specifically so that a follow-up PR can populate it without a breaking API change. The `version` field exists at the instance level where it's available from runtime registration.","created_at":"2026-02-10T12:46:08Z","updated_at":"2026-02-10T12:46:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787754082","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787754082"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787754082"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787754082/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":18,"original_start_line":16,"start_side":"RIGHT","line":86,"original_line":70,"side":"RIGHT","in_reply_to_id":2787739766,"author_association":"MEMBER","original_position":70,"position":86,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787755908","pull_request_review_id":3778737744,"id":2787755908,"node_id":"PRRC_kwDOPaLyBs6mKceE","diff_hunk":"@@ -0,0 +1,38 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{Missing, OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+/// Register all REST routes for the module orchestrator\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /module-orchestrator/v1/modules - List all registered modules\n+    router = OperationBuilder::<Missing, Missing, ()>::get(\"/module-orchestrator/v1/modules\")\n+        .operation_id(\"module_orchestrator.list_modules\")\n+        .summary(\"List all registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .public()\n+        .handler(handlers::list_modules)","path":"modules/system/module_orchestrator/src/api/rest/routes.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"### Question: \nThis is consistent with the existing pattern in the codebase — all `nodes_registry` endpoints are also `.public()`. The platform currently does not have an authentication layer for system introspection endpoints. That said, the concern is valid in principle: gRPC endpoint URIs and module names could be considered sensitive in a production deployment. This should be revisited when an auth/RBAC system is implemented platform-wide. For now, this endpoint follows the same access pattern as other system module APIs.\n\n### Answer:\nIf this is an intentional, repo-wide pattern (system introspection endpoints are currently unauthenticated), you can reduce repeated “public endpoint missing auth” findings by adding explicit guidance to the reviewer/compliance prompts.\n\nAdd repo-specific instructions (recommended, keeps security checks on but aligns them to your current architecture):\n\n```toml\n[pr_reviewer]\nextra_instructions = \"\"\"\\\nSecurity findings policy for this repo:\n- System introspection APIs (e.g., nodes_registry, module-orchestrator inventory) are intentionally unauthenticated today because the platform has no auth/RBAC layer yet.\n- Do NOT flag `.public()` on these introspection endpoints as a rule violation by itself.\n- Still flag as security issues only when there is *new* escalation beyond the established pattern (e.g., exposing secrets/tokens/credentials, or expanding scope to non-introspection/external-facing APIs).\n- When relevant, phrase as “requires verification / future hardening when auth/RBAC is introduced”, not “must fix now”.\n\"\"\"\n```\n\nIf you’re using `/compliance` and want the same behavior there:\n\n```toml\n[pr_compliance]\nextra_instructions = \"\"\"\\\nTreat unauthenticated system introspection endpoints as an accepted current-state pattern (no auth/RBAC yet).\nOnly mark non-compliance when a change increases exposure beyond existing introspection patterns or reveals sensitive secrets.\n\"\"\"\n```\n\nIf you instead want to fully suppress security scanning noise (less recommended), you can disable it per tool:\n- `/review`: set `require_security_review = false`\n- `/compliance`: set `enable_security_compliance = false`\n\n(If you tell me whether the finding was produced by `/review` vs `/compliance`, I can suggest the smallest, most targeted config change for that tool.)\n\n#### Relevant Sources:\n\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/review#extra-instructions\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/review#configuration-options\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/compliance#configuration-options\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/additional_configurations#extra-instructions\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions-and-best-practices\n","created_at":"2026-02-10T12:46:29Z","updated_at":"2026-02-10T12:46:29Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787755908","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787755908"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787755908"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787755908/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":17,"start_side":"RIGHT","line":null,"original_line":26,"side":"RIGHT","in_reply_to_id":2787739760,"author_association":"NONE","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787756999","pull_request_review_id":3778739289,"id":2787756999,"node_id":"PRRC_kwDOPaLyBs6mKcvH","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::collections::HashSet;\n+use std::sync::Arc;\n+\n+use modkit::registry::ModuleRegistrySnapshot;\n+use modkit::runtime::{InstanceState, ModuleManager};\n+\n+use super::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Service that assembles module information from registry snapshot and runtime data.\n+pub struct ModulesService {\n+    registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+    module_manager: Arc<ModuleManager>,\n+    oop_module_names: Arc<HashSet<String>>,\n+}\n+\n+impl ModulesService {\n+    pub fn new(\n+        registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+        module_manager: Arc<ModuleManager>,\n+        oop_module_names: Arc<HashSet<String>>,\n+    ) -> Self {\n+        Self {\n+            registry_snapshot,\n+            module_manager,\n+            oop_module_names,\n+        }\n+    }\n+\n+    /// List all registered modules, merging compile-time registry data with runtime instances.\n+    pub fn list_modules(&self) -> Vec<ModuleInfo> {\n+        let mut result = Vec::new();\n+        let mut seen_names = HashSet::new();\n+\n+        // 1. Emit all compiled-in modules from the registry snapshot.\n+        //    If a module is also in oop_module_names, it means the config overrides\n+        //    it to run out-of-process.\n+        for snapshot in &self.registry_snapshot.modules {\n+            seen_names.insert(snapshot.name.clone());\n+\n+            let deployment_mode = if self.oop_module_names.contains(&snapshot.name) {\n+                DeploymentMode::OutOfProcess\n+            } else {\n+                DeploymentMode::CompiledIn\n+            };\n+\n+            let instances = self.instances_for_module(&snapshot.name);\n+\n+            result.push(ModuleInfo {\n+                name: snapshot.name.clone(),\n+                capabilities: snapshot.capability_labels.clone(),\n+                dependencies: snapshot.deps.clone(),\n+                deployment_mode,\n+                instances,\n+            });\n+        }\n+\n+        // 2. Add OoP modules from config that haven't been seen yet\n+        //    (they may or may not have registered instances)\n+        for oop_name in self.oop_module_names.iter() {\n+            if seen_names.contains(oop_name) {\n+                continue;\n+            }\n+            seen_names.insert(oop_name.clone());\n+\n+            let instances = self.instances_for_module(oop_name);\n+\n+            result.push(ModuleInfo {\n+                name: oop_name.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // 3. Add any dynamically registered modules from ModuleManager\n+        //    that are not in the registry or OoP config\n+        for instance in self.module_manager.all_instances() {\n+            if seen_names.contains(&instance.module) {\n+                continue;\n+            }\n+            seen_names.insert(instance.module.clone());\n+\n+            let instances = self.instances_for_module(&instance.module);\n+\n+            result.push(ModuleInfo {\n+                name: instance.module.clone(),\n+                capabilities: vec![],\n+                dependencies: vec![],\n+                deployment_mode: DeploymentMode::OutOfProcess,\n+                instances,\n+            });\n+        }\n+\n+        // Sort by name for deterministic output\n+        result.sort_by(|a, b| a.name.cmp(&b.name));\n+\n+        result\n+    }","path":"modules/system/module_orchestrator/src/domain/service.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@KvizadSaderah`, thank you for the detailed explanation! That makes complete sense—scope management is important, especially for a good first issue. Including the fields in the API contract now for forward compatibility is a smart approach that prevents breaking changes later.\n\nI appreciate the clarification on the architectural constraints. I'll note this for future reviews.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: KvizadSaderah\nRepo: cyberfabric/cyberfabric-core PR: 540\nFile: modules/system/module_orchestrator/src/domain/service.rs:29-99\nTimestamp: 2026-02-10T12:46:27.491Z\nLearning: The `TypesRegistry` in the codebase tracks types and schemas but does not track which module registered them, so there is no module→plugin association in the current architecture.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T12:46:42Z","updated_at":"2026-02-10T12:46:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787756999","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787756999"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787756999"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787756999/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":29,"start_side":"RIGHT","line":null,"original_line":99,"side":"RIGHT","in_reply_to_id":2787734097,"author_association":"CONTRIBUTOR","original_position":99,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787757410","pull_request_review_id":3778740061,"id":2787757410,"node_id":"PRRC_kwDOPaLyBs6mKc1i","diff_hunk":"@@ -0,0 +1,83 @@\n+use std::collections::HashMap;\n+use uuid::Uuid;\n+\n+use crate::domain::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Deployment mode of a module\n+#[derive(Debug, Clone)]\n+#[modkit_macros::api_dto(response)]\n+pub enum DeploymentModeDto {\n+    /// Module is compiled into the host binary\n+    CompiledIn,\n+    /// Module runs as a separate process\n+    OutOfProcess,\n+}\n+\n+/// Response DTO for a single registered module\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleDto {\n+    /// Module name\n+    pub name: String,\n+    /// Declared capabilities (e.g., \"rest\", \"grpc\", \"system\", \"db\")\n+    pub capabilities: Vec<String>,\n+    /// Module dependencies (other module names)\n+    pub dependencies: Vec<String>,\n+    /// Whether the module is compiled-in or out-of-process\n+    pub deployment_mode: DeploymentModeDto,\n+    /// Running instances of this module\n+    pub instances: Vec<ModuleInstanceDto>,\n+    /// Plugins provided by this module (not yet populated; reserved for follow-up)\n+    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n+    pub plugins: Vec<PluginDto>,\n+}\n+\n+/// Response DTO for a running module instance\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleInstanceDto {\n+    /// Unique instance ID\n+    pub instance_id: Uuid,\n+    /// Module version (if reported during registration)\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+    /// Current instance state (e.g., \"registered\", \"healthy\", \"quarantined\")\n+    pub state: String,\n+    /// gRPC services provided by this instance (service name -> endpoint URI)\n+    pub grpc_services: HashMap<String, String>,\n+}\n+\n+/// Response DTO for a plugin (reserved for follow-up implementation)\n+#[modkit_macros::api_dto(response)]\n+pub struct PluginDto {\n+    /// Plugin GTS identifier\n+    pub gts_id: String,\n+    /// Plugin version\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub version: Option<String>,\n+}\n+\n+impl From<&ModuleInfo> for ModuleDto {\n+    fn from(info: &ModuleInfo) -> Self {\n+        Self {\n+            name: info.name.clone(),\n+            capabilities: info.capabilities.clone(),\n+            dependencies: info.dependencies.clone(),\n+            deployment_mode: match info.deployment_mode {\n+                DeploymentMode::CompiledIn => DeploymentModeDto::CompiledIn,\n+                DeploymentMode::OutOfProcess => DeploymentModeDto::OutOfProcess,\n+            },\n+            instances: info.instances.iter().map(ModuleInstanceDto::from).collect(),\n+            plugins: vec![],\n+        }","path":"modules/system/module-orchestrator/src/api/rest/dto.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"### Question: \nAcknowledged — this is a known limitation, same as the CodeRabbit finding above. **Module-level version**: The `#[modkit::module]` macro and `ModuleEntry` don't capture a module version today. Adding it requires macro + registry changes that are out of scope here. **Plugins**: There is no module→plugin association in the current architecture. `TypesRegistry` tracks schemas but doesn't link them back to the originating module. The `plugins` field is included in the DTO contract (with `skip_serializing_if = Vec::is_empty`) specifically so that a follow-up PR can populate it without a breaking API change. The `version` field exists at the instance level where it's available from runtime registration.\n\n### Answer:\nThis looks like an inherent product/architecture limitation in your codebase (macro + registry don’t currently carry module-level version, and there’s no module→plugin linkage), so it can’t be “fixed” purely via Qodo Merge configuration.\n\nWhat you *can* do via configuration is reduce future “requirement gap” noise by steering `/improve` to only raise items that are actionable within the PR scope, and to treat known architectural gaps as “follow-up / out of scope” unless the PR already touches the macro/registry design.\n\nAdd a repo-level `.pr_agent.toml` (or wiki `.pr_agent.toml`) like:\n\n```toml\n[pr_code_suggestions]\nextra_instructions = \"\"\"\\\nWhen reviewing API/DTO contract issues:\n- Only suggest changes that are implementable within the current architecture and the files changed in this PR.\n- Do NOT propose solutions that require redesigning procedural macros, global registries, or introducing new module↔plugin linkage if it doesn’t already exist.\n- If you detect missing fields like module-level version or populated plugins that require macro/registry redesign, label it explicitly as \"Known limitation / follow-up\" and avoid requesting code changes in this PR unless the PR already includes the needed infrastructure changes.\n- Prefer non-breaking, low-risk improvements (e.g., documenting fields, avoiding omission surprises, clarifying DTO behavior) over speculative architecture changes.\n\"\"\"\n```\n\nIf you want, I can tailor the wording further if you tell me which tool produced the finding (`/review`, `/improve`, or `/compliance`) and whether you want it to (a) stop flagging this pattern entirely, or (b) keep flagging it but downgrade severity/wording.\n\n#### Relevant Sources:\n\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions-and-best-practices\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/additional_configurations#extra-instructions\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/configuration_options#wiki-configuration-file\n","created_at":"2026-02-10T12:46:49Z","updated_at":"2026-02-10T12:46:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787757410","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787757410"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787757410"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787757410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":18,"original_start_line":16,"start_side":"RIGHT","line":86,"original_line":70,"side":"RIGHT","in_reply_to_id":2787739766,"author_association":"NONE","original_position":70,"position":86,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769862","pull_request_review_id":3778756045,"id":2787769862,"node_id":"PRRC_kwDOPaLyBs6mKf4G","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::collections::HashSet;\n+use std::sync::Arc;\n+\n+use modkit::registry::ModuleRegistrySnapshot;\n+use modkit::runtime::{InstanceState, ModuleManager};\n+\n+use super::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Service that assembles module information from registry snapshot and runtime data.\n+pub struct ModulesService {\n+    registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+    module_manager: Arc<ModuleManager>,\n+    oop_module_names: Arc<HashSet<String>>,\n+}\n+\n+impl ModulesService {\n+    pub fn new(\n+        registry_snapshot: Arc<ModuleRegistrySnapshot>,\n+        module_manager: Arc<ModuleManager>,\n+        oop_module_names: Arc<HashSet<String>>,\n+    ) -> Self {\n+        Self {\n+            registry_snapshot,\n+            module_manager,\n+            oop_module_names,\n+        }\n+    }\n+\n+    /// List all registered modules, merging compile-time registry data with runtime instances.\n+    pub fn list_modules(&self) -> Vec<ModuleInfo> {\n+        let mut result = Vec::new();","path":"modules/system/module_orchestrator/src/domain/service.rs","commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fair point — `result` is generic. Renaming to `modules` for clarity.","created_at":"2026-02-10T12:49:05Z","updated_at":"2026-02-10T12:49:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787769862","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769862"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787769862"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":31,"side":"RIGHT","author_association":"MEMBER","original_position":31,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769870","pull_request_review_id":3778756045,"id":2787769870,"node_id":"PRRC_kwDOPaLyBs6mKf4O","diff_hunk":"@@ -25,15 +31,19 @@ pub struct ModuleOrchestratorConfig;\n /// - Provides `DirectoryClient` to the `ClientHub` for in-process modules\n /// - Exposes `DirectoryService` gRPC service via `grpc_hub`\n /// - Tracks module instances and provides service resolution\n+/// - Exposes REST API to list all registered modules\n #[modkit::module(\n     name = \"module_orchestrator\",\n-    capabilities = [grpc, system],\n+    capabilities = [grpc, system, rest],","path":"modules/system/module-orchestrator/src/module.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"d9c1bdb064e7d4e9167b106d84aedefda34d32fd","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Valid observation but **not a bug in practice**. `module_orchestrator` is a system module that is always composed together with `api_gateway` (which provides `rest_host`). There is no supported deployment configuration where `module_orchestrator` runs without `api_gateway` — it already depends on the REST infrastructure for its gRPC directory service.\n\nIf a future binary were to include `module_orchestrator` without a `rest_host` module, the runtime would fail fast with a clear error (`RestRequiresHost`), which is the correct behavior — not a silent failure.\n\nFeature-gating the `rest` capability would add complexity without practical benefit, since the whole point of this PR is to expose the REST endpoint.","created_at":"2026-02-10T12:49:05Z","updated_at":"2026-02-10T12:49:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787769870","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769870"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2787769870"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787769870/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":37,"side":"RIGHT","author_association":"MEMBER","original_position":33,"position":27,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787819953","pull_request_review_id":3778809230,"id":2787819953,"node_id":"PRRC_kwDOPaLyBs6mKsGx","diff_hunk":"@@ -79,12 +103,48 @@ impl modkit::Module for ModuleOrchestrator {\n             .set(api_impl)\n             .map_err(|_| anyhow::anyhow!(\"DirectoryClient already set (init called twice?)\"))?;\n \n+        // Create the ModulesService for the REST endpoint\n+        let registry_snapshot = self\n+            .registry_snapshot\n+            .get()\n+            .cloned()\n+            .ok_or_else(|| anyhow::anyhow!(\"RegistrySnapshot not wired\"))?;\n+        let oop_module_names = self\n+            .oop_module_names\n+            .get()\n+            .cloned()\n+            .ok_or_else(|| anyhow::anyhow!(\"OoP module names not wired\"))?;\n+\n+        let modules_service = ModulesService::new(registry_snapshot, manager, oop_module_names);\n+        self.modules_service.store(Some(Arc::new(modules_service)));","path":"modules/system/module-orchestrator/src/module.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"dafe6e548d22e6de124cb18d508a65b60a4101be","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, locate and read the module.rs file\nfind . -path \"*/modules/system/module_orchestrator/src/module.rs\" -type f\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 122\n\n---\n\n🏁 Script executed:\n\n```shell\n# Get the
;\n+use uuid::Uuid;\n+\n+use modkit::runtime::InstanceState;\n+\n+use crate::domain::model::{DeploymentMode, InstanceInfo, ModuleInfo};\n+\n+/// Deployment mode of a module\n+#[derive(Debug, Clone)]\n+#[modkit_macros::api_dto(response)]\n+pub enum DeploymentModeDto {\n+    /// Module is compiled into the host binary\n+    CompiledIn,\n+    /// Module runs as a separate process\n+    OutOfProcess,\n+}\n+\n+/// Response DTO for a single registered module\n+#[modkit_macros::api_dto(response)]\n+pub struct ModuleDto {\n+    /// Module name\n+    pub name: String,\n+    /// Declared capabilities (e.g., \"rest\", \"grpc\", \"system\", \"db\")\n+    pub capabilities: Vec<String>,\n+    /// Module dependencies (other module names)\n+    pub dependencies: Vec<String>,\n+    /// Whether the module is compiled-in or out-of-process\n+    pub deployment_mode: DeploymentModeDto,\n+    /// Running instances of this module\n+    pub instances: Vec<ModuleInstanceDto>,","path":"modules/system/module-orchestrator/src/api/rest/dto.rs","commit_id":"197de1d1dee54331bc777edde2441b3160a8a4be","original_commit_id":"16dd46807de8f750af32427b683483659e334770","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Done — added `plugins: Vec<PluginDto>` with `skip_serializing_if = \"Vec::is_empty\"`. Reserved for follow-up implementation, API contract is in place. Covered by e2e test `plugins_field_omitted_when_empty`. Fixed in 74164ba.","created_at":"2026-02-10T21:43:52Z","updated_at":"2026-02-10T21:43:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790436934","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790436934"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790436934"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790436934/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":33,"original_line":30,"side":"RIGHT","in_reply_to_id":2790116654,"author_association":"MEMBER","original_position":30,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790440211","pull_request_review_id":3781798387,"id":2790440211,"node_id":"PRRC_kwDOPaLyBs6mUr0T","diff_hunk":"@@ -0,0 +1,38 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{Missing, OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+/// Register all REST routes for the module orchestrator\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /module-orchestrator/v1/modules - List all registered modules\n+    router = OperationBuilder::<Missing, Missing, ()>::get(\"/module-orchestrator/v1/modules\")\n+        .operation_id(\"module_orchestrator.list_modules\")\n+        .summary(\"List all registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .public()","path":"modules/system/module_orchestrator/src/api/rest/routes.rs","commit_id":"16dd46807de8f750af32427b683483659e334770","original_commit_id":"16dd46807de8f750af32427b683483659e334770","user":{"login":"KvizadSaderah","id":14391797,"node_id":"MDQ6VXNlcjE0MzkxNzk3","avatar_url":"https://avatars.githubusercontent.com/u/14391797?v=4","gravatar_id":"","url":"https://api.github.com/users/KvizadSaderah","html_url":"https://github.com/KvizadSaderah","followers_url":"https://api.github.com/users/KvizadSaderah/followers","following_url":"https://api.github.com/users/KvizadSaderah/following{/other_user}","gists_url":"https://api.github.com/users/KvizadSaderah/gists{/gist_id}","starred_url":"https://api.github.com/users/KvizadSaderah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KvizadSaderah/subscriptions","organizations_url":"https://api.github.com/users/KvizadSaderah/orgs","repos_url":"https://api.github.com/users/KvizadSaderah/repos","events_url":"https://api.github.com/users/KvizadSaderah/events{/privacy}","received_events_url":"https://api.github.com/users/KvizadSaderah/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Done — removed `.public()`, added `require_auth(&Resource::Modules, &Action::Read)`, `require_license_features::<License>([])`, and `.standard_errors(openapi)`. Follows the same auth pattern as `file_parser` routes. Fixed in 74164ba.","created_at":"2026-02-10T21:44:39Z","updated_at":"2026-02-10T21:44:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790440211","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790440211"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/540#discussion_r2790440211"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/540"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2790440211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":25,"side":"RIGHT","in_reply_to_id":2790137379,"author_association":"MEMBER","original_position":25,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2801281075","pull_request_review_id":3793937773,"id":2801281075,"node_id":"PRRC_kwDOPaLyBs6m-Cgz","diff_hunk":"@@ -0,0 +1,81 @@\n+use axum::http;\n+use axum::{Extension, Router};\n+use modkit::api::{\n+    OpenApiRegistry, OperationBuilder,\n+    operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature},\n+};\n+use std::sync::Arc;\n+\n+use super::dto::ModuleDto;\n+use super::handlers;\n+use crate::domain::service::ModulesService;\n+\n+enum Resource {\n+    Modules,\n+}\n+\n+enum Action {\n+    Read,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Resource::Modules => \"module_orchestrator\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Action::Read => \"read\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the module orchestrator\n+#[allow(clippy::needless_pass_by_value)]\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<ModulesService>,\n+) -> Router {\n+    // GET /modules/v1/modules/active - List all active registered modules\n+    router = OperationBuilder::get(\"/modules/v1/modules/active\")\n+        .operation_id(\"modules.list_active\")\n+        .summary(\"List all active registered modules\")\n+        .description(\n+            \"Returns a list of all compiled-in and out-of-process modules with their \\\n+         capabilities, dependencies, running instances, and deployment mode.\",\n+        )\n+        .tag(\"modules\")\n+        .require_auth(&Resource::Modules, &Action::Read)\n+        .require_license_features::<License>([])","path":"modules/system/module-orchestrator/src/api/rest/routes.rs","commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","original_commit_id":"08d3e08792501f816b672eca101e5a6ff843cfe3","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalc
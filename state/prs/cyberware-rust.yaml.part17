sem.clone().try_acquire_owned() {\n-            Ok(_permit) => {\n-                // Allow request; permit is dropped when response future completes\n-                return next.run(req).await;\n-            }\n-            Err(_) => {\n-                return StatusCode::SERVICE_UNAVAILABLE.into_response();\n+        // Check inflight limit using the matched key\n+        if let Some(sem) = map.inflight.get(key) {\n+            match sem.clone().try_acquire_owned() {\n+                Ok(_permit) => {\n+                    return next.run(req).await;\n+                }","path":"modules/system/api-gateway/src/middleware/rate_limit.rs","commit_id":"fc0191f852aa823b987daf112d2066b905ef8aec","original_commit_id":"5338c6cbb6648d77c6a01df5b0a1bed9312387bb","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@dominic1988-lgtm`, thank you for addressing this! The permit will now be held across the entire request lifecycle, correctly enforcing the in-flight limit.\n\n<!-- <review_comment_addressed> -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-12T08:38:11Z","updated_at":"2026-02-12T08:38:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797486933","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797486933"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797486933"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797486933/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":124,"start_side":"RIGHT","line":null,"original_line":129,"side":"RIGHT","in_reply_to_id":2797266227,"author_association":"CONTRIBUTOR","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797511853","pull_request_review_id":3789190971,"id":2797511853,"node_id":"PRRC_kwDOPaLyBs6mvqSt","diff_hunk":"@@ -115,16 +121,18 @@ pub async fn rate_limit_middleware(map: RateLimiterMap, mut req: Request, next:\n                 return StatusCode::TOO_MANY_REQUESTS.into_response();\n             }\n         }\n-    }\n \n-    if let Some(sem) = map.inflight.get(&key) {\n-        match sem.clone().try_acquire_owned() {\n-            Ok(_permit) => {\n-                // Allow request; permit is dropped when response future completes\n-                return next.run(req).await;\n-            }\n-            Err(_) => {\n-                return StatusCode::SERVICE_UNAVAILABLE.into_response();\n+        // Check inflight limit using the matched key\n+        if let Some(sem) = map.inflight.get(key) {\n+            match sem.clone().try_acquire_owned() {\n+                Ok(permit) => {\n+                    let response = next.run(req).await;\n+                    drop(permit);\n+                    return response;\n+                }\n+                Err(_) => {\n+                    return StatusCode::SERVICE_UNAVAILABLE.into_response();\n+                }\n             }\n         }\n     }","path":"modules/system/api-gateway/src/middleware/rate_limit.rs","commit_id":"fc0191f852aa823b987daf112d2066b905ef8aec","original_commit_id":"fc0191f852aa823b987daf112d2066b905ef8aec","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Critical Logic Error: Inflight limit check nested inside bucket check**\n\nThe inflight semaphore check is now nested inside the bucket matching conditional (line 102). This means if an endpoint has an inflight limit configured but NO rate bucket limit, the inflight check will never execute.\n\nIn the old code, these were independent checks:\n```rust\nif let Some(...) = map.buckets.get(&key) { /* bucket check */ }\nif let Some(sem) = map.inflight.get(&key) { /* inflight check */ }\n```\n\nThe new code makes inflight dependent on finding a matching bucket first, breaking endpoints that only use inflight limits.\n\n**Fix**: Move the inflight check outside and make it independent:\n```rust\nif let Some((key, bucker_map_entry)) = matching_bucket {\n    // ... bucket check code ...\n}\n\n// Separate inflight check (using the same matching logic)\nlet matching_inflight = map.inflight.iter()\n    .filter(|(key, _)| key.0 == method && path.ends_with(&key.1))\n    .max_by_key(|(key, _)| key.1.len());\n\nif let Some((_, sem)) = matching_inflight {\n    // ... inflight check code ...\n}\n```\n```suggestion\n    }\n\n    // Check inflight limit independently\n    let matching_inflight = map.inflight.iter()\n        .filter(|(key, _)| key.0 == method && path.ends_with(&key.1))\n        .max_by_key(|(key, _)| key.1.len());\n\n    if let Some((_, sem)) = matching_inflight {\n        match sem.clone().try_acquire_owned() {\n            Ok(permit) => {\n                let response = next.run(req).await;\n                drop(permit);\n                return response;\n            }\n            Err(_) => {\n                return StatusCode::SERVICE_UNAVAILABLE.into_response();\n            }\n        }\n    }\n}\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=cyberfabric&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/cyberfabric/cyberfabric-core/578?chatWithGeneratedComment=2f7b5df5-f67d-40b4-924d-dba8415afd1a\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-12T08:42:25Z","updated_at":"2026-02-12T08:42:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797511853","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797511853"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797511853"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797511853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":125,"start_side":"RIGHT","line":null,"original_line":138,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797703257","pull_request_review_id":3789723631,"id":2797703257,"node_id":"PRRC_kwDOPaLyBs6mwZBZ","diff_hunk":"@@ -54,9 +48,20 @@ pub async fn license_validation_middleware(\n         .get::<axum::extract::MatchedPath>()\n         .map_or_else(|| req.uri().path().to_owned(), |p| p.as_str().to_owned());\n \n-    let Some(required) = map.get(&method, &path) else {\n+    // Match if request path ends with a registered path (suffix match)\n+    let matching_entry = map\n+        .requirements\n+        .iter()\n+        .filter(|entry| {\n+            let (ref map_method, ref map_path) = *entry.key();\n+            *map_method == method && path.ends_with(map_path)\n+        })\n+        .max_by_key(|entry| entry.key().1.len());","path":"modules/system/api-gateway/src/middleware/license_validation.rs","commit_id":"9a94668a4c1cd50dffea613e3985f16b7d3529f2","original_commit_id":"9a94668a4c1cd50dffea613e3985f16b7d3529f2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Scope suffix matching to the intended `/chat` prefix.**\n\n`ends_with` alone will match any endpoint that shares trailing segments (e.g., `/support/rooms` → `/rooms`), which can apply the wrong license policy or block unrelated routes. If the intent is specifically “module routes under `/chat`”, guard by that prefix (or normalize by stripping `/chat` and then doing an exact lookup).\n\n\n<details>\n<summary>🛠️ Suggested guard to keep matching scoped to /chat</summary>\n\n```diff\n         .filter(|entry| {\n             let (ref map_method, ref map_path) = *entry.key();\n-            *map_method == method && path.ends_with(map_path)\n+            *map_method == method\n+                && (path == \"/chat\" || path.starts_with(\"/chat/\"))\n+                && path.ends_with(map_path)\n         })\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    // Match if request path ends with a registered path (suffix match)\n    let matching_entry = map\n        .requirements\n        .iter()\n        .filter(|entry| {\n            let (ref map_method, ref map_path) = *entry.key();\n            *map_method == method\n                && (path == \"/chat\" || path.starts_with(\"/chat/\"))\n                && path.ends_with(map_path)\n        })\n        .max_by_key(|entry| entry.key().1.len());\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/license_validation.rs` around lines\n51 - 59, The suffix match using path.ends_with(map_path) is too broad and can\nmisapply policies; update the matching logic in the block that computes\nmatching_entry (iterating map.requirements and using entry.key()) to first\nensure the incoming path is scoped to the /chat module (e.g., check\npath.starts_with(\"/chat\") or strip the \"/chat\" prefix into a normalized\nvariable) and then perform either an exact match against map_path or a suffix\nmatch only on the stripped remainder; keep the existing method comparison\n(map_method == method) and the max_by_key tie-breaker but restrict the candidate\nentries to those valid under the /chat prefix by using the normalized path for\nthe ends_with/equals check.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-12T09:17:10Z","updated_at":"2026-02-12T09:17:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797703257","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797703257"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#discussion_r2797703257"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2797703257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":51,"original_start_line":51,"start_side":"RIGHT","line":59,"original_line":59,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":26,"position":26,"subject_type":"line"}],"source_reviews":[{"id":3789185439,"node_id":"PRR_kwDOPaLyBs7h2mGf","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 3**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (3)</summary><blockquote>\n> \n> <details>\n> <summary>Makefile (1)</summary><blockquote>\n> \n> `438-439`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Add `openapi` to the `all` target to keep specs in sync.**  \n> The default `all` target should invoke OpenAPI generation so local builds produce the current spec.  \n> \n> <details>\n> <summary>🛠️ Suggested change</summary>\n> \n> ```diff\n> -all: build check test-sqlite e2e-local\n> +all: openapi build check test-sqlite e2e-local\n> ```\n> </details>\n> Based on learnings: Ensure that the default 'all' target in every Makefile under cyberfabric-core includes a dependency on the 'openapi' target so OpenAPI generation runs as part of the local build. Verify that an openapi target exists and that including it does not introduce unnecessary rebuilds or circular dependencies.\n> \n> </blockquote></details>\n> <details>\n> <summary>scripts/ci.py (1)</summary><blockquote>\n> \n> `289-295`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Fix port parsing when `base_url` includes a path.**  \n> `base_url.split(\":\")[-1]` now returns `\"8086/chat\"`, so the port passed to `kill_existing_server` is invalid.  \n> \n> <details>\n> <summary>🛠️ Suggested fix</summary>\n> \n> ```diff\n> +from urllib.parse import urlparse\n> ```\n> \n> ```diff\n> -    port = base_url.split(\":\")[-1]\n> -    kill_existing_server(port)\n> +    parsed = urlparse(base_url)\n> +    port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n> +    kill_existing_server(str(port))\n> ```\n> </details>\n> \n> </blockquote></details>\n> <details>\n> <summary>modules/system/api-gateway/tests/license_middleware.rs (1)</summary><blockquote>\n> \n> `182-197`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Fix missing `/chat` prefix for the bad-license request**\n> \n> With module routes now nested under `/chat`, this request will bypass the intended route and return 404 instead of 403. Update the URI to match the new prefix.\n> \n> <details>\n> <summary>🛠️ Suggested fix</summary>\n> \n> ```diff\n> -                .uri(\"/tests/v1/license/bad\")\n> +                .uri(\"/chat/tests/v1/license/bad\")\n> ```\n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/license_validation.rs`:\n- Around line 51-60: The current lookup using map.requirements.iter().find(...)\ncan pick a nondeterministic match for overlapping suffixes; instead, scan all\nentries (map.requirements.iter()) that match method and path.ends_with(map_path)\nand select the entry whose map_path is longest (most specific) — e.g., use\nfilter/map and max_by_key on map_path.len() to pick the best match, then clone\nthe entry.value() into required; update references around matching_entry,\nentry.key(), and entry.value() accordingly so the chosen policy is the most\nspecific suffix match.\n\nIn `@modules/system/api-gateway/src/middleware/mime_validation.rs`:\n- Around line 99-110: The current suffix match uses\nvalidation_map.iter().find(...) which can return an arbitrary match when\nmultiple map_path suffixes match; change this to iterate/filter entries where\nmap_method == &method and path.ends_with(map_path) and then choose the entry\nwith the longest map_path (most specific) — e.g. use\nvalidation_map.iter().filter(...).max_by_key(|entry| entry.key().1.len()) to\nassign matching_entry, then handle the Option as before and clone allowed_types\nfrom matching_entry.value().\n\nIn `@modules/system/api-gateway/src/middleware/rate_limit.rs`:\n- Around line 95-100: The current suffix match using\nmap.buckets.iter().find(...) is nondeterministic for overlapping routes; replace\nthe find with an iterator that filters by the same predicate (key.0 == method &&\npath.ends_with(&key.1)) and then selects the most-specific match via max_by_key\nusing the length of key.1 (i.e., choose the longest suffix). Apply this change\nwhere matching_bucket is computed (referencing map.buckets, key.0, key.1,\nmatching_bucket) so the chosen (key, bucker_map_entry) is the longest matching\nroute.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>libs/modkit/src/contracts.rs (1)</summary><blockquote>\n\n`85-90`: **Clarify the `module_router` contract in docs.**  \nAdding a brief note on how it should be merged will avoid ambiguity for implementers.  \n\n<details>\n<summary>📝 Suggested doc update</summary>\n\n```diff\n-    /// Finalize before start: attach /openapi.json, /docs, persist the Router internally if needed.\n+    /// Finalize before start: attach /openapi.json, /docs, persist the Router internally if needed.\n+    /// `module_router` contains module-scoped REST routes and should be merged into `router`\n+    /// during finalization.\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789185439","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789185439"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"submitted_at":"2026-02-12T07:47:44Z","commit_id":"a09b9436745663f658a7b2ba2350871cab8e7b56"},{"id":3789211565,"node_id":"PRR_kwDOPaLyBs7h2set","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (1)</summary><blockquote>\n> \n> <details>\n> <summary>modules/system/api-gateway/tests/license_middleware.rs (1)</summary><blockquote>\n> \n> `182-199`: _⚠️ Potential issue_ | _🟡 Minor_\n> \n> **Update the request URI to include `/chat` for module routes.**\n> \n> With module routes now wired via `module_router`, the endpoint is expected under the `/chat` prefix. The request in this test still targets `/tests/v1/license/bad`, which may now 404 instead of asserting the license middleware behavior.\n> \n> \n> \n> <details>\n> <summary>✅ Proposed fix</summary>\n> \n> ```diff\n> -                .uri(\"/tests/v1/license/bad\")\n> +                .uri(\"/chat/tests/v1/license/bad\")\n> ```\n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/rate_limit.rs`:\n- Around line 124-129: The acquired OwnedSemaphorePermit from\nsem.clone().try_acquire_owned() is being dropped before next.run(req).await\ncompletes because it was bound to an unused _permit; keep the permit alive\nacross the await by binding it to a named variable (e.g., permit) in the match\narm that succeeded and ensuring that variable remains in scope until after\nnext.run(req).await finishes (drop it or let it go out of scope after the\nawait). Update the match on map.inflight / try_acquire_owned to hold the permit\nvariable across the await rather than using an unused _permit.\n```\n\n</details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789211565","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789211565"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"submitted_at":"2026-02-12T07:55:27Z","commit_id":"5338c6cbb6648d77c6a01df5b0a1bed9312387bb"},{"id":3789272066,"node_id":"PRR_kwDOPaLyBs7h27QC","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (2)</summary><blockquote>\n> \n> <details>\n> <summary>scripts/ci.py (1)</summary><blockquote>\n> \n> `290-295`: _⚠️ Potential issue_ | _🔴 Critical_\n> \n> **Port extraction is broken by the `/chat` suffix.**\n> \n> The port extraction at line 294 uses `split(\":\")[-1]` which will now return `\"8086/chat\"` instead of `\"8086\"`. This will cause `kill_existing_server(port)` to fail when trying to find/kill processes on an invalid port string.\n> \n> \n> <details>\n> <summary>🐛 Proposed fix</summary>\n> \n> ```diff\n>  def cmd_e2e(args):\n>      base_url = os.environ.get(\"E2E_BASE_URL\", \"http://localhost:8086/chat\")\n>      check_pytest()\n> \n>      # Kill any existing server on the port before starting\n> -    port = base_url.split(\":\")[-1]\n> +    # Extract port from URL, handling path suffixes like /chat\n> +    from urllib.parse import urlparse\n> +    parsed = urlparse(base_url)\n> +    port = str(parsed.port) if parsed.port else \"8086\"\n>      kill_existing_server(port)\n> ```\n> \n> Alternatively, a simpler fix:\n> ```diff\n> -    port = base_url.split(\":\")[-1]\n> +    port = base_url.split(\":\")[-1].split(\"/\")[0]\n> ```\n> </details>\n> \n> </blockquote></details>\n> <details>\n> <summary>modules/system/api-gateway/tests/license_middleware.rs (1)</summary><blockquote>\n> \n> `193-203`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Inconsistent URI - missing `/chat` prefix.**\n> \n> The test URI `/tests/v1/license/bad` at line 196 is missing the `/chat` prefix, while other similar tests (`allows_base_feature_requirement` at line 239 and `allows_no_license_requirement` at line 282) use `/chat/tests/v1/license/...`.\n> \n> This test will fail because the route won't be found under the root path after the `/chat` nesting change.\n> \n> \n> <details>\n> <summary>🐛 Proposed fix</summary>\n> \n> ```diff\n>      let response = router\n>          .oneshot(\n>              Request::builder()\n> -                .uri(\"/tests/v1/license/bad\")\n> +                .uri(\"/chat/tests/v1/license/bad\")\n>                  .body(Body::empty())\n>                  .unwrap(),\n>          )\n> ```\n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>modules/system/api-gateway/src/module.rs (1)</summary><blockquote>\n\n`594-600`: **Consider making the `/chat` prefix configurable.**\n\nThe `/chat` prefix is hardcoded. For flexibility across different deployments, this could be added to `ApiGatewayConfig`:\n\n\n<details>\n<summary>♻️ Suggested approach</summary>\n\n```diff\n // In config.rs\n+    /// Prefix path for module routes (default: \"/chat\")\n+    #[serde(default = \"default_module_prefix\")]\n+    pub module_prefix: String,\n+\n+fn default_module_prefix() -> String {\n+    \"/chat\".to_owned()\n+}\n\n // In module.rs rest_finalize\n-        let mut prefix_router = Router::new().nest(\"/chat\", module_router);\n+        let prefix = &config.module_prefix;\n+        let mut prefix_router = Router::new().nest(prefix, module_router);\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789272066","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789272066"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"submitted_at":"2026-02-12T08:09:07Z","commit_id":"522f284a1c4b5c15682aae1798709b31d276800e"},{"id":3789419140,"node_id":"PRR_kwDOPaLyBs7h3fKE","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@scripts/ci.py`:\n- Around line 289-295: The port extraction in cmd_e2e is fragile\n(base_url.split(...)) — use urllib.parse.urlparse to parse base_url, read\nparsed.port (which will be an int or None), and only call kill_existing_server\nwhen parsed.port is not None; convert the int to a string if\nkill_existing_server expects a string. Update references to base_url/port in\ncmd_e2e accordingly so URLs without an explicit port (e.g., https://host/chat)\nskip kill_existing_server.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (1)</summary><blockquote>\n\n<details>\n<summary>modules/system/api-gateway/src/middleware/rate_limit.rs (1)</summary><blockquote>\n\n`95-102`: **LGTM on suffix matching; minor typo in variable name.**\n\nThe suffix matching logic correctly uses `filter` + `max_by_key` for longest-match selection, consistent with other middlewares.\n\nMinor: `bucker_map_entry` appears to be a typo for `bucket_map_entry`.\n\n\n<details>\n<summary>✏️ Suggested fix for typo</summary>\n\n```diff\n-    if let Some((key, bucker_map_entry)) = matching_bucket {\n+    if let Some((key, bucket_map_entry)) = matching_bucket {\n         let headers = req.headers_mut();\n-        headers.insert(\"RateLimit-Policy\", bucker_map_entry.policy.clone());\n-        match bucker_map_entry.bucket.check() {\n+        headers.insert(\"RateLimit-Policy\", bucket_map_entry.policy.clone());\n+        match bucket_map_entry.bucket.check() {\n             Ok(state) => {\n-                headers.insert(\"RateLimit-Limit\", bucker_map_entry.burst.clone());\n+                headers.insert(\"RateLimit-Limit\", bucket_map_entry.burst.clone());\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789419140","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789419140"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"submitted_at":"2026-02-12T08:32:47Z","commit_id":"85446d43727215387b536df493a4c2abe26e947c"},{"id":3789723631,"node_id":"PRR_kwDOPaLyBs7h4pfv","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (1)</summary><blockquote>\n> \n> <details>\n> <summary>modules/system/api-gateway/src/module.rs (1)</summary><blockquote>\n> \n> `582-600`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Prefixing under `/chat` breaks public docs route policy.**\n> \n> `add_openapi_routes` is now nested under `/chat`, but `build_auth_state_from_specs` still whitelists `/docs` and `/openapi.json`. With auth enabled, `/chat/docs` and `/chat/openapi.json` can become unexpectedly protected (or follow default auth policy). Please update the public-route list (or derive it from the prefix) to keep policy consistent.  \n> \n> \n> <details>\n> <summary>🔧 Suggested update (public routes)</summary>\n> \n> ```rust\n> // In build_auth_state_from_specs()\n> public_routes.insert((Method::GET, \"/chat/docs\".to_owned()));\n> public_routes.insert((Method::GET, \"/chat/openapi.json\".to_owned()));\n> // Optionally remove the unprefixed variants if they no longer exist.\n> ```\n> </details>\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/license_validation.rs`:\n- Around line 51-59: The suffix match using path.ends_with(map_path) is too\nbroad and can misapply policies; update the matching logic in the block that\ncomputes matching_entry (iterating map.requirements and using entry.key()) to\nfirst ensure the incoming path is scoped to the /chat module (e.g., check\npath.starts_with(\"/chat\") or strip the \"/chat\" prefix into a normalized\nvariable) and then perform either an exact match against map_path or a suffix\nmatch only on the stripped remainder; keep the existing method comparison\n(map_method == method) and the max_by_key tie-breaker but restrict the candidate\nentries to those valid under the /chat prefix by using the normalized path for\nthe ends_with/equals check.\n```\n\n</details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789723631","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/578#pullrequestreview-3789723631"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/578"}},"submitted_at":"2026-02-12T09:17:11Z","commit_id":"9a94668a4c1cd50dffea613e3985f16b7d3529f2"}]},{"source_pr_number":577,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/577","source_state":"closed","source_author":"ziqwerty","target_issue_number":null,"title":"[PR #577] ci: add github workflow for e2e smoke-on-push and nightly runs with automatic failure ownership assignment","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"gh-workflow","pr_head_sha":"db9508d9ac8d5e1cc9e80203524683f4dec0d82e","pr_base_ref":"main","pr_head_owner":"ziqwerty","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/577","id":3274724779,"node_id":"PR_kwDOPaLyBs7DMFWr","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/577","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/577.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/577.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/577","number":577,"state":"closed","locked":false,"title":"ci: add github workflow for e2e smoke-on-push and nightly runs with automatic failure ownership assignment","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Issue: #259\r\nDepends on PR: #320\r\n\r\n## Github Workflow for E2E smoke and nightly run\r\nImplements the E2E execution strategy: smoke tests on every push to main, full suite nightly.\r\n\r\n### What changed\r\n\r\n**New workflow: [.github/workflows/e2e.yml]()**\r\n- **Push to `main`** → runs `make e2e-smoke` (only `@pytest.mark.smoke` tests)\r\n- **Nightly schedule** (02:00 UTC) → runs full `make e2e` suite\r\n- **Manual dispatch** → choice of `smoke` or `full`\r\n- **Auto-issue on smoke failure**: creates/updates a GitHub Issue labeled `bug`, `e2e-smoke`, `ci`, assigned to the latest commit author. If an issue already exists, adds a comment with the new failure details and reassigns instead of creating a duplicate.\r\n\r\n**Makefile: `e2e-smoke` target**\r\n- Runs E2E with smoke marker `-m smoke` to pytest\r\n\r\n**Smoke test markers (6 tests across 5 modules)**\r\n\r\n| Module | Test | Coverage |\r\n|--------|------|----------|\r\n| settings | [test_get_settings_returns_defaults](testing/e2e/modules/settings/test_settings_get.py:5:0-44:73) | read-only |\r\n| settings | [test_settings_full_workflow](testing/e2e/modules/settings/test_settings_integration.py:5:0-81:49) | **write→read** (POST + PATCH + GET) |\r\n| types-registry | [test_get_entity_by_id](testing/e2e/modules/types_registry/test_types_registry_get.py:23:0-88:68) | **write→read** (POST + GET) |\r\n| nodes-registry | [test_get_node_by_id](testing/e2e/modules/nodes_registry/test_nodes_registry_get.py:6:0-54:61) | read-only |\r\n| file-parser | `test_file_parser_info_basic` | read-only |\r\n| tenant-resolver-gw | `test_get_root_tenant` | read-only |\r\n\r\n### Design decisions\r\n- Smoke suite kept intentionally small (~6 tests) for fast post-merge feedback\r\n- Nightly failures do **not** auto-create issues to avoid noise\r\n- `workflow_dispatch` supports mode selection for manual triage runs\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added a smoke testing workflow running on push, nightly, and manual triggers.\n  * Introduced a fast \"smoke\" test target for quick validation.\n  * Automatic issue creation/commenting and cleanup when smoke runs fail on push.\n\n* **Tests**\n  * Marked key end-to-end tests as smoke tests across modules.\n  * Added a pytest \"smoke\" marker for test selection.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-02-12T06:36:57Z","updated_at":"2026-02-19T02:51:23Z","closed_at":"2026-02-13T10:20:18Z","merged_at":"2026-02-13T10:20:18Z","merge_commit_sha":"a25bd22664cb0208a4f28d07838f8d2b883b6f1c","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/577/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/577/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/577/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/db9508d9ac8d5e1cc9e80203524683f4dec0d82e","head":{"label":"ziqwerty:gh-workflow","ref":"gh-workflow","sha":"db9508d9ac8d5e1cc9e80203524683f4dec0d82e","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions
tion":61,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2815965742","pull_request_review_id":3812815938,"id":2815965742,"node_id":"PRRC_kwDOPaLyBs6n2Dou","diff_hunk":"@@ -0,0 +1,34 @@\n+#![cfg_attr(coverage_nightly, feature(coverage_attribute))]","path":"modules/system/authn-resolver/plugins/static-authn-plugin/src/lib.rs","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Nit: `cfg_attr` should come after the module doc comment per Rust convention (doc comments before attributes). Other modules in this repo follow doc-first order.","created_at":"2026-02-17T09:50:12Z","updated_at":"2026-02-17T09:50:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2815965742","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2815965742"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2815965742"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2815965742/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816623243","pull_request_review_id":3813529039,"id":2816623243,"node_id":"PRRC_kwDOPaLyBs6n4kKL","diff_hunk":"@@ -0,0 +1,49 @@\n+[package]\n+name = \"cf-static-authz-plugin\"\n+version = \"0.1.0\"\n+edition.workspace = true\n+license.workspace = true\n+authors.workspace = true\n+description = \"AuthZ resolver plugin with static allow-all policy for development and testing\"\n+repository.workspace = true\n+readme = \"README.md\"\n+keywords = [\"cyberfabric\", \"cyberfabric-system\"]\n+categories = [\"authentication\"]\n+","path":"modules/system/authz-resolver/plugins/static-authz-plugin/Cargo.toml","commit_id":"efa3ffa346090af62be89ff2519231ca07689fae","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2026-02-17T11:44:51Z","updated_at":"2026-02-17T11:44:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2816623243","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816623243"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2816623243"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816623243/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":12,"original_line":12,"side":"RIGHT","in_reply_to_id":2815965682,"author_association":"MEMBER","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816624191","pull_request_review_id":3813529879,"id":2816624191,"node_id":"PRRC_kwDOPaLyBs6n4kY_","diff_hunk":"@@ -0,0 +1,167 @@\n+//! Domain service for the `AuthN` resolver.\n+//!\n+//! Plugin discovery is lazy: resolved on first API call after\n+//! types-registry is ready.\n+\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use authn_resolver_sdk::{\n+    AuthNResolverPluginClient, AuthNResolverPluginSpecV1, AuthenticationResult,\n+};\n+use modkit::client_hub::{ClientHub, ClientScope};\n+use modkit::gts::BaseModkitPluginV1;\n+use modkit::plugins::GtsPluginSelector;\n+use modkit::telemetry::ThrottledLog;\n+use modkit_macros::domain_model;\n+use tracing::info;\n+use types_registry_sdk::{GtsEntity, ListQuery, TypesRegistryClient};\n+\n+use super::error::DomainError;\n+\n+/// Throttle interval for unavailable plugin warnings.\n+const UNAVAILABLE_LOG_THROTTLE: Duration = Duration::from_secs(10);\n+\n+/// `AuthN` resolver service.\n+///\n+/// Discovers plugins via types-registry and delegates authentication calls.\n+#[domain_model]\n+pub struct Service {\n+    hub: Arc<ClientHub>,\n+    vendor: String,\n+    selector: GtsPluginSelector,\n+    unavailable_log_throttle: ThrottledLog,\n+}\n+\n+impl Service {\n+    /// Creates a new service with lazy plugin resolution.\n+    #[must_use]\n+    pub fn new(hub: Arc<ClientHub>, vendor: String) -> Self {\n+        Self {\n+            hub,\n+            vendor,\n+            selector: GtsPluginSelector::new(),\n+            unavailable_log_throttle: ThrottledLog::new(UNAVAILABLE_LOG_THROTTLE),\n+        }\n+    }\n+\n+    /// Lazily resolves and returns the plugin client.\n+    async fn get_plugin(&self) -> Result<Arc<dyn AuthNResolverPluginClient>, DomainError> {\n+        let instance_id = self.selector.get_or_init(|| self.resolve_plugin()).await?;\n+        let scope = ClientScope::gts_id(instance_id.as_ref());\n+\n+        if let Some(client) = self\n+            .hub\n+            .try_get_scoped::<dyn AuthNResolverPluginClient>(&scope)\n+        {\n+            Ok(client)\n+        } else {\n+            if self.unavailable_log_throttle.should_log() {\n+                tracing::warn!(\n+                    plugin_gts_id = %instance_id,\n+                    vendor = %self.vendor,\n+                    \"Plugin client not registered yet\"\n+                );\n+            }\n+            Err(DomainError::PluginUnavailable {\n+                gts_id: instance_id.to_string(),\n+                reason: \"client not registered yet\".into(),\n+            })\n+        }\n+    }\n+\n+    /// Resolves the plugin instance from types-registry.\n+    #[tracing::instrument(skip_all, fields(vendor = %self.vendor))]\n+    async fn resolve_plugin(&self) -> Result<String, DomainError> {\n+        info!(\"Resolving authn_resolver plugin\");\n+\n+        let registry = self\n+            .hub\n+            .get::<dyn TypesRegistryClient>()\n+            .map_err(|e| DomainError::TypesRegistryUnavailable(e.to_string()))?;\n+\n+        let plugin_type_id = AuthNResolverPluginSpecV1::gts_schema_id().clone();\n+\n+        let instances = registry\n+            .list(\n+                ListQuery::new()\n+                    .with_pattern(format!(\"{plugin_type_id}*\"))\n+                    .with_is_type(false),\n+            )\n+            .await?;\n+\n+        let gts_id = choose_plugin_instance(&self.vendor, &instances)?;\n+        info!(plugin_gts_id = %gts_id, \"Selected authn_resolver plugin instance\");\n+\n+        Ok(gts_id)\n+    }\n+\n+    /// Authenticate a bearer token via the selected plugin.\n+    ///\n+    /// # Errors\n+    ///\n+    /// - `Unauthorized` if the token is invalid\n+    /// - Plugin resolution errors\n+    #[tracing::instrument(skip_all)]\n+    pub async fn authenticate(\n+        &self,\n+        bearer_token: &str,\n+    ) -> Result<AuthenticationResult, DomainError> {\n+        let plugin = self.get_plugin().await?;\n+        plugin\n+            .authenticate(bearer_token)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+}\n+\n+/// Selects the best plugin instance for the given vendor.\n+///\n+/// If multiple instances match, the one with lowest priority wins.\n+#[tracing::instrument(skip_all, fields(vendor, instance_count = instances.len()))]\n+fn choose_plugin_instance(vendor: &str, instances: &[GtsEntity]) -> Result<String, DomainError> {","path":"modules/system/authn-resolver/authn-resolver/src/domain/service.rs","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"refactored","created_at":"2026-02-17T11:45:05Z","updated_at":"2026-02-17T11:45:05Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2816624191","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816624191"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2816624191"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2816624191/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":122,"side":"RIGHT","in_reply_to_id":2815965673,"author_association":"MEMBER","original_position":122,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817087485","pull_request_review_id":3814007727,"id":2817087485,"node_id":"PRRC_kwDOPaLyBs6n6Vf9","diff_hunk":"@@ -0,0 +1,74 @@\n+//! `AuthN` resolver module.\n+\n+use std::sync::{Arc, OnceLock};\n+\n+use async_trait::async_trait;\n+use authn_resolver_sdk::{AuthNResolverClient, AuthNResolverPluginSpecV1};\n+use modkit::Module;\n+use modkit::context::ModuleCtx;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryClient;\n+\n+use crate::config::AuthNResolverConfig;\n+use crate::domain::{AuthNResolverLocalClient, Service};\n+\n+/// `AuthN` Resolver module.\n+///\n+/// This module:\n+/// 1. Registers the plugin schema in types-registry\n+/// 2. Discovers plugin instances via types-registry\n+/// 3. Routes requests to the selected plugin based on vendor configuration\n+///\n+/// Plugin discovery is lazy: happens on first API call after types-registry\n+/// is ready.\n+#[modkit::module(\n+    name = \"authn-resolver\",\n+    deps = [\"types-registry\"],\n+    capabilities = []\n+)]\n+pub(crate) struct AuthNResolver {\n+    service: OnceLock<Arc<Service>>,","path":"modules/system/authn-resolver/authn-resolver/src/module.rs","commit_id":"efa3ffa346090af62be89ff2519231ca07689fae","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`tenant-resolver` uses `OnceLock<Arc<Service>>` too. Suggest migrating all modules to `OnceLock<Arc<Service>>` separately - I've created #639 for this.","created_at":"2026-02-17T13:38:07Z","updated_at":"2026-02-17T13:38:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817087485","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817087485"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817087485"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817087485/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":30,"original_line":30,"side":"RIGHT","in_reply_to_id":2815965700,"author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817462230","pull_request_review_id":3814426469,"id":2817462230,"node_id":"PRRC_kwDOPaLyBs6n7w_W","diff_hunk":"@@ -65,7 +34,7 @@ pub fn register_routes(\n         .operation_id(\"file_parser.get_parser_info\")\n         .summary(\"Get information about available file parsers\")\n         .tag(\"File Parser\")\n-        .require_auth(&Resource::FileParser, &Action::Read)\n+        .authenticated()","path":"modules/file-parser/src/api/rest/routes.rs","commit_id":"efa3ffa346090af62be89ff2519231ca07689fae","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As we previously discussed, API Gateway will perform coarse-grained access check, while the domain module will do fine-grained access check. OpenAPI security will reflect coarse-grained access check, fine-grained permissions should not be exposed in public area.\r\n\r\nCoarse-grained access check is an API Gateway's feature which will be implemented in https://github.com/cyberfabric/cyberfabric-core/issues/630.","created_at":"2026-02-17T14:52:47Z","updated_at":"2026-02-17T14:52:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817462230","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817462230"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817462230"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817462230/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":37,"original_line":37,"side":"RIGHT","in_reply_to_id":2815965710,"author_association":"MEMBER","original_position":47,"position":47,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817476894","pull_request_review_id":3814443282,"id":2817476894,"node_id":"PRRC_kwDOPaLyBs6n70ke","diff_hunk":"@@ -0,0 +1,34 @@\n+#![cfg_attr(coverage_nightly, feature(coverage_attribute))]","path":"modules/system/authn-resolver/plugins/static-authn-plugin/src/lib.rs","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"thanks, fixed","created_at":"2026-02-17T14:55:29Z","updated_at":"2026-02-17T14:55:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817476894","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817476894"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817476894"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817476894/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","in_reply_to_id":2815965742,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817577420","pull_request_review_id":3814563540,"id":2817577420,"node_id":"PRRC_kwDOPaLyBs6n8NHM","diff_hunk":"@@ -152,285 +91,185 @@ impl SecurityContextBuilder {\n     }\n \n     #[must_use]\n-    pub fn add_permission(mut self, permission: Permission) -> Self {\n-        self.permissions.push(permission);\n+    pub fn subject_tenant_id(mut self, subject_tenant_id: Uuid) -> Self {\n+        self.subject_tenant_id = Some(subject_tenant_id);\n+        self\n+    }\n+\n+    #[must_use]\n+    pub fn token_scopes(mut self, scopes: Vec<String>) -> Self {\n+        self.token_scopes = scopes;\n         self\n     }\n \n     #[must_use]\n-    pub fn add_environment_attribute(mut self, key: &str, value: &str) -> Self {\n-        self.environment.push((key.to_owned(), value.to_owned()));\n+    pub fn bearer_token(mut self, token: impl Into<SecretString>) -> Self {\n+        self.bearer_token = Some(token.into());\n         self\n     }\n \n     #[must_use]\n     pub fn build(self) -> SecurityContext {\n         SecurityContext {\n-            tenant_id: self.tenant_id.unwrap_or_default(),\n             subject_id: self.subject_id.unwrap_or_default(),\n             subject_type: self.subject_type,\n-            permissions: self.permissions,\n-            environment: self.environment,\n+            subject_tenant_id: self.subject_tenant_id.unwrap_or_default(),","path":"libs/modkit-security/src/context.rs","commit_id":"af7e853b5a118bc28093277165c5750c144b4bb9","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good point. I've changed the `build()` method making it more error-prone. Now it returns error if `subject_id` or `subject_tenant_id` is missing. There is only legal way to get security context with empty `subject_id`/`subject_tenant_id` is using `SecurityContext::anonymous()` constructor that is clear and observable.","created_at":"2026-02-17T15:14:45Z","updated_at":"2026-02-17T15:15:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817577420","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817577420"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817577420"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817577420/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":116,"side":"RIGHT","in_reply_to_id":2815965706,"author_association":"MEMBER","original_position":203,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817923580","pull_request_review_id":3814978256,"id":2817923580,"node_id":"PRRC_kwDOPaLyBs6n9hn8","diff_hunk":"@@ -0,0 +1,63 @@\n+#![cfg_attr(coverage_nightly, feature(coverage_attribute))]\n+//! `AuthZ` Resolver SDK\n+//!\n+//! This crate provides the public API for the `authz_resolver` module:\n+//!\n+//! - [`AuthZResolverClient`] - Public API trait for consumers\n+//! - [`AuthZResolverPluginClient`] - Plugin API trait for implementations\n+//! - [`EvaluationRequest`], [`EvaluationResponse`] - Evaluation models\n+//! - [`Constraint`], [`Predicate`] - Constraint types\n+//! - [`AuthZResolverError`] - Error types\n+//! - [`AuthZResolverPluginSpecV1`] - GTS schema for plugin discovery\n+//! - [`pep`] - PEP helpers ([`PolicyEnforcer`], [`ResourceType`], compiler)\n+//!\n+//! ## Usage\n+//!\n+//! ```ignore\n+//! use authz_resolver_sdk::{\n+//!     AuthZResolverClient,\n+//!     pep::{AccessRequest, PolicyEnforcer, ResourceType},\n+//! };\n+//!\n+//! const USER: ResourceType = ResourceType {\n+//!     name: \"gts.x.core.users.user.v1~\",\n+//!     supported_properties: &[\"owner_tenant_id\", \"id\"],\n+//! };\n+//!\n+//! // Get the client from ClientHub\n+//! let authz = hub.get::<dyn AuthZResolverClient>()?;\n+//!\n+//! // Create an enforcer (once, during init — serves all resource types)\n+//! let enforcer = PolicyEnforcer::new(authz);\n+//!\n+//! // All CRUD operations return AccessScope (PDP always returns constraints)\n+//! let scope = enforcer.access_scope(&ctx, &USER, \"get\", Some(id)).await?;\n+//!\n+//! // CREATE — also returns AccessScope with constraints from PDP\n+//! let scope = enforcer.access_scope_with(\n+//!     &ctx, &USER, \"create\", None,\n+//!     &AccessRequest::new()\n+//!         .context_tenant_id(target_tenant_id)\n+//!         .resource_property(\"owner_tenant_id\", target_tenant_id),\n+//! ).await?;\n+//! ```\n+\n+pub mod api;\n+pub mod constraints;\n+pub mod error;\n+pub mod gts;\n+pub mod models;\n+pub mod pep;\n+pub mod plugin_api;","path":"modules/system/authz-resolver/authz-resolver-sdk/src/lib.rs","commit_id":"efa3ffa346090af62be89ff2519231ca07689fae","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Discussed, decided to keep `PolicyEnforcer` in `modules/system/authz-resolver/authz-resolver-sdk/src/pep` and consider it's as a part of SDK for now. Moving this to `modkit-*` is not good option - we don't want to make modkit dependent on AuthZ Resolver.","created_at":"2026-02-17T16:27:03Z","updated_at":"2026-02-17T16:27:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817923580","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817923580"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2817923580"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817923580/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":51,"original_line":51,"side":"RIGHT","in_reply_to_id":2815965725,"author_association":"MEMBER","original_position":51,"position":51,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818048064","pull_request_review_id":3815123562,"id":2818048064,"node_id":"PRRC_kwDOPaLyBs6n-ABA","diff_hunk":"@@ -0,0 +1,98 @@\n+//! Static `AuthN` resolver plugin module.\n+\n+use std::sync::{Arc, OnceLock};\n+\n+use async_trait::async_trait;\n+use authn_resolver_sdk::{AuthNResolverPluginClient, AuthNResolverPluginSpecV1};\n+use modkit::Module;\n+use modkit::client_hub::ClientScope;\n+use modkit::context::ModuleCtx;\n+use modkit::gts::BaseModkitPluginV1;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryClient;\n+\n+use crate::config::StaticAuthNPluginConfig;\n+use crate::domain::Service;\n+\n+/// Static `AuthN` resolver plugin module.\n+///\n+/// Provides token-to-identity mapping from configuration.\n+///\n+/// **Plugin registration pattern:**\n+/// - Gateway registers the plugin schema (GTS type definition)\n+/// - This plugin registers its instance (implementation metadata)\n+/// - This plugin registers its scoped client (implementation in `ClientHub`)\n+#[modkit::module(\n+    name = \"static-authn-plugin\",\n+    deps = [\"types-registry\"]\n+)]\n+pub struct StaticAuthNPlugin {\n+    service: OnceLock<Arc<Service>>,\n+}\n+\n+impl Default for StaticAuthNPlugin {\n+    fn default() -> Self {\n+        Self {\n+            service: OnceLock::new(),\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for StaticAuthNPlugin {\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        info!(\"Initializing static_authn_plugin\");\n+\n+        // Load configuration\n+        let cfg: StaticAuthNPluginConfig = ctx.config()?;\n+        if matches!(cfg.mode, crate::config::AuthNMode::AcceptAll) {\n+            tracing::warn!(\n+                \"Static AuthN plugin is running in `accept_all` mode \\u{2014} \\\n+                 all bearer tokens will be accepted with a hardcoded identity. \\\n+                 Do NOT use this mode in production.\"\n+            );\n+        }\n+\n+        info!(\n+            vendor = %cfg.vendor,\n+            priority = cfg.priority,\n+            mode = ?cfg.mode,\n+            token_count = cfg.tokens.len(),\n+            \"Loaded plugin configuration\"\n+        );\n+\n+        // Generate plugin instance ID\n+        let instance_id = AuthNResolverPluginSpecV1::gts_make_instance_id(\n+            \"hyperspot.builtin.static_authn_resolver.plugin.v1\",\n+        );\n+\n+        // Register plugin instance in types-registry\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryClient>()?;\n+        let instance = BaseModkitPluginV1::<AuthNResolverPluginSpecV1> {\n+            id: instance_id.clone(),\n+            vendor: cfg.vendor.clone(),\n+            priority: cfg.priority,\n+            properties: AuthNResolverPluginSpecV1,\n+        };\n+        let instance_json = serde_json::to_value(&instance)?;\n+\n+        let _ = registry.register(vec![instance_json]).await?;","path":"modules/system/authn-resolver/plugins/static-authn-plugin/src/module.rs","commit_id":"8ef1f79b64b681c57de8c8ecbbcdb3561eab4e92","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"changed, it turns out result may contain errors as well, so we need to check it too","created_at":"2026-02-17T16:56:25Z","updated_at":"2026-02-17T16:57:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818048064","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818048064"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818048064"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818048064/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":79,"side":"RIGHT","in_reply_to_id":2815965690,"author_association":"MEMBER","original_position":79,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818242201","pull_request_review_id":3815350443,"id":2818242201,"node_id":"PRRC_kwDOPaLyBs6n-vaZ","diff_hunk":"@@ -107,3 +119,1027 @@ async fn dbprovider_transaction_smoke() {\n         .await","path":"examples/modkit/users-info/users-info/src/domain/service/tests_security_scoping.rs","commit_id":"cb9d452169ffed3f102c65c166ffc109a8358ae8","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"agree, split","created_at":"2026-02-17T17:38:35Z","updated_at":"2026-02-17T17:38:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818242201","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818242201"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818242201"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818242201/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":119,"side":"RIGHT","in_reply_to_id":2815965733,"author_association":"MEMBER","original_position":61,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818339361","pull_request_review_id":3815467284,"id":2818339361,"node_id":"PRRC_kwDOPaLyBs6n_HIh","diff_hunk":"@@ -0,0 +1,169 @@\n+//! Service implementation for the static `AuthZ` resolver plugin.\n+\n+use authz_resolver_sdk::{\n+    Constraint, EvaluationRequest, EvaluationResponse, EvaluationResponseContext, InPredicate,\n+    Predicate,\n+};\n+use modkit_macros::domain_model;\n+use modkit_security::pep_properties;\n+use uuid::Uuid;\n+\n+/// Static `AuthZ` resolver service.\n+///\n+/// In `allow_all` mode:\n+/// - Always returns `decision: true`\n+/// - Returns `in` predicate on `pep_properties::OWNER_TENANT_ID` scoped to the context tenant\n+///   from the request (for all operations including CREATE).\n+#[domain_model]\n+#[derive(Default)]\n+pub struct Service;\n+\n+impl Service {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self\n+    }\n+\n+    /// Evaluate an authorization request.\n+    #[must_use]\n+    #[allow(clippy::unused_self)] // &self reserved for future config/state\n+    pub fn evaluate(&self, request: &EvaluationRequest) -> EvaluationResponse {\n+        // Always scope to context tenant (all CRUD operations get constraints)\n+        let tenant_id = request\n+            .context\n+            .tenant_context\n+            .as_ref()\n+            .and_then(|t| t.root_id)\n+            .or_else(|| {\n+                // Fallback: extract tenant_id from subject properties\n+                request\n+                    .subject\n+                    .properties\n+                    .get(\"tenant_id\")\n+                    .and_then(|v| v.as_str())\n+                    .and_then(|s| Uuid::parse_str(s).ok())\n+            });\n+\n+        let constraints = if let Some(tid) = tenant_id {\n+            if tid == Uuid::default() {","path":"modules/system/authz-resolver/plugins/static-authz-plugin/src/domain/service.rs","commit_id":"fee2ef631afd646ad2d4c2f49a99300fdf215deb","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've changed implementation of static-authz-plugin - now it returns `decision: false` when tenant_id is nil UUID or unresolvable.","created_at":"2026-02-17T17:59:41Z","updated_at":"2026-02-17T17:59:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818339361","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818339361"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818339361"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818339361/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":48,"side":"RIGHT","in_reply_to_id":2815965717,"author_association":"MEMBER","original_position":48,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818833713","pull_request_review_id":3816007989,"id":2818833713,"node_id":"PRRC_kwDOPaLyBs6oA_0x","diff_hunk":"@@ -122,6 +117,30 @@ modules:\n       # Use ephemeral port; OoP modules receive the actual bound address from master host\n       listen_addr: \"uds:///tmp/hyperspot-grpc\"\n \n+  authn-resolver:","path":"config/quickstart.yaml","commit_id":"efa3ffa346090af62be89ff2519231ca07689fae","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've removed \"replaces the legacy auth_disabled flag\" phrase from the static authn plugin's README.md. It was a wrong statement. I think it's worth to consider introduction `authentication_mode` enum parameter instead of boolean `auth_disabled` with values like\r\n- `basic` - basic auth\r\n- `bearer` - resolving security context passing bearer token to AuthN Resolver.\r\n- `none` - without any authentication, security context with the \"default\" subject/tenant will be used\r\n- etc.\r\n\r\nAdditionally, I've added comments in `config/quickstart.yaml` for better clarity.","created_at":"2026-02-17T20:03:10Z","updated_at":"2026-02-17T20:03:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818833713","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818833713"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2818833713"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818833713/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":122,"original_line":120,"side":"RIGHT","in_reply_to_id":2815965693,"author_association":"MEMBER","original_position":16,"position":25,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2820729295","pull_request_review_id":3818158347,"id":2820729295,"node_id":"PRRC_kwDOPaLyBs6oIOnP","diff_hunk":"@@ -156,6 +188,7 @@ impl<R: CitiesRepository> CitiesService<R> {\n         }\n         current.updated_at = OffsetDateTime::now_utc();\n \n+        // repo.update applies scope constraints via WHERE clause (TOCTOU-safe).","path":"examples/modkit/users-info/users-info/src/domain/service/cities.rs","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why are update and delete semantics different? delete performs the query and then checks num of rows affected - so the operation is atomic, while update performs additional pre-check query, so technically it's not atomical","created_at":"2026-02-18T07:15:15Z","updated_at":"2026-02-18T07:15:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2820729295","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2820729295"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2820729295"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2820729295/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":191,"original_line":191,"side":"RIGHT","author_association":"MEMBER","original_position":177,"position":177,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2822377935","pull_request_review_id":3819939916,"id":2822377935,"node_id":"PRRC_kwDOPaLyBs6oOhHP","diff_hunk":"@@ -156,6 +188,7 @@ impl<R: CitiesRepository> CitiesService<R> {\n         }\n         current.updated_at = OffsetDateTime::now_utc();\n \n+        // repo.update applies scope constraints via WHERE clause (TOCTOU-safe).","path":"examples/modkit/users-info/users-info/src/domain/service/cities.rs","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","original_commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e","user":{"login":"aviator5","id":245955115,"node_id":"U_kgDODqj6Kw","avatar_url":"https://avatars.githubusercontent.com/u/245955115?v=4","gravatar_id":"","url":"https://api.github.com/users/aviator5","html_url":"https://github.com/aviator5","followers_url":"https://api.github.com/users/aviator5/followers","following_url":"https://api.github.com/users/aviator5/following{/other_user}","gists_url":"https://api.github.com/users/aviator5/gists{/gist_id}","starred_url":"https://api.github.com/users/aviator5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aviator5/subscriptions","organizations_url":"https://api.github.com/users/aviator5/orgs","repos_url":"https://api.github.com/users/aviator5/repos","events_url":"https://api.github.com/users/aviator5/events{/privacy}","received_events_url":"https://api.github.com/users/aviator5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"hm, probably I miss something, but semantics for both update and delete are the same now: SQL query prefetch -> PDP request -> SQL update/delete.","created_at":"2026-02-18T13:33:38Z","updated_at":"2026-02-18T13:33:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2822377935","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2822377935"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#discussion_r2822377935"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2822377935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":191,"original_line":191,"side":"RIGHT","in_reply_to_id":2820729295,"author_association":"MEMBER","original_position":177,"position":177,"subject_type":"line"}],"source_reviews":[{"id":3812815938,"node_id":"PRR_kwDOPaLyBs7jQvRC","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Missing E2E test for the full authn → authz → secure ORM pipeline.**\n\n`tests_security_scoping.rs` covers PEP→scope→ORM with mock AuthZ. The api-gateway unit tests mock `AuthNResolverClient`. But nothing exercises the full chain:\n\n`HTTP request → api-gateway authn middleware → authn-resolver → plugin → SecurityContext → domain → PolicyEnforcer → authz-resolver → plugin → AccessScope → secure ORM`\n\nTracked in follow-up issues (#630–634)?","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/612#pullrequestreview-3812815938","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/612#pullrequestreview-3812815938"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/612"}},"submitted_at":"2026-02-17T09:50:12Z","commit_id":"9fe5ab22d5b152a47f664785f5347e1fb528442e"}]},{"source_pr_number":609,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/609","source_state":"closed","source_author":"yoskini","target_issue_number":null,"title":"[PR #609] bugfix: fix e2e tests and make all (#567)","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"bugfix/e2e_tests","pr_head_sha":"82969832139e27c9a5544440e8f7e7a50c6be5cc","pr_base_ref":"main","pr_head_owner":"yoskini","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609","id":3280881963,"node_id":"PR_kwDOP
om/repos/cyberfabric/cyberware-rust/pulls/comments/2795211780/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":33,"original_start_line":33,"start_side":"RIGHT","line":57,"original_line":51,"side":"RIGHT","in_reply_to_id":2794572933,"author_association":"MEMBER","original_position":51,"position":57,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795213774","pull_request_review_id":3787063054,"id":2795213774,"node_id":"PRRC_kwDOPaLyBs6mm5PO","diff_hunk":"@@ -0,0 +1,107 @@\n+name: Cache Cleanup\n+\n+on:\n+  schedule:\n+    - cron: \"0 3 * * 0\" # every week Sunday\n+  workflow_dispatch:\n+\n+permissions:\n+  actions: write\n+  contents: read\n+\n+jobs:\n+  cleanup:\n+    name: Prune PR shared caches\n+    runs-on: ubuntu-latest\n+    steps:\n+      - name: Delete old PR caches\n+        uses: actions/github-script@v7\n+        with:\n+          script: |\n+            const owner = context.repo.owner;\n+            const repo = context.repo.repo;\n+\n+            const keyPrefix = 'pr-';\n+            const keepNewestPerKey = 3;\n+            const retentionDays = 7;\n+            const maxDeletes = 200;\n+\n+            const nowMs = Date.now();\n+            const msPerDay = 1000 * 60 * 60 * 24;\n+            const ageDays = (iso) => (nowMs - new Date(iso).getTime()) / msPerDay;\n+\n+            let page = 1;\n+            const perPage = 100;\n+            const allCaches = [];\n+\n+            while (true) {\n+              const res = await github.rest.actions.getActionsCacheList({\n+                owner,\n+                repo,\n+                per_page: perPage,\n+                page,\n+              });\n+\n+              const batch = res.data.actions_caches ?? [];\n+              allCaches.push(...batch);\n+\n+              if (batch.length < perPage) break;\n+              page += 1;\n+              if (page > 50) break;\n+            }","path":".github/workflows/cache_cleanup.yml","commit_id":"c030e75bdbbb2e8b73cac9204fbcaea2b145be92","original_commit_id":"59d884760fd35633138c4d1f03f428f9a7d3a1f9","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"### Question: \n5000 caches is not-realisitic in any case\n\n### Answer:\nYou can handle this kind of “that scale is unrealistic” pushback by adding explicit guidance in `pr_code_suggestions.extra_instructions` to (a) avoid assuming repo-scale constraints, and (b) require a concrete justification + mitigation even when the reviewer thinks the edge case is rare.\n\nAdd something like this to your repo `.pr_agent.toml` (or wiki config):\n\n```toml\n[pr_code_suggestions]\nextra_instructions = \"\"\"\\\nWhen commenting on reliability/scalability concerns:\n- Do not dismiss issues as \"unrealistic\" without evidence. Assume some repos can exceed typical scales.\n- If a limit/cap exists (e.g., pagination hard-stop), require either:\n  (1) a clear warning/log/message that the cap was hit, or\n  (2) configurable pagination limits, or\n  (3) a safe loop/termination condition that still guarantees full coverage.\n- In your writeup, explicitly state: impact, when it manifests, and the minimal low-risk fix.\n- Prefer pragmatic mitigations (configurable caps + visibility) over speculative statements about usage.\n\"\"\"\n```\n\nIf you want this behavior specifically in `/review` (when the bot is used as a reviewer), apply the same idea under:\n\n```toml\n[pr_reviewer]\nextra_instructions = \"\"\"\\\nDo not dismiss edge cases as unrealistic; request evidence or add safeguards (warnings/config knobs) when a workflow has silent caps/limits.\n\"\"\"\n```\n\n#### Relevant Sources:\n\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions-and-best-practices\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/review#extra-instructions\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/additional_configurations#extra-instructions\n","created_at":"2026-02-11T19:56:55Z","updated_at":"2026-02-11T19:56:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/561#discussion_r2795213774","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/561","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795213774"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/561#discussion_r2795213774"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/561"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795213774/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":33,"original_start_line":33,"start_side":"RIGHT","line":57,"original_line":51,"side":"RIGHT","in_reply_to_id":2794572933,"author_association":"NONE","original_position":51,"position":57,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795234481","pull_request_review_id":3787093960,"id":2795234481,"node_id":"PRRC_kwDOPaLyBs6mm-Sx","diff_hunk":"@@ -0,0 +1,107 @@\n+name: Cache Cleanup\n+\n+on:\n+  schedule:\n+    - cron: \"0 3 * * 0\" # every week Sunday\n+  workflow_dispatch:\n+\n+permissions:\n+  actions: write\n+  contents: read\n+\n+jobs:\n+  cleanup:\n+    name: Prune PR shared caches\n+    runs-on: ubuntu-latest\n+    steps:\n+      - name: Delete old PR caches\n+        uses: actions/github-script@v7\n+        with:\n+          script: |\n+            const owner = context.repo.owner;\n+            const repo = context.repo.repo;\n+\n+            const keyPrefix = 'pr-';\n+            const keepNewestPerKey = 3;\n+            const retentionDays = 7;\n+            const maxDeletes = 200;\n+\n+            const nowMs = Date.now();\n+            const msPerDay = 1000 * 60 * 60 * 24;\n+            const ageDays = (iso) => (nowMs - new Date(iso).getTime()) / msPerDay;\n+\n+            let page = 1;\n+            const perPage = 100;\n+            const allCaches = [];\n+\n+            while (true) {","path":".github/workflows/cache_cleanup.yml","commit_id":"c030e75bdbbb2e8b73cac9204fbcaea2b145be92","original_commit_id":"59d884760fd35633138c4d1f03f428f9a7d3a1f9","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's LLM-generated script. I think it's a some protection vs a huge number of caches","created_at":"2026-02-11T20:01:39Z","updated_at":"2026-02-11T20:01:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/561#discussion_r2795234481","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/561","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795234481"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/561#discussion_r2795234481"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/561"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795234481/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":37,"original_line":37,"side":"RIGHT","in_reply_to_id":2794791392,"author_association":"MEMBER","original_position":37,"position":37,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795243228","pull_request_review_id":3787106942,"id":2795243228,"node_id":"PRRC_kwDOPaLyBs6mnAbc","diff_hunk":"@@ -0,0 +1,107 @@\n+name: Cache Cleanup\n+\n+on:\n+  schedule:\n+    - cron: \"0 3 * * 0\" # every week Sunday\n+  workflow_dispatch:\n+\n+permissions:\n+  actions: write\n+  contents: read\n+\n+jobs:\n+  cleanup:\n+    name: Prune PR shared caches\n+    runs-on: ubuntu-latest\n+    steps:\n+      - name: Delete old PR caches\n+        uses: actions/github-script@v7\n+        with:\n+          script: |\n+            const owner = context.repo.owner;\n+            const repo = context.repo.repo;\n+\n+            const keyPrefix = 'pr-';\n+            const keepNewestPerKey = 3;\n+            const retentionDays = 7;\n+            const maxDeletes = 200;\n+\n+            const nowMs = Date.now();\n+            const msPerDay = 1000 * 60 * 60 * 24;\n+            const ageDays = (iso) => (nowMs - new Date(iso).getTime()) / msPerDay;\n+\n+            let page = 1;\n+            const perPage = 100;\n+            const allCaches = [];\n+\n+            while (true) {\n+              const res = await github.rest.actions.getActionsCacheList({\n+                owner,\n+                repo,\n+                per_page: perPage,\n+                page,\n+              });\n+\n+              const batch = res.data.actions_caches ?? [];\n+              allCaches.push(...batch);\n+\n+              if (batch.length < perPage) break;\n+              page += 1;\n+              if (page > 50) break;\n+            }\n+\n+            const prCaches = allCaches.filter((c) => (c.key ?? '').startsWith(keyPrefix));\n+\n+            const groups = new Map();\n+            for (const c of prCaches) {\n+              const key = c.key ?? '';\n+              if (!groups.has(key)) groups.set(key, []);\n+              groups.get(key).push(c);\n+            }\n+\n+            const toDelete = [];\n+\n+            for (const [key, caches] of groups.entries()) {\n+              caches.sort((a, b) => {\n+                const aTs = new Date(a.last_accessed_at ?? a.created_at).getTime();\n+                const bTs = new Date(b.last_accessed_at ?? b.created_at).getTime();\n+                return bTs - aTs;\n+              });\n+\n+              const keep = new Set(caches.slice(0, keepNewestPerKey).map((c) => c.id));\n+\n+              for (const c of caches.slice(keepNewestPerKey)) {\n+                const ts = c.last_accessed_at ?? c.created_at;\n+                if (ts && ageDays(ts) > retentionDays) {\n+                  toDelete.push({\n+                    id: c.id,\n+                    key,\n+                    created_at: c.created_at,\n+                    last_accessed_at: c.last_accessed_at,\n+                    size_in_bytes: c.size_in_bytes,\n+                  });\n+                }\n+              }\n+            }\n+\n+            toDelete.sort((a, b) => {\n+              const aTs = new Date(a.last_accessed_at ?? a.created_at).getTime();\n+              const bTs = new Date(b.last_accessed_at ?? b.created_at).getTime();\n+              return aTs - bTs;\n+            });\n+\n+            const limited = toDelete.slice(0, maxDeletes);\n+\n+            core.info(`Found ${allCaches.length} total caches; ${prCaches.length} pr-* caches.`);\n+            core.info(`Deleting ${limited.length} caches (max ${maxDeletes}) older than ${retentionDays} days, keeping newest ${keepNewestPerKey} per key.`);\n+\n+            for (const c of limited) {\n+              core.info(`Deleting cache id=${c.id} key=${c.key} size=${c.size_in_bytes} created_at=${c.created_at} last_accessed_at=${c.last_accessed_at}`);\n+              await github.rest.actions.deleteActionsCacheById({\n+                owner,\n+                repo,\n+                cache_id: c.id,\n+              });\n+            }","path":".github/workflows/cache_cleanup.yml","commit_id":"c030e75bdbbb2e8b73cac9204fbcaea2b145be92","original_commit_id":"59d884760fd35633138c4d1f03f428f9a7d3a1f9","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://
entBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }\n+\n+        // Apply vendor-specific extra headers.\n+        for (name, value) in &self.extra_headers {\n+            builder = builder.header(name, value);\n+        }\n+\n+        let response = builder\n+            .form(fields.as_slice())\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .send()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- check status, then parse response ------------------------------------\n+        let token_resp: super::types::TokenResponse = response\n+            .error_for_status()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?\n+            .json()\n+            .await\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        // -- validate token_type -------------------------------------------------\n+        if let Some(ref tt) = token_resp.token_type\n+            && !tt.eq_ignore_ascii_case(\"bearer\")\n+        {\n+            return Err(TokenError::UnsupportedTokenType(tt.clone()));\n+        }\n+\n+        // -- compute lifetime ----------------------------------------------------\n+        let lifetime_secs = token_resp\n+            .expires_in\n+            .unwrap_or(self.default_ttl.as_secs())\n+            .max(self.default_ttl.as_secs());\n+\n+        let access_token = AccessToken::new(token_resp.access_token);\n+        let token = self.lifetime_config.create_token(\n+            &access_token,\n+            None::<&IdToken>,\n+            DurationSecs(lifetime_secs),\n+        );\n+\n+        Ok(token)\n+    }\n+}","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"a15960c384e8aec44802f70f5733b4d3416e1d8d","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@MikeFalcon77`, great! Thanks for addressing that.\n\n<!-- <review_comment_addressed> -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T02:34:17Z","updated_at":"2026-02-10T02:34:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785478687","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785478687"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785478687"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785478687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":84,"original_start_line":85,"start_side":"RIGHT","line":177,"original_line":172,"side":"RIGHT","in_reply_to_id":2785440227,"author_association":"CONTRIBUTOR","original_position":172,"position":177,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785512346","pull_request_review_id":3776442126,"id":2785512346,"node_id":"PRRC_kwDOPaLyBs6mB4ua","diff_hunk":"@@ -0,0 +1,273 @@\n+use std::future::Future;\n+use std::pin::Pin;\n+use std::task::{Context, Poll};\n+\n+use http::header::{AUTHORIZATION, HeaderName};\n+use http::{HeaderValue, Request, Response};\n+use tower::{Layer, Service};\n+\n+use super::token::Token;\n+use modkit_http::HttpError;\n+\n+// ── Layer ────────────────────────────────────────────────────────────────────\n+\n+/// Tower layer that injects a bearer token into outbound HTTP requests.\n+///\n+/// Wraps an [`Token`] handle and sets the `Authorization: Bearer <token>`\n+/// header (or a custom header) on every request before forwarding it to the\n+/// inner service.\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthLayer {\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl BearerAuthLayer {\n+    /// Create a layer that injects `Authorization: Bearer <token>`.\n+    #[must_use]\n+    pub fn new(token: Token) -> Self {\n+        Self {\n+            token,\n+            header_name: AUTHORIZATION,\n+        }\n+    }\n+\n+    /// Create a layer that injects `<header_name>: Bearer <token>`.\n+    #[must_use]\n+    pub fn with_header_name(token: Token, header_name: HeaderName) -> Self {\n+        Self { token, header_name }\n+    }\n+}\n+\n+impl<S> Layer<S> for BearerAuthLayer {\n+    type Service = BearerAuthService<S>;\n+\n+    fn layer(&self, inner: S) -> Self::Service {\n+        BearerAuthService {\n+            inner,\n+            token: self.token.clone(),\n+            header_name: self.header_name.clone(),\n+        }\n+    }\n+}\n+\n+// ── Service ──────────────────────────────────────────────────────────────────\n+\n+/// Tower service that injects a bearer token header before forwarding the\n+/// request to the inner service.\n+///\n+/// Created by [`BearerAuthLayer`].\n+#[derive(Clone, Debug)]\n+pub struct BearerAuthService<S> {\n+    inner: S,\n+    token: Token,\n+    header_name: HeaderName,\n+}\n+\n+impl<S, B, ResBody> Service<Request<B>> for BearerAuthService<S>\n+where\n+    S: Service<Request<B>, Response = Response<ResBody>, Error = HttpError>\n+        + Clone\n+        + Send\n+        + 'static,\n+    S::Future: Send,\n+    B: Send + 'static,\n+    ResBody: Send + 'static,\n+{\n+    type Response = Response<ResBody>;\n+    type Error = HttpError;\n+    type Future = Pin<Box<dyn Future<Output = Result<Response<ResBody>, HttpError>> + Send>>;\n+\n+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {\n+        self.inner.poll_ready(cx)\n+    }\n+\n+    fn call(&mut self, mut req: Request<B>) -> Self::Future {\n+        let bearer_value = match self.token.get() {\n+            Ok(secret) => {\n+                let raw = format!(\"Bearer {}\", secret.expose());\n+                match HeaderValue::from_str(&raw) {\n+                    Ok(v) => v,\n+                    Err(e) => return Box::pin(async { Err(HttpError::InvalidHeaderValue(e)) }),\n+                }\n+            }\n+            Err(e) => {\n+                return Box::pin(async { Err(HttpError::Transport(Box::new(e))) });\n+            }\n+        };\n+\n+        req.headers_mut()\n+            .insert(self.header_name.clone(), bearer_value);\n+","path":"libs/modkit-auth/src/oauth2/layer.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"619e6e5b19da655053fe65f9e0ec3e21f6ddef35","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\nfind . -name \"Cargo.toml\" | grep -E \"(modkit-auth|root)\" | head -5\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 101\n\n---\n\n🏁 Script executed:\n\n```shell\ncat Cargo.toml\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 13232\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"http\\s*=\" --type toml\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1762\n\n---\n\n🏁 Script executed:\n\n```shell\ncat libs/modkit-auth/Cargo.toml\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1536\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"set_sensitive\" .\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 54\n\n---\n\n🌐 Web query:\n\n`http crate 1.3 HeaderValue::set_sensitive Rust API`\n\n💡 Result:\n\nIn `http` crate **1.3.x**, `HeaderValue` has:\n\n- `pub fn set_sensitive(&mut self, val: bool)` — mark/unmark a header value as sensitive.\n- `pub fn is_sensitive(&self) -> bool` — query the flag.  \nSensitive values are **masked in `Debug` output**, and the flag can be used by components (e.g., caches / HPACK encoders) to handle the value more carefully. [1]\n\n```rust\nuse http::header::HeaderValue;\n\nlet mut v = HeaderValue::from_static(\"my secret\");\n\nv.set_sensitive(true);\nassert!(v.is_sensitive());\n\nv.set_sensitive(false);\nassert!(!v.is_sensitive());\n```\n\n**API docs:** `http::header::HeaderValue` → “Methods” → `set_sensitive` / `is_sensitive`. [1]\n\nSources: [1] https://docs.rs/http/latest/http/header/struct.HeaderValue.html\n\n---\n\n🏁 Script executed:\n\n```shell\nhead -20 libs/modkit-auth/src/oauth2/layer.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 706\n\n---\n\n\n\n</details>\n\n**Mark injected bearer headers as sensitive to prevent token leakage in logs.**\n\nThe `HeaderValue::set_sensitive(true)` method is available in the `http` crate (version 1.3) and should be used to prevent debug/trace header dumps from exposing bearer tokens. The proposed fix correctly makes `bearer_value` mutable and calls `set_sensitive(true)` before inserting the header.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-        let bearer_value = match self.token.get() {\n+        let mut bearer_value = match self.token.get() {\n             Ok(secret) => {\n                 let raw = format!(\"Bearer {}\", secret.expose());\n                 match HeaderValue::from_str(&raw) {\n                     Ok(v) => v,\n                     Err(e) => return Box::pin(async { Err(HttpError::InvalidHeaderValue(e)) }),\n                 }\n             }\n             Err(e) => {\n                 return Box::pin(async { Err(HttpError::Transport(Box::new(e))) });\n             }\n         };\n \n+        bearer_value.set_sensitive(true);\n         req.headers_mut()\n             .insert(self.header_name.clone(), bearer_value);\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/src/oauth2/layer.rs` around lines 85 - 101, The bearer\nheader inserted in the Layer::call implementation should be marked sensitive to\navoid token leakage: make the created HeaderValue mutable (bearer_value), call\nbearer_value.set_sensitive(true) after constructing it from\nHeaderValue::from_str, and then insert it into the request headers using\nself.header_name.clone(); update the match arm that builds bearer_value (and the\nvariable binding) in the call method so the HeaderValue is mutable and\nset_sensitive(true) is invoked before req.headers_mut().insert(...).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 45e06a1","created_at":"2026-02-10T02:47:10Z","updated_at":"2026-02-10T10:58:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785512346","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785512346"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785512346"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785512346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":81,"original_start_line":85,"start_side":"RIGHT","line":98,"original_line":101,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":101,"position":98,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622417","pull_request_review_id":3776550609,"id":2785622417,"node_id":"PRRC_kwDOPaLyBs6mCTmR","diff_hunk":"@@ -0,0 +1,138 @@\n+## Detailed design\n+\n+### Dependency policy\n+\n+`modkit-auth` depends on `aliri_tokens` without default features and without `oauth2`:\n+\n+```toml\n+aliri_tokens = { version = \"0.3\", default-features = false, features = [\"rand\"] }\n+```\n+\n+`modkit-auth` depends on `modkit-http` for token endpoint HTTP calls. This is acceptable because `modkit-http` is hyper-based and does not pull `reqwest`.\n+\n+### Public API\n+\n+Modules use a long-lived token capability:\n+\n+```rust\n+#[derive(Clone)]\n+pub struct Token {\n+    inner: std::sync::Arc<TokenInner>,\n+}\n+\n+impl Token {\n+    pub async fn get(&self) -> Result<SecretString, TokenError>;\n+    pub async fn invalidate(&self);\n+}\n+```\n+\n+Rules:\n+\n+- modules never see client credentials\n+- modules never store the token string beyond request construction\n+- token is returned only as a transient `SecretString`\n+\n+### Token configuration\n+\n+**Required:**\n+\n+- `token_endpoint` or `issuer_url`\n+- `client_id`, `client_secret`\n+- `scopes` (normalized once, stable order)\n+\n+**Optional:**\n+\n+- extra headers for vendor quirks\n+- client auth method: `Basic` (default) or `form`\n+- refresh policy:\n+    - refresh offset (default 30 minutes)\n+    - jitter max (default 5 minutes)\n+    - minimum refresh period (default 10 seconds)\n+- safe default TTL if `expires_in` is missing\n+- `HttpClientConfig` override for the token endpoint client (defaults to `HttpClientConfig::token_endpoint()`)\n+\n+### Token source (modkit-http based)\n+\n+Implement a custom `AsyncTokenSource` for `aliri_tokens`.\n+\n+The token source holds an `HttpClient` instance built with `HttpClientConfig::token_endpoint()`. This client provides:\n+\n+- retry with exponential backoff and jitter (transport errors, timeout, 429)\n+- concurrency limiting (10 concurrent requests)\n+- 30s request timeout\n+- 1 MB response body limit\n+- OTel tracing (when `otel` feature is enabled)\n+- TLS-only transport (no accidental plaintext token requests)\n+\n+**Responsibilities:**\n+\n+- resolve token endpoint:\n+    - use direct `token_endpoint`, or\n+    - OIDC discovery from `issuer_url` using `/.well-known/openid-configuration`\n+- do client credentials grant:\n+    - `grant_type=client_credentials`\n+    - optional `scope` (space-separated)\n+    - `Basic` auth or form-based auth\n+    - uses `HttpClient::post(url).form(&fields)` for the token request\n+- attach extra headers (if configured) via `RequestBuilder::header()`\n+- parse response via `HttpResponse::json::<TokenResponse>()`:\n+    - `access_token` (required)\n+    - `expires_in` (optional)\n+    - `token_type` (optional)\n+\n+**Behavior rules:**\n+\n+- missing `expires_in` uses a safe default TTL (prevents hot loops)\n+- if `token_type` exists and is not `Bearer`, fail token acquisition\n+- HTTP error handling: `HttpClient` already retries on transport errors, timeouts, and 429; the token source maps non-2xx responses to `TokenError` using `HttpResponse::error_for_status()`\n+- `Retry-After` header parsing uses `modkit_http::response::parse_retry_after()` when available in error context\n+- sanitize errors: never log or include secrets (`client_secret`, token value) in error text\n+\n+### Token watcher\n+\n+Use `aliri_tokens` watcher created from the token source.\n+\n+Watcher responsibilities:\n+\n+- in-memory caching\n+- refresh scheduling\n+- jitter application\n+- error backoff\n+- concurrency control (avoid duplicate refresh under load)\n+- optionally serve current token while refresh is in progress\n+\n+### Invalidate semantics\n+\n+`aliri_tokens` watcher has no explicit \"drop cached token now\" API.\n+\n+Implementation:\n+\n+- store the active watcher behind `ArcSwap` (preferred) or `RwLock<Arc<_>>`\n+- `Token::invalidate()` creates a new watcher (same config) and swaps it in\n+- old watcher is dropped when no longer referenced\n+- next `get()` triggers a new fetch via the token source\n+\n+### Outbound auth layer (tower)\n+\n+Implement a tower layer that injects the `Authorization` header.\n+\n+**Behavior:**\n+\n+- on each request:\n+    - call `Token::get().await`\n+    - set `Authorization: Bearer <token>`\n+    - forward request\n+- configurable header name if a vendor requires a non-standard header\n+\n+**Integration with `HttpClient`:** The auth layer can be composed into the `HttpClient` tower stack at build time. Two options:\n+\n+1. **Builder extension** — add a `.with_bearer_auth(token: Token)` method to `HttpClientBuilder` that inserts the auth layer into the stack (between OTel and retry, so retries re-acquire the token)\n+2. **Standalone wrapping** — the auth layer wraps an existing `HttpClient`'s inner service, producing a new `HttpClient` with auth injected\n+\n+Option 1 is preferred because it integrates naturally with the existing layer ordering and ensures correct retry-after-401 semantics.","path":"libs/modkit-auth/docs/design.md","commit_id":"0ec2170a051416844105f4975506c2722c101a10","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Align auth‑layer placement description with the current stack**\n\nThe doc says the auth layer sits between OTel and retry, but the builder inserts it *inside* retry (between retry and timeout) so each retry re-acquires the token. Please update wording to match the implementation.  \n\n\n<details>\n<summary>✏️ Suggested doc tweak</summary>\n\n```diff\n-1. **Builder extension** — add a `.with_bearer_auth(token: Token)` method to `HttpClientBuilder` that inserts the auth layer into the stack (between OTel and retry, so retries re-acquire the token)\n+1. **Builder extension** — add a `.with_bearer_auth(token: Token)` method to `HttpClientBuilder` that inserts the auth layer into the stack (between retry and timeout, so retries re-acquire the token)\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n**Integration with `HttpClient`:** The auth layer can be composed into the `HttpClient` tower stack at build time. Two options:\n\n1. **Builder extension** — add a `.with_bearer_auth(token: Token)` method to `HttpClientBuilder` that inserts the auth layer into the stack (between retry and timeout, so retries re-acquire the token)\n2. **Standalone wrapping** — the auth layer wraps an existing `HttpClient`'s inner service, producing a new `HttpClient` with auth injected\n\nOption 1 is preferred because it integrates naturally with the existing layer ordering and ensures correct retry-after-401 semantics.\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/design.md` around lines 127 - 132, Update the design\ntext that describes auth-layer placement so it matches the actual builder\nbehavior: change the description that currently says the auth layer sits\n“between OTel and retry” to state that HttpClientBuilder.with_bearer_auth\ninserts the auth layer inside the retry layer (i.e., between retry and timeout),\nso each retry will re-acquire the token; reference the HttpClientBuilder and\nwith_bearer_auth in the prose to make the implementation alignment explicit.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 45e06a1","created_at":"2026-02-10T03:37:47Z","updated_at":"2026-02-10T10:58:29Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622417","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622417"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622417"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":127,"start_side":"RIGHT","line":null,"original_line":132,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":132,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622423","pull_request_review_id":3776550609,"id":2785622423,"node_id":"PRRC_kwDOPaLyBs6mCTmX","diff_hunk":"@@ -0,0 +1,792 @@\n+# Implementation Plan — Outbound OAuth2 Client Credentials\n+\n+Reference: [0002-modkit-auth-client.md](./0002-modkit-auth-client.md)\n+\n+Crate: `libs/modkit-auth`\n+\n+## Existing code to reuse\n+\n+Before starting, review the existing JWKS provider at\n+`libs/modkit-auth/src/providers/jwks.rs`. It is the closest analog to the OAuth2\n+token source and establishes patterns that must be followed:\n+\n+| Concern | JWKS (existing) | OAuth2 (new) |\n+|---------|----------------|--------------|\n+| HTTP client | `HttpClient::builder().timeout().retry(None).build()` | `HttpClientConfig::token_endpoint()` |\n+| Lock-free cache | `Arc<ArcSwap<HashMap<String,DecodingKey>>>` | `ArcSwap<TokenInner>` |\n+| Background refresh | `run_jwks_refresh_task` + `CancellationToken` | `aliri_tokens` watcher |\n+| Backoff | Manual exponential in `calculate_backoff()` | Delegated to `aliri_tokens` |\n+| Error mapping | `map_http_error(HttpError) -> ClaimsError` | Extract shared `map_http_error` or create parallel `map_http_error(HttpError) -> TokenError` |\n+| Test scaffold | `httpmock` + `allow_insecure_http()` | Same pattern |\n+\n+Key reuse points:\n+\n+1. **`map_http_error`** — `jwks.rs:417-473` maps every `HttpError` variant.\n+   Extract it into a shared helper `src/providers/http_error_mapping.rs` or\n+   duplicate the pattern for `TokenError`. Extraction is preferred to keep the\n+   exhaustive match in one place (HttpError is `#[non_exhaustive]`).","path":"libs/modkit-auth/docs/modkit-auth-client-impl.md","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Resolve the shared HTTP error helper path inconsistency.**  \nThe plan mentions `src/providers/http_error_mapping.rs` (Line 25) but later mandates `src/http_error.rs` (Line 59). Please standardize on one path to avoid divergent implementations.  \n\n\n\nAlso applies to: 59-61\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/docs/modkit-auth-client-impl.md` around lines 24 - 27, The\ndocs reference for the shared HTTP error helper is inconsistent—`map_http_error`\nis suggested to be extracted to src/providers/http_error_mapping.rs but\nelsewhere the plan refers to src/http_error.rs; standardize to a single path and\nupdate code and docs accordingly. Pick one canonical module name (e.g.,\nsrc/providers/http_error_mapping.rs) and move or create the helper there (the\nfunction map_http_error and any TokenError mappings), then update all references\nin docs and code to import from that single module (replace any imports/usages\npointing to src/http_error.rs or alternative paths to the chosen module) so the\nexhaustive HttpError mapping is centralized and reused by both map_http_error\nand TokenError handling.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-10T03:37:47Z","updated_at":"2026-02-10T03:37:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622423","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622423"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622423"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622423/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":25,"original_start_line":24,"start_side":"RIGHT","line":28,"original_line":27,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":27,"position":28,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622427","pull_request_review_id":3776550609,"id":2785622427,"node_id":"PRRC_kwDOPaLyBs6mCTmb","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\ncat -n libs/modkit-auth/src/oauth2/source.rs | sed -n '100,130p'\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1713\n\n---\n\n🌐 Web query:\n\n`RFC 6749 Section 2.3.1 client credentials basic authentication encoding requirements percent-encoding`\n\n💡 Result:\n\nRFC 6749 §2.3.1 requires a **two-step encoding** when you put `client_id` / `client_secret` into the HTTP `Authorization: Basic ...` header:\n\n1) **Percent-/form-encode each credential separately** using the `\"application/x-www-form-urlencoded\"` algorithm from **Appendix B** (i.e., UTF-8 encode first, then apply x-www-form-urlencoded escaping; e.g., space → `+`, and many other bytes → `%HH`). The encoded `client_id` becomes the **Basic username**; the encoded `client_secret` becomes the **Basic password**. [1][2]\n\n2) Then apply **HTTP Basic** as defined by RFC 2617: build `username:password` (using those already-form-encoded strings) and Base64-encode it for the `Authorization: Basic ...` header. (This “2-step” intent is explicitly called out as a clarification in RFC 6749 Errata 4749.) [1][3]\n\nSources:  \n[1] RFC 6749 (OAuth 2.0), Section 2.3.1, “Client Password” ([rfc-editor.org](https://www.rfc-editor.org/rfc/rfc6749))  \n[2] RFC 6749, Appendix B, “Use of application/x-www-form-urlencoded Media Type” ([rfc-editor.org](https://www.rfc-editor.org/rfc/rfc6749))  \n[3] RFC 6749 Errata 4749 (clarifies the two-step encoding: form-encode, then RFC 2617 Basic encoding/Base64) ([rfc-editor.org](https://www.rfc-editor.org/errata/eid4749?utm_source=openai))\n\nCitations:\n\n- 1: https://www.rfc-editor.org/rfc/rfc6749\n- 2: https://www.rfc-editor.org/rfc/rfc6749\n- 3: https://www.rfc-editor.org/errata/eid4749?utm_source=openai\n\n---\n\n🌐 Web query:\n\n`Rust http crate HeaderValue set_sensitive method`\n\n💡 Result:\n\n`HeaderValue::set_sensitive(bool)` (from the `http` crate) marks an HTTP header value as containing sensitive data (e.g., credentials). Libraries that use `http` can then handle it more carefully—e.g., avoid caching/storing it, and HTTP/2 HPACK encoders may choose not to compress it. Sensitive values are also masked in `Debug` output. Sensitivity **does not** affect equality/ordering. [1]\n\nExample:\n\n```rust\nuse http::header::{HeaderValue, AUTHORIZATION};\n\nlet mut v = HeaderValue::from_static(\"Bearer secret-token\");\nv.set_sensitive(true);\n\nassert!(v.is_sensitive());\n\n// e.g., insert into headers\n// headers.insert(AUTHORIZATION, v);\n```\n\n**Source:** `http::header::HeaderValue` docs (methods `set_sensitive` / `is_sensitive`). [1]\n\n**References**\n- [1] https://docs.rs/http/latest/http/header/struct.HeaderValue.html\n\n---\n\n🏁 Script executed:\n\n```shell\nhead -50 libs/modkit-auth/src/oauth2/source.rs | cat -n\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2102\n\n---\n\n🏁 Script executed:\n\n```shell\nrg -A 5 \"use.*header|use.*http|use.*url\" libs/modkit-auth/src/oauth2/source.rs | head -40\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 472\n\n---\n\n🏁 Script executed:\n\n```shell\nfd Cargo.toml | xargs cat | grep -A 20 \"\\[dependencies\\]\"\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 36896\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"enum TokenError|struct TokenError\" libs/modkit-auth/\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 130\n\n---\n\n🏁 Script executed:\n\n```shell\nrg -A 20 \"pub enum TokenError\" libs/modkit-auth/src/oauth2/error.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 831\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"impl.*TokenError|TokenError::\" libs/modkit-auth/src/oauth2/ | head -20\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2554\n\n---\n\n🏁 Script executed:\n\n```shell\nfd Cargo.toml libs/modkit-auth | xargs grep -A 30 \"\\[dependencies\\]\"\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 888\n\n---\n\n\n\n</details>\n\n**Percent-encode Basic auth credentials per RFC 6749 and mark the header sensitive**\n\nThe current implementation violates RFC 6749 Section 2.3.1, which requires percent-encoding (form-urlencoded) credentials separately before base64-encoding them. This fails for credentials containing `:`, `+`, `%`, or non-ASCII characters. Additionally, the Authorization header containing credentials should be marked sensitive to prevent accidental leakage in logs or debug output.\n\n<details>\n<summary>🛠️ Suggested fix (RFC 6749 compliance + sensitive header)</summary>\n\n```diff\n-        if self.auth_method == ClientAuthMethod::Basic {\n-            let credentials = Zeroizing::new(format!(\n-                \"{}:{}\",\n-                self.client_id,\n-                self.client_secret.expose()\n-            ));\n-            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n-            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n-            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n-        }\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let encode = |s: &str| -> String {\n+                url::form_urlencoded::byte_serialize(s.as_bytes()).collect()\n+            };\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                encode(&self.client_id),\n+                encode(self.client_secret.expose())\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let mut header_value = http::HeaderValue::from_str(&format!(\"Basic {}\", &*encoded))\n+                .map_err(|e| TokenError::Http(format!(\"OAuth2 token invalid header value: {e}\")))?;\n+            header_value.set_sensitive(true);\n+            builder = builder.header(AUTHORIZATION, header_value);\n+        }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@libs/modkit-auth/src/oauth2/source.rs` around lines 109 - 120, Replace the\ncurrent raw credential concatenation in the Basic branch (where self.auth_method\n== ClientAuthMethod::Basic, client_id, client_secret, Zeroizing, encoded,\nheader_value, builder.header(AUTHORIZATION.as_str(), &header_value)) with RFC\n6749-compliant steps: percent-encode client_id and client_secret separately\nusing an x-www-form-urlencoded encoder, join them with \":\" to form the\ncredential octet string, base64-encode that result, wrap all plaintext in\nZeroizing as before, set the Authorization header to \"Basic <base64>\" and ensure\nthe resulting header is marked sensitive (so it cannot be accidentally logged or\nexposed).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T03:37:47Z","updated_at":"2026-02-10T10:42:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622427","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622427"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2785622427"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2785622427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":108,"original_start_line":109,"start_side":"RIGHT","line":119,"original_line":120,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":120,"position":119,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787192970","pull_request_review_id":3778178136,"id":2787192970,"node_id":"PRRC_kwDOPaLyBs6mITCK","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Percent-encoding — skip. RFC 6749 technically requires it, but Go's SetBasicAuth doesn't do it, most OAuth2 libraries don't, and applying it can break IdPs that don't expect %XX-encoded credentials on the server side. Our Go codebase doesn't encode either, so this maintains parity.","created_at":"2026-02-10T10:42:24Z","updated_at":"2026-02-10T10:42:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787192970","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787192970"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787192970"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787192970/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"start_line":108,"original_start_line":109,"start_side":"RIGHT","line":119,"original_line":120,"side":"RIGHT","in_reply_to_id":2785622427,"author_association":"MEMBER","original_position":120,"position":119,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787196587","pull_request_review_id":3778181667,"id":2787196587,"node_id":"PRRC_kwDOPaLyBs6mIT6r","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@MikeFalcon77`, understood — maintaining practical interoperability and parity with your Go implementation makes sense. Thanks for the context on IdP compatibility concerns and industry practice.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: MikeFalcon77\nRepo: cyberfabric/cyberfabric-core PR: 535\nFile: libs/modkit-auth/src/oauth2/source.rs:109-120\nTimestamp: 2026-02-10T10:43:04.968Z\nLearning: In modkit-auth OAuth2 client credentials flow, the project deliberately skips RFC 6749 Section 2.3.1 percent-encoding (form-urlencoded) for Basic auth credentials before base64-encoding. Rationale: most OAuth2 libraries (including Go's SetBasicAuth) don't encode, applying it can break IdPs that don't expect %XX-encoded credentials, and the project's Go codebase doesn't encode either (maintaining parity).\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-10T10:43:12Z","updated_at":"2026-02-10T10:43:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787196587","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787196587"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787196587"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787196587/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":108,"original_start_line":109,"start_side":"RIGHT","line":119,"original_line":120,"side":"RIGHT","in_reply_to_id":2785622427,"author_association":"CONTRIBUTOR","original_position":120,"position":119,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2787197371","pull_request_review_id":3778182473,"id":2787197371,"node_id":"PRRC_kwDOPaLyBs6mIUG7","diff_hunk":"@@ -0,0 +1,461 @@\n+use std::time::Duration;\n+\n+use aliri_clock::DurationSecs;\n+use aliri_tokens::sources::AsyncTokenSource;\n+use aliri_tokens::{AccessToken, IdToken, TokenLifetimeConfig, TokenWithLifetime};\n+use async_trait::async_trait;\n+use base64::{Engine as _, engine::general_purpose};\n+use http::header::AUTHORIZATION;\n+use url::Url;\n+use zeroize::Zeroizing;\n+\n+use super::config::OAuthClientConfig;\n+use super::error::TokenError;\n+use super::types::ClientAuthMethod;\n+use modkit_utils::SecretString;\n+\n+/// Token source that exchanges client credentials for an access token using\n+/// `modkit-http::HttpClient`.\n+///\n+/// It implements [`aliri_tokens::AsyncTokenSource`] so that\n+/// `aliri_tokens` can drive refresh scheduling, jitter, and backoff.\n+pub struct OAuthTokenSource {\n+    client: modkit_http::HttpClient,\n+    token_endpoint: Url,\n+    client_id: String,\n+    client_secret: SecretString,\n+    /// Pre-joined scopes (space-separated), or `None` when the scope list is\n+    /// empty.\n+    scopes: Option<String>,\n+    auth_method: ClientAuthMethod,\n+    extra_headers: Vec<(String, String)>,\n+    default_ttl: Duration,\n+    lifetime_config: TokenLifetimeConfig,\n+}\n+\n+impl OAuthTokenSource {\n+    /// Build a new token source from the given configuration.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`TokenError::ConfigError`] if `token_endpoint` is `None`.\n+    ///\n+    /// Returns [`TokenError::Http`] if the underlying `HttpClient` fails to\n+    /// build.\n+    pub fn new(config: &OAuthClientConfig) -> Result<Self, TokenError> {\n+        let token_endpoint = config\n+            .token_endpoint\n+            .clone()\n+            .ok_or_else(|| TokenError::ConfigError(\"token_endpoint is required\".into()))?;\n+\n+        let http_config = config\n+            .http_config\n+            .clone()\n+            .unwrap_or_else(modkit_http::HttpClientConfig::token_endpoint);\n+\n+        let client = modkit_http::HttpClientBuilder::with_config(http_config)\n+            .build()\n+            .map_err(|e| {\n+                TokenError::Http(crate::http_error::format_http_error(&e, \"OAuth2 token\"))\n+            })?;\n+\n+        let scopes = if config.scopes.is_empty() {\n+            None\n+        } else {\n+            Some(config.scopes.join(\" \"))\n+        };\n+\n+        Ok(Self {\n+            client,\n+            token_endpoint,\n+            client_id: config.client_id.clone(),\n+            client_secret: config.client_secret.clone(),\n+            scopes,\n+            auth_method: config.auth_method,\n+            extra_headers: config.extra_headers.clone(),\n+            default_ttl: config.default_ttl,\n+            lifetime_config: TokenLifetimeConfig::new(\n+                0.75,\n+                DurationSecs(config.refresh_offset.as_secs()),\n+            ),\n+        })\n+    }\n+}\n+\n+#[async_trait]\n+impl AsyncTokenSource for OAuthTokenSource {\n+    type Error = TokenError;\n+\n+    async fn request_token(&mut self) -> Result<TokenWithLifetime, Self::Error> {\n+        // -- build form fields ---------------------------------------------------\n+        let mut fields: Vec<(&str, &str)> = vec![(\"grant_type\", \"client_credentials\")];\n+\n+        if let Some(ref scope) = self.scopes {\n+            fields.push((\"scope\", scope));\n+        }\n+\n+        // For Form auth, credentials go into the form body.\n+        // Wrap the temporary copy in `Zeroizing` so it is scrubbed on drop.\n+        let secret_expose;\n+        if self.auth_method == ClientAuthMethod::Form {\n+            secret_expose = Zeroizing::new(self.client_secret.expose().to_owned());\n+            fields.push((\"client_id\", &self.client_id));\n+            fields.push((\"client_secret\", &secret_expose));\n+        }\n+\n+        // -- build request -------------------------------------------------------\n+        let mut builder = self.client.post(self.token_endpoint.as_str());\n+\n+        // For Basic auth, credentials go into the Authorization header.\n+        // Wrap intermediates in `Zeroizing` so the plaintext is scrubbed on drop.\n+        if self.auth_method == ClientAuthMethod::Basic {\n+            let credentials = Zeroizing::new(format!(\n+                \"{}:{}\",\n+                self.client_id,\n+                self.client_secret.expose()\n+            ));\n+            let encoded = Zeroizing::new(general_purpose::STANDARD.encode(credentials.as_bytes()));\n+            let header_value = Zeroizing::new(format!(\"Basic {}\", &*encoded));\n+            builder = builder.header(AUTHORIZATION.as_str(), &header_value);\n+        }","path":"libs/modkit-auth/src/oauth2/source.rs","commit_id":"4498f35da206c75bcd6f33785fa0327d9533d6bb","original_commit_id":"e5aa2fe20a4d26f35c175da947b9a72a4e6ca847","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"### Question: \nPercent-encoding — skip. RFC 6749 technically requires it, but Go's SetBasicAuth doesn't do it, most OAuth2 libraries don't, and applying it can break IdPs that don't expect %XX-encoded credentials on the server side. Our Go codebase doesn't encode either, so this maintains parity.\n\n### Answer:\nAdd a repo-level instruction for the `/improve` tool to **avoid RFC-spec-driven percent-encoding changes for OAuth2 Basic client credentials unless there is an explicit failing interoperability/security requirement**, and to prioritize parity with your existing Go implementation.\n\n```toml\n[pr_code_suggestions]\nextra_instructions = \"\"\"\\\nWhen suggesting changes around OAuth2 / Authorization: Basic client authentication:\n- Do NOT suggest percent-encoding / x-www-form-urlencoded encoding of client_id/client_secret for Basic auth unless the PR explicitly targets RFC 6749 strict compliance or there is a demonstrated bug/IdP requirement.\n- Prefer interoperability and parity with our existing Go codebase behavior (no encoding) over strict RFC pedantry.\n- Still feel free to suggest low-risk hardening improvements (e.g., marking Authorization headers as sensitive / avoiding accidental logging) when applicable.\n\"\"\"\n```\n\nIf you want this to apply only to automated runs (not to manual `/improve` requests), embed the instruction in the auto command itself (GitHub App example):\n\n```toml\n[github_app]\npr_commands = [\n  \"\"\"/improve --pr_code_suggestions.extra_instructions='When suggesting OAuth2 Basic auth changes: do not recommend percent-encoding of client_id/client_secret unless explicitly requested for RFC compliance; prefer interoperability and parity with our Go implementation.'\"\"\",\n]\n```\n\n#### Relevant Sources:\n\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions-and-best-practices\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/tools/improve#extra-instructions\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/automations_and_usage#github-app-automatic-tools-when-a-new-pr-is-opened\n> - https://docs.qodo.ai/qodo-documentation/qodo-merge/usage-guide/additional_configurations#extra-instructions\n","created_at":"2026-02-10T10:43:22Z","updated_at":"2026-02-10T10:43:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/535#discussion_r2787197371","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/535
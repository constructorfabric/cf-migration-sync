":263,"watchers":32,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/548"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/548"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/548"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/548/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/548/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/548/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/4cdfe117d80a6262322d39e1b03b869b385191f6"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3880449286","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/548#issuecomment-3880449286","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/548","id":3880449286,"node_id":"IC_kwDOPaLyBs7nSvUG","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.githu
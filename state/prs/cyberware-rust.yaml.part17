yberfabric/cyberfabric-core\n\nLength of output: 1350\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/system/api-gateway/src/module.rs | grep -A 30 \"mime_map.clone()\" | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1586\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/system/api-gateway/src/module.rs | grep -B 30 \"mime_map.clone()\" | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1643\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"MatchedPath\" modules/system/api-gateway/src --type rust -B 3 -A 3\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2365\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/system/api-gateway/src/module.rs | grep -A 80 \"fn build_router\"\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 3875\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"Router::new()\" modules/system/api-gateway/src --type rust -A 30 | head -100\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 7435\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"\\.route\\(\" modules/system/api-gateway/src --type rust -B 2 -A 2 | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2123\n\n---\n\n🏁 Script executed:\n\n```shell\nrg \"register_route\\|add_route\" modules/system/api-gateway/src --type rust -B 3 -A 5\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 54\n\n---\n\n\n\n</details>\n\n**MIME validation is skipped for parameterized routes due to path template mismatch.**\n\nThe `validation_map` is keyed by `OperationSpec.path` templates (e.g., `/users/{id}`), but the middleware performs lookups using `req.uri().path()`, which returns concrete paths (e.g., `/users/123`). For parameterized routes, the lookup fails and validation is silently skipped.\n\nUse `MatchedPath` to retrieve the route template instead:\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n-use axum::extract::Request;\n+use axum::extract::{MatchedPath, Request};\n@@\n-    // Use MatchedPath extension (set by Axum router) for accurate route matching\n-    let path = req.uri().path().to_owned();\n+    let path = req\n+        .extensions()\n+        .get::<MatchedPath>()\n+        .map(|m| m.as_str().to_owned())\n+        .unwrap_or_else(|| req.uri().path().to_owned());\n```\n</details>\n\nThe same issue affects `rate_limit_middleware` in the same file.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/mime_validation.rs` around lines 91\n- 94, The middleware currently looks up validation_map using the concrete\nrequest path (req.uri().path()), which fails for parameterized routes; change\nthe lookup to use the Axum MatchedPath extension (extract MatchedPath from\nreq.extensions() or use axum::extract::MatchedPath::from_request parts) to\nobtain the route template (matching OperationSpec.path like \"/users/{id}\") and\nfall back to req.uri().path() only if MatchedPath is absent; apply the same\nchange in the rate_limit_middleware so both mime validation (where\nvalidation_map is consulted) and rate limit lookups use the route template\ninstead of the concrete path.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-11T07:10:35Z","updated_at":"2026-02-11T07:19:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791746504","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791746504"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791746504"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791746504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":91,"original_start_line":91,"start_side":"RIGHT","line":94,"original_line":94,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":9,"position":9,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791746507","pull_request_review_id":3783191567,"id":2791746507,"node_id":"PRRC_kwDOPaLyBs6mZqvL","diff_hunk":"@@ -87,10 +87,7 @@ impl RateLimiterMap {\n pub async fn rate_limit_middleware(map: RateLimiterMap, mut req: Request, next: Next) -> Response {\n     let method = req.method().clone();\n     // Use MatchedPath extension (set by Axum router) for accurate route matching\n-    let path = req\n-        .extensions()\n-        .get::<axum::extract::MatchedPath>()\n-        .map_or_else(|| req.uri().path().to_owned(), |p| p.as_str().to_owned());\n+    let path = req.uri().path().to_owned();\n     let key = (method, path);\n ","path":"modules/system/api-gateway/src/middleware/rate_limit.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Find the rate_limit.rs file and examine its structure\nfind . -name \"rate_limit.rs\" -type f\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 129\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look for RateLimiterMap definition\nrg \"RateLimiterMap\" --type rust -B 2 -A 5\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 2905\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look for OperationSpec definition\nrg \"struct OperationSpec|pub struct OperationSpec\" --type rust -B 2 -A 10\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1107\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for how RateLimiterMap is populated/initialized\nrg \"RateLimiterMap::\" --type rust -B 2 -A 3\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 630\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Get the full rate_limit.rs file to understand the key generation\nwc -l ./modules/system/api-gateway/src/middleware/rate_limit.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 133\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Read the from_specs implementation\nsed -n '1,150p' ./modules/system/api-gateway/src/middleware/rate_limit.rs | cat -n\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5672\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look at operation_builder.rs to see how OperationSpec.path is constructed\ncat -n ./libs/modkit/src/api/operation_builder.rs | head -200\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 8297\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for actual examples where OperationSpec is created\nrg \"OperationSpec \\{\" --type rust -A 10 | head -100\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 7619\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look for path values being set in tests or examples\nrg 'path.*:.*\"/.*\\{.*\\}' --type rust | head -30\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 273\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check if MatchedPath is used elsewhere in the codebase\nrg \"MatchedPath\" --type rust -B 2 -A 2\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1759\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Verify that Axum's router actually sets MatchedPath when routing\nrg \"axum.*router\" ./modules/system/api-gateway/src/module.rs -B 3 -A 10 | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1043\n\n---\n\n\n\n</details>\n\n**Rate limiting bypassed for parameterized routes due to path key mismatch.**\n\n`RateLimiterMap` is keyed by `OperationSpec.path` templates (e.g., `/users/{id}`), but the middleware performs lookups using `req.uri().path()` which yields concrete paths (e.g., `/users/123`). Since template paths never match concrete paths in the HashMap, all requests to parameterized routes silently bypass rate limiting and in-flight limits. Use `MatchedPath` extension (set by Axum's router) to obtain the matched template and fall back to the raw path only if unavailable.\n\n<details>\n<summary>🔧 Suggested fix (template-aware lookup)</summary>\n\n```diff\n-use axum::{\n-    extract::Request,\n+use axum::{\n+    extract::{MatchedPath, Request},\n     middleware::Next,\n     response::{IntoResponse, Response},\n };\n@@\n-    // Use MatchedPath extension (set by Axum router) for accurate route matching\n-    let path = req.uri().path().to_owned();\n+    let path = req\n+        .extensions()\n+        .get::<MatchedPath>()\n+        .map(|m| m.as_str().to_owned())\n+        .unwrap_or_else(|| req.uri().path().to_owned());\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@modules/system/api-gateway/src/middleware/rate_limit.rs` around lines 88 -\n92, The middleware currently builds the lookup key from req.uri().path(),\ncausing mismatches with RateLimiterMap keys (OperationSpec.path templates like\n/users/{id}); change the key construction in the rate_limit middleware to first\ntry to read the Axum MatchedPath extension (MatchedPath::from_request or\nreq.extensions().get::<MatchedPath>()) and use its template string as the path\ncomponent for the key, falling back to req.uri().path() only if MatchedPath is\nabsent; keep the method as req.method().clone() and ensure the resulting key\n(method, template_path) is used for lookups in RateLimiterMap so parameterized\nroutes correctly hit their rate limits.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-11T07:10:35Z","updated_at":"2026-02-11T07:10:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791746507","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791746507"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791746507"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791746507/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":88,"original_start_line":88,"start_side":"RIGHT"
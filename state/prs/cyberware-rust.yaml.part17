tomatically\r\n  - No manual trigger required\r\n\r\n- ## Context-Aware Code Review\r\n  - Understands cross-file changes\r\n  - Detects architectural inconsistencies\r\n\r\n- ## Actionable Suggestions\r\n  - Concrete code fixes\r\n  - Clear explanations\r\n  - Prioritized feedback\r\n\r\n- ## Security & Reliability Checks\r\n  - Identifies risky patterns\r\n  - Reduces attack surface area","external_url":"https://www.qodo.ai/","html_url":"https://github.com/apps/qodo-code-review","created_at":"2023-11-16T16:18:38Z","updated_at":"2026-05-06T15:53:40Z","permissions":{"actions":"read","checks":"read","contents":"write","discussions":"write","issues":"write","metadata":"read","pull_requests":"write"},"events":["check_run","check_suite","discussion_comment","issue_comment","pull_request","pull_request_review_comment","push"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":531,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/531","source_state":"closed","source_author":"aviator5","target_issue_number":null,"title":"[PR #531] docs: rename HyperSpot to Cyber Fabric in authorization docs and add MFA open question","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"authorization-mfa","pr_head_sha":"aadd4e24ad78bd6cb84a0bb1a112c323a82c2fb6","pr_base_ref":"main","pr_head_owner":"aviator5","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/531","id":3262809139,"node_id":"PR_kwDOPaLyBs7CeoQz","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/531","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/531.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/531.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/531","number":531,"state":"closed","locked":false,"title":"docs: rename HyperSpot to Cyber Fabric in authorization docs and add MFA open question","user":{"login":"a
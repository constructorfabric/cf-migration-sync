handle for prefix path then?","created_at":"2026-02-11T07:19:31Z","updated_at":"2026-02-11T07:19:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791772427","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791772427"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/553#discussion_r2791772427"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/553"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791772427/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"start_line":91,"original_start_line":91,"start_side":"RIGHT","line":94,"original_line":94,"side":"RIGHT","in_reply_to_id":2791746504,"author_association":"MEMBER","original_position":9,"position":9,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2791773166","pull_request_review_id":3783217137,"id":2791773166,"node_id":"PRRC_kwDOPaLyBs6mZxPu","diff_hunk":"@@ -49,10 +49,11 @@ pub async fn license_validation_middleware(\n     next: Next,\n ) -> Response {\n     let method = req.method().clone();\n-    let path = req\n-        .extensions()\n-        .get::<axum::extract::MatchedPath>()\n-        .map_or_else(|| req.uri().path().to_owned(), |p| p.as_str().to_owned());\n+    // Use req.uri().path() rather than MatchedPath because MatchedPath includes\n+    // the nest prefix (e.g. \"/chat\"), while the specs store un-prefixed paths.\n+    // Since this middleware is applied before nesting, req.uri().path() is already\n+    // prefix-stripped by Axum.\n+    let path = req.uri().path().to_owned();","path":"modules/system/api-gateway/src/middleware/license_validation.rs","commit_id":"b602411b9be5245571122ee074d4f134c8cd3225","original_commit_id":"b
cyberware-rust/pulls/comments/2831421913","pull_request_review_id":3830038438,"id":2831421913,"node_id":"PRRC_kwDOPaLyBs6oxBHZ","diff_hunk":"@@ -66,7 +66,15 @@ impl RateLimiterMap {\n                 ),\n                 |r| (r.rps, r.burst, r.in_flight),\n             );\n-            let key = (spec.method.clone(), spec.path.clone());\n+\n+            let prefix = cfg.prefix_path.trim_end_matches('/');\n+            let path = if prefix.is_empty() {\n+                spec.path.clone()\n+            } else {\n+                format!(\"{}{}\", prefix, spec.path)\n+            };","path":"modules/system/api-gateway/src/middleware/rate_limit.rs","commit_id":"6a573c9664af9442130c6c83aaab6d9ba76fd94a","original_commit_id":"1fb3beb12310653dfa95e0b1651c81deb1db0ec0","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Inconsistent prefix normalization compared to other middlewares.**\n\nThis implementation only trims trailing slashes but doesn't ensure a leading slash, unlike `license_validation.rs` and `mime_validation.rs` which use `super::common::prefixed_path`. If `cfg.prefix_path` is `\"chat\"` (without leading slash), rate limiting produces keys like `\"chat/...\"` while other middlewares produce `\"/chat/...\"`, causing key mismatches and rate limits being bypassed.\n\nUse the shared `prefixed_path` helper for consistency:\n\n\n<details>\n<summary>🐛 Proposed fix to use the shared helper</summary>\n\n```diff\n-            let prefix = cfg.prefix_path.trim_end_matches('/');\n-            let path = if prefix.is_empty() {\n-                spec.path.clone()\n-            } else {\n-                format!(\"{}{}\", prefix, spec.path)\n-            };\n+            let path = super::common::prefixed_path(&cfg.prefix_path, &spec.path);\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/api-gateway/src/middleware/rate_limit.rs` around lines 70 -\n75, The rate-limit middleware currently trims only trailing slashes for\ncfg.prefix_path which can omit a leading slash and create mismatched keys;\nreplace that manual normalization with the shared helper by calling\nsuper::common::prefixed_path(cfg.prefix_path.as_str(), &spec.path) (or the\nequivalent function signature) when computing path so it matches\nlicense_validation.rs and mime_validation.rs behavior and produces a\nconsistently prefixed path for rate-limiting keys.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-20T05:15:12Z","updated_at":"2026-02-20T05:15:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/602#discussion_r2831421913","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/602","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831421913"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/602#discussion_r2831421913"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/602"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831421913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":70,"start_side":"RIGHT","line":null,"original_line":75,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":11,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831447247","pull_request_review_id":3830064683,"id":2831447247,"node_id":"PRRC_kwDOPaLyBs6oxHTP","diff_hunk":"@@ -41,6 +45,19 @@ pub struct ApiGatewayConfig {\n     /// If true, routes without explicit security requirement still require authentication (AuthN-only).\n     #[serde(default = \"default_require_auth_by_default\")]\n     pub require_auth_by_default: bool,\n+\n+    #[serde(default = \"default_prefix_path\")]\n+    pub prefix_path: String,\n+}\n+\n+impl Default for ApiGatewayConfig {\n+    fn default() -> Self {\n+        Self {\n+            require_auth_by_default: default_require_auth_by_default(),\n+            prefix_path: default_prefix_path(),\n+            ..Default::default()\n+        }\n+    }\n }","path":"modules/system/api-gateway/src/config.rs","commit_id":"5fc5115db1a3293d32a38c9195f9ecb82993c5d1","original_commit_id":"9269651c574e1ecad3d0c2eaadb8b96e81116b57","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🔴 Critical_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\ncat -n modules/system/api-gateway/src/config.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5544\n\n---\n\n🏁 Script executed:\n\n```shell\nrg -r 'ApiGatewayConfig::default|ApiGatewayConfig\\s*\\{' modules/system/api-gateway/ --type rust -A 3\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 54\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Search for any tests in the api-gateway module\nfd -t f '\\.rs$' modules/system/api-gateway/ | xargs grep -l 'mod test\\|#\\[test\\]' 2>/dev/null | head -5\n\n# Also search for ApiGatewayConfig usage\nrg 'ApiGatewayConfig' modules/system/api-gateway/ -A 2\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 4242\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look at module.rs more carefully to see the actual context\nsed -n '1,100p' modules/system/api-gateway/src/module.rs | cat -n\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 4323\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Look for the test code that was mentioned\ngrep -n 'let mut config = ApiGatewayConfig::default()' modules/system/api-gateway/src/module.rs -B 5 -A 10\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 718\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Double-check the struct definition to confirm it doesn't derive Default\nsed -n '15,51p' modules/system/api-gateway/src/config.rs | cat -n\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1692\n\n---\n\n\n\n</details>\n\n**Infinite recursion in `Default` implementation.**\n\n`ApiGatewayConfig` does not derive `Default`, so the `..Default::default()` on line 58 calls `ApiGatewayConfig::default()` recursively, causing a stack overflow at runtime. There is a test in `module.rs` (line 694) that calls this method, which confirms this code path is meant to be used.\n\nExplicitly initialize all fields instead of using the spread operator:\n\n<details>\n<summary>Required fix</summary>\n\n```diff\n impl Default for ApiGatewayConfig {\n     fn default() -> Self {\n         Self {\n+            bind_addr: String::new(),\n+            enable_docs: false,\n+            cors_enabled: false,\n+            cors: None,\n+            openapi: OpenApiConfig::default(),\n+            defaults: Defaults::default(),\n+            auth_disabled: false,\n             require_auth_by_default: default_require_auth_by_default(),\n             prefix_path: default_prefix_path(),\n-            ..Default::default()\n         }\n     }\n }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/api-gateway/src/config.rs` around lines 53 - 61, The Default\nimpl for ApiGatewayConfig is causing infinite recursion because it uses the\nstruct update syntax with ..Default::default(), which calls\nApiGatewayConfig::default() again; replace that by explicitly initializing every\nfield of ApiGatewayConfig inside impl Default::default (remove the\n..Default::default() spread) and assign each field either its explicit default\nvalue or by calling the appropriate helper default functions (e.g., use\ndefault_require_auth_by_default() and default_prefix_path() for those fields),\nso that ApiGatewayConfig::default returns a fully constructed struct without\ndelegating to Default::default() recursively.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Addressed in commit 73ac29b","created_at":"2026-02-20T05:27:06Z","updated_at":"2026-02-20T06:41:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/602#discussion_r2831447247","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/602","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831447247"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/602#discussion_r2831447247"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/602"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831447247/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":61,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":35,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2831644891","pull_request_review_id":3830276977,"id":2831644891,"node_id":"PRRC_kwDOPaLyBs6ox3jb","diff_hunk":"@@ -41,6 +45,19 @@ pub struct ApiGatewayConfig {\n     /// If true, routes without explicit security requirement still require authentication (AuthN-only).\n     #[serde(default = \"default_require_auth_by_default\")]\n     pub require_auth_by_default: bool,\n+\n+    #[serde(default = \"default_prefix_path\")]\n+    pub prefix_path: String,\n+}\n+\n+impl Default for ApiGatewayConfig {\n+    f
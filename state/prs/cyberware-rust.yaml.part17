i.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833840617","pull_request_review_id":3832739827,"id":2833840617,"node_id":"PRRC_kwDOPaLyBs6o6Pnp","diff_hunk":"@@ -49,7 +49,15 @@ impl Module for AuthZResolver {\n         // Register plugin schema in types-registry\n         let registry = ctx.client_hub().get::<dyn TypesRegistryClient>()?;\n         let schema_str = AuthZResolverPluginSpecV1::gts_schema_with_refs_as_string();\n-        let schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n+        let mut schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n+        // The gts-macros derived schema omits additionalProperties: false on allOf schemas;","path":"modules/system/authz-resolver/authz-resolver/src/module.rs","commit_id":"8005da86a8d08eea5de0ca74e35c1c9d7ae2648a","original_commit_id":"b28abd81374c09dccd7c69225e857fb1ca3357b5","user":{"login":"yoskini","id":20127030,"node_id":"MDQ6VXNlcjIwMTI3MDMw","avatar_url":"https://avatars.githubusercontent.com/u/20127030?v=4","gravatar_id":"","url":"https://api.github.com/users/yoskini","html_url":"https://github.com/yoskini","followers_url":"https://api.github.com/users/yoskini/followers","following_url":"https://api.github.com/users/yoskini/following{/other_user}","gists_url":"https://api.github.com/users/yoskini/gists{/gist_id}","starred_url":"https://api.github.com/users/yoskini/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yoskini/subscriptions","organizations_url":"https://api.github.com/users/yoskini/orgs","repos_url":"https://api.github.com/users/yoskini/repos","events_url":"https://api.github.com/users/yoskini/events{/privacy}","received_events_url":"https://api.github.com/users/yoskini/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"When a child type is annotated with `#[struct_to_gts_schema(base = ParentStruct, ...)]`,\r\nthe generated `gts_schema_with_refs_allof()` produces an `allOf` schema **without**\r\n`\"additionalProperties\": false` at the top level:\r\n\r\n```json\r\n{\r\n  \"$id\": \"gts://parent~child~\",\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"type\": \"object\",\r\n  \"allOf\": [\r\n    { \"$ref\": \"gts://parent~\" },\r\n    { \"type\": \"object\", \"properties\": { ... } }\r\n  ]\r\n}\r\n```\r\n\r\nThe base schema (`parent~`) declares `\"additionalProperties\": false`. The `types-registry` base-compatibility validator treats the absence of this field in the derived schema as a loosening of the constraint and rejects registration with:\r\n\r\nderived schema '...' loosens additionalProperties from false in base '...'\r\n\r\n# Workaround\r\nPatch \"additionalProperties\": false into the schema JSON at registration time in each module that registers a derived plugin schema. To be removed once gts-macros emits the field for allOf schemas.","created_at":"2026-02-20T15:43:33Z","updated_at":"2026-02-20T15:44:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/609#discussion_r2833840617","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833840617"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/609#discussion_r2833840617"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833840617/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":53,"side":"RIGHT","in_reply_to_id":2833713137,"author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833872987","pull_request_review_id":3832780339,"id":2833872987,"node_id":"PRRC_kwDOPaLyBs6o6Xhb","diff_hunk":"@@ -439,7 +437,7 @@ ci: fmt clippy test-no-macros test-macros test-db deny test-users-info-pg lychee\n \n # Make a release build using stable toolchain\n build:\n-\tcargo +stable build --release\n+\tcargo +stable build --release --features users-info-example,static-tenants,static-authz","path":"Makefile","commit_id":"85f900ac85ed072ebc504bdb67b6f12e267d7097","original_commit_id":"b28abd81374c09dccd7c69225e857fb1ca3357b5","user":{"login":"yoskini","id":20127030,"node_id":"MDQ6VXNlcjIwMTI3MDMw","avatar_url":"https://avatars.githubusercontent.com/u/20127030?v=4","gravatar_id":"","url":"https://api.github.com/users/yoskini","html_url":"https://github.com/yoskini","followers_url":"https://api.github.com/users/yoskini/followers","following_url":"https://api.github.com/users/yoskini/following{/other_user}","gists_url":"https://api.github.com/users/yoskini/gists{/gist_id}","starred_url":"https://api.github.com/users/yoskini/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yoskini/subscriptions","organizations_url":"https://api.github.com/users/yoskini/orgs","repos_url":"https://api.github.com/users/yoskini/repos","events_url":"https://api.github.com/users/yoskini/events{/privacy}","received_events_url":"https://api.github.com/users/yoskini/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Target now is explicit.","created_at":"2026-02-20T15:50:35Z","updated_at":"2026-02-20T15:50:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/609#discussion_r2833872987","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833872987"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/609#discussion_r2833872987"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2833872987/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":440,"side":"RIGHT","in_reply_to_id":2833720433,"author_association":"MEMBER","original_position":14,"position":1,"subject_type":"line"}],"source_reviews":[{"id":3797271613,"node_id":"PRR_kwDOPaLyBs7iVcQ9","user":{"login":"copilot-pull-request-reviewer[bot]","id":175728472,"node_id":"BOT_kgDOCnlnWA","avatar_url":"https://avatars.githubusercontent.com/in/946600?v=4","gravatar_id":"","url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D","html_url":"https://github.com/apps/copilot-pull-request-reviewer","followers_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/followers","following_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/repos","events_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/copilot-pull-request-reviewer%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"## Pull request overview\n\nUpdates the E2E test suite and its Docker-based runtime configuration to align with the Types Registry API’s current snake_case JSON/query parameter conventions, and adjusts the E2E container setup to run with an E2E-specific server config.\n\n**Changes:**\n- Updated Types Registry E2E tests to use `gts_id` / `is_schema` (and segment fields like `type_name`, `ver_major`) and to query using `is_schema`.\n- Added a dedicated `config/e2e-docker.yaml` and switched the E2E Docker image to run with it; adjusted docker-compose accordingly.\n- Extended `file-parser` module configuration/service to optionally allow insecure HTTP downloads for E2E/mock usage.\n\n### Reviewed changes\n\nCopilot reviewed 10 out of 11 changed files in this pull request and generated 2 comments.\n\n<details>\n<summary>Show a summary per file</summary>\n\n| File | Description |\r\n| ---- | ----------- |\r\n| testing/e2e/modules/types_registry/test_types_registry_register.py | Adjusts assertions to snake_case entity fields returned by the API. |\r\n| testing/e2e/modules/types_registry/test_types_registry_list.py | Updates query params/response assertions to snake_case; keeps list filtering tests aligned with API DTOs. |\r\n| testing/e2e/modules/types_registry/test_types_registry_get.py | Updates get/segments assertions to snake_case field names. |\r\n| testing/docker/hyperspot.Dockerfile | Copies additional workspace member and switches container to use the new E2E config. |\r\n| testing/docker/docker-compose.yml | Removes API-gateway env overrides now represented in the E2E config file. |\r\n| modules/file-parser/src/module.rs | Wires new config flag through into the service config. |\r\n| modules/file-parser/src/domain/service.rs | Adds `allow_insecure_http` option to the HTTP client builder. |\r\n| modules/file-parser/src/config.rs | Adds `allow_insecure_http` to module config with safe defaults. |\r\n| dylint_lints/Cargo.lock | Updates dependency lock versions for cf-modkit/system SDK crates. |\r\n| config/e2e-docker.yaml | New E2E-focused server configuration used by the Dockerized E2E environment. |\r\n| apps/hyperspot-server/src/registered_modules.rs | Ensures the `types` module crate is linked/registered. |\r\n| Makefile | Updates default E2E feature set and broadens `gts-docs` validation scope. |\n</details>\n\n\n\n\n","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/609#pullrequestreview-3797271613","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609","author_association":"NONE","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/609#pullrequestreview-3797271613"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609"}},"submitted_at":"2026-02-13T13:24:13Z","commit_id":"01b98b60ea2712de68cd3651adbbf88a2b037963"},{"id":3797274126,"node_id":"PRR_kwDOPaLyBs7iVc4O","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 1**\n\n> [!CAUTION]\n> Some comments are outside the diff and can’t be posted inline due to platform limitations.\n> \n> \n> \n> <details>\n> <summary>⚠️ Outside diff range comments (1)</summary><blockquote>\n> \n> <details>\n> <summary>Makefile (1)</summary><blockquote>\n> \n> `440-441`: _⚠️ Potential issue_ | _🟠 Major_\n> \n> **Add `openapi` as a dependency of the `all` target.**\n> \n> The default `all` target should run OpenAPI generation as part of the local build.\n> \n> <details>\n> <summary>💡 Suggested fix</summary>\n> \n> ```diff\n> -all: build check test-sqlite e2e-local\n> +all: build check test-sqlite e2e-local openapi\n> ```\n> </details>\n> Based on learnings: Ensure that the default 'all' target in every Makefile under cyberfabric-core includes a dependency on the 'openapi' target so OpenAPI generation runs as part of the local build. Verify that an openapi target exists and that including it does not introduce unnecessary rebuilds or circular dependencies.\n> \n> </blockquote></details>\n> \n> </blockquote></details>\n\n<details>\n<summary>🤖 Fix all issues with AI agents</summary>\n\n```\nIn `@config/e2e-docker.yaml`:\n- Around line 238-240: The sampler configuration for parent_based_ratio has a\nmismatch between the numeric value and its comment: update either the ratio\nfield or the comment so they agree; specifically, in the parent_based_ratio\nblock adjust ratio (currently ratio: 1.0) to the intended sampling fraction\n(e.g., 0.2 for 20%) or change the comment to reflect 100% sampling, and ensure\nthe keys `parent_based_ratio` and `ratio` remain unchanged.\n```\n\n</details>\n\n<details>\n<summary>🧹 Nitpick comments (5)</summary><blockquote>\n\n<details>\n<summary>testing/e2e/modules/types_registry/test_types_registry_list.py (3)</summary><blockquote>\n\n`88-101`: **Docstring inconsistent with actual query parameter.**\n\nThe docstring on line 90 still references `isSchema=true` but the actual query parameter on line 100 uses `is_schema`. Consider updating the docstring for consistency.\n\n\n\n<details>\n<summary>📝 Suggested docstring update</summary>\n\n```diff\n `@pytest.mark.asyncio`\n async def test_list_entities_filter_by_is_schema_true(base_url, auth_headers):\n     \"\"\"\n-    Test GET /types-registry/v1/entities?isSchema=true\n+    Test GET /types-registry/v1/entities?is_schema=true\n\n-    Verifies filtering entities by isSchema=true (types only).\n+    Verifies filtering entities by is_schema=true (types only).\n     \"\"\"\n```\n</details>\n\n---\n\n`122-136`: **Docstring inconsistent with actual query parameter.**\n\nSame issue as above - docstring references `isSchema=false` but the code uses `is_schema`.\n\n---\n\n`307-330`: **Minor inconsistency in assertion message.**\n\nLine 330 uses `isSchema=True` in the assertion message but the actual field being checked is `is_schema`. Consider updating the message for consistency.\n\n\n\n<details>\n<summary>📝 Suggested fix</summary>\n\n```diff\n-            assert entity[\"is_schema\"] is True, f\"Expected isSchema=True: {entity}\"\n+            assert entity[\"is_schema\"] is True, f\"Expected is_schema=True: {entity}\"\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/file-parser/src/module.rs (1)</summary><blockquote>\n\n`51-75`: **Include `allow_insecure_http` in the config log for visibility.**\n\nThis makes it obvious when the module is running in an insecure mode.\n\n<details>\n<summary>🔎 Suggested update</summary>\n\n```diff\n-        debug!(\n-            \"Loaded file-parser config: max_file_size_mb={}, download_timeout_secs={}\",\n-            cfg.max_file_size_mb, cfg.download_timeout_secs\n-        );\n+        debug!(\n+            \"Loaded file-parser config: max_file_size_mb={}, download_timeout_secs={}, allow_insecure_http={}\",\n+            cfg.max_file_size_mb,\n+            cfg.download_timeout_secs,\n+            cfg.allow_insecure_http\n+        );\n```\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/file-parser/src/domain/service.rs (1)</summary><blockquote>\n\n`80-86`: **Log a warning when insecure HTTP is enabled.**\n\nA warning helps surface risky configuration in logs.\n\n<details>\n<summary>⚠️ Suggested update</summary>\n\n```diff\n-use tracing::{debug, info, instrument};\n+use tracing::{debug, info, instrument, warn};\n\n...\n\n-        if config.allow_insecure_http {\n+        if config.allow_insecure_http {\n+            warn!(\"FileParserService is configured to allow insecure HTTP downloads\");\n             builder = builder.allow_insecure_http();\n         }\n```\n</details>\n\n</blockquote></details>\n\n</blockquote></details>\n\n<!-- This is an auto-generated comment by CodeRabbit for review status -->","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/609#pullrequestreview-3797274126","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/609#pullrequestreview-3797274126"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/609"}},"submitted_at":"2026-02-13T13:24:47Z","commit_id":"3cc673e826a62cc2f5278f5789756fd0d8d54e3c"},{"id":3797306817,"node_id":"PRR_kwDOPaLyBs7iVk3B","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_
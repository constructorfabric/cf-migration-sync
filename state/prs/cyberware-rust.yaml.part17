ollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860686","pull_request_review_id":3772501723,"id":2781860686,"node_id":"PRRC_kwDOPaLyBs6lz9NO","diff_hunk":"@@ -388,14 +462,44 @@ def resolve_upstream_by_alias(tenant_id, alias, req):\n     # Closest tenant wins for routing target\n     selected = matches[0]\n \n-    # Multiple endpoints with common suffix alias require Host header\n+    # Multiple endpoints with common suffix alias require X-OAGW-Target-Host header\n     if len(selected.endpoints) > 1:\n         has_common_suffix = any(\n             ep.host != alias and ep.host.endswith(\".\" + alias)\n             for ep in selected.endpoints\n         )\n-        if has_common_suffix and \"Host\" not in req.headers:\n-            return Response(status=400)  # Missing Host header\n+        if has_common_suffix and \"X-OAGW-Target-Host\" not in req.headers:\n+            return ErrorResponse(\n+                status=400,\n+                type=\"gts.x.core.errors.err.v1~x.oagw.routing.missing_target_host.v1\",\n+                detail=f\"X-OAGW-Target-Host header required. Valid hosts: {[ep.host for ep in selected.endpoints]}\"\n+            )\n+\n+        # Validate X-OAGW-Target-Host header if present\n+        if \"X-OAGW-Target-Host\" in req.headers:\n+            target_host = req.headers[\"X-OAGW-Target-Host\"]\n+\n+            # Format validation: must be valid hostname or IP (no port, path, or special chars)\n+            if not is_valid_hostname_or_ip(target_host):\n+                return ErrorResponse(\n+                    status=400,\n+                    type=\"gts.x.core.errors.err.v1~x.oagw.routing.invalid_target_host.v1\",\n+                    detail=\"X-OAGW-Target-Host must be a valid hostname or IP address\"\n+                )\n+\n+            # Allowlist validation: must match one of the endpoint hosts (case-insensitive)\n+            matched_endpoint = None\n+            for ep in selected.endpoints:\n+                if ep.host.lower() == target_host.lower():\n+                    matched_endpoint = ep\n+                    break\n+\n+            if matched_endpoint is None:\n+                return ErrorResponse(\n+                    status=400,\n+                    type=\"gts.x.core.errors.err.v1~x.oagw.routing.unknown_target_host.v1\",\n+                    detail=f\"X-OAGW-Target-Host '{target_host}' does not match any endpoint. Valid hosts: {[ep.host for ep in selected.endpoints]}\"\n+                )","path":"modules/system/oagw/DESIGN.md","commit_id":"16b8580b4443ce48a8002a2a70c4e14dd026d3a2","original_commit_id":"01e0ad53b85847fcec0a7b350f97a06da9e5aa11","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n1\\. Routing pseudocode incomplete <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\n• Alias-resolution pseudocode validates <b><i>X-OAGW-Target-Host</i></b> only inside the\n  <b><i>len(selected.endpoints) &gt; 1</i></b> block, so single-endpoint upstreams never get validated in this\n  algorithm.\n• Even for multi-endpoint upstreams, <b><i>matched_endpoint</i></b> is computed but never applied to\n  routing/selection, conflicting with scenarios requiring explicit endpoint selection and\n  load-balancing bypass.\n• This is likely to mislead implementers and cause scenario/test failures.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nThe Alias Resolution pseudocode currently (a) scopes header validation under `len(endpoints) > 1`, skipping single-endpoint validation, and (b) computes `matched_endpoint` without applying it, despite scenarios requiring explicit endpoint selection.\n\n## Issue Context\nScenarios under `scenarios/proxy-api/custom-header-routing/` expect the header to be validated for single-endpoint upstreams and to select a specific endpoint for multi-endpoint upstreams.\n\n## Fix Focus Areas\n- modules/system/oagw/DESIGN.md[458-513]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-09T10:34:12Z","updated_at":"2026-02-09T10:34:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2781860686","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860686"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2781860686"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":465,"start_side":"RIGHT","line":null,"original_line":502,"side":"RIGHT","author_association":"NONE","original_position":192,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860692","pull_request_review_id":3772501723,"id":2781860692,"node_id":"PRRC_kwDOPaLyBs6lz9NU","diff_hunk":"@@ -100,6 +101,23 @@ CRUD for upstream configurations. Each upstream defines: server endpoints, proto\n \n CRUD for routes. Routes define matching rules (method, path, query allowlist) mapping requests to upstreams.\n \n+### Enable/Disable Semantics\n+\n+Upstreams and routes support an `enabled` boolean field (default: `true`).\n+\n+**Behavior**:\n+- **Disabled upstream**: All proxy requests to this upstream rejected with gateway error\n+- **Disabled route**: Route excluded from matching; request falls through to next match or returns 404\n+\n+**Hierarchical Inheritance**:\n+- If ancestor tenant disables an upstream, it is disabled for all descendants\n+- Descendant cannot re-enable an ancestor-disabled resource\n+","path":"modules/system/oagw/PRD.md","commit_id":"141f08c649b048bdf4b4c9e7add110efb09054c6","original_commit_id":"01e0ad53b85847fcec0a7b350f97a06da9e5aa11","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n2\\. Disabled upstream mismatch <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\n• PRD/scenarios define “disabled upstream” as a gateway rejection (scenario expects 503), but the\n  DESIGN “Find Upstream by Alias” query filters disabled upstreams out, which implies alias-not-found\n  behavior.\n• Without a single defined HTTP status + Problem <b><i>type</i></b> for disabled upstreams, clients will\n  interpret the same state differently (404 vs 503).\n• Recommend defining a stable error mapping (status + type) and aligning PRD, DESIGN queries, and\n  scenarios.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nThe spec currently conflicts on how a disabled upstream is surfaced at proxy time (explicit gateway error like 503 vs effectively not-found due to `enabled=TRUE` filtering).\n\n## Issue Context\nScenarios and PRD imply operators can temporarily disable an upstream and receive a distinct gateway rejection. DESIGN query examples currently filter disabled upstreams out.\n\n## Fix Focus Areas\n- modules/system/oagw/PRD.md[104-115]\n- modules/system/oagw/DESIGN.md[2524-2546]\n- modules/system/oagw/scenarios/management-api/upstreams/positive-2.11-re-enable-upstream-restores-proxy-traffic.md[65-74]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-09T10:34:12Z","updated_at":"2026-02-09T10:34:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2781860692","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860692"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/527#discussion_r2781860692"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/527"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2781860692/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":148,"original_start_line":104,"start_side":"RIGHT","line":159,"original_line":115,"side":"RIGHT","author_association":"NONE","original_position":23,"position":199,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2782688491","pull_request_review_id":3773352361,"id":2782688491,"node_id":"PRRC_kwDOPaLyBs6l3HTr","diff_hunk":"@@ -388,14 +462,44 @@ def resolve_upstream_by_alias(tenant_id, alias, req):\n     # Closest tenant wins for routing target\n     selected = matches[0]\n \n-    # Multiple endpoints with common suffix alias require Host header\n+    # Multiple endpoints with common suffix alias require X-OAGW-Target-Host header\n     if len(selected.endpoints) > 1:\n         has_common_suffix = any(\n             ep.host != alias and ep.host.endswith(\".\" + alias)\n             for ep in selected.endpoints\n         )\n-        if has_common_suffix and \"Host\" not in req.headers:\n-            return Response(status=400)  # Missing Host header\n+        if has_common_suffix and \"X-OAGW-Target-Host\" not in req.headers:\n+            return ErrorResponse(\n+                status=400,\n+                type=\"gts.x.core.errors.err.v1~x.oagw.routing.missing_target_host.v1\",\n+                detail=f\"X-OAGW-Target-Host header required. Valid hosts: {[ep.host for ep in selected.endpoints]}\"\n+            )\n+\n+        # Validate X-OAGW-Target-Host header if present\n+        if \"X-OAGW-Target-Host\" in req.headers:\n+            target_host = req.headers[\"X-OAGW-Target-Host\"]\n+\n+            # Format validation: must be valid hostname or IP (no port, path, or special chars)\n+            if not is_valid_hostname_or_ip(target_host):\n+                return ErrorResponse(\n+                    status=400,\n+                    type=\"gts.x.core.errors.err.v1~x.oagw.routing.invalid_target_host.v1\",\n+                    detail=\"X-OAGW-Target-Host must be a valid hostname or IP address\"\n+                )\n+\n+            # Allowlist validation: must match one of the endpoint hosts (case-insensitive)\n+            matched_endpoint = None\n+            for ep in selected.endpoints:\n+                if ep.host.lower() == target_host.lower():\n+                    matched_endpoint = ep\n+                    break\n+\n+            if matched_endpoint is None:\n+                return ErrorResponse(\n+                    status=400,\n+                    type=\"gts.x.core.errors.err.v1~x.oagw.routing.unknown_target_host.v1\",\n+                    detail=f\"X-OAGW-Target-Host '{target_host}' does not match any endpoint. Valid hosts: {[ep.host for ep in selected.endpoints]}\"\n+                )","path":"modules/system/oagw/DESIGN.md","commit_id":"16b8580b4443ce48a8002a2a70c4e14dd026d3a2","original_commit_id":"01e0ad53b85847fcec0a7b350f97a06da9e5aa11","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","av
ric/cyberware-rust/pulls/comments/3314021050/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":452,"side":"RIGHT","in_reply_to_id":3312550454,"author_association":"MEMBER","original_position":73,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3314023789","pull_request_review_id":4376267029,"id":3314023789,"node_id":"PRRC_kwDOPaLyBs7Fh_1t","diff_hunk":"@@ -0,0 +1,56 @@\n+//! Centralized constants for OAGW metric label keys and values.\n+//!\n+//! Keeps magic strings out of service code and ensures consistent naming\n+//! across recording sites and dashboards.\n+\n+// ── Label keys (OpenTelemetry attribute names) ───────────────────────────\n+\n+pub mod key {\n+    /// Upstream alias (stable, low-cardinality identifier of the destination service).\n+    pub const HOST: &str = \"host\";\n+    /// Route match pattern (NOT raw request path — cardinality control).\n+    pub const PATH: &str = \"path\";\n+    /// HTTP method.\n+    pub const METHOD: &str = \"method\";\n+    /// HTTP status class (`2xx`, `3xx`, `4xx`, `5xx`).\n+    pub const STATUS_CLASS: &str = \"status_class\";\n+    /// `DomainError` variant name.\n+    pub const ERROR_TYPE: &str = \"error_type\";\n+    /// Pipeline phase for duration histogram (`total`, future: `auth`, `guard`, `upstream`, …).\n+    pub const PHASE: &str = \"phase\";\n+}\n+\n+// ── Label values ─────────────────────────────────────────────────────────\n+\n+/// HTTP status class labels (`status_class` label).\n+pub mod status_class {\n+    pub const C2XX: &str = \"2xx\";","path":"modules/system/oagw/oagw/src/domain/ports/metric_labels.rs","commit_id":"a6312484dc3954077208589a45be88f51173fa11","original_commit_id":"a6312484dc3954077208589a45be88f51173fa11","user":{"login":"asmith987","id":260502008,"node_id":"U_kgDOD4bx-A","avatar_url":"https://avatars.githubusercontent.com/u/260502008?v=4","gravatar_id":"","url":"https://api.github.com/users/asmith987","html_url":"https://github.com/asmith987","followers_url":"https://api.github.com/users/asmith987/followers","following_url":"https://api.github.com/users/asmith987/following{/other_user}","gists_url":"https://api.github.com/users/asmith987/gists{/gist_id}","starred_url":"https://api.github.com/users/asmith987/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/asmith987/subscriptions","organizations_url":"https://api.github.com/users/asmith987/orgs","repos_url":"https://api.github.com/users/asmith987/repos","events_url":"https://api.github.com/users/asmith987/events{/privacy}","received_events_url":"https://api.github.com/users/asmith987/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This should be fixed now. We are using the actual status code now instead of flooring the code into 2XX, 3XX etc.","created_at":"2026-05-27T21:46:28Z","updated_at":"2026-05-27T21:46:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1969#discussion_r3314023789","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1969","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3314023789"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1969#discussion_r3314023789"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1969"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3314023789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":27,"side":"RIGHT","in_reply_to_id":3312542098,"author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":1968,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/1968","source_state":"closed","source_author":"diffora","target_issue_number":null,"title":"[PR #1968] feat(account-management): OData filter/orderby on /users + first/lasе name read-projection","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"am/user-first-name","pr_head_sha":"53c8c86e13b6f34c208d5c88952819df6f44fbef","pr_base_ref":"main","pr_head_owner":"diffora","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1968","id":3735286945,"node_id":"PR_kwDOPaLyBs7eo_Sh","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1968","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/1968.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/1968.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1968","number":1968,"state":"closed","locked":false,"title":"feat(account-management): OData filter/orderby on /users + first/lasе name read-projection","user":{"login":"diffora","id":272209596,"node_id":"U_kgDOEDmWvA","avatar_url":"https://avatars.githubusercontent.com/u/272209596?v=4","gravatar_id":"","url":"https://api.github.com/users/diffora","html_url":"https://github.com/diffora","followers_url":"https://api.github.com/users/diffora/followers","following_url":"https://api.github.com/users/diffora/following{/other_user}","gists_url":"https://api.github.com/users/diffora/gists{/gist_id}","starred_url":"https://api.github.com/users/diffora/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/diffora/subscriptions","organizations_url":"https://api.github.com/users/diffora/orgs","repos_url":"https://api.github.com/users/diffora/repos","events_url":"https://api.github.com/users/diffora/events{/privacy}","received_events_url":"https://api.github.com/users/diffora/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\r\n\r\n- Adds typed OData `$filter` and `$orderby` to `GET /tenants/{id}/users` over `id`, `username`, `email`, `display_name`, `first_name`, `last_name`. Operators: `eq`, `ne`, `in`, plus case-insensitive `contains` / `startswith` / `endswith` on String fields; `and` / `or` / `not` composition.\r\n- Read-projection: `first_name` / `last_name` reach `IdpUser`, `UserDto`, the static-idp store, and the published `gts.cf.core.am.user.v1~` schema. Write-path: `IdpNewUser` / `UserCreateRequestDto` gain `first_name`, `last_name`, and an atomic initial credential bundle (`Debug`-redacted).\r\n- Static-idp plugin honours the typed `FilterNode<IdpUserFilterField>` + `ODataOrderBy`; cursor migrates from decimal offset to `modkit_odata::CursorV1` with order-drift detection.\r\n- Drive-by: bootstrap `CleanFailure` log now redacts the provider detail (matches the `Ambiguous` / `Unavailable` arms).\r\n\r\n## Test plan\r\n\r\n- [x] `cargo fmt --check` (3 touched crates)\r\n- [x] `cargo clippy --all-targets --all-features -- -D warnings -D clippy::perf` (3 crates)\r\n- [x] `cargo dylint --all` (3 crates)\r\n- [x] `cargo test --lib` (60 SDK + 750 AM + 24 plugin = 834 lib tests)\r\n- [x] `cargo test --test api_users_test` (16 HTTP integration tests through the real router)\r\n","created_at":"2026-05-23T14:49:53Z","updated_at":"2026-05-23T16:12:56Z","closed_at":"2026-05-23T16:12:56Z","merged_at":"2026-05-23T16:12:56Z","merge_commit_sha":"cf112b01fd83e758d180587e290fcc3a97661c6f","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1968/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1968/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric
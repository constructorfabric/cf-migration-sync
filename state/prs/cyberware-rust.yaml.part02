@@ -0,0 +1,133 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)\n+    return False\n+\n+\n+def fetch_openapi(url: str, output_path: Path) -> bool:\n+    \"\"\"Fetch OpenAPI spec and save to file.\"\"\"\n+    try:\n+        with urllib.request.urlopen(url, timeout=30) as resp:\n+            content = resp.read()\n+            output_path.parent.mkdir(parents=True, exist_ok=True)\n+            output_path.write_bytes(content)\n+            return True\n+    except (urllib.error.URLError, urllib.error.HTTPError) as e:\n+        print(f\"ERROR: Failed to fetch OpenAPI spec: {e}\")\n+        return False","path":"scripts/openapi.py","commit_id":"c8193b5a50be8f4ee72f73124b09ffdf22c93601","original_commit_id":"6edba5f4a6ef013341ac2d9e80b7f90c843b437a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@dominic1988-lgtm` Thank you for addressing the URL scheme validation! The fix will help prevent potential SSRF attacks by ensuring only HTTP(S) URLs are accepted by the OpenAPI generation script.\n\n<!-- <review_comment_addressed> -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-12T03:16:39Z","updated_at":"2026-02-12T03:16:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796572783","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796572783"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796572783"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796572783/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":18,"start_side":"RIGHT","line":54,"original_line":46,"side":"RIGHT","in_reply_to_id":2796562688,"author_association":"CONTRIBUTOR","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796590861","pull_request_review_id":3788555157,"id":2796590861,"node_id":"PRRC_kwDOPaLyBs6msJcN","diff_hunk":"@@ -0,0 +1,144 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+from urllib.parse import urlparse\n+\n+def _validate_http_url(url: str) -> None:\n+    scheme = urlparse(url).scheme\n+    if scheme not in (\"http\", \"https\"):\n+        raise ValueError(f\"Unsupported URL scheme: {scheme}\")\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    _validate_http_url(url)\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)","path":"scripts/openapi.py","commit_id":"c8193b5a50be8f4ee72f73124b09ffdf22c93601","original_commit_id":"3828716004a735a116a41e6b2f828d06c7d93dac","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, let's find and check the openapi.py file\ngit ls-files scripts/openapi.py\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 90\n\n---\n\n🏁 Script executed:\n\n```shell\n# Read the file to verify the code snippet and understand the full context\ncat -n scripts/openapi.py | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1952\n\n---\n\n\n\n</details>\n\n**Use wall‑clock time to enforce `max_wait` accurately.**\n\n`elapsed` only tracks sleep time, ignoring the request timeout duration. The loop can exceed `max_wait` by the request timeout (5 seconds) or more per iteration. Use `time.monotonic()` to measure actual elapsed time.\n\n<details>\n<summary>💡 Proposed fix</summary>\n\n```diff\n-    elapsed = 0\n+    start = time.monotonic()\n+    elapsed = 0\n     sleep_time = 1\n     while elapsed < max_wait:\n         try:\n             with urllib.request.urlopen(url, timeout=5) as resp:\n                 if resp.status == 200:\n                     return True\n         except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n             pass\n-        print(f\"Waiting for server... ({elapsed}s)\")\n+        elapsed = time.monotonic() - start\n+        print(f\"Waiting for server... ({int(elapsed)}s)\")\n         time.sleep(sleep_time)\n-        elapsed += sleep_time\n+        elapsed = time.monotonic() - start\n         sleep_time = min(sleep_time * 2, 8)\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Ruff (0.15.0)</summary>\n\n[error] 30-30: Audit URL open for permitted schemes. Allowing use of `file:` or custom schemes is often unexpected.\n\n(S310)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@scripts/openapi.py` around lines 23 - 38, The wait_for_server function\ncurrently accumulates only sleep time in elapsed and can exceed max_wait due to\nthe urlopen timeout; change it to use time.monotonic() to measure wall-clock\nelapsed (record start = time.monotonic(), compute elapsed = time.monotonic() -\nstart each loop) and break when elapsed >= max_wait. Also compute a\nremaining_timeout = max(0.0, min(5, max_wait - elapsed)) and pass that to\nurllib.request.urlopen so individual requests never block past the remaining\nallowed time; update the loop condition/prints to use the monotonic-based\nelapsed value and return False if the overall max_wait is reached.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @dominic1988-lgtm\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-12T03:24:55Z","updated_at":"2026-02-12T03:33:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796590861","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796590861"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796590861"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796590861/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":23,"start_side":"RIGHT","line":39,"original_line":38,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":38,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796605266","pull_request_review_id":3788569899,"id":2796605266,"node_id":"PRRC_kwDOPaLyBs6msM9S","diff_hunk":"@@ -0,0 +1,144 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+from urllib.parse import urlparse\n+\n+def _validate_http_url(url: str) -> None:\n+    scheme = urlparse(url).scheme\n+    if scheme not in (\"http\", \"https\"):\n+        raise ValueError(f\"Unsupported URL scheme: {scheme}\")\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    _validate_http_url(url)\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)","path":"scripts/openapi.py","commit_id":"c819
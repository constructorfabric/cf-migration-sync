er ending with ~ that identifies a GTS Type.\n> GTS Type Schema: the canonical definition of a GTS Type — a JSON Schema document annotated with the GTS vocabulary (x-gts-*), describing the type's instance shape, traits, metadata, and relations.\n\nSource: https://github.com/GlobalTypeSystem/gts-spec/blob/main/README.md","created_at":"2026-05-20T11:21:18Z","updated_at":"2026-05-20T11:21:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1953#discussion_r3273476169","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1953","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3273476169"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1953#discussion_r3273476169"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1953"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3273476169/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":18,"original_line":18,"side":"RIGHT","author_association":"MEMBER","original_position":18,"position":18,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3274128843","pull_request_review_id":4328715637,"id":3274128843,"node_id":"PRRC_kwDOPaLyBs7DJz3L","diff_hunk":"@@ -34,12 +34,26 @@\n /// errors (e.g. `tenant {id} not found` → 404).\n pub const TENANT_RESOURCE_TYPE: &str = \"gts.cf.core.am.tenant.v1~\";\n \n-/// AM `TenantMetadata` resource. Used for canonical errors raised\n-/// by the metadata feature (e.g. `MetadataSchemaNotRegistered`,\n-/// `MetadataEntryNotFound`) and for the future PEP gate on\n-/// metadata reads / writes.\n+/// AM `TenantMetadata` resource. Used for canonical errors raised by\n+/// the metadata-entry surface (e.g. `MetadataEntryNotFound`,\n+/// `MetadataValidation`) and for the future PEP gate on metadata\n+/// reads / writes.\n pub const TENANT_METADATA_RESOURCE_TYPE: &str = \"gts.cf.core.am.tenant_metadata.v1~\";\n \n+/// AM `TenantMetadataSchema` resource. Distinct from\n+/// [`TENANT_METADATA_RESOURCE_TYPE`] so clients reading the canonical\n+/// envelope can branch on `resource_type` to distinguish\n+/// `MetadataSchemaNotRegistered` (schema-level 404, the chained\n+/// `schema_id` was never registered in the types registry) from\n+/// `MetadataEntryNotFound` (entry-level 404, the registered schema\n+/// exists but the tenant has no row at that schema).\n+///\n+/// Per `dod-tenant-metadata-distinct-404-codes` clients MUST be able\n+/// to branch deterministically on the wire; using a distinct\n+/// `resource_type` per variant (rather than only the `detail` prose)\n+/// makes the distinction structural.\n+pub const TENANT_METADATA_SCHEMA_RESOURCE_TYPE: &str = \"gts.cf.core.am.tenant_metadata_schema.v1~\";","path":"modules/system/account-management/account-management-sdk/src/gts.rs","commit_id":"12935a4007d42e77ce50fb462a638600e8f5b7c5","original_commit_id":"12935a4007d42e77ce50fb462a638600e8f5b7c5","user":{"login":"diffora","id":272209596,"node_id":"U_kgDOEDmWvA","avatar_url":"https://avatars.githubusercontent.com/u/272209596?v=4","gravatar_id":"","url":"https://api.github.com/users/diffora","html_url":"https://github.com/diffora","followers_url":"https://api.github.com/users/diffora/followers","following_url":"https://api.github.com/users/diffora/following{/other_user}","gists_url":"https://api.github.com/users/diffora/gists{/gist_id}","starred_url":"https://api.github.com/users/diffora/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/diffora/subscriptions","organizations_url":"https://api.github.com/users/diffora/orgs","repos_url":"https://api.github.com/users/diffora/repos","events_url":"https://api.github.com/users/diffora/events{/privacy}","received_events_url":"https://api.github.com/
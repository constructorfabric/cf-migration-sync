18","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796531518"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796531518"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796531518/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":231,"original_line":231,"side":"RIGHT","in_reply_to_id":2796519448,"author_association":"CONTRIBUTOR","original_position":156,"position":145,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796536789","pull_request_review_id":3788503650,"id":2796536789,"node_id":"PRRC_kwDOPaLyBs6mr8PV","diff_hunk":"@@ -247,14 +260,15 @@ security: deny\n # -------- API and docs --------\n \n .PHONY: openapi\n-\n # Generate OpenAPI spec from running hyperspot-server\n openapi:\n+\t@echo \"Generating OpenAPI specs...\"\n \t@command -v curl >/dev/null || (echo \"curl is required to generate OpenAPI spec\" && exit 1)\n+\t@echo \"Building hyperspot-server...\"\n+\tcargo build --bin hyperspot-server --features users-info-example\n \t@echo \"Starting hyperspot-server to generate OpenAPI spec...\"\n-\t# Run server in background\n-\tcargo run --bin hyperspot-server --features users-info-example -- --config config/quickstart.yaml &\n-\t@SERVER_PID=$$!; \\\n+\t./target/debug/hyperspot-server --config $(QUICKSTART_CONFIG) & \\","path":"Makefile","commit_id":"a075606a1174a8f967dabdbefe206f5c21343ea7","original_commit_id":"a075606a1174a8f967dabdbefe206f5c21343ea7","user":{"login":"dominic1988-lgtm","id":206866400,"node_id":"U_kgDODFSH4A","avatar_url":"https://avatars.githubusercontent.com/u/206866400?v=4","gravatar_id":"","url":"https://api.github.com/users/dominic1988-lgtm","html_url":"https://github.com/dominic1988-lgtm","followers_url":"https://api.github.com/users/dominic1988-lgtm/followers","following_url":"https://api.github.com/users/dominic1988-lgtm/following{/other_user}","gists_url":"https://api.github.com/users/dominic1988-lgtm/gists{/gist_id}","starred_url":"https://api.github.com/users/dominic1988-lgtm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dominic1988-lgtm/subscriptions","organizations_url":"https://api.github.com/users/dominic1988-lgtm/orgs","repos_url":"https://api.github.com/users/dominic1988-lgtm/repos","events_url":"https://api.github.com/users/dominic1988-lgtm/events{/privacy}","received_events_url":"https://api.github.com/users/dominic1988-lgtm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Updated","created_at":"2026-02-12T02:58:51Z","updated_at":"2026-02-12T02:58:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796536789","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796536789"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796536789"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796536789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":270,"side":"RIGHT","in_reply_to_id":2786063836,"author_association":"MEMBER","original_position":35,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562688","pull_request_review_id":3788527491,"id":2796562688,"node_id":"PRRC_kwDOPaLyBs6msCkA","diff_hunk":"@@ -0,0 +1,133 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)\n+    return False\n+\n+\n+def fetch_openapi(url: str, output_path: Path) -> bool:\n+    \"\"\"Fetch OpenAPI spec and save to file.\"\"\"\n+    try:\n+        with urllib.request.urlopen(url, timeout=30) as resp:\n+            content = resp.read()\n+            output_path.parent.mkdir(parents=True, exist_ok=True)\n+            output_path.write_bytes(content)\n+            return True\n+    except (urllib.error.URLError, urllib.error.HTTPError) as e:\n+        print(f\"ERROR: Failed to fetch OpenAPI spec: {e}\")\n+        return False","path":"scripts/openapi.py","commit_id":"c8193b5a50be8f4ee72f73124b09ffdf22c93601","original_commit_id":"6edba5f4a6ef013341ac2d9e80b7f90c843b437a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n# First, let's examine the full content of scripts/openapi.py\ncat -n scripts/openapi.py\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5552\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there are any command-line argument handling for URLs\nrg \"argparse|argumen|--url|Makefile\" scripts/openapi.py -A 2 -B 2\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 885\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for any other urlopen usages in the codebase\nrg \"urlopen\" --type python -B 3 -A 3\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 102\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there's a Makefile that might override URLs\nfd Makefile -x cat {}\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 15142\n\n---\n\n🌐 Web query:\n\n`urllib.request.urlopen file:// scheme vulnerability python security`\n\n💡 Result:\n\n`urllib.request.urlopen()` will happily handle more than `http(s)://` URLs by default—including `file:` via `FileHandler`—so if you pass it attacker-controlled input (classic SSRF), an attacker may be able to make your server open local files (e.g., `file:///etc/passwd`) instead of fetching a web URL. Python’s docs show the default opener includes `FileHandler` (and `FTPHandler`, etc.). [1]\n\n### The “file:// scheme vulnerability” people usually mean\nIt’s typically **not that `file://` support is itself a bug**, but that applications **intended to fetch only web URLs** sometimes implement weak scheme filtering (e.g., “block `file:`”) and then call `urlopen()` anyway.\n\nA notable historical issue is **CVE-2019-9948 (Python 2.x through 2.7.16)**: `urllib` supported an extra scheme `local_file:` that could **bypass naive blocklists that only reject `file:`**, enabling local file reads (e.g., `urllib.urlopen('local_file:///etc/passwd')`). [2][3] A fix was made so urllib rejects `local_file://`. [3]\n\n### Relevant behavior detail (Python 3)\n`FileHandler.file_open()` is for local file access; Python docs note it opens files locally (and since Python 3.2, remote hostnames in a `file://` URL raise `URLError`). [4]\n\n### Practical mitigations\n- **Never call `urlopen()` on untrusted / user-supplied URLs** without strict validation.\n- Use an **allowlist**: permit only `http` and `https` (reject everything else after trimming whitespace and normalizing case).\n- If you must use `urllib`, consider installing a **custom opener** that does **not** include `FileHandler`/`FTPHandler` when you only want web fetches. (Default opener includes `FileHandler`.) [1]\n- If you still run **Python 2.7.16 or earlier**, upgrade (CVE-2019-9948 applies). [2][3]\n\n**Sources**: Python `urllib.request` docs (default handlers list), NVD CVE-2019-9948, Python issue tracker discussion/fix for `local_file://`, Python docs for `FileHandler.file_open()` behavior. [1][2][3][4]\n\n---\n\n🏁 Script executed:\n\n```shell\n# Let's also verify by examining Python's urllib behavior with a quick test\npython3 << 'EOF'\nimport urllib.request\nfrom urllib.parse import urlparse\n\n# Test what schemes urlopen accepts\ntest_urls = [\n    \"file:///etc/passwd\",\n    \"http://127.0.0.1:8087\",\n    \"https://example.com\",\n    \"custom://scheme\",\n]\n\nfor url in test_urls:\n    scheme = urlparse(url).scheme\n    print(f\"URL: {url} -> Scheme: '{scheme}'\")\n\n# Demonstrate the vulnerability - file:// would be accepted by urlopen\nprint(\"\\n--- Vulnerability Demo ---\")\nprint(\"urllib.request.urlopen('file:///etc/passwd') WOULD attempt to read local file\")\nprint(\"This is a local file inclusion vulnerability if URL is user-controlled\")\nEOF\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 420\n\n---\n\n\n\n</details>\n\n**Add URL scheme validation to restrict OpenAPI requests to http/https.**\n\nThe `wait_for_server()` and `fetch_openapi()` functions accept user-controlled URLs (via `--url` argument and Makefile `OPENAPI_URL` variable). Python's `urllib.request.urlopen()` accepts `file://` and other schemes by default, allowing a user to pass `file:///etc/passwd` to read local files instead of fetching from the server. Add an explicit allowlist check.\n\n<details>\n<summary>🔒 Proposed fix</summary>\n\n```diff\n import urllib.request\n import urllib.error\n+from urllib.parse import urlparse\n@@\n+def _validate_http_url(url: str) -> None:\n+    scheme = urlparse(url).scheme\n+    if scheme not in (\"http\", \"https\"):\n+        raise ValueError(f\"Unsupported URL scheme: {scheme}\")\n+\n def wait_for_server(url: str, max_wait: int = 300) -> bool:\n     \"\"\"Wait for the server to become ready.\"\"\"\n+    _validate_http_url(url)\n@@\n def fetch_openapi(url: str, output_path: Path) -> bool:\n     \"\"\"Fetch OpenAPI spec and save to file.\"\"\"\n+    _validate_http_url(url)\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Ruff (0.15.0)</summary>\n\n[error] 24-24: Audit URL open for permitted schemes. Allowing use of `file:` or custom schemes is often unexpected.\n\n(S310)\n\n---\n\n[error] 39-39: Audit URL open for permitted schemes. Allowing use of `file:` or custom schemes is often unexpected.\n\n(S310)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@scripts/openapi.py` around lines 18 - 46, Both wait_for_server() and\nfetch_openapi() currently pass user-controlled URLs directly to\nurllib.request.urlopen(), which allows unsafe schemes like file://; add an\nallowlist check at the start of each function by parsing the URL\n(urllib.parse.urlparse) and ensuring parsed.scheme is either \"http\" or \"https\";\nif not, log/print a clear error and return False (or raise ValueError\nconsistently) before calling urlopen so only HTTP(S) requests are allowed.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @dominic1988-lgtm\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-12T03:11:07Z","updated_at":"2026-02-12T03:16:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796562688","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562688"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796562688"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562688/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":18,"start_side":"RIGHT","line":54,"original_line":46,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562694","pull_request_review_id":3788527491,"id":2796562694,"node_id":"PRRC_kwDOPaLyBs6msCkG","diff_hunk":"@@ -0,0 +1,133 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)\n+    return False\n+\n+\n+def fetch_openapi(url: str, output_path: Path) -> bool:\n+    \"\"\"Fetch OpenAPI spec and save to file.\"\"\"\n+    try:\n+        with urllib.request.urlopen(url, timeout=30) as resp:\n+            content = resp.read()\n+            output_path.parent.mkdir(parents=True, exist_ok=True)\n+            output_path.write_bytes(content)\n+            return True\n+    except (urllib.error.URLError, urllib.error.HTTPError) as e:\n+        print(f\"ERROR: Failed to fetch OpenAPI spec: {e}\")\n+        return False\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=\"Generate OpenAPI spec from hyperspot-server\")\n+    parser.add_argument(\"--url\", default=\"http://127.0.0.1:8087/openapi.json\",\n+                        help=\"OpenAPI endpoint URL\")\n+    parser.add_argument(\"--output\", default=\"docs/api/api.json\",\n+                        help=\"Output file path\")\n+    parser.add_argument(\"--config\", required=True,\n+                        help=\"Server config file path\")\n+    parser.add_argument(\"--server-bin\", default=\"target/debug/hyperspot-server\",\n+                        help=\"Path to hyperspot-server binary\")\n+    parser.add_argument(\"--max-wait\", type=int, default=300,\n+                        help=\"Maximum seconds to wait for server\")\n+    args = parser.parse_args()\n+\n+    # Determine binary path (add .exe on Windows)\n+    server_bin = args.server_bin\n+    if sys.platform == \"win32\" and not server_bin.endswith(\".exe\"):\n+        server_bin += \".exe\"\n+\n+    if not Path(server_bin).exists():\n+        print(f\"ERROR: Server binary not found: {server_bin}\")\n+        print(\"Run 'cargo build --bin hyperspot-server --features users-info-example' first\")\n+        sys.exit(1)","path":"scripts/openapi.py","commit_id":"c8193b5a50be8f4ee72f73124b09ffdf22c93601","original_commit_id":"6edba5f4a6ef013341ac2d9e80b7f90c843b437a","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\ncat -n scripts/openapi.py\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5552\n\n---\n\n\n\n</details>\n\n**Add early validation for the config file path to fail fast.**\n\nIf `--config` points to a non-existent file, the server startup fails silently (stderr is redirected to DEVNULL), causing the script to wait up to 300 seconds before timing out with an unclear error. A pre-check immediately before starting the server provides clear feedback.\n\n<details>\n<summary>Suggested check</summary>\n\n```diff\n     args = parser.parse_args()\n \n+    if not Path(args.config).exists():\n+        print(f\"ERROR: Server config not found: {args.config}\")\n+        sys.exit(1)\n+\n     # Determine binary path (add .exe on Windows)\n     server_bin = args.server_bin\n     if sys.platform == \"win32\" and not server_bin.endswith(\".exe\"):\n         server_bin += \".exe\"\n \n     if not Path(server_bin).exists():\n         print(f\"ERROR: Server binary not found: {server_bin}\")\n         print(\"Run 'cargo build --bin hyperspot-server --features users-info-example' first\")\n         sys.exit(1)\n```\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@scripts/openapi.py` around lines 55 - 71, Add an early existence check for\nthe config file provided via the --config argument: after args =\nparser.parse_args() validate Path(args.config).exists() (similar to the\nserver_bin check) and if missing print a clear error and sys.exit(1). Update any\nreferences to the config path variable (args.config) and ensure this check runs\nbefore the server startup logic that currently redirects stderr to DEVNULL so\nthe script fails fast with a helpful message.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @dominic1988-lgtm\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-12T03:11:07Z","updated_at":"2026-02-12T03:14:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796562694","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562694"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796562694"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796562694/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":63,"original_start_line":55,"start_side":"RIGHT","line":83,"original_line":71,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":71,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796567893","pull_request_review_id":3788532480,"id":2796567893,"node_id":"PRRC_kwDOPaLyBs6msD1V","diff_hunk":"@@ -0,0 +1,133 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Generate OpenAPI spec by starting hyperspot-server, fetching the spec, and stopping the server.\n+Cross-platform compatible (Windows/Linux/macOS).\n+\"\"\"\n+\n+import argparse\n+import os\n+import signal\n+import subprocess\n+import sys\n+import time\n+import urllib.request\n+import urllib.error\n+from pathlib import Path\n+\n+\n+def wait_for_server(url: str, max_wait: int = 300) -> bool:\n+    \"\"\"Wait for the server to become ready.\"\"\"\n+    elapsed = 0\n+    sleep_time = 1\n+    while elapsed < max_wait:\n+        try:\n+            with urllib.request.urlopen(url, timeout=5) as resp:\n+                if resp.status == 200:\n+                    return True\n+        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):\n+            pass\n+        print(f\"Waiting for server... ({elapsed}s)\")\n+        time.sleep(sleep_time)\n+        elapsed += sleep_time\n+        sleep_time = min(sleep_time * 2, 8)\n+    return False\n+\n+\n+def fetch_openapi(url: str, output_path: Path) -> bool:\n+    \"\"\"Fetch OpenAPI spec and save to file.\"\"\"\n+    try:\n+        with urllib.request.urlopen(url, timeout=30) as resp:\n+            content = resp.read()\n+            output_path.parent.mkdir(parents=True, exist_ok=True)\n+            output_path.write_bytes(content)\n+            return True\n+    except (urllib.error.URLError, urllib.error.HTTPError) as e:\n+        print(f\"ERROR: Failed to fetch OpenAPI spec: {e}\")\n+        return False\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=\"Generate OpenAPI spec from hyperspot-server\")\n+    parser.add_argument(\"--url\", default=\"http://127.0.0.1:8087/openapi.json\",\n+                        help=\"OpenAPI endpoint URL\")\n+    parser.add_argument(\"--output\", default=\"docs/api/api.json\",\n+                        help=\"Output file path\")\n+    parser.add_argument(\"--config\", required=True,\n+                        help=\"Server config file path\")\n+    parser.add_argument(\"--server-bin\", default=\"target/debug/hyperspot-server\",\n+                        help=\"Path to hyperspot-server binary\")\n+    parser.add_argument(\"--max-wait\", type=int, default=300,\n+                        help=\"Maximum seconds to wait for server\")\n+    args = parser.parse_args()\n+\n+    # Determine binary path (add .exe on Windows)\n+    server_bin = args.server_bin\n+    if sys.platform == \"win32\" and not server_bin.endswith(\".exe\"):\n+        server_bin += \".exe\"\n+\n+    if not Path(server_bin).exists():\n+        print(f\"ERROR: Server binary not found: {server_bin}\")\n+        print(\"Run 'cargo build --bin hyperspot-server --features users-info-example' first\")\n+        sys.exit(1)","path":"scripts/openapi.py","commit_id":"c8193b5a50be8f4ee72f73124b09ffdf22c93601","original_commit_id":"6edba5f4a6ef013341ac2d9e80b7f90c843b437a","user":{"login":"dominic1988-lgtm","id":206866400,"node_id":"U_kgDODFSH4A","avatar_url":"https://avatars.githubusercontent.com/u/206866400?v=4","gravatar_id":"","url":"https://api.github.com/users/dominic1988-lgtm","html_url":"https://github.com/dominic1988-lgtm","followers_url":"https://api.github.com/users/dominic1988-lgtm/followers","following_url":"https://api.github.com/users/dominic1988-lgtm/following{/other_user}","gists_url":"https://api.github.com/users/dominic1988-lgtm/gists{/gist_id}","starred_url":"https://api.github.com/users/dominic1988-lgtm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dominic1988-lgtm/subscriptions","organizations_url":"https://api.github.com/users/dominic1988-lgtm/orgs","repos_url":"https://api.github.com/users/dominic1988-lgtm/repos","events_url":"https://api.github.com/users/dominic1988-lgtm/events{/privacy}","received_events_url":"https://api.github.com/users/dominic1988-lgtm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Updated","created_at":"2026-02-12T03:13:52Z","updated_at":"2026-02-12T03:13:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796567893","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2796567893"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/519#discussion_r2796567893"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/519"}},"rea
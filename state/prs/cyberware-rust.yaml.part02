(alias)) = (\n+            event.secondary_file_id.as_deref(),\n+            event.secondary_provider_kind.as_deref(),\n+            event.secondary_upstream_alias.as_deref(),\n+        ) {\n+            match provider_kind {\n+                \"anthropic\" => {\n+                    if let Some(client) = self.anthropic_files_client.as_ref() {","path":"modules/mini-chat/mini-chat/src/infra/workers/cleanup_worker.rs","commit_id":"145432d4874370acc0712627a65be5010a84fcc2","original_commit_id":"c40106506f9c641b6a33b37e09a5c1f718177457","user":{"login":"jalankulkija","id":260627792,"node_id":"U_kgDOD4jdUA","avatar_url":"https://avatars.githubusercontent.com/u/260627792?v=4","gravatar_id":"","url":"https://api.github.com/users/jalankulkija","html_url":"https://github.com/jalankulkija","followers_url":"https://api.github.com/users/jalankulkija/followers","following_url":"https://api.github.com/users/jalankulkija/following{/other_user}","gists_url":"https://api.github.com/users/jalankulkija/gists{/gist_id}","starred_url":"https://api.github.com/users/jalankulkija/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jalankulkija/subscriptions","organizations_url":"https://api.github.com/users/jalankulkija/orgs","repos_url":"https://api.github.com/users/jalankulkija/repos","events_url":"https://api.github.com/users/jalankulkija/events{/privacy}","received_events_url":"https://api.github.com/users/jalankulkija/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed","created_at":"2026-05-18T12:55:42Z","updated_at":"2026-05-18T12:55:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259048015","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259048015"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259048015"},"pul
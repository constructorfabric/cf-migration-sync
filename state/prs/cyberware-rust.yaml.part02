+\n+// ── Label keys (OpenTelemetry attribute names) ───────────────────────────\n+\n+pub mod key {\n+    /// Upstream alias (stable, low-cardinality identifier of the destination service).\n+    pub const HOST: &str = \"host\";\n+    /// Route match pattern (NOT raw request path — cardinality control).\n+    pub const PATH: &str = \"path\";\n+    /// HTTP method.\n+    pub const METHOD: &str = \"method\";\n+    /// HTTP status class (`2xx`, `3xx`, `4xx`, `5xx`).\n+    pub const STATUS_CLASS: &str = \"status_class\";","path":"modules/system/oagw/oagw/src/domain/ports/metric_labels.rs","commit_id":"a6312484dc3954077208589a45be88f51173fa11","original_commit_id":"a6312484dc3954077208589a45be88f51173fa11","user":{"login":"asmith987","id":260502008,"node_id":"U_kgDOD4bx-A","avatar_url":"https://avatars.githubusercontent.com/u/260502008?v=4","gravatar_id":"","url":"https://api.github.com/users/asmith987","html_url":"https://github.com/asmith987","followers_url":"https://api.github.com/users/asmith987/followers","following_url":"https://api.github.com/users/asmith987/following{/other_user}","gists_url":"https://api.github.com/users/asmith987/gists{/gist_id}","starred_url":"https://api.github.com/users/asmith987/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/asmith987/subscriptions","organizations_url":"https://api.github.com/users/asmith987/orgs","repos_url":"https://api.github.com/users/asmith987/repos","events_url":"https://api.github.com/users/asmith987/events{/privacy}","received_events_url":"https://api.github.com/users/asmith987/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Renamed to STATUS_CODE. Additionally, the label has also been renamed to `http.response.status_code`, so it is consistent with API gateway + OTEL HTTP semcov.","created_at":"2026-05-27T21:45:36Z","updated_at":"2026-05-27T21:45:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1969#discussion_r3314019371","pull_requ
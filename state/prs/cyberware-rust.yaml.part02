/github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"i made modification to how `$(E2E_ARGS)` can be used as an optional extra args to the commands rather than hardcoding it with features.\n\nFor example:\n```\ne2e-docker-pg:\n\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features db-pg,users-info-example,tenant-resolver-example\" --profile postgres $(E2E_ARGS)\n```\n","created_at":"2026-02-13T11:02:19Z","updated_at":"2026-02-13T11:02:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803639798","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803639798"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803639798"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803639798/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":6,"side":"LEFT","in_reply_to_id":2803588457,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803733839","pull_request_review_id":3796749671,"id":2803733839,"node_id":"PRRC_kwDOPaLyBs6nHZVP","diff_hunk":"@@ -3,9 +3,6 @@ CI := 1\n OPENAPI_URL ?= http://127.0.0.1:8087/openapi.json\n OPENAPI_OUT ?= docs/api/api.json\n \n-# E2E Docker args","path":"Makefile","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"6da276bbdc10f74f88703c6f15ea189c74aba249","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"i added a new parameter `DEFAULT_FEATURES ?= users-info-example,tenant-resolver-example` for default features.","created_at":"2026-02-13T11:26:45Z","updated_at":"2026-02-13T11:26:45Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803733839","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803733839"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803733839"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803733839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":6,"side":"LEFT","in_reply_to_id":2803588457,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803744864","pull_request_review_id":3710243536,"id":2803744864,"node_id":"PRRC_kwDOPaLyBs6nHcBg","diff_hunk":"@@ -314,22 +313,30 @@ test-users-info-pg:\n \n # -------- E2E tests --------\n \n-.PHONY: e2e e2e-local e2e-docker e2e-smoke\n+.PHONY: e2e e2e-local e2e-docker e2e-docker-pg e2e-docker-mysql e2e-smoke\n \n # Run E2E tests in Docker (default)\n e2e: e2e-docker\n \n-## Run E2E smoke tests in Docker (only tests marked @pytest.mark.smoke)\n+## Run E2E smoke tests in Docker with sqlite (only tests marked @pytest.mark.smoke)\n e2e-smoke:\n-\tpython3 scripts/ci.py e2e --docker $(E2E_ARGS) -- -m smoke\n+\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features $(DEFAULT_FEATURES)\" $(E2E_ARGS) -- -m smoke\n \n # Run E2E tests locally\n e2e-local:\n \tpython3 scripts/ci.py e2e\n \n-## Run E2E tests in Docker environment\n+## Run E2E tests in Docker environment (default: sqlite)\n e2e-docker:\n-\tpython3 scripts/ci.py e2e --docker $(E2E_ARGS)\n+\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features $(DEFAULT_FEATURES)\" $(E2E_ARGS)","path":"Makefile","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"f55b313cd5fdbf71294a696ff16517031ce0f53f","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Missing database driver feature for default e2e-docker target. The command passes `--features $(DEFAULT_FEATURES)` which only includes `users-info-example,tenant-resolver-example`, but doesn't specify a database driver (db-sqlite, db-pg, or db-mysql).\n\nSince the default features in `apps/hyperspot-server/Cargo.toml` is empty and the database-using modules (`users-info`, `simple-user-settings`) have removed their default database drivers, this will fail to compile or run properly.\n\n**Fix**: Add `db-sqlite` to the default build:\n```makefile\ne2e-docker:\n\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features db-sqlite,$(DEFAULT_FEATURES)\" $(E2E_ARGS)\n```\n```suggestion\ne2e-docker:\n\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features db-sqlite,$(DEFAULT_FEATURES)\" $(E2E_ARGS)\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=cyberfabric&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/cyberfabric/cyberfabric-core/320?chatWithGeneratedComment=ba019d6a-6469-4ec4-9fda-414fef0e7d78\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-13T11:29:47Z","updated_at":"2026-02-13T11:29:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803744864","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803744864"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803744864"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803744864/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":330,"start_side":"RIGHT","line":null,"original_line":331,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803753568","pull_request_review_id":3796769417,"id":2803753568,"node_id":"PRRC_kwDOPaLyBs6nHeJg","diff_hunk":"@@ -314,22 +313,30 @@ test-users-info-pg:\n \n # -------- E2E tests --------\n \n-.PHONY: e2e e2e-local e2e-docker e2e-smoke\n+.PHONY: e2e e2e-local e2e-docker e2e-docker-pg e2e-docker-mysql e2e-smoke\n \n # Run E2E tests in Docker (default)\n e2e: e2e-docker\n \n-## Run E2E smoke tests in Docker (only tests marked @pytest.mark.smoke)\n+## Run E2E smoke tests in Docker with sqlite (only tests marked @pytest.mark.smoke)\n e2e-smoke:\n-\tpython3 scripts/ci.py e2e --docker $(E2E_ARGS) -- -m smoke\n+\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features $(DEFAULT_FEATURES)\" $(E2E_ARGS) -- -m smoke\n \n # Run E2E tests locally\n e2e-local:\n \tpython3 scripts/ci.py e2e\n \n-## Run E2E tests in Docker environment\n+## Run E2E tests in Docker environment (default: sqlite)\n e2e-docker:\n-\tpython3 scripts/ci.py e2e --docker $(E2E_ARGS)\n+\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features $(DEFAULT_FEATURES)\" $(E2E_ARGS)","path":"Makefile","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"f55b313cd5fdbf71294a696ff16517031ce0f53f","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"the default is db-sqlite already without explicitly defining it.","created_at":"2026-02-13T11:32:16Z","updated_at":"2026-02-13T11:32:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803753568","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803753568"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803753568"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803753568/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":330,"start_side":"RIGHT","line":null,"original_line":331,"side":"RIGHT","in_reply_to_id":2803744864,"author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2858281493","pull_request_review_id":3860060595,"id":2858281493,"node_id":"PRRC_kwDOPaLyBs6qXeoV","diff_hunk":"@@ -280,8 +280,43 @@ impl AppConfig {\n         let figment = Figment::new()\n             .merge(Serialized::defaults(AppConfig::default()))\n             .merge(Yaml::file(config_path))\n-            // Example: APP__SERVER__PORT=8087 maps to server.port\n-            .merge(Env::prefixed(\"APP__\").split(\"__\"));\n+            // Env vars use \"__\" as the nesting separator, e.g.\n+            //   APP__SERVER__PORT=8087  →  server.port\n+            //\n+            // Module names in YAML may be hyphenated (e.g. \"api-gateway\") or\n+            // underscored (e.g. \"api_gateway\"), but env vars cannot contain\n+            // hyphens. We merge env vars twice:\n+            //  1. Plain — matches underscored YAML keys as-is.\n+            //  2. With .map() — converts underscores to hyphens in the\n+            //     module-name segment to match hyphenated YAML keys.\n+            // This lets APP__MODULES__api_gateway__CONFIG__X override both\n+            // modules.api_gateway.config.x and modules.api-gateway.config.x.\n+            .merge(Env::prefixed(\"APP__\").split(\"__\"))","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The merge-twice-with-map approach works but is fragile - it's hardcoded to modules__ and logging__ prefixes, so every new hyphenated section needs a code change. It also makes env var override priority non-obvious (two merges for the same prefix).\r\n\r\nBetter way: write a single custom Figment provider that normalizes underscores to hyphens in one place, driven by the actual config structure - not a hardcoded prefix list. That way new hyphenated sections work automatically without touching the bootstrap code.","created_at":"2026-02-26T10:44:10Z","updated_at":"2026-02-26T10:44:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2858281493","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2858281493"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2858281493"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2858281493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":294,"side":"RIGHT","author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2871657273","pull_request_review_id":3875314786,"id":2871657273,"node_id":"PRRC_kwDOPaLyBs6rKgM5","diff_hunk":"@@ -280,8 +280,43 @@ impl AppConfig {\n         let figment = Figment::new()\n             .merge(Serialized::defaults(AppConfig::default()))\n             .merge(Yaml::file(config_path))\n-            // Example: APP__SERVER__PORT=8087 maps to server.port\n-            .merge(Env::prefixed(\"APP__\").split(\"__\"));\n+            // Env vars use \"__\" as the nesting separator, e.g.\n+            //   APP__SERVER__PORT=8087  →  server.port\n+            //\n+            // Module names in YAML may be hyphenated (e.g. \"api-gateway\") or\n+            // underscored (e.g. \"api_gateway\"), but env vars cannot contain\n+            // hyphens. We merge env vars twice:\n+            //  1. Plain — matches underscored YAML keys as-is.\n+            //  2. With .map() — converts underscores to hyphens in the\n+            //     module-name segment to match hyphenated YAML keys.\n+            // This lets APP__MODULES__api_gateway__CONFIG__X override both\n+            // modules.api_gateway.config.x and modules.api-gateway.config.x.\n+            .merge(Env::prefixed(\"APP__\").split(\"__\"))","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed. Updated with custom figment provider.","created_at":"2026-03-02T10:33:10Z","updated_at":"2026-03-03T02:49:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2871657273","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2871657273"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2871657273"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2871657273/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"or
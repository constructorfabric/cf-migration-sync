 `ServerConfig`. \r\n\r\nThe tests don't go through the modkit bootstrap, so it would not be available otherwise.\r\n\r\nI've folded the `ensure_crypto_provider` function into `test_server_config`,  so that it is only initialized when needed while running the tests.","created_at":"2026-05-20T23:05:20Z","updated_at":"2026-05-20T23:05:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1960#discussion_r3277680848","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1960","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3277680848"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1960#discussion_r3277680848"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1960"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3277680848/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","in_reply_to_id":3277208977,"author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":1959,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/1959","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #1959] chore: continue renaming of cf-sdlc to cyberware-sdlc","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"cyberware","pr_head_sha":"77bd54d5947d7a2fb8fff7533490bce9cf4542a0","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1959","id":3718462020,"node_id":"PR_kwDOPaLyBs7dozpE","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1959","diff_url":"https://github.com/c
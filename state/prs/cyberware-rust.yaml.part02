"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/4016534567","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#issuecomment-4016534567","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/243","id":4016534567,"node_id":"IC_kwDOPaLyBs7vZ3Qn","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2026-03-07T13:33:42Z","updated_at":"2026-03-07T13:33:42Z","body":"There are unresolved review comments awaiting response.\n\nUnanswered human review threads: 56\nUnresolved comments: 56","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/4016534567/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":15368,"client_id":"Iv1.05c79e9ad1f6bdfa","slug":"github-actions","node_id":"MDM6QXBwMTUzNjg=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url":"https://api.github.com/users/github/following{/other_user}","gists_url":"https://api.github.com/users/github/gists{/gist_id}","starred_url":"https://api.github.com/users/github/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github/subscriptions","organizations_url":"https://api.github.com/users/github/orgs","repos_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-05-05T14:51:38Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694098942","pull_request_review_id":3665259141,"id":2694098942,"node_id":"PRRC_kwDOPaLyBs6glK_-","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This appears to be P0 for us.","created_at":"2026-01-15T11:56:20Z","updated_at":"2026-01-15T13:03:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694098942","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694098942"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694098942"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694098942/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":227,"original_line":227,"side":"RIGHT","author_association":"MEMBER","original_position":227,"position":227,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694114199","pull_request_review_id":3665259141,"id":2694114199,"node_id":"PRRC_kwDOPaLyBs6glOuX","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This will require us to provide a way to define external dependencies for workflow and monitoring of their availability. Is this really P0? It seems to me BR-020 covers base scenario of external dependency failure handling which should be sufficient for P0","created_at":"2026-01-15T12:01:42Z","updated_at":"2026-01-15T13:03:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694114199","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694114199"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694114199"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694114199/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":101,"original_line":101,"side":"RIGHT","author_association":"MEMBER","original_position":101,"position":101,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694118770","pull_request_review_id":3665259141,"id":2694118770,"node_id":"PRRC_kwDOPaLyBs6glP1y","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"this seems to be responsibility of Secret Management Service","created_at":"2026-01-15T12:03:19Z","updated_at":"2026-01-15T13:03:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694118770","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694118770"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694118770"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694118770/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":174,"original_line":174,"side":"RIGHT","author_association":"MEMBER","original_position":174,"position":174,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694137435","pull_request_review_id":3665259141,"id":2694137435,"node_id":"PRRC_kwDOPaLyBs6glUZb","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"what's the difference between this and PR-005?","created_at":"2026-01-15T12:10:00Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694137435","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694137435"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694137435"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694137435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":106,"original_line":106,"side":"RIGHT","author_association":"MEMBER","original_position":106,"position":106,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694138903","pull_request_review_id":3665259141,"id":2694138903,"node_id":"PRRC_kwDOPaLyBs6glUwX","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not sure this is P0","created_at":"2026-01-15T12:10:32Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694138903","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694138903"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694138903"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694138903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":59,"original_line":59,"side":"RIGHT","author_association":"MEMBER","original_position":59,"position":59,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694150848","pull_request_review_id":3665259141,"id":2694150848,"node_id":"PRRC_kwDOPaLyBs6glXrA","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Should this be a part of Workflow Engine System? Looks like a Policy or Configuration System responsibility to me","created_at":"2026-01-15T12:14:17Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694150848","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694150848"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694150848"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694150848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":269,"original_line":269,"side":"RIGHT","author_association":"MEMBER","original_position":269,"position":269,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694157988","pull_request_review_id":3665259141,"id":2694157988,"node_id":"PRRC_kwDOPaLyBs6glZak","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.\n+\n+### BR-134 (P1): Idempotency mechanisms","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Seems to be P0","created_at":"2026-01-15T12:16:41Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694157988","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694157988"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694157988"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694157988/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":341,"original_line":341,"side":"RIGHT","author_association":"MEMBER","original_position":341,"position":341,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694214631","pull_request_review_id":3665259141,"id":2694214631,"node_id":"PRRC_kwDOPaLyBs6glnPn","diff_hunk":"@@ -0,0 +1,516 @@\n+# ADR — Starlark Runtime (Function & Workflow Execution)\n+\n+## Status\n+Proposed\n+\n+## Context\n+Hyperspot Serverless Runtime supports functions and workflows defined as GTS-identified JSON Schemas and invoked via a unified invocation API.\n+\n+This ADR defines the design of the Starlark runtime implementation used to execute those definitions:\n+- the Starlark program structure (entrypoint contract)\n+- strong typing rules and runtime validation\n+- runtime-provided helper methods (`r_*`) and their versioning\n+- asynchronous execution model (promise + await)\n+- workflow orchestration hooks (steps, retries, compensation, snapshots, event waiting)\n+- example definitions and Starlark programs for functions and workflows\n+\n+This ADR is intentionally aligned with `2_ADR_ENTRYPOINT.md` (Entrypoint schema + Invocation API).\n+\n+## Why Starlark?\n+\n+Starlark is a good fit for Hyperspot Serverless Runtime because it provides a constrained, embeddable, deterministic scripting language with strong tooling hooks.\n+\n+### Fit for functions and workflows\n+- Starlark can express both short-lived function handlers and long-lived workflow orchestration logic using the same `main(ctx, input)` contract.\n+- Workflows rely on runtime-provided primitives (`r_snapshot_v1`, `r_wait_event_v1`, `r_run_step_v1`) rather than language-level threads, exceptions, or background I/O.\n+  This keeps orchestration behavior explicit and makes suspend/resume semantics a runtime feature instead of a language hack.\n+\n+### Rust-first embedding model\n+- The runtime is implemented in Rust and can interpret Starlark directly via an embedded interpreter.\n+- Runtime helpers (`r_*`) are the primary integration surface: the Rust host controls all I/O, persistence, event waiting, step tracking, and compensation.\n+- This model minimizes the host surface area compared to embedding Python/JS while still giving an ergonomic authoring experience.\n+\n+### Static validation via parse/AST and policy checks\n+Starlark allows a practical pre-execution validation pipeline:\n+- parse source into an AST and fail fast on syntax errors\n+- restrict the available built-ins and prohibit disallowed constructs\n+- validate that the program exports `main(ctx, input)`\n+- validate calls to runtime helpers (`r_*`) for arity and argument types where possible\n+- optionally enforce additional policy (e.g., forbid dynamic `load()`, forbid unbounded loops, or require explicit timeouts on I/O helpers)\n+\n+The runtime MAY also perform system-aware validation when registering a function/workflow, for example:\n+- validate that outbound URLs are recognized/allowed by policy and have corresponding credentials configured (e.g., via an outbound API gateway)\n+- validate that referenced event type IDs are registered in the system\n+- validate error types are registered in the system\n+- validate function/workflow contract against entrypoint schema\n+\n+### Determinism and replayability\n+- Starlark is designed to be deterministic given the same inputs and host-provided functions.\n+- The runtime can ensure all nondeterminism flows through `r_*` helpers, which are versioned and can be recorded/replayed.\n+- This is critical for durable workflows that may be resumed from snapshots and must behave consistently.\n+\n+### Resource controls and safe execution\n+- Because execution happens inside our Rust host, the runtime can enforce limits (wall-clock, instruction count/step budget, memory, and CPU quotas) at the interpreter boundary.\n+- Restricting the language and the host surface makes it easier to sandbox than general-purpose runtimes.\n+\n+### Debuggability (breakpoints, stack traces, tracing)\n+- Starlark evaluation naturally exposes execution state (call stack, frames, current location) to the host.\n+- The runtime can implement:\n+  - setting breakpoints by source location\n+  - pausing/resuming execution and inspecting locals\n+  - structured tracing of `r_*` calls, including step boundaries and awaited events\n+  - deterministic stack traces aligned with source\n+\n+### Familiarity (humans and LLMs)\n+- Starlark syntax is intentionally Python-like, making it familiar to Python users.\n+- Its Python-like surface also makes it a strong target for LLM-assisted authoring, review, and transformation.\n+\n+### Stewardship\n+Starlark is used by Bazel and the language specification is maintained in the `bazelbuild` ecosystem with strong ongoing involvement from the Bazel community and Google.\n+\n+For Rust-based embedding, `starlark-rust` is a widely used Rust implementation of Starlark (commonly referenced as `facebook/starlark-rust` / Meta) published as standard crates.\n+\n+### Alternatives (quick comparison)\n+- WebAssembly (Wasm)\n+  - Pros: strong sandboxing, mature tooling, good performance\n+  - Cons: heavier authoring model, less ergonomic for orchestration scripting, debugging and host-call surface can be more complex, deterministic replay requires additional conventions\n+- JavaScript (embedded engine)\n+  - Pros: familiar language, large ecosystem\n+  - Cons: larger runtime/attack surface, more complexity around determinism, resource control, and sandboxing; host embedding is heavier\n+- Python\n+  - Pros: very popular, high productivity\n+  - Cons: embedding/sandboxing is hard, resource controls are complex, too many dynamic escape hatches for a multi-tenant runtime\n+- Lua\n+  - Pros: embeddable, small\n+  - Cons: less aligned with structured typing via `struct(...)` conventions and our desired validation ergonomics; ecosystem familiarity varies\n+- Custom DSL\n+  - Pros: maximum control and validation\n+  - Cons: high implementation cost, poor ergonomics, and tends to grow into a full language over time\n+\n+## Goals\n+- Provide a deterministic and safe execution model for runtime created/updated code.\n+- Make functions and workflows compatible with a single language/runtime surface.\n+- Enforce schema-based typing and prevent invalid input/output at runtime.\n+- Support long-running execution patterns: waiting on events, suspend/resume, and snapshots.\n+- Provide a versioned runtime API so code remains forward-compatible.\n+\n+## Non-goals\n+- Defining the full sandboxing / isolation strategy.\n+- Defining the persistence format for snapshots.\n+- Defining the complete event transport implementation.\n+\n+## Starlark program structure\n+\n+### Entrypoint\n+All Starlark functions and workflows MUST expose a `main(ctx, input)` function.\n+\n+- `ctx` is a runtime-provided context object.\n+- `input` is the validated input object matching the entrypoint `params` schema.\n+\n+`main()` MUST return a value matching the entrypoint `returns` schema or terminate execution via `r_exit(...)`.\n+\n+## Strong type system\n+\n+### Source of truth\n+The source of truth for function/workflow types is the GTS-identified JSON Schema:\n+- `params` (input)\n+- `returns` (output)\n+- `errors` (error envelope types)\n+\n+### Validation rules\n+- On function registration, the runtime MUST validate `params` against the entrypoint schema before executing Starlark.\n+- Similarly, the runtime MUST validate the returned value against the `returns` schema.\n+- For workflows, the runtime MUST validate snapshot state and resumption input before continuing.\n+\n+### Starlark typing model\n+Starlark is dynamically typed, but the runtime enforces a strong type system by:\n+- validating boundary values (input/output)\n+- validating `r_*` method arguments (e.g., `url` must be string)\n+- validating `r_wait_event(...)` against an event schema ID and payload schema\n+\n+For maximum ergonomics and stricter typing, the runtime SHOULD materialize validated inputs as a Starlark `struct(...)` with fields matching the JSON Schema properties (instead of a generic dict). This enables `input.customer_id` style access.\n+\n+All objects returned to the caller MUST be compatible with the JSON Schema types declared in `returns`.\n+In practice, this means Starlark programs MUST treat returned objects as strongly typed structs:\n+- no missing required fields\n+- no additional fields when `additionalProperties` is false\n+- field types must match schema\n+\n+## Runtime helper methods (versioned)\n+All runtime helper methods (`r_*`) MUST be versioned to preserve compatibility across functions and workflows.\n+\n+### Common conventions\n+- All helper names are prefixed with `r_`.\n+- Methods that perform I/O MUST be async and return a promise.\n+- Methods that influence control flow (`r_exit`, `r_snapshot`) MUST be deterministic.\n+\n+To preserve determinism and replayability, Starlark programs MUST NOT use nondeterministic sources such as embedded `datetime.now()` or `random.random()`.\n+If time or randomness is required, it MUST be obtained via runtime helpers provided by the Rust host.\n+\n+### Promise and await\n+The runtime provides a minimal async model:\n+\n+- `Promise<T>` is an opaque runtime object.\n+- `r_await(promise)` waits for the promise to resolve and returns `T`.\n+\n+The runtime MAY also support `r_await_all([p1, p2, ...])` to resolve multiple promises concurrently.\n+\n+If `r_await(...)` is called on a promise that cannot complete without external input (event or timer), the runtime MUST suspend the invocation and resume it when the promise becomes ready.\n+\n+### HTTP helpers\n+\n+#### Response shape\n+`r_http_*_v1()` resolves to an `HttpResult` value which never raises exceptions and can represent either a successful HTTP response or an error.\n+\n+`HttpResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access (`result.ok`, `result.response`, `result.error`).\n+\n+Successful response:\n+- `ok` (boolean, `true`)\n+- `response` (a Starlark `struct(...)`)\n+  - `status_code` (integer)\n+  - `headers` (dict)\n+  - `body` (dict)\n+\n+Error response:\n+- `ok` (boolean, `false`)\n+- `error` (a Starlark `struct(...)`) compatible with the runtime error envelope defined in `2_ADR_ENTRYPOINT.md`.\n+  - for non-2xx upstream responses: `gts.x.core.faas.err.v1~x.core._.http.v1~`\n+  - for upstream transport failures: `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~` and `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~`\n+  - for runtime failures: `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~`, and `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~`\n+\n+If the upstream response body is not JSON, the runtime SHOULD return an empty object for `response.body`.","path":"modules/serverless_runtime/docs/3_ADR_STARLARK_RUNTIME.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"What about non-JSON APIs?","created_at":"2026-01-15T12:35:36Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694214631","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694214631"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694214631"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694214631/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":181,"original_line":181,"side":"RIGHT","author_association":"MEMBER","original_position":181,"position":181,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694218538","pull_request_review_id":3665259141,"id":2694218538,"node_id":"PRRC_kwDOPaLyBs6gloMq","diff_hunk":"@@ -0,0 +1,516 @@\n+# ADR — Starlark Runtime (Function & Workflow Execution)\n+\n+## Status\n+Proposed\n+\n+## Context\n+Hyperspot Serverless Runtime supports functions and workflows defined as GTS-identified JSON Schemas and invoked via a unified invocation API.\n+\n+This ADR defines the design of the Starlark runtime implementation used to execute those definitions:\n+- the Starlark program structure (entrypoint contract)\n+- strong typing rules and runtime validation\n+- runtime-provided helper methods (`r_*`) and their versioning\n+- asynchronous execution model (promise + await)\n+- workflow orchestration hooks (steps, retries, compensation, snapshots, event waiting)\n+- example definitions and Starlark programs for functions and workflows\n+\n+This ADR is intentionally aligned with `2_ADR_ENTRYPOINT.md` (Entrypoint schema + Invocation API).\n+\n+## Why Starlark?\n+\n+Starlark is a good fit for Hyperspot Serverless Runtime because it provides a constrained, embeddable, deterministic scripting language with strong tooling hooks.\n+\n+### Fit for functions and workflows\n+- Starlark can express both short-lived function handlers and long-lived workflow orchestration logic using the same `main(ctx, input)` contract.\n+- Workflows rely on runtime-provided primitives (`r_snapshot_v1`, `r_wait_event_v1`, `r_run_step_v1`) rather than language-level threads, exceptions, or background I/O.\n+  This keeps orchestration behavior explicit and makes suspend/resume semantics a runtime feature instead of a language hack.\n+\n+### Rust-first embedding model\n+- The runtime is implemented in Rust and can interpret Starlark directly via an embedded interpreter.\n+- Runtime helpers (`r_*`) are the primary integration surface: the Rust host controls all I/O, persistence, event waiting, step tracking, and compensation.\n+- This model minimizes the host surface area compared to embedding Python/JS while still giving an ergonomic authoring experience.\n+\n+### Static validation via parse/AST and policy checks\n+Starlark allows a practical pre-execution validation pipeline:\n+- parse source into an AST and fail fast on syntax errors\n+- restrict the available built-ins and prohibit disallowed constructs\n+- validate that the program exports `main(ctx, input)`\n+- validate calls to runtime helpers (`r_*`) for arity and argument types where possible\n+- optionally enforce additional policy (e.g., forbid dynamic `load()`, forbid unbounded loops, or require explicit timeouts on I/O helpers)\n+\n+The runtime MAY also perform system-aware validation when registering a function/workflow, for example:\n+- validate that outbound URLs are recognized/allowed by policy and have corresponding credentials configured (e.g., via an outbound API gateway)\n+- validate that referenced event type IDs are registered in the system\n+- validate error types are registered in the system\n+- validate function/workflow contract against entrypoint schema\n+\n+### Determinism and replayability\n+- Starlark is designed to be deterministic given the same inputs and host-provided functions.\n+- The runtime can ensure all nondeterminism flows through `r_*` helpers, which are versioned and can be recorded/replayed.\n+- This is critical for durable workflows that may be resumed from snapshots and must behave consistently.\n+\n+### Resource controls and safe execution\n+- Because execution happens inside our Rust host, the runtime can enforce limits (wall-clock, instruction count/step budget, memory, and CPU quotas) at the interpreter boundary.\n+- Restricting the language and the host surface makes it easier to sandbox than general-purpose runtimes.\n+\n+### Debuggability (breakpoints, stack traces, tracing)\n+- Starlark evaluation naturally exposes execution state (call stack, frames, current location) to the host.\n+- The runtime can implement:\n+  - setting breakpoints by source location\n+  - pausing/resuming execution and inspecting locals\n+  - structured tracing of `r_*` calls, including step boundaries and awaited events\n+  - deterministic stack traces aligned with source\n+\n+### Familiarity (humans and LLMs)\n+- Starlark syntax is intentionally Python-like, making it familiar to Python users.\n+- Its Python-like surface also makes it a strong target for LLM-assisted authoring, review, and transformation.\n+\n+### Stewardship\n+Starlark is used by Bazel and the language specification is maintained in the `bazelbuild` ecosystem with strong ongoing involvement from the Bazel community and Google.\n+\n+For Rust-based embedding, `starlark-rust` is a widely used Rust implementation of Starlark (commonly referenced as `facebook/starlark-rust` / Meta) published as standard crates.\n+\n+### Alternatives (quick comparison)\n+- WebAssembly (Wasm)\n+  - Pros: strong sandboxing, mature tooling, good performance\n+  - Cons: heavier authoring model, less ergonomic for orchestration scripting, debugging and host-call surface can be more complex, deterministic replay requires additional conventions\n+- JavaScript (embedded engine)\n+  - Pros: familiar language, large ecosystem\n+  - Cons: larger runtime/attack surface, more complexity around determinism, resource control, and sandboxing; host embedding is heavier\n+- Python\n+  - Pros: very popular, high productivity\n+  - Cons: embedding/sandboxing is hard, resource controls are complex, too many dynamic escape hatches for a multi-tenant runtime\n+- Lua\n+  - Pros: embeddable, small\n+  - Cons: less aligned with structured typing via `struct(...)` conventions and our desired validation ergonomics; ecosystem familiarity varies\n+- Custom DSL\n+  - Pros: maximum control and validation\n+  - Cons: high implementation cost, poor ergonomics, and tends to grow into a full language over time\n+\n+## Goals\n+- Provide a deterministic and safe execution model for runtime created/updated code.\n+- Make functions and workflows compatible with a single language/runtime surface.\n+- Enforce schema-based typing and prevent invalid input/output at runtime.\n+- Support long-running execution patterns: waiting on events, suspend/resume, and snapshots.\n+- Provide a versioned runtime API so code remains forward-compatible.\n+\n+## Non-goals\n+- Defining the full sandboxing / isolation strategy.\n+- Defining the persistence format for snapshots.\n+- Defining the complete event transport implementation.\n+\n+## Starlark program structure\n+\n+### Entrypoint\n+All Starlark functions and workflows MUST expose a `main(ctx, input)` function.\n+\n+- `ctx` is a runtime-provided context object.\n+- `input` is the validated input object matching the entrypoint `params` schema.\n+\n+`main()` MUST return a value matching the entrypoint `returns` schema or terminate execution via `r_exit(...)`.\n+\n+## Strong type system\n+\n+### Source of truth\n+The source of truth for function/workflow types is the GTS-identified JSON Schema:\n+- `params` (input)\n+- `returns` (output)\n+- `errors` (error envelope types)\n+\n+### Validation rules\n+- On function registration, the runtime MUST validate `params` against the entrypoint schema before executing Starlark.\n+- Similarly, the runtime MUST validate the returned value against the `returns` schema.\n+- For workflows, the runtime MUST validate snapshot state and resumption input before continuing.\n+\n+### Starlark typing model\n+Starlark is dynamically typed, but the runtime enforces a strong type system by:\n+- validating boundary values (input/output)\n+- validating `r_*` method arguments (e.g., `url` must be string)\n+- validating `r_wait_event(...)` against an event schema ID and payload schema\n+\n+For maximum ergonomics and stricter typing, the runtime SHOULD materialize validated inputs as a Starlark `struct(...)` with fields matching the JSON Schema properties (instead of a generic dict). This enables `input.customer_id` style access.\n+\n+All objects returned to the caller MUST be compatible with the JSON Schema types declared in `returns`.\n+In practice, this means Starlark programs MUST treat returned objects as strongly typed structs:\n+- no missing required fields\n+- no additional fields when `additionalProperties` is false\n+- field types must match schema\n+\n+## Runtime helper methods (versioned)\n+All runtime helper methods (`r_*`) MUST be versioned to preserve compatibility across functions and workflows.\n+\n+### Common conventions\n+- All helper names are prefixed with `r_`.\n+- Methods that perform I/O MUST be async and return a promise.\n+- Methods that influence control flow (`r_exit`, `r_snapshot`) MUST be deterministic.\n+\n+To preserve determinism and replayability, Starlark programs MUST NOT use nondeterministic sources such as embedded `datetime.now()` or `random.random()`.\n+If time or randomness is required, it MUST be obtained via runtime helpers provided by the Rust host.\n+\n+### Promise and await\n+The runtime provides a minimal async model:\n+\n+- `Promise<T>` is an opaque runtime object.\n+- `r_await(promise)` waits for the promise to resolve and returns `T`.\n+\n+The runtime MAY also support `r_await_all([p1, p2, ...])` to resolve multiple promises concurrently.\n+\n+If `r_await(...)` is called on a promise that cannot complete without external input (event or timer), the runtime MUST suspend the invocation and resume it when the promise becomes ready.\n+\n+### HTTP helpers\n+\n+#### Response shape\n+`r_http_*_v1()` resolves to an `HttpResult` value which never raises exceptions and can represent either a successful HTTP response or an error.\n+\n+`HttpResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access (`result.ok`, `result.response`, `result.error`).\n+\n+Successful response:\n+- `ok` (boolean, `true`)\n+- `response` (a Starlark `struct(...)`)\n+  - `status_code` (integer)\n+  - `headers` (dict)\n+  - `body` (dict)\n+\n+Error response:\n+- `ok` (boolean, `false`)\n+- `error` (a Starlark `struct(...)`) compatible with the runtime error envelope defined in `2_ADR_ENTRYPOINT.md`.\n+  - for non-2xx upstream responses: `gts.x.core.faas.err.v1~x.core._.http.v1~`\n+  - for upstream transport failures: `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~` and `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~`\n+  - for runtime failures: `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~`, and `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~`\n+\n+If the upstream response body is not JSON, the runtime SHOULD return an empty object for `response.body`.\n+\n+#### r_http_get_v1(...)\n+Signature:\n+- `r_http_get_v1(url, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+Notes:\n+- `url` is required.\n+- `headers` is an optional dict.\n+- `timeout_ms` is optional.\n+- `retry` is optional runtime-defined retry policy (e.g., {\"max_attempts\": 3, \"backoff_ms\": 200}).\n+- `exit_on_http_error=true` means the runtime calls `r_exit(...)` on non-2xx upstream responses or on upstream transport failures.\n+- `exit_on_http_error=false` means the promise resolves to an `HttpResult` and the Starlark code is responsible for handling `ok=false` and/or non-2xx status codes.\n+\n+NOTE: The runtime MUST NOT perform outbound HTTP requests directly. Instead, it MUST delegate outbound calls to the outbound API gateway so that security context, credential management, and internal-to-external token/authorization exchange are applied consistently and all egress traffic is centrally enforced and observed.\n+\n+#### r_http_post_v1(...)\n+Signature:\n+- `r_http_post_v1(url, body, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+### Sleep\n+- `r_sleep(milliseconds) -> Promise<None>`\n+\n+### Time and randomness (deterministic)\n+- `r_now_v1() -> string`\n+- `r_rand_v1(label=None) -> string`","path":"modules/serverless_runtime/docs/3_ADR_STARLARK_RUNTIME.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"both are strings?","created_at":"2026-01-15T12:36:55Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694218538","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694218538"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694218538"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694218538/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":206,"original_line":206,"side":"RIGHT","author_association":"MEMBER","original_position":206,"position":206,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694224312","pull_request_review_id":3665259141,"id":2694224312,"node_id":"PRRC_kwDOPaLyBs6glpm4","diff_hunk":"@@ -0,0 +1,516 @@\n+# ADR — Starlark Runtime (Function & Workflow Execution)\n+\n+## Status\n+Proposed\n+\n+## Context\n+Hyperspot Serverless Runtime supports functions and workflows defined as GTS-identified JSON Schemas and invoked via a unified invocation API.\n+\n+This ADR defines the design of the Starlark runtime implementation used to execute those definitions:\n+- the Starlark program structure (entrypoint contract)\n+- strong typing rules and runtime validation\n+- runtime-provided helper methods (`r_*`) and their versioning\n+- asynchronous execution model (promise + await)\n+- workflow orchestration hooks (steps, retries, compensation, snapshots, event waiting)\n+- example definitions and Starlark programs for functions and workflows\n+\n+This ADR is intentionally aligned with `2_ADR_ENTRYPOINT.md` (Entrypoint schema + Invocation API).\n+\n+## Why Starlark?\n+\n+Starlark is a good fit for Hyperspot Serverless Runtime because it provides a constrained, embeddable, deterministic scripting language with strong tooling hooks.\n+\n+### Fit for functions and workflows\n+- Starlark can express both short-lived function handlers and long-lived workflow orchestration logic using the same `main(ctx, input)` contract.\n+- Workflows rely on runtime-provided primitives (`r_snapshot_v1`, `r_wait_event_v1`, `r_run_step_v1`) rather than language-level threads, exceptions, or background I/O.\n+  This keeps orchestration behavior explicit and makes suspend/resume semantics a runtime feature instead of a language hack.\n+\n+### Rust-first embedding model\n+- The runtime is implemented in Rust and can interpret Starlark directly via an embedded interpreter.\n+- Runtime helpers (`r_*`) are the primary integration surface: the Rust host controls all I/O, persistence, event waiting, step tracking, and compensation.\n+- This model minimizes the host surface area compared to embedding Python/JS while still giving an ergonomic authoring experience.\n+\n+### Static validation via parse/AST and policy checks\n+Starlark allows a practical pre-execution validation pipeline:\n+- parse source into an AST and fail fast on syntax errors\n+- restrict the available built-ins and prohibit disallowed constructs\n+- validate that the program exports `main(ctx, input)`\n+- validate calls to runtime helpers (`r_*`) for arity and argument types where possible\n+- optionally enforce additional policy (e.g., forbid dynamic `load()`, forbid unbounded loops, or require explicit timeouts on I/O helpers)\n+\n+The runtime MAY also perform system-aware validation when registering a function/workflow, for example:\n+- validate that outbound URLs are recognized/allowed by policy and have corresponding credentials configured (e.g., via an outbound API gateway)\n+- validate that referenced event type IDs are registered in the system\n+- validate error types are registered in the system\n+- validate function/workflow contract against entrypoint schema\n+\n+### Determinism and replayability\n+- Starlark is designed to be deterministic given the same inputs and host-provided functions.\n+- The runtime can ensure all nondeterminism flows through `r_*` helpers, which are versioned and can be recorded/replayed.\n+- This is critical for durable workflows that may be resumed from snapshots and must behave consistently.\n+\n+### Resource controls and safe execution\n+- Because execution happens inside our Rust host, the runtime can enforce limits (wall-clock, instruction count/step budget, memory, and CPU quotas) at the interpreter boundary.\n+- Restricting the language and the host surface makes it easier to sandbox than general-purpose runtimes.\n+\n+### Debuggability (breakpoints, stack traces, tracing)\n+- Starlark evaluation naturally exposes execution state (call stack, frames, current location) to the host.\n+- The runtime can implement:\n+  - setting breakpoints by source location\n+  - pausing/resuming execution and inspecting locals\n+  - structured tracing of `r_*` calls, including step boundaries and awaited events\n+  - deterministic stack traces aligned with source\n+\n+### Familiarity (humans and LLMs)\n+- Starlark syntax is intentionally Python-like, making it familiar to Python users.\n+- Its Python-like surface also makes it a strong target for LLM-assisted authoring, review, and transformation.\n+\n+### Stewardship\n+Starlark is used by Bazel and the language specification is maintained in the `bazelbuild` ecosystem with strong ongoing involvement from the Bazel community and Google.\n+\n+For Rust-based embedding, `starlark-rust` is a widely used Rust implementation of Starlark (commonly referenced as `facebook/starlark-rust` / Meta) published as standard crates.\n+\n+### Alternatives (quick comparison)\n+- WebAssembly (Wasm)\n+  - Pros: strong sandboxing, mature tooling, good performance\n+  - Cons: heavier authoring model, less ergonomic for orchestration scripting, debugging and host-call surface can be more complex, deterministic replay requires additional conventions\n+- JavaScript (embedded engine)\n+  - Pros: familiar language, large ecosystem\n+  - Cons: larger runtime/attack surface, more complexity around determinism, resource control, and sandboxing; host embedding is heavier\n+- Python\n+  - Pros: very popular, high productivity\n+  - Cons: embedding/sandboxing is hard, resource controls are complex, too many dynamic escape hatches for a multi-tenant runtime\n+- Lua\n+  - Pros: embeddable, small\n+  - Cons: less aligned with structured typing via `struct(...)` conventions and our desired validation ergonomics; ecosystem familiarity varies\n+- Custom DSL\n+  - Pros: maximum control and validation\n+  - Cons: high implementation cost, poor ergonomics, and tends to grow into a full language over time\n+\n+## Goals\n+- Provide a deterministic and safe execution model for runtime created/updated code.\n+- Make functions and workflows compatible with a single language/runtime surface.\n+- Enforce schema-based typing and prevent invalid input/output at runtime.\n+- Support long-running execution patterns: waiting on events, suspend/resume, and snapshots.\n+- Provide a versioned runtime API so code remains forward-compatible.\n+\n+## Non-goals\n+- Defining the full sandboxing / isolation strategy.\n+- Defining the persistence format for snapshots.\n+- Defining the complete event transport implementation.\n+\n+## Starlark program structure\n+\n+### Entrypoint\n+All Starlark functions and workflows MUST expose a `main(ctx, input)` function.\n+\n+- `ctx` is a runtime-provided context object.\n+- `input` is the validated input object matching the entrypoint `params` schema.\n+\n+`main()` MUST return a value matching the entrypoint `returns` schema or terminate execution via `r_exit(...)`.\n+\n+## Strong type system\n+\n+### Source of truth\n+The source of truth for function/workflow types is the GTS-identified JSON Schema:\n+- `params` (input)\n+- `returns` (output)\n+- `errors` (error envelope types)\n+\n+### Validation rules\n+- On function registration, the runtime MUST validate `params` against the entrypoint schema before executing Starlark.\n+- Similarly, the runtime MUST validate the returned value against the `returns` schema.\n+- For workflows, the runtime MUST validate snapshot state and resumption input before continuing.\n+\n+### Starlark typing model\n+Starlark is dynamically typed, but the runtime enforces a strong type system by:\n+- validating boundary values (input/output)\n+- validating `r_*` method arguments (e.g., `url` must be string)\n+- validating `r_wait_event(...)` against an event schema ID and payload schema\n+\n+For maximum ergonomics and stricter typing, the runtime SHOULD materialize validated inputs as a Starlark `struct(...)` with fields matching the JSON Schema properties (instead of a generic dict). This enables `input.customer_id` style access.\n+\n+All objects returned to the caller MUST be compatible with the JSON Schema types declared in `returns`.\n+In practice, this means Starlark programs MUST treat returned objects as strongly typed structs:\n+- no missing required fields\n+- no additional fields when `additionalProperties` is false\n+- field types must match schema\n+\n+## Runtime helper methods (versioned)\n+All runtime helper methods (`r_*`) MUST be versioned to preserve compatibility across functions and workflows.\n+\n+### Common conventions\n+- All helper names are prefixed with `r_`.\n+- Methods that perform I/O MUST be async and return a promise.\n+- Methods that influence control flow (`r_exit`, `r_snapshot`) MUST be deterministic.\n+\n+To preserve determinism and replayability, Starlark programs MUST NOT use nondeterministic sources such as embedded `datetime.now()` or `random.random()`.\n+If time or randomness is required, it MUST be obtained via runtime helpers provided by the Rust host.\n+\n+### Promise and await\n+The runtime provides a minimal async model:\n+\n+- `Promise<T>` is an opaque runtime object.\n+- `r_await(promise)` waits for the promise to resolve and returns `T`.\n+\n+The runtime MAY also support `r_await_all([p1, p2, ...])` to resolve multiple promises concurrently.\n+\n+If `r_await(...)` is called on a promise that cannot complete without external input (event or timer), the runtime MUST suspend the invocation and resume it when the promise becomes ready.\n+\n+### HTTP helpers\n+\n+#### Response shape\n+`r_http_*_v1()` resolves to an `HttpResult` value which never raises exceptions and can represent either a successful HTTP response or an error.\n+\n+`HttpResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access (`result.ok`, `result.response`, `result.error`).\n+\n+Successful response:\n+- `ok` (boolean, `true`)\n+- `response` (a Starlark `struct(...)`)\n+  - `status_code` (integer)\n+  - `headers` (dict)\n+  - `body` (dict)\n+\n+Error response:\n+- `ok` (boolean, `false`)\n+- `error` (a Starlark `struct(...)`) compatible with the runtime error envelope defined in `2_ADR_ENTRYPOINT.md`.\n+  - for non-2xx upstream responses: `gts.x.core.faas.err.v1~x.core._.http.v1~`\n+  - for upstream transport failures: `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~` and `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~`\n+  - for runtime failures: `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~`, and `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~`\n+\n+If the upstream response body is not JSON, the runtime SHOULD return an empty object for `response.body`.\n+\n+#### r_http_get_v1(...)\n+Signature:\n+- `r_http_get_v1(url, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+Notes:\n+- `url` is required.\n+- `headers` is an optional dict.\n+- `timeout_ms` is optional.\n+- `retry` is optional runtime-defined retry policy (e.g., {\"max_attempts\": 3, \"backoff_ms\": 200}).\n+- `exit_on_http_error=true` means the runtime calls `r_exit(...)` on non-2xx upstream responses or on upstream transport failures.\n+- `exit_on_http_error=false` means the promise resolves to an `HttpResult` and the Starlark code is responsible for handling `ok=false` and/or non-2xx status codes.\n+\n+NOTE: The runtime MUST NOT perform outbound HTTP requests directly. Instead, it MUST delegate outbound calls to the outbound API gateway so that security context, credential management, and internal-to-external token/authorization exchange are applied consistently and all egress traffic is centrally enforced and observed.\n+\n+#### r_http_post_v1(...)\n+Signature:\n+- `r_http_post_v1(url, body, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+### Sleep\n+- `r_sleep(milliseconds) -> Promise<None>`\n+\n+### Time and randomness (deterministic)\n+- `r_now_v1() -> string`\n+- `r_rand_v1(label=None) -> string`\n+\n+`r_now_v1()` returns a runtime-provided timestamp string. For workflows, the runtime MUST ensure the returned value is replay-safe (e.g., captured/recorded at a deterministic boundary and reused on resume).\n+\n+`r_rand_v1(...)` returns a runtime-provided pseudo-random value. For workflows, the runtime MUST ensure the returned value is replay-safe (e.g., derived from invocation identity + an optional label, and/or recorded for deterministic replay).\n+\n+### Exit\n+- `r_exit(error) -> None`\n+\n+`error` MUST be an object compatible with the runtime error envelope.\n+\n+For workflows, calling `r_exit(...)` terminates execution and triggers compensation for previously completed steps:\n+- the runtime MUST execute all registered compensation actions for steps that completed successfully prior to the `r_exit(...)` call\n+- compensations MUST be executed in reverse step completion order\n+- the runtime MUST NOT invoke compensation for steps that did not complete successfully\n+\n+### Event waiting\n+\n+#### r_wait_event_v1(...)\n+Signature:\n+- `r_wait_event_v1(event_type_id, event_filter_query=None, timeout_ms=None, exit_on_error=True) -> Promise<EventWaitResult>`\n+\n+- `event_type_id` MUST be a GTS type ID string ending with `~` (e.g., `gts.x.core.events.event.v1~vendor.app.some.event.v1~`).\n+- `event_filter_query` MUST be a valid event filter query string supported by the event broker.\n+- `timeout_ms` MUST be a non-negative integer.\n+- The event payload MUST be validated against the event type schema.\n+\n+`EventWaitResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access.\n+\n+- `struct(ok = True, value = <Event>)` when the event is received\n+- `struct(ok = False, error = <FaaS Error envelope>)` when the wait fails\n+\n+When an error occurs while waiting (including a timeout):\n+- if `exit_on_error=true`, the runtime MUST call `r_exit(...)` with an error envelope\n+- if `exit_on_error=false`, the promise MUST resolve with `struct(ok = False, error = ...)`\n+\n+When `timeout_ms` is provided and the timeout occurs, the error envelope id MUST be `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`.\n+\n+Waiting on an event is implemented by:\n+- the runtime suspending the invocation\n+- registering an event subscription\n+- resuming execution when the event arrives or timeout occurs\n+\n+### Snapshotting\n+\n+#### r_snapshot_v1(...)","path":"modules/serverless_runtime/docs/3_ADR_STARLARK_RUNTIME.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"shouldn't we implicitely make shapshots of state on every side-effect invocation? what is the purpose of explicit snapshots?","created_at":"2026-01-15T12:38:54Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694224312","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694224312"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694224312"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694224312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":251,"original_line":251,"side":"RIGHT","author_association":"MEMBER","original_position":251,"position":251,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694258703","pull_request_review_id":3665451041,"id":2694258703,"node_id":"PRRC_kwDOPaLyBs6glyAP","diff_hunk":"@@ -0,0 +1,1267 @@\n+# ADR — Serverless Runtime Entrypoints (Function & Workflow Definitions, Invocation API)\n+\n+## Status\n+Proposed\n+\n+## Context\n+The Serverless Runtime module needs a stable, tenant-safe way to:\n+- register functions & workflows schema and code definitions at runtime\n+- invoke those definitions via API\n+- observe execution progress and outcomes\n+\n+This ADR defines:\n+- GTS-based identifiers and JSON Schema conventions for functions & workflows definitions\n+- definition “traits” (semantics, limits, runtime, error types)\n+- invocation API (start, status, cancel, dry-run) with observability fields\n+\n+## Classifications\n+\n+### Function\n+\n+Functions are single-unit compute entrypoints designed for request/response execution:\n+- Stateless with respect to the runtime (any durable state is stored externally).\n+- Typically short-lived (bounded by platform timeout limits).\n+- Commonly used as building blocks for APIs, event handlers, and single-step jobs.\n+- Retries are common; authors SHOULD design for idempotency when side effects are possible.\n+\n+Event waiting is supported by the platform via execution suspension and later resumption.\n+For functions this is an advanced capability and is primarily relevant for asynchronous execution.\n+\n+### Workflow\n+\n+Workflows are durable, multi-step orchestrations that coordinate one or more actions over time.\n+A workflow is a definition that may contain multiple execution steps, suspension points, and runtime-managed continuation.\n+- Persisted execution state (durable progress across restarts).\n+- Supports long-running behavior (timers, waiting on external events, human-in-the-loop patterns).\n+- Encodes orchestration logic (fan-out/fan-in, branching, retries, compensation) over multiple steps.\n+- Individual steps are commonly implemented by calling functions or external integrations.\n+\n+For workflows, the underlying code interpreter/runtime is responsible for typical workflow execution processing, including:\n+- step identification\n+- step retry scheduling and retry status\n+- compensation orchestration\n+- checkpointing and suspend/resume\n+- event subscription and event-driven continuation\n+\n+Event waiting for workflows is implemented via suspension plus event subscription, with runtime-level examples defined in the code runtime document (e.g. Starlark).\n+\n+In Hyperspot, functions and workflows use the same entrypoint definition schema and the same implementation language constructs (if/else, loops, variables, etc.).\n+In practice, everything is defined and invoked as a function entrypoint, and the selected runtime MAY determine that a given entrypoint should be treated as a workflow by analyzing the code during validation. For example, the Starlark runtime can validate the program and detect runtime durability primitives (e.g., checkpoints/snapshots or awaiting events/timers); if present, the runtime can apply workflow execution semantics (durable suspend/resume and continuation) rather than treating it as a regular short-lived function.\n+The practical difference is execution semantics:\n+- Workflows are typically **async** and include internal snapshot/checkpoint behavior so the runtime can persist progress and support suspend/resume.\n+- Functions are typically **sync**, short-lived, and stateless with respect to the runtime.\n+\n+## Synchronous vs Asynchronous\n+\n+Functions and workflows can be executed synchronously or asynchronously.\n+\n+- **sync**\n+  - The client waits for completion and receives the result (or error) in the HTTP response.\n+  - This is constrained by HTTP and gateway timeouts, so it is best for short executions.\n+\n+- **async**\n+  - The client receives an `invocation_id` immediately and retrieves status/results later via the status endpoint.\n+  - The client “polls” for completion:\n+    - **Short poll**: `GET` returns immediately with the latest known status.\n+    - **Long poll**: `GET` waits up to a timeout before returning (otherwise identical semantics); this reduces client round-trips while still using polling.\n+\n+## Functions & Workflows identifier conventions\n+\n+Both functions and workflows use the same schema and semantic definition following `https://github.com/GlobalTypeSystem/gts-spec` specification.\n+\n+According to GTS specification, function/workflow contract definitions are represented as GTS **types** (JSON Schema documents), identified by `$id` values that end with `~`.\n+\n+* Base function/workflow definition:\n+  - `gts.x.core.faas.func.v1~` - defines the base function/workflow definition schema, including placeholders for `params`, `returns`, `errors`, and the schema for `traits` (semantics) such as timeouts and limits.\n+\n+* Specific function/workflow definitions:\n+  - are derived GTS types (JSON Schemas) that reference the base type (typically via `allOf`) and then pin concrete `params`, `returns`, and initialized `traits` values.\n+\n+Functions/workflows identifier examples:\n+  - `gts.x.core.faas.func.v1~vendor_x.app.namespace.func_name.v1~`\n+  - `gts.x.core.faas.func.v1~vendor_y.pkg.domain.workflow_name.v1~`\n+\n+The invocation API uses GTS ID to refer to the specific function/workflow definition type identifier (the `$id` value without the `gts://` prefix).\n+\n+## Schemas\n+This section defines base schema for functions/workflows definitions.\n+\n+### Base schema: Entrypoint Definition\n+**Schema ID (type):** `gts.x.core.faas.func.v1~`\n+\n+Main schema elements are:\n+- `id` - base function/workflow type identifier.\n+- `params` - function input schema, to be refined by specific functions/workflows.\n+- `returns` - function output schema, to be refined by specific functions/workflows.\n+- `errors` - list of possible custom error type identifiers (GTS IDs).\n+- `traits` - schema for `traits` (semantics) such as timeouts and limits, that must be pinned by specific functions/workflows (e.g., with property-level `const`)\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~\",\n+  \"title\": \"FaaS Function Definition\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"properties\": {\n+    \"id\": {\n+      \"type\": \"string\",\n+      \"description\": \"Well-known type identifier of this function/workflow definition.\",\n+      \"examples\": [\"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\"]\n+    },\n+\n+    \"title\": { \"type\": \"string\" },\n+    \"description\": { \"type\": \"string\" },\n+\n+    \"params\": {\n+      \"description\": \"Function input schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void params\"}\n+      ]\n+    },\n+\n+    \"returns\": {\n+      \"description\": \"Function output schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void returns\"}\n+      ]\n+    },\n+\n+    \"errors\": {\n+      \"type\": \"array\",\n+      \"items\": {\"type\": \"string\"},\n+      \"default\": [],\n+      \"description\": \"List of possible customerror type identifiers (GTS IDs).\"\n+    },\n+\n+    \"traits\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"entrypoint\": {\n+          \"type\": \"boolean\",\n+          \"default\": true,\n+          \"description\": \"If true, the function is externally callable via the invocation API. If false, it is internal-only and can be referenced only from other workflows/functions.\"\n+        },\n+        \"is_idempotent\": {\n+          \"type\": \"boolean\",\n+          \"default\": false,\n+          \"description\": \"Whether repeated execution with the same effective input produces the same effect.\"\n+        },\n+\n+        \"invocation\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"supported\": {\n+              \"type\": \"array\",\n+              \"items\": {\"type\": \"string\", \"enum\": [\"sync\", \"async\"]},\n+              \"minItems\": 1,\n+              \"uniqueItems\": true,\n+              \"default\": [\"async\"],\n+              \"description\": \"Which invocation modes this entrypoint supports.\"\n+            },\n+            \"default\": {\n+              \"type\": \"string\",\n+              \"enum\": [\"sync\", \"async\"],\n+              \"default\": \"async\",\n+              \"description\": \"Default invocation mode if the caller does not specify one.\"\n+            }\n+          },\n+          \"required\": [\"supported\"]\n+        },\n+\n+        \"caching\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"description\": \"Client caching policy for successful results. Cache reuse is ALWAYS scoped by tenant, caller token/identity, all request headers, and the full `params` payload. This trait is a hint for the caller: the function owner is responsible for providing a reasonable hint, and the runtime cannot guarantee that a cached value equals what the function would return now. This trait only defines freshness TTL.\",\n+          \"properties\": {\n+            \"max_age_seconds\": {\n+              \"type\": \"integer\",\n+              \"minimum\": 0,\n+              \"default\": 0,\n+              \"description\": \"How long a cached result is considered fresh (TTL). 0 means no caching (clients MUST NOT reuse cached results). TTL is a client-side reuse hint and does not guarantee correctness under non-determinism, data drift, or changing upstream dependencies.\"\n+            }\n+          },\n+          \"required\": [\"max_age_seconds\"]\n+        },\n+        \"runtime\": {\n+          \"type\": \"string\",\n+          \"description\": \"Mandatory runtime selector (e.g., Starlark, WASM, AWS Lambda, etc.).\"\n+        },\n+\n+        \"default_timeout_seconds\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Default timeout for this function/workflow in seconds.\"\n+        },\n+        \"default_memory_mb\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Default memory allocation for this function/workflow in MB.\"\n+        },\n+        \"default_cpu\": {\n+          \"type\": \"number\",\n+          \"minimum\": 0,\n+          \"description\": \"Default CPU allocation for this function/workflow.\"\n+        },\n+\n+        \"localization_dictionary_id\": {\n+          \"type\": \"string\",\n+          \"description\": \"Optional localization dictionary reference (GTS ID).\"\n+        },\n+\n+        \"tags\": {\n+          \"type\": \"array\",\n+          \"items\": {\"type\": \"string\"},\n+          \"default\": [],\n+          \"description\": \"Optional tags for this function/workflow categorization, searchability, etc.\"\n+        }\n+\n+      },\n+      \"required\": [\"runtime\"]\n+    },\n+\n+    \"implementation\": {","path":"modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"pr0tey","id":1847966,"node_id":"MDQ6VXNlcjE4NDc5NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1847966?v=4","gravatar_id":"","url":"https://api.github.com/users/pr0tey","html_url":"https://github.com/pr0tey","followers_url":"https://api.github.com/users/pr0tey/followers","following_url":"https://api.github.com/users/pr0tey/following{/other_user}","gists_url":"https://api.github.com/users/pr0tey/gists{/gist_id}","starred_url":"https://api.github.com/users/pr0tey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pr0tey/subscriptions","organizations_url":"https://api.github.com/users/pr0tey/orgs","repos_url":"https://api.github.com/users/pr0tey/repos","events_url":"https://api.github.com/users/pr0tey/events{/privacy}","received_events_url":"https://api.github.com/users/pr0tey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"What about the dependencies of the code?","created_at":"2026-01-15T12:49:24Z","updated_at":"2026-01-15T12:49:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694258703","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694258703"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694258703"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694258703/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":229,"original_line":229,"side":"RIGHT","author_association":"MEMBER","original_position":229,"position":229,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694292197","pull_request_review_id":3665259141,"id":2694292197,"node_id":"PRRC_kwDOPaLyBs6gl6Ll","diff_hunk":"@@ -0,0 +1,1267 @@\n+# ADR — Serverless Runtime Entrypoints (Function & Workflow Definitions, Invocation API)\n+\n+## Status\n+Proposed\n+\n+## Context\n+The Serverless Runtime module needs a stable, tenant-safe way to:\n+- register functions & workflows schema and code definitions at runtime\n+- invoke those definitions via API\n+- observe execution progress and outcomes\n+\n+This ADR defines:\n+- GTS-based identifiers and JSON Schema conventions for functions & workflows definitions\n+- definition “traits” (semantics, limits, runtime, error types)\n+- invocation API (start, status, cancel, dry-run) with observability fields\n+\n+## Classifications\n+\n+### Function\n+\n+Functions are single-unit compute entrypoints designed for request/response execution:\n+- Stateless with respect to the runtime (any durable state is stored externally).\n+- Typically short-lived (bounded by platform timeout limits).\n+- Commonly used as building blocks for APIs, event handlers, and single-step jobs.\n+- Retries are common; authors SHOULD design for idempotency when side effects are possible.\n+\n+Event waiting is supported by the platform via execution suspension and later resumption.\n+For functions this is an advanced capability and is primarily relevant for asynchronous execution.\n+\n+### Workflow\n+\n+Workflows are durable, multi-step orchestrations that coordinate one or more actions over time.\n+A workflow is a definition that may contain multiple execution steps, suspension points, and runtime-managed continuation.\n+- Persisted execution state (durable progress across restarts).\n+- Supports long-running behavior (timers, waiting on external events, human-in-the-loop patterns).\n+- Encodes orchestration logic (fan-out/fan-in, branching, retries, compensation) over multiple steps.\n+- Individual steps are commonly implemented by calling functions or external integrations.\n+\n+For workflows, the underlying code interpreter/runtime is responsible for typical workflow execution processing, including:\n+- step identification\n+- step retry scheduling and retry status\n+- compensation orchestration\n+- checkpointing and suspend/resume\n+- event subscription and event-driven continuation\n+\n+Event waiting for workflows is implemented via suspension plus event subscription, with runtime-level examples defined in the code runtime document (e.g. Starlark).\n+\n+In Hyperspot, functions and workflows use the same entrypoint definition schema and the same implementation language constructs (if/else, loops, variables, etc.).\n+In practice, everything is defined and invoked as a function entrypoint, and the selected runtime MAY determine that a given entrypoint should be treated as a workflow by analyzing the code during validation. For example, the Starlark runtime can validate the program and detect runtime durability primitives (e.g., checkpoints/snapshots or awaiting events/timers); if present, the runtime can apply workflow execution semantics (durable suspend/resume and continuation) rather than treating it as a regular short-lived function.\n+The practical difference is execution semantics:\n+- Workflows are typically **async** and include internal snapshot/checkpoint behavior so the runtime can persist progress and support suspend/resume.\n+- Functions are typically **sync**, short-lived, and stateless with respect to the runtime.\n+\n+## Synchronous vs Asynchronous\n+\n+Functions and workflows can be executed synchronously or asynchronously.\n+\n+- **sync**\n+  - The client waits for completion and receives the result (or error) in the HTTP response.\n+  - This is constrained by HTTP and gateway timeouts, so it is best for short executions.\n+\n+- **async**\n+  - The client receives an `invocation_id` immediately and retrieves status/results later via the status endpoint.\n+  - The client “polls” for completion:\n+    - **Short poll**: `GET` returns immediately with the latest known status.\n+    - **Long poll**: `GET` waits up to a timeout before returning (otherwise identical semantics); this reduces client round-trips while still using polling.\n+\n+## Functions & Workflows identifier conventions\n+\n+Both functions and workflows use the same schema and semantic definition following `https://github.com/GlobalTypeSystem/gts-spec` specification.\n+\n+According to GTS specification, function/workflow contract definitions are represented as GTS **types** (JSON Schema documents), identified by `$id` values that end with `~`.\n+\n+* Base function/workflow definition:\n+  - `gts.x.core.faas.func.v1~` - defines the base function/workflow definition schema, including placeholders for `params`, `returns`, `errors`, and the schema for `traits` (semantics) such as timeouts and limits.\n+\n+* Specific function/workflow definitions:\n+  - are derived GTS types (JSON Schemas) that reference the base type (typically via `allOf`) and then pin concrete `params`, `returns`, and initialized `traits` values.\n+\n+Functions/workflows identifier examples:\n+  - `gts.x.core.faas.func.v1~vendor_x.app.namespace.func_name.v1~`\n+  - `gts.x.core.faas.func.v1~vendor_y.pkg.domain.workflow_name.v1~`\n+\n+The invocation API uses GTS ID to refer to the specific function/workflow definition type identifier (the `$id` value without the `gts://` prefix).\n+\n+## Schemas\n+This section defines base schema for functions/workflows definitions.\n+\n+### Base schema: Entrypoint Definition\n+**Schema ID (type):** `gts.x.core.faas.func.v1~`\n+\n+Main schema elements are:\n+- `id` - base function/workflow type identifier.\n+- `params` - function input schema, to be refined by specific functions/workflows.\n+- `returns` - function output schema, to be refined by specific functions/workflows.\n+- `errors` - list of possible custom error type identifiers (GTS IDs).\n+- `traits` - schema for `traits` (semantics) such as timeouts and limits, that must be pinned by specific functions/workflows (e.g., with property-level `const`)\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~\",\n+  \"title\": \"FaaS Function Definition\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"properties\": {\n+    \"id\": {\n+      \"type\": \"string\",\n+      \"description\": \"Well-known type identifier of this function/workflow definition.\",\n+      \"examples\": [\"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\"]\n+    },\n+\n+    \"title\": { \"type\": \"string\" },\n+    \"description\": { \"type\": \"string\" },\n+\n+    \"params\": {\n+      \"description\": \"Function input schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void params\"}\n+      ]\n+    },\n+\n+    \"returns\": {\n+      \"description\": \"Function output schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void returns\"}\n+      ]\n+    },\n+\n+    \"errors\": {\n+      \"type\": \"array\",\n+      \"items\": {\"type\": \"string\"},\n+      \"default\": [],\n+      \"description\": \"List of possible customerror type identifiers (GTS IDs).\"\n+    },\n+\n+    \"traits\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"entrypoint\": {\n+          \"type\": \"boolean\",\n+          \"default\": true,\n+          \"description\": \"If true, the function is externally callable via the invocation API. If false, it is internal-only and can be referenced only from other workflows/functions.\"\n+        },\n+        \"is_idempotent\": {\n+          \"type\": \"boolean\",\n+          \"default\": false,\n+          \"description\": \"Whether repeated execution with the same effective input produces the same effect.\"\n+        },\n+\n+        \"invocation\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"supported\": {\n+              \"type\": \"array\",\n+              \"items\": {\"type\": \"string\", \"enum\": [\"sync\", \"async\"]},\n+              \"minItems\": 1,\n+              \"uniqueItems\": true,\n+              \"default\": [\"async\"],\n+              \"description\": \"Which invocation modes this entrypoint supports.\"\n+            },\n+            \"default\": {\n+              \"type\": \"string\",\n+              \"enum\": [\"sync\", \"async\"],\n+              \"default\": \"async\",\n+              \"description\": \"Default invocation mode if the caller does not specify one.\"\n+            }\n+          },\n+          \"required\": [\"supported\"]\n+        },\n+\n+        \"caching\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"description\": \"Client caching policy for successful results. Cache reuse is ALWAYS scoped by tenant, caller token/identity, all request headers, and the full `params` payload. This trait is a hint for the caller: the function owner is responsible for providing a reasonable hint, and the runtime cannot guarantee that a cached value equals what the function would return now. This trait only defines freshness TTL.\",\n+          \"properties\": {\n+            \"max_age_seconds\": {\n+              \"type\": \"integer\",\n+              \"minimum\": 0,\n+              \"default\": 0,\n+              \"description\": \"How long a cached result is considered fresh (TTL). 0 means no caching (clients MUST NOT reuse cached results). TTL is a client-side reuse hint and does not guarantee correctness under non-determinism, data drift, or changing upstream dependencies.\"\n+            }\n+          },\n+          \"required\": [\"max_age_seconds\"]\n+        },\n+        \"runtime\": {\n+          \"type\": \"string\",\n+          \"description\": \"Mandatory runtime selector (e.g., Starlark, WASM, AWS Lambda, etc.).\"\n+        },\n+\n+        \"default_timeout_seconds\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Default timeout for this function/workflow in seconds.\"\n+        },\n+        \"default_memory_mb\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Default memory allocation for this function/workflow in MB.\"\n+        },\n+        \"default_cpu\": {\n+          \"type\": \"number\",\n+          \"minimum\": 0,\n+          \"description\": \"Default CPU allocation for this function/workflow.\"\n+        },\n+\n+        \"localization_dictionary_id\": {\n+          \"type\": \"string\",\n+          \"description\": \"Optional localization dictionary reference (GTS ID).\"\n+        },\n+\n+        \"tags\": {\n+          \"type\": \"array\",\n+          \"items\": {\"type\": \"string\"},\n+          \"default\": [],\n+          \"description\": \"Optional tags for this function/workflow categorization, searchability, etc.\"\n+        }\n+\n+      },\n+      \"required\": [\"runtime\"]\n+    },\n+\n+    \"implementation\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"code\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"language\": {\"type\": \"string\"},\n+            \"source\": {\n+              \"type\": \"string\",\n+              \"description\": \"Inline source code (optional).\"\n+            }\n+          },\n+          \"required\": [\"language\"]\n+        }\n+      },\n+      \"description\": \"Execution implementation. `code` MUST be provided.\",\n+      \"minProperties\": 1,\n+      \"required\": [\"code\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"params\", \"returns\", \"traits\", \"implementation\"]\n+}\n+```\n+\n+### Base schema: Error\n+**Schema ID (type):** `gts.x.core.faas.err.v1~`\n+\n+This is the base error envelope returned by the runtime (and referenced by entrypoints via `errors`). Derived error types specialize the `details` field.\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~\",\n+  \"title\": \"FaaS Error\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"properties\": {\n+    \"id\": {\n+      \"type\": \"string\",\n+      \"description\": \"Error code identifier (GTS ID).\",\n+      \"examples\": [\"gts.x.core.faas.err.v1~x.core._.code.v1~\"]\n+    },\n+    \"message\": {\n+      \"type\": \"string\",\n+      \"description\": \"Human-readable error message.\"\n+    },\n+    \"details\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": true,\n+      \"description\": \"Error-class-specific structured payload.\"\n+    }\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Upstream HTTP error\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.http.v1~`\n+\n+Used for failures from upstream HTTP calls (e.g., `r_http_get_v1()`). This schema specializes `details`.\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.http.v1~\",\n+  \"title\": \"FaaS Upstream HTTP Error\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.http.v1~\"},\n+    \"details\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"status_code\": {\"type\": \"integer\", \"minimum\": 100, \"maximum\": 599},\n+        \"headers\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": {\n+            \"oneOf\": [\n+              {\"type\": \"string\"},\n+              {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n+            ]\n+          }\n+        },\n+        \"body\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": true,\n+          \"description\": \"Parsed JSON body when available; otherwise an empty object.\"\n+        }\n+      },\n+      \"required\": [\"status_code\", \"headers\", \"body\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Upstream HTTP transport error (timeout / no connection)\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.http_transport.v1~`\n+\n+Used for upstream HTTP call failures where **no HTTP response** is available (e.g., timeout, connection failure). This schema specializes `details`.\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.http_transport.v1~\",\n+  \"title\": \"FaaS Upstream HTTP Transport Error\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.http_transport.v1~\"},\n+    \"details\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"url\": {\"type\": \"string\"}\n+      },\n+      \"required\": [\"url\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Upstream HTTP transport timeout\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~\",\n+  \"title\": \"FaaS Upstream HTTP Transport Timeout\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.http_transport.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Upstream HTTP transport no connection\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~\",\n+  \"title\": \"FaaS Upstream HTTP Transport No Connection\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.http_transport.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Runtime resource/timeout error\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.runtime.v1~`\n+\n+Used when the runtime aborts execution due to resource limits or platform constraints.\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~\",\n+  \"title\": \"FaaS Runtime Error\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~\"},\n+    \"details\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"limit\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"timeout_seconds\": {\"type\": \"integer\", \"minimum\": 1},\n+            \"memory_limit_mb\": {\"type\": \"integer\", \"minimum\": 1},\n+            \"cpu_limit\": {\"type\": \"number\", \"minimum\": 0}\n+          }\n+        },\n+        \"observed\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"duration_ms\": {\"type\": \"integer\", \"minimum\": 0},\n+            \"cpu_time_ms\": {\"type\": \"integer\", \"minimum\": 0},\n+            \"max_memory_used_mb\": {\"type\": \"integer\", \"minimum\": 0}\n+          }\n+        }\n+      },\n+      \"required\": []\n+    }\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Runtime timeout\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~\",\n+  \"title\": \"FaaS Runtime Timeout\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Runtime memory limit\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~\",\n+  \"title\": \"FaaS Runtime Memory Limit\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Runtime CPU limit\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~\",\n+  \"title\": \"FaaS Runtime CPU Limit\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Runtime canceled\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~`\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~\",\n+  \"title\": \"FaaS Runtime Canceled\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~x.core._.runtime.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~\"}\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+### Derived error schema: Code execution/validation error\n+**Schema ID (type):** `gts.x.core.faas.err.v1~x.core._.code.v1~`\n+\n+Used for code-level failures produced by the selected runtime (e.g., Starlark validation/compile/runtime errors).\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.err.v1~x.core._.code.v1~\",\n+  \"title\": \"FaaS Code Error\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.err.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.err.v1~x.core._.code.v1~\"},\n+    \"details\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"runtime\": {\"type\": \"string\", \"description\": \"Language/runtime identifier (e.g., starlark).\"},\n+        \"phase\": {\"type\": \"string\", \"enum\": [\"validate\", \"compile\", \"execute\"]},\n+        \"error_kind\": {\"type\": \"string\", \"description\": \"Runtime-specific diagnostic kind/code (not an exception).\"},\n+        \"location\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"line\": {\"type\": \"integer\", \"minimum\": 1},\n+            \"code\": {\"type\": \"string\"}\n+          },\n+          \"required\": [\"line\", \"code\"]\n+        },\n+        \"stack\": {\n+          \"type\": \"object\",\n+          \"additionalProperties\": false,\n+          \"properties\": {\n+            \"frames\": {\n+              \"type\": \"array\",\n+              \"items\": {\n+                \"type\": \"object\",\n+                \"additionalProperties\": false,\n+                \"properties\": {\n+                  \"function\": {\"type\": \"string\"},\n+                  \"file\": {\"type\": \"string\"},\n+                  \"line\": {\"type\": \"integer\", \"minimum\": 1}\n+                },\n+                \"required\": [\"function\", \"file\", \"line\"]\n+              }\n+            }\n+          },\n+          \"required\": [\"frames\"]\n+        }\n+      },\n+      \"required\": [\"runtime\", \"phase\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"message\", \"details\"]\n+}\n+```\n+\n+## Examples\n+### Function definition type example #1\n+\n+This is a tax calculation function example written in Starlark that:\n+- Supports both sync and async invocation (default is async)\n+- Idempotent\n+- Includes default resource/time limits\n+- Enables client caching for 60 seconds (within tenant + token/identity + headers + params)\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~vendor.app.billing.calculate_tax.v1~\",\n+  \"title\": \"Calculate Tax\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.func.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.func.v1~vendor.app.billing.calculate_tax.v1~\"},\n+    \"params\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"invoice_total\": {\"type\": \"number\"},\n+          \"region\": {\"type\": \"string\"}\n+        },\n+        \"required\": [\"invoice_total\", \"region\"]\n+      }\n+    },\n+    \"returns\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"tax\": {\"type\": \"number\"}\n+        },\n+        \"required\": [\"tax\"]\n+      }\n+    },\n+    \"errors\": {\"const\": [\"gts.x.core.faas.err.v1~x.core._.code.v1~\", \"gts.x.core.faas.err.v1~vendor.app.billing.tax_error.v1~\"]},\n+    \"traits\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"runtime\": {\"const\": \"starlark\"},\n+        \"is_idempotent\": {\"const\": true},\n+        \"invocation\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"supported\": {\"const\": [\"sync\", \"async\"]},\n+            \"default\": {\"const\": \"async\"}\n+          }\n+        },\n+        \"default_timeout_seconds\": {\"const\": 10},\n+        \"default_memory_mb\": {\"const\": 128},\n+        \"caching\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"max_age_seconds\": {\"const\": 60}\n+          },\n+          \"required\": [\"max_age_seconds\"]\n+        }\n+      }\n+    },\n+    \"implementation\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"code\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"language\": {\"const\": \"starlark\"},\n+            \"source\": {\"const\": \"def main(ctx, input):\\n  return {\\\"tax\\\": 0}\\n\"}\n+          },\n+          \"required\": [\"language\"]\n+        }\n+      },\n+      \"required\": [\"code\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"params\", \"returns\", \"traits\", \"implementation\"]\n+}\n+```\n+\n+### Function definition type example #2\n+\n+This is an example of a customer lookup function written in Starlark that:\n+- Supports both sync and async invocation (default is sync)\n+- Idempotent\n+- No client caching by default (`max_age_seconds = 0`)\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~vendor.app.crm.lookup_customer.v1~\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.func.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.func.v1~vendor.app.crm.lookup_customer.v1~\"},\n+    \"params\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"customer_id\": {\"type\": \"string\"}\n+        },\n+        \"required\": [\"customer_id\"]\n+      }\n+    },\n+    \"returns\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"customer\": {\n+            \"type\": \"object\",\n+            \"additionalProperties\": true\n+          }\n+        },\n+        \"required\": [\"customer\"]\n+      }\n+    },\n+    \"traits\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"runtime\": {\"const\": \"starlark\"},\n+        \"is_idempotent\": {\"const\": true},\n+        \"invocation\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"supported\": {\"const\": [\"sync\", \"async\"]},\n+            \"default\": {\"const\": \"sync\"}\n+          }\n+        },\n+        \"default_timeout_seconds\": {\"const\": 5},\n+        \"caching\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"max_age_seconds\": {\"const\": 0}\n+          },\n+          \"required\": [\"max_age_seconds\"]\n+        }\n+      }\n+    },\n+    \"implementation\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"code\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"language\": {\"const\": \"starlark\"},\n+            \"source\": {\"const\": \"def main(ctx, input):\\\\n  url = \\\"https://example.crm/api/customer/\\\" + input[\\\"customer_id\\\"]\\\\n  resp = r_http_get_v1(url)\\\\n  return {\\\"customer\\\": resp}\\\\n\"}\n+          },\n+          \"required\": [\"language\"]\n+        }\n+      },\n+      \"required\": [\"code\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"params\", \"returns\", \"traits\", \"implementation\"]\n+}\n+```\n+\n+## Invocation API (Entrypoint)\n+### Principles\n+- Executed invocations produce an **invocation record** with a stable `invocation_id`.\n+- Invocations SHOULD support:\n+  - `Idempotency-Key` (to prevent duplicate starts)\n+  - `X-Request-Id` / correlation id\n+  - `traceparent` (W3C trace context)\n+- Invocation status is obtained via a dedicated endpoint.\n+\n+Throttling and rate limiting:\n+- The runtime SHOULD enforce throttling to protect itself and downstream dependencies (e.g., per-tenant rate limits, per-entrypoint concurrency caps).\n+- When throttled, the runtime SHOULD return `429 Too Many Requests` and SHOULD include `Retry-After`.\n+\n+Dry run vs execute:\n+- `dry_run: true` performs validation (including authorization) without creating a durable invocation record.\n+- This aligns with AWS Lambda `InvocationType=DryRun`.\n+\n+### 1) Invoke an entrypoint (sync or async)\n+`POST /api/serverless-runtime/v1/invocations`\n+\n+Request body:\n+```json\n+{\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"params\": {},\n+  \"mode\": \"async\",\n+  \"dry_run\": false\n+}\n+```\n+\n+Response:\n+- `200 OK` (when `mode` is `sync` and `dry_run` is false) — **InvocationRecord (completed)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.succeeded.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:00.010Z\",\n+    \"finished_at\": \"2026-01-01T00:00:00.120Z\"\n+  },\n+  \"result\": {\n+    \"tax\": 0\n+  },\n+  \"error\": null,\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 110,\n+      \"billed_duration_ms\": 200,\n+      \"cpu_time_ms\": 70,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 64\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` (when `mode` is `sync` and `dry_run` is false) — **InvocationRecord (failed)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.crm.lookup_customer.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.failed.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:00.010Z\",\n+    \"finished_at\": \"2026-01-01T00:00:00.120Z\"\n+  },\n+  \"result\": null,\n+  \"error\": {\n+    \"id\": \"gts.x.core.faas.err.v1~x.core._.http.v1~\",\n+    \"message\": \"Upstream CRM returned non-success status\",\n+    \"details\": {\n+      \"status_code\": 503,\n+      \"headers\": {\"content-type\": \"application/json\"},\n+      \"body\": {\"error\": \"service_unavailable\"}\n+    }\n+  },\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 110,\n+      \"billed_duration_ms\": 200,\n+      \"cpu_time_ms\": 70,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 64\n+    }\n+  }\n+}\n+```\n+\n+- `202 Accepted` (when `mode` is `async` and `dry_run` is false) — **InvocationRecord (pending)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.queued.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": null,\n+    \"finished_at\": null\n+  },\n+  \"result\": null,\n+  \"error\": null,\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": null,\n+      \"billed_duration_ms\": null,\n+      \"cpu_time_ms\": null,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": null\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` (when `dry_run` is true)\n+```json\n+{\n+  \"dry_run\": true,\n+  \"result\": {},\n+  \"error\": null,\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": null,\n+      \"billed_duration_ms\": null,\n+      \"cpu_time_ms\": null,\n+      \"memory_limit_mb\": null,\n+      \"max_memory_used_mb\": null\n+    }\n+  }\n+}\n+```\n+\n+### 2) Get invocation status\n+`GET /api/serverless-runtime/v1/invocations/{invocation_id}`\n+\n+Response:\n+- `200 OK` — **InvocationRecord (pending)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.queued.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": null,\n+    \"finished_at\": null\n+  },\n+  \"result\": null,\n+  \"error\": null,\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": null,\n+      \"billed_duration_ms\": null,\n+      \"cpu_time_ms\": null,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": null\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` — **InvocationRecord (failed: code error)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.billing.calculate_tax.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.failed.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:00.010Z\",\n+    \"finished_at\": \"2026-01-01T00:00:00.020Z\"\n+  },\n+  \"result\": null,\n+  \"error\": {\n+    \"id\": \"gts.x.core.faas.err.v1~x.core._.code.v1~\",\n+    \"message\": \"Starlark execution error: division by zero\",\n+    \"details\": {\n+      \"runtime\": \"starlark\",\n+      \"phase\": \"execute\",\n+      \"error_kind\": \"division_by_zero\",\n+      \"location\": {\"line\": 12, \"code\": \"x = 1 / 0\"},\n+      \"stack\": {\n+        \"frames\": [\n+          {\"function\": \"main\", \"file\": \"inline\", \"line\": 1},\n+          {\"function\": \"calculate\", \"file\": \"inline\", \"line\": 12}\n+        ]\n+      }\n+    }\n+  },\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 10,\n+      \"billed_duration_ms\": 100,\n+      \"cpu_time_ms\": 8,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 24\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` — **InvocationRecord (failed: runtime timeout)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.failed.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:00.010Z\",\n+    \"finished_at\": \"2026-01-01T00:00:05.010Z\"\n+  },\n+  \"result\": null,\n+  \"error\": {\n+    \"id\": \"gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~\",\n+    \"message\": \"Execution timed out\",\n+    \"details\": {\n+      \"limit\": {\"timeout_seconds\": 5},\n+      \"observed\": {\"duration_ms\": 5000, \"cpu_time_ms\": 4900, \"max_memory_used_mb\": 90}\n+    }\n+  },\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 5000,\n+      \"billed_duration_ms\": 5000,\n+      \"cpu_time_ms\": 4900,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 90\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` — **InvocationRecord (failed: upstream no connection)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.crm.lookup_customer.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.failed.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:00.010Z\",\n+    \"finished_at\": \"2026-01-01T00:00:00.520Z\"\n+  },\n+  \"result\": null,\n+  \"error\": {\n+    \"id\": \"gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~\",\n+    \"message\": \"Upstream HTTP request failed\",\n+    \"details\": {\n+      \"url\": \"https://example.crm/api/customers/123\"\n+    }\n+  },\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 510,\n+      \"billed_duration_ms\": 600,\n+      \"cpu_time_ms\": 30,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 40\n+    }\n+  }\n+}\n+```\n+\n+- `200 OK` — **InvocationRecord (completed)**\n+```json\n+{\n+  \"invocation_id\": \"<opaque-id>\",\n+  \"entrypoint_id\": \"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\",\n+  \"status\": \"gts.x.core.faas.status.v1~x.core._.succeeded.v1\",\n+  \"timestamps\": {\n+    \"created_at\": \"2026-01-01T00:00:00.000Z\",\n+    \"started_at\": \"2026-01-01T00:00:01.000Z\",\n+    \"finished_at\": \"2026-01-01T00:00:02.000Z\"\n+  },\n+  \"result\": {},\n+  \"error\": null,\n+  \"observability\": {\n+    \"correlation_id\": \"<id>\",\n+    \"trace_id\": \"<trace>\",\n+    \"metrics\": {\n+      \"duration_ms\": 1000,\n+      \"billed_duration_ms\": 1000,\n+      \"cpu_time_ms\": 620,\n+      \"memory_limit_mb\": 128,\n+      \"max_memory_used_mb\": 80\n+    }\n+  }\n+}\n+```\n+\n+Status values:","path":"modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"binarycode","id":415262,"node_id":"MDQ6VXNlcjQxNTI2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/415262?v=4","gravatar_id":"","url":"https://api.github.com/users/binarycode","html_url":"https://github.com/binarycode","followers_url":"https://api.github.com/users/binarycode/followers","following_url":"https://api.github.com/users/binarycode/following{/other_user}","gists_url":"https://api.github.com/users/binarycode/gists{/gist_id}","starred_url":"https://api.github.com/users/binarycode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/binarycode/subscriptions","organizations_url":"https://api.github.com/users/binarycode/orgs","repos_url":"https://api.github.com/users/binarycode/repos","events_url":"https://api.github.com/users/binarycode/events{/privacy}","received_events_url":"https://api.github.com/users/binarycode/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"statuses as GTS ids - will this be a common practice in the project (like tenant statuses etc), or there is something in particular with function statuses that requires GTS?","created_at":"2026-01-15T12:59:27Z","updated_at":"2026-01-15T13:03:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694292197","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694292197"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2694292197"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2694292197/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1053,"original_line":1053,"side":"RIGHT","author_association":"MEMBER","original_position":1053,"position":1053,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695215521","pull_request_review_id":3666654496,"id":2695215521,"node_id":"PRRC_kwDOPaLyBs6gpbmh","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.\n+\n+### BR-134 (P1): Idempotency mechanisms\n+The platform MUST provide mechanisms to implement idempotency for workflow/function execution.\n+The system SHOULD support common idempotency patterns, including idempotency keys, deduplication windows, and correlation identifiers to track and deduplicate requests.\n+\n+### BR-135 (P1): Tenant-segmented operational metrics\n+The system MUST provide operational metrics for workflow/function execution, including volume, latency, error rates, and queue/backlog indicators, and support segmentation by tenant.\n+\n+### P2 Requirements (Nice-to-have)\n+\n+### BR-201 (P2): Archival for long-term compliance\n+The system SHOULD support long-term archival of execution history and audit records for tenants with extended compliance and reporting requirements.\n+\n+### BR-202 (P2): Workflow/function definition import/export\n+The system SHOULD support importing and exporting workflow/function definitions to enable backup, migration, and cross-environment management.\n+\n+### BR-203 (P2): Execution time travel\n+The system SHOULD support execution time travel from historical states for debugging and compliance investigation purposes.\n+\n+### BR-204 (P2): Workflow/function execution A/B testing\n+The system SHOULD support A/B testing of workflow/function versions to validate changes before full deployment.\n+\n+### BR-205 (P2): Workflow/function execution canary releases\n+The system SHOULD support canary release patterns for gradual rollout of workflow/function updates.\n+\n+### BR-206 (P2): Execution environment isolation via stronger boundaries\n+The system SHOULD provide stronger isolation boundaries for workflow/function execution to ensure:\n+- one tenant's code execution cannot access or affect another tenant's execution environment\n+- resource consumption by one execution does not negatively impact other executions (noisy neighbor prevention)\n+- the isolation boundary is enforced at the operating system or equivalent level\n+\n+The P2 version may use process-level isolation with strict resource limits.\n+\n+### BR-207 (P2): Performance SLOs for execution and visibility\n+Under normal load, the system SHOULD meet performance targets for:\n+- workflow start latency p95 ≤ 100 ms from start request to first step scheduling\n+- step dispatch latency p95 ≤ 50 ms from step scheduled to execution start\n+- monitoring query latency p95 ≤ 200 ms for execution state/history queries\n+- runtime overhead ≤ 10 ms per step (excluding business logic)\n+\n+### BR-208 (P2): Scalability targets\n+The system SHOULD support scale targets including:\n+- ≥ 10,000 concurrent executions per region under normal load\n+- sustained workflow starts ≥ 1,000/sec per region under normal load\n+- ≥ 100,000 workflow executions/day initially with a growth plan to ≥ 1,000,000/day\n+- ≥ 1,000 tenants with a clear partitioning/isolation strategy\n+- ≥ 10,000 registered workflow definitions across tenants (including per-tenant hot-plug)\n+\n+## Target Use Cases\n+- **Resource provisioning**: multi-step provisioning with rollback on failure.\n+- **Tenant onboarding**: staged setup, waiting on external approvals/events.\n+- **Subscription lifecycle**: activation, renewal, suspension, cancellation flows.\n+- **Billing cycles**: metering aggregation and invoice preparation workflows.\n+- **Policy enforcement/remediation**: detect drift and execute corrective actions.\n+- **Data migration**: long-running copy/checkpoint/resume processes.\n+- **Disaster recovery orchestration**: controlled failover/failback sequences.\n+\n+## Acceptance Criteria (Business-Level)\n+### Workflow Execution\n+- Workflows can be started with inputs and produce a completion outcome (success or failure) with a correlation identifier.\n+- In-progress workflows resume after a service restart without duplicating completed step side effects.\n+- Transient failures result in automatic retries per defined policy until success or exhaustion.\n+- Permanent failures in multi-step workflows invoke compensation for previously completed steps.\n+- Workflows can remain active for 30+ days with state preserved and queryable, and can continue on external signals/events.\n+\n+### Tenant Isolation & Security Context\n+- A tenant can only see and manage its own functions/workflows and executions.\n+- Security context is preserved through long-running executions, ensuring actions are attributable to the correct tenant/user or system identity.\n+- Unauthorized operations fail closed.\n+\n+### Hot-Plug / Runtime Updates\n+- New or updated functions/workflows become available without interrupting existing in-flight executions.\n+- Updates do not retroactively change the behavior of already-running executions (safe evolution).\n+\n+### Scheduling\n+- Tenants can create, update, pause/resume, and cancel schedules for recurring workflows.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tenants usually mean ownership. Actions (such as creation of schedule) is usually done by users","created_at":"2026-01-15T16:58:31Z","updated_at":"2026-01-15T20:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695215521","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695215521"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695215521"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695215521/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":415,"original_line":415,"side":"RIGHT","author_association":"MEMBER","original_position":415,"position":415,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695222084","pull_request_review_id":3666654496,"id":2695222084,"node_id":"PRRC_kwDOPaLyBs6gpdNE","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I see that in a lot of places we use operators, but in the description of the document we use \"users\". I suggest to stick to \"users\" to avoid misinterpretations","created_at":"2026-01-15T17:00:49Z","updated_at":"2026-01-15T20:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695222084","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695222084"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695222084"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695222084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":303,"original_line":303,"side":"RIGHT","author_association":"MEMBER","original_position":303,"position":303,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695432218","pull_request_review_id":3666654496,"id":2695432218,"node_id":"PRRC_kwDOPaLyBs6gqQga","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\"for an execution\" of what? Do we mean API calls here? Or execution of any function?","created_at":"2026-01-15T18:05:40Z","updated_at":"2026-01-15T20:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695432218","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695432218"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695432218"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695432218/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":320,"original_line":320,"side":"RIGHT","author_association":"MEMBER","original_position":320,"position":320,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695444891","pull_request_review_id":3666654496,"id":2695444891,"node_id":"PRRC_kwDOPaLyBs6gqTmb","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.\n+\n+### BR-134 (P1): Idempotency mechanisms\n+The platform MUST provide mechanisms to implement idempotency for workflow/function execution.\n+The system SHOULD support common idempotency patterns, including idempotency keys, deduplication windows, and correlation identifiers to track and deduplicate requests.\n+\n+### BR-135 (P1): Tenant-segmented operational metrics\n+The system MUST provide operational metrics for workflow/function execution, including volume, latency, error rates, and queue/backlog indicators, and support segmentation by tenant.\n+\n+### P2 Requirements (Nice-to-have)\n+\n+### BR-201 (P2): Archival for long-term compliance\n+The system SHOULD support long-term archival of execution history and audit records for tenants with extended compliance and reporting requirements.\n+\n+### BR-202 (P2): Workflow/function definition import/export\n+The system SHOULD support importing and exporting workflow/function definitions to enable backup, migration, and cross-environment management.\n+\n+### BR-203 (P2): Execution time travel\n+The system SHOULD support execution time travel from historical states for debugging and compliance investigation purposes.\n+\n+### BR-204 (P2): Workflow/function execution A/B testing\n+The system SHOULD support A/B testing of workflow/function versions to validate changes before full deployment.\n+\n+### BR-205 (P2): Workflow/function execution canary releases\n+The system SHOULD support canary release patterns for gradual rollout of workflow/function updates.\n+\n+### BR-206 (P2): Execution environment isolation via stronger boundaries\n+The system SHOULD provide stronger isolation boundaries for workflow/function execution to ensure:\n+- one tenant's code execution cannot access or affect another tenant's execution environment\n+- resource consumption by one execution does not negatively impact other executions (noisy neighbor prevention)\n+- the isolation boundary is enforced at the operating system or equivalent level\n+\n+The P2 version may use process-level isolation with strict resource limits.\n+\n+### BR-207 (P2): Performance SLOs for execution and visibility\n+Under normal load, the system SHOULD meet performance targets for:\n+- workflow start latency p95 ≤ 100 ms from start request to first step scheduling\n+- step dispatch latency p95 ≤ 50 ms from step scheduled to execution start\n+- monitoring query latency p95 ≤ 200 ms for execution state/history queries\n+- runtime overhead ≤ 10 ms per step (excluding business logic)\n+\n+### BR-208 (P2): Scalability targets\n+The system SHOULD support scale targets including:\n+- ≥ 10,000 concurrent executions per region under normal load\n+- sustained workflow starts ≥ 1,000/sec per region under normal load\n+- ≥ 100,000 workflow executions/day initially with a growth plan to ≥ 1,000,000/day\n+- ≥ 1,000 tenants with a clear partitioning/isolation strategy\n+- ≥ 10,000 registered workflow definitions across tenants (including per-tenant hot-plug)\n+\n+## Target Use Cases","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Are we sure that all these use-cases are related to Serverless runtime?\r\nWhat is \"data migration\" ?\r\nHow does \"disaster-recovery\" should be orchestrated inside Serverless platform? It looks more like a requirements to hosting platform where we plan to run \"serverless runtime\" ","created_at":"2026-01-15T18:10:15Z","updated_at":"2026-01-15T20:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695444891","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695444891"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695444891"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695444891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":388,"original_line":388,"side":"RIGHT","author_association":"MEMBER","original_position":388,"position":388,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695455345","pull_request_review_id":3666654496,"id":2695455345,"node_id":"PRRC_kwDOPaLyBs6gqWJx","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.\n+\n+### BR-134 (P1): Idempotency mechanisms\n+The platform MUST provide mechanisms to implement idempotency for workflow/function execution.\n+The system SHOULD support common idempotency patterns, including idempotency keys, deduplication windows, and correlation identifiers to track and deduplicate requests.\n+\n+### BR-135 (P1): Tenant-segmented operational metrics\n+The system MUST provide operational metrics for workflow/function execution, including volume, latency, error rates, and queue/backlog indicators, and support segmentation by tenant.\n+\n+### P2 Requirements (Nice-to-have)\n+\n+### BR-201 (P2): Archival for long-term compliance\n+The system SHOULD support long-term archival of execution history and audit records for tenants with extended compliance and reporting requirements.\n+\n+### BR-202 (P2): Workflow/function definition import/export\n+The system SHOULD support importing and exporting workflow/function definitions to enable backup, migration, and cross-environment management.\n+\n+### BR-203 (P2): Execution time travel\n+The system SHOULD support execution time travel from historical states for debugging and compliance investigation purposes.\n+\n+### BR-204 (P2): Workflow/function execution A/B testing\n+The system SHOULD support A/B testing of workflow/function versions to validate changes before full deployment.\n+\n+### BR-205 (P2): Workflow/function execution canary releases\n+The system SHOULD support canary release patterns for gradual rollout of workflow/function updates.\n+\n+### BR-206 (P2): Execution environment isolation via stronger boundaries\n+The system SHOULD provide stronger isolation boundaries for workflow/function execution to ensure:\n+- one tenant's code execution cannot access or affect another tenant's execution environment\n+- resource consumption by one execution does not negatively impact other executions (noisy neighbor prevention)\n+- the isolation boundary is enforced at the operating system or equivalent level\n+\n+The P2 version may use process-level isolation with strict resource limits.\n+\n+### BR-207 (P2): Performance SLOs for execution and visibility\n+Under normal load, the system SHOULD meet performance targets for:\n+- workflow start latency p95 ≤ 100 ms from start request to first step scheduling\n+- step dispatch latency p95 ≤ 50 ms from step scheduled to execution start\n+- monitoring query latency p95 ≤ 200 ms for execution state/history queries\n+- runtime overhead ≤ 10 ms per step (excluding business logic)\n+\n+### BR-208 (P2): Scalability targets\n+The system SHOULD support scale targets including:\n+- ≥ 10,000 concurrent executions per region under normal load\n+- sustained workflow starts ≥ 1,000/sec per region under normal load\n+- ≥ 100,000 workflow executions/day initially with a growth plan to ≥ 1,000,000/day\n+- ≥ 1,000 tenants with a clear partitioning/isolation strategy\n+- ≥ 10,000 registered workflow definitions across tenants (including per-tenant hot-plug)\n+\n+## Target Use Cases\n+- **Resource provisioning**: multi-step provisioning with rollback on failure.\n+- **Tenant onboarding**: staged setup, waiting on external approvals/events.\n+- **Subscription lifecycle**: activation, renewal, suspension, cancellation flows.\n+- **Billing cycles**: metering aggregation and invoice preparation workflows.\n+- **Policy enforcement/remediation**: detect drift and execute corrective actions.\n+- **Data migration**: long-running copy/checkpoint/resume processes.\n+- **Disaster recovery orchestration**: controlled failover/failback sequences.\n+\n+## Acceptance Criteria (Business-Level)","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Throttling? Idempotancy? Security & Governance ?","created_at":"2026-01-15T18:13:30Z","updated_at":"2026-01-15T20:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695455345","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695455345"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695455345"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695455345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":397,"original_line":397,"side":"RIGHT","author_association":"MEMBER","original_position":397,"position":397,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695823858","pull_request_review_id":3667411347,"id":2695823858,"node_id":"PRRC_kwDOPaLyBs6grwHy","diff_hunk":"@@ -0,0 +1,516 @@\n+# ADR — Starlark Runtime (Function & Workflow Execution)\n+\n+## Status\n+Proposed\n+\n+## Context\n+Hyperspot Serverless Runtime supports functions and workflows defined as GTS-identified JSON Schemas and invoked via a unified invocation API.\n+\n+This ADR defines the design of the Starlark runtime implementation used to execute those definitions:\n+- the Starlark program structure (entrypoint contract)\n+- strong typing rules and runtime validation\n+- runtime-provided helper methods (`r_*`) and their versioning\n+- asynchronous execution model (promise + await)\n+- workflow orchestration hooks (steps, retries, compensation, snapshots, event waiting)\n+- example definitions and Starlark programs for functions and workflows\n+\n+This ADR is intentionally aligned with `2_ADR_ENTRYPOINT.md` (Entrypoint schema + Invocation API).\n+\n+## Why Starlark?\n+\n+Starlark is a good fit for Hyperspot Serverless Runtime because it provides a constrained, embeddable, deterministic scripting language with strong tooling hooks.","path":"modules/serverless_runtime/docs/3_ADR_STARLARK_RUNTIME.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This statement does not address the question above. It would be beneficial to see the established criteria, the other options considered, and the rationale for choosing Starlark.","created_at":"2026-01-15T20:18:39Z","updated_at":"2026-01-15T20:18:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695823858","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695823858"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2695823858"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2695823858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":21,"original_line":21,"side":"RIGHT","author_association":"MEMBER","original_position":21,"position":21,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696381527","pull_request_review_id":3668152784,"id":2696381527,"node_id":"PRRC_kwDOPaLyBs6gt4RX","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Are Workflows and Functions related one to each other? Should it be possible to chain Functions into the Workflow?","created_at":"2026-01-15T23:56:32Z","updated_at":"2026-01-15T23:56:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2696381527","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696381527"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2696381527"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696381527/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":30,"original_line":30,"side":"RIGHT","author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696385324","pull_request_review_id":3668156575,"id":2696385324,"node_id":"PRRC_kwDOPaLyBs6gt5Ms","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I assume it would be good to run one workflow based on the execution result of another workflow. So, it would be good to integrate workflows and functions with even subsystem and publish there execution results as events","created_at":"2026-01-15T23:59:00Z","updated_at":"2026-01-15T23:59:00Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2696385324","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696385324"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2696385324"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2696385324/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":34,"original_line":34,"side":"RIGHT","author_association":"MEMBER","original_position":34,"position":34,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698178863","pull_request_review_id":3670466202,"id":2698178863,"node_id":"PRRC_kwDOPaLyBs6g0vEv","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\"in a secure way\"","created_at":"2026-01-16T11:32:53Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698178863","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698178863"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698178863"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698178863/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":9,"original_line":9,"side":"RIGHT","author_association":"MEMBER","original_position":9,"position":9,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698323037","pull_request_review_id":3670466202,"id":2698323037,"node_id":"PRRC_kwDOPaLyBs6g1SRd","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need to add remind AI to follow GTS versioning rules - https://github.com/globaltypesystem/gts-spec?tab=readme-ov-file#4-gts-identifier-versions-compatibility","created_at":"2026-01-16T12:23:25Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698323037","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698323037"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698323037"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698323037/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":142,"original_line":142,"side":"RIGHT","author_association":"MEMBER","original_position":142,"position":142,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698329111","pull_request_review_id":3670466202,"id":2698329111,"node_id":"PRRC_kwDOPaLyBs6g1TwX","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"mention workflow spec it should support","created_at":"2026-01-16T12:25:44Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698329111","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698329111"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698329111"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698329111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":4,"original_line":4,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698331785","pull_request_review_id":3670466202,"id":2698331785,"node_id":"PRRC_kwDOPaLyBs6g1UaJ","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"partial checkpointing or step-level state save is required for improved recovery and efficiency","created_at":"2026-01-16T12:26:46Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698331785","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698331785"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698331785"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698331785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":37,"original_line":37,"side":"RIGHT","author_association":"MEMBER","original_position":37,"position":37,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334204","pull_request_review_id":3670466202,"id":2698334204,"node_id":"PRRC_kwDOPaLyBs6g1U_8","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":" event correlation, filtering, and payload transformation for event-driven workflows.","created_at":"2026-01-16T12:27:41Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698334204","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334204"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698334204"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334204/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":34,"original_line":34,"side":"RIGHT","author_association":"MEMBER","original_position":34,"position":34,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334532","pull_request_review_id":3670655336,"id":2698334532,"node_id":"PRRC_kwDOPaLyBs6g1VFE","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"entropyshift","id":241303648,"node_id":"U_kgDODmIAYA","avatar_url":"https://avatars.githubusercontent.com/u/241303648?v=4","gravatar_id":"","url":"https://api.github.com/users/entropyshift","html_url":"https://github.com/entropyshift","followers_url":"https://api.github.com/users/entropyshift/followers","following_url":"https://api.github.com/users/entropyshift/following{/other_user}","gists_url":"https://api.github.com/users/entropyshift/gists{/gist_id}","starred_url":"https://api.github.com/users/entropyshift/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/entropyshift/subscriptions","organizations_url":"https://api.github.com/users/entropyshift/orgs","repos_url":"https://api.github.com/users/entropyshift/repos","events_url":"https://api.github.com/users/entropyshift/events{/privacy}","received_events_url":"https://api.github.com/users/entropyshift/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do you plan to implement a visual designer that generates imperative code? This approach seems more complex than using a declarative format similar to Serverless Workflow. Or are you planning to support both - imperative when code is required and declarative for the UI layer?","created_at":"2026-01-16T12:27:47Z","updated_at":"2026-01-16T12:32:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698334532","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334532"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698334532"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698334532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":42,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":42,"position":42,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698335622","pull_request_review_id":3670466202,"id":2698335622,"node_id":"PRRC_kwDOPaLyBs6g1VWG","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"error handling requirements","created_at":"2026-01-16T12:28:11Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698335622","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698335622"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698335622"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698335622/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":40,"original_line":40,"side":"RIGHT","author_association":"MEMBER","original_position":40,"position":40,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698337687","pull_request_review_id":3670466202,"id":2698337687,"node_id":"PRRC_kwDOPaLyBs6g1V2X","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"need to consider API or metadata requirements to support future integration with visualization tools. Applicable for functions and workflows","created_at":"2026-01-16T12:28:56Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698337687","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698337687"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698337687"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698337687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":42,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":42,"position":42,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698343921","pull_request_review_id":3670466202,"id":2698343921,"node_id":"PRRC_kwDOPaLyBs6g1XXx","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"probably need step-level or partial checkpointing and not just full workflow snapshots","created_at":"2026-01-16T12:31:09Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698343921","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698343921"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698343921"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698343921/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":93,"original_line":93,"side":"RIGHT","author_association":"MEMBER","original_position":93,"position":93,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698346455","pull_request_review_id":3670466202,"id":2698346455,"node_id":"PRRC_kwDOPaLyBs6g1X_X","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"lets just use the serverless workflow specification and have it implemented.","created_at":"2026-01-16T12:32:05Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698346455","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698346455"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698346455"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698346455/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":96,"original_line":96,"side":"RIGHT","author_association":"MEMBER","original_position":96,"position":96,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698350842","pull_request_review_id":3670466202,"id":2698350842,"node_id":"PRRC_kwDOPaLyBs6g1ZD6","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need to consider having a reporting dashboard too","created_at":"2026-01-16T12:33:36Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698350842","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698350842"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698350842"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698350842/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":276,"original_line":276,"side":"RIGHT","author_association":"MEMBER","original_position":276,"position":276,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698352639","pull_request_review_id":3670466202,"id":2698352639,"node_id":"PRRC_kwDOPaLyBs6g1Zf_","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"include compensation for error scenarios and chaining (sub-workflow execution)","created_at":"2026-01-16T12:34:13Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698352639","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698352639"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698352639"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698352639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":123,"original_line":123,"side":"RIGHT","author_association":"MEMBER","original_position":123,"position":123,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698355732","pull_request_review_id":3670466202,"id":2698355732,"node_id":"PRRC_kwDOPaLyBs6g1aQU","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"consider requirements for sub-flow, sub-function execution.","created_at":"2026-01-16T12:35:17Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698355732","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698355732"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698355732"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698355732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":132,"original_line":132,"side":"RIGHT","author_association":"MEMBER","original_position":132,"position":132,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698359936","pull_request_review_id":3670466202,"id":2698359936,"node_id":"PRRC_kwDOPaLyBs6g1bSA","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"should would need to integrate with redaction functionality and it should be out of scope of serverless native capability. Hence modify the requirements.","created_at":"2026-01-16T12:36:29Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698359936","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698359936"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698359936"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698359936/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":139,"original_line":139,"side":"RIGHT","author_association":"MEMBER","original_position":139,"position":139,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698375251","pull_request_review_id":3670466202,"id":2698375251,"node_id":"PRRC_kwDOPaLyBs6g1fBT","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need to mention protocol support for executing the functions/workflows.\r\nThe function can be triggered with common base API like `trigger(fn_gts_id)` or function could be invoked as REST like API, as gRPC method, etc.\r\n\r\nNeed to add these requirements.\r\n","created_at":"2026-01-16T12:41:40Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698375251","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698375251"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698375251"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698375251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":79,"original_line":79,"side":"RIGHT","author_association":"MEMBER","original_position":79,"position":79,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698379442","pull_request_review_id":3670466202,"id":2698379442,"node_id":"PRRC_kwDOPaLyBs6g1gCy","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"add clarification  that metering should include step-level, sub-workflow, and external call breakdowns.","created_at":"2026-01-16T12:43:05Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698379442","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698379442"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698379442"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698379442/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":251,"original_line":251,"side":"RIGHT","author_association":"MEMBER","original_position":251,"position":251,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698383187","pull_request_review_id":3670466202,"id":2698383187,"node_id":"PRRC_kwDOPaLyBs6g1g9T","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"is this applicable for functions too?\r\n\r\nfor workflows this is called as \"human-in-the-loop\" feature. lets use this term","created_at":"2026-01-16T12:44:11Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698383187","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698383187"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698383187"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698383187/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":241,"original_line":241,"side":"RIGHT","author_association":"MEMBER","original_position":241,"position":241,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698387994","pull_request_review_id":3670466202,"id":2698387994,"node_id":"PRRC_kwDOPaLyBs6g1iIa","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"need explicit requirement to allow integration with other systems and supported protocols.","created_at":"2026-01-16T12:45:42Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698387994","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698387994"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698387994"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698387994/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":102,"original_line":102,"side":"RIGHT","author_association":"MEMBER","original_position":102,"position":102,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698390524","pull_request_review_id":3670466202,"id":2698390524,"node_id":"PRRC_kwDOPaLyBs6g1iv8","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"and on execution then SLA breach events should be surfaced for alerting and reporting.","created_at":"2026-01-16T12:46:34Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698390524","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698390524"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698390524"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698390524/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":255,"original_line":255,"side":"RIGHT","author_association":"MEMBER","original_position":255,"position":255,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698392928","pull_request_review_id":3670466202,"id":2698392928,"node_id":"PRRC_kwDOPaLyBs6g1jVg","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The throttling can be configured at tenant, and workflow level.","created_at":"2026-01-16T12:47:30Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698392928","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698392928"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698392928"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698392928/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":258,"original_line":258,"side":"RIGHT","author_association":"MEMBER","original_position":258,"position":258,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698396042","pull_request_review_id":3670466202,"id":2698396042,"node_id":"PRRC_kwDOPaLyBs6g1kGK","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"May be we mention if burst limits and sliding window policies should be considered","created_at":"2026-01-16T12:48:38Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698396042","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698396042"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698396042"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698396042/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":267,"original_line":267,"side":"RIGHT","author_association":"MEMBER","original_position":267,"position":267,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698398806","pull_request_review_id":3670466202,"id":2698398806,"node_id":"PRRC_kwDOPaLyBs6g1kxW","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"mention about cache refresh ttl. caching can be applicable at the workflow step level too, so lets include that into the requirement","created_at":"2026-01-16T12:49:32Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698398806","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698398806"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698398806"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698398806/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":273,"original_line":273,"side":"RIGHT","author_association":"MEMBER","original_position":273,"position":273,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698406896","pull_request_review_id":3670466202,"id":2698406896,"node_id":"PRRC_kwDOPaLyBs6g1mvw","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"There should be a manual way to stop execution of ongoing function or workflow","created_at":"2026-01-16T12:52:07Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698406896","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698406896"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698406896"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698406896/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":284,"original_line":284,"side":"RIGHT","author_association":"MEMBER","original_position":284,"position":284,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698409418","pull_request_review_id":3670466202,"id":2698409418,"node_id":"PRRC_kwDOPaLyBs6g1nXK","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"retention can be extended for compliance/legal reasons.\r\n","created_at":"2026-01-16T12:52:58Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698409418","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698409418"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698409418"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698409418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":298,"original_line":298,"side":"RIGHT","author_association":"MEMBER","original_position":298,"position":298,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698411240","pull_request_review_id":3670466202,"id":2698411240,"node_id":"PRRC_kwDOPaLyBs6g1nzo","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"pause/resume and manual intervention APIs are required","created_at":"2026-01-16T12:53:35Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698411240","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698411240"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698411240"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698411240/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":310,"original_line":310,"side":"RIGHT","author_association":"MEMBER","original_position":310,"position":310,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698412882","pull_request_review_id":3670466202,"id":2698412882,"node_id":"PRRC_kwDOPaLyBs6g1oNS","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"should link to error guideline within hyperspot.\r\n\r\nerror codes should be mappable to external systems or standards.","created_at":"2026-01-16T12:54:11Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698412882","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698412882"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698412882"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698412882/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":317,"original_line":317,"side":"RIGHT","author_association":"MEMBER","original_position":317,"position":317,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698414150","pull_request_review_id":3670466202,"id":2698414150,"node_id":"PRRC_kwDOPaLyBs6g1ohG","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"cache keys and invalidation policies are configurable.","created_at":"2026-01-16T12:54:38Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698414150","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698414150"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698414150"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698414150/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":336,"original_line":336,"side":"RIGHT","author_association":"MEMBER","original_position":336,"position":336,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698415329","pull_request_review_id":3670466202,"id":2698415329,"node_id":"PRRC_kwDOPaLyBs6g1ozh","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"compensation retries and error reporting are required.\r\n","created_at":"2026-01-16T12:55:00Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698415329","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698415329"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698415329"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698415329/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":339,"original_line":339,"side":"RIGHT","author_association":"MEMBER","original_position":339,"position":339,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698416481","pull_request_review_id":3670466202,"id":2698416481,"node_id":"PRRC_kwDOPaLyBs6g1pFh","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.\n+\n+### BR-113 (P1): Workflow/function execution throttling\n+The system SHOULD support throttling of execution starts to protect downstream systems and prevent resource exhaustion under high load conditions.\n+\n+### BR-114 (P1): Workflow/function dependency management\n+The system SHOULD support declaring and managing dependencies between workflows/functions to ensure proper deployment order and compatibility.\n+\n+### BR-115 (P1): Workflow/function execution tracing\n+The system SHOULD provide distributed tracing capabilities that follow execution across multiple services and external system calls for end-to-end visibility.\n+\n+### BR-116 (P1): Workflow/function execution rate limits and volume caps\n+The system MUST support configurable limits on execution frequency and total execution volume over time to prevent abuse and ensure fair resource allocation across tenants.\n+\n+### BR-117 (P1): Workflow/function execution environment customization\n+The system SHOULD support customizing execution environment settings (such as time zones, locale, and regional compliance requirements) per tenant.\n+\n+### BR-118 (P1): Workflow/function execution result caching\n+The system SHOULD support caching of execution results for idempotent operations to improve performance and reduce redundant processing.\n+\n+### BR-119 (P1): Workflow/function execution monitoring dashboards\n+The system SHOULD provide pre-built monitoring dashboards for common operational metrics and health indicators.\n+\n+### BR-120 (P1): Workflow/function execution performance profiling\n+The system SHOULD support performance profiling of executions to identify bottlenecks and optimization opportunities.\n+\n+### BR-121 (P1): Workflow/function execution blue-green deployment\n+The system SHOULD support blue-green deployment strategies for workflow/function updates to minimize risk during changes.\n+\n+### BR-122 (P1): Workflow/function publishing governance\n+The system SHOULD support governance controls for workflow/function changes (such as review/approval and controlled activation) to reduce operational risk and support compliance.\n+\n+### BR-123 (P1): Public/shared reusable workflows and functions\n+The system SHOULD allow an authorized tenant administrator or vendor to mark a workflow/function definition as public (shared) so that other authorized administrators/vendors can discover and reuse that definition within the same tenant.\n+\n+### BR-124 (P1): Execution replay\n+The system SHOULD support replaying an execution from a recorded history or saved state, to support debugging, incident analysis, and controlled recovery.\n+\n+### BR-125 (P1): Workflow visualization\n+The system SHOULD make it easy for authorized users to visualize workflow structure (execution blocks and decisions/branches) and to understand which path is taken for a given execution.\n+\n+### BR-126 (P1): Default execution history retention period\n+The system MUST provide a default retention period for execution history.\n+The default retention period SHOULD be 7 days and MUST be configurable per tenant or per function type\n+\n+### BR-127 (P1): Debugging access model (tenant vs operator)\n+The system MUST enforce a permission model for debugging capabilities, such that:\n+- tenant users/administrators can debug and inspect only executions within their tenant scope\n+- platform operators can debug across tenants only via explicit operator authorization and with tenant_id and correlation_id traceability\n+- sensitive inputs/outputs and secrets are access-controlled and masked by default unless explicitly permitted\n+\n+### BR-128 (P1): Invocation lifecycle control APIs\n+The system MUST provide lifecycle controls for individual executions, including:\n+- querying execution status until completion\n+- canceling an in-flight execution\n+- replaying an execution for controlled recovery and incident analysis\n+\n+### BR-129 (P1): Standardized error taxonomy\n+The system MUST expose a standardized error taxonomy for workflow/function execution failures, including at minimum:\n+- upstream HTTP/integration failures\n+- runtime/environment failures (timeouts, resource limits)\n+- code execution and validation failures\n+Errors MUST include a stable error identifier, a human-readable message, and a structured details object to support automation and support workflows.\n+\n+### BR-130 (P1): Debug call trace (inputs/outputs and durations)\n+The system MUST provide a debug view for an execution that includes an ordered list of invoked calls (in order of execution), including:\n+- input parameters\n+- execution duration per call\n+- the exact call response (result or error)\n+This debug view MUST be available for completed executions (at least the call trace).\n+\n+The debug view MUST NOT expose secrets.\n+Sensitive inputs/outputs and secrets MUST be masked by default unless explicitly permitted.\n+\n+### BR-131 (P1): Execution-level compute and memory metrics\n+The system SHOULD provide execution-level compute and memory metrics that support troubleshooting, performance tuning, and cost allocation, including:\n+- wall-clock duration\n+- CPU time\n+- memory usage and memory limits\n+\n+### BR-132 (P1): Result caching policy (TTL)\n+The system SHOULD support a result caching policy for eligible workflows/functions where cached successful results may be reused for a configured time-to-live (TTL), to reduce redundant processing.\n+\n+### BR-133 (P1): Saga and compensation support\n+The system MUST provide built-in support for saga-style orchestration, including compensation logic to reverse the effects of completed steps when a workflow cannot complete successfully.\n+\n+### BR-134 (P1): Idempotency mechanisms\n+The platform MUST provide mechanisms to implement idempotency for workflow/function execution.\n+The system SHOULD support common idempotency patterns, including idempotency keys, deduplication windows, and correlation identifiers to track and deduplicate requests.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"idempotency enforcement is required at the step level.","created_at":"2026-01-16T12:55:23Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698416481","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698416481"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698416481"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698416481/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":343,"original_line":343,"side":"RIGHT","author_association":"MEMBER","original_position":343,"position":343,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698417707","pull_request_review_id":3670466202,"id":2698417707,"node_id":"PRRC_kwDOPaLyBs6g1pYr","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"metrics should be filterable by workflow, step, and time range.\r\n","created_at":"2026-01-16T12:55:49Z","updated_at":"2026-01-16T12:56:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698417707","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698417707"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2698417707"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2698417707/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":158,"original_line":158,"side":"RIGHT","author_association":"MEMBER","original_position":158,"position":158,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895891","pull_request_review_id":3681661356,"id":2707895891,"node_id":"PRRC_kwDOPaLyBs6hZzZT","diff_hunk":"@@ -0,0 +1,1267 @@\n+# ADR — Serverless Runtime Entrypoints (Function & Workflow Definitions, Invocation API)\n+\n+## Status\n+Proposed\n+\n+## Context\n+The Serverless Runtime module needs a stable, tenant-safe way to:\n+- register functions & workflows schema and code definitions at runtime\n+- invoke those definitions via API\n+- observe execution progress and outcomes\n+\n+This ADR defines:\n+- GTS-based identifiers and JSON Schema conventions for functions & workflows definitions\n+- definition “traits” (semantics, limits, runtime, error types)\n+- invocation API (start, status, cancel, dry-run) with observability fields\n+\n+## Classifications\n+\n+### Function\n+\n+Functions are single-unit compute entrypoints designed for request/response execution:\n+- Stateless with respect to the runtime (any durable state is stored externally).\n+- Typically short-lived (bounded by platform timeout limits).\n+- Commonly used as building blocks for APIs, event handlers, and single-step jobs.\n+- Retries are common; authors SHOULD design for idempotency when side effects are possible.\n+\n+Event waiting is supported by the platform via execution suspension and later resumption.\n+For functions this is an advanced capability and is primarily relevant for asynchronous execution.\n+\n+### Workflow\n+\n+Workflows are durable, multi-step orchestrations that coordinate one or more actions over time.\n+A workflow is a definition that may contain multiple execution steps, suspension points, and runtime-managed continuation.\n+- Persisted execution state (durable progress across restarts).\n+- Supports long-running behavior (timers, waiting on external events, human-in-the-loop patterns).\n+- Encodes orchestration logic (fan-out/fan-in, branching, retries, compensation) over multiple steps.\n+- Individual steps are commonly implemented by calling functions or external integrations.\n+\n+For workflows, the underlying code interpreter/runtime is responsible for typical workflow execution processing, including:\n+- step identification\n+- step retry scheduling and retry status\n+- compensation orchestration\n+- checkpointing and suspend/resume\n+- event subscription and event-driven continuation\n+\n+Event waiting for workflows is implemented via suspension plus event subscription, with runtime-level examples defined in the code runtime document (e.g. Starlark).\n+\n+In Hyperspot, functions and workflows use the same entrypoint definition schema and the same implementation language constructs (if/else, loops, variables, etc.).\n+In practice, everything is defined and invoked as a function entrypoint, and the selected runtime MAY determine that a given entrypoint should be treated as a workflow by analyzing the code during validation. For example, the Starlark runtime can validate the program and detect runtime durability primitives (e.g., checkpoints/snapshots or awaiting events/timers); if present, the runtime can apply workflow execution semantics (durable suspend/resume and continuation) rather than treating it as a regular short-lived function.\n+The practical difference is execution semantics:\n+- Workflows are typically **async** and include internal snapshot/checkpoint behavior so the runtime can persist progress and support suspend/resume.\n+- Functions are typically **sync**, short-lived, and stateless with respect to the runtime.\n+\n+## Synchronous vs Asynchronous\n+\n+Functions and workflows can be executed synchronously or asynchronously.\n+\n+- **sync**\n+  - The client waits for completion and receives the result (or error) in the HTTP response.\n+  - This is constrained by HTTP and gateway timeouts, so it is best for short executions.\n+\n+- **async**\n+  - The client receives an `invocation_id` immediately and retrieves status/results later via the status endpoint.\n+  - The client “polls” for completion:\n+    - **Short poll**: `GET` returns immediately with the latest known status.\n+    - **Long poll**: `GET` waits up to a timeout before returning (otherwise identical semantics); this reduces client round-trips while still using polling.\n+\n+## Functions & Workflows identifier conventions\n+\n+Both functions and workflows use the same schema and semantic definition following `https://github.com/GlobalTypeSystem/gts-spec` specification.\n+\n+According to GTS specification, function/workflow contract definitions are represented as GTS **types** (JSON Schema documents), identified by `$id` values that end with `~`.\n+\n+* Base function/workflow definition:\n+  - `gts.x.core.faas.func.v1~` - defines the base function/workflow definition schema, including placeholders for `params`, `returns`, `errors`, and the schema for `traits` (semantics) such as timeouts and limits.\n+\n+* Specific function/workflow definitions:\n+  - are derived GTS types (JSON Schemas) that reference the base type (typically via `allOf`) and then pin concrete `params`, `returns`, and initialized `traits` values.\n+\n+Functions/workflows identifier examples:\n+  - `gts.x.core.faas.func.v1~vendor_x.app.namespace.func_name.v1~`\n+  - `gts.x.core.faas.func.v1~vendor_y.pkg.domain.workflow_name.v1~`\n+\n+The invocation API uses GTS ID to refer to the specific function/workflow definition type identifier (the `$id` value without the `gts://` prefix).\n+\n+## Schemas\n+This section defines base schema for functions/workflows definitions.\n+\n+### Base schema: Entrypoint Definition\n+**Schema ID (type):** `gts.x.core.faas.func.v1~`\n+\n+Main schema elements are:\n+- `id` - base function/workflow type identifier.\n+- `params` - function input schema, to be refined by specific functions/workflows.\n+- `returns` - function output schema, to be refined by specific functions/workflows.\n+- `errors` - list of possible custom error type identifiers (GTS IDs).\n+- `traits` - schema for `traits` (semantics) such as timeouts and limits, that must be pinned by specific functions/workflows (e.g., with property-level `const`)\n+\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~\",\n+  \"title\": \"FaaS Function Definition\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"properties\": {\n+    \"id\": {\n+      \"type\": \"string\",\n+      \"description\": \"Well-known type identifier of this function/workflow definition.\",\n+      \"examples\": [\"gts.x.core.faas.func.v1~vendor.app.namespace.func_name.v1~\"]\n+    },\n+\n+    \"title\": { \"type\": \"string\" },\n+    \"description\": { \"type\": \"string\" },\n+\n+    \"params\": {\n+      \"description\": \"Function input schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void params\"}\n+      ]\n+    },\n+\n+    \"returns\": {\n+      \"description\": \"Function output schema (DTS-style naming). May be a $ref to a GTS schema, inline JSON Schema, or void.\",\n+      \"oneOf\": [\n+        {\"$ref\": \"https://json-schema.org/draft/2020-12/schema\"},\n+        {\"type\": \"object\", \"additionalProperties\": true},\n+        {\"type\": \"null\", \"description\": \"Void returns\"}\n+      ]\n+    },\n+\n+    \"errors\": {\n+      \"type\": \"array\",\n+      \"items\": {\"type\": \"string\"},\n+      \"default\": [],\n+      \"description\": \"List of possible customerror type identifiers (GTS IDs).\"","path":"modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Typo in schema description: `customerror` should be `custom error`.\n\n```json\n\"description\": \"List of possible custom error type identifiers (GTS IDs).\"\n```\n\nThis typo appears in a JSON Schema `description` field which may be used for validation error messages or auto-generated documentation.\n```suggestion\n      \"description\": \"List of possible custom error type identifiers (GTS IDs).\"\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/243?chatWithGeneratedComment=af097881-be0d-4e20-9505-698ee166efa4\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-20T11:12:29Z","updated_at":"2026-01-20T11:12:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2707895891","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895891"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2707895891"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":138,"original_line":138,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":138,"position":138,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895970","pull_request_review_id":3681661356,"id":2707895970,"node_id":"PRRC_kwDOPaLyBs6hZzai","diff_hunk":"@@ -0,0 +1,450 @@\n+# PRD — Serverless Runtime (Business Requirements)\n+\n+## Purpose\n+Provide a platform capability that enables tenants and their users to create, modify, register, and execute custom automation (functions and workflows) at runtime, without requiring a product rebuild or redeploy, while maintaining strong isolation, governance, and operational visibility.\n+\n+## Background / Problem Statement\n+The platform requires a unified way to automate long-running and multi-step business processes across modules and external systems. Today, automation capability is limited by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n+\n+This PRD defines the business requirements for a Serverless Runtime capability that supports:\n+- tenant-specific automation assets (functions/workflows)\n+- durable long-running execution\n+- governance (limits, permissions, auditability)\n+- operational excellence (visibility, debugging)\n+\n+## Goals (Business Outcomes)\n+- Enable faster delivery of tenant-specific automation without platform redeploys.\n+- Reduce operational risk for long-running processes by ensuring durability and resumability.\n+- Improve supportability and incident resolution via rich observability and debugging.\n+- Maintain compliance posture with auditability and strict tenant isolation.\n+\n+## Stakeholders / Users\n+- **Platform service teams**: isolate and consolidate orchestration logic and reduce direct dependencies between platform components.\n+- **Integration vendors**: provide custom functions/workflows for integrations in runtime.\n+- **Tenant administrators**: manage automation assets, schedules, permissions, and governance.\n+\n+## Scope\n+### In Scope\n+- Runtime creation/modification/registration and execution of:\n+  - **Functions** (single unit of custom logic)\n+  - **Workflows** (multi-step orchestration)\n+- Tenant- and user-scoped registries for functions/workflows.\n+- Long-running asynchronous execution (including multi-day executions).\n+- Governance controls via resource limits and policies.\n+- Multiple trigger modes (schedule, API-triggered, event-triggered).\n+- Secure execution context options (system account vs API client or user context).\n+- Runtime interactions with platform capabilities (e.g., calling platform-provided runtime methods).\n+- Durability features (snapshots / suspend-resume) for reliability and event waiting.\n+- Operational tooling requirements: visibility, audit trail, and debugging capabilities.\n+- Built-in support for distributed transaction patterns (saga and compensation).\n+\n+### Out of Scope\n+- Visual workflow designer UI (future capability).\n+- External workflow template marketplace.\n+- Real-time event streaming infrastructure (assumed to exist as a separate platform capability).\n+- Short-lived synchronous request/response patterns as a primary workload.\n+\n+## Business Requirements (Global)\n+### P0 Requirements (Critical)\n+\n+### BR-001 (P0): Runtime authoring without platform rebuild\n+The system MUST allow tenants and their users to create and modify functions and workflows at runtime, such that changes can be applied without rebuilding or redeploying the platform.\n+\n+### BR-002 (P0): Tenant and user registries\n+The system MUST provide a registry of functions and workflows that is isolated per tenant and supports user-level ownership/management within a tenant.\n+\n+### BR-003 (P0): Long-running asynchronous execution\n+The system MUST support long-running asynchronous functions and workflows, including executions lasting days (and longer where needed for business processes).\n+\n+### BR-004 (P0): Synchronous invocation for short executions\n+The system MUST support synchronous request/response invocation as a first-class feature for short-running executions, where the caller receives the result (or error) in the same API response.\n+This mode MUST be optional and MUST NOT replace long-running asynchronous execution as the primary workload.\n+\n+### BR-005 (P0): Resource governance\n+The system MUST support defining and enforcing resource limits for function/workflow execution, including:\n+- CPU limits\n+- memory limits\n+\n+The P0 version may use runtime controlled resource isolation, not OS-level resource isolation.\n+\n+### BR-006 (P0): Execution identity context\n+Functions/workflows MUST support being executed under:\n+- a system account (platform/service context)\n+- an API client context\n+- a user context (end-user / tenant-user context)\n+\n+### BR-007 (P0): Trigger mechanisms\n+The system MUST support starting functions/workflows via three trigger modes:\n+- schedule-based triggers\n+- API-triggered starts\n+- event-driven triggers\n+\n+### BR-008 (P0): Runtime capabilities / integrations\n+Workflows and functions MUST be able to invoke runtime-provided capabilities needed for business automation, such as:\n+- making outbound HTTP requests\n+- emitting or publishing business events\n+- writing to audit logs\n+- invoking platform-provided operations required for orchestration\n+\n+### BR-009 (P0): Durability via snapshots and suspend/resume\n+Workflows MUST provide an integrated snapshot mechanism enabling:\n+- suspend and resume behavior when waiting for events\n+- survival across service restarts\n+- continuation without losing progress\n+\n+### BR-010 (P0): Conditional logic and loops\n+Workflow definitions MUST support conditional branching and loop constructs to model complex business logic.\n+\n+### BR-011 (P0): Function/Workflow definition validation\n+The system MUST validate workflow/function definitions before registration and reject invalid definitions with actionable feedback.\n+\n+### BR-012 (P0): Graceful disconnection handling\n+When an integration adapter or external dependency is disconnected, the system MUST:\n+- reject new workflow/function starts that depend on the disconnected component\n+- allow in-flight executions to complete or fail gracefully\n+\n+### BR-013 (P0): Per-function/workflow resource quotas\n+The system MUST support defining resource limits at the individual workflow/function definition level, including:\n+- maximum concurrent executions of that workflow/function\n+- maximum memory allocation per execution\n+- maximum CPU allocation per execution\n+\n+### BR-014 (P0): Long-running execution credential refresh\n+For long-running asynchronous workflows, the system MUST support automatic refresh of initiator/caller authentication tokens or credentials, ensuring that:\n+- workflows do not fail due to token expiration during extended execution\n+- security context remains valid and auditable throughout the workflow lifetime\n+\n+### BR-015 (P0): Workflow and execution lifecycle management\n+The system MUST support lifecycle management for workflows/functions and their executions, including the ability to:\n+- start executions\n+- cancel or terminate executions\n+- retry failed executions\n+- suspend and resume executions\n+- apply compensation behavior on cancellation where applicable\n+\n+### BR-016 (P0): Execution visibility and querying\n+The system MUST provide an interface for authorized users/operators to:\n+- list available workflow/function definitions in their scope\n+- list executions and their current status\n+- inspect execution history and the current/pending step\n+- filter/search by tenant, initiator, time range, status, and correlation identifier\n+\n+### BR-017 (P0): Access control and separation of duties\n+The system MUST enforce authenticated and authorized access to all workflow/function management and execution operations and MUST fail closed on authorization failures.\n+The system SHOULD support separation of duties so that permissions to author/modify workflows/functions can be distinct from permissions to execute or administer them.\n+\n+### BR-018 (P0): Data protection and privacy controls\n+The system MUST protect workflow/function definitions, execution state, and audit records with appropriate data protection controls, including:\n+- protection of data at rest and in transit\n+- minimization of sensitive data exposure in logs and execution history\n+- controls for handling sensitive inputs/outputs and restricting who can view them\n+\n+### BR-019 (P0): Workflow/function definition versioning\n+The system MUST support versioning of workflow/function definitions so that:\n+- new executions can use an updated version\n+- in-flight executions continue with the version they started with\n+- changes are traceable and can be rolled back where needed\n+\n+### BR-020 (P0): Retry and failure handling policies\n+The system MUST support configurable retry and failure-handling policies for workflows/functions, including:\n+- maximum retry attempts\n+- backoff behavior\n+- classification of non-retryable failures\n+\n+### BR-021 (P0): Tenant enablement and isolation provisioning\n+The system MUST support enabling the workflow/function runtime for a tenant in a way that provisions required isolation and governance settings (including quotas) so the tenant can safely use the capability.\n+\n+### BR-022 (P0): Tenant and correlation identifiers in observability\n+The system MUST ensure that tenant identifiers and correlation identifiers are consistently present across audit records, logs, and operational metrics for traceability and compliance.\n+\n+### BR-023 (P0): Schedule lifecycle and missed schedule handling\n+The system MUST support schedule lifecycle management (create, update, pause/resume, and delete) and MUST support a configurable policy for handling missed schedules during downtime.\n+\n+### BR-024 (P0): Audit log integrity\n+The system MUST ensure audit records are trustworthy for compliance purposes, including:\n+- audit records are protected from unauthorized modification and deletion\n+- audit records are available for compliance review within the configured retention period\n+\n+### BR-025 (P0): Security context availability to workflow/function steps\n+The system MUST ensure that the execution security context is available throughout the lifetime of an execution and to every workflow/function step so that all actions performed by the runtime are attributable, authorized, and auditable.\n+\n+### BR-026 (P0): Secure handling of secrets and sensitive values\n+The system MUST support secure handling of secrets and other sensitive values used by workflows/functions, ensuring that:\n+- secrets are not inadvertently exposed via logs, execution history, or debugging views\n+- access to secrets is restricted to authorized actors and permitted executions\n+\n+### BR-027 (P0): Workflow/function state consistency\n+The system MUST ensure that workflow/function state remains consistent during concurrent operations and system failures, with no partial updates or corrupted states.\n+\n+### BR-028 (P0): Dead letter queue handling\n+The system MUST provide dead letter handling for executions that repeatedly fail after all retry attempts, ensuring failed executions are preserved for analysis and manual recovery.\n+\n+### BR-029 (P0): Workflow/function maximum execution duration guardrail\n+The system MUST enforce a maximum execution duration guardrail to prevent infinite or runaway executions.\n+This guardrail MUST be configurable per tenant and workflow/function and MUST apply even if higher timeouts are requested.\n+\n+### BR-030 (P0): Workflow/function execution isolation during updates\n+The system MUST ensure that updating a workflow/function definition does not affect executions currently running with the previous version.\n+\n+### BR-031 (P0): Workflow/function execution error boundaries\n+The system MUST support error boundary mechanisms that contain failures within specific workflow sections and prevent cascading failures across the entire workflow.\n+\n+### BR-032 (P0): LLM-manageable workflow/function definitions\n+Workflow/function definitions MUST be expressible in a form that allows an LLM to reliably:\n+- create and update definitions\n+- validate definitions and provide actionable feedback\n+- explain the workflow/function behavior in human-readable form\n+\n+### BR-033 (P0): Typed workflow/function inputs and outputs\n+The system MUST support starting workflows/functions with typed input parameters and receiving typed outputs, such that:\n+- inputs/outputs can be validated before execution\n+- inputs/outputs can be safely inspected in execution history (subject to privacy controls)\n+\n+### BR-034 (P0): Encryption controls\n+The system MUST ensure workflow/function definitions, execution state, and execution history are encrypted at rest, and all network communication is encrypted in transit.\n+\n+### BR-035 (P0): Audit trail and change traceability\n+The system MUST maintain a complete audit trail for:\n+- workflow/function definition creation, modification, enable/disable, and deletion\n+- execution lifecycle events (started, suspended, resumed, failed, compensated, canceled, completed)\n+Audit records MUST identify the tenant, actor (system/API client/user), and correlation identifier.\n+\n+### P1 Requirements (Important)\n+\n+### BR-101 (P1): Debugging and auditability\n+The platform MUST provide a way to debug workflow executions, including:\n+- setting breakpoints\n+- logging each action/function call with input parameters and return values\n+- retaining sufficient execution history to troubleshoot failures\n+\n+### BR-102 (P1): Step-through execution\n+The platform SHOULD provide step-through capabilities for workflow execution to support troubleshooting and controlled execution.\n+\n+### BR-103 (P1): Dry-run execution (no side effects)\n+The system SHOULD support a dry-run mode for workflows/functions that validates execution readiness (definition validity, permissions, and configured limits) using user-provided input.\n+Dry-run MUST NOT create a durable execution record and MUST NOT cause external side effects.\n+\n+### BR-104 (P1): Child workflows / modular composition\n+The system SHOULD support invoking child workflows/functions from a parent workflow for modular composition and reuse.\n+\n+### BR-105 (P1): Parallel execution\n+The system SHOULD support parallel execution of independent steps/functions within a workflow, with controllable concurrency caps (similar in spirit to browser parallel request limits) and configurable concurrency limits.\n+\n+### BR-106 (P1): Per-tenant resource quotas\n+The system MUST support per-tenant resource quotas, including:\n+- maximum total concurrent workflow/function executions per tenant\n+- maximum execution history retention size per tenant\n+\n+### BR-107 (P1): Retention and deletion policies\n+The system MUST support configurable retention policies for execution history and related audit records, including tenant-level defaults and deletion policies aligned to contractual and compliance needs.\n+\n+### BR-108 (P1): External signals and manual intervention\n+The system SHOULD support controlled interaction with in-flight executions, including the ability for authorized actors to provide external signals/inputs (for event-driven continuation) and to perform manual intervention actions needed to resolve operational issues.\n+\n+### BR-109 (P1): Alerts and notifications\n+The system SHOULD support notifying authorized users/operators about important workflow/function events, including failures, repeated retries, and abnormal execution duration, to reduce time-to-detection and time-to-recovery.\n+\n+### BR-110 (P1): Schedule-level input parameters and overrides\n+The system SHOULD support defining schedule-level input parameters and overrides so that recurring executions can run with consistent defaults and can be adjusted without modifying the underlying workflow/function definition.\n+\n+### BR-111 (P1): Cost allocation and metering\n+The system MUST provide metering of resource consumption per tenant and per workflow/function to support cost allocation and billing.\n+\n+### BR-112 (P1): Workflow/function execution timeouts\n+The system MUST support configurable execution timeouts at both the workflow/function level and individual step level.\n+Configured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-033.","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Incorrect business requirement reference. References `BR-033` but should reference `BR-029`.\n\n```markdown\nConfigured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-029.\n```\n\nBR-033 defines \"Typed workflow/function inputs and outputs\" while BR-029 defines \"Workflow/function maximum execution duration guardrail\". This cross-reference error could mislead implementers about which requirement establishes the guardrail constraint.\n```suggestion\nConfigured timeouts MUST NOT exceed the maximum execution duration guardrail defined in BR-029.\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/243?chatWithGeneratedComment=c9b218ce-32ab-4005-a24c-65bd5f368eae\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-20T11:12:30Z","updated_at":"2026-01-20T11:12:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2707895970","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895970"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2707895970"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2707895970/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":255,"original_line":255,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":255,"position":255,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729606875","pull_request_review_id":3708423641,"id":2729606875,"node_id":"PRRC_kwDOPaLyBs6isn7b","diff_hunk":"","path":"modules/serverless_runtime/docs/1_PRD.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"ainetx","id":244471386,"node_id":"U_kgDODpJWWg","avatar_url":"https://avatars.githubusercontent.com/u/244471386?v=4","gravatar_id":"","url":"https://api.github.com/users/ainetx","html_url":"https://github.com/ainetx","followers_url":"https://api.github.com/users/ainetx/followers","following_url":"https://api.github.com/users/ainetx/following{/other_user}","gists_url":"https://api.github.com/users/ainetx/gists{/gist_id}","starred_url":"https://api.github.com/users/ainetx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ainetx/subscriptions","organizations_url":"https://api.github.com/users/ainetx/orgs","repos_url":"https://api.github.com/users/ainetx/repos","events_url":"https://api.github.com/users/ainetx/events{/privacy}","received_events_url":"https://api.github.com/users/ainetx/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"FDD style conversion:\n\n# PRD — Serverless Runtime\n\n## A. Vision\n\n**Purpose**: Provide a serverless runtime capability that enables tenants to create, register, and execute custom automation (functions and workflows) at runtime without requiring a platform rebuild or redeploy, while preserving strong tenant isolation, governance, and operational visibility.\n\nThe platform needs a unified way to orchestrate long-running, multi-step business processes across modules and external systems. Today, automation is constrained by release cycles and lacks durable, tenant-isolated execution with governance, controls, and observability.\n\nThis capability aims to make automation safe and operable at scale: executions must be durable, debuggable, auditable, and strictly isolated per tenant, with enforced resource and access controls.\n\n**Target Users**:\n- Tenant administrators managing automation assets, schedules, permissions, and governance policies for workflows and functions.\n- Integration vendors / tenant developers authoring and maintaining functions and workflows that run inside the runtime.\n- Platform operators supporting execution visibility, incident response, and compliance reviews.\n\n**Key Problems Solved**:\n- Slow delivery of tenant-specific automation due to platform release cycles.\n- Lack of durable execution for long-running business processes (multi-day, event-driven wait/resume).\n- Insufficient governance, auditability, and observability for operational support and compliance.\n\n**Success Criteria**:\n- Runtime updates (new/updated workflow/function definitions) become available without platform redeploy and without interrupting in-flight executions.\n- Executions remain resumable across service restarts without duplicating already completed step side effects.\n- Tenant isolation is enforced: a tenant can only manage and view its own assets and executions; unauthorized operations fail closed.\n- Availability ≥ 99.95% monthly for the runtime service, with auditable lifecycle events and queryable execution state/history.\n\n**Capabilities**:\n- Author, register, version, and manage functions and workflows per tenant and per user.\n- Execute workflows asynchronously for long-running processes (including multi-day), with durability (suspend/resume, snapshots).\n- Execute short-running workflows synchronously (optional mode).\n- Trigger executions via schedule, API, or event-driven starts.\n- Enforce governance: per-tenant and per-definition quotas, resource limits, and policies.\n- Provide operational visibility: querying, histories, tracing/audit logs, debugging views with sensitive data masking.\n- Support failure handling: retries, dead letter handling, and compensation (saga-style patterns).\n\n## B. Actors\n\n### Human Actors\n\n#### Tenant Administrator\n\n**ID**: `fdd-hyperspot-actor-tenant-admin`\n\n<!-- fdd-id-content -->\n**Role**: Manages tenant automation assets, schedules, permissions, and governance policies for workflows and functions.\n<!-- fdd-id-content -->\n\n#### Integration Vendor / Tenant Developer\n\n**ID**: `fdd-hyperspot-actor-automation-author`\n\n<!-- fdd-id-content -->\n**Role**: Authors, updates, and publishes workflow/function definitions and maintains integrations that run inside the runtime.\n<!-- fdd-id-content -->\n\n#### Platform Operator\n\n**ID**: `fdd-hyperspot-actor-platform-operator`\n\n<!-- fdd-id-content -->\n**Role**: Investigates incidents, audits execution history, and supports operational visibility across tenants under explicit authorization controls.\n<!-- fdd-id-content -->\n\n### System Actors\n\n#### Identity & Authorization Service\n\n**ID**: `fdd-hyperspot-actor-identity-service`\n\n<!-- fdd-id-content -->\n**Role**: Provides authentication and authorization decisions and identity context used by workflow/function execution.\n<!-- fdd-id-content -->\n\n#### Scheduler Service\n\n**ID**: `fdd-hyperspot-actor-scheduler-service`\n\n<!-- fdd-id-content -->\n**Role**: Triggers scheduled workflow starts and manages schedule lifecycle events (create/update/pause/resume/delete).\n<!-- fdd-id-content -->\n\n#### Event Infrastructure\n\n**ID**: `fdd-hyperspot-actor-event-infra`\n\n<!-- fdd-id-content -->\n**Role**: Delivers event triggers and signals used to start or resume event-driven workflow executions.\n<!-- fdd-id-content -->\n\n## C. Functional Requirements\n\n#### Runtime Authoring and Updates\n\n**ID**: `fdd-hyperspot-fr-runtime-authoring`\n\n<!-- fdd-id-content -->\nThe system MUST allow authorized tenant users to create, update, enable/disable, and delete workflow/function definitions at runtime without requiring a platform rebuild or redeploy.\n\n**Actors**: `fdd-hyperspot-actor-automation-author`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Tenant and User Registries\n\n**ID**: `fdd-hyperspot-fr-tenant-user-registries`\n\n<!-- fdd-id-content -->\nThe system MUST provide registries for workflow/function definitions that are isolated per tenant and support user-level ownership and management within a tenant.\n\n**Actors**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-identity-service`\n<!-- fdd-id-content -->\n\n#### Definition Validation on Registration\n\n**ID**: `fdd-hyperspot-fr-definition-validation`\n\n<!-- fdd-id-content -->\nThe system MUST validate workflow/function definitions before they are registered or updated and MUST reject invalid definitions with actionable feedback.\n\n**Actors**: `fdd-hyperspot-actor-automation-author`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Durable Long-Running Execution\n\n**ID**: `fdd-hyperspot-fr-durable-long-execution`\n\n<!-- fdd-id-content -->\nThe system MUST support long-running asynchronous workflow/function executions, including multi-day executions, while preserving execution state so that progress is not lost across service restarts.\n\n**Actors**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-platform-operator`\n<!-- fdd-id-content -->\n\n#### Synchronous Invocation (Optional)\n\n**ID**: `fdd-hyperspot-fr-synchronous-invocation`\n\n<!-- fdd-id-content -->\nThe system MUST support optional synchronous request/response invocation for short-running executions, where the caller receives the result (or error) in the same response.\n\n**Actors**: `fdd-hyperspot-actor-automation-author`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Triggered Starts (Schedule, API, Event)\n\n**ID**: `fdd-hyperspot-fr-triggered-starts`\n\n<!-- fdd-id-content -->\nThe system MUST support starting workflows/functions via:\n- schedule-based triggers\n- API-triggered starts\n- event-driven triggers\n\n**Actors**: `fdd-hyperspot-actor-scheduler-service`, `fdd-hyperspot-actor-event-infra`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Execution Identity Context\n\n**ID**: `fdd-hyperspot-fr-execution-identity-context`\n\n<!-- fdd-id-content -->\nThe system MUST support executing workflows/functions under an explicit identity context (system account, API client, or user context) and MUST preserve that context throughout the execution lifetime for authorization and auditability.\n\n**Actors**: `fdd-hyperspot-actor-identity-service`, `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-platform-operator`\n<!-- fdd-id-content -->\n\n#### Resource Governance and Quotas\n\n**ID**: `fdd-hyperspot-fr-resource-governance-quotas`\n\n<!-- fdd-id-content -->\nThe system MUST support defining and enforcing governance limits for workflow/function execution, including resource limits and concurrency quotas at:\n- tenant level\n- per-definition level\n\n**Actors**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-platform-operator`\n<!-- fdd-id-content -->\n\n#### Execution Lifecycle Controls\n\n**ID**: `fdd-hyperspot-fr-execution-lifecycle-controls`\n\n<!-- fdd-id-content -->\nThe system MUST provide lifecycle management capabilities for executions, including the ability to:\n- start executions\n- cancel or terminate executions\n- suspend and resume executions\n- retry failed executions\n- apply compensation behavior when a workflow cannot complete successfully\n\n**Actors**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-platform-operator`\n<!-- fdd-id-content -->\n\n#### Execution Visibility and Querying\n\n**ID**: `fdd-hyperspot-fr-execution-visibility-querying`\n\n<!-- fdd-id-content -->\nThe system MUST provide an interface for authorized users/operators to:\n- list workflow/function definitions in scope\n- list executions and their current status\n- inspect execution history and current/pending step\n- filter/search by tenant, initiator, time range, status, and correlation identifier\n\n**Actors**: `fdd-hyperspot-actor-platform-operator`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Audit Trail and Integrity\n\n**ID**: `fdd-hyperspot-fr-audit-trail-integrity`\n\n<!-- fdd-id-content -->\nThe system MUST maintain an audit trail for workflow/function definition lifecycle events and execution lifecycle events, and MUST ensure audit records are protected from unauthorized modification and deletion within the configured retention period.\n\n**Actors**: `fdd-hyperspot-actor-platform-operator`, `fdd-hyperspot-actor-tenant-admin`\n<!-- fdd-id-content -->\n\n#### Sensitive Data and Secrets Protection\n\n**ID**: `fdd-hyperspot-fr-sensitive-data-protection`\n\n<!-- fdd-id-content -->\nThe system MUST protect secrets and sensitive values used by workflows/functions and MUST prevent unintended exposure via logs, execution history, and debugging views, including masking by default unless explicitly permitted.\n\n**Actors**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-platform-operator`, `fdd-hyperspot-actor-identity-service`\n<!-- fdd-id-content -->\n\n## D. Use Cases\n\n#### UC-001: Register and Start Workflow Execution\n\n**ID**: `fdd-hyperspot-usecase-register-start-workflow`\n\n<!-- fdd-id-content -->\n**Actor**: `fdd-hyperspot-actor-automation-author`, `fdd-hyperspot-actor-tenant-admin`\n\n**Preconditions**: Actor is authenticated and authorized to manage workflow/function definitions within the tenant scope. The tenant runtime capability is enabled for the tenant.\n\n**Flow**:\n1. Actor submits a new or updated workflow definition for registration.\n2. System validates the definition and returns actionable errors if invalid (`fdd-hyperspot-fr-definition-validation`).\n3. Actor starts a workflow execution with input parameters (`fdd-hyperspot-fr-execution-lifecycle-controls`).\n4. System assigns a correlation identifier and records initial execution state (`fdd-hyperspot-fr-execution-visibility-querying`).\n5. System executes the workflow and records lifecycle events for audit (`fdd-hyperspot-fr-audit-trail-integrity`).\n\n**Postconditions**: The workflow execution is created (or rejected if invalid) and becomes visible for querying, including status and correlation identifier.\n<!-- fdd-id-content -->\n\n#### UC-002: Schedule Recurring Workflow Execution\n\n**ID**: `fdd-hyperspot-usecase-schedule-workflow`\n\n<!-- fdd-id-content -->\n**Actor**: `fdd-hyperspot-actor-tenant-admin`, `fdd-hyperspot-actor-scheduler-service`\n\n**Preconditions**: A workflow definition exists and is enabled for the tenant. Actor has permission to create and manage schedules.\n\n**Flow**:\n1. Actor creates a schedule for a selected workflow definition, including default input parameters.\n2. System validates schedule parameters and stores the schedule for the tenant scope.\n3. Scheduler Service triggers workflow starts according to the schedule (`fdd-hyperspot-fr-triggered-starts`).\n4. System applies governance limits (tenant quotas and per-definition quotas) before starting each execution (`fdd-hyperspot-fr-resource-governance-quotas`).\n5. System records missed schedules during downtime according to the configured policy and makes them queryable (`fdd-hyperspot-fr-execution-visibility-querying`).\n\n**Postconditions**: Scheduled executions start according to policy, are auditable, and are visible for querying; missed schedules are recorded per policy.\n<!-- fdd-id-content -->\n\n#### UC-003: Investigate Failed Execution and Recover\n\n**ID**: `fdd-hyperspot-usecase-investigate-recover-execution`\n\n<!-- fdd-id-content -->\n**Actor**: `fdd-hyperspot-actor-platform-operator`, `fdd-hyperspot-actor-tenant-admin`\n\n**Preconditions**: An execution exists in a failed or dead-lettered state. Actor is authorized to view execution history and debugging details for the tenant scope.\n\n**Flow**:\n1. Actor searches for an execution by correlation identifier, tenant, and time range (`fdd-hyperspot-fr-execution-visibility-querying`).\n2. System shows execution status, step history, and audit events (`fdd-hyperspot-fr-audit-trail-integrity`).\n3. System masks sensitive values in logs/history by default, only revealing permitted information (`fdd-hyperspot-fr-sensitive-data-protection`).\n4. Actor determines whether to retry, cancel/terminate, or apply compensation according to policy (`fdd-hyperspot-fr-execution-lifecycle-controls`).\n5. System performs the chosen lifecycle action and updates the execution record and audit trail.\n\n**Postconditions**: The execution is either retried, terminated/canceled, compensated, or preserved for further analysis, with all actions auditable and queryable.\n<!-- fdd-id-content -->\n\n## E. Non-functional requirements\n\n#### Availability\n\n**ID**: `fdd-hyperspot-nfr-availability`\n\n<!-- fdd-id-content -->\n- The runtime service availability MUST meet or exceed 99.95% monthly.\n- The system MUST preserve durable execution state across service restarts so in-progress workflows can continue without losing progress.\n<!-- fdd-id-content -->\n\n#### Performance SLOs\n\n**ID**: `fdd-hyperspot-nfr-performance-slos`\n\n<!-- fdd-id-content -->\nUnder normal load, the system SHOULD meet these targets:\n- workflow start latency p95 ≤ 100 ms from start request to first step scheduling\n- step dispatch latency p95 ≤ 50 ms from step scheduled to execution start\n- monitoring query latency p95 ≤ 200 ms for execution state/history queries\n<!-- fdd-id-content -->\n\n#### Tenant Isolation\n\n**ID**: `fdd-hyperspot-nfr-tenant-isolation`\n\n<!-- fdd-id-content -->\n- The system MUST enforce strict tenant isolation for workflow/function definitions, execution state, execution history, and operational visibility.\n- A tenant MUST NOT be able to access or affect another tenant’s runtime assets or executions.\n<!-- fdd-id-content -->\n\n#### Security and Access Control\n\n**ID**: `fdd-hyperspot-nfr-access-control`\n\n<!-- fdd-id-content -->\n- All workflow/function management and execution operations MUST require authenticated and authorized access.\n- Authorization failures MUST fail closed.\n- The system SHOULD support separation of duties (author/modify permissions distinct from execute/admin permissions).\n<!-- fdd-id-content -->\n\n#### Data Protection and Encryption\n\n**ID**: `fdd-hyperspot-nfr-data-protection`\n\n<!-- fdd-id-content -->\n- Workflow/function definitions, execution state, and execution history MUST be encrypted at rest.\n- All network communication MUST be encrypted in transit.\n- Sensitive inputs/outputs MUST be protected and exposure minimized in logs and history views.\n<!-- fdd-id-content -->\n\n#### Secrets Handling and Masking\n\n**ID**: `fdd-hyperspot-nfr-secrets-masking`\n\n<!-- fdd-id-content -->\n- Secrets MUST NOT be exposed via logs, execution history, or debugging views.\n- Sensitive values MUST be masked by default unless explicitly permitted for authorized actors.\n<!-- fdd-id-content -->\n\n#### Auditability and Retention\n\n**ID**: `fdd-hyperspot-nfr-audit-retention`\n\n<!-- fdd-id-content -->\n- The system MUST capture workflow/function definition lifecycle events and execution lifecycle events in an auditable form.\n- Audit and history retention MUST be configurable per tenant and aligned to compliance needs.\n- Operational visibility MUST support traceability using tenant identifiers and correlation identifiers.\n<!-- fdd-id-content -->\n\n## F. Additional context\n\n#### Scope Boundaries\n\n**ID**: `fdd-hyperspot-prd-context-scope-boundaries`\n\n<!-- fdd-id-content -->\n- In scope: runtime authoring/registration/execution for functions and workflows, triggers (schedule/API/event), governance, durability, visibility, debugging, auditability.\n- Out of scope: visual workflow designer UI and external marketplace; real-time event streaming infrastructure as a separate platform capability.\n<!-- fdd-id-content -->\n\n#### Assumptions\n\n**ID**: `fdd-hyperspot-prd-context-assumptions`\n\n<!-- fdd-id-content -->\n- Platform identity and authorization services exist and can provide system/API-client/user context.\n- Persistent storage exists to support durability of execution state.\n- Event infrastructure exists to deliver event triggers and lifecycle events.\n- Scheduling is logically part of the runtime capability, even if implemented as a cooperating internal service.\n<!-- fdd-id-content -->\n\n#### Risk: Hot-Plug Safety\n\n**ID**: `fdd-hyperspot-prd-context-risk-hot-plug`\n\n<!-- fdd-id-content -->\n- Runtime updates MUST NOT destabilize in-flight executions.\n- Definition versioning and safe evolution policies are required to prevent retroactive behavior change for running executions.\n<!-- fdd-id-content -->\n\n#### Risk: Tenant Isolation Failure\n\n**ID**: `fdd-hyperspot-prd-context-risk-isolation`\n\n<!-- fdd-id-content -->\n- Multi-tenant execution MUST prevent cross-tenant data access and cross-tenant operational visibility.\n- Isolation boundary failures are high-severity incidents requiring strong preventive controls and auditable operator access.\n<!-- fdd-id-content -->\n\n#### Risk: Secrets Exfiltration\n\n**ID**: `fdd-hyperspot-prd-context-risk-secret-exfiltration`\n\n<!-- fdd-id-content -->\n- Workflows/functions may attempt to exfiltrate secrets via outputs, events, HTTP calls, or logs.\n- Debugging and history views must mask secrets by default and enforce explicit permissioning for sensitive disclosure.\n<!-- fdd-id-content -->\n\n#### Risk: Scheduling Scale and Accuracy\n\n**ID**: `fdd-hyperspot-prd-context-risk-scheduling-scale`\n\n<!-- fdd-id-content -->\n- Large numbers of schedules and frequent triggers may stress dispatch and backlog management.\n- The system requires clear policies for missed schedules during downtime and operational visibility into scheduling behavior.\n<!-- fdd-id-content -->","created_at":"2026-01-26T23:02:57Z","updated_at":"2026-01-26T23:03:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729606875","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729606875"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729606875"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729606875/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729664790","pull_request_review_id":3708490911,"id":2729664790,"node_id":"PRRC_kwDOPaLyBs6is2EW","diff_hunk":"","path":"modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"ainetx","id":244471386,"node_id":"U_kgDODpJWWg","avatar_url":"https://avatars.githubusercontent.com/u/244471386?v=4","gravatar_id":"","url":"https://api.github.com/users/ainetx","html_url":"https://github.com/ainetx","followers_url":"https://api.github.com/users/ainetx/followers","following_url":"https://api.github.com/users/ainetx/following{/other_user}","gists_url":"https://api.github.com/users/ainetx/gists{/gist_id}","starred_url":"https://api.github.com/users/ainetx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ainetx/subscriptions","organizations_url":"https://api.github.com/users/ainetx/orgs","repos_url":"https://api.github.com/users/ainetx/repos","events_url":"https://api.github.com/users/ainetx/events{/privacy}","received_events_url":"https://api.github.com/users/ainetx/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## FDD ADR Validation Report\n\n**File**: `modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md`  \n**Validation type**: Content-only (URL input)  \n**Result**: **FAIL**\n\n---\n\n### Summary\n\n| Check | Status |\n|-------|--------|\n| Deterministic Gate (`fdd validate`) | SKIPPED (URL input) |\n| Adapter discovery | SKIPPED (no local repo) |\n| ADR directory structure | N/A (single file) |\n| **ADR format compliance** | **FAIL** |\n\n---\n\n### Findings\n\n#### 1) ADR Header Format\n\n| Expected | Actual | Status |\n|----------|--------|--------|\n| `# ADR-NNNN: Title` | `# ADR — Serverless Runtime Entrypoints...` | FAIL |\n\n#### 2) Required Metadata Fields\n\n| Field | Status |\n|-------|--------|\n| `**Date**: YYYY-MM-DD` | Missing |\n| `**Status**: Proposed` | Present but wrong format |\n| `**ADR ID**: fdd-{project}-adr-{slug}` | Missing |\n\n#### 3) Required MADR Sections\n\n| Section | Status |\n|---------|--------|\n| `## Context and Problem Statement` | Missing (have `## Context`) |\n| `## Considered Options` | Missing |\n| `## Decision Outcome` | Missing |\n| `## Related Design Elements` | Missing |\n\n#### 4) Content Boundaries\n\n| Check | Status |\n|-------|--------|\n| ADR contains decision rationale only | FAIL - Contains full API/schema spec |\n| No detailed implementation plans | FAIL - Contains JSON schemas, endpoints |\n\n---\n\n### Recommendations\n\n#### High Priority\n\n1. **Decide document type**:\n   - If **technical spec**: rename to `SPEC_ENTRYPOINTS.md`, keep under `docs/specs/`\n   - If **ADR**: convert to MADR format, move to `architecture/ADR/`\n\n2. **If converting to ADR, add required structure**:\n\n   ```markdown\n   # ADR-000X: Use unified entrypoint schema for functions and workflows\n\n   **Date**: 2026-01-27\n   **Status**: Proposed\n   **ADR ID**: `fdd-hyperspot-adr-unified-entrypoint`\n\n   ## Context and Problem Statement\n   ...\n\n   ## Considered Options\n   * Option A: Unified schema + invocation surface\n   * Option B: Split products (function API vs workflow API)\n   * Option C: Unified API, separate definition schemas\n\n   ## Decision Outcome\n   Chosen option: \"Option A\", because ...\n\n   ### Consequences\n   * Good, because ...\n   * Bad, because ...\n\n   ## Related Design Elements\n   * `fdd-hyperspot-req-...` - ...\n   ```\n\n#### Medium Priority\n\n- **Split decision from specification**: Keep ADR short, link to separate spec doc for schemas/API shapes\n\n---\n\n### Semantic Expert Review\n\n#### Architect\n\n- **Missing decision rationale**: No explicit decision section; reads like a spec\n- **Missing alternatives**: No \"considered options\" section\n- **Misplaced content**: JSON schemas and endpoint definitions belong in DESIGN/specs, not ADR\n\n**Proposed edits**:\n- Remove `## Schemas` section (move to spec file)\n- Add `## Considered Options` with explicit alternatives\n- Rewrite `## Context` to `## Context and Problem Statement`\n\n#### Security Expert\n\n- **Missing consequences**: No explicit security trade-offs documented\n- Security-relevant claims (\"tenant-safe\", caching scope) stated but not as decisions\n\n**Proposed edits**:\n- Add security consequences: \"Unified debug endpoints increase data leakage risk if authz incorrect\"\n- Clarify: \"dry_run MUST NOT persist records; MUST be rate-limited\"\n\n#### Developer\n\n- **Missing alternatives**: No explicit \"why not Temporal / why not separate workflow engine\"\n- **Misplaced content**: Excellent spec draft, but not an ADR per MADR\n\n**Proposed edits**:\n- Move large inline schema blocks to spec file\n- Rewrite title to decision statement: `ADR-000X: Use unified entrypoint definition schema...`\n\n---\n\n### Next Steps\n\n- [ ] Decide: Is this an ADR or a technical spec?\n- [ ] If ADR: Run `adr` workflow (UPDATE mode) to create proper ADR file\n- [ ] If spec: Rename and reorganize under `docs/specs/`\n\n---\n\n*Generated by FDD adr-validate workflow (content-only mode)*\n","created_at":"2026-01-26T23:27:12Z","updated_at":"2026-01-26T23:27:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729664790","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729664790"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729664790"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729664790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729685127","pull_request_review_id":3708513937,"id":2729685127,"node_id":"PRRC_kwDOPaLyBs6is7CH","diff_hunk":"","path":"modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"ainetx","id":244471386,"node_id":"U_kgDODpJWWg","avatar_url":"https://avatars.githubusercontent.com/u/244471386?v=4","gravatar_id":"","url":"https://api.github.com/users/ainetx","html_url":"https://github.com/ainetx","followers_url":"https://api.github.com/users/ainetx/followers","following_url":"https://api.github.com/users/ainetx/following{/other_user}","gists_url":"https://api.github.com/users/ainetx/gists{/gist_id}","starred_url":"https://api.github.com/users/ainetx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ainetx/subscriptions","organizations_url":"https://api.github.com/users/ainetx/orgs","repos_url":"https://api.github.com/users/ainetx/repos","events_url":"https://api.github.com/users/ainetx/events{/privacy}","received_events_url":"https://api.github.com/users/ainetx/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"# ADR-0002: Use a unified GTS-based entrypoint definition and invocation API for Serverless Runtime\n**Date**: 2026-01-27  \n**Status**: Proposed  \n**ADR ID**: `fdd-hyperspot-adr-serverless-runtime-entrypoints`\n## Context and Problem Statement\nThe Serverless Runtime module needs a stable, tenant-safe way to register and invoke compute entrypoints at runtime, and to observe execution progress and outcomes. We need a consistent contract model for both single-step functions and durable multi-step workflows, with clear invocation semantics (sync/async), structured errors, and debugging/observability surfaces.\nThis ADR captures the architectural decision to model entrypoints as GTS-identified JSON Schemas (types) and to expose a unified invocation API that returns a durable invocation record.\n## Decision Drivers\n- Tenant safety and strong isolation boundaries across invocation, caching, and observability.\n- A single, consistent contract model for function and workflow entrypoints.\n- Strong schema identity and versioning semantics for entrypoint contracts.\n- Operational needs: durable invocation records, status polling, cancellation, timeline/history.\n- Debuggability: correlation IDs, tracing fields, structured error taxonomy, and call traces.\n- Extensibility: ability to support multiple runtimes (e.g., Starlark, WASM, external FaaS) without changing API shapes.\n- Developer ergonomics: one invocation surface and one record shape across sync/async modes.\n## Considered Options\n- Option A: Unified entrypoint definition schema and unified invocation API for both functions and workflows (GTS-based).\n- Option B: Separate products/surfaces for functions vs workflows (split schema models and split APIs).\n- Option C: Unified invocation API but separate definition schemas and separate invocation record shapes per entrypoint kind.\n- Option D: SDK-first orchestration model (Temporal-like), where contract identity is not a first-class GTS type and invocation records are not a unified HTTP API concern.\n## Decision Outcome\nChosen option: \"Option A\", because it creates a single stable definition and invocation surface for both functions and workflows, while preserving the ability for a runtime to apply workflow semantics (durable suspend/resume, checkpoints) when code indicates durability primitives. A single schema identity model (GTS `$id` types) improves consistency, discoverability, and versioning for entrypoint contracts.\nKey elements of the decision:\n- Entrypoints are defined as GTS types (JSON Schemas) whose `$id` ends with `~`.\n- The base entrypoint definition type is `gts.x.core.faas.func.v1~`, and specific entrypoints derive from it.\n- Invocation is performed via a unified endpoint (`POST /api/serverless-runtime/v1/invocations`) and produces a durable `invocation_id` (unless `dry_run`).\n- Both sync and async execution are supported:\n  - `mode: sync` returns a completed invocation record in the HTTP response (subject to gateway timeouts).\n  - `mode: async` returns `202 Accepted` with a pending invocation record and later status polling.\n- Status, cancel, timeline, and debug endpoints exist with consistent response shapes.\n- Errors use a base error envelope type `gts.x.core.faas.err.v1~` with derived error classes (HTTP upstream errors, transport errors, runtime resource errors, code errors).\n- Observability fields include correlation/tracing identifiers and resource metrics.\n### Consequences\n- Good, because unified `InvocationRecord` shapes simplify clients, tooling, documentation, and consistency across runtimes.\n- Good, because GTS type identifiers provide clear schema identity and versioning boundaries for entrypoint contracts.\n- Good, because a structured error taxonomy enables robust retry policies, analytics, and consistent UI representation.\n- Good, because explicit debug and call-trace endpoints improve operational troubleshooting and reduce reliance on “logs only”.\n- Bad, because a unified surface increases the blast radius of API mistakes (authz, data leakage, record exposure) and therefore demands strict authorization and audit controls.\n- Bad, because implementing workflow-like durability semantics in a runtime (suspend/resume, checkpointing) is complex and must be validated rigorously.\n- Bad, because client-side caching hints (`traits.caching.max_age_seconds`) can be misunderstood as correctness guarantees; documentation and policy enforcement must be explicit.\n- Bad, because `sync` mode can encourage long-running executions over HTTP if not guarded by limits and clear guidance.\n## Related Design Elements\n**Actors**:\n- `fdd-hyperspot-actor-runtime-client` - External caller invoking entrypoints via HTTP APIs.\n- `fdd-hyperspot-actor-tenant-admin` - Tenant operator managing configuration and observing invocation outcomes.\n**Capabilities**:\n- `fdd-hyperspot-capability-register-entrypoint` - Register function/workflow entrypoint definitions at runtime.\n- `fdd-hyperspot-capability-invoke-entrypoint` - Invoke an entrypoint in sync or async mode.\n- `fdd-hyperspot-capability-observe-invocation` - Query invocation status, timeline, and debug information.\n**Requirements**:\n- `fdd-hyperspot-req-tenant-isolation` - Invocation records, caching, and observability MUST be tenant-scoped and protected by authorization.\n- `fdd-hyperspot-req-invocation-lifecycle` - System MUST support start, status, cancel, and result retrieval for invocations.\n- `fdd-hyperspot-req-structured-errors` - Errors MUST be structured and classified (upstream, transport, runtime, code).\n- `fdd-hyperspot-req-observability` - Invocation records MUST include correlation/tracing fields and key execution metrics.\n**Principles**:\n- `fdd-hyperspot-principle-unified-contracts` - Prefer one consistent contract model and record shape across similar concepts.\n- `fdd-hyperspot-principle-operability-first` - Designs MUST include first-class observability and debugging affordances.\n## More Information\nThis ADR was converted from `modules/serverless_runtime/docs/2_ADR_ENTRYPOINT.md` into MADR + FDD extensions.\nAssumptions made during conversion (content-only):\n- ADR number chosen as `ADR-0002` based on the source filename prefix `2_...`.\n- Project slug assumed to be `hyperspot` for the ADR ID and related FDD IDs.\n- Related Design Elements IDs are provisional and MUST be aligned with actual IDs from PRD/DESIGN when available.","created_at":"2026-01-26T23:35:24Z","updated_at":"2026-01-26T23:35:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729685127","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729685127"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2729685127"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2729685127/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2779259354","pull_request_review_id":3769725001,"id":2779259354,"node_id":"PRRC_kwDOPaLyBs6lqCHa","diff_hunk":"@@ -0,0 +1,516 @@\n+# ADR — Starlark Runtime (Function & Workflow Execution)\n+\n+## Status\n+Proposed\n+\n+## Context\n+Hyperspot Serverless Runtime supports functions and workflows defined as GTS-identified JSON Schemas and invoked via a unified invocation API.\n+\n+This ADR defines the design of the Starlark runtime implementation used to execute those definitions:\n+- the Starlark program structure (entrypoint contract)\n+- strong typing rules and runtime validation\n+- runtime-provided helper methods (`r_*`) and their versioning\n+- asynchronous execution model (promise + await)\n+- workflow orchestration hooks (steps, retries, compensation, snapshots, event waiting)\n+- example definitions and Starlark programs for functions and workflows\n+\n+This ADR is intentionally aligned with `2_ADR_ENTRYPOINT.md` (Entrypoint schema + Invocation API).\n+\n+## Why Starlark?\n+\n+Starlark is a good fit for Hyperspot Serverless Runtime because it provides a constrained, embeddable, deterministic scripting language with strong tooling hooks.\n+\n+### Fit for functions and workflows\n+- Starlark can express both short-lived function handlers and long-lived workflow orchestration logic using the same `main(ctx, input)` contract.\n+- Workflows rely on runtime-provided primitives (`r_snapshot_v1`, `r_wait_event_v1`, `r_run_step_v1`) rather than language-level threads, exceptions, or background I/O.\n+  This keeps orchestration behavior explicit and makes suspend/resume semantics a runtime feature instead of a language hack.\n+\n+### Rust-first embedding model\n+- The runtime is implemented in Rust and can interpret Starlark directly via an embedded interpreter.\n+- Runtime helpers (`r_*`) are the primary integration surface: the Rust host controls all I/O, persistence, event waiting, step tracking, and compensation.\n+- This model minimizes the host surface area compared to embedding Python/JS while still giving an ergonomic authoring experience.\n+\n+### Static validation via parse/AST and policy checks\n+Starlark allows a practical pre-execution validation pipeline:\n+- parse source into an AST and fail fast on syntax errors\n+- restrict the available built-ins and prohibit disallowed constructs\n+- validate that the program exports `main(ctx, input)`\n+- validate calls to runtime helpers (`r_*`) for arity and argument types where possible\n+- optionally enforce additional policy (e.g., forbid dynamic `load()`, forbid unbounded loops, or require explicit timeouts on I/O helpers)\n+\n+The runtime MAY also perform system-aware validation when registering a function/workflow, for example:\n+- validate that outbound URLs are recognized/allowed by policy and have corresponding credentials configured (e.g., via an outbound API gateway)\n+- validate that referenced event type IDs are registered in the system\n+- validate error types are registered in the system\n+- validate function/workflow contract against entrypoint schema\n+\n+### Determinism and replayability\n+- Starlark is designed to be deterministic given the same inputs and host-provided functions.\n+- The runtime can ensure all nondeterminism flows through `r_*` helpers, which are versioned and can be recorded/replayed.\n+- This is critical for durable workflows that may be resumed from snapshots and must behave consistently.\n+\n+### Resource controls and safe execution\n+- Because execution happens inside our Rust host, the runtime can enforce limits (wall-clock, instruction count/step budget, memory, and CPU quotas) at the interpreter boundary.\n+- Restricting the language and the host surface makes it easier to sandbox than general-purpose runtimes.\n+\n+### Debuggability (breakpoints, stack traces, tracing)\n+- Starlark evaluation naturally exposes execution state (call stack, frames, current location) to the host.\n+- The runtime can implement:\n+  - setting breakpoints by source location\n+  - pausing/resuming execution and inspecting locals\n+  - structured tracing of `r_*` calls, including step boundaries and awaited events\n+  - deterministic stack traces aligned with source\n+\n+### Familiarity (humans and LLMs)\n+- Starlark syntax is intentionally Python-like, making it familiar to Python users.\n+- Its Python-like surface also makes it a strong target for LLM-assisted authoring, review, and transformation.\n+\n+### Stewardship\n+Starlark is used by Bazel and the language specification is maintained in the `bazelbuild` ecosystem with strong ongoing involvement from the Bazel community and Google.\n+\n+For Rust-based embedding, `starlark-rust` is a widely used Rust implementation of Starlark (commonly referenced as `facebook/starlark-rust` / Meta) published as standard crates.\n+\n+### Alternatives (quick comparison)\n+- WebAssembly (Wasm)\n+  - Pros: strong sandboxing, mature tooling, good performance\n+  - Cons: heavier authoring model, less ergonomic for orchestration scripting, debugging and host-call surface can be more complex, deterministic replay requires additional conventions\n+- JavaScript (embedded engine)\n+  - Pros: familiar language, large ecosystem\n+  - Cons: larger runtime/attack surface, more complexity around determinism, resource control, and sandboxing; host embedding is heavier\n+- Python\n+  - Pros: very popular, high productivity\n+  - Cons: embedding/sandboxing is hard, resource controls are complex, too many dynamic escape hatches for a multi-tenant runtime\n+- Lua\n+  - Pros: embeddable, small\n+  - Cons: less aligned with structured typing via `struct(...)` conventions and our desired validation ergonomics; ecosystem familiarity varies\n+- Custom DSL\n+  - Pros: maximum control and validation\n+  - Cons: high implementation cost, poor ergonomics, and tends to grow into a full language over time\n+\n+## Goals\n+- Provide a deterministic and safe execution model for runtime created/updated code.\n+- Make functions and workflows compatible with a single language/runtime surface.\n+- Enforce schema-based typing and prevent invalid input/output at runtime.\n+- Support long-running execution patterns: waiting on events, suspend/resume, and snapshots.\n+- Provide a versioned runtime API so code remains forward-compatible.\n+\n+## Non-goals\n+- Defining the full sandboxing / isolation strategy.\n+- Defining the persistence format for snapshots.\n+- Defining the complete event transport implementation.\n+\n+## Starlark program structure\n+\n+### Entrypoint\n+All Starlark functions and workflows MUST expose a `main(ctx, input)` function.\n+\n+- `ctx` is a runtime-provided context object.\n+- `input` is the validated input object matching the entrypoint `params` schema.\n+\n+`main()` MUST return a value matching the entrypoint `returns` schema or terminate execution via `r_exit(...)`.\n+\n+## Strong type system\n+\n+### Source of truth\n+The source of truth for function/workflow types is the GTS-identified JSON Schema:\n+- `params` (input)\n+- `returns` (output)\n+- `errors` (error envelope types)\n+\n+### Validation rules\n+- On function registration, the runtime MUST validate `params` against the entrypoint schema before executing Starlark.\n+- Similarly, the runtime MUST validate the returned value against the `returns` schema.\n+- For workflows, the runtime MUST validate snapshot state and resumption input before continuing.\n+\n+### Starlark typing model\n+Starlark is dynamically typed, but the runtime enforces a strong type system by:\n+- validating boundary values (input/output)\n+- validating `r_*` method arguments (e.g., `url` must be string)\n+- validating `r_wait_event(...)` against an event schema ID and payload schema\n+\n+For maximum ergonomics and stricter typing, the runtime SHOULD materialize validated inputs as a Starlark `struct(...)` with fields matching the JSON Schema properties (instead of a generic dict). This enables `input.customer_id` style access.\n+\n+All objects returned to the caller MUST be compatible with the JSON Schema types declared in `returns`.\n+In practice, this means Starlark programs MUST treat returned objects as strongly typed structs:\n+- no missing required fields\n+- no additional fields when `additionalProperties` is false\n+- field types must match schema\n+\n+## Runtime helper methods (versioned)\n+All runtime helper methods (`r_*`) MUST be versioned to preserve compatibility across functions and workflows.\n+\n+### Common conventions\n+- All helper names are prefixed with `r_`.\n+- Methods that perform I/O MUST be async and return a promise.\n+- Methods that influence control flow (`r_exit`, `r_snapshot`) MUST be deterministic.\n+\n+To preserve determinism and replayability, Starlark programs MUST NOT use nondeterministic sources such as embedded `datetime.now()` or `random.random()`.\n+If time or randomness is required, it MUST be obtained via runtime helpers provided by the Rust host.\n+\n+### Promise and await\n+The runtime provides a minimal async model:\n+\n+- `Promise<T>` is an opaque runtime object.\n+- `r_await(promise)` waits for the promise to resolve and returns `T`.\n+\n+The runtime MAY also support `r_await_all([p1, p2, ...])` to resolve multiple promises concurrently.\n+\n+If `r_await(...)` is called on a promise that cannot complete without external input (event or timer), the runtime MUST suspend the invocation and resume it when the promise becomes ready.\n+\n+### HTTP helpers\n+\n+#### Response shape\n+`r_http_*_v1()` resolves to an `HttpResult` value which never raises exceptions and can represent either a successful HTTP response or an error.\n+\n+`HttpResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access (`result.ok`, `result.response`, `result.error`).\n+\n+Successful response:\n+- `ok` (boolean, `true`)\n+- `response` (a Starlark `struct(...)`)\n+  - `status_code` (integer)\n+  - `headers` (dict)\n+  - `body` (dict)\n+\n+Error response:\n+- `ok` (boolean, `false`)\n+- `error` (a Starlark `struct(...)`) compatible with the runtime error envelope defined in `2_ADR_ENTRYPOINT.md`.\n+  - for non-2xx upstream responses: `gts.x.core.faas.err.v1~x.core._.http.v1~`\n+  - for upstream transport failures: `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.timeout.v1~` and `gts.x.core.faas.err.v1~x.core._.http_transport.v1~x.core._.no_connection.v1~`\n+  - for runtime failures: `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.memory_limit.v1~`, `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.cpu_limit.v1~`, and `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.canceled.v1~`\n+\n+If the upstream response body is not JSON, the runtime SHOULD return an empty object for `response.body`.\n+\n+#### r_http_get_v1(...)\n+Signature:\n+- `r_http_get_v1(url, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+Notes:\n+- `url` is required.\n+- `headers` is an optional dict.\n+- `timeout_ms` is optional.\n+- `retry` is optional runtime-defined retry policy (e.g., {\"max_attempts\": 3, \"backoff_ms\": 200}).\n+- `exit_on_http_error=true` means the runtime calls `r_exit(...)` on non-2xx upstream responses or on upstream transport failures.\n+- `exit_on_http_error=false` means the promise resolves to an `HttpResult` and the Starlark code is responsible for handling `ok=false` and/or non-2xx status codes.\n+\n+NOTE: The runtime MUST NOT perform outbound HTTP requests directly. Instead, it MUST delegate outbound calls to the outbound API gateway so that security context, credential management, and internal-to-external token/authorization exchange are applied consistently and all egress traffic is centrally enforced and observed.\n+\n+#### r_http_post_v1(...)\n+Signature:\n+- `r_http_post_v1(url, body, headers=None, timeout_ms=None, retry=None, exit_on_http_error=True) -> Promise<HttpResult>`\n+\n+### Sleep\n+- `r_sleep(milliseconds) -> Promise<None>`\n+\n+### Time and randomness (deterministic)\n+- `r_now_v1() -> string`\n+- `r_rand_v1(label=None) -> string`\n+\n+`r_now_v1()` returns a runtime-provided timestamp string. For workflows, the runtime MUST ensure the returned value is replay-safe (e.g., captured/recorded at a deterministic boundary and reused on resume).\n+\n+`r_rand_v1(...)` returns a runtime-provided pseudo-random value. For workflows, the runtime MUST ensure the returned value is replay-safe (e.g., derived from invocation identity + an optional label, and/or recorded for deterministic replay).\n+\n+### Exit\n+- `r_exit(error) -> None`\n+\n+`error` MUST be an object compatible with the runtime error envelope.\n+\n+For workflows, calling `r_exit(...)` terminates execution and triggers compensation for previously completed steps:\n+- the runtime MUST execute all registered compensation actions for steps that completed successfully prior to the `r_exit(...)` call\n+- compensations MUST be executed in reverse step completion order\n+- the runtime MUST NOT invoke compensation for steps that did not complete successfully\n+\n+### Event waiting\n+\n+#### r_wait_event_v1(...)\n+Signature:\n+- `r_wait_event_v1(event_type_id, event_filter_query=None, timeout_ms=None, exit_on_error=True) -> Promise<EventWaitResult>`\n+\n+- `event_type_id` MUST be a GTS type ID string ending with `~` (e.g., `gts.x.core.events.event.v1~vendor.app.some.event.v1~`).\n+- `event_filter_query` MUST be a valid event filter query string supported by the event broker.\n+- `timeout_ms` MUST be a non-negative integer.\n+- The event payload MUST be validated against the event type schema.\n+\n+`EventWaitResult` SHOULD be represented as a Starlark `struct(...)` so callers can use attribute access.\n+\n+- `struct(ok = True, value = <Event>)` when the event is received\n+- `struct(ok = False, error = <FaaS Error envelope>)` when the wait fails\n+\n+When an error occurs while waiting (including a timeout):\n+- if `exit_on_error=true`, the runtime MUST call `r_exit(...)` with an error envelope\n+- if `exit_on_error=false`, the promise MUST resolve with `struct(ok = False, error = ...)`\n+\n+When `timeout_ms` is provided and the timeout occurs, the error envelope id MUST be `gts.x.core.faas.err.v1~x.core._.runtime.v1~x.core._.timeout.v1~`.\n+\n+Waiting on an event is implemented by:\n+- the runtime suspending the invocation\n+- registering an event subscription\n+- resuming execution when the event arrives or timeout occurs\n+\n+### Snapshotting\n+\n+#### r_snapshot_v1(...)\n+Signature:\n+- `r_snapshot_v1(label=None) -> None`\n+\n+Calling `r_snapshot_v1()` requests the runtime to capture a durable snapshot of execution state.\n+The snapshot includes:\n+- call stack / instruction pointer\n+- relevant variable bindings\n+- workflow runtime metadata needed for resume\n+\n+The runtime may automatically take snapshots at safe points, but `r_snapshot_v1()` allows user code to request one explicitly.\n+\n+## Workflow orchestration hooks\n+For workflows, the runtime is responsible for orchestrating typical workflow processing:\n+- identifying steps\n+- tracking step status and retries\n+- scheduling retries\n+- registering compensation actions\n+- checkpointing and suspend/resume via snapshots\n+- event subscription and event-driven continuation\n+\n+To support this, the runtime provides workflow helpers.\n+\n+### Workflow helpers\n+\n+#### r_step_v1(name, fn, compensate_fn=None)\n+Registers a step function, optional compensation function, and returns a callable wrapper.\n+\n+If `compensate_fn` is provided, it MUST accept the step output as its second argument:\n+- `fn(ctx, step_input) -> <step output>`\n+- `compensate_fn(ctx, step_input, step_output) -> None`\n+\n+The runtime automatically passes:\n+- `step_input` to the step function when executing the step and as the first argument to the compensation function\n+- `step_output` to the compensation function when invoking compensation\n+\n+This enables the main action to provide context to the compensation action by returning it as part of the step output (e.g., a created object ID).\n+\n+#### r_run_step_v1(step_name, fn, input, exit_on_error=True)\n+Executes a step with runtime tracking, retry policy, and status updates.\n+\n+`exit_on_error=true` means the runtime calls `r_exit(...)` if the step fails.\n+`exit_on_error=false` means the function returns a result object and the Starlark code is responsible for handling `ok=false`.\n+\n+The `r_run_step_v1(...)` function returns a result object:\n+- `struct(ok = True, value = <step output>)` on success\n+- `struct(ok = False, error = <FaaS Error envelope>)` on failure\n+\n+The exact internal representation is runtime-defined; the Starlark surface remains stable.\n+\n+Compensation invocation:\n+- When a workflow terminates unsuccessfully via `r_exit(...)` (or a runtime abort that maps to a workflow failure), the runtime MUST execute registered compensation actions for all previously completed steps.\n+- Compensations MUST be executed in reverse step completion order.\n+- Compensation failures MUST NOT cause additional compensations to be skipped; they MUST be recorded and surfaced via workflow status and logs.\n+\n+## Examples\n+\n+### Function example #1: two upstream calls and composite output\n+\n+#### Function definition (GTS schema)\n+```json\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"gts://gts.x.core.faas.func.v1~vendor.app.example.compose_customer_profile.v1~\",\n+  \"allOf\": [\n+    {\"$ref\": \"gts://gts.x.core.faas.func.v1~\"}\n+  ],\n+  \"type\": \"object\",\n+  \"properties\": {\n+    \"id\": {\"const\": \"gts.x.core.faas.func.v1~vendor.app.example.compose_customer_profile.v1~\"},\n+    \"params\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"customer_id\": {\"type\": \"string\"}\n+        },\n+        \"required\": [\"customer_id\"]\n+      }\n+    },\n+    \"returns\": {\n+      \"const\": {\n+        \"type\": \"object\",\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"customer\": {\"type\": \"object\", \"additionalProperties\": true},\n+          \"orders\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": true}}\n+        },\n+        \"required\": [\"customer\", \"orders\"]\n+      }\n+    },\n+    \"traits\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"runtime\": {\"const\": \"starlark\"},\n+        \"invocation\": {\n+          \"type\": \"object\",\n+          \"properties\": {\"supported\": {\"const\": [\"sync\", \"async\"]}, \"default\": {\"const\": \"sync\"}},\n+          \"required\": [\"supported\"]\n+        },\n+        \"caching\": {\n+          \"type\": \"object\",\n+          \"properties\": {\"max_age_seconds\": {\"const\": 0}},\n+          \"required\": [\"max_age_seconds\"]\n+        }\n+      },\n+      \"required\": [\"runtime\"]\n+    },\n+    \"implementation\": {\n+      \"type\": \"object\",\n+      \"properties\": {\n+        \"code\": {\n+          \"type\": \"object\",\n+          \"properties\": {\n+            \"language\": {\"const\": \"starlark\"},\n+            \"source\": {\"const\": \"\"}\n+          },\n+          \"required\": [\"language\"]\n+        }\n+      },\n+      \"required\": [\"code\"]\n+    }\n+  },\n+  \"required\": [\"id\", \"params\", \"returns\", \"traits\", \"implementation\"]\n+}\n+```\n+\n+#### Starlark code\n+```python\n+# main() is the required entrypoint.\n+\n+def main(ctx, input):\n+    customer_id = input.customer_id\n+\n+    p_customer = r_http_get_v1(\n+        \"https://example.crm/api/customers/\" + customer_id,\n+        timeout_ms = 2000,\n+        retry = {\"max_attempts\": 3, \"backoff_ms\": 200},\n+        exit_on_http_error = True,\n+    )\n+\n+    p_orders = r_http_get_v1(\n+        \"https://example.orders/api/orders?customer_id=\" + customer_id,\n+        timeout_ms = 2000,\n+        retry = {\"max_attempts\": 3, \"backoff_ms\": 200},\n+        exit_on_http_error = True,\n+    )\n+\n+    customer_result = r_await(p_customer)\n+    orders_result = r_await(p_orders)\n+\n+    customer_resp = customer_result.response\n+    orders_resp = orders_result.response\n+\n+    orders_body = orders_resp.body\n+    orders_items = orders_body[\"items\"] if \"items\" in orders_body else []\n+\n+    return {\n+        \"customer\": customer_resp.body,\n+        \"orders\": orders_items,\n+    }\n+```\n+\n+### Function example #2: handle upstream HTTP error/timeout\n+\n+This example demonstrates disabling automatic exit and returning a structured result.\n+\n+```python\n+\n+def main(ctx, input):\n+    customer_id = input.customer_id\n+\n+    p_customer = r_http_get_v1(\n+        \"https://example.crm/api/customers/\" + customer_id,\n+        timeout_ms = 500,\n+        retry = {\"max_attempts\": 1, \"backoff_ms\": 0},\n+        exit_on_http_error = False,\n+    )\n+\n+    customer_result = r_await(p_customer)\n+\n+    if not customer_result.ok:\n+        return {\n+            \"customer\": {\"id\": customer_id, \"status\": \"unavailable\"},\n+            \"orders\": [],\n+        }\n+\n+    customer_resp = customer_result.response\n+\n+    if customer_resp.status_code >= 400:\n+        return {\n+            \"customer\": {\"id\": customer_id, \"status\": \"unavailable\"},\n+            \"orders\": [],\n+        }\n+\n+    return {\n+        \"customer\": customer_resp.body,\n+        \"orders\": [],\n+    }\n+```\n+\n+### Example #3: workflow with steps, event waiting, snapshots, and compensation\n+\n+#### Workflow definition (high-level)\n+Workflows use the same entrypoint schema model, but are executed with durable semantics.\n+\n+#### Starlark workflow code\n+```python\n+\n+def step_reserve_inventory(ctx, input):\n+    p = r_http_post_v1(\n+        \"https://example.inventory/api/reservations\",\n+        body = {\"sku\": input.sku, \"qty\": input.qty},\n+        timeout_ms = 2000,\n+        retry = {\"max_attempts\": 3, \"backoff_ms\": 200},\n+        exit_on_http_error = True,\n+    )\n+    resp = r_await(p).response\n+    reservation_id = resp.body.get(\"reservation_id\")\n+    return struct(reservation_id = reservation_id)\n+\n+\n+def compensate_release_inventory(ctx, step_input, step_output):\n+    reservation = step_output\n+    p = r_http_post_v1(\n+        \"https://example.inventory/api/reservations:release\",\n+        body = {\"reservation_id\": reservation.reservation_id},\n+        timeout_ms = 2000,\n+        retry = {\"max_attempts\": 3, \"backoff_ms\": 200},\n+        exit_on_http_error = False,\n+    )\n+    release_result = r_await(p)\n+    if not release_result.ok:\n+        return None\n+    return None\n+\n+\n+def main(ctx, input):\n+    reserve = r_step_v1(\"reserve_inventory\", step_reserve_inventory, compensate_release_inventory)\n+\n+    reservation_result = r_run_step_v1(\"reserve_inventory\", reserve, input) # exists on error","path":"modules/serverless_runtime/docs/3_ADR_STARLARK_RUNTIME.md","commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","original_commit_id":"3f9d764ada1bd5c08b0b8e67ae266dd362da3932","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Typo in comment: 'exists on error' should be 'exits on error'\n\n```python\nreservation_result = r_run_step_v1(\"reserve_inventory\", reserve, input) # exits on error\n```\n```suggestion\n    reservation_result = r_run_step_v1(\"reserve_inventory\", reserve, input) # exits on error\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=cyberfabric&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/cyberfabric/cyberfabric-core/243?chatWithGeneratedComment=10073178-80ea-4f85-9fd9-ad8f2bdeeaae\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-02-08T13:20:33Z","updated_at":"2026-02-08T13:20:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2779259354","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2779259354"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/243#discussion_r2779259354"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/243"}},"reactions":{"url":"https://api.github.com/repos/cybe
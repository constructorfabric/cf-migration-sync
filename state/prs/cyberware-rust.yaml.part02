ype\": {\n+      \"$ref\": \"#/$defs/SearchType\"\n+    },\n+    \"provider_id\": {\n+      \"type\": \"string\",\n+      \"description\": \"Specific provider GTS ID, or tenant default if omitted\"\n+    },\n+    \"options\": {\n+      \"$ref\": \"#/$defs/SearchOptions\"\n+    }\n+  },\n+  \"$defs\": {\n+    \"SearchType\": {\n+      \"type\": \"string\",\n+      \"description\": \"Type of search to perform\",\n+      \"enum\": [\"web\", \"news\", \"image\", \"video\", \"academic\"],\n+      \"default\": \"web\"\n+    },\n+    \"SearchOptions\": {\n+      \"type\": \"object\",\n+      \"description\": \"Optional search parameters\",\n+      \"properties\": {\n+        \"max_results\": {\n+          \"type\": \"integer\",\n+          \"description\": \"Maximum results to return\",\n+          \"minimum\": 1,\n+          \"maximum\": 100,\n+          \"default\": 10\n+        },\n+        \"language\": {","path":"modules/web_search_gateway/gts/search_request.v1.json","commit_id":"8af9588dc0a4b2752bc18bbd5b54df0d630b8b23","original_commit_id":"8af9588dc0a4b2752bc18bbd5b54df0d630b8b23","user":{"login":"akshatjhalani","id":6149183,"node_id":"MDQ6VXNlcjYxNDkxODM=","avatar_url":"https://avatars.githubusercontent.com/u/6149183?v=4","gravatar_id":"","url":"https://api.github.com/users/akshatjhalani","html_url":"https://github.com/akshatjhalani","followers_url":"https://api.github.com/users/akshatjhalani/followers","following_url":"https://api.github.com/users/akshatjhalani/following{/other_user}","gists_url":"https://api.github.com/users/akshatjhalani/gists{/gist_id}","starred_url":"https://api.github.com/users/akshatjhalani/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akshatjhalani/subscriptions","organizations_url":"https://api.github.com/users/akshatjhalani/orgs","repos_url":"https://api.github.com/users/akshatjhalani/repos","events_url":"https://api.github.com/users/akshatjhalani/events{/privacy}","received_events_url":"https://api.github.com
ers/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The `allow_insecure_http` function in modkit-http is guarded by debug assertion, hence, i kept the macro here. Do u prefer to remove the macro in modkit-http as well?\r\nhttps://github.com/cyberfabric/cyberfabric-core/blob/main/libs/modkit-http/src/builder.rs#L124","created_at":"2026-02-12T10:46:08Z","updated_at":"2026-02-12T10:46:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798127575","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798127575"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798127575"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798127575/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":10,"side":"RIGHT","in_reply_to_id":2798070082,"author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798140173","pull_request_review_id":3790177893,"id":2798140173,"node_id":"PRRC_kwDOPaLyBs6myDsN","diff_hunk":"@@ -206,6 +203,20 @@ dylint-list:\n \n ## Test dylint lints on UI test cases (compile and verify violations)\n dylint-test:\n+\t@cd dylint_lints && cargo build","path":"Makefile","commit_id":"a05d1371e9e00f3a2c7003601b8532487c5befcc","original_commit_id":"a05d1371e9e00f3a2c7003601b8532487c5befcc","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ah, i encountered some dylint error previously and this was the fix suggested by AI. It looks like the issue was fixed somewhere along the way by someone. Will revert this. :)","created_at":"2026-02-12T10:48:31Z","updated_at":"2026-02-12T10:48:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798140173","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798140173"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798140173"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798140173/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":206,"side":"RIGHT","in_reply_to_id":2798064695,"author_association":"MEMBER","original_position":14,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798743367","pull_request_review_id":3790862530,"id":2798743367,"node_id":"PRRC_kwDOPaLyBs6m0W9H","diff_hunk":"@@ -4,3 +4,24 @@\n //! modular web applications.\n \n pub mod sse;\n+\n+/// Conditionally enables insecure HTTP on an `HttpClient` builder in debug builds.\n+#[macro_export]\n+macro_rules! maybe_allow_insecure_http {","path":"libs/modkit/src/http/mod.rs","commit_id":"81e701c205542b2974063295096bf01e1c6c2b5a","original_commit_id":"a05d1371e9e00f3a2c7003601b8532487c5befcc","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Discussed internally with Bruno. Let's leave this function as-is.\r\nRationale:\r\nThe concerns would be valid if this was about debug_assert!(). But this code does not use debug_assert!. It uses cfg(debug_assertions), which is a compile-time gate, not a runtime check.\r\n \r\nYes, cargo test, cargo run, and their -r variants use different profiles. That is expected and documented behavior. It is not “unreliable”. It is deterministic and fully controlled by Cargo profiles.\r\n\r\nDifferent behavior between debug and release is normal in Rust and in systems programming in general. It is not a bug and not a design flaw by default. Rust itself does this: debug_assert! exists. overflow-checks differ by profile. panic = abort vs unwind and etc. \r\n \r\nAlso we have no debug assertion logic leaking into prod. This is a compile-time restriction for a dangerous API.\r\nThe method is intentionally unavailable in release unless explicitly enabled.\r\n\r\n \r\n\r\n","created_at":"2026-02-12T12:54:14Z","updated_at":"2026-02-12T12:54:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798743367","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798743367"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2798743367"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2798743367/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":10,"side":"RIGHT","in_reply_to_id":2798070082,"author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803586991","pull_request_review_id":3796597396,"id":2803586991,"node_id":"PRRC_kwDOPaLyBs6nG1ev","diff_hunk":"@@ -327,9 +324,15 @@ e2e-smoke:\n e2e-local:\n \tpython3 scripts/ci.py e2e\n \n-## Run E2E tests in Docker environment\n+## Run E2E tests in Docker environment (default: sqlite)\n e2e-docker:\n-\tpython3 scripts/ci.py e2e --docker $(E2E_ARGS)\n+\tpython3 scripts/ci.py e2e --docker --cargo-build-args=\"--features users-info-example,tenant-resolver-example\" $(E2E_ARGS)\n+\n+e2e-docker-pg:","path":"Makefile","commit_id":"96961423e65f58ee94d5cdd9084efc7d45d9a9b9","original_commit_id":"6da276bbdc10f74f88703c6f15ea189c74aba249","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Please add comments above, so that 'make' would show e2e-docker-pg and e2e-docker-mysql targets in output\n\n```\n$ make\n...\n\nE2E tests:\n * e2e                 - Run E2E tests in Docker (default)\n * e2e-local           - Run E2E tests locally\n   e2e-docker          - Run E2E tests in Docker environment\n...\n```","created_at":"2026-02-13T10:48:59Z","updated_at":"2026-02-13T10:49:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803586991","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803586991"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2803586991"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803586991/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":453,"original_line":331,"side":"RIGHT","author_association":"MEMBER","original_position":29,"position":25,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2803588457","pull_request_review_id":3796597396,"id":2803588457,"node_id":"PRRC_kwDOPaLyBs6nG11p","diff_hunk":"@@ -3,9 +3,6 @@ CI := 1\n OPENAPI_URL ?= http://127.0.0.1:8087/openapi.json\n OPENAPI_OUT ?= docs/api/api.json\n \n-# E2E Docker args","path":"Makefile","commit_id":"edb4135782463e08644a3b2175bc694d3c5417ab","original_commit_id":"6da276bbdc10f74f88703c6f15ea189c74aba249","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"h
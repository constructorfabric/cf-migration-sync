                       let anth_ctx = tenant_security_context(event.tenant_id);\n+                        match client.delete_file(anth_ctx, alias, file_id).await {\n+                            Ok(()) => {\n+                                tracing::debug!(\n+                                    attachment_id = %event.attachment_id,\n+                                    anthropic_file_id = %file_id,\n+                                    \"attachment cleanup: Anthropic file deleted\"\n+                                );\n+                            }\n+                            Err(e) => {\n+                                warn!(\n+                                    attachment_id = %event.attachment_id,\n+                                    anthropic_file_id = %file_id,\n+                                    error = %e,\n+                                    \"attachment cleanup: Anthropic delete failed (orphaned); \\\n+                                     continuing with primary cleanup\"\n+                                );\n+                            }\n+                        }\n+                    } else {\n+                        warn!(\n+                            attachment_id = %event.attachment_id,\n+                            secondary_file_id = %file_id,\n+                            \"attachment cleanup: payload references anthropic secondary but no \\\n+                             client configured; orphaned\"","path":"modules/mini-chat/mini-chat/src/infra/workers/cleanup_worker.rs","commit_id":"145432d4874370acc0712627a65be5010a84fcc2","original_commit_id":"c40106506f9c641b6a33b37e09a5c1f718177457","user":{"login":"jalankulkija","id":260627792,"node_id":"U_kgDOD4jdUA","avatar_url":"https://avatars.githubusercontent.com/u/260627792?v=4","gravatar_id":"","url":"https://api.github.com/users/jalankulkija","html_url":"https://github.com/jalankulkija","followers_url":"https://api.github.com/users/jalankulkija/followers","following_url":"https://api.github.com/users/jalankulkija/following{/other_user}","gists_url":"https://api.github.com/users/jalankulkija/gists{/gist_id}","starred_url":"https://api.github.com/users/jalankulkija/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jalankulkija/subscriptions","organizations_url":"https://api.github.com/users/jalankulkija/orgs","repos_url":"https://api.github.com/users/jalankulkija/repos","events_url":"https://api.github.com/users/jalankulkija/events{/privacy}","received_events_url":"https://api.github.com/users/jalankulkija/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed","created_at":"2026-05-18T12:56:01Z","updated_at":"2026-05-18T12:56:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259050343","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259050343"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259050343"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259050343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":225,"original_line":228,"side":"RIGHT","in_reply_to_id":3253837156,"author_association":"MEMBER","original_position":91,"position":88,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259051123","pull_request_review_id":4310317477,"id":3259051123,"node_id":"PRRC_kwDOPaLyBs7CQSxz","diff_hunk":"@@ -392,6 +474,60 @@ impl LeasedMessageHandler for ChatCleanupHandler {\n                 }\n             }\n \n+            // Secondary-provider delete (best-effort).\n+            //\n+            // The chat-cleanup payload carries `secondary_upstream_alias`\n+            // resolved at chat-delete time; the attachment row carries\n+            // `secondary_file_id` and `secondary_provider_kind` from the\n+            // parallel upload. Failure is logged but does NOT block marking\n+            // this attachment done — the primary cleanup gates the\n+            // user-visible state, and a secondary orphan needs a separate\n+            // reaper. Today only `provider_kind = \"anthropic\"` is wired.\n+            if let (Some(file_id), Some(provider_kind), Some(alias)) = (\n+                att.secondary_file_id.as_deref(),\n+                att.secondary_provider_kind.as_deref(),\n+                event.secondary_upstream_alias.as_deref(),\n+            ) {\n+                use crate::infra::db::entity::attachment::SecondaryUploadStatus;\n+                if att.secondary_status == SecondaryUploadStatus::Uploaded {\n+                    match provider_kind {\n+                        \"anthropic\" => {\n+                            if let Some(client) = self.anthropic_files_client.as_ref() {\n+                                let anth_ctx = tenant_security_context(event.tenant_id);\n+                                match client.delete_file(anth_ctx, alias, file_id).await {\n+                                    Ok(()) => {\n+                                        tracing::debug!(\n+                                            chat_id = %chat_id,\n+                                            attachment_id = %att.id,\n+                                            anthropic_file_id = %file_id,\n+                                            \"chat cleanup: Anthropic file deleted\"\n+                                        );\n+                                    }\n+                                    Err(e) => {\n+                                        warn!(\n+                                            chat_id = %chat_id,\n+                                            attachment_id = %att.id,\n+                                            anthropic_file_id = %file_id,\n+                                            error = %e,\n+                                            \"chat cleanup: Anthropic delete failed (orphaned); \\\n+                                             continuing\"\n+                                        );","path":"modules/mini-chat/mini-chat/src/infra/workers/cleanup_worker.rs","commit_id":"145432d4874370acc0712627a65be5010a84fcc2","original_commit_id":"c40106506f9c641b6a33b37e09a5c1f718177457","user":{"login":"jalankulkija","id":260627792,"node_id":"U_kgDOD4jdUA","avatar_url":"https://avatars.githubusercontent.com/u/260627792?v=4","gravatar_id":"","url":"https://api.github.com/users/jalankulkija","html_url":"https://github.com/jalankulkija","followers_url":"https://api.github.com/users/jalankulkija/followers","following_url":"https://api.github.com/users/jalankulkija/following{/other_user}","gists_url":"https://api.github.com/users/jalankulkija/gists{/gist_id}","starred_url":"https://api.github.com/users/jalankulkija/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jalankulkija/subscriptions","organizations_url":"https://api.github.com/users/jalankulkija/orgs","repos_url":"https://api.github.com/users/jalankulkija/repos","events_url":"https://api.github.com/users/jalankulkija/events{/privacy}","received_events_url":"https://api.github.com/users/jalankulkija/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed","created_at":"2026-05-18T12:56:08Z","updated_at":"2026-05-18T12:56:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259051123","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259051123"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259051123"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259051123/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":515,"original_line":514,"side":"RIGHT","in_reply_to_id":3253837157,"author_association":"MEMBER","original_position":186,"position":187,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259052206","pull_request_review_id":4310318941,"id":3259052206,"node_id":"PRRC_kwDOPaLyBs7CQTCu","diff_hunk":"@@ -24,6 +24,19 @@ pub struct AttachmentCleanupEvent {\n     pub storage_backend: String,\n     pub attachment_kind: String,\n     pub deleted_at: OffsetDateTime,\n+    /// `Some` when the chat performed a secondary upload that succeeded\n+    /// (`secondary_status = uploaded`). The cleanup worker uses this to\n+    /// issue a provider-specific `DELETE` after the primary delete succeeds.\n+    #[serde(default)]\n+    pub secondary_file_id: Option<String>,\n+    /// Which provider's id is in `secondary_file_id` (e.g. `\"anthropic\"`).\n+    /// Set together with `secondary_file_id`.\n+    #[serde(default)]","path":"modules/mini-chat/mini-chat/src/domain/repos/outbox_enqueuer.rs","commit_id":"c40106506f9c641b6a33b37e09a5c1f718177457","original_commit_id":"c40106506f9c641b6a33b37e09a5c1f718177457","user":{"login":"jalankulkija","id":260627792,"node_id":"U_kgDOD4jdUA","avatar_url":"https://avatars.githubusercontent.com/u/260627792?v=4","gravatar_id":"","url":"https://api.github.com/users/jalankulkija","html_url":"https://github.com/jalankulkija","followers_url":"https://api.github.com/users/jalankulkija/followers","following_url":"https://api.github.com/users/jalankulkija/following{/other_user}","gists_url":"https://api.github.com/users/jalankulkija/gists{/gist_id}","starred_url":"https://api.github.com/users/jalankulkija/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jalankulkija/subscriptions","organizations_url":"https://api.github.com/users/jalankulkija/orgs","repos_url":"https://api.github.com/users/jalankulkija/repos","events_url":"https://api.github.com/users/jalankulkija/events{/privacy}","received_events_url":"https://api.github.com/users/jalankulkija/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed","created_at":"2026-05-18T12:56:17Z","updated_at":"2026-05-18T12:56:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259052206","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259052206"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1909#discussion_r3259052206"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1909"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3259052206/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":34,"side":"RIGHT","in_reply_to_id":3253837158,"author_association":"MEMBER","original_position":11,"position":1,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":1908,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908","source_state":"closed","source_author":"capybutler","target_issue_number":null,"title":"[PR #1908] feat(usage-collector): [2/6] add emitter, gateway, REST client, and noop storage plugin crates","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"usage-collector/feature-1/collector+emitter+noop-plugin","pr_head_sha":"d5ec0407bd5d4470128a88cdce738af2d9f96973","pr_base_ref":"usage-collector/feature-1/docs+sdk","pr_head_owner":"capybutler","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","id":3689202277,"node_id":"PR_kwDOPaLyBs7b5MJl","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1908","number":1908,"state":"closed","locked":false,"title":"feat(usage-collector): [2/6] add emitter, gateway, REST client, and noop storage plugin crates","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Introduces the core ingest-path crates completing Feature 1 (SDK & Ingest Core):\r\n\r\n- `usage-emitter`: two-phase PDP authorization (`authorize_for` / `authorize`), `UsageRecordBuilder` fluent API, transactional outbox enqueue (`enqueue` / `enqueue_in`), and async delivery worker forwarding to `UsageCollectorClientV1`. The security invariant ensures `UsageCollectorClientV1` is never published to `ClientHub`; source modules can only reach the collector through a PDP-authorized, tenant/resource-bound `AuthorizedUsageEmitter`.\r\n\r\n- `usage-collector`: gateway ModKit module; resolves the active storage plugin by vendor, registers `UsageCollectorLocalClient` as `dyn UsageCollectorClientV1`, wires in the embedded emitter, and serves the REST ingestion API for out-of-process callers.\r\n\r\n- `noop-usage-collector-storage-plugin`: discard-all storage plugin for local dev, CI, and smoke tests.\r\n\r\nUpdates DESIGN, DECOMPOSITION, and Feature 1 spec (→ v1.4) to reflect the implemented emitter API (`authorized.build_usage_record(...).enqueue()`), correct entity locations, and mark all p1 DoD items and CDSL blocks complete (status: IMPLEMENTED).\r\n\r\n## PR Train\r\n| # | PR | Description | Lines |\r\n|---|---|------------|------:|\r\n| 1 | [1907](https://github.com/cyberfabric/cyberfabric-core/pull/1907) | Feature 1 (Core SDK, Emitter & In-Process Ingest): SDK + docs | ~2500 |\r\n| 2 | [1908 (**this**)](https://github.com/cyberfabric/cyberfabric-core/pull/1908) | Feature 1 (Core SDK, Emitter & In-Process Ingest): `usage-collector` gateway + `usage-emitter` + `noop-usage-collector-storage-plugin` | ~8000 |\r\n| 3 | [1919](https://github.com/cyberfabric/cyberfabric-core/pull/1919) | Feature 2 (REST Client & Remote Ingest Delivery) | ~2800 |\r\n| 4 | [1926](https://github.com/cyberfabric/cyberfabric-core/pull/1926) | Feature 3 (Query API) | ~6000 |\r\n| 5 | [1927](https://github.com/cyberfabric/cyberfabric-core/pull/1927) | Feature 4 (TimescaleDB plugin) | ~7700 |\r\n| 6 | [1835](https://github.com/cyberfabric/cyberfabric-core/pull/1835) | e2e tests | ~1500 |\r\n|   |  | ... to be continued ... | |\r\n\r\n## Checklist\r\n- [x] Code follows project style guidelines\r\n- [x] Self-review completed\r\n- [x] No linting errors (`cargo clippy --workspace --all-targets --all-features -- -D warnings -D clippy::perf`)\r\n- [x] Code is properly formatted (`cargo fmt`)\r\n- [x] `cpt validate` — all checks passed\r\n- [x] Tests pass (`cargo nextest run --workspace`)\r\n\r\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\r\n\r\n## Summary by CodeRabbit\r\n\r\n# Release Notes\r\n\r\n* **New Features**\r\n  * Added usage collection infrastructure with REST API endpoints for recording and querying usage metrics\r\n  * Introduced usage emission pipeline with authorization and validation for metric tracking\r\n  * Added development/testing storage backend for usage record handling\r\n\r\n* **Chores**\r\n  * Registered new usage collection workspace modules and dependencies\r\n\r\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-05-15T11:26:46Z","updated_at":"2026-05-27T09:57:19Z","closed_at":"2026-05-27T09:57:19Z","merged_at":null,"merge_commit_sha":"5e7954585f7e14791d707bed93378a8194ed7c4b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1908/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/d5ec0407bd5d4470128a88cdce738af2d9f96973","head":{"label":"capybutler:usage-collector/feature-1/collector+emitter+noop-plugin","ref":"usage-collector/feature-1/collector+emitter+noop-plugin","sha":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gra
ode_id":"PRRC_kwDOPaLyBs6mjX8z","diff_hunk":"@@ -250,8 +269,43 @@ impl AppConfig {\n         let figment = Figment::new()\n             .merge(Serialized::defaults(base))\n             .merge(Yaml::file(config_path))\n-            // Example: APP__SERVER__PORT=8087 maps to server.port\n-            .merge(Env::prefixed(\"APP__\").split(\"__\"));\n+            // Env vars use \"__\" as the nesting separator, e.g.","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":"96961423e65f58ee94d5cdd9084efc7d45d9a9b9","original_commit_id":"bcbb3559bb3808f7dcf53ed5f0be5f77ff12b169","user":{"login":"ziqwerty","id":35517593,"node_id":"MDQ6VXNlcjM1NTE3NTkz","avatar_url":"https://avatars.githubusercontent.com/u/35517593?v=4","gravatar_id":"","url":"https://api.github.com/users/ziqwerty","html_url":"https://github.com/ziqwerty","followers_url":"https://api.github.com/users/ziqwerty/followers","following_url":"https://api.github.com/users/ziqwerty/following{/other_user}","gists_url":"https://api.github.com/users/ziqwerty/gists{/gist_id}","starred_url":"https://api.github.com/users/ziqwerty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ziqwerty/subscriptions","organizations_url":"https://api.github.com/users/ziqwerty/orgs","repos_url":"https://api.github.com/users/ziqwerty/repos","events_url":"https://api.github.com/users/ziqwerty/events{/privacy}","received_events_url":"https://api.github.com/users/ziqwerty/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is needed because YAML module keys can be hyphenated (e.g. api-gateway) but environment variable names cannot contain hyphens, so the second `.merge()` converts underscores in the module-name segment to hyphens (e.g. `APP__MODULES__api_gateway__…` → `modules.api-gateway.…`), ensuring env-var overrides match both naming conventions (`modules.api_gateway.config.x` and `modules.api-gateway.config.x`).\r\n\r\nIn testing docker-compose, i override `modules.api-gatway.config.bind_addr` value with env var.","created_at":"2026-02-11T16:35:16Z","updated_at":"2026-02-11T16:38:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2794290995","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2794290995"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2794290995"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2794290995/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":436,"original_line":272,"side":"RIGHT","in_reply_to_id":2793099206,"author_association":"MEMBER","original_position":44,"position":134,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2795033085","pull_request_review_id":3786804373,"id":2795033085,"node_id":"PRRC_kwDOPaLyBs6mmNH9","diff_hunk":"@@ -96,18 +96,37 @@ impl ConfigProvider for AppConfig {\n     fn get_module_config(&self, module_name: &str) -> Option<&serde_json::Value> {\n         self.modules.get(module_name)\n     }\n+\n+    fn allow_insecure_http(&self) -> bool {\n+        #[cfg(debug_assertions)]\n+        {\n+            self.server.allow_insecure_http\n+        }\n+\n+        #[cfg(not(debug_assertions))]\n+        {\n+            false\n+        }\n+    }\n }\n \n #[derive(Debug, Clone, Deserialize, Serialize)]\n #[serde(deny_unknown_fields)]\n pub struct ServerConfig {\n     pub home_dir: PathBuf, // will be normalized to absolute path\n+\n+    #[serde(default)]\n+    #[cfg(debug_assertions)]\n+    pub allow_insecure_http: bool,","path":"libs/modkit/src/bootstrap/config/mod.rs","commit_id":
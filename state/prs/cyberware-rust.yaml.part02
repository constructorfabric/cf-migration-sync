es \r\n\r\n\r\n\r\n","external_url":"https://coderabbit.ai?utm_source=cr_app&utm_medium=github","html_url":"https://github.com/apps/coderabbitai","created_at":"2023-06-14T15:47:27Z","updated_at":"2026-03-14T07:58:44Z","permissions":{"actions":"read","checks":"write","contents":"write","discussions":"read","issues":"write","members":"read","metadata":"read","pull_requests":"write","statuses":"write"},"events":["issues","issue_comment","label","organization","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","release","repository"]}}],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":1975,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/1975","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #1975] fix: md-fabric - improve md-fabric filter and selection behavior","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"ada2786778f49eedb6f1c40fec837cded69d231b","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1975","id":3754736808,"node_id":"PR_kwDOPaLyBs7fzLyo","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1975","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/1975.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/1975.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1975","number":1975,"state":"closed","locked":false,"title":"fix: md-fabric - improve md-fabric filter and selection behavior","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","follo
, Upstream};\n+\n+/// Check whether an upstream is visible to descendant tenants.\n+///\n+/// Per `cpt-cf-oagw-algo-tenant-alias-shadow` step 2b, an ancestor upstream is\n+/// visible if its own tenant matches the requester OR any per-field sharing flag\n+/// (`auth`, `rate_limit`, `plugins`, `cors`) is not `private`.\n+///\n+/// Returns `false` when all shareable fields are `None` — this is intentional.\n+/// An upstream with no auth, rate_limit, plugins, or cors has no configuration\n+/// to share with descendants, so it is treated as invisible. Fields without a\n+/// sharing mode (e.g. `headers`) do not contribute to visibility.\n+pub(crate) fn is_visible_to_descendant(upstream: &Upstream) -> bool {\n+    use crate::domain::model::SharingMode;\n+\n+    let auth_shared = upstream\n+        .auth\n+        .as_ref()\n+        .is_some_and(|a| a.sharing != SharingMode::Private);\n+    let rate_shared = upstream\n+        .rate_limit\n+        .as_ref()\n+        .is_some_and(|r| r.sharing != SharingMode::Private);\n+    let plugins_shared = upstream\n+        .plugins\n+        .as_ref()\n+        .is_some_and(|p| p.sharing != SharingMode::Private);\n+    let cors_shared = upstream\n+        .cors\n+        .as_ref()\n+        .is_some_and(|c| c.sharing != SharingMode::Private);\n+\n+    auth_shared || rate_shared || plugins_shared || cors_shared\n+}\n+\n+/// Compute the effective upstream configuration by merging ancestor upstreams\n+/// in the tenant chain (root → descendant).\n+///\n+/// Per `cpt-cf-oagw-algo-tenant-config-merge`:\n+/// - Auth:       `private` → local-only (blocked by ancestor `enforce`); `inherit` → override; `enforce` → sticky\n+/// - Rate limit: `private` → local-only (constrained by ancestor `enforce` via `min()`); else `min(ancestor, descendant)`\n+/// - Plugins:    `private` → local-only (ancestor `enforce` items preserved); else concatenate `ancestor + descendant`\n+/// - Tags:       union (add-only)\n+///\n+/// `ancestor_chain` is ordered root-first: `[root, parent, ..., selected]`.\n+/// The last element is the selected (resolved) upstream.\n+pub(crate) fn compute_effective_config(\n+    ancestor_chain: &[Upstream],\n+    route: Option<&Route>,","path":"modules/system/oagw/oagw/src/domain/services/management/merge.rs","commit_id":"79d1dd684fe178883c19c3f35e43cee385088840","original_commit_id":"890eda3ceae693e05b8baa183f0d29b64270ee82","user":{"login":"mattgarmon","id":22921875,"node_id":"MDQ6VXNlcjIyOTIxODc1","avatar_url":"https://avatars.githubusercontent.com/u/22921875?v=4","gravatar_id":"","url":"https://api.github.com/users/mattgarmon","html_url":"https://github.com/mattgarmon","followers_url":"https://api.github.com/users/mattgarmon/followers","following_url":"https://api.github.com/users/mattgarmon/following{/other_user}","gists_url":"https://api.github.com/users/mattgarmon/gists{/gist_id}","starred_url":"https://api.github.com/users/mattgarmon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattgarmon/subscriptions","organizations_url":"https://api.github.com/users/mattgarmon/orgs","repos_url":"https://api.github.com/users/mattgarmon/repos","events_url":"https://api.github.com/users/mattgarmon/events{/privacy}","received_events_url":"https://api.github.com/users/mattgarmon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Agreed, in this case removing would cause lots of code duplication","created_at":"2026-05-19T19:39:46Z","updated_at":"2026-05-19T19:39:46Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1918#discussion_r3269115853","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1918","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269115853"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1918#discussion_r3269115853"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1918"}},
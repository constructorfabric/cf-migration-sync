.exec(self.db.conn())\n-            .await?;\n-\n-        Ok(SimpleUserSettings {\n-            user_id,\n-            tenant_id,\n-            theme,\n-            language,\n-        })\n+        upsert_full_impl(&self.db, ctx, theme, language).await\n     }\n \n     async fn upsert_patch(\n         &self,\n         ctx: &SecurityContext,\n         patch: SimpleUserSettingsPatch,\n     ) -> anyhow::Result<SimpleUserSettings> {\n-        let user_id = ctx.subject_id();\n-        let tenant_id = ctx.tenant_id();\n-\n-        // Build COALESCE expressions: use patch value if provided, else keep existing\n-        // SQL: COALESCE(excluded.theme, settings.theme)\n-        let theme_expr = coalesce_patch_expr(entity::Column::Theme, patch.theme.as_ref());\n-        let language_expr = coalesce_patch_expr(entity::Column::Language, patch.language.as_ref());\n-\n-        let active_model = entity::ActiveModel {\n-            tenant_id: ActiveValue::Set(tenant_id),\n-            user_id: ActiveValue::Set(user_id),\n-            theme: ActiveValue::Set(patch.theme.clone()),\n-            language: ActiveValue::Set(patch.language.clone()),\n-        };\n-\n-        // Single atomic upsert with COALESCE - no read-before-write needed\n-        SettingsEntity::insert(active_model)\n-            .on_conflict(\n-                OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n-                    .value(entity::Column::Theme, theme_expr)\n-                    .value(entity::Column::Language, language_expr)\n-                    .to_owned(),\n-            )\n-            .exec(self.db.conn())\n-            .await?;\n-\n-        // NOTE: We need a second query because SeaORM's on_conflict() doesn't support\n-        // RETURNING clause. Ideally we'd use:\n-        //   INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING *\n-        // but this requires raw SQL. The extra SELECT is acceptable since it's a\n-        // simple primary key lookup and settings updates are infrequent.\n-        let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n-        let result = self\n-            .db\n-            .find::<SettingsEntity>(&scope)\n-            .one(self.db.conn())\n-            .await?\n-            .map(Into::into)\n-            .ok_or_else(|| anyhow::anyhow!(\"row must exist after successful upsert\"))?;\n-\n-        Ok(result)\n+        upsert_patch_mysql_impl(&self.db, ctx, patch).await\n     }\n }\n \n+async fn find_by_user_impl(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+) -> anyhow::Result<Option<SimpleUserSettings>> {\n+    let tenant_id = ctx.tenant_id();\n+    let scope = AccessScope::both(vec![tenant_id], vec![ctx.subject_id()]);\n+\n+    let result = db.find::<SettingsEntity>(&scope).one(db.conn()).await?;\n+\n+    Ok(result.map(Into::into))\n+}\n+\n+async fn upsert_full_impl(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+    theme: Option<String>,\n+    language: Option<String>,\n+) -> anyhow::Result<SimpleUserSettings> {\n+    let user_id = ctx.subject_id();\n+    let tenant_id = ctx.tenant_id();\n+\n+    let active_model = entity::ActiveModel {\n+        tenant_id: ActiveValue::Set(tenant_id),\n+        user_id: ActiveValue::Set(user_id),\n+        theme: ActiveValue::Set(theme.clone()),\n+        language: ActiveValue::Set(language.clone()),\n+    };\n+\n+    // Full replacement - overwrites all columns\n+    SettingsEntity::insert(active_model)\n+        .on_conflict(\n+            OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n+                .update_columns([entity::Column::Theme, entity::Column::Language])\n+                .to_owned(),\n+        )\n+        .exec(db.conn())\n+        .await?;\n+\n+    Ok(SimpleUserSettings {\n+        user_id,\n+        tenant_id,\n+        theme,\n+        language,\n+    })\n+}\n+\n+async fn upsert_patch_pg_sqlite_impl(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+    patch: SimpleUserSettingsPatch,\n+) -> anyhow::Result<SimpleUserSettings> {\n+    upsert_patch_impl_pg_sqlite(db, ctx, patch).await\n+}\n+\n+async fn upsert_patch_mysql_impl(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+    patch: SimpleUserSettingsPatch,\n+) -> anyhow::Result<SimpleUserSettings> {\n+    upsert_patch_impl_mysql(db, ctx, patch).await\n+}\n+\n+async fn upsert_patch_impl_pg_sqlite(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+    patch: SimpleUserSettingsPatch,\n+) -> anyhow::Result<SimpleUserSettings> {\n+    let user_id = ctx.subject_id();\n+    let tenant_id = ctx.tenant_id();\n+\n+    // Build COALESCE expressions: use patch value if provided, else keep existing\n+    // SQL: COALESCE(excluded.theme, settings.theme)\n+    let theme_expr = coalesce_patch_expr_pg_sqlite(entity::Column::Theme, patch.theme.as_ref());\n+    let language_expr =\n+        coalesce_patch_expr_pg_sqlite(entity::Column::Language, patch.language.as_ref());\n+\n+    let active_model = entity::ActiveModel {\n+        tenant_id: ActiveValue::Set(tenant_id),\n+        user_id: ActiveValue::Set(user_id),\n+        theme: ActiveValue::Set(patch.theme.clone()),\n+        language: ActiveValue::Set(patch.language.clone()),\n+    };\n+\n+    // Single atomic upsert with COALESCE - no read-before-write needed\n+    SettingsEntity::insert(active_model)\n+        .on_conflict(\n+            OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n+                .value(entity::Column::Theme, theme_expr)\n+                .value(entity::Column::Language, language_expr)\n+                .to_owned(),\n+        )\n+        .exec(db.conn())\n+        .await?;\n+\n+    // NOTE: We need a second query because SeaORM's on_conflict() doesn't support\n+    // RETURNING clause. Ideally we'd use:\n+    //   INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING *\n+    // but this requires raw SQL. The extra SELECT is acceptable since it's a\n+    // simple primary key lookup and settings updates are infrequent.\n+    let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n+    let result = db\n+        .find::<SettingsEntity>(&scope)\n+        .one(db.conn())\n+        .await?\n+        .map(Into::into)\n+        .ok_or_else(|| anyhow::anyhow!(\"row must exist after successful upsert\"))?;\n+\n+    Ok(result)\n+}\n+\n+async fn upsert_patch_impl_mysql(\n+    db: &SecureConn,\n+    ctx: &SecurityContext,\n+    patch: SimpleUserSettingsPatch,\n+) -> anyhow::Result<SimpleUserSettings> {\n+    let user_id = ctx.subject_id();\n+    let tenant_id = ctx.tenant_id();\n+\n+    let theme_expr = coalesce_patch_expr_mysql(entity::Column::Theme, patch.theme.as_ref());\n+    let language_expr =\n+        coalesce_patch_expr_mysql(entity::Column::Language, patch.language.as_ref());\n+\n+    let active_model = entity::ActiveModel {\n+        tenant_id: ActiveValue::Set(tenant_id),\n+        user_id: ActiveValue::Set(user_id),\n+        theme: ActiveValue::Set(patch.theme.clone()),\n+        language: ActiveValue::Set(patch.language.clone()),\n+    };\n+\n+    SettingsEntity::insert(active_model)\n+        .on_conflict(\n+            OnConflict::columns([entity::Column::TenantId, entity::Column::UserId])\n+                .value(entity::Column::Theme, theme_expr)\n+                .value(entity::Column::Language, language_expr)\n+                .to_owned(),\n+        )\n+        .exec(db.conn())\n+        .await?;\n+\n+    // NOTE: We need a second query because SeaORM's on_conflict() doesn't support\n+    // RETURNING clause. Ideally we'd use:\n+    //   INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING *\n+    // but this requires raw SQL. The extra SELECT is acceptable since it's a\n+    // simple primary key lookup and settings updates are infrequent.\n+    let scope = AccessScope::both(vec![tenant_id], vec![user_id]);\n+    let result = db\n+        .find::<SettingsEntity>(&scope)\n+        .one(db.conn())\n+        .await?\n+        .map(Into::into)\n+        .ok_or_else(|| anyhow::anyhow!(\"row must exist after successful upsert\"))?;\n+\n+    Ok(result)\n+}\n+\n /// Build COALESCE expression for patch semantics:\n /// - If patch value is Some: use the new value\n /// - If patch value is None: keep existing value (COALESCE(excluded.col, table.col))\n-fn coalesce_patch_expr<C: sea_orm::sea_query::IntoIden + Copy + 'static>(\n+fn coalesce_patch_expr_pg_sqlite<C: sea_orm::sea_query::IntoIden + Copy + 'static>(\n     column: C,\n     patch_value: Option<&String>,\n ) -> SimpleExpr {\n+    let inserted_expr: SimpleExpr =\n+        Expr::col((sea_orm::sea_query::Alias::new(\"excluded\"), column)).into();\n+\n     match patch_value {\n         Some(_) => {\n             // Patch has a value - use excluded (the new value from INSERT)\n-            Expr::col((sea_orm::sea_query::Alias::new(\"excluded\"), column)).into()\n+            inserted_expr\n+        }\n+        None => {\n+            // Patch is None - keep existing value\n+            Expr::col((entity::Entity, column)).into()\n+        }\n+    }\n+}\n+\n+/// Build COALESCE expression for patch semantics:\n+/// - If patch value is Some: use the new value\n+/// - If patch value is None: keep existing value (COALESCE(excluded.col, table.col))\n+fn coalesce_patch_expr_mysql<C: sea_orm::sea_query::IntoIden + Copy + 'static>(\n+    column: C,\n+    patch_value: Option<&String>,\n+) -> SimpleExpr {\n+    let inserted_expr: SimpleExpr = Expr::cust_with_exprs(\"VALUES(?)\", [Expr::col(column).into()]);\n+\n+    match patch_value {\n+        Some(_) => {\n+            // Patch has a value - use the new value from INSERT\n+            inserted_expr\n         }\n         None => {\n-            // Patch is None - keep existing value using COALESCE\n-            // COALESCE(excluded.column, settings.column)\n-            Expr::cust_with_exprs(\n-                \"COALESCE($1, $2)\",\n-                [\n-                    Expr::col((sea_orm::sea_query::Alias::new(\"excluded\"), column)).into(),\n-                    Expr::col((entity::Entity, column)).into(),\n-                ],\n-            )\n+            // Patch is None - keep existing value\n+            Expr::col((entity::Entity, column)).into()\n         }\n     }","path":"modules/simple_user_settings/simple_user_settings/src/infra/storage/sea_orm_repo.rs","commit_id":"b4b05009b99b27188cb755c895f2225364794394","original_commit_id":"6c63b5122a93d9475a3918dfac22b2bc37eb9298","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🌐 Web query:\n\n`MySQL 8.0.20 VALUES() deprecated ON DUPLICATE KEY UPDATE replacement`\n\n💡 Result:\n\nIn MySQL **8.0.20**, using `VALUES(col)` inside `INSERT ... ON DUPLICATE KEY UPDATE` is **deprecated**. Replace it by giving the incoming row a **row alias** (supported since **8.0.19**) and referencing `alias.col` instead. [1]\n\n### Replacement pattern\n\n```sql\nINSERT INTO t (a, b, c)\nVALUES (1, 2, 3), (4, 5, 6) AS new\nON DUPLICATE KEY UPDATE\n  c = new.a + new.b;\n```\n\nYou can also alias the incoming columns explicitly:\n\n```sql\nINSERT INTO t (a, b, c)\nVALUES (1, 2, 3), (4, 5, 6) AS new(m, n, p)\nON DUPLICATE KEY UPDATE\n  c = m + n;\n```  \n\nMySQL’s `INSERT` grammar shows the supported `AS row_alias[(col_alias,...)]` placement for `INSERT ... VALUES` and `INSERT ... SET`. [2]\n\n**Sources:** MySQL 8.0.20 release notes (deprecation + examples) [1]; MySQL 8.0 reference manual `INSERT` syntax (row/column alias support) [2].  \n\n**References**  \n[1] ([dev.mysql.com](https://dev.mysql.com/doc/relnotes/mysql/8.0/en/news-8-0-20.html?utm_source=openai))  \n[2] ([dev.mysql.com](https://dev.mysql.com/doc/mysql/8.0/en/insert.html?utm_source=openai))\n\nCitations:\n\n- 1: https://dev.mysql.com/doc/relnotes/mysql/8.0/en/news-8-0-20.html?utm_source=openai\n- 2: https://dev.mysql.com/doc/mysql/8.0/en/insert.html?utm_source=openai\n\n---\n\n🌐 Web query:\n\n`SeaQuery SeaORM ON DUPLICATE KEY UPDATE alternatives VALUES alias`\n\n💡 Result:\n\nMySQL deprecated using `VALUES(col)` inside `ON DUPLICATE KEY UPDATE` (warning starting in MySQL 8.0.20); the recommended replacement is to **alias the inserted row** and reference `alias.col` instead, e.g. `INSERT ... VALUES (...) AS new ... ON DUPLICATE KEY UPDATE c = new.c`. [1][2]\n\n**SeaQuery / SeaORM today:** SeaQuery’s MySQL upsert rendering via `OnConflict` still generates `... ON DUPLICATE KEY UPDATE col = VALUES(col)` (there’s no built-in API to emit `... VALUES (...) AS alias` / column-alias form). [3]\n\n**Practical alternatives:**\n1. **Keep using SeaQuery’s upsert** and tolerate the MySQL warning for now (it still works). [1][3]\n2. **Drop down to raw SQL** for the insert/upsert so you can use the MySQL alias syntax (`... VALUES (...) AS new ... UPDATE col = new.col`). [1]\n3. If acceptable semantically, use **`REPLACE INTO`** (SeaQuery supports `.replace()`), noting it’s not equivalent to upsert (it can delete+insert, affecting FKs/triggers/auto-inc behavior). [1][3]\n\n**Sources:**  \n[1] MySQL manual: `INSERT ... ON DUPLICATE KEY UPDATE` (VALUES() deprecated; alias syntax shown)  \n[2] Oracle “What is new in MySQL 8.0” note about `VALUES()` deprecation and using aliases instead  \n[3] SeaQuery docs/examples showing MySQL upsert rendered as `... = VALUES(...)`\n\n---\n\n🏁 Script executed:\n\n```shell\n# Check if there are any MySQL/MariaDB version constraints in the project\nfind . -name \"Cargo.toml\" -o -name \".github\" -type d | head -20\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1262\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for MySQL/MariaDB version specifications\nrg -i \"mysql|mariadb\" --type toml | head -30\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 866\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for ON DUPLICATE KEY UPDATE usage in the codebase\nrg -i \"on.duplicate.key.update|on_duplicate_key\" -A 3 -B 3\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 46\n\n---\n\n🏁 Script executed:\n\n```shell\n# Read the file to see the context around the function\ncat -n modules/simple_user_settings/simple_user_settings/src/infra/storage/sea_orm_repo.rs | sed -n '290,350p'\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 1316\n\n---\n\n🏁 Script executed:\n\n```shell\n# Search for calls to coalesce_patch_expr_mysql\nrg \"coalesce_patch_expr_mysql\" -B 5 -A 5\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 3065\n\n---\n\n🏁 Script executed:\n\n```shell\n# Look for on_conflict or upsert patterns in this file\nrg -i \"on_conflict|on_duplicate|upsert\" modules/simple_user_settings/simple_user_settings/src/infra/storage/sea_orm_repo.rs -B 3 -A 3\n```\n\nRepository: hypernetix/hyperspot\n\nLength of output: 4477\n\n---\n\n\n\n</details>\n\n**Use row alias syntax instead of deprecated `VALUES()` for MySQL 8.0.20+ compatibility.**\n\n`VALUES()` is deprecated in MySQL 8.0.20+ and generates warnings. The recommended replacement uses row aliases (supported since MySQL 8.0.19): `INSERT ... VALUES (...) AS new ... ON DUPLICATE KEY UPDATE col = new.col`.\n\nHowever, SeaQuery currently generates `VALUES(col)` and has no built-in API for the alias syntax. To address this:\n- If MariaDB or MySQL < 8.0.20: No action needed.\n- If targeting MySQL 8.0.20+: Either accept the deprecation warning for now, or drop to raw SQL to use the alias syntax. Monitor SeaQuery/SeaORM for future alias support.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn\n`@modules/simple_user_settings/simple_user_settings/src/infra/storage/sea_orm_repo.rs`\naround lines 306 - 321, The function coalesce_patch_expr_mysql currently builds\ninserted_expr using the deprecated VALUES(?) form; replace that with the\nrow-alias approach for MySQL >= 8.0.20 by producing a raw/custom expression that\nreferences the INSERT row alias (e.g., \"new.col\" or alias you choose) instead of\nVALUES(), or fall back to existing VALUES() only for MariaDB/MySQL < 8.0.20.\nConcretely, update the inserted_expr creation in coalesce_patch_expr_mysql to\nuse Expr::cust_with_exprs with the alias syntax expected in your ON DUPLICATE\nKEY UPDATE clause (or emit raw SQL there) and keep the None branch unchanged;\nensure the new/custom expression references the same column identifier used\nelsewhere so the generated UPDATE uses alias.col rather than VALUES(col).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-01-27T08:43:03Z","updated_at":"2026-01-27T08:43:04Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/320#discussion_r2730889250","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/320","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2730889250"},"html":{"href":"https:/
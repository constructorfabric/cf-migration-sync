\n pub struct PageInfo {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n     pub next_cursor: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n     pub prev_cursor: Option<String>,\n     pub limit: u64,","path":"libs/modkit-odata/src/page.rs","commit_id":"3d1998170dab6e34be5396cf535d19a6317d4517","original_commit_id":"3d1998170dab6e34be5396cf535d19a6317d4517","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"coderabbitai commented:\n\n> _⚠️ Potential issue_ | _🟠 Major_\n> \n> <details>\n> <summary>🧩 Analysis chain</summary>\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # First, let's confirm the test file exists and locate relevant test code\n> find . -type f -name \"query_raw_tests.rs\" | head -20\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 146\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Also search broadly for usage of page_info in the codebase\n> rg \"page_info\" --type rust -l | head -30\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 1628\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Search for references to next_cursor and prev_cursor\n> rg \"next_cursor|prev_cursor\" --type rust -B 2 -A 2 | head -100\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 9339\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> cat -n libs/modkit-odata/src/page.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 5709\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check the specific test that's mentioned in the review\n> sed -n '1,50p' modules/system/usage-collector/usage-collector/tests/query_raw_tests.rs | cat -n\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 1848\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Get more context around the failing test pattern\n> rg -A 10 \"query_raw_pagination_next_cursor\" modules/system/usage-collector/usage-collector/tests/query_raw_tests.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 466\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check if there are any recent changes or if tests were updated\n> # Search for .get patterns that would handle omitted keys\n> rg \"\\.get\\(\" modules/system/usage-collector/usage-collector/tests/query_raw_tests.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 54\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Get the full test function\n> rg -A 20 \"async fn query_raw_pagination_next_cursor\" modules/system/usage-collector/usage-collector/tests/query_raw_tests.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 937\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Also check for deserialization behavior - search for how JSON is parsed\n> rg \"json\\[\\\"page_info\\\"\\]\" modules/system/usage-collector/usage-collector/tests/query_raw_tests.rs -B 2 -A 5\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 425\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check if there are any other places using direct indexing on page_info in JSON\n> rg \"json.*page_info\" --type rust -B 2 -A 2\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 708\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check if there are any other similar patterns in handlers_tests that might need updates\n> rg \"\\.expect.*page_info\" modules/system/usage-collector/ --type rust -B 3 -A 1\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 708\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check the documentation/comments in routes.rs to see if it mentions the change\n> rg -B 5 -A 5 \"Null next_cursor|null next_cursor\" modules/system/usage-collector/usage-collector/src/api/rest/routes.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 599\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check if serde deserializing behavior would cause issues - search for if there are any #[serde(default)] overrides\n> rg \"serde.*default\" libs/modkit-odata/src/page.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 54\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Final check - see if there are any skip_deserializing or default handling that might mitigate the issue\n> rg \"skip_deserializing|default.*Option\" libs/modkit-odata/src/page.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 54\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check the mock implementation to see what cursor value is being set in the test\n> rg -A 30 \"with_raw_cursor\" modules/system/usage-collector/usage-collector/tests/common.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 175\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Find the common module\n> find . -type f -name \"common.rs\" | grep usage-collector\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 54\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Or search for MockUsageCollectorPluginClientV1\n> rg \"MockUsageCollectorPluginClientV1\" --type rust -l | head -5\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 290\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check the common module to see how the mock sets the cursor\n> rg -A 20 \"with_raw_cursor\" modules/system/usage-collector/usage-collector/tests/common/mod.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 670\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Check what the query_raw_raw test does with final page scenarios\n> rg -B 10 -A 20 \"test_raw_200_empty_final_page\" modules/system/usage-collector/usage-collector/src/api/rest/handlers_tests.rs\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 937\n> \n> ---\n> \n> 🏁 Script executed:\n> \n> ```shell\n> # Verify the actual serialization behavior - test if with_cursor = true does include the field\n> rg -A 50 \"with_cursor\" modules/system/usage-collector/usage-collector/tests/common/mod.rs | grep -A 40 \"query_raw\"\n> ```\n> \n> Repository: cyberfabric/cyberfabric-core\n> \n> Length of output: 1554\n> \n> ---\n> \n> \n> \n> </details>\n> \n> **Update API documentation and external JSON consumers for changed cursor field serialization.**\n> \n> With `skip_serializing_if = \"Option::is_none\"`, the JSON payload now **omits** `page_info.next_cursor` / `prev_cursor` when `None` (instead of sending null). This is a breaking change for external JSON consumers.\n> \n> The API documentation in `modules/system/usage-collector/usage-collector/src/api/rest/routes.rs` currently states: \"Null next_cursor in page_info signals the final page.\" This is now inaccurate—it should say \"absent next_cursor\" or \"omitted next_cursor\" signals the final page.\n> \n> Any external consumers (frontend, SDKs, etc.) that assume these keys are always present in the JSON will fail when handling final pages. Update documentation and ensure clients use `.get()` or optional chaining instead of direct field access.\n> \n> <details>\n> <summary>🤖 Prompt for AI Agents</summary>\n> \n> ```\n> Verify each finding against the current code and only fix it if needed.\n> \n> In `@libs/modkit-odata/src/page.rs` around lines 5 - 11, The PageInfo struct now\n> omits next_cursor/prev_cursor when None due to #[serde(skip_serializing_if =\n> \"Option::is_none\")], so update the API docs and any external JSON consumer\n> instructions to reflect that a missing/omitted next_cursor (not a JSON null)\n> signals the final page; specifically, change the explanatory text in\n> modules/system/usage-collector/usage-collector/src/api/rest/routes.rs from \"Null\n> next_cursor in page_info signals the final page\" to wording like \"absent/omitted\n> next_cursor in page_info signals the final page\", and audit\n> clients/SDKs/frontend code that read PageInfo to use safe access patterns (e.g.,\n> .get(), optional chaining, or Option-aware deserialization) instead of assuming\n> the keys are always present; search for uses of PageInfo, next_cursor,\n> prev_cursor to apply these fixes.\n> ```\n> \n> </details>\n> \n> <!-- fingerprinting:phantom:triton:puma:f5bbc3fa-5d10-4494-b2c1-2596d5d01da9 -->\n> \n> <!-- 4e71b3a2 -->\n> \n> <!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-05-19T12:02:41Z","updated_at":"2026-05-19T12:45:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266085159","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266085159"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266085159"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266085159/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":8,"original_line":10,"side":"RIGHT","author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266088397","pull_request_review_id":4318669423,"id":3266088397,"node_id":"PRRC_kwDOPaLyBs7CrI3N","diff_hunk":"@@ -0,0 +1,145 @@\n+//! Configuration for the `TimescaleDB` usage-collector storage plugin.\n+\n+use std::fmt;\n+use std::time::Duration;\n+\n+use serde::Deserialize;\n+\n+const SEVEN_DAYS_SECS: u64 = 7 * 24 * 3_600;\n+const SEVEN_YEARS_SECS: u64 = 7 * 365 * 24 * 3_600;\n+\n+fn default_pool_size_min() -> u32 {\n+    2\n+}\n+\n+fn default_pool_size_max() -> u32 {\n+    16\n+}\n+\n+fn default_retention_default() -> Duration {\n+    Duration::from_hours(8760)\n+}\n+\n+fn default_connection_timeout() -> Duration {\n+    Duration::from_secs(10)\n+}\n+\n+fn deserialize_duration<'de, D>(deserializer: D) -> Result<Duration, D::Error>\n+where\n+    D: serde::Deserializer<'de>,\n+{\n+    let s = String::deserialize(deserializer)?;\n+    humantime::parse_duration(&s).map_err(serde::de::Error::custom)\n+}\n+\n+/// Plugin configuration.\n+///\n+/// All parameters are static and require a plugin restart to change.\n+/// `database_url` must include `sslmode=require`; plaintext connections are rejected.\n+#[derive(Clone, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct TimescaleDbConfig {\n+    /// `PostgreSQL` connection URL. Must include `sslmode=require`.\n+    #[serde(default)]\n+    pub database_url: String,","path":"modules/system/usage-collector/plugins/timescaledb-usage-collector-plugin/src/config.rs","commit_id":"9ffbebd3f88d3afe331838b4cdc61a859ed18b41","original_commit_id":"3d1998170dab6e34be5396cf535d19a6317d4517","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"coderabbitai commented:\n\n> _⚠️ Potential issue_ | _🟡 Minor_ | _⚡ Quick win_\n> \n> **`database_url` doc comment only mentions `sslmode=require`, omitting `verify-ca` and `verify-full`**\n> \n> The validation at lines 100–103 accepts all three modes, but the field doc comment implies only `sslmode=require` is valid.\n> \n> <details>\n> <summary>📝 Proposed fix</summary>\n> \n> ```diff\n> -    /// `PostgreSQL` connection URL. Must include `sslmode=require`.\n> +    /// `PostgreSQL` connection URL. Must include `sslmode=require`, `sslmode=verify-ca`, or `sslmode=verify-full`.\n> ```\n> </details>\n> \n> <details>\n> <summary>🤖 Prompt for AI Agents</summary>\n> \n> ```\n> Verify each finding against the current code and only fix it if needed.\n> \n> In\n> `@modules/system/usage-collector/plugins/timescaledb-usage-collector-storage-plugin/src/config.rs`\n> around lines 42 - 44, The doc comment for the database_url field is misleading\n> (it only mentions `sslmode=require`) while the validation logic for\n> `database_url` accepts `sslmode=require`, `sslmode=verify-ca`, and\n> `sslmode=verify-full`; update the comment on the `database_url` field in\n> config.rs to list all supported SSL modes (require, verify-ca, verify-full) and\n> state that a valid PostgreSQL connection URL must include one of those sslmode\n> values so it matches the existing validation for the `database_url` field.\n> ```\n> \n> </details>\n> \n> <!-- fingerprinting:phantom:poseidon:churro -->\n> \n> <!-- d98c2f50 -->\n> \n> <!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-05-19T12:03:17Z","updated_at":"2026-05-19T14:43:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266088397","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266088397"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266088397"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266088397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":52,"original_line":44,"side":"RIGHT","author_association":"MEMBER","original_position":44,"position":52,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266091090","pull_request_review_id":4318669423,"id":3266091090,"node_id":"PRRC_kwDOPaLyBs7CrJhS","diff_hunk":"@@ -0,0 +1,151 @@\n+//! `TimescaleDB` storage plugin client.\n+\n+use std::sync::Arc;\n+use std::time::Instant;\n+\n+use async_trait::async_trait;\n+use modkit_macros::domain_model;\n+use usage_collector_sdk::models::{\n+    AggregationQuery, AggregationResult, RawQuery, UsageKind, UsageRecord,\n+};\n+use usage_collector_sdk::{Page, UsageCollectorError, UsageCollectorPluginClientV1};\n+\n+use crate::domain::error::StoragePluginError;\n+use crate::domain::insert_port::InsertPort;\n+use crate::domain::metrics::PluginMetrics;\n+use crate::domain::query_port::QueryPort;\n+\n+/// Storage plugin client backed by a `TimescaleDB` connection pool.\n+#[domain_model]\n+pub struct TimescaleDbPluginClient {\n+    insert_port: Arc<dyn InsertPort>,\n+    query_port: Arc<dyn QueryPort>,\n+    metrics: Arc<dyn PluginMetrics>,\n+}\n+\n+impl TimescaleDbPluginClient {\n+    /// Creates a new client wrapping the given insert port, query port, and metrics port.\n+    pub fn new(\n+        insert_port: Arc<dyn InsertPort>,\n+        query_port: Arc<dyn QueryPort>,\n+        metrics: Arc<dyn PluginMetrics>,\n+    ) -> Self {\n+        Self {\n+            insert_port,\n+            query_port,\n+            metrics,\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl UsageCollectorPluginClientV1 for TimescaleDbPluginClient {\n+    // @cpt-algo:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1\n+    // @cpt-flow:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1\n+    async fn create_usage_record(&self, record: UsageRecord) -> Result<(), UsageCollectorError> {\n+        let start = Instant::now();\n+\n+        // @cpt-begin:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-1\n+        // Plugin entry point; called by the gateway when delegating record storage.\n+        // @cpt-end:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-1\n+\n+        // @cpt-begin:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-2\n+        // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-1\n+        if record.kind == UsageKind::Counter && record.value < 0.0 {\n+            self.metrics.record_schema_validation_error();\n+            return Err(UsageCollectorError::internal(\n+                \"invalid record: counter value must be >= 0\",\n+            ));\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-1\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-2\n+        if record.kind == UsageKind::Counter && record.idempotency_key.is_empty() {\n+            self.metrics.record_schema_validation_error();\n+            return Err(UsageCollectorError::internal(\n+                \"invalid record: idempotency_key required for counter records\",\n+            ));\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-2\n+        // @cpt-end:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-2\n+\n+        // @cpt-begin:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-3\n+        let result = self.insert_port.insert_usage_record(&record).await;\n+        // @cpt-end:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-3\n+\n+        let rows_affected = match result {\n+            Ok(n) => n,\n+            Err(e) => {\n+                // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-4\n+                if let StoragePluginError::InvalidRecord(ref msg) = e {\n+                    tracing::warn!(error = %msg, \"unexpected unique constraint violation in usage_records\");\n+                    self.metrics.record_ingestion_error();\n+                    self.metrics\n+                        .record_ingestion_latency_ms(start.elapsed().as_secs_f64() * 1000.0);\n+                    return Err(UsageCollectorError::internal(\n+                        \"unexpected unique constraint violation\",\n+                    ));\n+                }\n+                // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-4\n+\n+                // @cpt-begin:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-4\n+                // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-5\n+                if let StoragePluginError::Transient(ref msg) = e {\n+                    self.metrics.record_ingestion_error();\n+                    self.metrics\n+                        .record_ingestion_latency_ms(start.elapsed().as_secs_f64() * 1000.0);\n+                    return Err(UsageCollectorError::unavailable(format!(\n+                        \"transient error: {msg}\"\n+                    )));\n+                }\n+                // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-5\n+                // @cpt-end:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-4\n+\n+                self.metrics.record_ingestion_error();\n+                self.metrics\n+                    .record_ingestion_latency_ms(start.elapsed().as_secs_f64() * 1000.0);\n+                return Err(UsageCollectorError::internal(format!(\"storage error: {e}\")));\n+            }\n+        };\n+\n+        let elapsed_ms = start.elapsed().as_secs_f64() * 1000.0;\n+        self.metrics.record_ingestion_latency_ms(elapsed_ms);\n+        if rows_affected == 0 {\n+            self.metrics.record_dedup();\n+        } else {\n+            self.metrics.record_ingestion_success();\n+        }\n+\n+        // @cpt-begin:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-5\n+        // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-7\n+        Ok(())\n+        // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-create-usage-record:p1:inst-cur-7\n+        // @cpt-end:cpt-cf-usage-collector-flow-production-storage-plugin-storage-backend-ingest:p1:inst-flow-ing-5\n+    }\n+\n+    // @cpt-algo:cpt-cf-usage-collector-algo-production-storage-plugin-query-aggregated:p1\n+    async fn query_aggregated(\n+        &self,\n+        query: AggregationQuery,\n+    ) -> Result<Vec<AggregationResult>, UsageCollectorError> {\n+        let start = Instant::now();\n+        let result = self.query_port.query_aggregated(query).await;\n+        self.metrics\n+            .record_query_latency_ms(\"aggregated\", start.elapsed().as_secs_f64() * 1000.0);\n+        result\n+    }\n+\n+    // @cpt-algo:cpt-cf-usage-collector-algo-production-storage-plugin-query-raw:p1\n+    async fn query_raw(&self, query: RawQuery) -> Result<Page<UsageRecord>, UsageCollectorError> {\n+        let start = Instant::now();\n+        let result = self.query_port.query_raw(query).await;\n+        self.metrics\n+            .record_query_latency_ms(\"raw\", start.elapsed().as_secs_f64() * 1000.0);\n+        result\n+    }","path":"modules/system/usage-collector/plugins/timescaledb-usage-collector-plugin/src/domain/client.rs","commit_id":"9ffbebd3f88d3afe331838b4cdc61a859ed18b41","original_commit_id":"3d1998170dab6e34be5396cf535d19a6317d4517","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"coderabbitai commented:\n\n> _⚠️ Potential issue_ | _🟠 Major_ | _🏗️ Heavy lift_\n> \n> **Query paths never emit a success/error counter.**\n> \n> Both methods record latency, but neither increments a query volume/error metric. That makes it impossible to tell “no traffic” from “all queries failing,” and it misses the PR’s query-counter observability requirement.\n> \n> <details>\n> <summary>🤖 Prompt for AI Agents</summary>\n> \n> ```\n> Verify each finding against the current code and only fix it if needed.\n> \n> In\n> `@modules/system/usage-collector/plugins/timescaledb-usage-collector-storage-plugin/src/domain/client.rs`\n> around lines 127 - 145, Both query_aggregated and query_raw currently only\n> record latency; modify each to inspect the Result returned from self.query_port\n> (the variable result) and increment the appropriate success or error counter on\n> self.metrics before returning. Concretely: after let result =\n> self.query_port.query_aggregated(query).await (and similarly for\n> query_raw/query_port.query_raw), call something like if result.is_ok() {\n> self.metrics.record_query_success(\"aggregated\"); } else {\n> self.metrics.record_query_error(\"aggregated\"); } (use analogous \"raw\" label for\n> query_raw), then record_query_latency_ms as before and finally return result.\n> Ensure you use the existing self.metrics methods for counting\n> (record_query_success/record_query_error or their equivalent) and do not change\n> the await/return semantics of query_aggregated or query_raw.\n> ```\n> \n> </details>\n> \n> <!-- fingerprinting:phantom:medusa:grasshopper:d2d15a0a-03f2-4e8e-92e9-093f1a6aa48c -->\n> \n> <!-- 4e71b3a2 -->\n> \n> <!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-05-19T12:03:49Z","updated_at":"2026-05-19T14:30:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266091090","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266091090"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1927#discussion_r3266091090"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1927"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266091090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":145,"original_line":145,"side":"RIGHT","author_association":"MEMBER","original_position":145,"position":145,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3266093524","pull_request_review_id":4318669423,"id":3266093524,"node_id":"PRRC_kwDOPaLyBs7CrKHU","diff_hunk":"@@ -0,0 +1,149 @@\n+//! Schema migration runner for the `TimescaleDB` storage plugin.\n+\n+use sqlx::PgPool;\n+\n+use crate::domain::error::MigrationError;\n+\n+// @cpt-algo:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1\n+/// # Errors\n+///\n+/// Returns [`MigrationError`] if any DDL statement fails against the database.\n+pub async fn run_migrations(pool: &PgPool) -> Result<(), MigrationError> {\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-1\n+    sqlx::query(\"CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE\")\n+        .execute(pool)\n+        .await\n+        .map_err(|e| {\n+            MigrationError::Migration(format!(\"failed to create timescaledb extension: {e}\"))\n+        })?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-1\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-2\n+    sqlx::query(\n+        \"CREATE TABLE IF NOT EXISTS usage_records (\n+            id              UUID        NOT NULL DEFAULT gen_random_uuid(),\n+            tenant_id       UUID        NOT NULL,\n+            module          TEXT        NOT NULL,\n+            kind            TEXT        NOT NULL CHECK (kind IN ('counter', 'gauge')),\n+            metric          TEXT        NOT NULL,\n+            value           NUMERIC     NOT NULL,\n+            timestamp       TIMESTAMPTZ NOT NULL,\n+            idempotency_key TEXT,\n+            resource_id     UUID        NOT NULL,\n+            resource_type   TEXT        NOT NULL,\n+            subject_id      UUID,\n+            subject_type    TEXT,\n+            ingested_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n+            metadata        JSONB,\n+            PRIMARY KEY (id, timestamp)\n+        )\",\n+    )\n+    .execute(pool)\n+    .await\n+    .map_err(|e| MigrationError::Migration(format!(\"failed to create usage_records table: {e}\")))?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-2\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-3\n+    sqlx::query(\"SELECT create_hypertable('usage_records', 'timestamp', if_not_exists => true)\")\n+        .execute(pool)\n+        .await\n+        .map_err(|e| {\n+            MigrationError::Migration(format!(\n+                \"failed to convert usage_records to hypertable: {e}\"\n+            ))\n+        })?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-3\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-4\n+    sqlx::query(\n+        \"CREATE INDEX IF NOT EXISTS idx_usage_records_tenant_time \\\n+         ON usage_records (tenant_id, timestamp DESC)\",\n+    )\n+    .execute(pool)\n+    .await\n+    .map_err(|e| {\n+        MigrationError::Migration(format!(\n+            \"failed to create idx_usage_records_tenant_time: {e}\"\n+        ))\n+    })?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-4\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-5\n+    sqlx::query(\n+        \"CREATE INDEX IF NOT EXISTS idx_usage_records_tenant_metric_time \\\n+         ON usage_records (tenant_id, metric, timestamp DESC)\",\n+    )\n+    .execute(pool)\n+    .await\n+    .map_err(|e| {\n+        MigrationError::Migration(format!(\n+            \"failed to create idx_usage_records_tenant_metric_time: {e}\"\n+        ))\n+    })?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-5\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-6\n+    sqlx::query(\n+        \"CREATE INDEX IF NOT EXISTS idx_usage_records_tenant_subject_time \\\n+         ON usage_records (tenant_id, subject_id, timestamp DESC)\",\n+    )\n+    .execute(pool)\n+    .await\n+    .map_err(|e| {\n+        MigrationError::Migration(format!(\n+            \"failed to create idx_usage_records_tenant_subject_time: {e}\"\n+        ))\n+    })?;\n+    // @cpt-end:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-6\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-production-storage-plugin-schema-migrations:p1:inst-mig-7\n+    sqlx::query(\n+        \"CREATE INDEX IF NOT EXISTS idx_usage_records_tenant_resource_time \\\n+         ON usage_records (tenant_id, 
b.com/users/qodo-ai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-ai/subscriptions","organizations_url":"https://api.github.com/users/qodo-ai/orgs","repos_url":"https://api.github.com/users/qodo-ai/repos","events_url":"https://api.github.com/users/qodo-ai/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-ai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"Qodo Code Review","description":"### The AI Code Review Platform\r\n\r\n## Get Started\r\nSimply sign into Github and click the \"Configure\" button. Check out our documentation for more info: https://docs.qodo.ai/get-started.\r\n\r\n## Overview\r\nQodo automatically reviews every GitHub pull request, identifies logic bugs, edge cases, security issues, and code quality problems, and provides actionable suggestions your team can apply immediately.\r\n\r\nInstall in minutes. Integrates seamlessly into your existing workflows.\r\n\r\n## Qodo is designed for developers who:\r\n- Handle frequent pull requests and need reliable review coverage\r\n- Balance code quality with fast delivery\r\n- Work in complex, multi-repo systems\r\n- Use AI-generated code and need stronger guardrails\r\n- Build production software where reliability matters\r\n\r\n## Qodo Capabilities\r\n- ## Automated PR Analysis\r\n  - Reviews every pull request automatically\r\n  - No manual trigger required\r\n\r\n- ## Context-Aware Code Review\r\n  - Understands cross-file changes\r\n  - Detects architectural inconsistencies\r\n\r\n- ## Actionable Suggestions\r\n  - Concrete code fixes\r\n  - Clear explanations\r\n  - Prioritized feedback\r\n\r\n- ## Security & Reliability Checks\r\n  - Identifies risky patterns\r\n  - Reduces attack surface area","external_url":"https://www.qodo.ai/","html_url":"https://github.com/apps/qodo-code-review","created_at":"2023-11-16T16:18:38Z","updated_at":"2026-05-06T15:53:40Z","permissions":{"actions":"read","checks":"read","contents":"write","discussions":"write","issues":"write","metadata":"read","pull_requests":"write"},"events":["check_run","check_suite","discussion_comment","issue_comment","pull_request","pull_request_review_comment","push"]}},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/4553476752","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#issuecomment-4553476752","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1908","id":4553476752,"node_id":"IC_kwDOPaLyBs8AAAABD2iKkA","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-27T09:57:19Z","updated_at":"2026-05-27T09:57:19Z","body":"The approach to usage collector is revised in #1974","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/4553476752/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247908458","pull_request_review_id":4297793291,"id":3247908458,"node_id":"PRRC_kwDOPaLyBs7BlyZq","diff_hunk":"@@ -0,0 +1,134 @@\n+//! [`UsageRecordBuilder`] for chaining optional fields and enqueueing through an\n+//! [`AuthorizedUsageEmitter`](crate::AuthorizedUsageEmitter). Tenant, resource, module,\n+//! and kind are taken from the authorized handle; kind is resolved from the allowed metrics list.\n+//!\n+//! Construct via [`AuthorizedUsageEmitter::build_usage_record`](crate::AuthorizedUsageEmitter::build_usage_record).\n+\n+use chrono::{DateTime, Utc};\n+use modkit_db::secure::DBRunner;\n+use serde_json::Value as JsonValue;\n+use usage_collector_sdk::models::{UsageKind, UsageRecord};\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::error::UsageEmitterError;\n+\n+/// Fluent builder tied to an [`AuthorizedUsageEmitter`]. Optionally set idempotency key or\n+/// timestamp, then [`Self::enqueue`] or [`Self::enqueue_in`].\n+///\n+/// `kind` is resolved automatically from the allowed metrics list; no `.counter()` or `.gauge()`\n+/// call is required.\n+pub struct UsageRecordBuilder<'a> {\n+    emitter: &'a AuthorizedUsageEmitter,\n+    metric: String,\n+    idempotency_key: Option<String>,\n+    value: f64,\n+    timestamp: Option<DateTime<Utc>>,\n+    metadata: Option<JsonValue>,\n+}\n+\n+impl<'a> UsageRecordBuilder<'a> {\n+    /// Starts a builder with the required `metric` and `value` set.\n+    #[must_use]\n+    pub fn new(emitter: &'a AuthorizedUsageEmitter, metric: impl Into<String>, value: f64) -> Self {\n+        Self {\n+            emitter,\n+            metric: metric.into(),\n+            idempotency_key: None,\n+            value,\n+            timestamp: None,\n+            metadata: None,\n+        }\n+    }\n+\n+    /// Sets a caller-provided idempotency key. If omitted, a new UUID string is used on enqueue.\n+    #[must_use]\n+    pub fn with_idempotency_key(self, key: impl Into<String>) -> Self {\n+        Self {\n+            idempotency_key: Some(key.into()),\n+            ..self\n+        }\n+    }\n+\n+    /// Sets the observation timestamp. If omitted, the current UTC time is used on enqueue.\n+    #[must_use]\n+    pub fn with_timestamp(self, timestamp: DateTime<Utc>) -> Self {\n+        Self {\n+            timestamp: Some(timestamp),\n+            ..self\n+        }\n+    }\n+\n+    /// Sets optional metadata JSON. Must serialize to ≤ 8192 bytes or enqueue will return\n+    /// [`UsageEmitterError::MetadataTooLarge`].\n+    #[must_use]\n+    pub fn with_metadata(self, metadata: JsonValue) -> Self {\n+        Self {\n+            metadata: Some(metadata),\n+            ..self\n+        }\n+    }\n+\n+    /// Builds, then enqueues on this emitter's database connection.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError::InvalidRecord`] if the metric is not in the allowed list,\n+    /// or any error from [`AuthorizedUsageEmitter::enqueue_in`].\n+    pub async fn enqueue(self) -> Result<(), UsageEmitterError> {\n+        let conn = self\n+            .emitter\n+            .db\n+            .conn()\n+            .map_err(|e| UsageEmitterError::internal(e.to_string()))?;\n+        self.enqueue_in(&conn).await\n+    }\n+\n+    /// Builds, then enqueues on the given database runner (connection or transaction).\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError::InvalidRecord`] if the metric is not in the allowed list,\n+    /// or any error from [`AuthorizedUsageEmitter::enqueue_in`].\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1\n+    pub async fn enqueue_in(self, db: &(dyn DBRunner + Sync)) -> Result<(), UsageEmitterError> {\n+        let kind = self\n+            .emitter\n+            .allowed_metrics\n+            .iter()\n+            .find(|m| m.name == self.metric)\n+            .map_or(UsageKind::Gauge, |m| m.kind);\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+        let subject_id = self.emitter.subject_id;\n+        let subject_type = self.emitter.subject_type.clone();\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+\n+        let record = UsageRecord {\n+            tenant_id: self.emitter.tenant_id,\n+            module: self.emitter.module.clone(),\n+            resource_id: self.emitter.resource_id,\n+            resource_type: self.emitter.resource_type.clone(),\n+            subject_id,\n+            subject_type,\n+            metric: self.metric,\n+            kind,\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5b\n+            idempotency_key: if kind == UsageKind::Gauge {\n+                String::new()\n+            } else {\n+                self.idempotency_key.unwrap_or_default()","path":"modules/system/usage-collector/usage-emitter/src/usage_builder.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> HIGH\n> \n> Doc on with_idempotency_key (line 43) states \"If omitted, a new UUID string is used on enqueue\", but unwrap_or_default() produces an empty String, not a UUID.\n> \n> For a Counter without an idempotency key the emitted record has idempotency_key = \"\", which validate_counter_idempotency_key then rejects with InvalidRecord. Callers relying on the documented contract will see unexpected 422s.\n> \n> Either generate a UUID here when kind == Counter && idempotency_key.is_none() (matching the doc), or update the docstring on line 43 and on dto.rs:30 to say the key is required for counters.","created_at":"2026-05-15T11:38:29Z","updated_at":"2026-05-15T11:39:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247908458","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247908458"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247908458"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247908458/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":119,"side":"RIGHT","author_association":"MEMBER","original_position":119,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247916787","pull_request_review_id":4297803668,"id":3247916787,"node_id":"PRRC_kwDOPaLyBs7Bl0bz","diff_hunk":"@@ -0,0 +1,188 @@\n+use std::sync::Arc;\n+\n+use authz_resolver_sdk::AuthZResolverClient;\n+use authz_resolver_sdk::models::BarrierMode;\n+use authz_resolver_sdk::pep::{AccessRequest, PolicyEnforcer};\n+use modkit_db::Db;\n+use modkit_db::outbox::Outbox;\n+use modkit_security::{SecurityContext, pep_properties};\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use uuid::Uuid;\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::config::UsageEmitterConfig;\n+use crate::domain::authz;\n+use crate::emitter::enforcer_error_to_emitter_error;\n+use crate::error::UsageEmitterError;\n+\n+/// A usage emitter scoped to a specific module.\n+///\n+/// Constructed via [`crate::UsageEmitterV1::for_module`]. Call [`Self::authorize_for`] or\n+/// [`Self::authorize`] to obtain a time-limited [`AuthorizedUsageEmitter`] after PDP authorization\n+/// and allowed-metrics retrieval for this module.\n+///\n+/// # Example\n+///\n+/// ```ignore\n+/// // In init():\n+/// let scoped = emitter.for_module(Self::MODULE_NAME);\n+///\n+/// // In a handler (with subject):\n+/// let authorized = scoped\n+///     .authorize_for(&ctx, tenant_id, resource_id, resource_type, Some(subject_id), Some(subject_type))\n+///     .await?;\n+/// authorized.build_usage_record(\"requests\", 1.0).enqueue().await?;\n+///\n+/// // In a handler (without subject):\n+/// let authorized = scoped\n+///     .authorize_for(&ctx, tenant_id, resource_id, resource_type, None, None)\n+///     .await?;\n+/// authorized.build_usage_record(\"requests\", 1.0).enqueue().await?;\n+/// ```\n+#[derive(Clone)]\n+pub struct ScopedUsageEmitter {\n+    module: String,\n+    authz: Arc<dyn AuthZResolverClient>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+    db: Db,\n+    config: Arc<UsageEmitterConfig>,\n+    outbox: Arc<Outbox>,\n+}\n+\n+impl ScopedUsageEmitter {\n+    pub(crate) fn new(\n+        module: String,\n+        authz: Arc<dyn AuthZResolverClient>,\n+        collector: Arc<dyn UsageCollectorClientV1>,\n+        db: Db,\n+        config: Arc<UsageEmitterConfig>,\n+        outbox: Arc<Outbox>,\n+    ) -> Self {\n+        Self {\n+            module,\n+            authz,\n+            collector,\n+            db,\n+            config,\n+            outbox,\n+        }\n+    }\n+\n+    /// Obtain a time-limited [`AuthorizedUsageEmitter`] by calling the PDP for `USAGE_RECORD`/`CREATE`\n+    /// and fetching the allowed metrics for this module from the collector.\n+    ///\n+    /// The returned handle is bound to the module name, tenant, metered resource, and subject\n+    /// identity; every enqueued record must match and its metric must be in the allowed list.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] if PDP denies, the module is not configured, or the collector\n+    /// call fails.\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1\n+    pub async fn authorize_for(\n+        &self,\n+        ctx: &SecurityContext,\n+        tenant_id: Uuid,\n+        resource_id: Uuid,\n+        resource_type: String,\n+        subject_id: Option<Uuid>,\n+        subject_type: Option<String>,\n+    ) -> Result<AuthorizedUsageEmitter, UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-2\n+        let mut request = AccessRequest::new()\n+            .require_constraints(false)\n+            .barrier_mode(BarrierMode::Ignore)\n+            .resource_property(pep_properties::OWNER_TENANT_ID, tenant_id)\n+            .resource_property(authz::properties::RESOURCE_ID, resource_id)\n+            .resource_property(authz::properties::RESOURCE_TYPE, resource_type.as_str())\n+            .resource_property(authz::properties::MODULE, self.module.clone());\n+        if let Some(ref sid) = subject_id {\n+            request = request.resource_property(authz::properties::SUBJECT_ID, sid.to_string());\n+        }\n+        if let Some(ref stype) = subject_type {\n+            request = request.resource_property(authz::properties::SUBJECT_TYPE, stype.as_str());\n+        }\n+        let pdp_result = PolicyEnforcer::new(Arc::clone(&self.authz))\n+            .access_scope_with(\n+                ctx,\n+                &authz::USAGE_RECORD,\n+                authz::actions::CREATE,\n+                None,\n+                &request,\n+            )\n+            .await;\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-2\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3\n+        if let Err(e) = pdp_result {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3a\n+            return Err(enforcer_error_to_emitter_error(e));\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-4\n+        // @cpt-begin:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-1\n+        let module_cfg_result = self.collector.get_module_config(&self.module).await;\n+        // @cpt-end:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-1\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-4\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5\n+        let module_cfg = match module_cfg_result {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5a\n+            Err(UsageCollectorError::ModuleNotFound { module_name }) => {\n+                return Err(UsageEmitterError::module_not_configured(module_name));\n+            }\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5a\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5b\n+            Err(e) => return Err(UsageEmitterError::internal(e.to_string())),","path":"modules/system/usage-collector/usage-emitter/src/scoped_emitter.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **HIGH**\n> \n> `Err(e) => return Err(UsageEmitterError::internal(e.to_string()))` collapses every non-`ModuleNotFound` `UsageCollectorError` (`PluginTimeout`, `CircuitOpen`, `Unavailable`) into a stringified `Internal` error.\n> \n> For source modules using `UsageEmitterV1` over the REST client, a transient gateway outage becomes an opaque 500 instead of being mappable to 503/504. The categorization the collector deliberately exposes is lost in transit.\n> \n> Match the relevant variants and surface them as distinct emitter errors (e.g. an `Unavailable`/`Timeout` variant on `UsageEmitterError`), or at minimum preserve the source via `#[from]` on a new variant.","created_at":"2026-05-15T11:39:52Z","updated_at":"2026-05-15T11:39:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247916787","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247916787"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247916787"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247916787/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":138,"side":"RIGHT","author_association":"MEMBER","original_position":138,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247921402","pull_request_review_id":4297809326,"id":3247921402,"node_id":"PRRC_kwDOPaLyBs7Bl1j6","diff_hunk":"@@ -0,0 +1,73 @@\n+//! Route registration for the usage-collector REST API.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+\n+use modkit::api::operation_builder::LicenseFeature;\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use usage_collector_sdk::UsageCollectorClientV1;\n+use usage_emitter::UsageEmitterV1;\n+\n+use super::dto::{CreateUsageRecordRequest, ModuleConfigResponse};\n+use super::handlers;\n+\n+const API_TAG: &str = \"Usage Collector\";\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.cf.core.lic.feat.v1~cf.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the usage-collector module.\n+pub fn register_routes(\n+    router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    emitter: Arc<dyn UsageEmitterV1>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+) -> Router {\n+    let router = OperationBuilder::post(\"/usage-collector/v1/records\")\n+        .operation_id(\"usage_collector.create_usage_record\")\n+        .summary(\"Create a usage record\")\n+        .description(\n+            \"Accepts a usage record payload and delegates storage to the configured storage plugin.\",\n+        )\n+        .tag(API_TAG)\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .json_request::<CreateUsageRecordRequest>(openapi, \"Usage record to create\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::handle_create_usage_record)\n+        .json_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")","path":"modules/system/usage-collector/usage-collector/src/api/rest/routes.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **HIGH**\n> \n> `.json_response(StatusCode::NO_CONTENT, ...)` advertises an `application/json` body for HTTP 204, but the handler returns `StatusCode::NO_CONTENT` with no body. RFC 7230 §3.3.3 forbids a body on 204, and the OpenAPI doc will tell generated clients to expect JSON.\n> \n> `OperationBuilder` exposes `no_content_response(...)` precisely for this case (see `libs/modkit/src/api/operation_builder.rs:1084`).\n> \n> Replace the call with `.no_content_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")`.","created_at":"2026-05-15T11:40:44Z","updated_at":"2026-05-15T11:40:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247921402","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247921402"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247921402"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247921402/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":46,"side":"RIGHT","author_association":"MEMBER","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247927457","pull_request_review_id":4297816821,"id":3247927457,"node_id":"PRRC_kwDOPaLyBs7Bl3Ch","diff_hunk":"@@ -0,0 +1,113 @@\n+use std::sync::Arc;\n+\n+use authz_resolver_sdk::AuthZResolverClient;\n+use authz_resolver_sdk::EnforcerError;\n+use modkit_db::Db;\n+use modkit_db::outbox::WorkerTuning;\n+use modkit_db::outbox::{Outbox, OutboxHandle, Partitions};\n+use usage_collector_sdk::UsageCollectorClientV1;\n+\n+use crate::api::UsageEmitterV1;\n+use crate::config::UsageEmitterConfig;\n+use crate::infra::delivery_handler::DeliveryHandler;\n+use crate::scoped_emitter::ScopedUsageEmitter;\n+\n+/// An emitter that starts the usage outbox worker and issues scoped emit handles.\n+///\n+/// Constructed via [`UsageEmitter::build`]. Call [`UsageEmitterV1::for_module`] to obtain a\n+/// [`ScopedUsageEmitter`] bound to a module name, then use its `authorize_for` / `authorize` to\n+/// get a time-limited [`crate::AuthorizedUsageEmitter`].\n+pub struct UsageEmitter {\n+    config: Arc<UsageEmitterConfig>,\n+    db: Db,\n+    authz: Arc<dyn AuthZResolverClient>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+    outbox_handle: OutboxHandle,\n+}\n+\n+impl UsageEmitter {\n+    /// Build a [`UsageEmitter`] and start the background outbox worker.\n+    ///\n+    /// Registers the `usage-records` queue, attaches `delivery_handler` for async delivery to\n+    /// `collector`, and wires the [`authz_resolver_sdk::pep::PolicyEnforcer`] for per-call PDP checks.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if the outbox worker fails to start (e.g. DB unavailable or\n+    /// queue registration fails).\n+    pub async fn build(\n+        config: UsageEmitterConfig,\n+        db: Db,\n+        authz: Arc<dyn AuthZResolverClient>,\n+        collector: Arc<dyn UsageCollectorClientV1>,\n+    ) -> anyhow::Result<Self> {\n+        config.validate()?;\n+\n+        let delivery_handler = DeliveryHandler::new(Arc::clone(&collector));\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-6a\n+        let processor_tuning =\n+            WorkerTuning::processor_default().retry_max(config.outbox_backoff_max);\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-6a\n+\n+        let outbox_handle = Outbox::builder(db.clone())\n+            .processor_tuning(processor_tuning)\n+            .queue(\n+                &config.outbox_queue,\n+                Partitions::of(config.outbox_partition_count),\n+            )\n+            .leased(delivery_handler)\n+            .start()\n+            .await\n+            .map_err(anyhow::Error::from)?;\n+\n+        Ok(Self {\n+            config: Arc::new(config),\n+            db,\n+            authz,\n+            collector,\n+            outbox_handle,\n+        })\n+    }\n+}\n+\n+impl UsageEmitterV1 for UsageEmitter {\n+    fn for_module(&self, module_name: &str) -> ScopedUsageEmitter {\n+        ScopedUsageEmitter::new(\n+            module_name.to_owned(),\n+            Arc::clone(&self.authz),\n+            Arc::clone(&self.collector),\n+            self.db.clone(),\n+            Arc::clone(&self.config),\n+            Arc::clone(self.outbox_handle.outbox()),\n+        )\n+    }\n+}\n+\n+pub fn enforcer_error_to_emitter_error(e: EnforcerError) -> crate::error::UsageEmitterError {\n+    use crate::error::UsageEmitterError;\n+    use authz_resolver_sdk::EnforcerError;\n+    match e {\n+        EnforcerError::Denied { deny_reason } => {\n+            let message = deny_reason.map_or_else(\n+                || \"access denied by policy\".to_owned(),\n+                |r| match r.details {\n+                    Some(details) => format!(\"{}: {}\", r.error_code, details),\n+                    None => r.error_code,\n+                },\n+            );\n+            UsageEmitterError::authorization_failed(message)\n+        }\n+        EnforcerError::CompileFailed(_) => {\n+            UsageEmitterError::internal(\"authorization constraint compilation failed\")","path":"modules/system/usage-collector/usage-emitter/src/emitter.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **MEDIUM**\n> \n> `EnforcerError::CompileFailed(_)` and `EvaluationFailed(_)` discard the inner error, leaving the operator with only a fixed string.\n> \n> When PDP misbehaves in production, logs show \"authorization constraint compilation failed\" with no clue what failed. That defeats the point of having structured PDP errors.\n> \n> Format the inner cause into the message, e.g. `UsageEmitterError::internal(format!(\"authorization constraint compilation failed: {e}\"))` for both arms; or add a dedicated variant that preserves `#[source]`.","created_at":"2026-05-15T11:41:45Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247927457","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247927457"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247927457"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247927457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":102,"side":"RIGHT","author_association":"MEMBER","original_position":102,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247930565","pull_request_review_id":4297816821,"id":3247930565,"node_id":"PRRC_kwDOPaLyBs7Bl3zF","diff_hunk":"@@ -0,0 +1,239 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::{Problem, internal_error};\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use usage_emitter::{UsageEmitterError, UsageEmitterV1};\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(emitter): Extension<Arc<dyn UsageEmitterV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+    if let Some(err) = validate_metadata_size(req.metadata.as_ref()) {\n+        return Err(err);\n+    }\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+\n+    let authorized = authorize_request(&ctx, &emitter, &req).await?;\n+\n+    let mut builder = authorized\n+        .build_usage_record(req.metric, req.value)\n+        .with_timestamp(req.timestamp);\n+\n+    if let Some(key) = req.idempotency_key.filter(|k| !k.is_empty()) {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    builder.enqueue().await.map_err(emitter_error_to_problem)?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+fn validate_metadata_size(metadata: Option<&serde_json::Value>) -> Option<Problem> {\n+    let meta = metadata?;\n+    let byte_len = serde_json::to_vec(meta).map_or(0, |v| v.len());","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **MEDIUM**\n> \n> If `serde_json::to_vec(meta)` fails, `map_or(0, |v| v.len())` returns 0 and the metadata silently passes the size check. The same metadata is then re-serialized in `AuthorizedUsageEmitter::validate_metadata_size`, which surfaces a generic `Internal` error rather than the more accurate \"metadata too large / unserializable\" 422.\n> \n> Replace with an explicit match: on serialization error return a 422 `Problem` here (\"Invalid metadata\"), so the failure path is consistent and never bypasses validation.","created_at":"2026-05-15T11:42:15Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247930565","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247930565"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247930565"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247930565/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":53,"side":"RIGHT","author_association":"MEMBER","original_position":53,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247933305","pull_request_review_id":4297816821,"id":3247933305,"node_id":"PRRC_kwDOPaLyBs7Bl4d5","diff_hunk":"@@ -0,0 +1,239 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::{Problem, internal_error};\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use usage_emitter::{UsageEmitterError, UsageEmitterV1};\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(emitter): Extension<Arc<dyn UsageEmitterV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+    if let Some(err) = validate_metadata_size(req.metadata.as_ref()) {\n+        return Err(err);\n+    }\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+\n+    let authorized = authorize_request(&ctx, &emitter, &req).await?;\n+\n+    let mut builder = authorized\n+        .build_usage_record(req.metric, req.value)\n+        .with_timestamp(req.timestamp);\n+\n+    if let Some(key) = req.idempotency_key.filter(|k| !k.is_empty()) {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    builder.enqueue().await.map_err(emitter_error_to_problem)?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+fn validate_metadata_size(metadata: Option<&serde_json::Value>) -> Option<Problem> {\n+    let meta = metadata?;\n+    let byte_len = serde_json::to_vec(meta).map_or(0, |v| v.len());\n+    if byte_len > 8192 {\n+        tracing::warn!(\n+            byte_len,\n+            limit = 8192,\n+            \"Metadata byte length exceeds limit; rejecting record\"\n+        );\n+        return Some(Problem::new(\n+            StatusCode::UNPROCESSABLE_ENTITY,\n+            \"Metadata too large\",\n+            format!(\"metadata byte length {byte_len} exceeds limit of 8192\"),\n+        ));\n+    }\n+    None\n+}\n+\n+async fn authorize_request(\n+    ctx: &SecurityContext,\n+    emitter: &Arc<dyn UsageEmitterV1>,\n+    req: &CreateUsageRecordRequest,\n+) -> Result<usage_emitter::AuthorizedUsageEmitter, Problem> {\n+    match (&req.subject_id, &req.subject_type) {\n+        (None, None) => {\n+            // No subject — skip PDP authorization.\n+            tracing::debug!(\"No subject fields present; skipping PDP authorization\");","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **MEDIUM**\n> \n> The comment claims \"No subject — skip PDP authorization\", but the code still calls `authorize_for(...)` which always invokes the PDP via `PolicyEnforcer::access_scope_with` (see `scoped_emitter.rs:105`). Only the `subject_id`/`subject_type` resource properties are omitted from the request.\n> \n> The misleading comment will lead future readers to believe this branch is unauthorized, which it is not.\n> \n> Rewrite as: `// No subject context — call PDP without subject_id/subject_type properties.`","created_at":"2026-05-15T11:42:41Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247933305","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247933305"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247933305"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247933305/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":77,"side":"RIGHT","author_association":"MEMBER","original_position":77,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247937591","pull_request_review_id":4297816821,"id":3247937591,"node_id":"PRRC_kwDOPaLyBs7Bl5g3","diff_hunk":"@@ -0,0 +1,107 @@\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use modkit_db::outbox::{LeasedMessageHandler, MessageResult, OutboxMessage};\n+use tracing::{debug, error, info, warn};\n+use usage_collector_sdk::models::UsageRecord;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+\n+/// Outbox delivery handler that forwards dequeued usage records to the usage collector,\n+/// calling [`UsageCollectorClientV1::create_usage_record`] once per message.\n+///\n+/// Implements [`LeasedMessageHandler`]:\n+/// - Deserialization failures dead-letter the message (permanent: corrupt payload).\n+/// - [`UsageCollectorError::PluginTimeout`], [`UsageCollectorError::CircuitOpen`], and\n+///   [`UsageCollectorError::Unavailable`] trigger retry (transient: timeout, open circuit,\n+///   connection/transport error, or identity service temporarily unreachable).\n+/// - All other collector errors dead-letter the message (permanent: auth denial,\n+///   module not configured, or unexpected condition).\n+pub struct DeliveryHandler {\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+}\n+\n+impl DeliveryHandler {\n+    #[must_use]\n+    pub fn new(collector: Arc<dyn UsageCollectorClientV1>) -> Self {\n+        Self { collector }\n+    }\n+}\n+\n+#[async_trait]\n+impl LeasedMessageHandler for DeliveryHandler {\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1\n+    // @cpt-flow:cpt-cf-usage-collector-flow-sdk-and-ingest-core-emit:p1\n+    async fn handle(&self, msg: &OutboxMessage) -> MessageResult {\n+        // Processor may pass several messages per lease cycle (see WorkerTuning::batch_size);\n+        // this handler still delivers each payload individually.\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-1\n+        let record_result = serde_json::from_slice::<UsageRecord>(&msg.payload);\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-1\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2\n+        if let Err(ref err) = record_result {\n+            warn!(\n+                msg.seq,\n+                msg.partition_id,\n+                %err,\n+                \"usage record deserialization failed\"\n+            );\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2a\n+            return MessageResult::Reject(err.to_string());\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2\n+\n+        // inst-dlv-3: gateway ingest request assembly from UsageRecord fields is performed\n+        // inside UsageCollectorClientV1::create_usage_record — see rest_client.rs\n+        // (UsageRecord IS the request at this layer; DTO assembly is an implementation detail\n+        //  of the REST client adapter).\n+        // SAFETY: the Err branch above always returns; this value is Ok.\n+        #[allow(clippy::unwrap_used)]\n+        let record = record_result.unwrap();","path":"modules/system/usage-collector/usage-emitter/src/infra/delivery_handler.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> **MEDIUM**\n> \n> `if let Err(...) { return ...; } let record = record_result.unwrap();` is unidiomatic and forces a `#[allow(clippy::unwrap_used)]` and a SAFETY comment to explain why the unwrap is sound.\n> \n> Replace the block with a direct `match` that binds in the `Ok` arm:\n> \n> ```rust\n> let record = match serde_json::from_slice::<UsageRecord>(&msg.payload) {\n>     Ok(r) => r,\n>     Err(err) => {\n>         warn!(msg.seq, msg.partition_id, %err, \"usage record deserialization failed\");\n>         return MessageResult::Reject(err.to_string());\n>     }\n> };\n> ```\n> \n> Drop the `#[allow]` and the SAFETY note.","created_at":"2026-05-15T11:43:29Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247937591","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247937591"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247937591"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247937591/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":62,"side":"RIGHT","author_association":"MEMBER","original_position":62,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247946812","pull_request_review_id":4297816821,"id":3247946812,"node_id":"PRRC_kwDOPaLyBs7Bl7w8","diff_hunk":"@@ -0,0 +1,457 @@\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use chrono::{DateTime, Utc};\n+use modkit_db::migration_runner::run_migrations_for_testing;\n+use modkit_db::outbox::{\n+    LeasedMessageHandler, MessageResult, Outbox, OutboxHandle, OutboxMessage, Partitions,\n+    outbox_migrations,\n+};\n+use modkit_db::{ConnectOpts, Db, connect_db};\n+use usage_collector_sdk::models::{AllowedMetric, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::config::UsageEmitterConfig;\n+use crate::error::UsageEmitterError;\n+\n+// ── Infrastructure ────────────────────────────────────────────────────────────\n+\n+struct NoopHandler;\n+\n+#[async_trait]\n+impl LeasedMessageHandler for NoopHandler {\n+    async fn handle(&self, _msg: &OutboxMessage) -> MessageResult {\n+        MessageResult::Ok\n+    }\n+}\n+\n+async fn build_db(name: &str) -> Db {\n+    let url = format!(\"sqlite:file:{name}?mode=memory&cache=shared\");\n+    let db = connect_db(\n+        &url,\n+        ConnectOpts {\n+            max_conns: Some(1),\n+            ..Default::default()\n+        },\n+    )\n+    .await\n+    .unwrap();\n+    run_migrations_for_testing(&db, outbox_migrations())\n+        .await\n+        .unwrap();\n+    db\n+}\n+\n+async fn build_outbox(db: Db) -> OutboxHandle {\n+    let cfg = UsageEmitterConfig::default();\n+    Outbox::builder(db)\n+        .queue(\n+            cfg.outbox_queue.as_str(),\n+            Partitions::of(cfg.outbox_partition_count),\n+        )\n+        .leased(NoopHandler)\n+        .start()\n+        .await\n+        .unwrap()\n+}\n+\n+// ── Test fixture ──────────────────────────────────────────────────────────────\n+\n+struct Fixture {\n+    db: Db,\n+    _handle: OutboxHandle,\n+    emitter: AuthorizedUsageEmitter,\n+    tenant_id: Uuid,\n+    resource_id: Uuid,\n+}\n+\n+impl Fixture {\n+    async fn build(name: &str) -> Self {\n+        let db = build_db(name).await;\n+        let handle = build_outbox(db.clone()).await;\n+        let tenant_id = Uuid::new_v4();\n+        let resource_id = Uuid::new_v4();\n+        let allowed_metrics = vec![\n+            AllowedMetric {\n+                name: \"test.gauge\".to_owned(),\n+                kind: UsageKind::Gauge,\n+            },\n+            AllowedMetric {\n+                name: \"test.counter\".to_owned(),\n+                kind: UsageKind::Counter,\n+            },\n+        ];\n+        let emitter = AuthorizedUsageEmitter::new(\n+            Arc::new(UsageEmitterConfig::default()),\n+            db.clone(),\n+            Arc::clone(handle.outbox()),\n+            \"test-module\".to_owned(),\n+            tenant_id,\n+            resource_id,\n+            \"test.resource\".to_owned(),\n+            allowed_metrics,\n+            Some(Uuid::nil()),\n+            Some(\"test.subject\".to_owned()),\n+        );\n+        Self {\n+            db,\n+            _handle: handle,\n+            emitter,\n+            tenant_id,\n+            resource_id,\n+        }\n+    }\n+\n+    fn conn(&self) -> modkit_db::DbConn<'_> {\n+        self.db.conn().unwrap()\n+    }\n+\n+    /// Build a valid `UsageRecord` that matches the authorized token fields.\n+    fn record(&self) -> UsageRecord {\n+        UsageRecord {\n+            tenant_id: self.tenant_id,\n+            module: \"test-module\".to_owned(),\n+            metric: \"test.gauge\".to_owned(),\n+            kind: UsageKind::Gauge,\n+            value: 1.0,\n+            resource_id: self.resource_id,\n+            resource_type: \"test.resource\".to_owned(),\n+            subject_id: Some(Uuid::nil()),\n+            subject_type: Some(\"test.subject\".to_owned()),\n+            idempotency_key: Uuid::new_v4().to_string(),\n+            timestamp: Utc::now(),\n+            metadata: None,\n+        }\n+    }\n+}\n+\n+// ── Metric kind resolution ────────────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn builder_enqueues_gauge_metric() {\n+    let f = Fixture::build(\"ub_gauge\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 42.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_enqueues_counter_metric_with_positive_value() {\n+    let f = Fixture::build(\"ub_counter_pos\").await;\n+    f.emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .with_idempotency_key(\"idem-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_counter_metric_with_negative_value() {\n+    let f = Fixture::build(\"ub_counter_neg\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", -1.0)\n+        .with_idempotency_key(\"idem-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(\n+        err,\n+        UsageEmitterError::NegativeCounterValue { value } if (value + 1.0).abs() < f64::EPSILON\n+    ));\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_counter_metric_without_idempotency_key() {\n+    let f = Fixture::build(\"ub_counter_no_idem\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(err, UsageEmitterError::InvalidRecord { .. }));\n+}\n+\n+#[tokio::test]\n+async fn builder_accepts_gauge_metric_with_negative_value() {\n+    let f = Fixture::build(\"ub_gauge_neg\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", -5.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_unknown_metric() {\n+    let f = Fixture::build(\"ub_unknown_metric\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"unknown.metric\", 1.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(\n+        matches!(err, UsageEmitterError::MetricNotAllowed { ref metric } if metric == \"unknown.metric\")\n+    );\n+}\n+\n+// ── Optional fields ───────────────────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn builder_with_idempotency_key_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_idem_key\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 1.0)\n+        .with_idempotency_key(\"my-stable-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_with_timestamp_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_timestamp\").await;\n+    let ts = DateTime::parse_from_rfc3339(\"2025-01-01T00:00:00Z\")\n+        .unwrap()\n+        .with_timezone(&Utc);\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 1.0)\n+        .with_timestamp(ts)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_without_optional_fields_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_defaults\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 0.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+// ── Blank idempotency key handling ────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn test_counter_with_blank_idempotency_key_is_rejected() {\n+    let f = Fixture::build(\"ub_counter_blank_idem\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .with_idempotency_key(\"\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(err, UsageEmitterError::InvalidRecord { .. }));\n+}\n+\n+#[tokio::test]\n+async fn test_gauge_with_blank_idempotency_key_uses_uuid_fallback() {","path":"modules/system/usage-collector/usage-emitter/src/usage_builder_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> MEDIUM\n> \n> The test name claims \"uses_uuid_fallback\", but the assertion (line 351-354) is assert!(record.idempotency_key.is_empty(), ...) — it verifies the opposite (empty string, not UUID).\n> \n> This indicates either the production behaviour regressed without the test being renamed, or the test was written against an aspirational contract that was never implemented. Either way the name lies about what is verified.\n> \n> If the empty-string behaviour is intentional, rename to gauge_with_blank_idempotency_key_stays_blank. If a UUID fallback is the intended contract (per usage_builder.rs:43 doc), fix usage_builder.rs:116-120 and update the assertion accordingly.","created_at":"2026-05-15T11:45:19Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247946812","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247946812"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247946812"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247946812/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":257,"side":"RIGHT","author_association":"MEMBER","original_position":257,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247950456","pull_request_review_id":4297816821,"id":3247950456,"node_id":"PRRC_kwDOPaLyBs7Bl8p4","diff_hunk":"@@ -0,0 +1,57 @@\n+use usage_collector_sdk::models::UsageKind;\n+\n+use super::*;\n+\n+// ── Display ───────────────────────────────────────────────────────\n+\n+#[test]\n+fn display_authorization_expired() {","path":"modules/system/usage-collector/usage-emitter/src/error_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> LOW\n> \n> The display_* tests in this file (lines 8-57) only snapshot the #[error(...)] format strings produced by thiserror. They verify framework-generated Display output, not domain behavior — a contract no consumer relies on. Renaming the message strings would require lock-step test updates with zero defensive value (snapshot abuse, anti-pattern https://github.com/cyberfabric/cyberware-rust/pull/8 in the test guidelines).\n> \n> Delete the display_* tests, or replace them with a single test that asserts the message includes the dynamic field (metric, value, len, etc.) when that field is the diagnostic contract.","created_at":"2026-05-15T11:46:04Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247950456","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247950456"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247950456"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247950456/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":8,"side":"RIGHT","author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247953687","pull_request_review_id":4297816821,"id":3247953687,"node_id":"PRRC_kwDOPaLyBs7Bl9cX","diff_hunk":"@@ -0,0 +1,111 @@\n+use std::time::Duration;\n+\n+use super::UsageEmitterConfig;\n+\n+#[test]\n+fn default_authorization_max_age_is_30_seconds() {\n+    let cfg = UsageEmitterConfig::default();","path":"modules/system/usage-collector/usage-emitter/src/config_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> LOW\n> \n> default_authorization_max_age_is_30_seconds, default_outbox_queue_is_usage_records, default_outbox_partition_count_is_4, and default_outbox_backoff_max_is_10_minutes (lines 5-21, 78-82) only read back constants from the Default impl. They are constructor-echo tests (anti-pattern https://github.com/cyberfabric/cyberware-rust/pull/1 in the test guidelines): tightening or loosening any default to a different reasonable value breaks them with no behavior actually broken.\n> \n> Delete them. The remaining validate_* and serde tests in this file already cover the meaningful contracts (validation bounds, serde compatibility).","created_at":"2026-05-15T11:46:44Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247953687","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247953687"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3247953687"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3247953687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":7,"side":"RIGHT","author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248019593","pull_request_review_id":4297816821,"id":3248019593,"node_id":"PRRC_kwDOPaLyBs7BmNiJ","diff_hunk":"@@ -0,0 +1,42 @@\n+use chrono::Utc;\n+use usage_collector_sdk::{UsageCollectorPluginClientV1, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use super::Service;\n+\n+fn make_record(tenant_id: Uuid) -> UsageRecord {\n+    UsageRecord {\n+        module: \"test-module\".to_owned(),\n+        tenant_id,\n+        metric: \"test.metric\".to_owned(),\n+        kind: UsageKind::Gauge,\n+        value: 1.0,\n+        resource_id: Uuid::new_v4(),\n+        resource_type: \"test.resource\".to_owned(),\n+        subject_id: Some(Uuid::nil()),\n+        subject_type: Some(\"test.subject\".to_owned()),\n+        idempotency_key: Uuid::new_v4().to_string(),\n+        timestamp: Utc::now(),\n+        metadata: None,\n+    }\n+}\n+\n+#[tokio::test]\n+async fn create_usage_record_always_returns_ok() {\n+    let service = Service::new();\n+    let plugin: &dyn UsageCollectorPluginClientV1 = &service;\n+    let rec = make_record(Uuid::new_v4());\n+    let result = plugin.create_usage_record(rec).await;\n+    assert!(result.is_ok());\n+}\n+\n+#[tokio::test]\n+async fn create_usage_record_multiple_records_all_return_ok() {","path":"modules/system/usage-collector/plugins/noop-usage-collector-storage-plugin/src/domain/client_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 commented:\n\n> LOW\n> \n> create_usage_record_multiple_records_all_return_ok adds no coverage over create_usage_record_always_returns_ok: the noop service is stateless, so calling the same Ok-returning function in a loop verifies nothing new (anti-pattern https://github.com/cyberfabric/cyberware-rust/pull/5: redundant test).\n> \n> Delete this test.","created_at":"2026-05-15T12:00:14Z","updated_at":"2026-05-15T12:00:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248019593","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248019593"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248019593"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248019593/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":34,"side":"RIGHT","author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248113792","pull_request_review_id":4298032381,"id":3248113792,"node_id":"PRRC_kwDOPaLyBs7BmkiA","diff_hunk":"@@ -0,0 +1,134 @@\n+//! [`UsageRecordBuilder`] for chaining optional fields and enqueueing through an\n+//! [`AuthorizedUsageEmitter`](crate::AuthorizedUsageEmitter). Tenant, resource, module,\n+//! and kind are taken from the authorized handle; kind is resolved from the allowed metrics list.\n+//!\n+//! Construct via [`AuthorizedUsageEmitter::build_usage_record`](crate::AuthorizedUsageEmitter::build_usage_record).\n+\n+use chrono::{DateTime, Utc};\n+use modkit_db::secure::DBRunner;\n+use serde_json::Value as JsonValue;\n+use usage_collector_sdk::models::{UsageKind, UsageRecord};\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::error::UsageEmitterError;\n+\n+/// Fluent builder tied to an [`AuthorizedUsageEmitter`]. Optionally set idempotency key or\n+/// timestamp, then [`Self::enqueue`] or [`Self::enqueue_in`].\n+///\n+/// `kind` is resolved automatically from the allowed metrics list; no `.counter()` or `.gauge()`\n+/// call is required.\n+pub struct UsageRecordBuilder<'a> {\n+    emitter: &'a AuthorizedUsageEmitter,\n+    metric: String,\n+    idempotency_key: Option<String>,\n+    value: f64,\n+    timestamp: Option<DateTime<Utc>>,\n+    metadata: Option<JsonValue>,\n+}\n+\n+impl<'a> UsageRecordBuilder<'a> {\n+    /// Starts a builder with the required `metric` and `value` set.\n+    #[must_use]\n+    pub fn new(emitter: &'a AuthorizedUsageEmitter, metric: impl Into<String>, value: f64) -> Self {\n+        Self {\n+            emitter,\n+            metric: metric.into(),\n+            idempotency_key: None,\n+            value,\n+            timestamp: None,\n+            metadata: None,\n+        }\n+    }\n+\n+    /// Sets a caller-provided idempotency key. If omitted, a new UUID string is used on enqueue.\n+    #[must_use]\n+    pub fn with_idempotency_key(self, key: impl Into<String>) -> Self {\n+        Self {\n+            idempotency_key: Some(key.into()),\n+            ..self\n+        }\n+    }\n+\n+    /// Sets the observation timestamp. If omitted, the current UTC time is used on enqueue.\n+    #[must_use]\n+    pub fn with_timestamp(self, timestamp: DateTime<Utc>) -> Self {\n+        Self {\n+            timestamp: Some(timestamp),\n+            ..self\n+        }\n+    }\n+\n+    /// Sets optional metadata JSON. Must serialize to ≤ 8192 bytes or enqueue will return\n+    /// [`UsageEmitterError::MetadataTooLarge`].\n+    #[must_use]\n+    pub fn with_metadata(self, metadata: JsonValue) -> Self {\n+        Self {\n+            metadata: Some(metadata),\n+            ..self\n+        }\n+    }\n+\n+    /// Builds, then enqueues on this emitter's database connection.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError::InvalidRecord`] if the metric is not in the allowed list,\n+    /// or any error from [`AuthorizedUsageEmitter::enqueue_in`].\n+    pub async fn enqueue(self) -> Result<(), UsageEmitterError> {\n+        let conn = self\n+            .emitter\n+            .db\n+            .conn()\n+            .map_err(|e| UsageEmitterError::internal(e.to_string()))?;\n+        self.enqueue_in(&conn).await\n+    }\n+\n+    /// Builds, then enqueues on the given database runner (connection or transaction).\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError::InvalidRecord`] if the metric is not in the allowed list,\n+    /// or any error from [`AuthorizedUsageEmitter::enqueue_in`].\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1\n+    pub async fn enqueue_in(self, db: &(dyn DBRunner + Sync)) -> Result<(), UsageEmitterError> {\n+        let kind = self\n+            .emitter\n+            .allowed_metrics\n+            .iter()\n+            .find(|m| m.name == self.metric)\n+            .map_or(UsageKind::Gauge, |m| m.kind);\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+        let subject_id = self.emitter.subject_id;\n+        let subject_type = self.emitter.subject_type.clone();\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+\n+        let record = UsageRecord {\n+            tenant_id: self.emitter.tenant_id,\n+            module: self.emitter.module.clone(),\n+            resource_id: self.emitter.resource_id,\n+            resource_type: self.emitter.resource_type.clone(),\n+            subject_id,\n+            subject_type,\n+            metric: self.metric,\n+            kind,\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5b\n+            idempotency_key: if kind == UsageKind::Gauge {\n+                String::new()\n+            } else {\n+                self.idempotency_key.unwrap_or_default()","path":"modules/system/usage-collector/usage-emitter/src/usage_builder.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The feedback is fully resolved. The old `usage_builder.rs:119` no longer exists; the builder is now `usage-emitter/src/domain/usage_record_builder.rs` and the contract has been split kind-aware:\r\n\r\n  ## Documented contract (the part that was wrong)\r\n\r\n  - `with_idempotency_key` doc at `usage_record_builder.rs:110-115`:\r\n    > Required (non-empty) for counter metrics — enforced by `UsageEmitter::enqueue_in`. Optional for gauge metrics; when omitted or blank, the emitter generates a UUID at enqueue time.\r\n  - Wire DTO at `dto.rs:28-30` mirrors this: \"Required for counter metrics (non-empty); optional for gauge — when omitted for a gauge, the gateway generates a UUID … Counter records without a key are rejected\r\n  with `422 Unprocessable Entity`.\"\r\n\r\n  So the doc no longer overpromises a UUID for every record.\r\n\r\n  ## Behavior (the part that has to match)\r\n\r\n  `UsageRecordBuilder::build` still uses `idempotency_key.unwrap_or_default()` (`usage_record_builder.rs:186`) and emits `\"\"` as a sentinel. The kind-aware logic lives one layer down in\r\n  `UsageEmitter::enqueue_in` (`emitter.rs:60-119`), in this specific order:\r\n\r\n  1. `validate_counter_idempotency_key` (`emitter.rs:235-246`) — if `kind == Counter` and the key is blank/whitespace, reject with `InvalidArgument` (\"counter records require a non-empty idempotency_key\"). 422\r\n   here is now the *documented* contract, not a surprise.\r\n  2. `generate_gauge_idempotency_key` (`emitter.rs:276-282`) — if `kind == Gauge` and the key is blank/whitespace, set it to `Uuid::new_v4().to_string()`.\r\n\r\n  The order matters: the comment at `emitter.rs:77-80` calls it out — generate runs *after* validate, so counter records can't be silently rescued by a generated UUID.\r\n\r\n  ## Net effect\r\n\r\n  Both cases the reviewer flagged are correct now:\r\n\r\n  - A gauge without a key gets a UUID (matches the doc).\r\n  - A counter without a key gets the canonical 422 (also matches the doc, on both the builder side and the REST DTO side).","created_at":"2026-05-15T12:19:26Z","updated_at":"2026-05-15T12:19:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248113792","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248113792"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248113792"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248113792/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":119,"side":"RIGHT","in_reply_to_id":3247908458,"author_association":"MEMBER","original_position":119,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248159937","pull_request_review_id":4298081884,"id":3248159937,"node_id":"PRRC_kwDOPaLyBs7BmvzB","diff_hunk":"@@ -0,0 +1,188 @@\n+use std::sync::Arc;\n+\n+use authz_resolver_sdk::AuthZResolverClient;\n+use authz_resolver_sdk::models::BarrierMode;\n+use authz_resolver_sdk::pep::{AccessRequest, PolicyEnforcer};\n+use modkit_db::Db;\n+use modkit_db::outbox::Outbox;\n+use modkit_security::{SecurityContext, pep_properties};\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use uuid::Uuid;\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::config::UsageEmitterConfig;\n+use crate::domain::authz;\n+use crate::emitter::enforcer_error_to_emitter_error;\n+use crate::error::UsageEmitterError;\n+\n+/// A usage emitter scoped to a specific module.\n+///\n+/// Constructed via [`crate::UsageEmitterV1::for_module`]. Call [`Self::authorize_for`] or\n+/// [`Self::authorize`] to obtain a time-limited [`AuthorizedUsageEmitter`] after PDP authorization\n+/// and allowed-metrics retrieval for this module.\n+///\n+/// # Example\n+///\n+/// ```ignore\n+/// // In init():\n+/// let scoped = emitter.for_module(Self::MODULE_NAME);\n+///\n+/// // In a handler (with subject):\n+/// let authorized = scoped\n+///     .authorize_for(&ctx, tenant_id, resource_id, resource_type, Some(subject_id), Some(subject_type))\n+///     .await?;\n+/// authorized.build_usage_record(\"requests\", 1.0).enqueue().await?;\n+///\n+/// // In a handler (without subject):\n+/// let authorized = scoped\n+///     .authorize_for(&ctx, tenant_id, resource_id, resource_type, None, None)\n+///     .await?;\n+/// authorized.build_usage_record(\"requests\", 1.0).enqueue().await?;\n+/// ```\n+#[derive(Clone)]\n+pub struct ScopedUsageEmitter {\n+    module: String,\n+    authz: Arc<dyn AuthZResolverClient>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+    db: Db,\n+    config: Arc<UsageEmitterConfig>,\n+    outbox: Arc<Outbox>,\n+}\n+\n+impl ScopedUsageEmitter {\n+    pub(crate) fn new(\n+        module: String,\n+        authz: Arc<dyn AuthZResolverClient>,\n+        collector: Arc<dyn UsageCollectorClientV1>,\n+        db: Db,\n+        config: Arc<UsageEmitterConfig>,\n+        outbox: Arc<Outbox>,\n+    ) -> Self {\n+        Self {\n+            module,\n+            authz,\n+            collector,\n+            db,\n+            config,\n+            outbox,\n+        }\n+    }\n+\n+    /// Obtain a time-limited [`AuthorizedUsageEmitter`] by calling the PDP for `USAGE_RECORD`/`CREATE`\n+    /// and fetching the allowed metrics for this module from the collector.\n+    ///\n+    /// The returned handle is bound to the module name, tenant, metered resource, and subject\n+    /// identity; every enqueued record must match and its metric must be in the allowed list.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] if PDP denies, the module is not configured, or the collector\n+    /// call fails.\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1\n+    pub async fn authorize_for(\n+        &self,\n+        ctx: &SecurityContext,\n+        tenant_id: Uuid,\n+        resource_id: Uuid,\n+        resource_type: String,\n+        subject_id: Option<Uuid>,\n+        subject_type: Option<String>,\n+    ) -> Result<AuthorizedUsageEmitter, UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-2\n+        let mut request = AccessRequest::new()\n+            .require_constraints(false)\n+            .barrier_mode(BarrierMode::Ignore)\n+            .resource_property(pep_properties::OWNER_TENANT_ID, tenant_id)\n+            .resource_property(authz::properties::RESOURCE_ID, resource_id)\n+            .resource_property(authz::properties::RESOURCE_TYPE, resource_type.as_str())\n+            .resource_property(authz::properties::MODULE, self.module.clone());\n+        if let Some(ref sid) = subject_id {\n+            request = request.resource_property(authz::properties::SUBJECT_ID, sid.to_string());\n+        }\n+        if let Some(ref stype) = subject_type {\n+            request = request.resource_property(authz::properties::SUBJECT_TYPE, stype.as_str());\n+        }\n+        let pdp_result = PolicyEnforcer::new(Arc::clone(&self.authz))\n+            .access_scope_with(\n+                ctx,\n+                &authz::USAGE_RECORD,\n+                authz::actions::CREATE,\n+                None,\n+                &request,\n+            )\n+            .await;\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-2\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3\n+        if let Err(e) = pdp_result {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3a\n+            return Err(enforcer_error_to_emitter_error(e));\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-3\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-4\n+        // @cpt-begin:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-1\n+        let module_cfg_result = self.collector.get_module_config(&self.module).await;\n+        // @cpt-end:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-1\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-4\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5\n+        let module_cfg = match module_cfg_result {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5a\n+            Err(UsageCollectorError::ModuleNotFound { module_name }) => {\n+                return Err(UsageEmitterError::module_not_configured(module_name));\n+            }\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5a\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-5b\n+            Err(e) => return Err(UsageEmitterError::internal(e.to_string())),","path":"modules/system/usage-collector/usage-emitter/src/scoped_emitter.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The feedback is resolved. Here's how:\r\n\r\n## The original problem (commit `daf14524`, `scoped_emitter.rs:138`)\r\n\r\n```rust\r\nErr(e) => return Err(UsageEmitterError::internal(e.to_string())),\r\n```\r\n\r\nEvery non-`ModuleNotFound` `UsageCollectorError` variant got stringified into a generic Internal error, so `DeadlineExceeded` / `ServiceUnavailable` / `ResourceExhausted` etc. were no longer distinguishable to\r\ncallers.\r\n\r\nThe refactor\r\n\r\n1. `UsageEmitterError` is now a type alias for `CanonicalError` (`usage-emitter/src/error.rs:16`), the same canonical taxonomy that `UsageCollectorError` already uses (`usage-collector-sdk/src/error.rs:3`).\r\n2. In `domain/factory.rs:187-202`, the old match-on-`ModuleNotFound`/stringify-everything-else block is gone. The collector call is now:\r\n\r\n```rust\r\nlet Ok(module_cfg_result) = timeout(\r\n    self.config.authorize_call_timeout,\r\n    self.collector.get_module_config(&self.module),\r\n).await else {\r\n    return Err(UsageRecordError::deadline_exceeded(...).create());\r\n};\r\nlet module_cfg = module_cfg_result?;\r\n```\r\n\r\n2. The ? propagates the collector error verbatim — same enum, same variant, no string collapse. `DeadlineExceeded`, `ServiceUnavailable`, `ResourceExhausted`, `NotFound` (module-not-found), `PermissionDenied`, etc.\r\nall reach the caller intact and remain mappable to REST 503/504/etc.\r\n3. Coverage is locked in by factory_tests.rs:\r\n  - `authorize_propagates_collector_deadline_exceeded` (line 421) asserts `Err(UsageEmitterError::DeadlineExceeded { .. })`.\r\n  - `authorize_propagates_collector_service_unavailable` (line 443) asserts `Err(UsageEmitterError::ServiceUnavailable { .. })`.\r\n  - `authorize_propagates_collector_resource_exhausted` (line 465) for the rate-limit variant.\r\n\r\n## Summary\r\n\r\nSo the feedback — \"preserve the source / surface them as distinct variants\" — is satisfied structurally: unifying both crates on `CanonicalError` makes the propagation lossless by construction rather than\r\nneeding a per-variant `#[from]` mapping.\r\n","created_at":"2026-05-15T12:27:52Z","updated_at":"2026-05-15T12:28:06Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248159937","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248159937"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248159937"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248159937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":138,"side":"RIGHT","in_reply_to_id":3247916787,"author_association":"MEMBER","original_position":138,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248185023","pull_request_review_id":4298109439,"id":3248185023,"node_id":"PRRC_kwDOPaLyBs7Bm16_","diff_hunk":"@@ -0,0 +1,73 @@\n+//! Route registration for the usage-collector REST API.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+\n+use modkit::api::operation_builder::LicenseFeature;\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use usage_collector_sdk::UsageCollectorClientV1;\n+use usage_emitter::UsageEmitterV1;\n+\n+use super::dto::{CreateUsageRecordRequest, ModuleConfigResponse};\n+use super::handlers;\n+\n+const API_TAG: &str = \"Usage Collector\";\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.cf.core.lic.feat.v1~cf.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the usage-collector module.\n+pub fn register_routes(\n+    router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    emitter: Arc<dyn UsageEmitterV1>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+) -> Router {\n+    let router = OperationBuilder::post(\"/usage-collector/v1/records\")\n+        .operation_id(\"usage_collector.create_usage_record\")\n+        .summary(\"Create a usage record\")\n+        .description(\n+            \"Accepts a usage record payload and delegates storage to the configured storage plugin.\",\n+        )\n+        .tag(API_TAG)\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .json_request::<CreateUsageRecordRequest>(openapi, \"Usage record to create\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::handle_create_usage_record)\n+        .json_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")","path":"modules/system/usage-collector/usage-collector/src/api/rest/routes.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved in the latest revision of this branch.\r\n\r\n`modules/system/usage-collector/usage-collector/src/api/rest/routes.rs:49` now reads:\r\n\r\n```rust\r\n.no_content_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")\r\n```\r\n\r\ninstead of the original `.json_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")`. The handler at `modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs:59` still returns `Ok(StatusCode::NO_CONTENT)` with no body, so the wire behavior and the OpenAPI doc are now consistent: clients are told to expect an empty 204, matching RFC 7230 §3.3.3.\r\n","created_at":"2026-05-15T12:32:28Z","updated_at":"2026-05-15T12:32:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248185023","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248185023"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248185023"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248185023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":46,"side":"RIGHT","in_reply_to_id":3247921402,"author_association":"MEMBER","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248231066","pull_request_review_id":4298163074,"id":3248231066,"node_id":"PRRC_kwDOPaLyBs7BnBKa","diff_hunk":"@@ -0,0 +1,113 @@\n+use std::sync::Arc;\n+\n+use authz_resolver_sdk::AuthZResolverClient;\n+use authz_resolver_sdk::EnforcerError;\n+use modkit_db::Db;\n+use modkit_db::outbox::WorkerTuning;\n+use modkit_db::outbox::{Outbox, OutboxHandle, Partitions};\n+use usage_collector_sdk::UsageCollectorClientV1;\n+\n+use crate::api::UsageEmitterV1;\n+use crate::config::UsageEmitterConfig;\n+use crate::infra::delivery_handler::DeliveryHandler;\n+use crate::scoped_emitter::ScopedUsageEmitter;\n+\n+/// An emitter that starts the usage outbox worker and issues scoped emit handles.\n+///\n+/// Constructed via [`UsageEmitter::build`]. Call [`UsageEmitterV1::for_module`] to obtain a\n+/// [`ScopedUsageEmitter`] bound to a module name, then use its `authorize_for` / `authorize` to\n+/// get a time-limited [`crate::AuthorizedUsageEmitter`].\n+pub struct UsageEmitter {\n+    config: Arc<UsageEmitterConfig>,\n+    db: Db,\n+    authz: Arc<dyn AuthZResolverClient>,\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+    outbox_handle: OutboxHandle,\n+}\n+\n+impl UsageEmitter {\n+    /// Build a [`UsageEmitter`] and start the background outbox worker.\n+    ///\n+    /// Registers the `usage-records` queue, attaches `delivery_handler` for async delivery to\n+    /// `collector`, and wires the [`authz_resolver_sdk::pep::PolicyEnforcer`] for per-call PDP checks.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if the outbox worker fails to start (e.g. DB unavailable or\n+    /// queue registration fails).\n+    pub async fn build(\n+        config: UsageEmitterConfig,\n+        db: Db,\n+        authz: Arc<dyn AuthZResolverClient>,\n+        collector: Arc<dyn UsageCollectorClientV1>,\n+    ) -> anyhow::Result<Self> {\n+        config.validate()?;\n+\n+        let delivery_handler = DeliveryHandler::new(Arc::clone(&collector));\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-6a\n+        let processor_tuning =\n+            WorkerTuning::processor_default().retry_max(config.outbox_backoff_max);\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-6a\n+\n+        let outbox_handle = Outbox::builder(db.clone())\n+            .processor_tuning(processor_tuning)\n+            .queue(\n+                &config.outbox_queue,\n+                Partitions::of(config.outbox_partition_count),\n+            )\n+            .leased(delivery_handler)\n+            .start()\n+            .await\n+            .map_err(anyhow::Error::from)?;\n+\n+        Ok(Self {\n+            config: Arc::new(config),\n+            db,\n+            authz,\n+            collector,\n+            outbox_handle,\n+        })\n+    }\n+}\n+\n+impl UsageEmitterV1 for UsageEmitter {\n+    fn for_module(&self, module_name: &str) -> ScopedUsageEmitter {\n+        ScopedUsageEmitter::new(\n+            module_name.to_owned(),\n+            Arc::clone(&self.authz),\n+            Arc::clone(&self.collector),\n+            self.db.clone(),\n+            Arc::clone(&self.config),\n+            Arc::clone(self.outbox_handle.outbox()),\n+        )\n+    }\n+}\n+\n+pub fn enforcer_error_to_emitter_error(e: EnforcerError) -> crate::error::UsageEmitterError {\n+    use crate::error::UsageEmitterError;\n+    use authz_resolver_sdk::EnforcerError;\n+    match e {\n+        EnforcerError::Denied { deny_reason } => {\n+            let message = deny_reason.map_or_else(\n+                || \"access denied by policy\".to_owned(),\n+                |r| match r.details {\n+                    Some(details) => format!(\"{}: {}\", r.error_code, details),\n+                    None => r.error_code,\n+                },\n+            );\n+            UsageEmitterError::authorization_failed(message)\n+        }\n+        EnforcerError::CompileFailed(_) => {\n+            UsageEmitterError::internal(\"authorization constraint compilation failed\")","path":"modules/system/usage-collector/usage-emitter/src/emitter.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Status:** Resolved.\r\n\r\nThe mapping moved from `emitter.rs` into a dedicated helper at\r\n`modules/system/usage-collector/usage-emitter/src/error.rs:24`\r\n(`enforcer_error_to_emitter_error`). Both arms now bind the inner\r\n`source` and log it via `tracing::error!` before returning a\r\nfail-closed canonical error:\r\n\r\n```rust\r\nEnforcerError::CompileFailed(source) => {\r\n    error!(\r\n        pdp_error_variant = \"CompileFailed\",\r\n        error = %source,\r\n        \"PDP constraint compilation failed; access denied (fail-closed)\",\r\n    );\r\n    UsageRecordError::permission_denied()\r\n        .with_reason(\"AUTHORIZATION_DENIED\")\r\n        .create()\r\n}\r\n// EvaluationFailed handled the same way.\r\n```\r\n\r\nThe reviewer's concern — *\"logs show a fixed string with no clue what\r\nfailed\"* — is addressed: every infra failure now produces a structured\r\nlog line carrying the variant tag and the full `Display` of the\r\nunderlying `ConstraintCompileError` / `AuthZResolverError`.\r\n\r\n**Deliberate divergence:** the cause is not folded into the returned\r\nerror (no `format!(\"...: {e}\")`, no `#[source]`). All three\r\n`EnforcerError` outcomes collapse to `PermissionDenied` with\r\n`AUTHORIZATION_DENIED` to keep the fail-closed posture — a PDP infra\r\nfault must be indistinguishable from a policy denial at the API\r\nboundary. Diagnosability lives in logs; the returned error stays safe.\r\n","created_at":"2026-05-15T12:40:51Z","updated_at":"2026-05-15T12:40:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248231066","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248231066"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248231066"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248231066/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":102,"side":"RIGHT","in_reply_to_id":3247927457,"author_association":"MEMBER","original_position":102,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248255316","pull_request_review_id":4298190994,"id":3248255316,"node_id":"PRRC_kwDOPaLyBs7BnHFU","diff_hunk":"@@ -0,0 +1,239 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::{Problem, internal_error};\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use usage_emitter::{UsageEmitterError, UsageEmitterV1};\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(emitter): Extension<Arc<dyn UsageEmitterV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+    if let Some(err) = validate_metadata_size(req.metadata.as_ref()) {\n+        return Err(err);\n+    }\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+\n+    let authorized = authorize_request(&ctx, &emitter, &req).await?;\n+\n+    let mut builder = authorized\n+        .build_usage_record(req.metric, req.value)\n+        .with_timestamp(req.timestamp);\n+\n+    if let Some(key) = req.idempotency_key.filter(|k| !k.is_empty()) {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    builder.enqueue().await.map_err(emitter_error_to_problem)?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+fn validate_metadata_size(metadata: Option<&serde_json::Value>) -> Option<Problem> {\n+    let meta = metadata?;\n+    let byte_len = serde_json::to_vec(meta).map_or(0, |v| v.len());","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved by the refactor — the handler-side pre-check that this feedback targeted no longer exists.\r\n\r\n**What changed**\r\n\r\nThe handler (`modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs`) no longer calls a local `validate_metadata_size` helper. It just attaches metadata to the builder and lets the emitter validate at enqueue time, with errors mapped through one canonical path.\r\n\r\n```rust\r\nif let Some(meta) = req.metadata {\r\n    builder = builder.with_metadata(meta);\r\n}\r\nlet record = builder.build().map_err(|e| canonical_error_to_problem(&e))?;\r\nemitter.enqueue(record).await.map_err(|e| canonical_error_to_problem(&e))?;\r\n```\r\n\r\n**Why the original concern is gone**\r\n\r\n1. **No more `map_or(0, |v| v.len())`.** The lossy `to_vec(...).map_or(0, ...)` line was deleted; there is no path that treats a serialization failure as 0 bytes anymore.\r\n2. **Single source of truth for size validation.** `UsageEmitter::validate_metadata_size` in `usage-emitter/src/domain/emitter.rs:248` is now the only place this check runs. Serialization failure there is explicit — it produces `UsageRecordError::invalid_argument()` with constraint `\"metadata is not serializable: {e}\"`, not a generic `Internal`:\r\n   ```rust\r\n   let len = serde_json::to_vec(metadata)\r\n       .map_err(|e| UsageRecordError::invalid_argument()\r\n           .with_constraint(format!(\"metadata is not serializable: {e}\"))\r\n           .create())?\r\n       .len();\r\n   ```\r\n3. **Mapped to a proper client error, not 500.** `canonical_error_to_problem` routes `InvalidArgument` through `modkit_canonical_errors::Problem::from_error`, where `InvalidArgument` → HTTP 400 with the canonical title/detail/context preserved as RFC 9457 extension members. So an unserializable metadata payload surfaces as a structured client error, not a generic `Internal`.\r\n4. **No double-serialization risk.** Because the handler no longer serializes metadata to size-check it, the value is serialized exactly once (inside the emitter), so there is no second call that could disagree with the first.\r\n\r\nNet result: the failure mode the reviewer flagged (silent bypass → re-serialize → generic `Internal`) is structurally impossible in the current code.\r\n","created_at":"2026-05-15T12:45:37Z","updated_at":"2026-05-15T12:45:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248255316","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248255316"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248255316"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248255316/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":53,"side":"RIGHT","in_reply_to_id":3247930565,"author_association":"MEMBER","original_position":53,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248273327","pull_request_review_id":4298213724,"id":3248273327,"node_id":"PRRC_kwDOPaLyBs7BnLev","diff_hunk":"@@ -0,0 +1,239 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::{Problem, internal_error};\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+use usage_emitter::{UsageEmitterError, UsageEmitterV1};\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(emitter): Extension<Arc<dyn UsageEmitterV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+    if let Some(err) = validate_metadata_size(req.metadata.as_ref()) {\n+        return Err(err);\n+    }\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-1\n+\n+    let authorized = authorize_request(&ctx, &emitter, &req).await?;\n+\n+    let mut builder = authorized\n+        .build_usage_record(req.metric, req.value)\n+        .with_timestamp(req.timestamp);\n+\n+    if let Some(key) = req.idempotency_key.filter(|k| !k.is_empty()) {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    builder.enqueue().await.map_err(emitter_error_to_problem)?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+fn validate_metadata_size(metadata: Option<&serde_json::Value>) -> Option<Problem> {\n+    let meta = metadata?;\n+    let byte_len = serde_json::to_vec(meta).map_or(0, |v| v.len());\n+    if byte_len > 8192 {\n+        tracing::warn!(\n+            byte_len,\n+            limit = 8192,\n+            \"Metadata byte length exceeds limit; rejecting record\"\n+        );\n+        return Some(Problem::new(\n+            StatusCode::UNPROCESSABLE_ENTITY,\n+            \"Metadata too large\",\n+            format!(\"metadata byte length {byte_len} exceeds limit of 8192\"),\n+        ));\n+    }\n+    None\n+}\n+\n+async fn authorize_request(\n+    ctx: &SecurityContext,\n+    emitter: &Arc<dyn UsageEmitterV1>,\n+    req: &CreateUsageRecordRequest,\n+) -> Result<usage_emitter::AuthorizedUsageEmitter, Problem> {\n+    match (&req.subject_id, &req.subject_type) {\n+        (None, None) => {\n+            // No subject — skip PDP authorization.\n+            tracing::debug!(\"No subject fields present; skipping PDP authorization\");","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved in the refactor — the misleading comment is gone and the code now makes it structurally obvious that PDP is always invoked.\r\n\r\n`modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs:63-82` (`authorize_request`) is now a single, unconditional path:\r\n\r\n```rust\r\nlet factory = runtime.factory(&req.module).with_tenant(req.tenant_id);\r\nlet factory = match req.subject.clone() {\r\n    Some(s) => factory.with_subject(s),\r\n    None    => factory.without_subject(),\r\n};\r\nfactory.authorize(ctx, req.resource_id, &req.resource_type).await\r\n```\r\n\r\nKey points:\r\n\r\n- `factory.authorize(...)` is called on every branch — there is no \"skip PDP\" path anymore. The subject choice only toggles whether `subject_id` / `subject_type` are included as resource properties in the PDP request, exactly as the original feedback requested.\r\n- The new comment above the `match` (lines 68–72) explicitly states that `None` is forwarded as the caller's explicit \"no subject\" intent — not a default-from-context fallback — and warns that substituting the gateway's own `SecurityContext` subject would silently misattribute the principal at the PDP boundary.\r\n- The three-state contract (`Explicit(Some)` / `Explicit(None)` / `DefaultFromCtx`) is documented on `SubjectChoice` in `usage-emitter/src/domain/factory.rs` and covered by tests in `factory_tests.rs` (`authorize_without_subject_omits_subject_properties_from_pdp_request`, `authorize_pdp_request_includes_subject_id_and_subject_type_resource_properties`, `authorize_default_subject_choice_falls_back_to_ctx_subject_in_pdp`).\r\n","created_at":"2026-05-15T12:48:50Z","updated_at":"2026-05-15T12:48:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248273327","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248273327"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248273327"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248273327/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":77,"side":"RIGHT","in_reply_to_id":3247933305,"author_association":"MEMBER","original_position":77,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248282445","pull_request_review_id":4298225186,"id":3248282445,"node_id":"PRRC_kwDOPaLyBs7BnNtN","diff_hunk":"@@ -0,0 +1,107 @@\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use modkit_db::outbox::{LeasedMessageHandler, MessageResult, OutboxMessage};\n+use tracing::{debug, error, info, warn};\n+use usage_collector_sdk::models::UsageRecord;\n+use usage_collector_sdk::{UsageCollectorClientV1, UsageCollectorError};\n+\n+/// Outbox delivery handler that forwards dequeued usage records to the usage collector,\n+/// calling [`UsageCollectorClientV1::create_usage_record`] once per message.\n+///\n+/// Implements [`LeasedMessageHandler`]:\n+/// - Deserialization failures dead-letter the message (permanent: corrupt payload).\n+/// - [`UsageCollectorError::PluginTimeout`], [`UsageCollectorError::CircuitOpen`], and\n+///   [`UsageCollectorError::Unavailable`] trigger retry (transient: timeout, open circuit,\n+///   connection/transport error, or identity service temporarily unreachable).\n+/// - All other collector errors dead-letter the message (permanent: auth denial,\n+///   module not configured, or unexpected condition).\n+pub struct DeliveryHandler {\n+    collector: Arc<dyn UsageCollectorClientV1>,\n+}\n+\n+impl DeliveryHandler {\n+    #[must_use]\n+    pub fn new(collector: Arc<dyn UsageCollectorClientV1>) -> Self {\n+        Self { collector }\n+    }\n+}\n+\n+#[async_trait]\n+impl LeasedMessageHandler for DeliveryHandler {\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1\n+    // @cpt-flow:cpt-cf-usage-collector-flow-sdk-and-ingest-core-emit:p1\n+    async fn handle(&self, msg: &OutboxMessage) -> MessageResult {\n+        // Processor may pass several messages per lease cycle (see WorkerTuning::batch_size);\n+        // this handler still delivers each payload individually.\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-1\n+        let record_result = serde_json::from_slice::<UsageRecord>(&msg.payload);\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-1\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2\n+        if let Err(ref err) = record_result {\n+            warn!(\n+                msg.seq,\n+                msg.partition_id,\n+                %err,\n+                \"usage record deserialization failed\"\n+            );\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2a\n+            return MessageResult::Reject(err.to_string());\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-outbox-delivery:p1:inst-dlv-2\n+\n+        // inst-dlv-3: gateway ingest request assembly from UsageRecord fields is performed\n+        // inside UsageCollectorClientV1::create_usage_record — see rest_client.rs\n+        // (UsageRecord IS the request at this layer; DTO assembly is an implementation detail\n+        //  of the REST client adapter).\n+        // SAFETY: the Err branch above always returns; this value is Ok.\n+        #[allow(clippy::unwrap_used)]\n+        let record = record_result.unwrap();","path":"modules/system/usage-collector/usage-emitter/src/infra/delivery_handler.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved in the current branch (`modules/system/usage-collector/usage-emitter/src/infra/delivery_handler.rs:52-66`).\r\n\r\nThe `if let Err(...) { return ...; } let record = record_result.unwrap();` block has been replaced with a direct `match` that binds in the `Ok` arm, exactly as suggested:\r\n\r\n```rust\r\nlet record = match serde_json::from_slice::<UsageRecord>(&msg.payload) {\r\n    Ok(r) => r,\r\n    Err(err) => {\r\n        warn!(\r\n            msg.seq,\r\n            msg.partition_id,\r\n            %err,\r\n            \"usage record deserialization failed\"\r\n        );\r\n        return MessageResult::Reject(format!(\"{:#}\", anyhow::Error::new(err)));\r\n    }\r\n};\r\n```\r\n\r\n- No `unwrap()` call remains.\r\n- `#[allow(clippy::unwrap_used)]` is gone.\r\n- The `// SAFETY:` comment justifying the unwrap is gone.\r\n\r\nVerified via `grep -nE \"unwrap|allow\\(clippy|SAFETY\"` on the file — no matches.\r\n","created_at":"2026-05-15T12:50:41Z","updated_at":"2026-05-15T12:50:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248282445","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248282445"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248282445"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248282445/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":62,"side":"RIGHT","in_reply_to_id":3247937591,"author_association":"MEMBER","original_position":62,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248292081","pull_request_review_id":4298236527,"id":3248292081,"node_id":"PRRC_kwDOPaLyBs7BnQDx","diff_hunk":"@@ -0,0 +1,457 @@\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use chrono::{DateTime, Utc};\n+use modkit_db::migration_runner::run_migrations_for_testing;\n+use modkit_db::outbox::{\n+    LeasedMessageHandler, MessageResult, Outbox, OutboxHandle, OutboxMessage, Partitions,\n+    outbox_migrations,\n+};\n+use modkit_db::{ConnectOpts, Db, connect_db};\n+use usage_collector_sdk::models::{AllowedMetric, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use crate::authorized_emitter::AuthorizedUsageEmitter;\n+use crate::config::UsageEmitterConfig;\n+use crate::error::UsageEmitterError;\n+\n+// ── Infrastructure ────────────────────────────────────────────────────────────\n+\n+struct NoopHandler;\n+\n+#[async_trait]\n+impl LeasedMessageHandler for NoopHandler {\n+    async fn handle(&self, _msg: &OutboxMessage) -> MessageResult {\n+        MessageResult::Ok\n+    }\n+}\n+\n+async fn build_db(name: &str) -> Db {\n+    let url = format!(\"sqlite:file:{name}?mode=memory&cache=shared\");\n+    let db = connect_db(\n+        &url,\n+        ConnectOpts {\n+            max_conns: Some(1),\n+            ..Default::default()\n+        },\n+    )\n+    .await\n+    .unwrap();\n+    run_migrations_for_testing(&db, outbox_migrations())\n+        .await\n+        .unwrap();\n+    db\n+}\n+\n+async fn build_outbox(db: Db) -> OutboxHandle {\n+    let cfg = UsageEmitterConfig::default();\n+    Outbox::builder(db)\n+        .queue(\n+            cfg.outbox_queue.as_str(),\n+            Partitions::of(cfg.outbox_partition_count),\n+        )\n+        .leased(NoopHandler)\n+        .start()\n+        .await\n+        .unwrap()\n+}\n+\n+// ── Test fixture ──────────────────────────────────────────────────────────────\n+\n+struct Fixture {\n+    db: Db,\n+    _handle: OutboxHandle,\n+    emitter: AuthorizedUsageEmitter,\n+    tenant_id: Uuid,\n+    resource_id: Uuid,\n+}\n+\n+impl Fixture {\n+    async fn build(name: &str) -> Self {\n+        let db = build_db(name).await;\n+        let handle = build_outbox(db.clone()).await;\n+        let tenant_id = Uuid::new_v4();\n+        let resource_id = Uuid::new_v4();\n+        let allowed_metrics = vec![\n+            AllowedMetric {\n+                name: \"test.gauge\".to_owned(),\n+                kind: UsageKind::Gauge,\n+            },\n+            AllowedMetric {\n+                name: \"test.counter\".to_owned(),\n+                kind: UsageKind::Counter,\n+            },\n+        ];\n+        let emitter = AuthorizedUsageEmitter::new(\n+            Arc::new(UsageEmitterConfig::default()),\n+            db.clone(),\n+            Arc::clone(handle.outbox()),\n+            \"test-module\".to_owned(),\n+            tenant_id,\n+            resource_id,\n+            \"test.resource\".to_owned(),\n+            allowed_metrics,\n+            Some(Uuid::nil()),\n+            Some(\"test.subject\".to_owned()),\n+        );\n+        Self {\n+            db,\n+            _handle: handle,\n+            emitter,\n+            tenant_id,\n+            resource_id,\n+        }\n+    }\n+\n+    fn conn(&self) -> modkit_db::DbConn<'_> {\n+        self.db.conn().unwrap()\n+    }\n+\n+    /// Build a valid `UsageRecord` that matches the authorized token fields.\n+    fn record(&self) -> UsageRecord {\n+        UsageRecord {\n+            tenant_id: self.tenant_id,\n+            module: \"test-module\".to_owned(),\n+            metric: \"test.gauge\".to_owned(),\n+            kind: UsageKind::Gauge,\n+            value: 1.0,\n+            resource_id: self.resource_id,\n+            resource_type: \"test.resource\".to_owned(),\n+            subject_id: Some(Uuid::nil()),\n+            subject_type: Some(\"test.subject\".to_owned()),\n+            idempotency_key: Uuid::new_v4().to_string(),\n+            timestamp: Utc::now(),\n+            metadata: None,\n+        }\n+    }\n+}\n+\n+// ── Metric kind resolution ────────────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn builder_enqueues_gauge_metric() {\n+    let f = Fixture::build(\"ub_gauge\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 42.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_enqueues_counter_metric_with_positive_value() {\n+    let f = Fixture::build(\"ub_counter_pos\").await;\n+    f.emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .with_idempotency_key(\"idem-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_counter_metric_with_negative_value() {\n+    let f = Fixture::build(\"ub_counter_neg\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", -1.0)\n+        .with_idempotency_key(\"idem-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(\n+        err,\n+        UsageEmitterError::NegativeCounterValue { value } if (value + 1.0).abs() < f64::EPSILON\n+    ));\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_counter_metric_without_idempotency_key() {\n+    let f = Fixture::build(\"ub_counter_no_idem\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(err, UsageEmitterError::InvalidRecord { .. }));\n+}\n+\n+#[tokio::test]\n+async fn builder_accepts_gauge_metric_with_negative_value() {\n+    let f = Fixture::build(\"ub_gauge_neg\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", -5.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_rejects_unknown_metric() {\n+    let f = Fixture::build(\"ub_unknown_metric\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"unknown.metric\", 1.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(\n+        matches!(err, UsageEmitterError::MetricNotAllowed { ref metric } if metric == \"unknown.metric\")\n+    );\n+}\n+\n+// ── Optional fields ───────────────────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn builder_with_idempotency_key_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_idem_key\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 1.0)\n+        .with_idempotency_key(\"my-stable-key\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_with_timestamp_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_timestamp\").await;\n+    let ts = DateTime::parse_from_rfc3339(\"2025-01-01T00:00:00Z\")\n+        .unwrap()\n+        .with_timezone(&Utc);\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 1.0)\n+        .with_timestamp(ts)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn builder_without_optional_fields_enqueues_successfully() {\n+    let f = Fixture::build(\"ub_defaults\").await;\n+    f.emitter\n+        .build_usage_record(\"test.gauge\", 0.0)\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap();\n+}\n+\n+// ── Blank idempotency key handling ────────────────────────────────────────────\n+\n+#[tokio::test]\n+async fn test_counter_with_blank_idempotency_key_is_rejected() {\n+    let f = Fixture::build(\"ub_counter_blank_idem\").await;\n+    let err = f\n+        .emitter\n+        .build_usage_record(\"test.counter\", 1.0)\n+        .with_idempotency_key(\"\")\n+        .enqueue_in(&f.conn())\n+        .await\n+        .unwrap_err();\n+    assert!(matches!(err, UsageEmitterError::InvalidRecord { .. }));\n+}\n+\n+#[tokio::test]\n+async fn test_gauge_with_blank_idempotency_key_uses_uuid_fallback() {","path":"modules/system/usage-collector/usage-emitter/src/usage_builder_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved in the follow-up refactor. The aspirational UUID-fallback contract is now actually implemented, and the test name matches the assertion.\r\n\r\n**What changed**\r\n\r\n- The file `usage_builder_tests.rs` was renamed to `domain/usage_record_builder_tests.rs`. The misleading test was removed and replaced by `gauge_with_blank_idempotency_key_gets_uuid_at_enqueue` (`domain/usage_record_builder_tests.rs:416`).\r\n- The new test goes through the full enqueue path (real outbox + sqlite + capture handler), then asserts:\r\n  - `!record.idempotency_key.is_empty()` (`:505`)\r\n  - `Uuid::parse_str(&record.idempotency_key).is_ok()` (`:509`)\r\n- The production contract from the doc comment is now implemented in the emitter, not the builder, which is the right boundary (build-time records can still be blank; enqueue fills in the UUID):\r\n  - `domain/emitter.rs:81` — `Self::generate_gauge_idempotency_key(&mut record);` called from `enqueue_in`\r\n  - `domain/emitter.rs:276-280` — generates `Uuid::new_v4().to_string()` when `kind == Gauge && idempotency_key.trim().is_empty()`\r\n  - `domain/emitter.rs:235-240` — counters with blank keys are rejected with `InvalidArgument`\r\n- The doc comment on `with_idempotency_key` (`domain/usage_record_builder.rs:110-115`) accurately states the contract: required for counters, generated at enqueue for blank gauges.\r\n- The remaining `is_empty()` assertion at `domain/usage_record_builder_tests.rs:132` is inside `build_succeeds_with_all_required_fields` — its name is honest, and it correctly verifies that `build()` itself does *not* fabricate a key (that is the emitter's job).\r\n","created_at":"2026-05-15T12:52:41Z","updated_at":"2026-05-15T12:52:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248292081","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248292081"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248292081"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248292081/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":257,"side":"RIGHT","in_reply_to_id":3247946812,"author_association":"MEMBER","original_position":257,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248331196","pull_request_review_id":4298283083,"id":3248331196,"node_id":"PRRC_kwDOPaLyBs7BnZm8","diff_hunk":"@@ -0,0 +1,57 @@\n+use usage_collector_sdk::models::UsageKind;\n+\n+use super::*;\n+\n+// ── Display ───────────────────────────────────────────────────────\n+\n+#[test]\n+fn display_authorization_expired() {","path":"modules/system/usage-collector/usage-emitter/src/error_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Resolved.**\r\n\r\nThe entire `modules/system/usage-collector/usage-emitter/src/error_tests.rs` file (all seven `display_*` snapshot tests) has been deleted on this branch. `error.rs` no longer carries a `#[cfg(test)]` block, and `grep` for any of the removed test names across the crate returns nothing — so no equivalent assertions were re-introduced elsewhere.\r\n\r\nThe only remaining `err.to_string()` assertions in the crate are in `config_tests.rs`, which use `assert!(err.to_string().contains(\"<field>\"))` to verify the dynamic field name surfaces in the message — i.e. exactly the \"assert the message includes the dynamic field\" pattern you suggested as the acceptable alternative, not full-string snapshots of thiserror output.\r\n","created_at":"2026-05-15T12:59:35Z","updated_at":"2026-05-15T12:59:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248331196","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248331196"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248331196"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248331196/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":8,"side":"RIGHT","in_reply_to_id":3247950456,"author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248376122","pull_request_review_id":4298333936,"id":3248376122,"node_id":"PRRC_kwDOPaLyBs7Bnkk6","diff_hunk":"@@ -0,0 +1,111 @@\n+use std::time::Duration;\n+\n+use super::UsageEmitterConfig;\n+\n+#[test]\n+fn default_authorization_max_age_is_30_seconds() {\n+    let cfg = UsageEmitterConfig::default();","path":"modules/system/usage-collector/usage-emitter/src/config_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved.\r\n\r\nAll four constructor-echo tests have been deleted from `modules/system/usage-collector/usage-emitter/src/config_tests.rs`:\r\n\r\n- `default_authorization_max_age_is_30_seconds`\r\n- `default_outbox_queue_is_usage_records`\r\n- `default_outbox_partition_count_is_4`\r\n- `default_outbox_backoff_max_is_10_minutes`\r\n\r\nThe file now contains only `validate_*` tests that exercise the meaningful contracts (validation bounds for `outbox_queue`, `outbox_partition_count`, `authorization_max_age`, `outbox_backoff_max`, and `authorize_call_timeout`), plus `validate_accepts_defaults` which asserts the behavioral invariant \"defaults must pass validation\" rather than echoing specific constants. Changing any default to another reasonable value no longer breaks the test suite.\r\n","created_at":"2026-05-15T13:08:15Z","updated_at":"2026-05-15T13:08:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248376122","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248376122"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248376122"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248376122/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":7,"side":"RIGHT","in_reply_to_id":3247953687,"author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248386514","pull_request_review_id":4298346601,"id":3248386514,"node_id":"PRRC_kwDOPaLyBs7BnnHS","diff_hunk":"@@ -0,0 +1,42 @@\n+use chrono::Utc;\n+use usage_collector_sdk::{UsageCollectorPluginClientV1, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use super::Service;\n+\n+fn make_record(tenant_id: Uuid) -> UsageRecord {\n+    UsageRecord {\n+        module: \"test-module\".to_owned(),\n+        tenant_id,\n+        metric: \"test.metric\".to_owned(),\n+        kind: UsageKind::Gauge,\n+        value: 1.0,\n+        resource_id: Uuid::new_v4(),\n+        resource_type: \"test.resource\".to_owned(),\n+        subject_id: Some(Uuid::nil()),\n+        subject_type: Some(\"test.subject\".to_owned()),\n+        idempotency_key: Uuid::new_v4().to_string(),\n+        timestamp: Utc::now(),\n+        metadata: None,\n+    }\n+}\n+\n+#[tokio::test]\n+async fn create_usage_record_always_returns_ok() {\n+    let service = Service::new();\n+    let plugin: &dyn UsageCollectorPluginClientV1 = &service;\n+    let rec = make_record(Uuid::new_v4());\n+    let result = plugin.create_usage_record(rec).await;\n+    assert!(result.is_ok());\n+}\n+\n+#[tokio::test]\n+async fn create_usage_record_multiple_records_all_return_ok() {","path":"modules/system/usage-collector/plugins/noop-usage-collector-storage-plugin/src/domain/client_tests.rs","commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","original_commit_id":"daf145240faf665d6c41a9551bce934e8ce36f24","user":{"login":"capybutler","id":261428887,"node_id":"U_kgDOD5UWlw","avatar_url":"https://avatars.githubusercontent.com/u/261428887?v=4","gravatar_id":"","url":"https://api.github.com/users/capybutler","html_url":"https://github.com/capybutler","followers_url":"https://api.github.com/users/capybutler/followers","following_url":"https://api.github.com/users/capybutler/following{/other_user}","gists_url":"https://api.github.com/users/capybutler/gists{/gist_id}","starred_url":"https://api.github.com/users/capybutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capybutler/subscriptions","organizations_url":"https://api.github.com/users/capybutler/orgs","repos_url":"https://api.github.com/users/capybutler/repos","events_url":"https://api.github.com/users/capybutler/events{/privacy}","received_events_url":"https://api.github.com/users/capybutler/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Resolved.\r\n\r\n`create_usage_record_multiple_records_all_return_ok` has been deleted. `modules/system/usage-collector/plugins/noop-usage-collector-plugin/src/domain/client_tests.rs` now contains only `create_usage_record_always_returns_ok` — the loop variant that exercised the same stateless `Ok`-returning path is gone.\r\n","created_at":"2026-05-15T13:10:16Z","updated_at":"2026-05-15T13:10:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248386514","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248386514"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3248386514"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3248386514/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":34,"side":"RIGHT","in_reply_to_id":3248019593,"author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853273","pull_request_review_id":4323466629,"id":3269853273,"node_id":"PRRC_kwDOPaLyBs7C5gBZ","diff_hunk":"@@ -0,0 +1,181 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::Problem;\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::UsageCollectorError;\n+use usage_emitter::UsageEmitterRuntimeV1;\n+\n+use crate::domain::Service;\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+#[tracing::instrument(\n+    skip_all,\n+    fields(\n+        module = %req.module,\n+        tenant_id = %req.tenant_id,\n+        resource_id = %req.resource_id,\n+    ),\n+)]\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(runtime): Extension<Arc<dyn UsageEmitterRuntimeV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    let emitter = authorize_request(&ctx, &runtime, &req).await?;\n+\n+    let mut builder = emitter\n+        .usage_record_builder(req.metric, req.value)\n+        .map_err(|e| canonical_error_to_problem(&e))?\n+        .with_timestamp(req.timestamp);\n+\n+    // Normalize whitespace-only keys at the boundary so the builder always sees\n+    // `Some(non-empty)` or `None`. A raw whitespace key is treated as missing for gauges\n+    // (UUID generated at enqueue time) and surfaces as the canonical InvalidArgument for\n+    // counters at validation — consistent across both metric kinds.\n+    if let Some(key) = req\n+        .idempotency_key\n+        .map(|k| k.trim().to_owned())\n+        .filter(|k| !k.is_empty())\n+    {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    // `usage_record_builder` prefills every required field (module, tenant_id,\n+    // resource_id, resource_type, metric, kind, value); the optional setters above\n+    // only add fields, never clear required ones — so this `.build()` is currently\n+    // unreachable on the error branch. The prefill invariant is regression-tested\n+    // by `cyberware-usage-emitter`'s `usage_record_builder_prefills_authorized_fields_for_gauge`\n+    // and `usage_record_builder_resolves_counter_kind_from_allowed_metrics` (in\n+    // `usage_record_builder_tests.rs`), which assert that `.build()` succeeds after\n+    // the prefill alone. We still funnel any future `.build()` error through\n+    // `canonical_error_to_problem` so a legitimate failure path keeps the canonical\n+    // 4xx contract instead of panicking inside an axum handler.\n+    let record = builder\n+        .build()\n+        .map_err(|e| canonical_error_to_problem(&e))?;\n+    emitter\n+        .enqueue(record)\n+        .await\n+        .map_err(|e| canonical_error_to_problem(&e))?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+async fn authorize_request(\n+    ctx: &SecurityContext,\n+    runtime: &Arc<dyn UsageEmitterRuntimeV1>,\n+    req: &CreateUsageRecordRequest,\n+) -> Result<usage_emitter::UsageEmitter, Problem> {\n+    // Forward the caller's stated subject intent verbatim. `Some(s)` becomes\n+    // an explicit binding; `None` becomes the explicit \"no subject\" choice —\n+    // NOT the default-from-context fallback. Substituting the gateway's own\n+    // `SecurityContext` subject when the caller sent `None` would silently\n+    // attribute the request to the wrong principal at the PDP boundary.\n+    let factory = runtime.factory(&req.module).with_tenant(req.tenant_id);\n+    let factory = match req.subject.clone() {\n+        Some(s) => factory.with_subject(s),\n+        None => factory.without_subject(),\n+    };\n+    factory\n+        .authorize(ctx, req.resource_id, &req.resource_type)\n+        .await\n+        .map_err(|e| canonical_error_to_problem(&e))\n+}\n+\n+/// Handler for `GET /usage-collector/v1/modules/{module_name}/config`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] if the module is not found or the collector call fails.\n+// @cpt-flow:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2\n+#[tracing::instrument(skip_all, fields(module = %module_name))]\n+pub async fn handle_get_module_config(\n+    Path(module_name): Path<String>,\n+    Extension(service): Extension<Arc<Service>>,\n+) -> Result<Json<ModuleConfigResponse>, Problem> {\n+    // @cpt-begin:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-2\n+    // Authenticated request received; ModKit pipeline enforces authentication before handler entry.\n+    // @cpt-end:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-2\n+\n+    // @cpt-begin:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-3\n+    // Convert DomainError → UsageCollectorError via From, then funnel through the canonical\n+    // problem mapping so REST has a single source of truth for HTTP status / detail.\n+    let config = service\n+        .get_module_config(&module_name)\n+        .map_err(|e| canonical_error_to_problem(&UsageCollectorError::from(e)))?;\n+    // @cpt-end:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-3\n+\n+    // @cpt-begin:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-5\n+    let response = ModuleConfigResponse {\n+        allowed_metrics: config\n+            .allowed_metrics\n+            .into_iter()\n+            .map(|m| AllowedMetricResponse {\n+                name: m.name,\n+                kind: m.kind,\n+            })\n+            .collect(),\n+        max_metadata_bytes: config.max_metadata_bytes,\n+    };\n+\n+    Ok(Json(response))\n+    // @cpt-end:cpt-cf-usage-collector-flow-sdk-and-ingest-core-fetch-module-config:p2:inst-cfg-5\n+}\n+\n+fn canonical_error_to_problem(e: &UsageCollectorError) -> Problem {\n+    // Round-trip through the canonical Problem so its serialized per-category\n+    // context (reason / constraint / violations / resource_type / resource_name)\n+    // is preserved as an RFC 9457 extension member rather than dropped to a\n+    // title/detail pair. Built-in canonical contexts are plain structs and\n+    // shouldn't fail to serialize; if they ever do we fall back to a\n+    // context-less Problem so the request still returns the correct status.\n+    match modkit_canonical_errors::Problem::from_error(e) {\n+        Ok(canonical) => {\n+            let status =\n+                StatusCode::from_u16(canonical.status).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);\n+            Problem::new(status, canonical.title, canonical.detail)\n+                .with_type(canonical.problem_type)\n+                .with_context(canonical.context)\n+        }\n+        Err(err) => {\n+            // Reaching this branch means a built-in canonical context failed to serialize —\n+            // e.g. a new error variant carrying a non-`Serialize`-clean context. The client\n+            // still gets the correct status code, but the per-category context (reason /\n+            // constraint / violations) is silently dropped. Escalate to `error!` so log-based\n+            // alerting fires, and attach a stable `context_serialization_failed` extension on\n+            // the returned Problem so operators have a machine-distinguishable signal that\n+            // does not depend on log scraping.\n+            tracing::error!(\n+                error = %err,\n+                source_error = %e,\n+                \"canonical-to-problem conversion failed; falling back to context-less Problem\"\n+            );\n+            Problem::new(\n+                StatusCode::from_u16(e.status_code()).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR),\n+                e.title(),\n+                e.detail(),\n+            )\n+            .with_context(serde_json::json!({ \"context_serialization_failed\": true }))\n+        }\n+    }\n+}","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**HIGH**\n\n`canonical_error_to_problem` reinvents the canonical→`Problem` bridge and bypasses the documented migration prelude.\n\nThe standard pattern in the codebase (see `modules/file-parser/src/api/rest/error.rs:60`, `modules/system/types-registry/.../api/rest/error.rs:65`, `modules/system/nodes-registry/.../api/rest/error.rs:56`, `modules/simple-user-settings/.../api/rest/error.rs:52`) is:\n\n```rust\nuse modkit::api::canonical_prelude::*;  // Problem == modkit_canonical_errors::Problem, ApiResult == Result<T, Problem>\n\nimpl From<DomainError> for Problem {\n    fn from(err: DomainError) -> Self {\n        Problem::from(CanonicalError::from(err)).with_temporary_request_context(\"/\")\n    }\n}\n```\n\nHandlers then return `ApiResult<T>` and use `?` on `CanonicalError` / `DomainError` directly — no per-call `map_err(|e| canonical_error_to_problem(&e))?` boilerplate, and the result already carries `trace_id` / `instance` via `with_temporary_request_context`, which is what the canonical error middleware will key off when it lands (`libs/modkit/src/api/canonical_trace.rs:5-13`).\n\nThis file instead imports the legacy `modkit::api::problem::Problem`, hand-rolls the canonical→legacy field copy, and skips `with_temporary_request_context`, so:\n- every handler gets a 6-line `map_err(|e| canonical_error_to_problem(&e))?` wrapper repeated 4× in `handle_create_usage_record`\n- responses ship without `trace_id` / `instance` — operators lose request-correlation for every error path\n- when the canonical error middleware (`cpt-cf-errors-component-error-middleware`) lands, this module won't pick it up automatically; the bespoke helper has to be deleted by hand\n\nReplace `use modkit::api::problem::Problem` with `use modkit::api::canonical_prelude::*`, return `ApiResult<StatusCode>` from the handler, add `impl From<DomainError> for Problem` (the canonical one) using `Problem::from(CanonicalError::from(err)).with_temporary_request_context(\"/\")`, and drop `canonical_error_to_problem` plus the four `map_err` wrappers.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853273","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853273"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853273"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853273/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":176,"original_line":176,"side":"RIGHT","author_association":"MEMBER","original_position":176,"position":176,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853281","pull_request_review_id":4323466629,"id":3269853281,"node_id":"PRRC_kwDOPaLyBs7C5gBh","diff_hunk":"@@ -0,0 +1,64 @@\n+//! REST DTOs for the usage-collector gateway.\n+\n+use chrono::{DateTime, Utc};\n+use usage_collector_sdk::models::{Subject, UsageKind};\n+use uuid::Uuid;\n+\n+/// Request body to create one usage record (ingest).\n+#[derive(Debug, Clone)]\n+#[modkit_macros::api_dto(request)]\n+pub struct CreateUsageRecordRequest {\n+    /// Name of the module emitting this record.\n+    pub module: String,\n+    /// Tenant that owns the record.\n+    pub tenant_id: Uuid,\n+    /// Logical type of the metered resource.\n+    pub resource_type: String,\n+    /// Identifier of the metered resource instance.\n+    pub resource_id: Uuid,\n+    /// Subject (user or service) performing the request.\n+    /// `None` when no subject context is available; PDP subject validation is skipped in that case.","path":"modules/system/usage-collector/usage-collector/src/api/rest/dto.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\nDoc on `subject` says \"PDP subject validation is skipped in that case\", but the PDP is still invoked on the `None` branch — only the `SUBJECT_ID` / `SUBJECT_TYPE` resource properties are omitted from the request (see `handlers.rs:90-97` → `factory.without_subject().authorize(...)` → `factory.rs:188-193`).\n\nThis is the same misleading wording resolved in prior-review comment #3247933305 (where it lived on `handlers.rs:63`) — it migrated into the DTO docstring instead of being removed. Future readers (and generated OpenAPI consumers, since this DTO renders into the schema) will conclude that `subject: null` means \"no authorization at all\" rather than \"authorize without subject properties\".\n\nReplace with: `\\`None\\` means the request is authorized without \\`SUBJECT_ID\\` / \\`SUBJECT_TYPE\\` resource properties on the PDP request; tenant / resource / module checks still run.`","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853281","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853281"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853281"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853281/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":20,"original_line":20,"side":"RIGHT","author_association":"MEMBER","original_position":20,"position":20,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853285","pull_request_review_id":4323466629,"id":3269853285,"node_id":"PRRC_kwDOPaLyBs7C5gBl","diff_hunk":"@@ -0,0 +1,388 @@\n+use std::sync::Arc;\n+use std::time::Instant;\n+\n+use modkit_db::Db;\n+use modkit_db::outbox::Outbox;\n+use modkit_db::secure::DBRunner;\n+use tracing::{debug, error};\n+use usage_collector_sdk::error::UsageRecordError;\n+use usage_collector_sdk::models::{AllowedMetric, Subject, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use crate::config::UsageEmitterConfig;\n+use crate::domain::usage_record_builder::UsageRecordBuilder;\n+use crate::error::UsageEmitterError;\n+\n+/// Upper bound on free-form string fields inside a [`UsageRecord`] enqueued by\n+/// the emitter. Without this, a caller (REST gateway or in-process module) could\n+/// emit a multi-megabyte `module` / `metric` / `resource_type` / `idempotency_key` /\n+/// `subject.type` that would be serialized into the outbox payload, persisted, and\n+/// fanned out to every downstream consumer. 4 KiB is generous for legitimate\n+/// identifiers (UUIDs, dotted names) and small enough that nothing downstream is\n+/// asked to store a pathological value.\n+///\n+/// Enforced at the emitter rather than at the REST DTO boundary because the\n+/// emitter is the only common gate — in-process modules construct\n+/// [`UsageRecord`]s and call [`UsageEmitter::enqueue`]/[`enqueue_in`] without\n+/// going through the REST layer.\n+const MAX_RECORD_FIELD_LEN: usize = 4096;\n+\n+/// Emitter state after successful PDP authorization; call [`Self::enqueue`] or\n+/// [`Self::enqueue_in`] on the returned handle.\n+///\n+/// Constructed via [`crate::UsageEmitterFactory::authorize`]; callers cannot forge handles.\n+pub struct UsageEmitter {\n+    pub(crate) config: Arc<UsageEmitterConfig>,\n+    pub(crate) db: Db,\n+    pub(crate) outbox: Arc<Outbox>,\n+    pub(crate) module: String,\n+    pub(crate) tenant_id: Uuid,\n+    pub(crate) resource_id: Uuid,\n+    pub(crate) resource_type: String,\n+    pub(crate) allowed_metrics: Vec<AllowedMetric>,\n+    pub(crate) max_metadata_bytes: u32,\n+    pub(crate) subject: Option<Subject>,\n+    pub(crate) issued_at: Instant,\n+}\n+\n+impl UsageEmitter {\n+    /// Enqueue a usage record using this emitter's database connection.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] when obtaining a connection fails, the authorization handle\n+    /// expired, or the outbox enqueue fails.\n+    pub async fn enqueue(&self, record: UsageRecord) -> Result<(), UsageEmitterError> {\n+        // Outbox carve-out: `modkit_db::outbox::Outbox::enqueue` is framework-internal\n+        // transactional messaging that targets `modkit_outbox_incoming`/`_outbox`. Those tables\n+        // have no tenant or resource columns, so `AccessScope`/`SecureConn` filtering does not\n+        // apply; the outbox API takes any `DBRunner` directly. Using `db.conn()` here is\n+        // intentional and consistent with the modkit-db outbox contract.\n+        let conn = self.db.conn().map_err(|e| {\n+            UsageEmitterError::internal(format!(\"{:#}\", anyhow::Error::new(e))).create()","path":"modules/system/usage-collector/usage-emitter/src/domain/emitter.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`db.conn()` failure is mapped to `Internal`, but pool/connection acquisition failure is a transient infrastructure condition, not a code defect.\n\nThe consequence is the same retry-classification mismatch the rest of this PR is careful about: in `delivery_handler.rs:88-101`, `Internal` is dead-lettered (permanent) while `ServiceUnavailable` is retried. A pool-exhausted enqueue from an in-process source module surfaces to the caller as a 500 (RUST-ERR-001) and, when the caller is the gateway forwarding via REST, the outbox worker will dead-letter the resulting `Internal` instead of retrying — exactly the failure mode the canonical-variant alignment work in this PR is designed to prevent.\n\nReturn `UsageEmitterError::service_unavailable().with_detail(format!(\"db.conn() failed: {:#}\", anyhow::Error::new(e))).create()` so transient pool errors stay classified as transient throughout the pipeline.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853285","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853285"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853285"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":62,"original_line":62,"side":"RIGHT","author_association":"MEMBER","original_position":62,"position":62,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853288","pull_request_review_id":4323466629,"id":3269853288,"node_id":"PRRC_kwDOPaLyBs7C5gBo","diff_hunk":"@@ -0,0 +1,55 @@\n+//! Durable usage emission for source modules.\n+//!\n+//! Provides the complete emitter pipeline: module-scoped PDP authorization, transactional\n+//! outbox enqueue, and async delivery to the usage collector via `modkit-db` outbox workers.\n+//!\n+//! # Crate shape: single crate, not trait-SDK + impl\n+//!\n+//! Unlike other modules in the workspace, `usage-emitter` deliberately ships as a single\n+//! crate (trait + concrete types together) rather than a thin `*-sdk` crate. The trait\n+//! [`UsageEmitterRuntimeV1`] returns a concrete [`UsageEmitterFactory`], which produces a\n+//! concrete [`UsageEmitter`] and [`UsageRecordBuilder`]; these types carry private state\n+//! (`db`, `outbox`, `issued_at`, `allowed_metrics`) that the security invariant relies on,\n+//! so they cannot be reduced to opaque trait objects without losing the type-state\n+//! authorization handle. Every consumer therefore depends on the trait *and* the concrete\n+//! types simultaneously — splitting would not remove the impl-crate dependency. See the\n+//! crate `README.md` (\"Why there is no `usage-emitter-sdk` crate\") for the full rationale.\n+//!\n+//! # Usage\n+//!\n+//! Source modules should not construct [`UsageEmitterFactory`] directly. The `usage-collector`\n+//! or `usage-collector-rest-client` `ModKit` module builds and registers\n+//! `dyn UsageEmitterRuntimeV1` in `ClientHub` during `init()`.","path":"modules/system/usage-collector/usage-emitter/src/lib.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\nThis docstring (and the matching one in `usage-collector/src/lib.rs:21`, plus the gateway `README.md` cross-reference) enshrines a design where a separate ModKit module (`usage-collector-rest-client`) exists solely to register `dyn UsageCollectorClientV1` over HTTP.\n\nA standalone ModKit module per transport multiplies registration surface (one `init()` per transport, one set of config keys, one set of deps) for a type that the framework intentionally hides behind `dyn UsageCollectorClientV1`. Move the REST client implementation into `usage-collector-sdk` and let the existing host module (or a thin in-process wiring helper) pick local-vs-remote, mirroring the `wire_client` / `build_client` pattern in `09_oop_grpc_sdk_pattern.md`.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:59:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853288","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853288"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853288"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853288/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853291","pull_request_review_id":4323466629,"id":3269853291,"node_id":"PRRC_kwDOPaLyBs7C5gBr","diff_hunk":"@@ -0,0 +1,400 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use authz_resolver_sdk::constraints::{Constraint, InPredicate, Predicate};\n+use authz_resolver_sdk::models::{\n+    EvaluationRequest, EvaluationResponse, EvaluationResponseContext,\n+};\n+use authz_resolver_sdk::{AuthZResolverClient, AuthZResolverError, DenyReason};\n+use axum::routing::{get, post};\n+use axum::{Extension, Router};\n+use modkit::client_hub::{ClientHub, ClientScope};\n+use modkit_db::migration_runner::run_migrations_for_testing;\n+use modkit_db::outbox::outbox_migrations;\n+use modkit_db::{ConnectOpts, connect_db};\n+use modkit_security::SecurityContext;\n+use modkit_security::access_scope::pep_properties;\n+use types_registry_sdk::testing::make_test_instance;\n+use types_registry_sdk::{\n+    GtsInstance, GtsTypeSchema, InstanceQuery, RegisterResult, TypeSchemaQuery,\n+    TypesRegistryClient, TypesRegistryError,\n+};\n+use usage_collector::api::rest::handlers::{handle_create_usage_record, handle_get_module_config};\n+use usage_collector::config::{MetricConfig, UsageCollectorConfig};\n+use usage_collector::domain::Service;\n+use usage_collector_sdk::{\n+    AllowedMetric, ModuleConfig, UsageCollectorClientV1, UsageCollectorError,\n+    UsageCollectorPluginClientV1, UsageCollectorPluginSpecV1, UsageKind, UsageRecord,\n+};\n+use usage_emitter::{\n+    UsageEmitterConfig, UsageEmitterFactory, UsageEmitterRuntime, UsageEmitterRuntimeV1,\n+};\n+use uuid::Uuid;\n+\n+// ── AuthZ mocks ───────────────────────────────────────────────────────────────\n+\n+pub struct MockAuthZResolverClient {\n+    allow: bool,\n+    tenant_id: Uuid,\n+}\n+\n+impl MockAuthZResolverClient {\n+    pub fn allow(tenant_id: Uuid) -> Self {\n+        Self {\n+            allow: true,\n+            tenant_id,\n+        }\n+    }\n+\n+    #[allow(dead_code)]\n+    pub fn deny() -> Self {\n+        Self {\n+            allow: false,\n+            tenant_id: Uuid::nil(),\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl AuthZResolverClient for MockAuthZResolverClient {\n+    async fn evaluate(\n+        &self,\n+        _request: EvaluationRequest,\n+    ) -> Result<EvaluationResponse, AuthZResolverError> {\n+        if self.allow {\n+            Ok(EvaluationResponse {\n+                decision: true,\n+                context: EvaluationResponseContext {\n+                    constraints: vec![Constraint {\n+                        predicates: vec![Predicate::In(InPredicate::new(\n+                            pep_properties::OWNER_TENANT_ID,\n+                            [self.tenant_id],\n+                        ))],\n+                    }],\n+                    ..EvaluationResponseContext::default()\n+                },\n+            })\n+        } else {\n+            Ok(EvaluationResponse {\n+                decision: false,\n+                context: EvaluationResponseContext {\n+                    deny_reason: Some(DenyReason {\n+                        error_code: \"POLICY_DENIED\".to_owned(),\n+                        details: None,\n+                    }),\n+                    ..EvaluationResponseContext::default()\n+                },\n+            })\n+        }\n+    }\n+}\n+\n+// ── Collector mocks (used by the embedded emitter only) ───────────────────────\n+\n+pub struct EmitterCollector {\n+    config: ModuleConfig,\n+}\n+\n+impl EmitterCollector {\n+    fn new() -> Self {\n+        Self::with_metrics(vec![AllowedMetric {\n+            name: \"test.gauge\".to_owned(),\n+            kind: UsageKind::Gauge,\n+        }])\n+    }\n+\n+    fn with_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        Self {\n+            config: ModuleConfig {\n+                allowed_metrics: metrics,\n+                max_metadata_bytes: 8192,\n+            },\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl UsageCollectorClientV1 for EmitterCollector {\n+    async fn create_usage_record(&self, _: UsageRecord) -> Result<(), UsageCollectorError> {\n+        Ok(())\n+    }\n+    async fn get_module_config(&self, _: &str) -> Result<ModuleConfig, UsageCollectorError> {\n+        Ok(self.config.clone())\n+    }\n+}\n+\n+// ── Plugin mock ───────────────────────────────────────────────────────────────\n+\n+pub struct MockUsageCollectorPluginClientV1;\n+\n+impl MockUsageCollectorPluginClientV1 {\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+#[async_trait]\n+impl UsageCollectorPluginClientV1 for MockUsageCollectorPluginClientV1 {\n+    async fn create_usage_record(&self, _: UsageRecord) -> Result<(), UsageCollectorError> {\n+        Ok(())\n+    }\n+}\n+\n+// ── Service builder ───────────────────────────────────────────────────────────\n+\n+struct StubRegistry {\n+    instances: Vec<GtsInstance>,\n+}\n+\n+#[async_trait]\n+impl TypesRegistryClient for StubRegistry {\n+    async fn register(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn register_type_schemas(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn get_type_schema(&self, _: &str) -> Result<GtsTypeSchema, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schema_by_uuid(&self, _: Uuid) -> Result<GtsTypeSchema, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schemas(\n+        &self,\n+        _: Vec<String>,\n+    ) -> HashMap<String, Result<GtsTypeSchema, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schemas_by_uuid(\n+        &self,\n+        _: Vec<Uuid>,\n+    ) -> HashMap<Uuid, Result<GtsTypeSchema, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn list_type_schemas(\n+        &self,\n+        _: TypeSchemaQuery,\n+    ) -> Result<Vec<GtsTypeSchema>, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn register_instances(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn get_instance(&self, _: &str) -> Result<GtsInstance, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_instance_by_uuid(&self, _: Uuid) -> Result<GtsInstance, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_instances(\n+        &self,\n+        _: Vec<String>,\n+    ) -> HashMap<String, Result<GtsInstance, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn get_instances_by_uuid(\n+        &self,\n+        _: Vec<Uuid>,\n+    ) -> HashMap<Uuid, Result<GtsInstance, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn list_instances(\n+        &self,\n+        _: InstanceQuery,\n+    ) -> Result<Vec<GtsInstance>, TypesRegistryError> {\n+        Ok(self.instances.clone())\n+    }\n+}\n+\n+fn plugin_content(gts_id: &str, vendor: &str) -> serde_json::Value {\n+    serde_json::json!({\n+        \"id\": gts_id,\n+        \"vendor\": vendor,\n+        \"priority\": 0,\n+        \"properties\": {},\n+    })\n+}\n+\n+#[allow(dead_code)]\n+pub fn build_service(\n+    plugin: Arc<dyn UsageCollectorPluginClientV1>,\n+    metrics: HashMap<String, MetricConfig>,\n+) -> Arc<Service> {\n+    let instance_id = format!(\n+        \"{}test.usage.mock.harness_test.v1\",\n+        UsageCollectorPluginSpecV1::gts_schema_id()\n+    );\n+    let hub = Arc::new(ClientHub::default());\n+    hub.register::<dyn TypesRegistryClient>(Arc::new(StubRegistry {\n+        instances: vec![make_test_instance(\n+            &instance_id,\n+            plugin_content(&instance_id, \"cyberfabric\"),\n+        )],\n+    }));\n+    hub.register_scoped::<dyn UsageCollectorPluginClientV1>(\n+        ClientScope::gts_id(&instance_id),\n+        plugin,\n+    );\n+    Arc::new(Service::new(\n+        UsageCollectorConfig {\n+            metrics,\n+            ..UsageCollectorConfig::default()\n+        },\n+        hub,\n+    ))\n+}\n+\n+// ── Emitter mock ──────────────────────────────────────────────────────────────\n+\n+/// Wraps a real [`UsageEmitterRuntime`] because [`usage_emitter::UsageEmitter::new`] is\n+/// `pub(crate)`. Implements [`UsageEmitterRuntimeV1`] by delegating `factory(...)` to the\n+/// wrapped runtime so callers exercise the real factory layer through the mock runtime.\n+pub struct MockUsageEmitterRuntimeV1(UsageEmitterRuntime);\n+\n+impl MockUsageEmitterRuntimeV1 {\n+    pub async fn with_allow_authz() -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        Self(build_real_runtime(authz, EmitterCollector::new()).await)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_deny_authz() -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> = Arc::new(MockAuthZResolverClient::deny());\n+        Self(build_real_runtime(authz, EmitterCollector::new()).await)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_allow_authz_and_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        Self(build_real_runtime(authz, EmitterCollector::with_metrics(metrics)).await)\n+    }\n+}\n+\n+impl UsageEmitterRuntimeV1 for MockUsageEmitterRuntimeV1 {\n+    fn factory(&self, module_name: &str) -> UsageEmitterFactory {\n+        self.0.factory(module_name)\n+    }\n+}\n+\n+async fn build_real_runtime(\n+    authz: Arc<dyn AuthZResolverClient>,\n+    emitter_collector: EmitterCollector,\n+) -> UsageEmitterRuntime {\n+    let db_name = format!(\"uc_gw_{}\", Uuid::new_v4().simple());\n+    let url = format!(\"sqlite:file:{db_name}?mode=memory&cache=shared\");\n+    let db = connect_db(\n+        &url,\n+        ConnectOpts {\n+            max_conns: Some(1),\n+            ..Default::default()\n+        },\n+    )\n+    .await\n+    .unwrap();\n+    run_migrations_for_testing(&db, outbox_migrations())\n+        .await\n+        .unwrap();\n+    let collector: Arc<dyn UsageCollectorClientV1> = Arc::new(emitter_collector);\n+    UsageEmitterRuntime::build(UsageEmitterConfig::default(), db, authz, collector)\n+        .await\n+        .unwrap()\n+}\n+\n+// ── AppHarness ────────────────────────────────────────────────────────────────\n+\n+pub struct AppHarness {\n+    pub router: Router,\n+}\n+\n+impl AppHarness {\n+    #[allow(dead_code)]\n+    pub async fn new() -> Self {\n+        let runtime = Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz().await)\n+            as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub fn with_emitter(runtime: Arc<dyn UsageEmitterRuntimeV1>) -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_metrics(metrics: HashMap<String, MetricConfig>) -> Self {\n+        let runtime = Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz().await)\n+            as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, metrics);\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    /// Build a harness whose emitter resolves the given allowed-metrics list when callers\n+    /// authorize a module. Use this to exercise counter / gauge validation rules end-to-end\n+    /// from the HTTP boundary.\n+    #[allow(dead_code)]\n+    pub async fn with_emitter_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        let runtime =\n+            Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz_and_metrics(metrics).await)\n+                as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    fn build(\n+        runtime: Arc<dyn UsageEmitterRuntimeV1>,\n+        service: Arc<Service>,\n+        authz: Arc<dyn AuthZResolverClient>,\n+    ) -> Self {\n+        let ctx = SecurityContext::builder()\n+            .subject_id(Uuid::new_v4())\n+            .subject_tenant_id(Uuid::new_v4())\n+            .build()\n+            .unwrap();\n+        let router = Router::new()\n+            .route(\n+                \"/usage-collector/v1/records\",\n+                post(handle_create_usage_record),\n+            )\n+            .route(\n+                \"/usage-collector/v1/modules/{module_name}/config\",\n+                get(handle_get_module_config),\n+            )\n+            .layer(Extension(runtime))","path":"modules/system/usage-collector/usage-collector/tests/common/mod.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**LOW**\n\n`AppHarness::build` mounts handlers via raw `Router::new().route(...).layer(Extension(...))` instead of calling `crate::api::rest::routes::register_routes`. That bypasses every effect of `OperationBuilder.register(...)`:\n- response-shape registration (`.no_content_response` vs `.json_response` for 204 — the exact bug Mike flagged in prior comment #3247921402 would have passed silently through these tests),\n- `.allow_content_types([\"application/json\"])` enforcement,\n- `.require_license_features::<License>([])`,\n- `.authenticated()` middleware and `Extension<SecurityContext>` injection,\n- the OpenAPI registry receiving the routes.\n\nThese tests are labelled \"integration\" (`tests/create_record_tests.rs`) but only exercise handler bodies. Replace the manual `Router::new().route(...)` chain with `let openapi = …; let router = register_routes(Router::new(), &openapi, runtime, service);` and inject `Extension(SecurityContext)` via the existing layer so the production wiring is what's under test.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853291","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853291"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853291"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":394,"original_line":394,"side":"RIGHT","author_association":"MEMBER","original_position":394,"position":394,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853292","pull_request_review_id":4323466629,"id":3269853292,"node_id":"PRRC_kwDOPaLyBs7C5gBs","diff_hunk":"@@ -0,0 +1,400 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]\n+\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use authz_resolver_sdk::constraints::{Constraint, InPredicate, Predicate};\n+use authz_resolver_sdk::models::{\n+    EvaluationRequest, EvaluationResponse, EvaluationResponseContext,\n+};\n+use authz_resolver_sdk::{AuthZResolverClient, AuthZResolverError, DenyReason};\n+use axum::routing::{get, post};\n+use axum::{Extension, Router};\n+use modkit::client_hub::{ClientHub, ClientScope};\n+use modkit_db::migration_runner::run_migrations_for_testing;\n+use modkit_db::outbox::outbox_migrations;\n+use modkit_db::{ConnectOpts, connect_db};\n+use modkit_security::SecurityContext;\n+use modkit_security::access_scope::pep_properties;\n+use types_registry_sdk::testing::make_test_instance;\n+use types_registry_sdk::{\n+    GtsInstance, GtsTypeSchema, InstanceQuery, RegisterResult, TypeSchemaQuery,\n+    TypesRegistryClient, TypesRegistryError,\n+};\n+use usage_collector::api::rest::handlers::{handle_create_usage_record, handle_get_module_config};\n+use usage_collector::config::{MetricConfig, UsageCollectorConfig};\n+use usage_collector::domain::Service;\n+use usage_collector_sdk::{\n+    AllowedMetric, ModuleConfig, UsageCollectorClientV1, UsageCollectorError,\n+    UsageCollectorPluginClientV1, UsageCollectorPluginSpecV1, UsageKind, UsageRecord,\n+};\n+use usage_emitter::{\n+    UsageEmitterConfig, UsageEmitterFactory, UsageEmitterRuntime, UsageEmitterRuntimeV1,\n+};\n+use uuid::Uuid;\n+\n+// ── AuthZ mocks ───────────────────────────────────────────────────────────────\n+\n+pub struct MockAuthZResolverClient {\n+    allow: bool,\n+    tenant_id: Uuid,\n+}\n+\n+impl MockAuthZResolverClient {\n+    pub fn allow(tenant_id: Uuid) -> Self {\n+        Self {\n+            allow: true,\n+            tenant_id,\n+        }\n+    }\n+\n+    #[allow(dead_code)]\n+    pub fn deny() -> Self {\n+        Self {\n+            allow: false,\n+            tenant_id: Uuid::nil(),\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl AuthZResolverClient for MockAuthZResolverClient {\n+    async fn evaluate(\n+        &self,\n+        _request: EvaluationRequest,\n+    ) -> Result<EvaluationResponse, AuthZResolverError> {\n+        if self.allow {\n+            Ok(EvaluationResponse {\n+                decision: true,\n+                context: EvaluationResponseContext {\n+                    constraints: vec![Constraint {\n+                        predicates: vec![Predicate::In(InPredicate::new(\n+                            pep_properties::OWNER_TENANT_ID,\n+                            [self.tenant_id],\n+                        ))],\n+                    }],\n+                    ..EvaluationResponseContext::default()\n+                },\n+            })\n+        } else {\n+            Ok(EvaluationResponse {\n+                decision: false,\n+                context: EvaluationResponseContext {\n+                    deny_reason: Some(DenyReason {\n+                        error_code: \"POLICY_DENIED\".to_owned(),\n+                        details: None,\n+                    }),\n+                    ..EvaluationResponseContext::default()\n+                },\n+            })\n+        }\n+    }\n+}\n+\n+// ── Collector mocks (used by the embedded emitter only) ───────────────────────\n+\n+pub struct EmitterCollector {\n+    config: ModuleConfig,\n+}\n+\n+impl EmitterCollector {\n+    fn new() -> Self {\n+        Self::with_metrics(vec![AllowedMetric {\n+            name: \"test.gauge\".to_owned(),\n+            kind: UsageKind::Gauge,\n+        }])\n+    }\n+\n+    fn with_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        Self {\n+            config: ModuleConfig {\n+                allowed_metrics: metrics,\n+                max_metadata_bytes: 8192,\n+            },\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl UsageCollectorClientV1 for EmitterCollector {\n+    async fn create_usage_record(&self, _: UsageRecord) -> Result<(), UsageCollectorError> {\n+        Ok(())\n+    }\n+    async fn get_module_config(&self, _: &str) -> Result<ModuleConfig, UsageCollectorError> {\n+        Ok(self.config.clone())\n+    }\n+}\n+\n+// ── Plugin mock ───────────────────────────────────────────────────────────────\n+\n+pub struct MockUsageCollectorPluginClientV1;\n+\n+impl MockUsageCollectorPluginClientV1 {\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+#[async_trait]\n+impl UsageCollectorPluginClientV1 for MockUsageCollectorPluginClientV1 {\n+    async fn create_usage_record(&self, _: UsageRecord) -> Result<(), UsageCollectorError> {\n+        Ok(())\n+    }\n+}\n+\n+// ── Service builder ───────────────────────────────────────────────────────────\n+\n+struct StubRegistry {\n+    instances: Vec<GtsInstance>,\n+}\n+\n+#[async_trait]\n+impl TypesRegistryClient for StubRegistry {\n+    async fn register(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn register_type_schemas(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn get_type_schema(&self, _: &str) -> Result<GtsTypeSchema, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schema_by_uuid(&self, _: Uuid) -> Result<GtsTypeSchema, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schemas(\n+        &self,\n+        _: Vec<String>,\n+    ) -> HashMap<String, Result<GtsTypeSchema, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn get_type_schemas_by_uuid(\n+        &self,\n+        _: Vec<Uuid>,\n+    ) -> HashMap<Uuid, Result<GtsTypeSchema, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn list_type_schemas(\n+        &self,\n+        _: TypeSchemaQuery,\n+    ) -> Result<Vec<GtsTypeSchema>, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn register_instances(\n+        &self,\n+        _: Vec<serde_json::Value>,\n+    ) -> Result<Vec<RegisterResult>, TypesRegistryError> {\n+        Ok(vec![])\n+    }\n+    async fn get_instance(&self, _: &str) -> Result<GtsInstance, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_instance_by_uuid(&self, _: Uuid) -> Result<GtsInstance, TypesRegistryError> {\n+        unimplemented!()\n+    }\n+    async fn get_instances(\n+        &self,\n+        _: Vec<String>,\n+    ) -> HashMap<String, Result<GtsInstance, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn get_instances_by_uuid(\n+        &self,\n+        _: Vec<Uuid>,\n+    ) -> HashMap<Uuid, Result<GtsInstance, TypesRegistryError>> {\n+        unimplemented!()\n+    }\n+    async fn list_instances(\n+        &self,\n+        _: InstanceQuery,\n+    ) -> Result<Vec<GtsInstance>, TypesRegistryError> {\n+        Ok(self.instances.clone())\n+    }\n+}\n+\n+fn plugin_content(gts_id: &str, vendor: &str) -> serde_json::Value {\n+    serde_json::json!({\n+        \"id\": gts_id,\n+        \"vendor\": vendor,\n+        \"priority\": 0,\n+        \"properties\": {},\n+    })\n+}\n+\n+#[allow(dead_code)]\n+pub fn build_service(\n+    plugin: Arc<dyn UsageCollectorPluginClientV1>,\n+    metrics: HashMap<String, MetricConfig>,\n+) -> Arc<Service> {\n+    let instance_id = format!(\n+        \"{}test.usage.mock.harness_test.v1\",\n+        UsageCollectorPluginSpecV1::gts_schema_id()\n+    );\n+    let hub = Arc::new(ClientHub::default());\n+    hub.register::<dyn TypesRegistryClient>(Arc::new(StubRegistry {\n+        instances: vec![make_test_instance(\n+            &instance_id,\n+            plugin_content(&instance_id, \"cyberfabric\"),\n+        )],\n+    }));\n+    hub.register_scoped::<dyn UsageCollectorPluginClientV1>(\n+        ClientScope::gts_id(&instance_id),\n+        plugin,\n+    );\n+    Arc::new(Service::new(\n+        UsageCollectorConfig {\n+            metrics,\n+            ..UsageCollectorConfig::default()\n+        },\n+        hub,\n+    ))\n+}\n+\n+// ── Emitter mock ──────────────────────────────────────────────────────────────\n+\n+/// Wraps a real [`UsageEmitterRuntime`] because [`usage_emitter::UsageEmitter::new`] is\n+/// `pub(crate)`. Implements [`UsageEmitterRuntimeV1`] by delegating `factory(...)` to the\n+/// wrapped runtime so callers exercise the real factory layer through the mock runtime.\n+pub struct MockUsageEmitterRuntimeV1(UsageEmitterRuntime);\n+\n+impl MockUsageEmitterRuntimeV1 {\n+    pub async fn with_allow_authz() -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        Self(build_real_runtime(authz, EmitterCollector::new()).await)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_deny_authz() -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> = Arc::new(MockAuthZResolverClient::deny());\n+        Self(build_real_runtime(authz, EmitterCollector::new()).await)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_allow_authz_and_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        Self(build_real_runtime(authz, EmitterCollector::with_metrics(metrics)).await)\n+    }\n+}\n+\n+impl UsageEmitterRuntimeV1 for MockUsageEmitterRuntimeV1 {\n+    fn factory(&self, module_name: &str) -> UsageEmitterFactory {\n+        self.0.factory(module_name)\n+    }\n+}\n+\n+async fn build_real_runtime(\n+    authz: Arc<dyn AuthZResolverClient>,\n+    emitter_collector: EmitterCollector,\n+) -> UsageEmitterRuntime {\n+    let db_name = format!(\"uc_gw_{}\", Uuid::new_v4().simple());\n+    let url = format!(\"sqlite:file:{db_name}?mode=memory&cache=shared\");\n+    let db = connect_db(\n+        &url,\n+        ConnectOpts {\n+            max_conns: Some(1),\n+            ..Default::default()\n+        },\n+    )\n+    .await\n+    .unwrap();\n+    run_migrations_for_testing(&db, outbox_migrations())\n+        .await\n+        .unwrap();\n+    let collector: Arc<dyn UsageCollectorClientV1> = Arc::new(emitter_collector);\n+    UsageEmitterRuntime::build(UsageEmitterConfig::default(), db, authz, collector)\n+        .await\n+        .unwrap()\n+}\n+\n+// ── AppHarness ────────────────────────────────────────────────────────────────\n+\n+pub struct AppHarness {\n+    pub router: Router,\n+}\n+\n+impl AppHarness {\n+    #[allow(dead_code)]\n+    pub async fn new() -> Self {\n+        let runtime = Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz().await)\n+            as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub fn with_emitter(runtime: Arc<dyn UsageEmitterRuntimeV1>) -> Self {\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    #[allow(dead_code)]\n+    pub async fn with_metrics(metrics: HashMap<String, MetricConfig>) -> Self {\n+        let runtime = Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz().await)\n+            as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, metrics);\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    /// Build a harness whose emitter resolves the given allowed-metrics list when callers\n+    /// authorize a module. Use this to exercise counter / gauge validation rules end-to-end\n+    /// from the HTTP boundary.\n+    #[allow(dead_code)]\n+    pub async fn with_emitter_metrics(metrics: Vec<AllowedMetric>) -> Self {\n+        let runtime =\n+            Arc::new(MockUsageEmitterRuntimeV1::with_allow_authz_and_metrics(metrics).await)\n+                as Arc<dyn UsageEmitterRuntimeV1>;\n+        let authz: Arc<dyn AuthZResolverClient> =\n+            Arc::new(MockAuthZResolverClient::allow(Uuid::new_v4()));\n+        let plugin: Arc<dyn UsageCollectorPluginClientV1> =\n+            Arc::new(MockUsageCollectorPluginClientV1::new());\n+        let service = build_service(plugin, HashMap::new());\n+        Self::build(runtime, service, authz)\n+    }\n+\n+    fn build(\n+        runtime: Arc<dyn UsageEmitterRuntimeV1>,\n+        service: Arc<Service>,\n+        authz: Arc<dyn AuthZResolverClient>,\n+    ) -> Self {\n+        let ctx = SecurityContext::builder()\n+            .subject_id(Uuid::new_v4())\n+            .subject_tenant_id(Uuid::new_v4())\n+            .build()\n+            .unwrap();\n+        let router = Router::new()\n+            .route(\n+                \"/usage-collector/v1/records\",\n+                post(handle_create_usage_record),\n+            )\n+            .route(\n+                \"/usage-collector/v1/modules/{module_name}/config\",\n+                get(handle_get_module_config),\n+            )\n+            .layer(Extension(runtime))\n+            .layer(Extension(service))\n+            .layer(Extension(authz))","path":"modules/system/usage-collector/usage-collector/tests/common/mod.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**LOW**\n\n`.layer(Extension(authz))` adds an `Extension<Arc<dyn AuthZResolverClient>>` that no handler in this module extracts (PDP access goes through `runtime` → `UsageEmitterRuntime` → `PolicyEnforcer`, which holds its own `Arc<dyn AuthZResolverClient>` set in `UsageEmitterRuntime::build`).\n\nThe extension is dead weight, kept alive solely by the `AppHarness::build` signature taking `authz: Arc<dyn AuthZResolverClient>`. Drop the `authz` parameter and the `.layer(Extension(authz))` call, or extract it in `handle_create_usage_record` if it was supposed to be used.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853292","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853292"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853292"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853292/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":396,"original_line":396,"side":"RIGHT","author_association":"MEMBER","original_position":396,"position":396,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853295","pull_request_review_id":4323466629,"id":3269853295,"node_id":"PRRC_kwDOPaLyBs7C5gBv","diff_hunk":"@@ -0,0 +1,233 @@\n+use std::time::Duration;\n+\n+use usage_collector_sdk::UsageKind;\n+\n+use super::{CircuitBreakerConfig, UsageCollectorConfig};\n+\n+#[test]\n+fn test_validate_rejects_plugin_timeout_zero() {\n+    let cfg = UsageCollectorConfig {\n+        plugin_timeout: Duration::ZERO,\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"plugin_timeout\"),\n+        \"error must mention plugin_timeout, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_plugin_timeout_above_30s() {\n+    let cfg = UsageCollectorConfig {\n+        plugin_timeout: Duration::from_secs(31),\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"plugin_timeout\"),\n+        \"error must mention plugin_timeout, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_circuit_breaker_failure_threshold_zero() {\n+    let cfg = UsageCollectorConfig {\n+        circuit_breaker: CircuitBreakerConfig {\n+            failure_threshold: 0,\n+            ..CircuitBreakerConfig::default()\n+        },\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string()\n+            .contains(\"circuit_breaker.failure_threshold\"),\n+        \"error must mention circuit_breaker.failure_threshold, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_circuit_breaker_failure_threshold_above_100() {\n+    let cfg = UsageCollectorConfig {\n+        circuit_breaker: CircuitBreakerConfig {\n+            failure_threshold: 101,\n+            ..CircuitBreakerConfig::default()\n+        },\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string()\n+            .contains(\"circuit_breaker.failure_threshold\"),\n+        \"error must mention circuit_breaker.failure_threshold, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_plugin_timeout_below_100ms() {\n+    let cfg = UsageCollectorConfig {\n+        plugin_timeout: Duration::from_millis(50),\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"plugin_timeout\"),\n+        \"error must mention plugin_timeout, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_circuit_breaker_window_below_100ms() {\n+    let cfg = UsageCollectorConfig {\n+        circuit_breaker: CircuitBreakerConfig {\n+            window: Duration::ZERO,\n+            ..CircuitBreakerConfig::default()\n+        },\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"circuit_breaker.window\"),\n+        \"error must mention circuit_breaker.window, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_circuit_breaker_recovery_timeout_zero() {\n+    let cfg = UsageCollectorConfig {\n+        circuit_breaker: CircuitBreakerConfig {\n+            recovery_timeout: Duration::ZERO,\n+            ..CircuitBreakerConfig::default()\n+        },\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"circuit_breaker.recovery_timeout\"),\n+        \"error must mention circuit_breaker.recovery_timeout, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_rejects_circuit_breaker_recovery_timeout_above_5min() {\n+    let cfg = UsageCollectorConfig {\n+        circuit_breaker: CircuitBreakerConfig {\n+            recovery_timeout: Duration::from_secs(301),\n+            ..CircuitBreakerConfig::default()\n+        },\n+        ..UsageCollectorConfig::default()\n+    };\n+    let err = cfg.validate().unwrap_err();\n+    assert!(\n+        err.to_string().contains(\"circuit_breaker.recovery_timeout\"),\n+        \"error must mention circuit_breaker.recovery_timeout, got: {err}\"\n+    );\n+}\n+\n+#[test]\n+fn test_validate_accepts_defaults() {\n+    let cfg = UsageCollectorConfig::default();\n+    assert!(cfg.validate().is_ok());\n+}\n+\n+#[test]\n+fn vendor_can_be_overridden_via_serde() {\n+    let json = r#\"{\"vendor\": \"acme\"}\"#;\n+    let cfg: UsageCollectorConfig = serde_json::from_str(json).unwrap();\n+    assert_eq!(cfg.vendor, \"acme\");\n+}\n+\n+#[test]\n+fn serde_default_applies_default_vendor() {\n+    let cfg: UsageCollectorConfig = serde_json::from_str(\"{}\").unwrap();\n+    assert_eq!(\n+        cfg.vendor, \"cyberfabric\",\n+        \"serde(default) must use Default impl\"\n+    );\n+}","path":"modules/system/usage-collector/usage-collector/src/config_tests.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**LOW**\n\n`serde_default_applies_default_vendor` asserts `cfg.vendor == \"cyberfabric\"` (a literal copy of the value in `Default::default()` at `config.rs:119`). `serde_default_applies_default_plugin_timeout` does the same for `Duration::from_secs(5)`.\n\nThis is the constructor-echo anti-pattern Mike flagged in prior comment #3247953687 against `usage-emitter/src/config_tests.rs` (where four equivalent `default_*_is_X` tests were deleted in the follow-up refactor). The same family is alive here — changing either default to another reasonable value would break these without breaking any real contract.\n\nIf the intent is to pin the `#[serde(default)]` wiring (i.e. \"missing field inherits from `Default`\"), assert `cfg.vendor == UsageCollectorConfig::default().vendor` and `cfg.plugin_timeout == UsageCollectorConfig::default().plugin_timeout` instead — exactly the pattern used at `:196-201` for `max_metadata_bytes`. Otherwise delete both tests.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853295","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853295"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853295"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853295/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":148,"original_line":148,"side":"RIGHT","author_association":"MEMBER","original_position":148,"position":148,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853298","pull_request_review_id":4323466629,"id":3269853298,"node_id":"PRRC_kwDOPaLyBs7C5gBy","diff_hunk":"@@ -0,0 +1,65 @@\n+//! Error types for the usage emitter crate.\n+//!\n+//! [`UsageEmitterError`] is a type alias over [`CanonicalError`]: emitter operations report\n+//! failures using the canonical error taxonomy used elsewhere in the platform, so callers can\n+//! match on `CanonicalError::PermissionDenied`, `CanonicalError::Unauthenticated`, etc., without\n+//! a crate-specific error enum.\n+\n+use authz_resolver_sdk::{DenyReason, EnforcerError};\n+use modkit_canonical_errors::CanonicalError;\n+use tracing::{debug, error};\n+use usage_collector_sdk::error::UsageRecordError;\n+\n+/// Errors returned by the usage emitter pipeline.\n+///\n+/// Alias of [`CanonicalError`] — pattern-match on its variants directly.\n+pub type UsageEmitterError = CanonicalError;\n+\n+fn permission_denied(reason: &str) -> UsageEmitterError {\n+    UsageRecordError::permission_denied()\n+        .with_reason(reason)\n+        .create()\n+}\n+\n+fn map_denied(deny_reason: Option<DenyReason>) -> UsageEmitterError {\n+    let Some(d) = deny_reason else {\n+        return permission_denied(\"AUTHORIZATION_DENIED\");\n+    };\n+    debug!(\n+        pdp_error_code = %d.error_code,\n+        pdp_details = d.details.as_deref().unwrap_or(\"\"),\n+        \"PDP explicit deny\",\n+    );\n+    permission_denied(&d.error_code)\n+}\n+\n+/// Maps a PDP [`EnforcerError`] to a fail-closed [`UsageEmitterError`].\n+///\n+/// All enforcer outcomes (denial, compile failure, evaluation failure) map to\n+/// [`CanonicalError::PermissionDenied`] so that PDP infrastructure issues never\n+/// leak as availability problems to source modules. When the PDP attached a\n+/// [`DenyReason`], its `error_code` becomes the canonical `reason` (surfaced to\n+/// clients via Problem) and `details` are logged for diagnostics; otherwise the\n+/// reason falls back to `AUTHORIZATION_DENIED`.\n+#[allow(clippy::needless_pass_by_value)]\n+pub fn enforcer_error_to_emitter_error(e: EnforcerError) -> UsageEmitterError {\n+    match e {\n+        EnforcerError::Denied { deny_reason } => map_denied(deny_reason),\n+        EnforcerError::CompileFailed(source) => {\n+            error!(\n+                pdp_error_variant = \"CompileFailed\",\n+                error = %source,\n+                \"PDP constraint compilation failed; access denied (fail-closed)\",\n+            );\n+            permission_denied(\"AUTHORIZATION_DENIED\")\n+        }\n+        EnforcerError::EvaluationFailed(source) => {\n+            error!(\n+                pdp_error_variant = \"EvaluationFailed\",\n+                error = %source,\n+                \"PDP policy evaluation failed; access denied (fail-closed)\",\n+            );\n+            permission_denied(\"AUTHORIZATION_DENIED\")\n+        }\n+    }\n+}","path":"modules/system/usage-collector/usage-emitter/src/error.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**LOW**\n\n`enforcer_error_to_emitter_error` accepts the `EnforcerError` by value (`#[allow(clippy::needless_pass_by_value)]`) and the three arms collapse all PDP outcomes — including infra failures (`CompileFailed`, `EvaluationFailed`) — to `permission_denied(\"AUTHORIZATION_DENIED\")`. The original `DenyReason.error_code` is preserved via `map_denied`, but infra failures lose all variant identity at the canonical-error layer (only the structured `tracing::error!` carries it).\n\nThe fail-closed posture is justified in the comment, but `permission_denied(\"AUTHORIZATION_DENIED\")` for `EnforcerError::CompileFailed` means a misconfigured policy and a legitimate `Denied { deny_reason: None }` are indistinguishable at the API boundary *and* in the logs `reason` field. If an operator has to triage a spike of `AUTHORIZATION_DENIED` errors, they can't tell from the metric / Problem `reason` whether it's a policy outage or a real deny — they have to grep `pdp_error_variant` in `error!` traces.\n\nUse a stable distinct reason code (e.g. `\"PDP_INFRA_FAILURE\"` for the two non-`Denied` arms) so the canonical Problem's `reason` extension differentiates infra-failure from policy-deny. Status stays 403; only the `reason` string changes, keeping the fail-closed posture intact.","created_at":"2026-05-19T21:48:02Z","updated_at":"2026-05-19T21:48:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853298","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853298"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3269853298"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3269853298/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":65,"original_line":65,"side":"RIGHT","author_association":"MEMBER","original_position":65,"position":65,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425355","pull_request_review_id":4326651340,"id":3272425355,"node_id":"PRRC_kwDOPaLyBs7DDT-L","diff_hunk":"@@ -0,0 +1,130 @@\n+//! Usage-collector gateway `ModKit` module.\n+\n+use std::sync::{Arc, OnceLock};\n+\n+use async_trait::async_trait;\n+use authz_resolver_sdk::AuthZResolverClient;\n+use axum::Router;\n+use modkit::api::OpenApiRegistry;\n+use modkit::contracts::{DatabaseCapability, RestApiCapability};\n+use modkit::{Module, ModuleCtx};\n+use sea_orm_migration::MigrationTrait;\n+use tracing::info;\n+use types_registry_sdk::{RegisterResult, TypesRegistryClient};\n+use usage_collector_sdk::UsageCollectorPluginSpecV1;\n+use usage_emitter::{UsageEmitterRuntime, UsageEmitterRuntimeV1};\n+\n+use crate::api::rest::routes;\n+use crate::config::UsageCollectorConfig;\n+use crate::domain::{Service, UsageCollectorLocalClient};\n+\n+/// Usage collector gateway: registers plugin schema, resolves plugins via GTS,\n+/// exposes `dyn UsageCollectorClientV1` for outbox delivery, and wires REST endpoints\n+/// via `DatabaseCapability` and `RestApiCapability`.\n+#[modkit::module(\n+    name = \"usage-collector\",\n+    deps = [\"authz-resolver\", \"types-registry\"],\n+    capabilities = [db, rest],\n+)]\n+#[derive(Default)]\n+pub struct UsageCollectorModule {\n+    /// Gateway service stored during `init()` for use in `register_rest()`.\n+    service: OnceLock<Arc<Service>>,\n+}\n+\n+#[async_trait]\n+impl Module for UsageCollectorModule {\n+    #[tracing::instrument(skip_all, fields(vendor))]\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        let cfg: UsageCollectorConfig = ctx.config_or_default()?;\n+        cfg.validate()?;\n+        tracing::Span::current().record(\"vendor\", &cfg.vendor);\n+        info!(\n+            cfg.vendor,\n+            ?cfg.plugin_timeout,\n+            \"Loaded {} configuration\",\n+            Self::MODULE_NAME,\n+        );\n+\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryClient>()?;\n+        let schema_str = UsageCollectorPluginSpecV1::gts_schema_with_refs_as_string();\n+        let schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n+        let results = registry.register(vec![schema_json]).await?;\n+        RegisterResult::ensure_all_ok(&results)?;\n+        info!(\n+            schema_id = %UsageCollectorPluginSpecV1::gts_schema_id(),\n+            \"Registered {} plugin schema in types-registry\",\n+            Self::MODULE_NAME,\n+        );\n+\n+        let db = ctx\n+            .db_required()\n+            .map_err(|e| anyhow::anyhow!(\"{}: db not available: {e}\", Self::MODULE_NAME))?\n+            .db();\n+\n+        let authz = ctx\n+            .client_hub()\n+            .get::<dyn AuthZResolverClient>()\n+            .map_err(|e| {\n+                anyhow::anyhow!(\n+                    \"{}: AuthZResolverClient not registered: {e}\",\n+                    Self::MODULE_NAME\n+                )\n+            })?;\n+\n+        let service = Service::new(cfg.clone(), ctx.client_hub());\n+        let service = Arc::new(service);\n+        self.service\n+            .set(Arc::clone(&service))\n+            .map_err(|_| anyhow::anyhow!(\"{} module already initialized\", Self::MODULE_NAME))?;\n+\n+        let collector = UsageCollectorLocalClient::new(service);\n+        let collector = Arc::new(collector);\n+\n+        let runtime = UsageEmitterRuntime::build(cfg.emitter, db, authz, collector).await?;\n+        let runtime = Arc::new(runtime);\n+        ctx.client_hub()\n+            .register::<dyn UsageEmitterRuntimeV1>(runtime);\n+","path":"modules/system/usage-collector/usage-collector/src/module.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**CRITICAL**\n\n`UsageCollectorLocalClient` is constructed here but never registered in `ClientHub` as `dyn UsageCollectorClientV1`.\n\nAny module in the same binary that tries to resolve `dyn UsageCollectorClientV1` from the hub will get a runtime \"not found\" — despite the README advertising this as a supported in-process usage pattern.\n\nAdd `ctx.client_hub().register::<dyn UsageCollectorClientV1>(Arc::clone(&collector))` after `Arc::new(collector)` and before passing it into `UsageEmitterRuntime::build`.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:36:59Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272425355","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425355"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272425355"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425355/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":88,"original_line":88,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":88,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425659","pull_request_review_id":4326651340,"id":3272425659,"node_id":"PRRC_kwDOPaLyBs7DDUC7","diff_hunk":"@@ -0,0 +1,130 @@\n+//! Usage-collector gateway `ModKit` module.\n+\n+use std::sync::{Arc, OnceLock};\n+\n+use async_trait::async_trait;\n+use authz_resolver_sdk::AuthZResolverClient;\n+use axum::Router;\n+use modkit::api::OpenApiRegistry;\n+use modkit::contracts::{DatabaseCapability, RestApiCapability};\n+use modkit::{Module, ModuleCtx};\n+use sea_orm_migration::MigrationTrait;\n+use tracing::info;\n+use types_registry_sdk::{RegisterResult, TypesRegistryClient};\n+use usage_collector_sdk::UsageCollectorPluginSpecV1;\n+use usage_emitter::{UsageEmitterRuntime, UsageEmitterRuntimeV1};\n+\n+use crate::api::rest::routes;\n+use crate::config::UsageCollectorConfig;\n+use crate::domain::{Service, UsageCollectorLocalClient};\n+\n+/// Usage collector gateway: registers plugin schema, resolves plugins via GTS,\n+/// exposes `dyn UsageCollectorClientV1` for outbox delivery, and wires REST endpoints\n+/// via `DatabaseCapability` and `RestApiCapability`.\n+#[modkit::module(\n+    name = \"usage-collector\",\n+    deps = [\"authz-resolver\", \"types-registry\"],\n+    capabilities = [db, rest],\n+)]\n+#[derive(Default)]\n+pub struct UsageCollectorModule {\n+    /// Gateway service stored during `init()` for use in `register_rest()`.\n+    service: OnceLock<Arc<Service>>,\n+}","path":"modules/system/usage-collector/usage-collector/src/module.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`OnceLock<Arc<Service>>` on the module struct is used to pass state from `init()` to `register_rest()` — that's non-idiomatic for ModKit and prevents clean re-initialization.\n\nThe canonical pattern is to register the service in `ClientHub` under an internal key during `init()` and retrieve it in `register_rest()` via `ctx.client_hub()`. The `OnceLock` also panics silently on a second `init()` call rather than producing a meaningful lifecycle error.\n\nRegister the service via the hub or a typed internal client, and drop the `OnceLock` field.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:02Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272425659","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425659"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272425659"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272425659/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":33,"original_line":33,"side":"RIGHT","author_association":"MEMBER","original_position":33,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426137","pull_request_review_id":4326651340,"id":3272426137,"node_id":"PRRC_kwDOPaLyBs7DDUKZ","diff_hunk":"@@ -0,0 +1,273 @@\n+use std::sync::Arc;\n+use std::time::Instant;\n+\n+use authz_resolver_sdk::AuthZResolverClient;\n+use authz_resolver_sdk::models::BarrierMode;\n+use authz_resolver_sdk::pep::{AccessRequest, PolicyEnforcer};\n+use modkit_db::Db;\n+use modkit_db::outbox::Outbox;\n+use modkit_security::{SecurityContext, pep_properties};\n+use tokio::time::timeout;\n+use tracing::warn;\n+use usage_collector_sdk::UsageCollectorClientV1;\n+use usage_collector_sdk::authz;\n+use usage_collector_sdk::error::UsageRecordError;\n+use usage_collector_sdk::models::Subject;\n+use uuid::Uuid;\n+\n+use crate::config::UsageEmitterConfig;\n+use crate::domain::emitter::UsageEmitter;\n+use crate::error::{UsageEmitterError, enforcer_error_to_emitter_error};\n+\n+/// Build a [`Subject`] from a [`SecurityContext`].\n+///\n+/// Free function (not a `From` impl) because Rust orphan rules (E0117) forbid\n+/// `impl From<&SecurityContext> for Subject` here — both types are foreign to\n+/// this crate. Colocated with the factory since it is the sole consumer.\n+fn subject_from_ctx(ctx: &SecurityContext) -> Subject {\n+    Subject {\n+        id: ctx.subject_id(),\n+        r#type: ctx.subject_type().map(str::to_owned),\n+    }\n+}\n+\n+/// Caller intent for the subject identity bound to the next `.authorize()` call.\n+///\n+/// Three legal states match the wire/PDP contract:\n+///\n+/// - `DefaultFromCtx` — neither `.with_subject(...)` nor `.without_subject()` was\n+///   called. The factory falls back to `SecurityContext`-derived subject at\n+///   `.authorize()` time. This is the default for in-process modules whose\n+///   caller identity *is* the subject.\n+/// - `Explicit(Some(s))` — caller passed an explicit subject via\n+///   `.with_subject(s)`. The PDP receives that exact subject; the gateway/\n+///   forwarder identity is never substituted.\n+/// - `Explicit(None)` — caller explicitly opted out via `.without_subject()`.\n+///   No `SUBJECT_ID`/`SUBJECT_TYPE` is sent to the PDP and the resulting\n+///   `UsageEmitter` has `subject = None`.\n+///\n+/// This three-state split is the only way to distinguish \"default from\n+/// context\" from \"explicit no subject\" — `Option<Subject>` collapses both\n+/// into the same `None`, which silently substitutes the gateway's own\n+/// `SecurityContext` subject and violates the forwarder-substitution\n+/// invariant.\n+#[derive(Clone, Debug, Default)]\n+pub enum SubjectChoice {\n+    /// Resolve from `SecurityContext` at `.authorize()` time.\n+    #[default]\n+    DefaultFromCtx,\n+    /// Caller-supplied: `Some(s)` = use exactly `s`; `None` = no subject at all.\n+    Explicit(Option<Subject>),\n+}\n+\n+/// Module-bound producer of [`UsageEmitter`] handles.\n+///\n+/// Obtained from [`crate::api::UsageEmitterRuntimeV1::factory`]. Each module stores one\n+/// factory bound to its `MODULE_NAME` at init and clones it per call to apply tenant /\n+/// subject overrides via the fluent `.with_*()` chain. The terminal `.authorize()` runs\n+/// PDP authorization and fetches allowed metrics, returning a post-authorize handle.\n+///\n+/// `module` is fixed at construction time and cannot be overridden, preserving the\n+/// compile-time invariant that a factory cannot emit under the wrong module.\n+#[derive(Clone)]\n+pub struct UsageEmitterFactory {\n+    // shared Arcs cloned from the runtime\n+    pub(crate) config: Arc<UsageEmitterConfig>,\n+    pub(crate) db: Db,\n+    pub(crate) authz: Arc<dyn AuthZResolverClient>,\n+    pub(crate) collector: Arc<dyn UsageCollectorClientV1>,\n+    pub(crate) outbox: Arc<Outbox>,\n+    // immutable scope (set at construction by runtime.factory(name))\n+    pub(crate) module: String,\n+    // overridable scope (resolved at .authorize() time)\n+    pub(crate) tenant: Option<Uuid>,\n+    pub(crate) subject: SubjectChoice,\n+}\n+\n+impl UsageEmitterFactory {\n+    /// Override the tenant for the next [`Self::authorize`] call.\n+    ///\n+    /// Without this, tenant defaults to `ctx.subject_tenant_id()`.\n+    #[must_use]\n+    pub fn with_tenant(mut self, t: Uuid) -> Self {\n+        self.tenant = Some(t);\n+        self\n+    }\n+\n+    /// Bind an explicit caller-supplied [`Subject`] for the next [`Self::authorize`] call.\n+    ///\n+    /// The PDP receives this exact subject; gateways / forwarders MUST use this\n+    /// method (not the ctx-default fallback) so their own service identity is\n+    /// never substituted for the original caller's.\n+    #[must_use]\n+    pub fn with_subject(mut self, subject: Subject) -> Self {\n+        self.subject = SubjectChoice::Explicit(Some(subject));\n+        self\n+    }\n+\n+    /// Explicitly emit without any subject identity for the next [`Self::authorize`] call.\n+    ///\n+    /// `SUBJECT_ID` / `SUBJECT_TYPE` are omitted from the PDP request and the\n+    /// resulting [`UsageEmitter`] has `subject = None`. Distinct from the\n+    /// default (neither `with_subject` nor `without_subject` called), which\n+    /// falls back to the `SecurityContext`-derived subject at authorize time.\n+    #[must_use]\n+    pub fn without_subject(mut self) -> Self {\n+        self.subject = SubjectChoice::Explicit(None);\n+        self\n+    }\n+\n+    /// Run PDP authorization and fetch allowed metrics, returning a time-limited\n+    /// [`UsageEmitter`] handle bound to the module name, tenant, metered\n+    /// resource, and subject identity.\n+    ///\n+    /// Tenant defaults to `ctx.subject_tenant_id()` when not overridden via\n+    /// [`Self::with_tenant`]. Subject is resolved per the table in\n+    /// `RESEARCH-emitter-runtime.md`.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] if PDP denies, the module is not configured, or the\n+    /// collector call fails.\n+    // @cpt-algo:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1\n+    #[tracing::instrument(\n+        skip_all,\n+        fields(\n+            module = %self.module,\n+            resource_id = %resource_id,\n+            resource_type = %resource_type,\n+        ),\n+    )]\n+    pub async fn authorize(\n+        &self,\n+        ctx: &SecurityContext,\n+        resource_id: Uuid,\n+        resource_type: &str,\n+    ) -> Result<UsageEmitter, UsageEmitterError> {\n+        // Resolve tenant: explicit override or default to ctx's home tenant.\n+        let tenant_id = self.tenant.unwrap_or_else(|| ctx.subject_tenant_id());\n+\n+        // Resolve subject per the three-state intent (see SubjectChoice docs).\n+        let subject = match &self.subject {\n+            SubjectChoice::Explicit(s) => s.clone(),\n+            SubjectChoice::DefaultFromCtx => Some(subject_from_ctx(ctx)),\n+        };\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-authorize-for:p1:inst-authz-2\n+        // PDP request shape — both opt-outs are deliberate and load-bearing:\n+        //\n+        // * `require_constraints(false)` — usage emission is authorize-once-per-call-site\n+        //   and re-validates module / tenant / resource / subject / allowed-metrics\n+        //   in-memory at every `UsageEmitter::enqueue_in` (see `emitter.rs` validators).\n+        //   The PDP's role here is the allow/deny decision; it does not return additional\n+        //   constraint expressions for the emitter to apply later. Asking for constraints\n+        //   we never consume would incur compilation cost on every emit for no policy\n+        //   benefit. (Contrast: the query path on the gateway *does* enforce returned\n+        //   constraints as filters — see DESIGN.md §\"Authorize each query\".)\n+        //\n+        // * `BarrierMode::Ignore` — the emitter is invoked by trusted source modules (and\n+        //   the gateway forwarder) emitting usage *for* a target tenant that may be a","path":"modules/system/usage-collector/usage-emitter/src/domain/factory.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**HIGH**\n\n`BarrierMode::Ignore` is applied to every PDP request unconditionally — there's no opt-in for `BarrierMode::Respect`.\n\nIf a source module incorrectly gains access to `dyn UsageEmitterRuntimeV1`, it gets implicit cross-barrier emit capability it was never supposed to have. The whole security model here rests on PDP policy alone, with no defense-in-depth at the framework layer.\n\nExpose `BarrierMode` as a config field on `UsageEmitterFactory` (defaulting to `Ignore` for platform modules), so the widened barrier is an explicit choice rather than an invisible invariant.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:06Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426137","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426137"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426137"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426137/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":169,"original_line":169,"side":"RIGHT","author_association":"MEMBER","original_position":169,"position":169,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426515","pull_request_review_id":4326651340,"id":3272426515,"node_id":"PRRC_kwDOPaLyBs7DDUQT","diff_hunk":"@@ -0,0 +1,28 @@\n+/// Source-facing trait for the process-lifetime usage-emitter runtime.\n+///\n+/// Obtain from `ClientHub`: `hub.get::<dyn UsageEmitterRuntimeV1>()?`\n+///\n+/// Registered in `ClientHub` by the host module (`usage-collector` for in-process\n+/// delivery, `usage-collector-rest-client` for HTTP delivery to a remote collector).\n+/// The runtime owns the outbox worker and shared Arcs for the entire process.\n+///\n+/// Call [`Self::factory`] with the module's name constant to obtain a\n+/// [`crate::domain::factory::UsageEmitterFactory`] bound to that module. Modules store\n+/// one factory per module and clone it per call to apply scope overrides via the fluent\n+/// `.with_*()` chain before invoking `.authorize()`.\n+///\n+/// # Crate shape note\n+///\n+/// This trait is intentionally published from the implementation crate\n+/// (`cyberware-usage-emitter`) rather than a thin `*-sdk` crate. The trait returns a\n+/// concrete [`crate::domain::factory::UsageEmitterFactory`], which in turn produces\n+/// concrete [`crate::domain::emitter::UsageEmitter`] /\n+/// [`crate::domain::usage_record_builder::UsageRecordBuilder`] handles carrying private\n+/// state that enforces the security invariant — those types cannot be reduced to opaque\n+/// trait objects. Consumers therefore always need the trait *and* the concrete types\n+/// together; splitting into trait-SDK + impl crates would not remove the impl-crate\n+/// dependency. See the crate-level `lib.rs` docs and `README.md` for the full rationale.\n+pub trait UsageEmitterRuntimeV1: Send + Sync {\n+    /// Obtain a [`UsageEmitterFactory`] bound to `module_name`.\n+    fn factory(&self, module_name: &str) -> crate::domain::factory::UsageEmitterFactory;\n+}","path":"modules/system/usage-collector/usage-emitter/src/api.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**HIGH**\n\n`UsageEmitterRuntimeV1::factory()` returns a concrete `UsageEmitterFactory`, not a trait object.\n\nAny crate that wants to mock `UsageEmitterRuntimeV1` in tests must hold a real `UsageEmitterRuntime` backed by in-memory SQLite — dragging `modkit-db` and `sea-orm-migration` into test dependencies of every consumer. In practice this makes the trait non-mockable in isolation.\n\nDefine a `UsageEmitterFactoryV1` trait and return `Box<dyn UsageEmitterFactoryV1>` (or an associated type). Test stubs can then provide a lightweight in-memory fake without touching the DB stack.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:09Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426515","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426515"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426515"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426515/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":28,"original_line":28,"side":"RIGHT","author_association":"MEMBER","original_position":28,"position":28,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426779","pull_request_review_id":4326651340,"id":3272426779,"node_id":"PRRC_kwDOPaLyBs7DDUUb","diff_hunk":"@@ -0,0 +1,388 @@\n+use std::sync::Arc;\n+use std::time::Instant;\n+\n+use modkit_db::Db;\n+use modkit_db::outbox::Outbox;\n+use modkit_db::secure::DBRunner;\n+use tracing::{debug, error};\n+use usage_collector_sdk::error::UsageRecordError;\n+use usage_collector_sdk::models::{AllowedMetric, Subject, UsageKind, UsageRecord};\n+use uuid::Uuid;\n+\n+use crate::config::UsageEmitterConfig;\n+use crate::domain::usage_record_builder::UsageRecordBuilder;\n+use crate::error::UsageEmitterError;\n+\n+/// Upper bound on free-form string fields inside a [`UsageRecord`] enqueued by\n+/// the emitter. Without this, a caller (REST gateway or in-process module) could\n+/// emit a multi-megabyte `module` / `metric` / `resource_type` / `idempotency_key` /\n+/// `subject.type` that would be serialized into the outbox payload, persisted, and\n+/// fanned out to every downstream consumer. 4 KiB is generous for legitimate\n+/// identifiers (UUIDs, dotted names) and small enough that nothing downstream is\n+/// asked to store a pathological value.\n+///\n+/// Enforced at the emitter rather than at the REST DTO boundary because the\n+/// emitter is the only common gate — in-process modules construct\n+/// [`UsageRecord`]s and call [`UsageEmitter::enqueue`]/[`enqueue_in`] without\n+/// going through the REST layer.\n+const MAX_RECORD_FIELD_LEN: usize = 4096;\n+\n+/// Emitter state after successful PDP authorization; call [`Self::enqueue`] or\n+/// [`Self::enqueue_in`] on the returned handle.\n+///\n+/// Constructed via [`crate::UsageEmitterFactory::authorize`]; callers cannot forge handles.\n+pub struct UsageEmitter {\n+    pub(crate) config: Arc<UsageEmitterConfig>,\n+    pub(crate) db: Db,\n+    pub(crate) outbox: Arc<Outbox>,\n+    pub(crate) module: String,\n+    pub(crate) tenant_id: Uuid,\n+    pub(crate) resource_id: Uuid,\n+    pub(crate) resource_type: String,\n+    pub(crate) allowed_metrics: Vec<AllowedMetric>,\n+    pub(crate) max_metadata_bytes: u32,\n+    pub(crate) subject: Option<Subject>,\n+    pub(crate) issued_at: Instant,\n+}\n+\n+impl UsageEmitter {\n+    /// Enqueue a usage record using this emitter's database connection.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] when obtaining a connection fails, the authorization handle\n+    /// expired, or the outbox enqueue fails.\n+    pub async fn enqueue(&self, record: UsageRecord) -> Result<(), UsageEmitterError> {\n+        // Outbox carve-out: `modkit_db::outbox::Outbox::enqueue` is framework-internal\n+        // transactional messaging that targets `modkit_outbox_incoming`/`_outbox`. Those tables\n+        // have no tenant or resource columns, so `AccessScope`/`SecureConn` filtering does not\n+        // apply; the outbox API takes any `DBRunner` directly. Using `db.conn()` here is\n+        // intentional and consistent with the modkit-db outbox contract.\n+        let conn = self.db.conn().map_err(|e| {\n+            UsageEmitterError::internal(format!(\"{:#}\", anyhow::Error::new(e))).create()\n+        })?;\n+        self.enqueue_in(&conn, record).await\n+    }\n+\n+    /// Enqueue a usage record on the given database runner (connection or transaction).\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns [`UsageEmitterError`] when the authorization handle expired, the record does not\n+    /// match the authorized tenant/resource, the metric is not allowed for this module, a counter\n+    /// record has a negative value, or the outbox enqueue fails.\n+    #[tracing::instrument(\n+        skip_all,\n+        fields(\n+            module = %self.module,\n+            tenant_id = %self.tenant_id,\n+            resource_id = %self.resource_id,\n+            resource_type = %self.resource_type,\n+            metric = %record.metric,\n+        ),\n+    )]\n+    pub async fn enqueue_in(\n+        &self,\n+        db: &(dyn DBRunner + Sync),\n+        mut record: UsageRecord,\n+    ) -> Result<(), UsageEmitterError> {\n+        Self::validate_field_lengths(&record)?;\n+        self.validate_authorization_freshness()?;\n+        self.validate_authorized_tenant(&record)?;\n+        self.validate_authorized_resource(&record)?;\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+        self.validate_authorized_module(&record)?;\n+        self.validate_authorized_subject(&record)?;\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-6\n+        self.validate_allowed_metric(&record)?;\n+        self.validate_metric_kind(&record)?;\n+        Self::validate_counter_value(&record)?;\n+        Self::validate_counter_idempotency_key(&record)?;\n+        self.validate_metadata_size(&record)?;\n+        // Generate a UUID idempotency key for gauge records when the caller\n+        // omitted (or blanked) one. Counter records keep an empty key here so\n+        // `validate_counter_idempotency_key` can reject them with the canonical\n+        // `InvalidArgument` error.\n+        Self::generate_gauge_idempotency_key(&mut record);\n+\n+        // Fold the full 128-bit tenant UUID down to 32 bits via XOR before\n+        // taking the partition modulo. Using only the leading byte is uniform\n+        // for v4 but clusters under v7 (time-prefixed), where IDs minted in\n+        // the same ms share leading bytes and would all land on the same\n+        // partition.\n+        let n = record.tenant_id.as_u128();\n+        #[allow(clippy::cast_possible_truncation)]\n+        let folded = (n as u32) ^ ((n >> 32) as u32) ^ ((n >> 64) as u32) ^ ((n >> 96) as u32);\n+        let partition = folded % u32::from(self.config.outbox_partition_count);\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-8\n+        let payload = serde_json::to_vec(&record).map_err(|e| {\n+            UsageEmitterError::internal(format!(\n+                \"payload serialization failed: {:#}\",\n+                anyhow::Error::new(e)\n+            ))\n+            .create()\n+        })?;\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-8\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-9\n+        self.outbox\n+            .enqueue(\n+                db,\n+                &self.config.outbox_queue,\n+                partition,\n+                payload,\n+                \"usage-collector.record.v1\",\n+            )\n+            .await\n+            .map_err(|e| {\n+                // The canonical `ServiceUnavailable` error has no `#[source]` slot, so\n+                // wrapping the outbox error in `Problem.detail` strips the original\n+                // `#[source]` chain (sqlx, sea-orm, etc.). Log the original error here\n+                // so operators retain the full chain for debugging.\n+                error!(error = ?e, \"outbox enqueue failed\");\n+                UsageEmitterError::service_unavailable()\n+                    .with_detail(format!(\"outbox error: {:#}\", anyhow::Error::new(e)))\n+                    .create()\n+            })?;\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-9\n+\n+        debug!(%self.tenant_id, \"usage record enqueued\");\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-10\n+        Ok(())\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-10\n+    }\n+\n+    fn validate_field_lengths(record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        fn check(name: &str, value: &str) -> Result<(), UsageEmitterError> {\n+            if value.len() > MAX_RECORD_FIELD_LEN {\n+                return Err(UsageRecordError::invalid_argument()\n+                    .with_constraint(format!(\n+                        \"{name} length {} exceeds the {MAX_RECORD_FIELD_LEN}-byte limit\",\n+                        value.len(),\n+                    ))\n+                    .create());\n+            }\n+            Ok(())\n+        }\n+        check(\"module\", &record.module)?;\n+        check(\"metric\", &record.metric)?;\n+        check(\"resource_type\", &record.resource_type)?;\n+        check(\"idempotency_key\", &record.idempotency_key)?;\n+        if let Some(s) = &record.subject\n+            && let Some(ty) = &s.r#type\n+        {\n+            check(\"subject.type\", ty)?;\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_authorization_freshness(&self) -> Result<(), UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-1\n+        let elapsed = self.issued_at.elapsed();\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-1\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-2\n+        if elapsed > self.config.authorization_max_age {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-2a\n+            return Err(UsageEmitterError::unauthenticated()\n+                .with_reason(\"emit authorization token has expired\")\n+                .create());\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-2a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-2\n+        Ok(())\n+    }\n+\n+    fn validate_authorized_tenant(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if record.tenant_id != self.tenant_id {\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(\"usage record tenant_id does not match authorized tenant\")\n+                .create());\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_authorized_resource(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if record.resource_id != self.resource_id {\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(\"usage record resource_id does not match authorized resource\")\n+                .create());\n+        }\n+\n+        if record.resource_type != self.resource_type {\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(\"usage record resource_type does not match authorized resource\")\n+                .create());\n+        }\n+\n+        Ok(())\n+    }\n+\n+    fn validate_authorized_module(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if record.module != self.module {\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(\"record module does not match authorized token\")\n+                .create());\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_authorized_subject(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if record.subject != self.subject {\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(\"record subject does not match authorized token\")\n+                .create());\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_allowed_metric(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-3\n+        let metric_allowed = self.allowed_metrics.iter().any(|m| m.name == record.metric);\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-3\n+\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-4\n+        if !metric_allowed {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-4a\n+            return Err(UsageRecordError::permission_denied()\n+                .with_reason(format!(\n+                    \"metric not allowed for this module: {}\",\n+                    record.metric\n+                ))\n+                .create());\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-4a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-4\n+        Ok(())\n+    }\n+\n+    fn validate_metric_kind(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if let Some(allowed) = self\n+            .allowed_metrics\n+            .iter()\n+            .find(|m| m.name == record.metric)\n+            && allowed.kind != record.kind\n+        {\n+            return Err(UsageRecordError::invalid_argument()\n+                .with_constraint(format!(\n+                    \"metric '{}' expects kind {:?} but record specifies {:?}\",\n+                    record.metric, allowed.kind, record.kind\n+                ))\n+                .create());\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_counter_value(record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        if !record.value.is_finite() {\n+            return Err(UsageRecordError::invalid_argument()\n+                .with_constraint(format!(\"value must be finite, got: {}\", record.value))\n+                .create());\n+        }\n+        if record.kind == UsageKind::Counter && record.value < 0.0 {\n+            return Err(UsageRecordError::invalid_argument()\n+                .with_constraint(format!(\n+                    \"counter value must be non-negative, got: {}\",\n+                    record.value\n+                ))\n+                .create());\n+        }\n+        Ok(())\n+    }\n+\n+    fn validate_counter_idempotency_key(record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5\n+        if record.kind == UsageKind::Counter && record.idempotency_key.trim().is_empty() {\n+            // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5a\n+            return Err(UsageRecordError::invalid_argument()\n+                .with_constraint(\"counter records require a non-empty idempotency_key\")\n+                .create());\n+            // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5a\n+        }\n+        // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-5\n+        Ok(())\n+    }\n+\n+    fn validate_metadata_size(&self, record: &UsageRecord) -> Result<(), UsageEmitterError> {\n+        // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-enqueue:p1:inst-enq-7\n+        if let Some(ref metadata) = record.metadata {\n+            let len = serde_json::to_vec(metadata)\n+                .map_err(|e| {","path":"modules/system/usage-collector/usage-emitter/src/domain/emitter.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**HIGH**\n\n`validate_metadata_size` serializes `metadata` to a `Vec<u8>` purely to measure `len()` — then the same value gets serialized again when building the outbox payload a few lines later.\n\nOn a high-frequency gauge path this is two allocations per call where one would do.\n\nSerialize once, capture the `Vec<u8>`, check `.len()` against the limit, then pass the pre-serialized bytes into the outbox rather than serializing again downstream.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:12Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426779","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426779"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272426779"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272426779/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":312,"original_line":312,"side":"RIGHT","author_association":"MEMBER","original_position":312,"position":312,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272427619","pull_request_review_id":4326651340,"id":3272427619,"node_id":"PRRC_kwDOPaLyBs7DDUhj","diff_hunk":"@@ -0,0 +1,130 @@\n+//! Usage-collector gateway `ModKit` module.\n+\n+use std::sync::{Arc, OnceLock};\n+\n+use async_trait::async_trait;\n+use authz_resolver_sdk::AuthZResolverClient;\n+use axum::Router;\n+use modkit::api::OpenApiRegistry;\n+use modkit::contracts::{DatabaseCapability, RestApiCapability};\n+use modkit::{Module, ModuleCtx};\n+use sea_orm_migration::MigrationTrait;\n+use tracing::info;\n+use types_registry_sdk::{RegisterResult, TypesRegistryClient};\n+use usage_collector_sdk::UsageCollectorPluginSpecV1;\n+use usage_emitter::{UsageEmitterRuntime, UsageEmitterRuntimeV1};\n+\n+use crate::api::rest::routes;\n+use crate::config::UsageCollectorConfig;\n+use crate::domain::{Service, UsageCollectorLocalClient};\n+\n+/// Usage collector gateway: registers plugin schema, resolves plugins via GTS,\n+/// exposes `dyn UsageCollectorClientV1` for outbox delivery, and wires REST endpoints\n+/// via `DatabaseCapability` and `RestApiCapability`.\n+#[modkit::module(\n+    name = \"usage-collector\",\n+    deps = [\"authz-resolver\", \"types-registry\"],\n+    capabilities = [db, rest],\n+)]\n+#[derive(Default)]\n+pub struct UsageCollectorModule {\n+    /// Gateway service stored during `init()` for use in `register_rest()`.\n+    service: OnceLock<Arc<Service>>,\n+}\n+\n+#[async_trait]\n+impl Module for UsageCollectorModule {\n+    #[tracing::instrument(skip_all, fields(vendor))]\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        let cfg: UsageCollectorConfig = ctx.config_or_default()?;\n+        cfg.validate()?;\n+        tracing::Span::current().record(\"vendor\", &cfg.vendor);\n+        info!(\n+            cfg.vendor,\n+            ?cfg.plugin_timeout,\n+            \"Loaded {} configuration\",\n+            Self::MODULE_NAME,\n+        );\n+\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryClient>()?;\n+        let schema_str = UsageCollectorPluginSpecV1::gts_schema_with_refs_as_string();\n+        let schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n+        let results = registry.register(vec![schema_json]).await?;\n+        RegisterResult::ensure_all_ok(&results)?;\n+        info!(\n+            schema_id = %UsageCollectorPluginSpecV1::gts_schema_id(),\n+            \"Registered {} plugin schema in types-registry\",\n+            Self::MODULE_NAME,\n+        );\n+\n+        let db = ctx\n+            .db_required()\n+            .map_err(|e| anyhow::anyhow!(\"{}: db not available: {e}\", Self::MODULE_NAME))?\n+            .db();\n+\n+        let authz = ctx\n+            .client_hub()\n+            .get::<dyn AuthZResolverClient>()\n+            .map_err(|e| {\n+                anyhow::anyhow!(\n+                    \"{}: AuthZResolverClient not registered: {e}\",\n+                    Self::MODULE_NAME\n+                )\n+            })?;\n+\n+        let service = Service::new(cfg.clone(), ctx.client_hub());\n+        let service = Arc::new(service);\n+        self.service\n+            .set(Arc::clone(&service))\n+            .map_err(|_| anyhow::anyhow!(\"{} module already initialized\", Self::MODULE_NAME))?;\n+\n+        let collector = UsageCollectorLocalClient::new(service);\n+        let collector = Arc::new(collector);\n+\n+        let runtime = UsageEmitterRuntime::build(cfg.emitter, db, authz, collector).await?;\n+        let runtime = Arc::new(runtime);\n+        ctx.client_hub()\n+            .register::<dyn UsageEmitterRuntimeV1>(runtime);\n+","path":"modules/system/usage-collector/usage-collector/src/module.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`UsageEmitterRuntimeV1` is a trait defined in the `cyberware-usage-emitter` impl crate, yet it's registered directly in `ClientHub` here.\n\nPer ModKit conventions, hub-registered types must live in an SDK crate so other modules can resolve them without depending on the full impl. Right now any consumer of this hub key has to add `cyberware-usage-emitter` to its deps — that's an impl-crate leak into the dependency graph.\n\nMove `UsageEmitterRuntimeV1` (and the upcoming `UsageEmitterFactoryV1`) into a `cyberware-usage-emitter-sdk` crate and register the hub key from there.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:21Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272427619","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272427619"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272427619"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272427619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":88,"original_line":88,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":88,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428103","pull_request_review_id":4326651340,"id":3272428103,"node_id":"PRRC_kwDOPaLyBs7DDUpH","diff_hunk":"@@ -0,0 +1,96 @@\n+//! Route registration for the usage-collector REST API.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+\n+use modkit::api::operation_builder::LicenseFeature;\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use usage_emitter::UsageEmitterRuntimeV1;\n+\n+use crate::domain::Service;\n+\n+use super::dto::{CreateUsageRecordRequest, ModuleConfigResponse};\n+use super::handlers;\n+\n+const API_TAG: &str = \"Usage Collector\";\n+\n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.cf.core.lic.feat.v1~cf.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for License {}\n+\n+/// Register all REST routes for the usage-collector module.\n+pub fn register_routes(\n+    router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    runtime: Arc<dyn UsageEmitterRuntimeV1>,\n+    service: Arc<Service>,\n+) -> Router {\n+    let router = OperationBuilder::post(\"/usage-collector/v1/records\")\n+        .operation_id(\"usage_collector.create_usage_record\")\n+        .summary(\"Create a usage record\")\n+        .description(\n+            \"Accepts a usage record payload and delegates storage to the configured storage plugin.\",\n+        )\n+        .tag(API_TAG)\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .json_request::<CreateUsageRecordRequest>(openapi, \"Usage record to create\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::handle_create_usage_record)\n+        .no_content_response(http::StatusCode::NO_CONTENT, \"Record accepted and stored\")\n+        // Validation errors (metadata > 8 KiB, missing/empty idempotency_key for counter,\n+        // non-finite value, negative counter value, metric-kind mismatch).\n+        .error_400(openapi)\n+        // Stale authorization handle (TTL expired between authorize and enqueue).\n+        .error_401(openapi)\n+        // PDP denial / tenant/resource/module/subject mismatch.\n+        .error_403(openapi)\n+        // Malformed payload (non-finite numeric literals, invalid nested subject shape, etc.).\n+        .error_422(openapi)\n+        // Rate limiting propagated from the storage plugin.\n+        .error_429(openapi)\n+        // Internal failures from the emitter or storage plugin.\n+        .error_500(openapi)\n+        // Outbox enqueue failure or transient transport error.\n+        .problem_response(\n+            openapi,\n+            http::StatusCode::SERVICE_UNAVAILABLE,\n+            \"Service Unavailable\",\n+        )\n+        // Plugin call timed out.\n+        .problem_response(openapi, http::StatusCode::GATEWAY_TIMEOUT, \"Gateway Timeout\")\n+        .register(router, openapi);\n+\n+    let router = OperationBuilder::get(\"/usage-collector/v1/modules/{module_name}/config\")\n+        .operation_id(\"usage_collector.get_module_config\")\n+        .summary(\"Get module configuration\")\n+        .description(\n+            \"Returns the allowed metrics (and future configuration) for the specified module.\",\n+        )\n+        .tag(API_TAG)\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .path_param(\"module_name\", \"Module name\")\n+        .handler(handlers::handle_get_module_config)\n+        .json_response_with_schema::<ModuleConfigResponse>(\n+            openapi,\n+            http::StatusCode::OK,\n+            \"Module configuration\",\n+        )\n+        // Missing or invalid bearer token (authenticated route).\n+        .error_401(openapi)\n+        // Unknown module name.\n+        .error_404(openapi)\n+        // Internal failures resolving plugin / fetching config.\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    router.layer(Extension(runtime)).layer(Extension(service))\n+}","path":"modules/system/usage-collector/usage-collector/src/api/rest/routes.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`Extension<Arc<dyn UsageEmitterRuntimeV1>>` and `Extension<Arc<Service>>` are layered on the outer router, not scoped to individual routes.\n\nWhen this router is later composed with other module routers at the server level, both extensions inject into every route in the combined set — including ones that don't need them — and can shadow identically-typed extensions from other modules.\n\nScope the `.layer(Extension(...))` calls to the specific routes that use them (via a nested sub-router or per-route layering) rather than the top-level router.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:26Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272428103","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428103"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272428103"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":96,"original_line":96,"side":"RIGHT","author_association":"MEMBER","original_position":96,"position":96,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428651","pull_request_review_id":4326651340,"id":3272428651,"node_id":"PRRC_kwDOPaLyBs7DDUxr","diff_hunk":"@@ -0,0 +1,181 @@\n+//! REST handlers for the usage-collector gateway.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::Path;\n+use axum::{Extension, Json};\n+use http::StatusCode;\n+use modkit::api::problem::Problem;\n+use modkit_security::SecurityContext;\n+use usage_collector_sdk::UsageCollectorError;\n+use usage_emitter::UsageEmitterRuntimeV1;\n+\n+use crate::domain::Service;\n+\n+use super::dto::{AllowedMetricResponse, CreateUsageRecordRequest, ModuleConfigResponse};\n+\n+/// Handler for `POST /usage-collector/v1/records`.\n+///\n+/// # Errors\n+/// Returns a [`Problem`] on authorization failure, validation errors, or internal emitter failure.\n+#[tracing::instrument(\n+    skip_all,\n+    fields(\n+        module = %req.module,\n+        tenant_id = %req.tenant_id,\n+        resource_id = %req.resource_id,\n+    ),\n+)]\n+pub async fn handle_create_usage_record(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(runtime): Extension<Arc<dyn UsageEmitterRuntimeV1>>,\n+    Json(req): Json<CreateUsageRecordRequest>,\n+) -> Result<StatusCode, Problem> {\n+    let emitter = authorize_request(&ctx, &runtime, &req).await?;\n+\n+    let mut builder = emitter\n+        .usage_record_builder(req.metric, req.value)\n+        .map_err(|e| canonical_error_to_problem(&e))?\n+        .with_timestamp(req.timestamp);\n+\n+    // Normalize whitespace-only keys at the boundary so the builder always sees\n+    // `Some(non-empty)` or `None`. A raw whitespace key is treated as missing for gauges\n+    // (UUID generated at enqueue time) and surfaces as the canonical InvalidArgument for\n+    // counters at validation — consistent across both metric kinds.\n+    if let Some(key) = req\n+        .idempotency_key\n+        .map(|k| k.trim().to_owned())\n+        .filter(|k| !k.is_empty())\n+    {\n+        builder = builder.with_idempotency_key(key);\n+    }\n+\n+    if let Some(meta) = req.metadata {\n+        builder = builder.with_metadata(meta);\n+    }\n+\n+    // `usage_record_builder` prefills every required field (module, tenant_id,\n+    // resource_id, resource_type, metric, kind, value); the optional setters above\n+    // only add fields, never clear required ones — so this `.build()` is currently\n+    // unreachable on the error branch. The prefill invariant is regression-tested\n+    // by `cyberware-usage-emitter`'s `usage_record_builder_prefills_authorized_fields_for_gauge`\n+    // and `usage_record_builder_resolves_counter_kind_from_allowed_metrics` (in\n+    // `usage_record_builder_tests.rs`), which assert that `.build()` succeeds after\n+    // the prefill alone. We still funnel any future `.build()` error through\n+    // `canonical_error_to_problem` so a legitimate failure path keeps the canonical\n+    // 4xx contract instead of panicking inside an axum handler.\n+    let record = builder\n+        .build()\n+        .map_err(|e| canonical_error_to_problem(&e))?;\n+    emitter\n+        .enqueue(record)\n+        .await\n+        .map_err(|e| canonical_error_to_problem(&e))?;\n+\n+    // @cpt-begin:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+    Ok(StatusCode::NO_CONTENT)\n+    // @cpt-end:cpt-cf-usage-collector-algo-sdk-and-ingest-core-gateway-ingest-handler:inst-gw-7\n+}\n+\n+async fn authorize_request(\n+    ctx: &SecurityContext,\n+    runtime: &Arc<dyn UsageEmitterRuntimeV1>,\n+    req: &CreateUsageRecordRequest,\n+) -> Result<usage_emitter::UsageEmitter, Problem> {\n+    // Forward the caller's stated subject intent verbatim. `Some(s)` becomes\n+    // an explicit binding; `None` becomes the explicit \"no subject\" choice —\n+    // NOT the default-from-context fallback. Substituting the gateway's own\n+    // `SecurityContext` subject when the caller sent `None` would silently\n+    // attribute the request to the wrong principal at the PDP boundary.\n+    let factory = runtime.factory(&req.module).with_tenant(req.tenant_id);\n+    let factory = match req.subject.clone() {\n+        Some(s) => factory.with_subject(s),","path":"modules/system/usage-collector/usage-collector/src/api/rest/handlers.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`req.subject.clone()` allocates on every ingest request — `req` is already owned here (moved out of `Json`), so the `Option<Subject>` can be moved directly.\n\nReplace `req.subject.clone()` with `req.subject`. Adjust any subsequent access to `req` fields that the move would break (or reorder the field reads so `subject` is consumed last).\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:31Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272428651","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428651"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272428651"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272428651/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":92,"original_line":92,"side":"RIGHT","author_association":"MEMBER","original_position":92,"position":92,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272429269","pull_request_review_id":4326651340,"id":3272429269,"node_id":"PRRC_kwDOPaLyBs7DDU7V","diff_hunk":"@@ -0,0 +1,224 @@\n+//! Sliding-window circuit breaker used by the usage-collector domain service.\n+//!\n+//! Wraps fallible async calls to the storage plugin so that repeated\n+//! infrastructure failures stop hammering an unhealthy backend, while\n+//! caller-induced errors do not trip the breaker.\n+//!\n+//! The single entry point is [`CircuitBreaker::execute`], which acquires a\n+//! permit, invokes the closure, classifies the result, and updates breaker\n+//! state atomically.\n+\n+#![deny(clippy::await_holding_lock)]\n+\n+use std::time::Instant;\n+\n+use parking_lot::Mutex;\n+use tracing::{info, warn};\n+use usage_collector_sdk::UsageCollectorError;\n+\n+use super::error::DomainError;\n+use crate::config::CircuitBreakerConfig;\n+\n+#[derive(Debug)]\n+enum State {\n+    Closed,\n+    Open { opened_at: Instant },\n+    HalfOpen,\n+}\n+\n+#[derive(Debug)]\n+struct Inner {\n+    config: CircuitBreakerConfig,\n+    state: State,\n+    failure_timestamps: Vec<Instant>,\n+}\n+\n+impl Inner {\n+    /// Atomically check whether the next call may proceed and (if so) update\n+    /// state for an in-flight probe.\n+    ///\n+    /// Returns `Ok(was_probe)` — `true` when the caller is the single\n+    /// `HalfOpen` probe, `false` for normal `Closed` traffic — or\n+    /// `Err(DomainError::CircuitOpen)` when the circuit is rejecting calls.\n+    fn try_acquire(&mut self) -> Result<bool, DomainError> {\n+        match &self.state {\n+            State::Closed => Ok(false),\n+            State::Open { opened_at } => {\n+                if opened_at.elapsed() >= self.config.recovery_timeout {\n+                    info!(\"Circuit breaker transitioning from Open to HalfOpen for probe\");\n+                    self.state = State::HalfOpen;\n+                    Ok(true)\n+                } else {\n+                    Err(DomainError::CircuitOpen)\n+                }\n+            }\n+            // A probe is already in flight; reject everyone else until it completes.\n+            State::HalfOpen => Err(DomainError::CircuitOpen),\n+        }\n+    }\n+\n+    fn record_failure(&mut self) {\n+        let now = Instant::now();\n+\n+        // A failure during the HalfOpen probe must re-open unconditionally:\n+        // the probe's job is to confirm health, and the threshold/window\n+        // bookkeeping does not apply (the window was cleared on entry to Open).\n+        if matches!(self.state, State::HalfOpen) {\n+            warn!(\"Circuit breaker re-opening after failed HalfOpen probe\");\n+            self.state = State::Open { opened_at: now };\n+            self.failure_timestamps.clear();\n+            return;\n+        }\n+\n+        self.failure_timestamps\n+            .retain(|t| now.duration_since(*t) < self.config.window);\n+        self.failure_timestamps.push(now);\n+\n+        let failures_in_window = self.failure_timestamps.len();\n+\n+        if failures_in_window >= self.config.failure_threshold as usize {\n+            match self.state {\n+                State::Closed => {\n+                    warn!(\n+                        failures_in_window,\n+                        threshold = self.config.failure_threshold,\n+                        \"Circuit breaker opening after too many failures within the rolling window\"\n+                    );\n+                    self.state = State::Open { opened_at: now };\n+                    self.failure_timestamps.clear();\n+                }\n+                // HalfOpen is handled above; Open already at opened_at — resetting\n+                // would prevent recovery under sustained load.\n+                State::Open { .. } | State::HalfOpen => {}\n+            }\n+        }\n+    }\n+\n+    fn record_success(&mut self) {\n+        match self.state {\n+            State::HalfOpen => {\n+                info!(\n+                    \"Circuit breaker transitioning from HalfOpen to Closed after successful probe\"\n+                );\n+                self.state = State::Closed;\n+                self.failure_timestamps.clear();\n+            }\n+            State::Closed => {\n+                self.failure_timestamps.clear();\n+            }\n+            State::Open { .. } => {\n+                warn!(\"Circuit breaker received success while Open; resetting to Closed\");\n+                self.state = State::Closed;\n+                self.failure_timestamps.clear();\n+            }\n+        }\n+    }\n+}\n+\n+/// Sliding-window circuit breaker.\n+///\n+/// Opens after `failure_threshold` failures within the rolling `window`,\n+/// stays open for `recovery_timeout`, then admits one probe call. Any\n+/// non-success during a probe re-opens the circuit; a successful probe\n+/// closes it.\n+pub struct CircuitBreaker {\n+    inner: Mutex<Inner>,\n+}\n+\n+impl CircuitBreaker {\n+    #[must_use]\n+    pub fn new(config: CircuitBreakerConfig) -> Self {\n+        Self {\n+            inner: Mutex::new(Inner {\n+                config,\n+                state: State::Closed,\n+                failure_timestamps: Vec::new(),\n+            }),\n+        }\n+    }\n+\n+    /// Run `f` under the breaker.\n+    ///\n+    /// Returns `DomainError::CircuitOpen` without invoking `f` if the circuit\n+    /// is rejecting calls. Otherwise executes `f` and records the outcome:\n+    /// infrastructure-shaped errors count as failures, caller-induced errors\n+    /// are ignored, and during a `HalfOpen` probe any non-success re-opens the\n+    /// circuit.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Propagates any `DomainError` returned by `f`, or `DomainError::CircuitOpen`\n+    /// when the circuit is open.\n+    pub async fn execute<F, Fut, T>(&self, f: F) -> Result<T, DomainError>\n+    where\n+        F: FnOnce() -> Fut,\n+        Fut: std::future::Future<Output = Result<T, DomainError>>,\n+    {\n+        // The lock guard returned by `self.inner.lock()` MUST be dropped before\n+        // the `.await` below — holding a `parking_lot::Mutex` guard across an\n+        // await point would block the executor thread on every contended call.\n+        // The temporary-drop rule on this single-expression `let` is load-bearing:\n+        // a refactor to `let mut g = self.inner.lock(); let was_probe = g.try_acquire()?; … f().await`\n+        // would silently violate it. The module-scoped `#[deny(clippy::await_holding_lock)]`\n+        // above is the static guard against that regression.\n+        let was_probe = self.inner.lock().try_acquire()?;\n+\n+        let result = f().await;\n+\n+        let mut inner = self.inner.lock();\n+        match &result {\n+            Ok(_) => inner.record_success(),\n+            Err(e) if is_health_failure(e) => inner.record_failure(),\n+            // HalfOpen is strict: any non-success during the probe re-opens.\n+            Err(_) if was_probe => inner.record_failure(),\n+            // Caller-induced error in Closed state — leave breaker untouched.\n+            Err(_) => {}\n+        }\n+\n+        result\n+    }\n+}\n+\n+/// Returns `true` when `err` indicates plugin/infrastructure ill-health and\n+/// must trip the circuit breaker. Caller-induced errors return `false`.\n+fn is_health_failure(err: &DomainError) -> bool {\n+    match err {\n+        DomainError::TypesRegistryUnavailable(_)\n+        | DomainError::ClientHub(_)\n+        | DomainError::PluginNotFound { .. }\n+        | DomainError::PluginUnavailable { .. }","path":"modules/system/usage-collector/usage-collector/src/domain/circuit_breaker.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**MEDIUM**\n\n`PluginNotFound` is classified as a health failure and trips the circuit breaker — but `PluginNotFound` means the configured vendor string matched no registered GTS instances. That's a configuration error, not a transient infrastructure fault.\n\nA misconfigured vendor will hold the circuit permanently open, masking any real availability signal from a correctly-registered plugin. It also makes it impossible to distinguish \"plugin is down\" from \"plugin was never registered.\"\n\nMap `PluginNotFound` to `false` alongside `InvalidPluginInstance` so only genuine transient failures (timeouts, connection errors) trigger the breaker.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:37:36Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272429269","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272429269"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272429269"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272429269/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":189,"original_line":189,"side":"RIGHT","author_association":"MEMBER","original_position":189,"position":189,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272432647","pull_request_review_id":4326651340,"id":3272432647,"node_id":"PRRC_kwDOPaLyBs7DDVwH","diff_hunk":"@@ -0,0 +1,73 @@\n+//! No-op usage-collector storage plugin module.\n+//!\n+//! Registers a GTS plugin instance in the types registry and exposes\n+//! [`usage_collector_sdk::UsageCollectorPluginClientV1`] under a scope keyed by that instance.\n+\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use modkit::Module;\n+use modkit::client_hub::ClientScope;\n+use modkit::context::ModuleCtx;\n+use modkit::gts::BaseModkitPluginV1;\n+use tracing::info;\n+use types_registry_sdk::{RegisterResult, TypesRegistryClient};\n+use usage_collector_sdk::{UsageCollectorPluginClientV1, UsageCollectorPluginSpecV1};\n+\n+use crate::config::NoopUsageCollectorConfig;\n+use crate::domain::Service;\n+\n+/// No-op usage-collector storage plugin for development and testing.\n+#[modkit::module(\n+    name = \"noop-usage-collector-plugin\",\n+    deps = [\"types-registry\", \"usage-collector\"]","path":"modules/system/usage-collector/plugins/noop-usage-collector-plugin/src/module.rs","commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","original_commit_id":"d5ec0407bd5d4470128a88cdce738af2d9f96973","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**CRITICAL**\n\n`deps = [\"types-registry\", \"usage-collector\"]` creates a circular initialization dependency.\n\n`usage-collector` can't finish `init()` until this plugin has registered its `dyn UsageCollectorPluginClientV1`, but ModKit requires `usage-collector` to be initialized before `noop-usage-collector-plugin` starts — deadlock.\n\nRemove `\"usage-collector\"` from `deps`. The plugin registers a client the gateway consumes; it must not declare the gateway as its own dependency.\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_","created_at":"2026-05-20T08:38:11Z","updated_at":"2026-05-20T08:38:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272432647","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272432647"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1908#discussion_r3272432647"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1908"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3272432647/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":23,"original_line":23,"side":"RIGHT","author_association":"MEMBER","original_position":23,"position":23,"subject_type":"line"}],"source_reviews":[{"id":4323388805,"node_id":"PRR_kwDOPaLyBs8AAAABAbGthQ","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?u=5b264340d8036555dd7d9c74c9e5dc246922cab9&v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followe
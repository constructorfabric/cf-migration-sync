ps://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Once the lint is compiled, this would have little effect.\nFor now the enforcement of the lints will be handled by the cyberfabric(cyberware CLI)\nCan we move it to the env to have more control over the dynamic exclusions?","created_at":"2026-05-21T14:12:40Z","updated_at":"2026-05-21T14:19:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1961#discussion_r3281823661","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3281823661"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1961#discussion_r3281823661"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3281823661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":12,"side":"RIGHT","author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3288588330","pull_request_review_id":4345685550,"id":3288588330,"node_id":"PRRC_kwDOPaLyBs7EA-Aq","diff_hunk":"@@ -7,6 +7,10 @@ libraries = [\n     { path = \"tools/dylint_lints/de*/de*\" }\n ]\n \n+# DE1201: Publishable crates must build docs.rs with all features enabled.\n+[de1201_docs_rs_all_features]\n+excluded_crates = []","path":"dylint.toml","commit_id":"fd2cdbd61155eb042199806f43b97c82f8dfd2a0","original_commit_id":"fd2cdbd61155eb042199806f43b97c82f8dfd2a0","user":{"login":"fluiderson","id":90795031,"node_id":"MDQ6VXNlcjkwNzk1MDMx","avatar_url":"https://avatars.githubusercontent.com/u/90795031?v=4","gravatar_id":"","url":"https://api.github.com/users/fluiderson","html_url":"https://github.com/fluiderson","followers_url":"https://api.github.com/users/fluiderson/followers","following_url":"https://api.github.com/users/fluiderson/following{/other_user}","gists_url":"https://api.github.com/users/fluiderson/gists{/gist_id}","starred_url":"https://api.github.com/users/fluiderson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fluiderson/subscriptions","organizations_url":"https://api.github.com/users/fluiderson/orgs","repos_url":"https://api.github.com/users/fluiderson/repos","events_url":"https://api.github.com/users/fluiderson/events{/privacy}","received_events_url":"https://api.github.com/users/fluiderson/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Added `DE1201_DOCS_RS_ALL_FEATURES_EXCLUDED_CRATES`.\r\n\r\nAn example:\r\n\r\n```sh\r\nDE1201_DOCS_RS_ALL_FEATURES_EXCLUDED_CRATES=cyberware-modkit cargo dylint -p cyberware-modkit --lib de1201_docs_rs_all_features\r\n```","created_at":"2026-05-22T13:11:42Z","updated_at":"2026-05-22T13:11:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1961#discussion_r3288588330","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3288588330"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1961#discussion_r3288588330"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/3288588330/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":12,"side":"RIGHT","in_reply_to_id":3281823661,"author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"}],"source_reviews":[{"id":4337675137,"node_id":"PRR_kwDOPaLyBs8AAAABAourgQ","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I agree on the changes of the all-features for docs.\nI don't fully agree on the dylint rule for this purpose. It's not related with a linting rule, but a check on the cargo manifest. \nThis kind of checking is outside of rust source code, and dylint rules are expensive.\nI don't want to click \"Request changes\" but just commenting that this approach can be easily solved once the CLI is done(WIP)","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/1961#pullrequestreview-4337675137","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/1961#pullrequestreview-4337675137"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/1961"}},"submitted_at":"2026-05-21T14:19:25Z","commit_
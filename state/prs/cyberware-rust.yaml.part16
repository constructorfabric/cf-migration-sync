### [A-Z]/p' modules/system/oagw/DESIGN.md | head -80\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 14052\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\nset -euo pipefail\n\n# Check if OAGW actually exists as implemented code\necho \"=== Check if OAGW crate exists ===\" \nif [ -d \"modules/system/oagw\" ]; then\n  ls -la modules/system/oagw/\nfi\n\n# Search for domain_model macro usage in oagw\necho -e \"\\n=== Search for domain_model macro in OAGW ===\" \nfind modules/system/oagw -name \"*.rs\" 2>/dev/null | xargs grep -l \"domain_model\" 2>/dev/null || echo \"No domain_model macro found\"\n\n# Search for GTS schema registration in DESIGN.md\necho -e \"\\n=== GTS/Schema sections from DESIGN.md ===\" \nsed -n '/Type System/,/REST API/p' modules/system/oagw/DESIGN.md | head -150\n\n# Check if there's an openspec change proposal for OAGW\necho -e \"\\n=== Check for OAGW openspec files ===\" \nfind . -path \"*/oagw*/openspec*\" 2>/dev/null | head -20\n\n# Check what DESIGN.md says about breaking/new capabilities\necho -e \"\\n=== Check Feature phases (new capability indicators) ===\" \nsed -n '/^## Feature Breakdown/,/^## [A-Z]/p' modules/system/oagw/DESIGN.md | head -50\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 6331\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\nset -euo pipefail\n\n# Check actual domain_model macro usage (sample a file)\necho \"=== Sample domain_model macro usage ===\" \nsed -n '1,50p' modules/system/oagw/oagw/src/domain/model.rs | head -30\n\n# Verify RFC 9457 Problem type usage in error handling\necho -e \"\\n=== Search for Problem type in OAGW code ===\" \nfind modules/system/oagw -name \"*.rs\" 2>/dev/null | xargs grep -l \"Problem\" 2>/dev/null | head -5\n\n# Check GTS type provisioning\necho -e \"\\n=== GTS type provisioning file ===\" \nhead -100 modules/system/oagw/oagw/src/infra/type_provisioning.rs 2>/dev/null || echo \"File not found\"\n\n# Check OperationBuilder usage in routes\necho -e \"\\n=== Search for OperationBuilder in routes ===\" \nfind modules/system/oagw -path \"*/api/rest/routes*\" -name \"*.rs\" 2>/dev/null | xargs head -50 2>/dev/null | head -80\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5433\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\nset -euo pipefail\n\n# Check what phase this document is in and if breaking changes\necho \"=== Check Phase 0 (MVP) features in DESIGN.md ===\" \nsed -n '/Phase 0.*MVP/,/Phase 1/p' modules/system/oagw/DESIGN.md | head -50\n\n# Check if there are any references to openspec in OAGW docs\necho -e \"\\n=== Search for openspec references in OAGW ===\" \nfind modules/system/oagw -type f \\( -name \"*.md\" -o -name \"*.rs\" \\) 2>/dev/null | xargs grep -i \"openspec\\|change.*proposal\" 2>/dev/null | head -10 || echo \"No openspec references\"\n\n# Verify Problem type implementation\necho -e \"\\n=== Check Problem type usage in error.rs ===\" \nhead -80 modules/system/oagw/oagw/src/api/rest/error.rs\n\n# Check for SecureConn/AccessScope usage\necho -e \"\\n=== Search for database access pattern ===\" \ngrep -r \"SecureConn\\|AccessScope\" modules/system/oagw --include=\"*.rs\" 2>/dev/null | head -5 || echo \"Check repo structure\"\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 4123\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\nset -euo pipefail\n\n# Check if DESIGN.md follows change proposal format from learnings\necho \"=== Check DESIGN.md structure vs proposal format ===\" \nhead -100 modules/system/oagw/DESIGN.md\n\n# Check learnings about proposal format requirements\necho -e \"\\n=== Proposal format sections (from learnings) ===\" \necho \"Required sections per learnings:\"\necho \"- Why (1-2 sentences on problem/opportunity)\"\necho \"- What Changes (bullet list with breaking changes marked)\"\necho \"- Impact (affected specs and code)\"\necho \"- For design.md: Context, Goals/Non-Goals, Decisions, Risks/Trade-offs, Migration Plan, Open Questions\"\n\n# Check if DESIGN.md has these sections\necho -e \"\\n=== DESIGN.md section headers ===\" \ngrep \"^## \" modules/system/oagw/DESIGN.md | head -20\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 5794\n\n---\n\n\n\n</details>\n\n**Add openspec change proposal for OAGW as a new major capability.**\n\nOAGW's ModKit architecture is well-aligned: SDK pattern (two crates), RFC-9457 Problem Details errors, `domain_model` macros on all domain types, proper GTS schema registration, OperationBuilder route registration, and clean DDD-Light layering all follow guidelines correctly.\n\nHowever, per openspec conventions, new major capabilities and architecture shifts require a formal change proposal. Create `modules/system/oagw/openspec/changes/oagw-launch/proposal.md` with:\n- **Why**: 1-2 sentences on the business need (centralized outbound request management to external services)\n- **What Changes**: Bullet list of new GTS types (`gts.x.core.oagw.upstream.v1~`, `gts.x.core.oagw.route.v1~`, auth/guard/transform plugin types); mark any breaking changes\n- **Impact**: Affected modules (types-registry registration, api-ingress REST integration, cred-store secret references)\n\nOptionally add `modules/system/oagw/openspec/changes/oagw-launch/design.md` if cross-module coordination, new external dependencies, or migration complexity warrants it (currently your DESIGN.md covers this comprehensively, so extraction may be minimal).\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.20.0)</summary>\n\n[warning] 259-259: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/DESIGN.md` around lines 257 - 305, Add an openspec change\nproposal file named proposal.md under the oagw openspec changes for the new\nmajor capability: include a 1–2 sentence \"Why\" describing centralized outbound\nrequest management, a \"What Changes\" bullet list declaring new GTS types\n(gts.x.core.oagw.upstream.v1~, gts.x.core.oagw.route.v1~, and plugin types for\nauth/guard/transform) and mark breaking changes, and an \"Impact\" section listing\naffected areas (types-registry / GTS registration, api-ingress REST integration\n/ OperationBuilder route registration, and cred-store secret references);\noptionally add a design.md alongside proposal.md if cross-module coordination,\nnew external deps, or migration steps need detailing.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:37:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227532","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227532"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227532"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":257,"original_start_line":257,"start_side":"RIGHT","line":305,"original_line":305,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":506,"position":506,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227542","pull_request_review_id":3814159489,"id":2817227542,"node_id":"PRRC_kwDOPaLyBs6n63sW","diff_hunk":"@@ -0,0 +1,990 @@\n+//! Infrastructure implementation of `TypeProvisioningService` backed by `TypesRegistryClient`.\n+//!\n+//! Queries the types-registry for upstream and route GTS instances registered\n+//! by other modules during `init()`, deserializes their content, and returns\n+//! domain-level provisioned objects for `post_init()` to insert into repos.\n+\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use serde::Deserialize;\n+use types_registry_sdk::{ListQuery, TypesRegistryClient};\n+use uuid::Uuid;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::gts_helpers::{ROUTE_SCHEMA, UPSTREAM_SCHEMA};\n+use crate::domain::model as domain;\n+use crate::domain::type_provisioning::{\n+    ProvisionedRoute, ProvisionedUpstream, TypeProvisioningService,\n+};\n+\n+// ---------------------------------------------------------------------------\n+// Local serde types for GTS entity deserialization.\n+//\n+// These mirror the GTS JSON shape and convert to domain types. They are\n+// intentionally separate from REST DTOs so each can evolve independently.\n+// ---------------------------------------------------------------------------\n+\n+fn default_true() -> bool {\n+    true\n+}\n+\n+fn default_port() -> u16 {\n+    443\n+}\n+\n+fn default_cost() -> u32 {\n+    1\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[derive(Deserialize)]\n+struct Endpoint {\n+    #[serde(default)]\n+    scheme: Scheme,\n+    host: String,\n+    #[serde(default = \"default_port\")]\n+    port: u16,\n+}","path":"modules/system/oagw/oagw/src/infra/type_provisioning.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Fix default port selection for non-HTTPS schemes.**  \n`default_port()` always returns 443, so HTTP endpoints without an explicit port will be provisioned on 443. Consider making the port optional and deriving a scheme-based default during conversion.\n\n<details>\n<summary>🛠️ Suggested fix (scheme-based defaults)</summary>\n\n```diff\n-fn default_port() -> u16 {\n-    443\n-}\n-\n #[derive(Deserialize)]\n struct Endpoint {\n     #[serde(default)]\n     scheme: Scheme,\n     host: String,\n-    #[serde(default = \"default_port\")]\n-    port: u16,\n+    #[serde(default)]\n+    port: Option<u16>,\n }\n+\n+impl Scheme {\n+    fn default_port(&self) -> u16 {\n+        match self {\n+            Scheme::Http => 80,\n+            Scheme::Https | Scheme::Wss | Scheme::Wt | Scheme::Grpc => 443,\n+        }\n+    }\n+}\n\n impl From<Endpoint> for domain::Endpoint {\n     fn from(v: Endpoint) -> Self {\n         Self {\n             scheme: v.scheme.into(),\n             host: v.host,\n-            port: v.port,\n+            port: v.port.unwrap_or_else(|| v.scheme.default_port()),\n         }\n     }\n }\n```\n</details>\n\n\n\nAlso applies to: 288-307\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/infra/type_provisioning.rs` around lines 33 -\n59, Endpoint currently uses a non-optional port with default_port() always\nreturning 443, so HTTP/Ws/Grpc endpoints get wrong ports; change Endpoint.port\nto Option<u16> (remove #[serde(default = \"default_port\")]) and update the\nconversion/validation logic that consumes Endpoint (e.g., where Endpoint is\nconverted into provisioned address or in the function that reads Endpoint) to\ncompute a scheme-based default: if port.is_some() use it, else match on scheme\n(Scheme::Http => 80, Https/Wss => 443, Wt => 80, Grpc => 80 or appropriate\nvalue) and use that derived port; ensure default_port() is either removed or\nrepurposed to only return HTTPS default if still needed and update any tests\nhandling ports accordingly.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:44:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227542","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227542"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227542"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227542/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":33,"original_start_line":33,"start_side":"RIGHT","line":59,"original_line":59,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":59,"position":59,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227545","pull_request_review_id":3814159489,"id":2817227545,"node_id":"PRRC_kwDOPaLyBs6n63sZ","diff_hunk":"@@ -0,0 +1,990 @@\n+//! Infrastructure implementation of `TypeProvisioningService` backed by `TypesRegistryClient`.\n+//!\n+//! Queries the types-registry for upstream and route GTS instances registered\n+//! by other modules during `init()`, deserializes their content, and returns\n+//! domain-level provisioned objects for `post_init()` to insert into repos.\n+\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use serde::Deserialize;\n+use types_registry_sdk::{ListQuery, TypesRegistryClient};\n+use uuid::Uuid;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::gts_helpers::{ROUTE_SCHEMA, UPSTREAM_SCHEMA};\n+use crate::domain::model as domain;\n+use crate::domain::type_provisioning::{\n+    ProvisionedRoute, ProvisionedUpstream, TypeProvisioningService,\n+};\n+\n+// ---------------------------------------------------------------------------\n+// Local serde types for GTS entity deserialization.\n+//\n+// These mirror the GTS JSON shape and convert to domain types. They are\n+// intentionally separate from REST DTOs so each can evolve independently.\n+// ---------------------------------------------------------------------------\n+\n+fn default_true() -> bool {\n+    true\n+}\n+\n+fn default_port() -> u16 {\n+    443\n+}\n+\n+fn default_cost() -> u32 {\n+    1\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[derive(Deserialize)]\n+struct Endpoint {\n+    #[serde(default)]\n+    scheme: Scheme,\n+    host: String,\n+    #[serde(default = \"default_port\")]\n+    port: u16,\n+}\n+\n+#[derive(Deserialize)]\n+struct Server {\n+    endpoints: Vec<Endpoint>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+#[derive(Deserialize)]\n+struct AuthConfig {\n+    #[serde(rename = \"type\")]\n+    plugin_type: String,\n+    #[serde(default)]\n+    sharing: SharingMode,\n+    #[serde(default)]\n+    config: Option<HashMap<String, String>>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum PassthroughMode {\n+    #[default]\n+    None,\n+    Allowlist,\n+    All,\n+}\n+\n+#[derive(Deserialize, Default)]\n+struct RequestHeaderRules {\n+    #[serde(default)]\n+    set: HashMap<String, String>,\n+    #[serde(default)]\n+    add: HashMap<String, String>,\n+    #[serde(default)]\n+    remove: Vec<String>,\n+    #[serde(default)]\n+    passthrough: PassthroughMode,\n+    #[serde(default)]\n+    passthrough_allowlist: Vec<String>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+struct ResponseHeaderRules {\n+    #[serde(default)]\n+    set: HashMap<String, String>,\n+    #[serde(default)]\n+    add: HashMap<String, String>,\n+    #[serde(default)]\n+    remove: Vec<String>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+struct HeadersConfig {\n+    #[serde(default)]\n+    request: Option<RequestHeaderRules>,\n+    #[serde(default)]\n+    response: Option<ResponseHeaderRules>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+struct PluginsConfig {\n+    #[serde(default)]\n+    sharing: SharingMode,\n+    #[serde(default)]\n+    items: Vec<String>,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"snake_case\")]\n+enum RateLimitAlgorithm {\n+    #[default]\n+    TokenBucket,\n+    SlidingWindow,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum Window {\n+    #[default]\n+    Second,\n+    Minute,\n+    Hour,\n+    Day,\n+}\n+\n+#[derive(Deserialize)]\n+struct SustainedRate {\n+    rate: u32,\n+    #[serde(default)]\n+    window: Window,\n+}\n+\n+#[derive(Deserialize)]\n+struct BurstConfig {\n+    capacity: u32,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum RateLimitScope {\n+    Global,\n+    #[default]\n+    Tenant,\n+    User,\n+    Ip,\n+    Route,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum RateLimitStrategy {\n+    #[default]\n+    Reject,\n+    Queue,\n+    Degrade,\n+}\n+\n+#[derive(Deserialize)]\n+struct RateLimitConfig {\n+    #[serde(default)]\n+    sharing: SharingMode,\n+    #[serde(default)]\n+    algorithm: RateLimitAlgorithm,\n+    sustained: SustainedRate,\n+    #[serde(default)]\n+    burst: Option<BurstConfig>,\n+    #[serde(default)]\n+    scope: RateLimitScope,\n+    #[serde(default)]\n+    strategy: RateLimitStrategy,\n+    #[serde(default = \"default_cost\")]\n+    cost: u32,\n+}\n+\n+#[derive(Deserialize)]\n+#[serde(rename_all = \"UPPERCASE\")]\n+enum HttpMethod {\n+    Get,\n+    Post,\n+    Put,\n+    Delete,\n+    Patch,\n+}\n+\n+#[derive(Deserialize, Default)]\n+#[serde(rename_all = \"lowercase\")]\n+enum PathSuffixMode {\n+    Disabled,\n+    #[default]\n+    Append,\n+}\n+\n+#[derive(Deserialize)]\n+struct HttpMatch {\n+    methods: Vec<HttpMethod>,\n+    path: String,\n+    #[serde(default)]\n+    query_allowlist: Vec<String>,\n+    #[serde(default)]\n+    path_suffix_mode: PathSuffixMode,\n+}\n+\n+#[derive(Deserialize)]\n+struct GrpcMatch {\n+    service: String,\n+    method: String,\n+}\n+\n+#[derive(Deserialize)]\n+struct MatchRules {\n+    #[serde(default)]\n+    http: Option<HttpMatch>,\n+    #[serde(default)]\n+    grpc: Option<GrpcMatch>,\n+}\n+\n+/// Intermediate serde struct for deserializing upstream GTS entity content.\n+#[derive(Deserialize)]\n+struct UpstreamPayload {\n+    tenant_id: Uuid,\n+    server: Server,\n+    protocol: String,\n+    #[serde(default)]\n+    alias: Option<String>,\n+    #[serde(default)]\n+    auth: Option<AuthConfig>,\n+    #[serde(default)]\n+    headers: Option<HeadersConfig>,\n+    #[serde(default)]\n+    plugins: Option<PluginsConfig>,\n+    #[serde(default)]\n+    rate_limit: Option<RateLimitConfig>,\n+    #[serde(default)]\n+    tags: Vec<String>,\n+    #[serde(default = \"default_true\")]\n+    enabled: bool,\n+}\n+\n+/// Intermediate serde struct for deserializing route GTS entity content.\n+#[derive(Deserialize)]\n+struct RoutePayload {\n+    tenant_id: Uuid,\n+    upstream_id: Uuid,\n+    #[serde(rename = \"match\")]\n+    match_rules: MatchRules,\n+    #[serde(default)]\n+    plugins: Option<PluginsConfig>,\n+    #[serde(default)]\n+    rate_limit: Option<RateLimitConfig>,\n+    #[serde(default)]\n+    tags: Vec<String>,\n+    #[serde(default)]\n+    priority: i32,\n+    #[serde(default = \"default_true\")]\n+    enabled: bool,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// From conversions: local payload types → domain types\n+// ---------------------------------------------------------------------------\n+\n+impl From<Scheme> for domain::Scheme {\n+    fn from(v: Scheme) -> Self {\n+        match v {\n+            Scheme::Http => Self::Http,\n+            Scheme::Https => Self::Https,\n+            Scheme::Wss => Self::Wss,\n+            Scheme::Wt => Self::Wt,\n+            Scheme::Grpc => Self::Grpc,\n+        }\n+    }\n+}\n+\n+impl From<Endpoint> for domain::Endpoint {\n+    fn from(v: Endpoint) -> Self {\n+        Self {\n+            scheme: v.scheme.into(),\n+            host: v.host,\n+            port: v.port,\n+        }\n+    }\n+}\n+\n+impl From<Server> for domain::Server {\n+    fn from(v: Server) -> Self {\n+        Self {\n+            endpoints: v.endpoints.into_iter().map(Into::into).collect(),\n+        }\n+    }\n+}\n+\n+impl From<SharingMode> for domain::SharingMode {\n+    fn from(v: SharingMode) -> Self {\n+        match v {\n+            SharingMode::Private => Self::Private,\n+            SharingMode::Inherit => Self::Inherit,\n+            SharingMode::Enforce => Self::Enforce,\n+        }\n+    }\n+}\n+\n+impl From<AuthConfig> for domain::AuthConfig {\n+    fn from(v: AuthConfig) -> Self {\n+        Self {\n+            plugin_type: v.plugin_type,\n+            sharing: v.sharing.into(),\n+            config: v.config,\n+        }\n+    }\n+}\n+\n+impl From<PassthroughMode> for domain::PassthroughMode {\n+    fn from(v: PassthroughMode) -> Self {\n+        match v {\n+            PassthroughMode::None => Self::None,\n+            PassthroughMode::Allowlist => Self::Allowlist,\n+            PassthroughMode::All => Self::All,\n+        }\n+    }\n+}\n+\n+impl From<RequestHeaderRules> for domain::RequestHeaderRules {\n+    fn from(v: RequestHeaderRules) -> Self {\n+        Self {\n+            set: v.set,\n+            add: v.add,\n+            remove: v.remove,\n+            passthrough: v.passthrough.into(),\n+            passthrough_allowlist: v.passthrough_allowlist,\n+        }\n+    }\n+}\n+\n+impl From<ResponseHeaderRules> for domain::ResponseHeaderRules {\n+    fn from(v: ResponseHeaderRules) -> Self {\n+        Self {\n+            set: v.set,\n+            add: v.add,\n+            remove: v.remove,\n+        }\n+    }\n+}\n+\n+impl From<HeadersConfig> for domain::HeadersConfig {\n+    fn from(v: HeadersConfig) -> Self {\n+        Self {\n+            request: v.request.map(Into::into),\n+            response: v.response.map(Into::into),\n+        }\n+    }\n+}\n+\n+impl From<RateLimitAlgorithm> for domain::RateLimitAlgorithm {\n+    fn from(v: RateLimitAlgorithm) -> Self {\n+        match v {\n+            RateLimitAlgorithm::TokenBucket => Self::TokenBucket,\n+            RateLimitAlgorithm::SlidingWindow => Self::SlidingWindow,\n+        }\n+    }\n+}\n+\n+impl From<Window> for domain::Window {\n+    fn from(v: Window) -> Self {\n+        match v {\n+            Window::Second => Self::Second,\n+            Window::Minute => Self::Minute,\n+            Window::Hour => Self::Hour,\n+            Window::Day => Self::Day,\n+        }\n+    }\n+}\n+\n+impl From<SustainedRate> for domain::SustainedRate {\n+    fn from(v: SustainedRate) -> Self {\n+        Self {\n+            rate: v.rate,\n+            window: v.window.into(),\n+        }\n+    }\n+}\n+\n+impl From<BurstConfig> for domain::BurstConfig {\n+    fn from(v: BurstConfig) -> Self {\n+        Self {\n+            capacity: v.capacity,\n+        }\n+    }\n+}\n+\n+impl From<RateLimitScope> for domain::RateLimitScope {\n+    fn from(v: RateLimitScope) -> Self {\n+        match v {\n+            RateLimitScope::Global => Self::Global,\n+            RateLimitScope::Tenant => Self::Tenant,\n+            RateLimitScope::User => Self::User,\n+            RateLimitScope::Ip => Self::Ip,\n+            RateLimitScope::Route => Self::Route,\n+        }\n+    }\n+}\n+\n+impl From<RateLimitStrategy> for domain::RateLimitStrategy {\n+    fn from(v: RateLimitStrategy) -> Self {\n+        match v {\n+            RateLimitStrategy::Reject => Self::Reject,\n+            RateLimitStrategy::Queue => Self::Queue,\n+            RateLimitStrategy::Degrade => Self::Degrade,\n+        }\n+    }\n+}\n+\n+impl From<RateLimitConfig> for domain::RateLimitConfig {\n+    fn from(v: RateLimitConfig) -> Self {\n+        Self {\n+            sharing: v.sharing.into(),\n+            algorithm: v.algorithm.into(),\n+            sustained: v.sustained.into(),\n+            burst: v.burst.map(Into::into),\n+            scope: v.scope.into(),\n+            strategy: v.strategy.into(),\n+            cost: v.cost,\n+        }\n+    }\n+}\n+\n+impl From<PluginsConfig> for domain::PluginsConfig {\n+    fn from(v: PluginsConfig) -> Self {\n+        Self {\n+            sharing: v.sharing.into(),\n+            items: v.items,\n+        }\n+    }\n+}\n+\n+impl From<HttpMethod> for domain::HttpMethod {\n+    fn from(v: HttpMethod) -> Self {\n+        match v {\n+            HttpMethod::Get => Self::Get,\n+            HttpMethod::Post => Self::Post,\n+            HttpMethod::Put => Self::Put,\n+            HttpMethod::Delete => Self::Delete,\n+            HttpMethod::Patch => Self::Patch,\n+        }\n+    }\n+}\n+\n+impl From<PathSuffixMode> for domain::PathSuffixMode {\n+    fn from(v: PathSuffixMode) -> Self {\n+        match v {\n+            PathSuffixMode::Disabled => Self::Disabled,\n+            PathSuffixMode::Append => Self::Append,\n+        }\n+    }\n+}\n+\n+impl From<HttpMatch> for domain::HttpMatch {\n+    fn from(v: HttpMatch) -> Self {\n+        Self {\n+            methods: v.methods.into_iter().map(Into::into).collect(),\n+            path: v.path,\n+            query_allowlist: v.query_allowlist,\n+            path_suffix_mode: v.path_suffix_mode.into(),\n+        }\n+    }\n+}\n+\n+impl From<GrpcMatch> for domain::GrpcMatch {\n+    fn from(v: GrpcMatch) -> Self {\n+        Self {\n+            service: v.service,\n+            method: v.method,\n+        }\n+    }\n+}\n+\n+impl From<MatchRules> for domain::MatchRules {\n+    fn from(v: MatchRules) -> Self {\n+        Self {\n+            http: v.http.map(Into::into),\n+            grpc: v.grpc.map(Into::into),\n+        }\n+    }\n+}\n+\n+impl From<UpstreamPayload> for ProvisionedUpstream {\n+    fn from(p: UpstreamPayload) -> Self {\n+        Self {\n+            tenant_id: p.tenant_id,\n+            request: domain::CreateUpstreamRequest {\n+                server: p.server.into(),\n+                protocol: p.protocol,\n+                alias: p.alias,\n+                auth: p.auth.map(Into::into),\n+                headers: p.headers.map(Into::into),\n+                plugins: p.plugins.map(Into::into),\n+                rate_limit: p.rate_limit.map(Into::into),\n+                tags: p.tags,\n+                enabled: p.enabled,\n+            },\n+        }\n+    }\n+}\n+\n+impl From<RoutePayload> for ProvisionedRoute {\n+    fn from(p: RoutePayload) -> Self {\n+        Self {\n+            tenant_id: p.tenant_id,\n+            request: domain::CreateRouteRequest {\n+                upstream_id: p.upstream_id,\n+                match_rules: p.match_rules.into(),\n+                plugins: p.plugins.map(Into::into),\n+                rate_limit: p.rate_limit.map(Into::into),\n+                tags: p.tags,\n+                priority: p.priority,\n+                enabled: p.enabled,\n+            },\n+        }\n+    }\n+}\n+\n+/// `TypeProvisioningService` implementation that delegates to `TypesRegistryClient`.\n+pub struct TypeProvisioningServiceImpl {\n+    registry: Arc<dyn TypesRegistryClient>,\n+}\n+\n+impl TypeProvisioningServiceImpl {\n+    pub fn new(registry: Arc<dyn TypesRegistryClient>) -> Self {\n+        Self { registry }\n+    }\n+}\n+\n+#[async_trait]\n+impl TypeProvisioningService for TypeProvisioningServiceImpl {\n+    async fn list_upstreams(&self) -> Result<Vec<ProvisionedUpstream>, DomainError> {\n+        let query = ListQuery::new()\n+            .with_pattern(format!(\"{UPSTREAM_SCHEMA}*\"))\n+            .with_is_type(false);\n+\n+        let entities = self\n+            .registry\n+            .list(query)\n+            .await\n+            .map_err(|e| DomainError::internal(e.to_string()))?;\n+\n+        let mut result = Vec::with_capacity(entities.len());\n+        for entity in entities {\n+            match serde_json::from_value::<UpstreamPayload>(entity.content.clone()) {\n+                Ok(payload) => {\n+                    result.push(payload.into());\n+                }\n+                Err(e) => {\n+                    tracing::warn!(\n+                        gts_id = %entity.gts_id,\n+                        error = %e,\n+                        \"Skipping upstream: failed to deserialize GTS entity content\"\n+                    );\n+                }\n+            }\n+        }\n+\n+        Ok(result)\n+    }\n+\n+    async fn list_routes(&self) -> Result<Vec<ProvisionedRoute>, DomainError> {\n+        let query = ListQuery::new()\n+            .with_pattern(format!(\"{ROUTE_SCHEMA}*\"))\n+            .with_is_type(false);\n+\n+        let entities = self\n+            .registry\n+            .list(query)\n+            .await\n+            .map_err(|e| DomainError::internal(e.to_string()))?;\n+\n+        let mut result = Vec::with_capacity(entities.len());\n+        for entity in entities {\n+            match serde_json::from_value::<RoutePayload>(entity.content.clone()) {\n+                Ok(payload) => {\n+                    result.push(payload.into());\n+                }\n+                Err(e) => {\n+                    tracing::warn!(\n+                        gts_id = %entity.gts_id,\n+                        error = %e,\n+                        \"Skipping route: failed to deserialize GTS entity content\"\n+                    );\n+                }\n+            }","path":"modules/system/oagw/oagw/src/infra/type_provisioning.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Guard against empty match rules when provisioning routes.**  \n`MatchRules` allows both `http` and `grpc` to be `None`, which will deserialize but produce an unusable route. It’s safer to treat this as invalid and skip with a warning.\n\n<details>\n<summary>🛠️ Suggested validation before provisioning</summary>\n\n```diff\n         for entity in entities {\n             match serde_json::from_value::<RoutePayload>(entity.content.clone()) {\n                 Ok(payload) => {\n+                    if payload.match_rules.http.is_none() && payload.match_rules.grpc.is_none() {\n+                        tracing::warn!(\n+                            gts_id = %entity.gts_id,\n+                            \"Skipping route: missing http/grpc match rules\"\n+                        );\n+                        continue;\n+                    }\n                     result.push(payload.into());\n                 }\n                 Err(e) => {\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/infra/type_provisioning.rs` around lines 590 -\n614, In list_routes, after successfully deserializing RoutePayload (in the match\nhandling inside async fn list_routes), validate its MatchRules and skip invalid\nentries: if the RoutePayload.match_rules (or the struct field name for match\nrules) has both http and grpc equal to None/empty, emit a tracing::warn (include\ngts_id and the reason) and continue without pushing into result; otherwise\nconvert payload.into() as before. This ensures deserialized but unusable routes\nare ignored before creating ProvisionedRoute.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:44:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227545","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227545"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227545"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227545/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":590,"original_start_line":590,"start_side":"RIGHT","line":614,"original_line":614,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":614,"position":614,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227548","pull_request_review_id":3814159489,"id":2817227548,"node_id":"PRRC_kwDOPaLyBs6n63sc","diff_hunk":"@@ -0,0 +1,103 @@\n+//! Fluent request builder for integration tests.\n+\n+use axum::body::Body;\n+use http::header::HeaderMap;\n+use http::{HeaderName, HeaderValue, Method};\n+use serde::de::DeserializeOwned;\n+use tower::ServiceExt;\n+\n+use super::body::IntoBody;\n+use super::harness::AppHarness;\n+use super::response::TestResponse;\n+\n+/// Fluent HTTP request builder tied to an [`AppHarness`].\n+pub struct RequestCase<'a> {\n+    harness: &'a AppHarness,\n+    method: Method,\n+    path: String,\n+    headers: HeaderMap,\n+    query: Vec<(String, String)>,\n+    body: Option<Body>,\n+}\n+\n+impl<'a> RequestCase<'a> {\n+    pub(crate) fn new(harness: &'a AppHarness, method: Method, path: impl Into<String>) -> Self {\n+        Self {\n+            harness,\n+            method,\n+            path: path.into(),\n+            headers: HeaderMap::new(),\n+            query: Vec::new(),\n+            body: None,\n+        }\n+    }\n+\n+    /// Set the request body. Accepts any type implementing [`IntoBody`]:\n+    /// `Json(&struct)`, `serde_json::Value`, `&str`, `String`, `Bytes`, `Vec<u8>`.\n+    pub fn with_body(mut self, body: impl IntoBody) -> Self {\n+        let (b, ct) = body.into_body();\n+        self.body = Some(b);\n+        if let Some(ct) = ct {\n+            self.headers.insert(http::header::CONTENT_TYPE, ct);\n+        }\n+        self\n+    }\n+\n+    /// Add a request header.\n+    pub fn with_header(\n+        mut self,\n+        name: impl Into<HeaderName>,\n+        value: impl Into<HeaderValue>,\n+    ) -> Self {\n+        self.headers.insert(name.into(), value.into());\n+        self\n+    }\n+\n+    /// Add a query parameter.\n+    pub fn with_query(mut self, key: impl Into<String>, value: impl Into<String>) -> Self {\n+        self.query.push((key.into(), value.into()));\n+        self\n+    }\n+\n+    /// Send the request and return the collected response.\n+    pub async fn send(self) -> TestResponse {\n+        let uri = if self.query.is_empty() {\n+            self.path\n+        } else {\n+            let qs: Vec<String> = self.query.iter().map(|(k, v)| format!(\"{k}={v}\")).collect();\n+            format!(\"{}?{}\", self.path, qs.join(\"&\"))\n+        };","path":"modules/system/oagw/oagw/src/test_support/request.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Verify whether the `url` crate is already available in the workspace\nrg -n '^\\s*url\\s*=' -g 'Cargo.toml'\nrg -n 'form_urlencoded' -g 'Cargo.toml'\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 483\n\n---\n\n🏁 Script executed:\n\n```shell\ncat -n modules/system/oagw/oagw/src/test_support/request.rs | head -100\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 3852\n\n---\n\n\n\n</details>\n\n**Encode query parameters before building the URI.**\n\nThe current `{k}={v}` concatenation does not URL-encode reserved characters, which can produce invalid URIs or incorrect routing in tests. This is especially problematic when query values contain spaces, `&`, `?`, `=`, or `#` characters.\n\n<details>\n<summary>🔧 Suggested fix (uses form URL encoding)</summary>\n\n```diff\n use serde::de::DeserializeOwned;\n use tower::ServiceExt;\n+use url::form_urlencoded::Serializer;\n \n use super::body::IntoBody;\n@@\n-        let uri = if self.query.is_empty() {\n-            self.path\n-        } else {\n-            let qs: Vec<String> = self.query.iter().map(|(k, v)| format!(\"{k}={v}\")).collect();\n-            format!(\"{}?{}\", self.path, qs.join(\"&\"))\n-        };\n+        let uri = if self.query.is_empty() {\n+            self.path\n+        } else {\n+            let mut ser = Serializer::new(String::new());\n+            for (k, v) in &self.query {\n+                ser.append_pair(k, v);\n+            }\n+            format!(\"{}?{}\", self.path, ser.finish())\n+        };\n```\n\nThe `form_urlencoded` crate is already a dependency in your Cargo.toml.\n\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    /// Send the request and return the collected response.\n    pub async fn send(self) -> TestResponse {\n        let uri = if self.query.is_empty() {\n            self.path\n        } else {\n            let mut ser = url::form_urlencoded::Serializer::new(String::new());\n            for (k, v) in &self.query {\n                ser.append_pair(k, v);\n            }\n            format!(\"{}?{}\", self.path, ser.finish())\n        };\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/test_support/request.rs` around lines 62 - 69,\nThe send method builds the request URI by concatenating query pairs without\nURL-encoding, which breaks on reserved chars; update TestRequest::send to\nURL-encode query keys and values (self.query) before joining them into the URI\n(the uri variable built from self.path and qs.join(\"&\")), e.g. use the\nform_urlencoded encoder (already in Cargo.toml) to percent-encode each (k, v)\npair and produce a properly encoded query string, then format!(\"{}?{}\",\nself.path, encoded_qs).\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:44:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227548","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227548"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227548"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227548/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":62,"original_start_line":62,"start_side":"RIGHT","line":69,"original_line":69,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":69,"position":69,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227553","pull_request_review_id":3814159489,"id":2817227553,"node_id":"PRRC_kwDOPaLyBs6n63sh","diff_hunk":"@@ -0,0 +1,94 @@\n+\"\"\"Pytest configuration and fixtures for OAGW E2E tests.\"\"\"\n+import asyncio\n+import os\n+import threading\n+\n+import httpx\n+import pytest\n+\n+from .mock_upstream import MockUpstreamServer\n+\n+\n+# ---------------------------------------------------------------------------\n+# Environment-driven fixtures\n+# ---------------------------------------------------------------------------\n+\n+@pytest.fixture\n+def oagw_base_url():\n+    \"\"\"OAGW service base URL.\"\"\"\n+    return os.getenv(\"E2E_OAGW_BASE_URL\", \"http://localhost:8086\")\n+\n+\n+@pytest.fixture\n+def mock_upstream_url():\n+    \"\"\"Mock upstream base URL (must be reachable by the OAGW service).\"\"\"\n+    return os.getenv(\"E2E_MOCK_UPSTREAM_URL\", \"http://127.0.0.1:19876\")\n+\n+\n+@pytest.fixture\n+def tenant_id():\n+    \"\"\"Fixed tenant UUID for test isolation.\"\"\"\n+    return \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\"\n+\n+\n+@pytest.fixture\n+def oagw_headers(tenant_id):\n+    \"\"\"Standard headers for OAGW requests (tenant + optional auth).\"\"\"\n+    headers = {\"x-tenant-id\": tenant_id}\n+    token = os.getenv(\"E2E_AUTH_TOKEN\")\n+    if token:\n+        headers[\"Authorization\"] = f\"Bearer {token}\"\n+    return headers\n+\n+\n+# ---------------------------------------------------------------------------\n+# Session-scoped mock upstream server\n+# ---------------------------------------------------------------------------\n+\n+@pytest.fixture(scope=\"session\")\n+def mock_upstream():\n+    \"\"\"Start the mock upstream server for the entire test session.\"\"\"\n+    url = os.getenv(\"E2E_MOCK_UPSTREAM_URL\", \"http://127.0.0.1:19876\")\n+\n+    # If a custom URL is set, assume the mock is managed externally.\n+    if os.getenv(\"E2E_MOCK_UPSTREAM_EXTERNAL\"):\n+        yield\n+        return\n+\n+    # Parse port from URL.\n+    port = int(url.rsplit(\":\", 1)[-1].split(\"/\")[0])\n+    server = MockUpstreamServer(host=\"0.0.0.0\", port=port)\n+\n+    # Run the mock server in a background thread with its own event loop\n+    # so it can actually serve requests while tests run.\n+    loop = asyncio.new_event_loop()\n+    loop.run_until_complete(server.start())\n+\n+    thread = threading.Thread(target=loop.run_forever, daemon=True)\n+    thread.start()\n+\n+    yield server\n+\n+    loop.call_soon_threadsafe(loop.stop)\n+    thread.join(timeout=5)\n+    loop.run_until_complete(server.stop())\n+    loop.close()","path":"testing/e2e/modules/oagw/conftest.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Event loop teardown sequence may fail.**\n\nAfter calling `loop.stop()` and joining the thread, the loop is no longer running. Calling `loop.run_until_complete(server.stop())` on a stopped loop will fail or behave unexpectedly because the loop was used in `run_forever` mode from another thread.\n\n\n<details>\n<summary>🐛 Proposed fix: stop the server before stopping the loop</summary>\n\n```diff\n     yield server\n\n-    loop.call_soon_threadsafe(loop.stop)\n-    thread.join(timeout=5)\n-    loop.run_until_complete(server.stop())\n+    # Schedule server.stop() on the loop, then stop the loop\n+    import asyncio\n+    future = asyncio.run_coroutine_threadsafe(server.stop(), loop)\n+    future.result(timeout=10)  # Wait for stop to complete\n+    loop.call_soon_threadsafe(loop.stop)\n+    thread.join(timeout=5)\n     loop.close()\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    # Schedule server.stop() on the loop, then stop the loop\n    import asyncio\n    future = asyncio.run_coroutine_threadsafe(server.stop(), loop)\n    future.result(timeout=10)  # Wait for stop to complete\n    loop.call_soon_threadsafe(loop.stop)\n    thread.join(timeout=5)\n    loop.close()\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/conftest.py` around lines 72 - 75, The teardown\ncalls stop the loop before stopping the server; instead, submit the\nserver.stop() coroutine to the running loop (using\nasyncio.run_coroutine_threadsafe(server.stop(), loop)) and wait for it to\ncomplete, then call loop.call_soon_threadsafe(loop.stop), join the thread, and\nfinally close the loop; update the block referencing loop.call_soon_threadsafe,\nserver.stop, thread.join, loop.stop, loop.run_until_complete and loop.close to\nuse asyncio.run_coroutine_threadsafe(server.stop(), loop).result(timeout=...)\n(handle exceptions as needed) before stopping and closing the loop.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:45:28Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227553","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227553"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227553"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227553/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":72,"original_start_line":72,"start_side":"RIGHT","line":75,"original_line":75,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":75,"position":75,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227558","pull_request_review_id":3814159489,"id":2817227558,"node_id":"PRRC_kwDOPaLyBs6n63sm","diff_hunk":"@@ -0,0 +1,173 @@\n+\"\"\"Standalone mock upstream HTTP server for OAGW E2E tests.\n+\n+Provides endpoints that simulate an upstream service (OpenAI-compatible JSON,\n+SSE streaming, echo, configurable errors). Started as a session-scoped pytest\n+fixture so the OAGW service under test can proxy to it.\n+\"\"\"\n+import asyncio\n+import json\n+import time\n+\n+from aiohttp import web\n+\n+\n+# ---------------------------------------------------------------------------\n+# Handlers\n+# ---------------------------------------------------------------------------\n+\n+async def handle_health(request: web.Request) -> web.Response:\n+    return web.json_response({\"status\": \"ok\"})\n+\n+\n+async def handle_echo(request: web.Request) -> web.Response:\n+    \"\"\"Return received headers and body as JSON.\"\"\"\n+    body = await request.read()\n+    headers = {k.lower(): v for k, v in request.headers.items()}\n+    return web.json_response({\n+        \"headers\": headers,\n+        \"body\": body.decode(\"utf-8\", errors=\"replace\"),\n+    })\n+\n+\n+async def handle_chat_completions(request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible chat completion response.\"\"\"\n+    return web.json_response({\n+        \"id\": \"chatcmpl-mock-123\",\n+        \"object\": \"chat.completion\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\n+            \"index\": 0,\n+            \"message\": {\"role\": \"assistant\", \"content\": \"Hello from mock server\"},\n+            \"finish_reason\": \"stop\",\n+        }],\n+        \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 20, \"total_tokens\": 30},\n+    })\n+\n+\n+async def handle_models(request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible model list.\"\"\"\n+    return web.json_response({\n+        \"object\": \"list\",\n+        \"data\": [\n+            {\"id\": \"gpt-4\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+            {\"id\": \"gpt-3.5-turbo\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+        ],\n+    })\n+\n+\n+async def handle_stream_chat_completions(request: web.Request) -> web.StreamResponse:\n+    \"\"\"SSE streaming chat completion.\"\"\"\n+    resp = web.StreamResponse(\n+        status=200,\n+        headers={\"Content-Type\": \"text/event-stream\", \"Cache-Control\": \"no-cache\"},\n+    )\n+    await resp.prepare(request)\n+\n+    words = [\"Hello\", \" from\", \" mock\", \" server\"]\n+    for i, word in enumerate(words):\n+        delta = {}\n+        if i == 0:\n+            delta[\"role\"] = \"assistant\"\n+        delta[\"content\"] = word\n+        chunk = {\n+            \"id\": \"chatcmpl-mock-stream\",\n+            \"object\": \"chat.completion.chunk\",\n+            \"created\": 1_234_567_890,\n+            \"model\": \"gpt-4-mock\",\n+            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": None}],\n+        }\n+        await resp.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())\n+        await asyncio.sleep(0.01)\n+\n+    # Final chunk with finish_reason\n+    final = {\n+        \"id\": \"chatcmpl-mock-stream\",\n+        \"object\": \"chat.completion.chunk\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}],\n+    }\n+    await resp.write(f\"data: {json.dumps(final)}\\n\\n\".encode())\n+    await resp.write(b\"data: [DONE]\\n\\n\")\n+    await resp.write_eof()\n+    return resp\n+\n+\n+async def handle_error_code(request: web.Request) -> web.Response:\n+    \"\"\"Return a configurable HTTP error status.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response(\n+        {\"error\": {\"message\": f\"Simulated error {code}\", \"type\": \"server_error\", \"code\": f\"error_{code}\"}},\n+        status=code,\n+    )\n+\n+\n+async def handle_error_timeout(request: web.Request) -> web.Response:\n+    \"\"\"Sleep long enough for the gateway proxy timeout to fire.\"\"\"\n+    await asyncio.sleep(30)\n+    return web.Response(text=\"should not reach here\")\n+\n+\n+async def handle_status(request: web.Request) -> web.Response:\n+    \"\"\"Return configurable status code.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response({\"status\": code, \"description\": f\"Status {code}\"}, status=code)\n+\n+\n+# ---------------------------------------------------------------------------\n+# App factory\n+# ---------------------------------------------------------------------------\n+\n+def create_app() -> web.Application:\n+    app = web.Application()\n+    app.router.add_get(\"/health\", handle_health)\n+    app.router.add_post(\"/echo\", handle_echo)\n+    app.router.add_post(\"/v1/chat/completions\", handle_chat_completions)\n+    app.router.add_get(\"/v1/models\", handle_models)\n+    app.router.add_post(\"/v1/chat/completions/stream\", handle_stream_chat_completions)\n+    app.router.add_get(\"/error/{code}\", handle_error_code)\n+    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/status/{code}\", handle_status)","path":"testing/e2e/modules/oagw/mock_upstream.py","commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Route `/error/timeout` is unreachable due to registration order.**\n\nThe route `/error/{code}` at line 129 will match `timeout` as a code before `/error/timeout` at line 130 can be reached. This means `handle_error_timeout` will never be invoked.\n\n\n<details>\n<summary>🐛 Proposed fix: register the specific route before the parameterized one</summary>\n\n```diff\n     app.router.add_get(\"/error/{code}\", handle_error_code)\n-    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    # Move timeout route before the parameterized route\n```\n\nRegister `/error/timeout` before `/error/{code}`:\n\n```diff\n-    app.router.add_get(\"/error/{code}\", handle_error_code)\n-    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/error/{code}\", handle_error_code)\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n    app.router.add_get(\"/error/{code}\", handle_error_code)\n    app.router.add_get(\"/status/{code}\", handle_status)\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/mock_upstream.py` around lines 129 - 131, The\nparameterized route \"/error/{code}\" currently shadows the specific\n\"/error/timeout\" route, so move the registration of\napp.router.add_get(\"/error/timeout\", handle_error_timeout) to be before\napp.router.add_get(\"/error/{code}\", handle_error_code) so the specific handler\n(handle_error_timeout) is matched first; ensure the order in the module where\nroutes are added uses the exact route strings and handler names\n(handle_error_timeout, handle_error_code) as given.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:ocelot -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @striped-zebra-dev\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-17T14:08:15Z","updated_at":"2026-02-17T16:45:52Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227558","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227558"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817227558"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817227558/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":129,"start_side":"RIGHT","line":null,"original_line":131,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":131,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817883060","pull_request_review_id":3814928004,"id":2817883060,"node_id":"PRRC_kwDOPaLyBs6n9Xu0","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let mut auth_ctx = AuthContext {\n+                headers: outbound_headers.clone(),\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = auth_ctx.headers;\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged — this is a valid finding. Rate-limit scope enforcement (scope-based bucket keys incorporating tenant/user/IP context) will be implemented as a separate feature, since it requires broader design consideration (transport-layer changes for IP scope, bucket migration strategy, etc.). Tracked for follow-up.","created_at":"2026-02-17T16:16:49Z","updated_at":"2026-02-17T16:16:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817883060","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817883060"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817883060"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817883060/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":245,"original_start_line":224,"start_side":"RIGHT","line":253,"original_line":232,"side":"RIGHT","in_reply_to_id":2817019778,"author_association":"MEMBER","original_position":232,"position":253,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817884216","pull_request_review_id":3814929499,"id":2817884216,"node_id":"PRRC_kwDOPaLyBs6n9YA4","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::collections::HashSet;\n+use std::time::Instant;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{RateLimitConfig, Window};\n+use dashmap::DashMap;\n+\n+pub struct RateLimiter {\n+    buckets: DashMap<String, TokenBucket>,\n+}\n+\n+struct TokenBucket {\n+    capacity: f64,\n+    tokens: f64,\n+    refill_rate: f64, // tokens per second\n+    last_refill: Instant,\n+}\n+\n+impl TokenBucket {\n+    fn new(config: &RateLimitConfig) -> Self {\n+        let capacity = config\n+            .burst\n+            .as_ref()\n+            .map_or(config.sustained.rate as f64, |b| b.capacity as f64);\n+        let window_secs = window_to_secs(&config.sustained.window);\n+        let refill_rate = config.sustained.rate as f64 / window_secs;\n+        Self {\n+            capacity,\n+            tokens: capacity,\n+            refill_rate,\n+            last_refill: Instant::now(),\n+        }\n+    }\n+\n+    fn refill(&mut self) {\n+        let now = Instant::now();\n+        let elapsed = now.duration_since(self.last_refill).as_secs_f64();\n+        self.tokens = (self.tokens + elapsed * self.refill_rate).min(self.capacity);\n+        self.last_refill = now;\n+    }\n+\n+    fn try_consume(&mut self, cost: f64) -> bool {\n+        self.refill();\n+        if self.tokens >= cost {\n+            self.tokens -= cost;\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    fn retry_after_secs(&self, cost: f64) -> u64 {\n+        if self.refill_rate <= 0.0 {\n+            return 60;\n+        }\n+        let needed = cost - self.tokens;\n+        if needed <= 0.0 {\n+            return 0;\n+        }\n+        (needed / self.refill_rate).ceil() as u64\n+    }\n+}\n+\n+fn window_to_secs(window: &Window) -> f64 {\n+    match window {\n+        Window::Second => 1.0,\n+        Window::Minute => 60.0,\n+        Window::Hour => 3600.0,\n+        Window::Day => 86400.0,\n+    }\n+}\n+\n+impl RateLimiter {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self {\n+            buckets: DashMap::new(),\n+        }\n+    }\n+\n+    /// Remove all entries whose keys are not in `active_keys`.\n+    ///\n+    // TODO: Wire into management service delete operations (upstream/route)\n+    // so that stale rate-limit buckets are purged when entities are removed.\n+    #[allow(dead_code)]\n+    pub fn purge_keys(&self, active_keys: &HashSet<String>) {\n+        self.buckets.retain(|k, _| active_keys.contains(k));\n+    }\n+\n+    /// Try to consume tokens for the given key.\n+    ///\n+    /// # Errors\n+    /// Returns `DomainError::RateLimitExceeded` with Retry-After seconds when exhausted.\n+    pub fn try_consume(\n+        &self,\n+        key: &str,\n+        config: &RateLimitConfig,\n+        instance_uri: &str,\n+    ) -> Result<(), DomainError> {\n+        let cost = config.cost as f64;\n+        let mut bucket = self\n+            .buckets\n+            .entry(key.to_string())\n+            .or_insert_with(|| TokenBucket::new(config));\n+","path":"modules/system/oagw/oagw/src/domain/rate_limit.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is related to rate-limit scope enforcement — will be addressed together as a separate feature. The current in-memory bucket approach is intentionally simple for the initial implementation; reconfiguration on config change is a known limitation documented in the design.","created_at":"2026-02-17T16:17:07Z","updated_at":"2026-02-17T16:17:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817884216","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817884216"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817884216"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817884216/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":97,"original_start_line":94,"start_side":"RIGHT","line":108,"original_line":105,"side":"RIGHT","in_reply_to_id":2817019745,"author_association":"MEMBER","original_position":105,"position":108,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817885057","pull_request_review_id":3814930508,"id":2817885057,"node_id":"PRRC_kwDOPaLyBs6n9YOB","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let mut auth_ctx = AuthContext {\n+                headers: outbound_headers.clone(),\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = auth_ctx.headers;\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood — thank you for confirming this will be addressed in a future feature implementation.\n\nWould you like me to create a GitHub issue to track the rate-limit scope enforcement work, or has one already been created?\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:17:19Z","updated_at":"2026-02-17T16:17:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817885057","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817885057"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817885057"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817885057/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":245,"original_start_line":224,"start_side":"RIGHT","line":253,"original_line":232,"side":"RIGHT","in_reply_to_id":2817019778,"author_association":"CONTRIBUTOR","original_position":232,"position":253,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817886129","pull_request_review_id":3814931855,"id":2817886129,"node_id":"PRRC_kwDOPaLyBs6n9Yex","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::collections::HashSet;\n+use std::time::Instant;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{RateLimitConfig, Window};\n+use dashmap::DashMap;\n+\n+pub struct RateLimiter {\n+    buckets: DashMap<String, TokenBucket>,\n+}\n+\n+struct TokenBucket {\n+    capacity: f64,\n+    tokens: f64,\n+    refill_rate: f64, // tokens per second\n+    last_refill: Instant,\n+}\n+\n+impl TokenBucket {\n+    fn new(config: &RateLimitConfig) -> Self {\n+        let capacity = config\n+            .burst\n+            .as_ref()\n+            .map_or(config.sustained.rate as f64, |b| b.capacity as f64);\n+        let window_secs = window_to_secs(&config.sustained.window);\n+        let refill_rate = config.sustained.rate as f64 / window_secs;\n+        Self {\n+            capacity,\n+            tokens: capacity,\n+            refill_rate,\n+            last_refill: Instant::now(),\n+        }\n+    }\n+\n+    fn refill(&mut self) {\n+        let now = Instant::now();\n+        let elapsed = now.duration_since(self.last_refill).as_secs_f64();\n+        self.tokens = (self.tokens + elapsed * self.refill_rate).min(self.capacity);\n+        self.last_refill = now;\n+    }\n+\n+    fn try_consume(&mut self, cost: f64) -> bool {\n+        self.refill();\n+        if self.tokens >= cost {\n+            self.tokens -= cost;\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    fn retry_after_secs(&self, cost: f64) -> u64 {\n+        if self.refill_rate <= 0.0 {\n+            return 60;\n+        }\n+        let needed = cost - self.tokens;\n+        if needed <= 0.0 {\n+            return 0;\n+        }\n+        (needed / self.refill_rate).ceil() as u64\n+    }\n+}\n+\n+fn window_to_secs(window: &Window) -> f64 {\n+    match window {\n+        Window::Second => 1.0,\n+        Window::Minute => 60.0,\n+        Window::Hour => 3600.0,\n+        Window::Day => 86400.0,\n+    }\n+}\n+\n+impl RateLimiter {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self {\n+            buckets: DashMap::new(),\n+        }\n+    }\n+\n+    /// Remove all entries whose keys are not in `active_keys`.\n+    ///\n+    // TODO: Wire into management service delete operations (upstream/route)\n+    // so that stale rate-limit buckets are purged when entities are removed.\n+    #[allow(dead_code)]\n+    pub fn purge_keys(&self, active_keys: &HashSet<String>) {\n+        self.buckets.retain(|k, _| active_keys.contains(k));\n+    }\n+\n+    /// Try to consume tokens for the given key.\n+    ///\n+    /// # Errors\n+    /// Returns `DomainError::RateLimitExceeded` with Retry-After seconds when exhausted.\n+    pub fn try_consume(\n+        &self,\n+        key: &str,\n+        config: &RateLimitConfig,\n+        instance_uri: &str,\n+    ) -> Result<(), DomainError> {\n+        let cost = config.cost as f64;\n+        let mut bucket = self\n+            .buckets\n+            .entry(key.to_string())\n+            .or_insert_with(|| TokenBucket::new(config));\n+","path":"modules/system/oagw/oagw/src/domain/rate_limit.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood — thank you for clarifying that this is a deliberate trade-off for the initial implementation and will be addressed alongside rate-limit scope enforcement in a future feature. I appreciate that the limitation is documented in the design.\n\nNo further action needed on this point. 👍\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:17:34Z","updated_at":"2026-02-17T16:17:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817886129","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817886129"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817886129"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817886129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":97,"original_start_line":94,"start_side":"RIGHT","line":108,"original_line":105,"side":"RIGHT","in_reply_to_id":2817019745,"author_association":"CONTRIBUTOR","original_position":105,"position":108,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817942763","pull_request_review_id":3815000520,"id":2817942763,"node_id":"PRRC_kwDOPaLyBs6n9mTr","diff_hunk":"@@ -1,5 +1,19 @@\n-#![allow(dead_code)]\n-\n-pub mod client;\n+pub mod api;\n+pub mod body;\n pub mod error;\n-pub mod plugin;\n+\n+pub mod models;\n+\n+pub use models::{\n+    AuthConfig, BurstConfig, CreateRouteRequest, CreateRouteRequestBuilder, CreateUpstreamRequest,\n+    CreateUpstreamRequestBuilder, Endpoint, GrpcMatch, HeadersConfig, HttpMatch, HttpMethod,\n+    ListQuery, MatchRules, PassthroughMode, PathSuffixMode, PluginsConfig, RateLimitAlgorithm,\n+    RateLimitConfig, RateLimitScope, RateLimitStrategy, RequestHeaderRules, ResponseHeaderRules,\n+    Route, Scheme, Server, SharingMode, SustainedRate, UpdateRouteRequest,\n+    UpdateRouteRequestBuilder, UpdateUpstreamRequest, UpdateUpstreamRequestBuilder, Upstream,\n+    Window,\n+};\n+\n+pub use api::ServiceGatewayClientV1;\n+pub use body::Body;\n+pub use modkit_security::SecurityContext;","path":"modules/system/oagw/oagw-sdk/src/lib.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It is a greenfield project no need to think about public API","created_at":"2026-02-17T16:31:14Z","updated_at":"2026-02-17T16:31:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817942763","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817942763"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817942763"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817942763/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":19,"original_line":19,"side":"RIGHT","in_reply_to_id":2817019737,"author_association":"MEMBER","original_position":23,"position":23,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817944699","pull_request_review_id":3815002870,"id":2817944699,"node_id":"PRRC_kwDOPaLyBs6n9mx7","diff_hunk":"@@ -0,0 +1,332 @@\n+use crate::domain::model::{PassthroughMode, RequestHeaderRules};\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+\n+const HOP_BY_HOP_HEADERS: &[&str] = &[\n+    \"connection\",\n+    \"keep-alive\",\n+    \"proxy-authenticate\",\n+    \"proxy-authorization\",\n+    \"te\",\n+    \"trailer\",\n+    \"transfer-encoding\",\n+    \"upgrade\",\n+];\n+\n+/// Sensitive headers that must never be forwarded to upstream services,\n+/// even when `PassthroughMode::All` is used.\n+const STRIPPED_HEADERS: &[&str] = &[\n+    \"authorization\",\n+    \"cookie\",\n+    \"proxy-authorization\",\n+    \"set-cookie\",\n+];\n+\n+/// Apply passthrough filter: decide which inbound headers to forward.\n+/// Content-Type is always forwarded when present (needed for POST/PUT bodies).\n+pub fn apply_passthrough(\n+    inbound: &HeaderMap,\n+    mode: &PassthroughMode,\n+    allowlist: &[String],\n+) -> HeaderMap {\n+    let mut out = match mode {\n+        PassthroughMode::None => HeaderMap::new(),\n+        PassthroughMode::All => inbound.clone(),\n+        PassthroughMode::Allowlist => {\n+            let mut h = HeaderMap::new();\n+            for name in allowlist {\n+                if let Ok(n) = HeaderName::from_bytes(name.to_lowercase().as_bytes())\n+                    && let Some(v) = inbound.get(&n)\n+                {\n+                    h.insert(n, v.clone());\n+                }\n+            }\n+            h\n+        }\n+    };\n+\n+    // Always forward Content-Type if present.\n+    if !out.contains_key(http::header::CONTENT_TYPE)\n+        && let Some(ct) = inbound.get(http::header::CONTENT_TYPE)\n+    {\n+        out.insert(http::header::CONTENT_TYPE, ct.clone());\n+    }\n+\n+    // Strip sensitive headers that must never leak to upstream.\n+    for name in STRIPPED_HEADERS {\n+        out.remove(*name);\n+    }\n+\n+    out\n+}\n+\n+/// Remove hop-by-hop headers that must not be forwarded.\n+pub fn strip_hop_by_hop(headers: &mut HeaderMap) {\n+    for name in HOP_BY_HOP_HEADERS {\n+        headers.remove(*name);\n+    }\n+}","path":"modules/system/oagw/oagw/src/infra/proxy/headers.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/22553
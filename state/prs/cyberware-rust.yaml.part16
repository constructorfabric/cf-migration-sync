-rust/pulls/comments/2819581763"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2819581763"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2819581763/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":49,"original_line":47,"side":"RIGHT","author_association":"MEMBER","original_position":47,"position":49,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821023552","pull_request_review_id":3818474478,"id":2821023552,"node_id":"PRRC_kwDOPaLyBs6oJWdA","diff_hunk":"@@ -0,0 +1,16 @@\n+use axum::Router;\n+use axum::routing::any;\n+\n+use super::super::handlers;\n+\n+/// Register the proxy catch-all route.\n+///\n+/// Uses manual route registration because the proxy endpoint accepts all HTTP\n+/// methods on a wildcard path, which doesn't fit the OperationBuilder's\n+/// single-method pattern.\n+pub(super) fn register(router: Router) -> Router {\n+    router.route(","path":"modules/system/oagw/oagw/src/api/rest/routes/proxy.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9deec0b2c8887c2eea31867a016943e4187fb623","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes. Auth is enforced by the API Gateway's `AuthPolicyLayer` middleware which runs before all module routes — it validates tokens and injects `SecurityContext` as an Axum extension. The handler extracts `Extension(ctx): Extension<SecurityContext>` and would fail with 500 if the middleware hasn't run. The proxy route doesn't use `.require_auth()` on OperationBuilder (since it's manually registered), but the gateway-level middleware covers it.","created_at":"2026-02-18T08:35:48Z","updated_at":"2026-02-18T08:35:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821023552","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821023552"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821023552"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821023552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":12,"original_line":12,"side":"RIGHT","in_reply_to_id":2819563503,"author_association":"MEMBER","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024093","pull_request_review_id
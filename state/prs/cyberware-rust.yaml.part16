ea814632df97d508624362a221003b4b2f36e","original_commit_id":"9deec0b2c8887c2eea31867a016943e4187fb623","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Valid point. There's no validation of endpoint hosts against private/internal IP ranges (169.254.x.x, 10.x.x.x, 127.0.0.1, etc.) or cloud metadata endpoints. An authenticated tenant could configure an upstream pointing to internal infrastructure.\n\nThis needs a thoughtful approach — simple IP blocklisting isn't sufficient (DNS rebinding, IPv6 mapped addresses, etc.). Will address in a follow-up with a proper server-address validation layer. Tracking separately to not block the current PR.","created_at":"2026-02-18T08:35:54Z","updated_at":"2026-02-18T08:35:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821024093","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024093"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821024093"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":82,"original_line":58,"side":"RIGHT","in_reply_to_id":2819575665,"author_association":"MEMBER","original_position":58,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024215","pull_request_review_id":3818475157,"id":2821024215,"node_id":"PRRC_kwDOPaLyBs6oJWnX","diff_hunk":"@@ -0,0 +1,321 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9deec0b2c8887c2eea31867a016943e4187fb623","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good catch — fixed. Added `.redirect(reqwest::redirect::Policy::none())` to the HTTP client builder. Upstream redirects are now returned as-is (3xx) to the caller instead of being followed. This prevents an upstream from redirecting to internal/metadata endpoints.","created_at":"2026-02-18T08:35:56Z","updated_at":"2026-02-18T08:35:56Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821024215","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024215"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2821024215"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2821024215/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":49,"original_line":47,"side":"RIGHT","in_reply_to_id":2819581763,"author_association":"MEMBER","original_position":47,"position":49,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580846","pull_request_review_id":3822357469,"id":2824580846,"node_id":"PRRC_kwDOPaLyBs6oW67u","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Bug (critical).** `DomainError::NotFound { entity, id }` always maps to `ServiceGatewayError::RouteNotFound`, regardless of entity type. When `get_upstream` returns NotFound, the SDK caller sees `RouteNotFound` — wrong entity, wrong message. The `entity` field is silently discarded.\n\nAdd an `UpstreamNotFound` variant to the SDK error, or use a generic `NotFound { entity, instance }` variant. The existing test on line 703 even documents this — it asserts that an upstream-not-found maps to `RouteNotFound` and treats it as correct.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580846","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580846"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580846"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580846/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":204,"side":"RIGHT","author_association":"MEMBER","original_position":204,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580848","pull_request_review_id":3822357469,"id":2824580848,"node_id":"PRRC_kwDOPaLyBs6oW67w","diff_hunk":"@@ -0,0 +1,105 @@\n+use axum::Router;\n+use modkit::api::OpenApiRegistry;\n+use modkit::api::operation_builder::OperationBuilder;\n+\n+use super::super::dto;\n+use super::super::handlers;\n+use super::License;\n+\n+pub(super) fn register(mut router: Router, openapi: &dyn OpenApiRegistry) -> Router {\n+    // POST /oagw/v1/routes — Create route\n+    router = OperationBuilder::post(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.create_route\")\n+        .summary(\"Create route\")\n+        .description(\"Create a new route mapping for an upstream service\")\n+        .tag(\"routes\")\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .json_request::<dto::CreateRouteRequest>(openapi, \"Route configuration\")\n+        .handler(handlers::route::create_route)\n+        .json_response_with_schema::<dto::RouteResponse>(\n+            openapi,\n+            http::StatusCode::CREATED,\n+            \"Created route\",\n+        )\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{id} — Get route\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{id}\")\n+        .operation_id(\"oagw.get_route\")\n+        .summary(\"Get route by ID\")\n+        .description(\"Retrieve a specific route by its GTS identifier\")\n+        .tag(\"routes\")\n+        .path_param(\"id\", \"Route GTS identifier\")\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .handler(handlers::route::get_route)\n+        .json_response_with_schema::<dto::RouteResponse>(\n+            openapi,\n+            http::StatusCode::OK,\n+            \"Route found\",\n+        )\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // PUT /oagw/v1/routes/{id} — Update route\n+    router = OperationBuilder::put(\"/oagw/v1/routes/{id}\")","path":"modules/system/oagw/oagw/src/api/rest/routes/route.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Incorrect HTTP method (critical).** `UpdateRouteRequest` fields are all `Option<T>` — that's partial-update semantics (PATCH). PUT means full replacement (RFC 7231 §4.3.4): any field omitted should reset to its default, not be preserved.\n\nSame issue in `routes/upstream.rs:71`. Either switch both to `PATCH`, or make PUT request bodies fully required.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580848","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580848"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580848"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":47,"side":"RIGHT","author_association":"MEMBER","original_position":47,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580851","pull_request_review_id":3822357469,"id":2824580851,"node_id":"PRRC_kwDOPaLyBs6oW67z","diff_hunk":"@@ -0,0 +1,336 @@\n+use std::collections::HashMap;\n+\n+use modkit_macros::domain_model;\n+use uuid::Uuid;\n+\n+// ---------------------------------------------------------------------------\n+// Shared enums\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Endpoint / Server\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct Endpoint {\n+    pub scheme: Scheme,\n+    pub host: String,\n+    pub port: u16,\n+}\n+\n+impl Endpoint {\n+    #[must_use]\n+    pub fn alias_contribution(&self) -> String {\n+        if self.port == 443 || self.port == 80 {\n+            self.host.clone()\n+        } else {\n+            format!(\"{}:{}\", self.host, self.port)\n+        }\n+    }\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Server {\n+    pub endpoints: Vec<Endpoint>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// AuthConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct AuthConfig {\n+    pub plugin_type: String,\n+    pub sharing: SharingMode,\n+    pub config: Option<HashMap<String, String>>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// HeadersConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct HeadersConfig {\n+    pub request: Option<RequestHeaderRules>,\n+    pub response: Option<ResponseHeaderRules>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct RequestHeaderRules {\n+    pub set: HashMap<String, String>,\n+    pub add: HashMap<String, String>,\n+    pub remove: Vec<String>,\n+    pub passthrough: PassthroughMode,\n+    pub passthrough_allowlist: Vec<String>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct ResponseHeaderRules {\n+    pub set: HashMap<String, String>,\n+    pub add: HashMap<String, String>,\n+    pub remove: Vec<String>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum PassthroughMode {\n+    #[default]\n+    None,\n+    Allowlist,\n+    All,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// RateLimitConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct RateLimitConfig {\n+    pub sharing: SharingMode,\n+    pub algorithm: RateLimitAlgorithm,\n+    pub sustained: SustainedRate,\n+    pub burst: Option<BurstConfig>,\n+    pub scope: RateLimitScope,\n+    pub strategy: RateLimitStrategy,\n+    pub cost: u32,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitAlgorithm {\n+    #[default]\n+    TokenBucket,\n+    SlidingWindow,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct SustainedRate {\n+    pub rate: u32,\n+    pub window: Window,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum Window {\n+    #[default]\n+    Second,\n+    Minute,\n+    Hour,\n+    Day,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct BurstConfig {\n+    pub capacity: u32,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitScope {\n+    Global,\n+    #[default]\n+    Tenant,\n+    User,\n+    Ip,\n+    Route,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitStrategy {\n+    #[default]\n+    Reject,\n+    Queue,\n+    Degrade,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// PluginsConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct PluginsConfig {\n+    pub sharing: SharingMode,\n+    pub items: Vec<String>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Route matching\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n+pub enum HttpMethod {\n+    Get,\n+    Post,\n+    Put,\n+    Delete,\n+    Patch,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum PathSuffixMode {\n+    Disabled,\n+    #[default]\n+    Append,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct HttpMatch {\n+    pub methods: Vec<HttpMethod>,\n+    pub path: String,\n+    pub query_allowlist: Vec<String>,\n+    pub path_suffix_mode: PathSuffixMode,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct GrpcMatch {\n+    pub service: String,\n+    pub method: String,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct MatchRules {\n+    pub http: Option<HttpMatch>,\n+    pub grpc: Option<GrpcMatch>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Domain entities\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Route {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub upstream_id: Uuid,\n+    pub match_rules: MatchRules,\n+    pub plugins: Option<PluginsConfig>,\n+    pub rate_limit: Option<RateLimitConfig>,\n+    pub tags: Vec<String>,\n+    pub priority: i32,\n+    pub enabled: bool,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Upstream {","path":"modules/system/oagw/oagw/src/domain/model.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Maintainability.** `Upstream` (and every other model) is defined four times: `oagw-sdk/models.rs`, `domain/model.rs`, `api/rest/dto.rs`, `infra/type_provisioning.rs`. Each copy has its own `From` impls — ~600 lines total of `sdk::Foo::A => domain::Foo::A` mapping.\n\nAdding a single field means touching four files. Consider using SDK types in the domain layer directly (they're already transport-agnostic), or a shared crate with conditional derives.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580851","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580851"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580851"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580851/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":252,"original_line":252,"side":"RIGHT","author_association":"MEMBER","original_position":252,"position":252,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580852","pull_request_review_id":3822357469,"id":2824580852,"node_id":"PRRC_kwDOPaLyBs6oW670","diff_hunk":"@@ -0,0 +1,254 @@\n+use std::pin::Pin;\n+\n+use bytes::Bytes;\n+use futures_core::Stream;\n+\n+/// Boxed error type for body stream errors.\n+pub type BoxError = Box<dyn std::error::Error + Send + Sync>;\n+\n+/// A streaming body.\n+pub type BodyStream = Pin<Box<dyn Stream<Item = Result<Bytes, BoxError>> + Send>>;\n+\n+/// Unified body type for gateway proxy requests and responses.\n+///\n+/// Covers every protocol through a single `proxy_request` call:\n+/// - `Empty` — no body (GET, HEAD, DELETE)\n+/// - `Bytes` — buffered body (small JSON payloads, typical API calls)\n+/// - `Stream` — streaming body (SSE, chunked transfer, large payloads,\n+///   **and WebSocket messages** serialized as byte chunks)\n+///\n+/// # Protocol mapping\n+///\n+/// | Protocol  | Request Body          | Response Body          |\n+/// |-----------|-----------------------|------------------------|\n+/// | HTTP      | `Body::Bytes`/`Empty` | `Body::Bytes`          |\n+/// | SSE       | `Body::Bytes`/`Empty` | `Body::Stream`         |\n+/// | WebSocket | `Body::Stream`        | `Body::Stream`         |\n+pub enum Body {\n+    /// No body.\n+    Empty,\n+    /// Fully buffered body.\n+    Bytes(Bytes),\n+    /// Streaming body (SSE responses, WebSocket messages, chunked transfers).\n+    Stream(BodyStream),\n+}\n+\n+impl std::fmt::Debug for Body {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        match self {\n+            Body::Empty => write!(f, \"Body::Empty\"),\n+            Body::Bytes(b) => write!(f, \"Body::Bytes({} bytes)\", b.len()),\n+            Body::Stream(_) => write!(f, \"Body::Stream(...)\"),\n+        }\n+    }\n+}\n+\n+impl Body {\n+    /// Returns `true` if this is an empty body.\n+    #[must_use]\n+    pub fn is_empty(&self) -> bool {\n+        matches!(self, Body::Empty)\n+    }\n+\n+    /// Consume this body into `Bytes`, buffering a stream if necessary.\n+    ///\n+    /// For `Body::Stream`, reads the entire stream into memory. Use with\n+    /// caution on unbounded streams (SSE, etc.).\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if a stream chunk fails.\n+    pub async fn into_bytes(self) -> Result<Bytes, BoxError> {\n+        match self {\n+            Body::Empty => Ok(Bytes::new()),\n+            Body::Bytes(b) => Ok(b),\n+            Body::Stream(mut s) => {\n+                use futures_util::StreamExt;\n+                let mut buf = Vec::new();\n+                while let Some(chunk) = s.next().await {\n+                    buf.extend_from_slice(&chunk?);\n+                }\n+                Ok(Bytes::from(buf))\n+            }\n+        }\n+    }\n+\n+    /// Extract the inner `BodyStream`, converting other variants as needed.\n+    ///\n+    /// - `Empty` → empty stream\n+    /// - `Bytes` → single-item stream\n+    /// - `Stream` → pass-through\n+    pub fn into_stream(self) -> BodyStream {\n+        match self {\n+            Body::Empty => Box::pin(futures_util::stream::empty()),\n+            Body::Bytes(b) => Box::pin(futures_util::stream::once(async { Ok(b) })),\n+            Body::Stream(s) => s,\n+        }\n+    }\n+\n+    /// Extract the inner `Bytes`.\n+    ///\n+    /// # Panics\n+    ///\n+    /// Panics if this is not `Body::Bytes`.\n+    #[must_use]\n+    pub fn expect_bytes(self) -> Bytes {","path":"modules/system/oagw/oagw-sdk/src/body.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Panicking public API.** `expect_bytes()` and `expect_stream()` (line 108) panic on wrong variant. This is a public SDK — consumers have no compile-time guarantee which variant they'll get. Replace with `try_into_bytes(self) -> Result<Bytes, Self>` or just drop them. `into_bytes().await` and `into_stream()` already handle all variants safely.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580852","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580852"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580852"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":95,"side":"RIGHT","author_association":"MEMBER","original_position":95,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580853","pull_request_review_id":3822357469,"id":2824580853,"node_id":"PRRC_kwDOPaLyBs6oW671","diff_hunk":"@@ -0,0 +1,323 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // Never follow redirects — upstream could redirect to internal/metadata IPs.\n+            .redirect(reqwest::redirect::Policy::none())\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Docs claim WebSocket support, implementation doesn't.** The body is fully buffered into `Bytes` here, then forwarded as a single reqwest body. `body.rs` doc comment (lines 17-27) claims WebSocket via `Body::Stream`, but the proxy never passes a stream through — it consumes everything into memory. Either drop the WebSocket claims or implement bidirectional streaming.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580853","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580853"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580853"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":107,"original_line":106,"side":"RIGHT","author_association":"MEMBER","original_position":106,"position":107,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580855","pull_request_review_id":3822357469,"id":2824580855,"node_id":"PRRC_kwDOPaLyBs6oW673","diff_hunk":"@@ -0,0 +1,591 @@\n+use std::sync::Arc;\n+\n+use super::ControlPlaneService;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{\n+    CreateRouteRequest, CreateUpstreamRequest, ListQuery, Route, UpdateRouteRequest,\n+    UpdateUpstreamRequest, Upstream,\n+};\n+use crate::domain::repo::{RouteRepository, UpstreamRepository};\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+/// Control Plane service implementation backed by in-memory repositories.\n+#[domain_model]\n+pub(crate) struct ControlPlaneServiceImpl {\n+    upstreams: Arc<dyn UpstreamRepository>,\n+    routes: Arc<dyn RouteRepository>,\n+}\n+\n+impl ControlPlaneServiceImpl {\n+    #[must_use]\n+    pub(crate) fn new(\n+        upstreams: Arc<dyn UpstreamRepository>,\n+        routes: Arc<dyn RouteRepository>,\n+    ) -> Self {\n+        Self { upstreams, routes }\n+    }\n+}\n+\n+/// Generate an alias from the upstream's server endpoints.\n+/// Single endpoint: host (standard port omitted) or host:port.\n+fn generate_alias(upstream: &Upstream) -> String {\n+    let endpoints = &upstream.server.endpoints;\n+    if endpoints.is_empty() {\n+        return String::new();\n+    }\n+    // Use the first endpoint for alias generation.\n+    endpoints[0].alias_contribution()\n+}\n+\n+#[async_trait::async_trait]\n+impl ControlPlaneService for ControlPlaneServiceImpl {\n+    // -- Upstream CRUD --\n+\n+    async fn create_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let id = Uuid::new_v4();\n+\n+        let upstream = Upstream {\n+            id,\n+            tenant_id,\n+            alias: String::new(),\n+            server: req.server.clone(),\n+            protocol: req.protocol.clone(),\n+            enabled: req.enabled,\n+            auth: req.auth.clone(),\n+            headers: req.headers.clone(),\n+            plugins: req.plugins.clone(),\n+            rate_limit: req.rate_limit.clone(),\n+            tags: req.tags.clone(),\n+        };\n+\n+        let alias = req","path":"modules/system/oagw/oagw/src/domain/services/management.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Missing input validation.** Alias comes from user input with no checks. An alias of `../../admin`, empty string, or 10KB of unicode is accepted and stored. Since alias is matched against URL path segments (`/oagw/v1/proxy/{alias}/...`), this is a path traversal concern. Validate: non-empty, max length, safe charset (alphanumeric + `.:-_`).","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580855","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580855"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580855"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":92,"original_line":68,"side":"RIGHT","author_association":"MEMBER","original_position":68,"position":92,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580858","pull_request_review_id":3822357469,"id":2824580858,"node_id":"PRRC_kwDOPaLyBs6oW676","diff_hunk":"@@ -0,0 +1,591 @@\n+use std::sync::Arc;\n+\n+use super::ControlPlaneService;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{\n+    CreateRouteRequest, CreateUpstreamRequest, ListQuery, Route, UpdateRouteRequest,\n+    UpdateUpstreamRequest, Upstream,\n+};\n+use crate::domain::repo::{RouteRepository, UpstreamRepository};\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+/// Control Plane service implementation backed by in-memory repositories.\n+#[domain_model]\n+pub(crate) struct ControlPlaneServiceImpl {\n+    upstreams: Arc<dyn UpstreamRepository>,\n+    routes: Arc<dyn RouteRepository>,\n+}\n+\n+impl ControlPlaneServiceImpl {\n+    #[must_use]\n+    pub(crate) fn new(\n+        upstreams: Arc<dyn UpstreamRepository>,\n+        routes: Arc<dyn RouteRepository>,\n+    ) -> Self {\n+        Self { upstreams, routes }\n+    }\n+}\n+\n+/// Generate an alias from the upstream's server endpoints.\n+/// Single endpoint: host (standard port omitted) or host:port.\n+fn generate_alias(upstream: &Upstream) -> String {\n+    let endpoints = &upstream.server.endpoints;\n+    if endpoints.is_empty() {\n+        return String::new();\n+    }\n+    // Use the first endpoint for alias generation.\n+    endpoints[0].alias_contribution()\n+}\n+\n+#[async_trait::async_trait]\n+impl ControlPlaneService for ControlPlaneServiceImpl {\n+    // -- Upstream CRUD --\n+\n+    async fn create_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let id = Uuid::new_v4();\n+\n+        let upstream = Upstream {\n+            id,\n+            tenant_id,\n+            alias: String::new(),\n+            server: req.server.clone(),\n+            protocol: req.protocol.clone(),\n+            enabled: req.enabled,\n+            auth: req.auth.clone(),\n+            headers: req.headers.clone(),\n+            plugins: req.plugins.clone(),\n+            rate_limit: req.rate_limit.clone(),\n+            tags: req.tags.clone(),\n+        };\n+\n+        let alias = req\n+            .alias\n+            .clone()\n+            .unwrap_or_else(|| generate_alias(&upstream));\n+\n+        let upstream = Upstream { alias, ..upstream };\n+\n+        self.upstreams\n+            .create(upstream)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn get_upstream(&self, ctx: &SecurityContext, id: Uuid) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.upstreams\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: &SecurityContext,\n+        query: &ListQuery,\n+    ) -> Result<Vec<Upstream>, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.upstreams\n+            .list(tenant_id, query)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        req: UpdateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let mut existing = self\n+            .upstreams\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))?;\n+\n+        // Apply partial update.\n+        if let Some(server) = req.server {\n+            existing.server = server;\n+        }\n+        if let Some(protocol) = req.protocol {\n+            existing.protocol = protocol;\n+        }\n+        if let Some(alias) = req.alias {\n+            existing.alias = alias;\n+        }\n+        if let Some(auth) = req.auth {\n+            existing.auth = Some(auth);\n+        }\n+        if let Some(headers) = req.headers {\n+            existing.headers = Some(headers);\n+        }\n+        if let Some(plugins) = req.plugins {\n+            existing.plugins = Some(plugins);\n+        }\n+        if let Some(rate_limit) = req.rate_limit {\n+            existing.rate_limit = Some(rate_limit);\n+        }\n+        if let Some(tags) = req.tags {\n+            existing.tags = tags;\n+        }\n+        if let Some(enabled) = req.enabled {\n+            existing.enabled = enabled;\n+        }\n+\n+        self.upstreams\n+            .update(existing)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn delete_upstream(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        // Cascade delete routes.\n+        let _ = self.routes.delete_by_upstream(tenant_id, id).await;\n+        self.upstreams\n+            .delete(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))\n+    }\n+\n+    // -- Route CRUD --\n+\n+    async fn create_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateRouteRequest,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        // Validate that the upstream exists and belongs to this tenant.\n+        self.upstreams\n+            .get_by_id(tenant_id, req.upstream_id)\n+            .await\n+            .map_err(|_| {\n+                DomainError::validation(format!(\n+                    \"upstream '{}' not found for this tenant\",\n+                    req.upstream_id\n+                ))\n+            })?;\n+\n+        let route = Route {\n+            id: Uuid::new_v4(),\n+            tenant_id,\n+            upstream_id: req.upstream_id,\n+            match_rules: req.match_rules,\n+            plugins: req.plugins,\n+            rate_limit: req.rate_limit,\n+            tags: req.tags,\n+            priority: req.priority,\n+            enabled: req.enabled,\n+        };\n+\n+        self.routes.create(route).await.map_err(DomainError::from)\n+    }\n+\n+    async fn get_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: &SecurityContext,\n+        upstream_id: Uuid,\n+        query: &ListQuery,\n+    ) -> Result<Vec<Route>, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .list_by_upstream(tenant_id, upstream_id, query)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        req: UpdateRouteRequest,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let mut existing = self\n+            .routes\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))?;\n+\n+        if let Some(match_rules) = req.match_rules {\n+            existing.match_rules = match_rules;\n+        }\n+        if let Some(plugins) = req.plugins {\n+            existing.plugins = Some(plugins);\n+        }\n+        if let Some(rate_limit) = req.rate_limit {\n+            existing.rate_limit = Some(rate_limit);\n+        }\n+        if let Some(tags) = req.tags {\n+            existing.tags = tags;\n+        }\n+        if let Some(priority) = req.priority {\n+            existing.priority = priority;\n+        }\n+        if let Some(enabled) = req.enabled {\n+            existing.enabled = enabled;\n+        }\n+\n+        self.routes\n+            .update(existing)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn delete_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .delete(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))\n+    }\n+\n+    // -- Resolution --\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        alias: &str,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let upstream = self\n+            .upstreams\n+            .get_by_alias(tenant_id, alias)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", Uuid::nil()))?;\n+\n+        if !upstream.enabled {\n+            return Err(DomainError::upstream_disabled(alias));\n+        }\n+\n+        Ok(upstream)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes","path":"modules/system/oagw/oagw/src/domain/services/management.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**O(n) per proxy request.** `find_matching` scans all routes for the upstream on every request. Fine with <100 routes, but this is the hot path. Worth documenting the scaling limit, or indexing routes by (method, path_prefix) for O(log N) lookup.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580858","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580858"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580858"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":316,"original_line":289,"side":"RIGHT","author_association":"MEMBER","original_position":289,"position":316,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580861","pull_request_review_id":3822357469,"id":2824580861,"node_id":"PRRC_kwDOPaLyBs6oW679","diff_hunk":"@@ -0,0 +1,323 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // Never follow redirects — upstream could redirect to internal/metadata IPs.\n+            .redirect(reqwest::redirect::Policy::none())\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**No path normalization.** The URI path is split as-is. Requests like `/oagw/v1/proxy/alias/../admin/secret` or `/alias//v1//chat` will bypass route matching or hit unexpected routes. Normalize before extraction: collapse `//`, resolve `..`, reject paths that escape the alias prefix.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580861","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580861"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580861"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580861/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":82,"original_line":82,"side":"RIGHT","author_association":"MEMBER","original_position":82,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580862","pull_request_review_id":3822357469,"id":2824580862,"node_id":"PRRC_kwDOPaLyBs6oW67-","diff_hunk":"@@ -0,0 +1,92 @@\n+use std::collections::HashMap;\n+use std::fmt;\n+\n+use serde::{Deserialize, Serialize};\n+\n+/// Configuration for the OAGW module.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct OagwConfig {\n+    #[serde(default = \"default_proxy_timeout_secs\")]\n+    pub proxy_timeout_secs: u64,\n+    #[serde(default = \"default_max_body_size_bytes\")]\n+    pub max_body_size_bytes: usize,\n+    /// Optional credentials to pre-load into the in-memory credential resolver.\n+    /// Keys are secret references (e.g., `cred://openai-key`), values are secrets.\n+    /// Intended for development and testing only.\n+    #[serde(default)]\n+    pub credentials: HashMap<String, String>,","path":"modules/system/oagw/oagw/src/config.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Plaintext credentials in config.** Values sit in memory as plain `String`. The `Debug` redaction is good but doesn't prevent accidental serialization or memory dumps. For production, use `SecretString` for zeroize-on-drop and `Serialize`/`Debug` resistance. As a refernce: https://github.com/cyberfabric/cyberfabric-core/blob/main/libs/modkit-auth/src/oauth2/source.rs#L26\r\nThe \"dev only\" comment won't prevent production use.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:44:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580862","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580862"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580862"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":18,"original_line":18,"side":"RIGHT","author_association":"MEMBER","original_position":18,"position":18,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580865","pull_request_review_id":3822357469,"id":2824580865,"node_id":"PRRC_kwDOPaLyBs6oW68B","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {\n+            instance: format!(\"{entity}/{id}\"),\n+        },\n+        DomainError::Conflict { detail } => ServiceGatewayError::ValidationError {\n+            detail,\n+            instance: String::new(),\n+        },\n+        DomainError::Validation { detail, instance } => {\n+            ServiceGatewayError::ValidationError { detail, instance }\n+        }\n+        DomainError::UpstreamDisabled { alias } => ServiceGatewayError::UpstreamDisabled {\n+            detail: format!(\"upstream '{alias}' is disabled\"),\n+            instance: String::new(),\n+        },\n+        DomainError::Internal { message } => ServiceGatewayError::DownstreamError {\n+            detail: message,\n+            instance: String::new(),\n+        },\n+        DomainError::MissingTargetHost { instance } => {\n+            ServiceGatewayError::MissingTargetHost { instance }\n+        }\n+        DomainError::InvalidTargetHost { instance } => {\n+            ServiceGatewayError::InvalidTargetHost { instance }\n+        }\n+        DomainError::UnknownTargetHost { detail, instance } => {\n+            ServiceGatewayError::UnknownTargetHost { detail, instance }\n+        }\n+        DomainError::AuthenticationFailed { detail, instance } => {\n+            ServiceGatewayError::AuthenticationFailed { detail, instance }\n+        }\n+        DomainError::PayloadTooLarge { detail, instance } => {\n+            ServiceGatewayError::PayloadTooLarge { detail, instance }\n+        }\n+        DomainError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        } => ServiceGatewayError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        },\n+        DomainError::SecretNotFound { detail, instance } => {\n+            ServiceGatewayError::SecretNotFound { detail, instance }\n+        }\n+        DomainError::DownstreamError { detail, instance } => {\n+            ServiceGatewayError::DownstreamError { detail, instance }\n+        }\n+        DomainError::ProtocolError { detail, instance } => {\n+            ServiceGatewayError::ProtocolError { detail, instance }\n+        }\n+        DomainError::ConnectionTimeout { detail, instance } => {\n+            ServiceGatewayError::ConnectionTimeout { detail, instance }\n+        }\n+        DomainError::RequestTimeout { detail, instance } => {\n+            ServiceGatewayError::RequestTimeout { detail, instance }\n+        }\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// SDK request → domain request conversions (using SDK getters for private fields)\n+// ---------------------------------------------------------------------------\n+\n+fn sdk_create_upstream_to_domain(","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**~360 lines of mechanical mapping (lines 268-629).** Every `match` arm is `sdk::Foo::A => domain::Foo::A`. This is a direct consequence of the 4x model duplication — if the domain layer reused SDK types, this entire section disappears.","created_at":"2026-02-18T21:36:12Z","updated_at":"2026-02-18T21:36:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580865","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580865"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824580865"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824580865/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":269,"original_line":268,"side":"RIGHT","author_association":"MEMBER","original_position":268,"position":269,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704478","pull_request_review_id":3822483732,"id":2824704478,"node_id":"PRRC_kwDOPaLyBs6oXZHe","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Added a generic `NotFound { entity, instance }` variant to `ServiceGatewayError`. `DomainError::NotFound` now maps to `ServiceGatewayError::NotFound` preserving the entity type (e.g. \"upstream\"), instead of always mapping to `RouteNotFound`. Also split the GTS error type: route not-found gets `ERR_ROUTE_NOT_FOUND`, other entities get a generic `ERR_NOT_FOUND`. Updated the test at line 703 and the integration test.","created_at":"2026-02-18T22:11:08Z","updated_at":"2026-02-18T22:11:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704478","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704478"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704478"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704478/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":204,"side":"RIGHT","in_reply_to_id":2824580846,"author_association":"MEMBER","original_position":204,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704557","pull_request_review_id":3822483835,"id":2824704557,"node_id":"PRRC_kwDOPaLyBs6oXZIt","diff_hunk":"@@ -0,0 +1,105 @@\n+use axum::Router;\n+use modkit::api::OpenApiRegistry;\n+use modkit::api::operation_builder::OperationBuilder;\n+\n+use super::super::dto;\n+use super::super::handlers;\n+use super::License;\n+\n+pub(super) fn register(mut router: Router, openapi: &dyn OpenApiRegistry) -> Router {\n+    // POST /oagw/v1/routes — Create route\n+    router = OperationBuilder::post(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.create_route\")\n+        .summary(\"Create route\")\n+        .description(\"Create a new route mapping for an upstream service\")\n+        .tag(\"routes\")\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .json_request::<dto::CreateRouteRequest>(openapi, \"Route configuration\")\n+        .handler(handlers::route::create_route)\n+        .json_response_with_schema::<dto::RouteResponse>(\n+            openapi,\n+            http::StatusCode::CREATED,\n+            \"Created route\",\n+        )\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{id} — Get route\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{id}\")\n+        .operation_id(\"oagw.get_route\")\n+        .summary(\"Get route by ID\")\n+        .description(\"Retrieve a specific route by its GTS identifier\")\n+        .tag(\"routes\")\n+        .path_param(\"id\", \"Route GTS identifier\")\n+        .authenticated()\n+        .require_license_features::<License>([])\n+        .handler(handlers::route::get_route)\n+        .json_response_with_schema::<dto::RouteResponse>(\n+            openapi,\n+            http::StatusCode::OK,\n+            \"Route found\",\n+        )\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // PUT /oagw/v1/routes/{id} — Update route\n+    router = OperationBuilder::put(\"/oagw/v1/routes/{id}\")","path":"modules/system/oagw/oagw/src/api/rest/routes/route.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Both update endpoints switched from PUT to PATCH — routes and upstreams. Updated the `OperationBuilder` registration, the test router, and all test helpers/callers.","created_at":"2026-02-18T22:11:10Z","updated_at":"2026-02-18T22:11:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704557","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704557"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704557"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":47,"side":"RIGHT","in_reply_to_id":2824580848,"author_association":"MEMBER","original_position":47,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704712","pull_request_review_id":3822484010,"id":2824704712,"node_id":"PRRC_kwDOPaLyBs6oXZLI","diff_hunk":"@@ -0,0 +1,336 @@\n+use std::collections::HashMap;\n+\n+use modkit_macros::domain_model;\n+use uuid::Uuid;\n+\n+// ---------------------------------------------------------------------------\n+// Shared enums\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Endpoint / Server\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct Endpoint {\n+    pub scheme: Scheme,\n+    pub host: String,\n+    pub port: u16,\n+}\n+\n+impl Endpoint {\n+    #[must_use]\n+    pub fn alias_contribution(&self) -> String {\n+        if self.port == 443 || self.port == 80 {\n+            self.host.clone()\n+        } else {\n+            format!(\"{}:{}\", self.host, self.port)\n+        }\n+    }\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Server {\n+    pub endpoints: Vec<Endpoint>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// AuthConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct AuthConfig {\n+    pub plugin_type: String,\n+    pub sharing: SharingMode,\n+    pub config: Option<HashMap<String, String>>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// HeadersConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct HeadersConfig {\n+    pub request: Option<RequestHeaderRules>,\n+    pub response: Option<ResponseHeaderRules>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct RequestHeaderRules {\n+    pub set: HashMap<String, String>,\n+    pub add: HashMap<String, String>,\n+    pub remove: Vec<String>,\n+    pub passthrough: PassthroughMode,\n+    pub passthrough_allowlist: Vec<String>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct ResponseHeaderRules {\n+    pub set: HashMap<String, String>,\n+    pub add: HashMap<String, String>,\n+    pub remove: Vec<String>,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum PassthroughMode {\n+    #[default]\n+    None,\n+    Allowlist,\n+    All,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// RateLimitConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct RateLimitConfig {\n+    pub sharing: SharingMode,\n+    pub algorithm: RateLimitAlgorithm,\n+    pub sustained: SustainedRate,\n+    pub burst: Option<BurstConfig>,\n+    pub scope: RateLimitScope,\n+    pub strategy: RateLimitStrategy,\n+    pub cost: u32,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitAlgorithm {\n+    #[default]\n+    TokenBucket,\n+    SlidingWindow,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct SustainedRate {\n+    pub rate: u32,\n+    pub window: Window,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum Window {\n+    #[default]\n+    Second,\n+    Minute,\n+    Hour,\n+    Day,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct BurstConfig {\n+    pub capacity: u32,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitScope {\n+    Global,\n+    #[default]\n+    Tenant,\n+    User,\n+    Ip,\n+    Route,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum RateLimitStrategy {\n+    #[default]\n+    Reject,\n+    Queue,\n+    Degrade,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// PluginsConfig\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq, Default)]\n+pub struct PluginsConfig {\n+    pub sharing: SharingMode,\n+    pub items: Vec<String>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Route matching\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n+pub enum HttpMethod {\n+    Get,\n+    Post,\n+    Put,\n+    Delete,\n+    Patch,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub enum PathSuffixMode {\n+    Disabled,\n+    #[default]\n+    Append,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct HttpMatch {\n+    pub methods: Vec<HttpMethod>,\n+    pub path: String,\n+    pub query_allowlist: Vec<String>,\n+    pub path_suffix_mode: PathSuffixMode,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct GrpcMatch {\n+    pub service: String,\n+    pub method: String,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct MatchRules {\n+    pub http: Option<HttpMatch>,\n+    pub grpc: Option<GrpcMatch>,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Domain entities\n+// ---------------------------------------------------------------------------\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Route {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub upstream_id: Uuid,\n+    pub match_rules: MatchRules,\n+    pub plugins: Option<PluginsConfig>,\n+    pub rate_limit: Option<RateLimitConfig>,\n+    pub tags: Vec<String>,\n+    pub priority: i32,\n+    pub enabled: bool,\n+}\n+\n+#[domain_model]\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct Upstream {","path":"modules/system/oagw/oagw/src/domain/model.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged. The 4× model duplication is a deliberate trade-off for layer isolation at this stage, but agreed it adds maintenance overhead. Will address in a follow-up refactor — likely by sharing SDK types in the domain layer or introducing a shared crate.","created_at":"2026-02-18T22:11:13Z","updated_at":"2026-02-18T22:11:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704712","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704712"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704712"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704712/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":252,"original_line":252,"side":"RIGHT","in_reply_to_id":2824580851,"author_association":"MEMBER","original_position":252,"position":252,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704834","pull_request_review_id":3822484142,"id":2824704834,"node_id":"PRRC_kwDOPaLyBs6oXZNC","diff_hunk":"@@ -0,0 +1,254 @@\n+use std::pin::Pin;\n+\n+use bytes::Bytes;\n+use futures_core::Stream;\n+\n+/// Boxed error type for body stream errors.\n+pub type BoxError = Box<dyn std::error::Error + Send + Sync>;\n+\n+/// A streaming body.\n+pub type BodyStream = Pin<Box<dyn Stream<Item = Result<Bytes, BoxError>> + Send>>;\n+\n+/// Unified body type for gateway proxy requests and responses.\n+///\n+/// Covers every protocol through a single `proxy_request` call:\n+/// - `Empty` — no body (GET, HEAD, DELETE)\n+/// - `Bytes` — buffered body (small JSON payloads, typical API calls)\n+/// - `Stream` — streaming body (SSE, chunked transfer, large payloads,\n+///   **and WebSocket messages** serialized as byte chunks)\n+///\n+/// # Protocol mapping\n+///\n+/// | Protocol  | Request Body          | Response Body          |\n+/// |-----------|-----------------------|------------------------|\n+/// | HTTP      | `Body::Bytes`/`Empty` | `Body::Bytes`          |\n+/// | SSE       | `Body::Bytes`/`Empty` | `Body::Stream`         |\n+/// | WebSocket | `Body::Stream`        | `Body::Stream`         |\n+pub enum Body {\n+    /// No body.\n+    Empty,\n+    /// Fully buffered body.\n+    Bytes(Bytes),\n+    /// Streaming body (SSE responses, WebSocket messages, chunked transfers).\n+    Stream(BodyStream),\n+}\n+\n+impl std::fmt::Debug for Body {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        match self {\n+            Body::Empty => write!(f, \"Body::Empty\"),\n+            Body::Bytes(b) => write!(f, \"Body::Bytes({} bytes)\", b.len()),\n+            Body::Stream(_) => write!(f, \"Body::Stream(...)\"),\n+        }\n+    }\n+}\n+\n+impl Body {\n+    /// Returns `true` if this is an empty body.\n+    #[must_use]\n+    pub fn is_empty(&self) -> bool {\n+        matches!(self, Body::Empty)\n+    }\n+\n+    /// Consume this body into `Bytes`, buffering a stream if necessary.\n+    ///\n+    /// For `Body::Stream`, reads the entire stream into memory. Use with\n+    /// caution on unbounded streams (SSE, etc.).\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns an error if a stream chunk fails.\n+    pub async fn into_bytes(self) -> Result<Bytes, BoxError> {\n+        match self {\n+            Body::Empty => Ok(Bytes::new()),\n+            Body::Bytes(b) => Ok(b),\n+            Body::Stream(mut s) => {\n+                use futures_util::StreamExt;\n+                let mut buf = Vec::new();\n+                while let Some(chunk) = s.next().await {\n+                    buf.extend_from_slice(&chunk?);\n+                }\n+                Ok(Bytes::from(buf))\n+            }\n+        }\n+    }\n+\n+    /// Extract the inner `BodyStream`, converting other variants as needed.\n+    ///\n+    /// - `Empty` → empty stream\n+    /// - `Bytes` → single-item stream\n+    /// - `Stream` → pass-through\n+    pub fn into_stream(self) -> BodyStream {\n+        match self {\n+            Body::Empty => Box::pin(futures_util::stream::empty()),\n+            Body::Bytes(b) => Box::pin(futures_util::stream::once(async { Ok(b) })),\n+            Body::Stream(s) => s,\n+        }\n+    }\n+\n+    /// Extract the inner `Bytes`.\n+    ///\n+    /// # Panics\n+    ///\n+    /// Panics if this is not `Body::Bytes`.\n+    #[must_use]\n+    pub fn expect_bytes(self) -> Bytes {","path":"modules/system/oagw/oagw-sdk/src/body.rs","commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Replaced `expect_bytes()` and `expect_stream()` with fallible `try_into_bytes(self) -> Result<Bytes, Self>` and `try_into_stream(self) -> Result<BodyStream, Self>`. No callers were using the panicking variants outside of tests. Updated tests accordingly.","created_at":"2026-02-18T22:11:15Z","updated_at":"2026-02-18T22:11:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704834","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704834"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824704834"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824704834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":95,"side":"RIGHT","in_reply_to_id":2824580852,"author_association":"MEMBER","original_position":95,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714432","pull_request_review_id":3822493966,"id":2824714432,"node_id":"PRRC_kwDOPaLyBs6oXbjA","diff_hunk":"@@ -0,0 +1,323 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // Never follow redirects — upstream could redirect to internal/metadata IPs.\n+            .redirect(reqwest::redirect::Policy::none())\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged. The WebSocket claims in the doc comment are aspirational — the proxy currently buffers the body and streams the response but doesn't do bidirectional WebSocket. Will clean up the docs to reflect the actual implementation (HTTP + SSE) and add WebSocket support as a separate feature.","created_at":"2026-02-18T22:14:11Z","updated_at":"2026-02-18T22:14:11Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714432","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714432"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714432"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714432/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":107,"original_line":106,"side":"RIGHT","in_reply_to_id":2824580853,"author_association":"MEMBER","original_position":106,"position":107,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714521","pull_request_review_id":3822494027,"id":2824714521,"node_id":"PRRC_kwDOPaLyBs6oXbkZ","diff_hunk":"@@ -0,0 +1,591 @@\n+use std::sync::Arc;\n+\n+use super::ControlPlaneService;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{\n+    CreateRouteRequest, CreateUpstreamRequest, ListQuery, Route, UpdateRouteRequest,\n+    UpdateUpstreamRequest, Upstream,\n+};\n+use crate::domain::repo::{RouteRepository, UpstreamRepository};\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+/// Control Plane service implementation backed by in-memory repositories.\n+#[domain_model]\n+pub(crate) struct ControlPlaneServiceImpl {\n+    upstreams: Arc<dyn UpstreamRepository>,\n+    routes: Arc<dyn RouteRepository>,\n+}\n+\n+impl ControlPlaneServiceImpl {\n+    #[must_use]\n+    pub(crate) fn new(\n+        upstreams: Arc<dyn UpstreamRepository>,\n+        routes: Arc<dyn RouteRepository>,\n+    ) -> Self {\n+        Self { upstreams, routes }\n+    }\n+}\n+\n+/// Generate an alias from the upstream's server endpoints.\n+/// Single endpoint: host (standard port omitted) or host:port.\n+fn generate_alias(upstream: &Upstream) -> String {\n+    let endpoints = &upstream.server.endpoints;\n+    if endpoints.is_empty() {\n+        return String::new();\n+    }\n+    // Use the first endpoint for alias generation.\n+    endpoints[0].alias_contribution()\n+}\n+\n+#[async_trait::async_trait]\n+impl ControlPlaneService for ControlPlaneServiceImpl {\n+    // -- Upstream CRUD --\n+\n+    async fn create_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let id = Uuid::new_v4();\n+\n+        let upstream = Upstream {\n+            id,\n+            tenant_id,\n+            alias: String::new(),\n+            server: req.server.clone(),\n+            protocol: req.protocol.clone(),\n+            enabled: req.enabled,\n+            auth: req.auth.clone(),\n+            headers: req.headers.clone(),\n+            plugins: req.plugins.clone(),\n+            rate_limit: req.rate_limit.clone(),\n+            tags: req.tags.clone(),\n+        };\n+\n+        let alias = req","path":"modules/system/oagw/oagw/src/domain/services/management.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Added `validate_alias()` that enforces: non-empty, max 253 characters, safe charset (alphanumeric + `.`, `:`, `-`, `_` only). Called in both `create_upstream` and `update_upstream`. Path traversal patterns like `../../admin` or `foo/bar` are now rejected. Added tests for empty, slashes, and traversal patterns.","created_at":"2026-02-18T22:14:12Z","updated_at":"2026-02-18T22:14:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714521","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714521"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714521"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714521/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":92,"original_line":68,"side":"RIGHT","in_reply_to_id":2824580855,"author_association":"MEMBER","original_position":68,"position":92,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714573","pull_request_review_id":3822494082,"id":2824714573,"node_id":"PRRC_kwDOPaLyBs6oXblN","diff_hunk":"@@ -0,0 +1,591 @@\n+use std::sync::Arc;\n+\n+use super::ControlPlaneService;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{\n+    CreateRouteRequest, CreateUpstreamRequest, ListQuery, Route, UpdateRouteRequest,\n+    UpdateUpstreamRequest, Upstream,\n+};\n+use crate::domain::repo::{RouteRepository, UpstreamRepository};\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+/// Control Plane service implementation backed by in-memory repositories.\n+#[domain_model]\n+pub(crate) struct ControlPlaneServiceImpl {\n+    upstreams: Arc<dyn UpstreamRepository>,\n+    routes: Arc<dyn RouteRepository>,\n+}\n+\n+impl ControlPlaneServiceImpl {\n+    #[must_use]\n+    pub(crate) fn new(\n+        upstreams: Arc<dyn UpstreamRepository>,\n+        routes: Arc<dyn RouteRepository>,\n+    ) -> Self {\n+        Self { upstreams, routes }\n+    }\n+}\n+\n+/// Generate an alias from the upstream's server endpoints.\n+/// Single endpoint: host (standard port omitted) or host:port.\n+fn generate_alias(upstream: &Upstream) -> String {\n+    let endpoints = &upstream.server.endpoints;\n+    if endpoints.is_empty() {\n+        return String::new();\n+    }\n+    // Use the first endpoint for alias generation.\n+    endpoints[0].alias_contribution()\n+}\n+\n+#[async_trait::async_trait]\n+impl ControlPlaneService for ControlPlaneServiceImpl {\n+    // -- Upstream CRUD --\n+\n+    async fn create_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let id = Uuid::new_v4();\n+\n+        let upstream = Upstream {\n+            id,\n+            tenant_id,\n+            alias: String::new(),\n+            server: req.server.clone(),\n+            protocol: req.protocol.clone(),\n+            enabled: req.enabled,\n+            auth: req.auth.clone(),\n+            headers: req.headers.clone(),\n+            plugins: req.plugins.clone(),\n+            rate_limit: req.rate_limit.clone(),\n+            tags: req.tags.clone(),\n+        };\n+\n+        let alias = req\n+            .alias\n+            .clone()\n+            .unwrap_or_else(|| generate_alias(&upstream));\n+\n+        let upstream = Upstream { alias, ..upstream };\n+\n+        self.upstreams\n+            .create(upstream)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn get_upstream(&self, ctx: &SecurityContext, id: Uuid) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.upstreams\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: &SecurityContext,\n+        query: &ListQuery,\n+    ) -> Result<Vec<Upstream>, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.upstreams\n+            .list(tenant_id, query)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        req: UpdateUpstreamRequest,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let mut existing = self\n+            .upstreams\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))?;\n+\n+        // Apply partial update.\n+        if let Some(server) = req.server {\n+            existing.server = server;\n+        }\n+        if let Some(protocol) = req.protocol {\n+            existing.protocol = protocol;\n+        }\n+        if let Some(alias) = req.alias {\n+            existing.alias = alias;\n+        }\n+        if let Some(auth) = req.auth {\n+            existing.auth = Some(auth);\n+        }\n+        if let Some(headers) = req.headers {\n+            existing.headers = Some(headers);\n+        }\n+        if let Some(plugins) = req.plugins {\n+            existing.plugins = Some(plugins);\n+        }\n+        if let Some(rate_limit) = req.rate_limit {\n+            existing.rate_limit = Some(rate_limit);\n+        }\n+        if let Some(tags) = req.tags {\n+            existing.tags = tags;\n+        }\n+        if let Some(enabled) = req.enabled {\n+            existing.enabled = enabled;\n+        }\n+\n+        self.upstreams\n+            .update(existing)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn delete_upstream(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        // Cascade delete routes.\n+        let _ = self.routes.delete_by_upstream(tenant_id, id).await;\n+        self.upstreams\n+            .delete(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", id))\n+    }\n+\n+    // -- Route CRUD --\n+\n+    async fn create_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: CreateRouteRequest,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        // Validate that the upstream exists and belongs to this tenant.\n+        self.upstreams\n+            .get_by_id(tenant_id, req.upstream_id)\n+            .await\n+            .map_err(|_| {\n+                DomainError::validation(format!(\n+                    \"upstream '{}' not found for this tenant\",\n+                    req.upstream_id\n+                ))\n+            })?;\n+\n+        let route = Route {\n+            id: Uuid::new_v4(),\n+            tenant_id,\n+            upstream_id: req.upstream_id,\n+            match_rules: req.match_rules,\n+            plugins: req.plugins,\n+            rate_limit: req.rate_limit,\n+            tags: req.tags,\n+            priority: req.priority,\n+            enabled: req.enabled,\n+        };\n+\n+        self.routes.create(route).await.map_err(DomainError::from)\n+    }\n+\n+    async fn get_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: &SecurityContext,\n+        upstream_id: Uuid,\n+        query: &ListQuery,\n+    ) -> Result<Vec<Route>, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .list_by_upstream(tenant_id, upstream_id, query)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        req: UpdateRouteRequest,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let mut existing = self\n+            .routes\n+            .get_by_id(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))?;\n+\n+        if let Some(match_rules) = req.match_rules {\n+            existing.match_rules = match_rules;\n+        }\n+        if let Some(plugins) = req.plugins {\n+            existing.plugins = Some(plugins);\n+        }\n+        if let Some(rate_limit) = req.rate_limit {\n+            existing.rate_limit = Some(rate_limit);\n+        }\n+        if let Some(tags) = req.tags {\n+            existing.tags = tags;\n+        }\n+        if let Some(priority) = req.priority {\n+            existing.priority = priority;\n+        }\n+        if let Some(enabled) = req.enabled {\n+            existing.enabled = enabled;\n+        }\n+\n+        self.routes\n+            .update(existing)\n+            .await\n+            .map_err(DomainError::from)\n+    }\n+\n+    async fn delete_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes\n+            .delete(tenant_id, id)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"route\", id))\n+    }\n+\n+    // -- Resolution --\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: &SecurityContext,\n+        alias: &str,\n+    ) -> Result<Upstream, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        let upstream = self\n+            .upstreams\n+            .get_by_alias(tenant_id, alias)\n+            .await\n+            .map_err(|_| DomainError::not_found(\"upstream\", Uuid::nil()))?;\n+\n+        if !upstream.enabled {\n+            return Err(DomainError::upstream_disabled(alias));\n+        }\n+\n+        Ok(upstream)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<Route, DomainError> {\n+        let tenant_id = ctx.subject_tenant_id();\n+        self.routes","path":"modules/system/oagw/oagw/src/domain/services/management.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged. The O(n) scan is fine for the current scale (<100 routes per upstream). Will document the scaling limit and consider indexing by (method, path_prefix) in a follow-up when we approach higher route counts.","created_at":"2026-02-18T22:14:13Z","updated_at":"2026-02-18T22:14:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714573","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714573"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714573"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":316,"original_line":289,"side":"RIGHT","in_reply_to_id":2824580858,"author_association":"MEMBER","original_position":289,"position":316,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714635","pull_request_review_id":3822494144,"id":2824714635,"node_id":"PRRC_kwDOPaLyBs6oXbmL","diff_hunk":"@@ -0,0 +1,323 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // Never follow redirects — upstream could redirect to internal/metadata IPs.\n+            .redirect(reqwest::redirect::Policy::none())\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed. Added `normalize_path()` to the proxy service that collapses `//`, resolves `.` and `..` segments, and clamps segments that would escape above root. Applied before alias/path_suffix extraction. Added tests covering double slashes, dot-dot traversal, single dots, root escape, and clean paths.","created_at":"2026-02-18T22:14:15Z","updated_at":"2026-02-18T22:14:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714635","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714635"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714635"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":82,"original_line":82,"side":"RIGHT","in_reply_to_id":2824580861,"author_association":"MEMBER","original_position":82,"position":82,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714719","pull_request_review_id":3822494231,"id":2824714719,"node_id":"PRRC_kwDOPaLyBs6oXbnf","diff_hunk":"@@ -0,0 +1,92 @@\n+use std::collections::HashMap;\n+use std::fmt;\n+\n+use serde::{Deserialize, Serialize};\n+\n+/// Configuration for the OAGW module.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct OagwConfig {\n+    #[serde(default = \"default_proxy_timeout_secs\")]\n+    pub proxy_timeout_secs: u64,\n+    #[serde(default = \"default_max_body_size_bytes\")]\n+    pub max_body_size_bytes: usize,\n+    /// Optional credentials to pre-load into the in-memory credential resolver.\n+    /// Keys are secret references (e.g., `cred://openai-key`), values are secrets.\n+    /// Intended for development and testing only.\n+    #[serde(default)]\n+    pub credentials: HashMap<String, String>,","path":"modules/system/oagw/oagw/src/config.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged. Good point about `SecretString` — the Debug redaction is a start but zeroize-on-drop would be better. Will switch to `SecretString` from `secrecy` crate in a follow-up, using the modkit-auth pattern as reference.","created_at":"2026-02-18T22:14:16Z","updated_at":"2026-02-18T22:14:16Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714719","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714719"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714719"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714719/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":18,"original_line":18,"side":"RIGHT","in_reply_to_id":2824580862,"author_association":"MEMBER","original_position":18,"position":18,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714786","pull_request_review_id":3822494303,"id":2824714786,"node_id":"PRRC_kwDOPaLyBs6oXboi","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {\n+            instance: format!(\"{entity}/{id}\"),\n+        },\n+        DomainError::Conflict { detail } => ServiceGatewayError::ValidationError {\n+            detail,\n+            instance: String::new(),\n+        },\n+        DomainError::Validation { detail, instance } => {\n+            ServiceGatewayError::ValidationError { detail, instance }\n+        }\n+        DomainError::UpstreamDisabled { alias } => ServiceGatewayError::UpstreamDisabled {\n+            detail: format!(\"upstream '{alias}' is disabled\"),\n+            instance: String::new(),\n+        },\n+        DomainError::Internal { message } => ServiceGatewayError::DownstreamError {\n+            detail: message,\n+            instance: String::new(),\n+        },\n+        DomainError::MissingTargetHost { instance } => {\n+            ServiceGatewayError::MissingTargetHost { instance }\n+        }\n+        DomainError::InvalidTargetHost { instance } => {\n+            ServiceGatewayError::InvalidTargetHost { instance }\n+        }\n+        DomainError::UnknownTargetHost { detail, instance } => {\n+            ServiceGatewayError::UnknownTargetHost { detail, instance }\n+        }\n+        DomainError::AuthenticationFailed { detail, instance } => {\n+            ServiceGatewayError::AuthenticationFailed { detail, instance }\n+        }\n+        DomainError::PayloadTooLarge { detail, instance } => {\n+            ServiceGatewayError::PayloadTooLarge { detail, instance }\n+        }\n+        DomainError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        } => ServiceGatewayError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        },\n+        DomainError::SecretNotFound { detail, instance } => {\n+            ServiceGatewayError::SecretNotFound { detail, instance }\n+        }\n+        DomainError::DownstreamError { detail, instance } => {\n+            ServiceGatewayError::DownstreamError { detail, instance }\n+        }\n+        DomainError::ProtocolError { detail, instance } => {\n+            ServiceGatewayError::ProtocolError { detail, instance }\n+        }\n+        DomainError::ConnectionTimeout { detail, instance } => {\n+            ServiceGatewayError::ConnectionTimeout { detail, instance }\n+        }\n+        DomainError::RequestTimeout { detail, instance } => {\n+            ServiceGatewayError::RequestTimeout { detail, instance }\n+        }\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// SDK request → domain request conversions (using SDK getters for private fields)\n+// ---------------------------------------------------------------------------\n+\n+fn sdk_create_upstream_to_domain(","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"85c283dc715a5a799700a8c5dc586cfdec95909c","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Acknowledged. This is a direct consequence of the 4× model duplication (comment #3). Will be addressed together in the same refactor.","created_at":"2026-02-18T22:14:17Z","updated_at":"2026-02-18T22:14:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714786","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714786"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2824714786"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2824714786/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":269,"original_line":268,"side":"RIGHT","in_reply_to_id":2824580865,"author_association":"MEMBER","original_position":268,"position":269,"subject_type":"line"}],"source_reviews":[{"id":3813938351,"node_id":"PRR_kwDOPaLyBs7jVBSv","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"**Actionable comments posted: 8**\n\n> [!NOTE]\n> Due to the large number of review comments, Critical, Major severity comments were prioritized as inline comments.\n\n<details>\n<summary>🟡 Minor comments (20)</summary><blockquote>\n\n<details>\n<summary>modules/system/oagw/PRD.md-435-439 (1)</summary><blockquote>\n\n`435-439`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Add a language to the fenced block.**  \nMarkdownlint flags this. Use `text` (or `http`) for clarity.\n\n\n<details>\n<summary>✏️ Suggested fix</summary>\n\n```diff\n-```\n+```text\n {METHOD} /api/oagw/v1/proxy/{alias}[/{path}][?{query}]\n ```\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n````\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/PRD.md` around lines 435 - 439, The fenced code block\nshowing the Proxy API route should include a language tag to satisfy\nmarkdownlint; update the block that contains \"{METHOD}\n/api/oagw/v1/proxy/{alias}[/{path}][?{query}]\" to use a language like \"text\" or\n\"http\" (e.g., change ``` to ```text) so the fenced block becomes ```text ...\n```; locate the block in PRD.md where the Proxy API route is defined and add the\nlanguage tag.\n````\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/system/oagw/oagw/src/domain/error.rs-76-81 (1)</summary><blockquote>\n\n`76-81`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Avoid empty `instance` values for validation errors.**  \n`DomainError::validation` hardcodes `instance` to an empty string, which can strip useful context for Problem Details. Consider offering a constructor that accepts an instance so callers can pass a real value.\n\n\n<details>\n<summary>💡 Suggested fix</summary>\n\n```diff\n     #[must_use]\n     pub fn validation(detail: impl Into<String>) -> Self {\n-        Self::Validation {\n-            detail: detail.into(),\n-            instance: String::new(),\n-        }\n+        Self::validation_with_instance(detail, \"\")\n     }\n+\n+    #[must_use]\n+    pub fn validation_with_instance(\n+        detail: impl Into<String>,\n+        instance: impl Into<String>,\n+    ) -> Self {\n+        Self::Validation {\n+            detail: detail.into(),\n+            instance: instance.into(),\n+        }\n+    }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/domain/error.rs` around lines 76 - 81,\nDomainError::validation currently sets the Validation.instance to an empty\nstring which loses useful context; add a new constructor that accepts an\ninstance (or change validation to take an optional instance) and have the\noriginal validation() delegate to it for backwards compatibility. Specifically,\nadd a function like validation_with_instance(instance: impl Into<String>,\ndetail: impl Into<String>) -> Self (or validation(detail: impl Into<String>,\ninstance: impl Into<String>) -> Self) that constructs Self::Validation { detail:\ndetail.into(), instance: instance.into() } and update callers/tests to use the\nnew API where an instance is available.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/system/oagw/PRD.md-36-38 (1)</summary><blockquote>\n\n`36-38`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Fix TOC anchors for plugin sections.**  \nThe TOC fragments drop the `_` in `auth_plugin`, `guard_plugin`, and `transform_plugin`, which likely breaks GitHub anchor slugs. Update the fragments (or add explicit anchors).\n\n\n<details>\n<summary>✏️ Suggested fix</summary>\n\n```diff\n-    - [Auth Plugins (`gts.x.core.oagw.auth_plugin.v1~*`)](`#auth-plugins-gtsxcoreoagwauthpluginv1`)\n-    - [Guard Plugins (`gts.x.core.oagw.guard_plugin.v1~*`)](`#guard-plugins-gtsxcoreoagwguardpluginv1`)\n-    - [Transform Plugins (`gts.x.core.oagw.transform_plugin.v1~*`)](`#transform-plugins-gtsxcoreoagwtransformpluginv1`)\n+    - [Auth Plugins (`gts.x.core.oagw.auth_plugin.v1~*`)](`#auth-plugins-gtsxcoreoagwauth_pluginv1`)\n+    - [Guard Plugins (`gts.x.core.oagw.guard_plugin.v1~*`)](`#guard-plugins-gtsxcoreoagwguard_pluginv1`)\n+    - [Transform Plugins (`gts.x.core.oagw.transform_plugin.v1~*`)](`#transform-plugins-gtsxcoreoagwtransform_pluginv1`)\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/PRD.md` around lines 36 - 38, The table-of-contents\nanchors for the plugin sections use fragments that drop underscores and\ntherefore won't match the actual headings; update the TOC entries referencing\nauth_plugin, guard_plugin, and transform_plugin so their fragment links exactly\nmatch the headings (for example include the underscores or add explicit HTML\nanchors near the headings), ensuring the link targets like `auth_plugin`,\n`guard_plugin`, and `transform_plugin` resolve correctly.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/system/oagw/oagw/src/test_support/request.rs-62-69 (1)</summary><blockquote>\n\n`62-69`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Encode query keys/values before concatenation.**\nThe current `{k}={v}` join will break when keys/values contain `&`, `=` or spaces, producing ambiguous URIs. Please percent‑encode the query pairs before joining.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/test_support/request.rs` around lines 62 - 69,\nThe URI builder in send() currently concatenates query pairs with\nformat!(\"{k}={v}\") which breaks on reserved chars; instead percent-encode each\nkey and value before joining. In the send() function's query iteration, replace\nthe raw format with encoded versions of k and v (e.g. use\npercent_encoding::utf8_percent_encode or url::form_urlencoded utilities to\nencode k and v) and then join them with '&' so the final format remains \"{}?{}\",\nbut with encoded query components.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>testing/e2e/modules/oagw/mock_upstream.py-18-20 (1)</summary><blockquote>\n\n`18-20`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Silence unused‑argument warnings in handlers.**\nThese handlers don't use the `request` argument, so Ruff flags them. Renaming the parameter keeps intent clear and removes warnings.\n\n<details>\n<summary>💡 Suggested fix</summary>\n\n```diff\n-async def handle_health(request: web.Request) -> web.Response:\n+async def handle_health(_request: web.Request) -> web.Response:\n     return web.json_response({\"status\": \"ok\"})\n\n-async def handle_chat_completions(request: web.Request) -> web.Response:\n+async def handle_chat_completions(_request: web.Request) -> web.Response:\n     \"\"\"OpenAI-compatible chat completion response.\"\"\"\n     return web.json_response({\n\n-async def handle_models(request: web.Request) -> web.Response:\n+async def handle_models(_request: web.Request) -> web.Response:\n     \"\"\"OpenAI-compatible model list.\"\"\"\n     return web.json_response({\n\n-async def handle_error_timeout(request: web.Request) -> web.Response:\n+async def handle_error_timeout(_request: web.Request) -> web.Response:\n     \"\"\"Sleep long enough for the gateway proxy timeout to fire.\"\"\"\n     await asyncio.sleep(30)\n```\n\n</details>\n\n\nAlso applies to: 32-45, 48-56, 106-109\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/mock_upstream.py` around lines 18 - 20, The handlers\ncurrently accept an unused parameter named request (e.g., async def\nhandle_health(request: web.Request) -> web.Response) which triggers\nunused‑argument warnings; rename the parameter to _request (or _ ) in\nhandle_health and the other handler functions in this module so the signature\nremains explicit but Ruff no longer flags the variable as unused, leaving the\nfunction bodies unchanged.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>modules/system/oagw/docs/adr-component-architecture.md-55-64 (1)</summary><blockquote>\n\n`55-64`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Add a language identifier to the fenced code block.**\nMarkdownlint MD040 expects a language hint on fenced blocks.\n\n<details>\n<summary>💡 Suggested fix</summary>\n\n```diff\n-```\n+```text\n modules/system/oagw/\n ├── oagw-sdk/              # Public API: ServiceGatewayClientV1 trait, models, errors\n └── oagw/                  # Single module crate\n     └── src/\n         ├── api/rest/      # Transport layer (handlers, routes, DTOs)\n         ├── domain/        # Business logic (traits, models, errors)\n         │   └── services/  # ControlPlaneService + DataPlaneService\n         └── infra/         # Infrastructure (proxy, storage, plugins)\n ```\n```\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n````\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/docs/adr-component-architecture.md` around lines 55 - 64,\nThe fenced code block that shows the directory tree lacks a language hint; edit\nthe markdown (the ADR file containing the directory-tree code block) and change\nthe opening fence from ``` to ```text so the block becomes ```text followed by\nthe existing tree and closing ```, satisfying MD040.\n````\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>testing/e2e/modules/oagw/helpers.py-140-142 (1)</summary><blockquote>\n\n`140-142`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Default port should align with scheme.**\n\nWhen `parsed.port` is `None`, defaulting to `80` may be incorrect for `https` scheme (which should default to `443`). Consider deriving the default port from the scheme:\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n     host = parsed.hostname or \"127.0.0.1\"\n-    port = parsed.port or 80\n+    port = parsed.port or (443 if scheme == \"https\" else 80)\n     scheme = parsed.scheme or \"http\"\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/helpers.py` around lines 140 - 142, The default port\ncurrently hardcodes 80 even when parsed.scheme may be \"https\"; set scheme first\nfrom parsed.scheme (scheme = parsed.scheme or \"http\") and then derive port from\nparsed.port using the scheme (e.g., if parsed.port is None choose 443 for\n\"https\" else 80) so that the variables parsed, scheme, port, and host are\nupdated in that order and port defaults align with the scheme.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>testing/e2e/modules/oagw/test_sse_streaming.py-10-13 (1)</summary><blockquote>\n\n`10-13`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Mark `mock_upstream` as used to satisfy linting.**\n\nThese tests don’t reference the fixture directly, which triggers ARG001 warnings. If it’s only for side effects, add a no-op reference.\n\n<details>\n<summary>Example (apply similarly to other tests)</summary>\n\n```diff\n async def test_sse_proxy_content_type_and_done(\n     oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n ):\n     \"\"\"SSE proxy returns text/event-stream and ends with data: [DONE].\"\"\"\n+    _ = mock_upstream\n     alias = unique_alias(\"sse-ct\")\n```\n</details>\n\n\n\nAlso applies to: 41-44\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/test_sse_streaming.py` around lines 10 - 13, The\ntest function test_sse_proxy_content_type_and_done (and the similar test around\nlines 41-44) declares the fixture parameter mock_upstream but never references\nit, triggering ARG001; fix by adding a no-op reference to mock_upstream (e.g., a\nsimple underscore assignment or a pass-through comment using mock_upstream)\ninside the body of test_sse_proxy_content_type_and_done and the other test to\nmark the fixture as used while preserving its side effects.\n```\n\n</details>\n\n</blockquote></details>\n<details>\n<summary>testing/e2e/modules/oagw/test_error_handling.py-8-12 (1)</summary><blockquote>\n\n`8-12`: _⚠️ Potential issue_ | _🟡 Minor_\n\n**Mark `mock_upstream` as used to satisfy linting.**\n\nThe fixture parameter is unused in these tests, which triggers ARG001 warnings. If it’s only needed for side effects, add a no-op reference to mark it used.\n\n<details>\n<summary>Example (apply similarly to other tests)</summary>\n\n```diff\n async def test_nonexistent_alias
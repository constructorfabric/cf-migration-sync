/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Avoid committing plaintext API keys in config.**\n\nThe `sk-test-e2e-fake-key` literal is a secret value checked into the repo; even in e2e configs this increases risk and can leak via logs or forks. Prefer env expansion or a local, untracked secrets file (e.g., `${OPENAI_API_KEY}`) and document how to inject it for tests.  \n\n<details>\n<summary>🔧 Suggested safer pattern</summary>\n\n```diff\n   oagw:\n     config:\n       proxy_timeout_secs: 2\n       credentials:\n-        \"cred://openai-key\": \"sk-test-e2e-fake-key\"\n+        \"cred://openai-key\": \"${OPENAI_API_KEY}\"\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n  oagw:\n    config:\n      proxy_timeout_secs: 2\n      credentials:\n        \"cred://openai-key\": \"${OPENAI_API_KEY}\"\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@config/e2e-local.yaml` around lines 212 - 216, The config commits a plaintext\nAPI key (\"sk-test-e2e-fake-key\") under oagw.config.credentials which is a\nsecret; change the config to use environment expansion or a reference to an\nuntracked secrets file (e.g., replace the literal credential value with a\nplaceholder like ${OPENAI_API_KEY} or a local secret reference) and update\ndocumentation or tests to show how to inject OPENAI_API_KEY for e2e runs so no\nreal or fake keys are committed. Ensure the change touches the\noagw.config.credentials entry and any test setup that reads it so the runtime\nloads the key from env/local secrets instead of the hardcoded string.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T13:22:39Z","updated_at":"2026-02-17T13:59:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019691","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019691"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019691"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":212,"start_side":"RIGHT","line":null,"original_line":216,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019737","pull_request_review_id":3813938351,"id":2817019737,"node_id":"PRRC_kwDOPaLyBs6n6E9Z","diff_hunk":"@@ -1,5 +1,19 @@\n-#![allow(dead_code)]\n-\n-pub mod client;\n+pub mod api;\n+pub mod body;\n pub mod error;\n-pub mod plugin;\n+\n+pub mod models;\n+\n+pub use models::{\n+    AuthConfig, BurstConfig, CreateRouteRequest, CreateRouteRequestBuilder, CreateUpstreamRequest,\n+    CreateUpstreamRequestBuilder, Endpoint, GrpcMatch, HeadersConfig, HttpMatch, HttpMethod,\n+    ListQuery, MatchRules, PassthroughMode, PathSuffixMode, PluginsConfig, RateLimitAlgorithm,\n+    RateLimitConfig, RateLimitScope, RateLimitStrategy, RequestHeaderRules, ResponseHeaderRules,\n+    Route, Scheme, Server, SharingMode, SustainedRate, UpdateRouteRequest,\n+    UpdateRouteRequestBuilder, UpdateUpstreamRequest, UpdateUpstreamRequestBuilder, Upstream,\n+    Window,\n+};\n+\n+pub use api::ServiceGatewayClientV1;\n+pub use body::Body;\n+pub use modkit_security::SecurityContext;","path":"modules/system/oagw/oagw-sdk/src/lib.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Public API reshuffle is a breaking change—ensure semver or compatibility shims.**\n\nRemoving top-level `client`/`plugin` exports and replacing them with `api/body/models` will break downstream users. If this crate is published, consider a major version bump or temporary deprecated re-exports to ease migration.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw-sdk/src/lib.rs` around lines 1 - 19, The change\nremoved prior top-level exports (e.g., old client/plugin symbols) and will break\ndownstream users; either publish as a major semver bump or add temporary\ndeprecated compatibility re-exports that forward the old names to the new\nmodules (for example re-export the legacy client and plugin identifiers to\napi::ServiceGatewayClientV1, body::Body and modkit_security::SecurityContext\nwith #[deprecated] messages pointing to the new paths); implement the deprecated\nre-exports alongside the new api/body/models exports so consumers have time to\nmigrate before cutting a major version.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T13:22:40Z","updated_at":"2026-02-17T16:31:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019737","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019737"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019737"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":1,"original_start_line":1,"start_side":"RIGHT","line":19,"original_line":19,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":23,"position":23,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019745","pull_request_review_id":3813938351,"id":2817019745,"node_id":"PRRC_kwDOPaLyBs6n6E9h","diff_hunk":"@@ -0,0 +1,223 @@\n+use std::collections::HashSet;\n+use std::time::Instant;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{RateLimitConfig, Window};\n+use dashmap::DashMap;\n+\n+pub struct RateLimiter {\n+    buckets: DashMap<String, TokenBucket>,\n+}\n+\n+struct TokenBucket {\n+    capacity: f64,\n+    tokens: f64,\n+    refill_rate: f64, // tokens per second\n+    last_refill: Instant,\n+}\n+\n+impl TokenBucket {\n+    fn new(config: &RateLimitConfig) -> Self {\n+        let capacity = config\n+            .burst\n+            .as_ref()\n+            .map_or(config.sustained.rate as f64, |b| b.capacity as f64);\n+        let window_secs = window_to_secs(&config.sustained.window);\n+        let refill_rate = config.sustained.rate as f64 / window_secs;\n+        Self {\n+            capacity,\n+            tokens: capacity,\n+            refill_rate,\n+            last_refill: Instant::now(),\n+        }\n+    }\n+\n+    fn refill(&mut self) {\n+        let now = Instant::now();\n+        let elapsed = now.duration_since(self.last_refill).as_secs_f64();\n+        self.tokens = (self.tokens + elapsed * self.refill_rate).min(self.capacity);\n+        self.last_refill = now;\n+    }\n+\n+    fn try_consume(&mut self, cost: f64) -> bool {\n+        self.refill();\n+        if self.tokens >= cost {\n+            self.tokens -= cost;\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    fn retry_after_secs(&self, cost: f64) -> u64 {\n+        if self.refill_rate <= 0.0 {\n+            return 60;\n+        }\n+        let needed = cost - self.tokens;\n+        if needed <= 0.0 {\n+            return 0;\n+        }\n+        (needed / self.refill_rate).ceil() as u64\n+    }\n+}\n+\n+fn window_to_secs(window: &Window) -> f64 {\n+    match window {\n+        Window::Second => 1.0,\n+        Window::Minute => 60.0,\n+        Window::Hour => 3600.0,\n+        Window::Day => 86400.0,\n+    }\n+}\n+\n+impl RateLimiter {\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self {\n+            buckets: DashMap::new(),\n+        }\n+    }\n+\n+    /// Remove all entries whose keys are not in `active_keys`.\n+    ///\n+    // TODO: Wire into management service delete operations (upstream/route)\n+    // so that stale rate-limit buckets are purged when entities are removed.\n+    #[allow(dead_code)]\n+    pub fn purge_keys(&self, active_keys: &HashSet<String>) {\n+        self.buckets.retain(|k, _| active_keys.contains(k));\n+    }\n+\n+    /// Try to consume tokens for the given key.\n+    ///\n+    /// # Errors\n+    /// Returns `DomainError::RateLimitExceeded` with Retry-After seconds when exhausted.\n+    pub fn try_consume(\n+        &self,\n+        key: &str,\n+        config: &RateLimitConfig,\n+        instance_uri: &str,\n+    ) -> Result<(), DomainError> {\n+        let cost = config.cost as f64;\n+        let mut bucket = self\n+            .buckets\n+            .entry(key.to_string())\n+            .or_insert_with(|| TokenBucket::new(config));\n+","path":"modules/system/oagw/oagw/src/domain/rate_limit.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Buckets ignore updated rate-limit config after changes.**\n\n`try_consume` reuses an existing `TokenBucket` without reconfiguring it, so runtime updates to `RateLimitConfig` are ignored until a purge or restart. Consider reinitializing the bucket when derived parameters change.\n\n\n\n<details>\n<summary>🛠️ One way to reconfigure on change</summary>\n\n```diff\n impl TokenBucket {\n+    fn reconfigure_if_needed(&mut self, config: &RateLimitConfig) {\n+        let capacity = config\n+            .burst\n+            .as_ref()\n+            .map_or(config.sustained.rate as f64, |b| b.capacity as f64);\n+        let window_secs = window_to_secs(&config.sustained.window);\n+        let refill_rate = config.sustained.rate as f64 / window_secs;\n+        if (self.capacity - capacity).abs() > f64::EPSILON\n+            || (self.refill_rate - refill_rate).abs() > f64::EPSILON\n+        {\n+            *self = TokenBucket::new(config);\n+        }\n+    }\n }\n@@\n         let mut bucket = self\n             .buckets\n             .entry(key.to_string())\n             .or_insert_with(|| TokenBucket::new(config));\n+        bucket.reconfigure_if_needed(config);\n \n         if bucket.try_consume(cost) {\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    pub fn try_consume(\n        &self,\n        key: &str,\n        config: &RateLimitConfig,\n        instance_uri: &str,\n    ) -> Result<(), DomainError> {\n        let cost = config.cost as f64;\n        let mut bucket = self\n            .buckets\n            .entry(key.to_string())\n            .or_insert_with(|| TokenBucket::new(config));\n        bucket.reconfigure_if_needed(config);\n\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/domain/rate_limit.rs` around lines 94 - 105, The\nTokenBucket stored in the buckets map is reused in try_consume so runtime\nchanges to RateLimitConfig are ignored; update try_consume to detect when the\nexisting TokenBucket's derived parameters (e.g., capacity, refill_rate,\ncost-related fields) differ from the provided RateLimitConfig and either\nreinitialize or update the bucket accordingly. Locate the buckets HashMap and\nTokenBucket::new usage in try_consume and replace the or_insert_with-only\nbehavior with logic that: 1) fetches the existing TokenBucket for key, 2)\ncompares its stored config-derived fields to the incoming RateLimitConfig, and\n3) if they differ call a TokenBucket::reconfigure/update_from(config) or replace\nit with TokenBucket::new(config) before continuing to consume. Ensure the\ncomparison references concrete fields on TokenBucket (capacity/refill_rate/etc.)\nso config changes take effect immediately.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T13:22:40Z","updated_at":"2026-02-17T16:17:14Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019745","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019745"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019745"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019745/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":97,"original_start_line":94,"start_side":"RIGHT","line":108,"original_line":105,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":105,"position":108,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019759","pull_request_review_id":3813938351,"id":2817019759,"node_id":"PRRC_kwDOPaLyBs6n6E9v","diff_hunk":"@@ -0,0 +1,332 @@\n+use crate::domain::model::{PassthroughMode, RequestHeaderRules};\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+\n+const HOP_BY_HOP_HEADERS: &[&str] = &[\n+    \"connection\",\n+    \"keep-alive\",\n+    \"proxy-authenticate\",\n+    \"proxy-authorization\",\n+    \"te\",\n+    \"trailer\",\n+    \"transfer-encoding\",\n+    \"upgrade\",\n+];\n+\n+/// Sensitive headers that must never be forwarded to upstream services,\n+/// even when `PassthroughMode::All` is used.\n+const STRIPPED_HEADERS: &[&str] = &[\n+    \"authorization\",\n+    \"cookie\",\n+    \"proxy-authorization\",\n+    \"set-cookie\",\n+];\n+\n+/// Apply passthrough filter: decide which inbound headers to forward.\n+/// Content-Type is always forwarded when present (needed for POST/PUT bodies).\n+pub fn apply_passthrough(\n+    inbound: &HeaderMap,\n+    mode: &PassthroughMode,\n+    allowlist: &[String],\n+) -> HeaderMap {\n+    let mut out = match mode {\n+        PassthroughMode::None => HeaderMap::new(),\n+        PassthroughMode::All => inbound.clone(),\n+        PassthroughMode::Allowlist => {\n+            let mut h = HeaderMap::new();\n+            for name in allowlist {\n+                if let Ok(n) = HeaderName::from_bytes(name.to_lowercase().as_bytes())\n+                    && let Some(v) = inbound.get(&n)\n+                {\n+                    h.insert(n, v.clone());\n+                }\n+            }\n+            h\n+        }\n+    };\n+\n+    // Always forward Content-Type if present.\n+    if !out.contains_key(http::header::CONTENT_TYPE)\n+        && let Some(ct) = inbound.get(http::header::CONTENT_TYPE)\n+    {\n+        out.insert(http::header::CONTENT_TYPE, ct.clone());\n+    }\n+\n+    // Strip sensitive headers that must never leak to upstream.\n+    for name in STRIPPED_HEADERS {\n+        out.remove(*name);\n+    }\n+\n+    out\n+}\n+\n+/// Remove hop-by-hop headers that must not be forwarded.\n+pub fn strip_hop_by_hop(headers: &mut HeaderMap) {\n+    for name in HOP_BY_HOP_HEADERS {\n+        headers.remove(*name);\n+    }\n+}","path":"modules/system/oagw/oagw/src/infra/proxy/headers.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Strip `Connection`-listed hop-by-hop headers as well.**  \nHTTP/1.1 requires removing headers named in the `Connection` header; currently only the fixed list is removed, so connection-specific headers can leak upstream.  \n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n pub fn strip_hop_by_hop(headers: &mut HeaderMap) {\n+    if let Some(conn) = headers.get(http::header::CONNECTION) {\n+        if let Ok(conn_str) = conn.to_str() {\n+            for name in conn_str.split(',').map(|s| s.trim()) {\n+                if !name.is_empty() {\n+                    headers.remove(name);\n+                }\n+            }\n+        }\n+    }\n     for name in HOP_BY_HOP_HEADERS {\n         headers.remove(*name);\n     }\n }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n/// Remove hop-by-hop headers that must not be forwarded.\npub fn strip_hop_by_hop(headers: &mut HeaderMap) {\n    if let Some(conn) = headers.get(http::header::CONNECTION) {\n        if let Ok(conn_str) = conn.to_str() {\n            for name in conn_str.split(',').map(|s| s.trim()) {\n                if !name.is_empty() {\n                    headers.remove(name);\n                }\n            }\n        }\n    }\n    for name in HOP_BY_HOP_HEADERS {\n        headers.remove(*name);\n    }\n}\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/infra/proxy/headers.rs` around lines 62 - 67,\nThe current strip_hop_by_hop(headers: &mut HeaderMap) only removes fixed\nHOP_BY_HOP_HEADERS but must also remove any header names listed in the\nConnection header(s). Update strip_hop_by_hop to: 1) fetch all Connection header\nvalues (use headers.get_all or equivalent for the CONNECTION name), 2) split\neach value on commas, trim whitespace and normalize case to obtain header\ntokens, 3) remove each token-named header from the HeaderMap\n(headers.remove(token)), and 4) also remove the Connection header itself; keep\nthe existing removal of HOP_BY_HOP_HEADERS. Use the existing function name\nstrip_hop_by_hop and HeaderMap/HOP_BY_HOP_HEADERS identifiers when making the\nchange.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-17T13:22:40Z","updated_at":"2026-02-17T13:22:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019759","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019759"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817019759"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":62,"original_start_line":62,"start_side":"RIGHT","line":85,"original_line":67,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":67,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817019778","pull_request_review_id":3813938351,"id":2817019778,"node_id":"PRRC_kwDOPaLyBs6n6E-C","diff_hunk":"@@ -0,0 +1,302 @@\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let mut auth_ctx = AuthContext {\n+                headers: outbound_headers.clone(),\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = auth_ctx.headers;\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"d1fde6eab875166fb33d01c5d286df0b8c6712ab","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","grava
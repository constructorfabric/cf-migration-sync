use it's not referenced in the function body. In pytest, when a fixture is needed for its side effects (starting the mock server) but not for its return value, use `@pytest.mark.usefixtures` instead of including it as a parameter.\n\n<details>\n<summary>Example fix (apply to both tests)</summary>\n\n```diff\n-@pytest.mark.asyncio\n-async def test_invalid_content_length_returns_400(\n-    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n-):\n+@pytest.mark.usefixtures(\"mock_upstream\")\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url,\n-):\n```\n</details>\n\nAlso applies to: 73-76\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Ruff (0.15.1)</summary>\n\n[warning] 32-32: Unused function argument: `mock_upstream`\n\n(ARG001)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/test_body_validation.py` around lines 30 - 33, The\ntest functions (e.g., test_invalid_content_length_returns_400 and the other test\naround lines 73-76) include the mock_upstream fixture as an unused parameter\nwhich triggers lint warnings; make the dependency explicit by removing\nmock_upstream from the function signatures and adding\n`@pytest.mark.usefixtures`(\"mock_upstream\") above each test (keep existing\n`@pytest.mark.asyncio`), so the fixture runs for its side effects (starting the\nmock server) without being listed as a parameter.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:58:03Z","updated_at":"2026-02-17T17:07:46Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055424","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055424"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055424"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055424/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":30,"original_start_line":30,"start_side":"RIGHT","line":33,"original_line":33,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":33,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055428","pull_request_review_id":3815132047,"id":2818055428,"node_id":"PRRC_kwDOPaLyBs6n-B0E","diff_hunk":"@@ -0,0 +1,114 @@\n+\"\"\"E2E tests for OAGW body validation guardrails.\"\"\"\n+import asyncio\n+from urllib.parse import urlparse\n+\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+\n+async def _raw_http_request(host: str, port: int, raw_request: bytes, timeout: float = 10.0) -> str:\n+    \"\"\"Send a raw HTTP request and return the raw response as a string.\"\"\"\n+    reader, writer = await asyncio.wait_for(\n+        asyncio.open_connection(host, port), timeout=timeout,\n+    )\n+    writer.write(raw_request)\n+    await writer.drain()\n+    response = await asyncio.wait_for(reader.read(8192), timeout=timeout)\n+    writer.close()\n+    return response.decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _parse_status_code(raw_response: str) -> int:\n+    \"\"\"Extract the HTTP status code from a raw response.\"\"\"\n+    # e.g. \"HTTP/1.1 400 Bad Request\\r\\n...\"\n+    first_line = raw_response.split(\"\\r\\n\", 1)[0]\n+    return int(first_line.split(\" \", 2)[1])\n+\n+\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):\n+    \"\"\"Non-integer Content-Length returns 400.\"\"\"\n+    alias = unique_alias(\"body-cl\")\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        upstream = await create_upstream(\n+            client, oagw_base_url, oagw_headers, mock_upstream_url, alias=alias,\n+        )\n+        uid = upstream[\"id\"]\n+        await create_route(\n+            client, oagw_base_url, oagw_headers, uid, [\"POST\"], \"/v1/test\",\n+        )\n+\n+        # httpx/h11 rejects invalid Content-Length client-side, so use raw socket.\n+        parsed = urlparse(oagw_base_url)\n+        host = parsed.hostname or \"127.0.0.1\"\n+        port = parsed.port or 80\n+","path":"testing/e2e/modules/oagw/test_body_validation.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Raw socket helper doesn’t handle HTTPS base URLs.**\n\nIf `E2E_OAGW_BASE_URL` is `https://...`, `asyncio.open_connection` will fail without TLS. Consider skipping when scheme is https or add SSL support.  \n \n\n<details>\n<summary>Example guard</summary>\n\n```diff\n         parsed = urlparse(oagw_base_url)\n+        if parsed.scheme == \"https\":\n+            pytest.skip(\"raw socket helper does not support TLS; use http base URL\")\n         host = parsed.hostname or \"127.0.0.1\"\n```\n</details>\n\n\nAlso applies to: 90-93\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@testing/e2e/modules/oagw/test_body_validation.py` around lines 45 - 49, The\nraw-socket helper that parses oagw_base_url into parsed/host/port doesn't handle\nHTTPS; update the helper to detect parsed.scheme == \"https\" and either skip the\ntest or enable TLS by creating an SSLContext and passing ssl=ssl_context into\nasyncio.open_connection; modify the code around parsed, host, port and the place\nthat calls asyncio.open_connection so HTTPS URLs use TLS (or are skipped) to\nprevent connection failures.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:58:03Z","updated_at":"2026-02-17T17:07:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055428","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055428"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055428"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":45,"original_start_line":45,"start_side":"RIGHT","line":49,"original_line":49,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":49,"position":49,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093117","pull_request_review_id":3815176916,"id":2818093117,"node_id":"PRRC_kwDOPaLyBs6n-LA9","diff_hunk":"@@ -0,0 +1,254 @@\n+use std::pin::Pin;\n+\n+use bytes::Bytes;\n+use futures_core::Stream;\n+\n+/// Boxed error type for body stream errors.\n+pub type BoxError = Box<dyn std::error::Error + Send + Sync>;\n+\n+/// A streaming body.\n+pub type BodyStream = Pin<Box<dyn Stream<Item = Result<Bytes, BoxError>> + Send>>;\n+\n+/// Unified body type for gateway proxy requests and responses.\n+///\n+/// Covers every protocol through a single `proxy_request` call:\n+/// - `Empty` — no body (GET, HEAD, DELETE)\n+/// - `Bytes` — buffered body (small JSON payloads, typical API calls)\n+/// - `Stream` — streaming body (SSE, chunked transfer, large payloads,\n+///   **and WebSocket messages** serialized as byte chunks)\n+///\n+/// # Protocol mapping\n+///\n+/// | Protocol  | Request Body          | Response Body          |\n+/// |-----------|-----------------------|------------------------|\n+/// | HTTP      | `Body::Bytes`/`Empty` | `Body::Bytes`          |\n+/// | SSE       | `Body::Bytes`/`Empty` | `Body::Stream`         |\n+/// | WebSocket | `Body::Stream`        | `Body::Stream`         |\n+pub enum Body {\n+    /// No body.\n+    Empty,\n+    /// Fully buffered body.\n+    Bytes(Bytes),\n+    /// Streaming body (SSE responses, WebSocket messages, chunked transfers).\n+    Stream(BodyStream),\n+}\n+\n+impl std::fmt::Debug for Body {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        match self {\n+            Body::Empty => write!(f, \"Body::Empty\"),\n+            Body::Bytes(b) => write!(f, \"Body::Bytes({} bytes)\", b.len()),\n+            Body::Stream(_) => write!(f, \"Body::Stream(...)\"),\n+        }\n+    }\n+}\n+\n+impl Body {\n+    /// Returns `true` if this is an empty body.\n+    #[must_use]\n+    pub fn is_empty(&self) -> bool {\n+        matches!(self, Body::Empty)\n+    }","path":"modules/system/oagw/oagw-sdk/src/body.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Minor edge case — From<Bytes> already maps empty bytes to Body::Empty, so this would only matter if someone manually constructs Body::Bytes(Bytes::new()). Low risk but noted.","created_at":"2026-02-17T17:06:56Z","updated_at":"2026-02-17T17:06:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093117","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093117"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093117"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093117/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":46,"original_start_line":46,"start_side":"RIGHT","line":51,"original_line":51,"side":"RIGHT","in_reply_to_id":2818055369,"author_association":"MEMBER","original_position":51,"position":51,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093250","pull_request_review_id":3815177033,"id":2818093250,"node_id":"PRRC_kwDOPaLyBs6n-LDC","diff_hunk":"@@ -0,0 +1,911 @@\n+// REST DTOs for the OAGW API.\n+//\n+// These types own serde annotations and JSON schema concerns. They convert\n+// to/from internal domain types via `From` impls for the service layer boundary.\n+\n+use std::collections::HashMap;\n+\n+use serde::{Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+use crate::domain::model as domain;\n+\n+// ---------------------------------------------------------------------------\n+// Shared enums\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Endpoint / Server\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]\n+pub struct Endpoint {\n+    #[serde(default)]\n+    pub scheme: Scheme,\n+    pub host: String,\n+    #[serde(default = \"default_port\")]\n+    pub port: u16,\n+}\n+\n+fn default_port() -> u16 {\n+    443\n+}","path":"modules/system/oagw/oagw/src/api/rest/dto.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Duplicate of the default_port() finding — already acknowledged on the other comment. Will fix in a follow-up.","created_at":"2026-02-17T17:06:58Z","updated_at":"2026-02-17T17:06:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093250","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093250"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093250"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093250/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":41,"original_start_line":41,"start_side":"RIGHT","line":52,"original_line":52,"side":"RIGHT","in_reply_to_id":2818055383,"author_association":"MEMBER","original_position":52,"position":52,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093432","pull_request_review_id":3815177202,"id":2818093432,"node_id":"PRRC_kwDOPaLyBs6n-LF4","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {\n+            instance: format!(\"{entity}/{id}\"),\n+        },\n+        DomainError::Conflict { detail } => ServiceGatewayError::ValidationError {\n+            detail,\n+            instance: String::new(),\n+        },\n+        DomainError::Validation { detail, instance } => {\n+            ServiceGatewayError::ValidationError { detail, instance }\n+        }\n+        DomainError::UpstreamDisabled { alias } => ServiceGatewayError::UpstreamDisabled {\n+            detail: format!(\"upstream '{alias}' is disabled\"),\n+            instance: String::new(),\n+        },\n+        DomainError::Internal { message } => ServiceGatewayError::DownstreamError {\n+            detail: message,\n+            instance: String::new(),\n+        },\n+        DomainError::MissingTargetHost { instance } => {\n+            ServiceGatewayError::MissingTargetHost { instance }\n+        }\n+        DomainError::InvalidTargetHost { instance } => {\n+            ServiceGatewayError::InvalidTargetHost { instance }\n+        }\n+        DomainError::UnknownTargetHost { detail, instance } => {\n+            ServiceGatewayError::UnknownTargetHost { detail, instance }\n+        }\n+        DomainError::AuthenticationFailed { detail, instance } => {\n+            ServiceGatewayError::AuthenticationFailed { detail, instance }\n+        }\n+        DomainError::PayloadTooLarge { detail, instance } => {\n+            ServiceGatewayError::PayloadTooLarge { detail, instance }\n+        }\n+        DomainError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        } => ServiceGatewayError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        },\n+        DomainError::SecretNotFound { detail, instance } => {\n+            ServiceGatewayError::SecretNotFound { detail, instance }\n+        }\n+        DomainError::DownstreamError { detail, instance } => {\n+            ServiceGatewayError::DownstreamError { detail, instance }\n+        }\n+        DomainError::ProtocolError { detail, instance } => {\n+            ServiceGatewayError::ProtocolError { detail, instance }\n+        }\n+        DomainError::ConnectionTimeout { detail, instance } => {\n+            ServiceGatewayError::ConnectionTimeout { detail, instance }\n+        }\n+        DomainError::RequestTimeout { detail, instance } => {\n+            ServiceGatewayError::RequestTimeout { detail, instance }\n+        }\n+    }","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The SDK facade maps domain errors to SDK errors. The current mapping is intentionally coarse for the initial implementation — we expose a minimal error surface to SDK consumers. Finer error granularity can be added as the SDK stabilizes.","created_at":"2026-02-17T17:07:01Z","updated_at":"2026-02-17T17:07:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093432","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093432"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818093432"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818093432/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":202,"original_start_line":202,"start_side":"RIGHT","line":262,"original_line":261,"side":"RIGHT","in_reply_to_id":2818055389,"author_association":"MEMBER","original_position":261,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094488","pull_request_review_id":3815178403,"id":2818094488,"node_id":"PRRC_kwDOPaLyBs6n-LWY","diff_hunk":"@@ -0,0 +1,123 @@\n+use std::sync::Arc;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::plugin::{AuthContext, AuthPlugin, PluginError};\n+use serde::Deserialize;\n+\n+/// Configuration for the API key auth plugin.\n+#[derive(Debug, Deserialize)]\n+struct ApiKeyConfig {\n+    /// Header name to set (e.g. \"Authorization\", \"X-API-Key\").\n+    header: String,\n+    /// Prefix prepended to the secret value (e.g. \"Bearer \").\n+    #[serde(default)]\n+    prefix: String,\n+    /// Secret reference to resolve (e.g. \"cred://openai-key\").\n+    secret_ref: String,\n+}\n+\n+/// Auth plugin that resolves a secret reference and injects it as a header value.\n+pub struct ApiKeyAuthPlugin {\n+    credential_resolver: Arc<dyn CredentialResolver>,\n+}\n+\n+impl ApiKeyAuthPlugin {\n+    #[must_use]\n+    pub fn new(credential_resolver: Arc<dyn CredentialResolver>) -> Self {\n+        Self {\n+            credential_resolver,\n+        }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl AuthPlugin for ApiKeyAuthPlugin {\n+    async fn authenticate(&self, ctx: &mut AuthContext) -> Result<(), PluginError> {\n+        let config: ApiKeyConfig = serde_json::from_value(\n+            serde_json::to_value(&ctx.config)\n+                .map_err(|e| PluginError::Internal(format!(\"invalid apikey auth config: {e}\")))?,\n+        )\n+        .map_err(|e| PluginError::Internal(format!(\"invalid apikey auth config: {e}\")))?;\n+\n+        let secret = self\n+            .credential_resolver\n+            .resolve(&config.secret_ref)\n+            .await\n+            .map_err(|_| PluginError::SecretNotFound(config.secret_ref.clone()))?;","path":"modules/system/oagw/oagw/src/infra/plugin/apikey_auth.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fair point — collapsing all credential resolver errors into SecretNotFound loses information. In practice the only resolver implementation currently is the static config resolver which can only produce 'not found'. When we add a real cred-store integration, we'll add proper error variant mapping. Noted for that work.","created_at":"2026-02-17T17:07:18Z","updated_at":"2026-02-17T17:07:18Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094488","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094488"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094488"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094488/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":42,"original_start_line":42,"start_side":"RIGHT","line":46,"original_line":46,"side":"RIGHT","in_reply_to_id":2818055395,"author_association":"MEMBER","original_position":46,"position":46,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094650","pull_request_review_id":3815178536,"id":2818094650,"node_id":"PRRC_kwDOPaLyBs6n-LY6","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The HashMap<String, String> round-trip is intentional — it satisfies the DDD layer rule (DE0308: no http types in domain). Auth plugins operate on a transport-agnostic context. Non-UTF8 headers and multi-value headers are not expected in the auth flow (we only add/read specific known headers like Authorization). The trade-off is accepted.","created_at":"2026-02-17T17:07:20Z","updated_at":"2026-02-17T17:07:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094650","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094650"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094650"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":181,"original_start_line":178,"start_side":"RIGHT","line":224,"original_line":221,"side":"RIGHT","in_reply_to_id":2818055396,"author_association":"MEMBER","original_position":221,"position":224,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094789","pull_request_review_id":3815178660,"id":2818094789,"node_id":"PRRC_kwDOPaLyBs6n-LbF","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }\n+            }\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+\n+        // 7. Build URL.\n+        // path_suffix is the full path from the proxy URL; strip the route prefix\n+        // so we get: endpoint + route_path + remaining_suffix.\n+        let route_path = route\n+            .match_rules\n+            .http\n+            .as_ref()\n+            .map_or(\"/\", |h| h.path.as_str());\n+        let remaining_suffix = path_suffix.strip_prefix(route_path).unwrap_or(\"\");\n+        let url = request_builder::build_upstream_url(\n+            endpoint,\n+            route_path,\n+            remaining_suffix,\n+            &query_params,\n+        )?;\n+\n+        // 8. Forward request with timeout on response headers.\n+        let send_future = self\n+            .http_client\n+            .request(method, &url)\n+            .headers(outbound_headers)\n+            .body(body_bytes)\n+            .send();\n+\n+        let timeout = self.request_timeout;\n+        let response = tokio::time::timeout(timeout, send_future)\n+            .await\n+            .map_err(|_| DomainError::RequestTimeout {\n+                detail: format!(\"request to {url} timed out after {timeout:?}\"),\n+                instance: instance_uri.clone(),\n+            })?\n+            .map_err(|e| {\n+                if e.is_connect() {\n+                    DomainError::ConnectionTimeout {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                } else {\n+                    DomainError::DownstreamError {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                }\n+            })?;\n+\n+        // 9. Build streaming response.\n+        let status = response.status();\n+        let resp_headers = response.headers().clone();\n+\n+        let body_stream: BodyStream = Box::pin(\n+            response\n+                .bytes_stream()\n+                .map(|r| r.map_err(|e| Box::new(e) as BoxError)),\n+        );\n+\n+        let mut resp = http::Response::builder()\n+            .status(status)\n+            .body(Body::Stream(body_stream))\n+            .map_err(|e| DomainError::DownstreamError {\n+                detail: format!(\"failed to build response: {e}\"),\n+                instance: instance_uri,\n+            })?;\n+\n+        *resp.headers_mut() = resp_headers;\n+        resp.extensions_mut().insert(ErrorSource::Upstream);","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good catch — sanitize_response_headers() exists and is tested but is not called on the upstream response path. The response headers from upstream are copied verbatim. This needs to be fixed. Will address in a follow-up commit.","created_at":"2026-02-17T17:07:22Z","updated_at":"2026-02-17T17:07:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094789","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094789"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818094789"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818094789/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":300,"original_start_line":297,"start_side":"RIGHT","line":320,"original_line":316,"side":"RIGHT","in_reply_to_id":2818055405,"author_association":"MEMBER","original_position":316,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095238","pull_request_review_id":3815179076,"id":2818095238,"node_id":"PRRC_kwDOPaLyBs6n-LiG","diff_hunk":"@@ -0,0 +1,211 @@\n+\"\"\"Shared helpers for OAGW E2E tests.\"\"\"\n+import re\n+import uuid\n+\n+import httpx\n+\n+# ---------------------------------------------------------------------------\n+# OAGW GTS type catalog — mirrors the Rust catalog in domain/type_catalog.rs\n+# ---------------------------------------------------------------------------\n+\n+# Schema GTS identifiers (7)\n+UPSTREAM_SCHEMA = \"gts.x.core.oagw.upstream.v1~\"\n+ROUTE_SCHEMA = \"gts.x.core.oagw.route.v1~\"\n+PROTOCOL_SCHEMA = \"gts.x.core.oagw.protocol.v1~\"\n+AUTH_PLUGIN_SCHEMA = \"gts.x.core.oagw.auth_plugin.v1~\"\n+GUARD_PLUGIN_SCHEMA = \"gts.x.core.oagw.guard_plugin.v1~\"\n+TRANSFORM_PLUGIN_SCHEMA = \"gts.x.core.oagw.transform_plugin.v1~\"\n+PROXY_SCHEMA = \"gts.x.core.oagw.proxy.v1~\"\n+\n+# Protocol instances (2)\n+HTTP_PROTOCOL_ID = \"gts.x.core.oagw.protocol.v1~x.core.oagw.http.v1\"\n+GRPC_PROTOCOL_ID = \"gts.x.core.oagw.protocol.v1~x.core.oagw.grpc.v1\"\n+\n+# Auth plugin instances (6)\n+NOOP_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.noop.v1\"\n+APIKEY_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.apikey.v1\"\n+BASIC_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.basic.v1\"\n+BEARER_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.bearer.v1\"\n+OAUTH2_CLIENT_CRED_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.oauth2_client_cred.v1\"\n+OAUTH2_CLIENT_CRED_BASIC_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.oauth2_client_cred_basic.v1\"\n+\n+# Guard plugin instances (2)\n+TIMEOUT_GUARD_PLUGIN_ID = \"gts.x.core.oagw.guard_plugin.v1~x.core.oagw.timeout.v1\"\n+CORS_GUARD_PLUGIN_ID = \"gts.x.core.oagw.guard_plugin.v1~x.core.oagw.cors.v1\"\n+\n+# Transform plugin instances (3)\n+LOGGING_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.logging.v1\"\n+METRICS_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.metrics.v1\"\n+REQUEST_ID_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.request_id.v1\"\n+\n+# Grouped for assertions\n+OAGW_SCHEMAS = [\n+    UPSTREAM_SCHEMA, ROUTE_SCHEMA, PROTOCOL_SCHEMA,\n+    AUTH_PLUGIN_SCHEMA, GUARD_PLUGIN_SCHEMA, TRANSFORM_PLUGIN_SCHEMA,\n+    PROXY_SCHEMA,\n+]\n+\n+OAGW_INSTANCES = [\n+    HTTP_PROTOCOL_ID, GRPC_PROTOCOL_ID,\n+    NOOP_AUTH_PLUGIN_ID, APIKEY_AUTH_PLUGIN_ID, BASIC_AUTH_PLUGIN_ID,\n+    BEARER_AUTH_PLUGIN_ID, OAUTH2_CLIENT_CRED_AUTH_PLUGIN_ID,\n+    OAUTH2_CLIENT_CRED_BASIC_AUTH_PLUGIN_ID,\n+    TIMEOUT_GUARD_PLUGIN_ID, CORS_GUARD_PLUGIN_ID,\n+    LOGGING_TRANSFORM_PLUGIN_ID, METRICS_TRANSFORM_PLUGIN_ID,\n+    REQUEST_ID_TRANSFORM_PLUGIN_ID,\n+]\n+\n+ALL_OAGW_GTS_IDS = OAGW_SCHEMAS + OAGW_INSTANCES\n+\n+\n+async def register_oagw_types(\n+    client: httpx.AsyncClient,\n+    base_url: str,\n+    headers: dict,\n+) -> httpx.Response:\n+    \"\"\"Register all OAGW GTS schemas and instances via the types-registry REST API.\n+\n+    Idempotent — safe to call when types are already registered at startup.\n+    \"\"\"\n+    entities = []\n+    for gts_id in OAGW_SCHEMAS:\n+        entities.append({\n+            \"$id\": f\"gts://{gts_id}\",\n+            \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+            \"type\": \"object\",\n+        })\n+    for gts_id in OAGW_INSTANCES:\n+        entities.append({\"$id\": gts_id})\n+\n+    resp = await client.post(\n+        f\"{base_url}/types-registry/v1/entities\",\n+        headers={**headers, \"content-type\": \"application/json\"},\n+        json={\"entities\": entities},\n+    )\n+    return resp\n+\n+\n+async def list_oagw_types(\n+    client: httpx.AsyncClient,\n+    base_url: str,\n+    headers: dict,\n+) -> list[dict]:\n+    \"\"\"List all OAGW entities registered in the types-registry via REST API.\n+\n+    Queries with namespace=oagw to scope to OAGW entities.\n+    Returns the list of entity dicts from the response.\n+    \"\"\"\n+    resp = await client.get(\n+        f\"{base_url}/types-registry/v1/entities\",\n+        headers=headers,\n+        params={\"namespace\": \"oagw\"},\n+    )\n+    resp.raise_for_status()\n+    return resp.json().get(\"entities\", [])\n+\n+\n+def unique_alias(prefix: str = \"e2e\") -> str:\n+    \"\"\"Generate a unique alias to avoid cross-test collisions.\"\"\"\n+    short = uuid.uuid4().hex[:8]\n+    return f\"{prefix}-{short}\"\n+\n+\n+def parse_gts_uuid(gts_id: str) -> str:\n+    \"\"\"Extract the UUID from a GTS identifier (e.g., 'gts.x.core.oagw.upstream.v1~<uuid>').\"\"\"\n+    if \"~\" in gts_id:\n+        return gts_id.rsplit(\"~\", 1)[-1]\n+    # Fallback: try regex for both hyphenated and non-hyphenated UUIDs.\n+    match = re.search(r\"[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\", gts_id, re.IGNORECASE)\n+    if not match:\n+        raise ValueError(f\"No UUID found in GTS identifier: {gts_id}\")\n+    return match.group(0)","path":"testing/e2e/modules/oagw/helpers.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Test helper — parse_gts_uuid is only used in e2e tests to extract UUIDs from well-known GTS IDs. The non-UUID suffix case (protocol IDs) isn't exercised. Low risk.","created_at":"2026-02-17T17:07:29Z","updated_at":"2026-02-17T17:07:29Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095238","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095238"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095238"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095238/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":113,"original_start_line":113,"start_side":"RIGHT","line":121,"original_line":121,"side":"RIGHT","in_reply_to_id":2818055407,"author_association":"MEMBER","original_position":121,"position":121,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095387","pull_request_review_id":3815179297,"id":2818095387,"node_id":"PRRC_kwDOPaLyBs6n-Lkb","diff_hunk":"@@ -0,0 +1,173 @@\n+\"\"\"Standalone mock upstream HTTP server for OAGW E2E tests.\n+\n+Provides endpoints that simulate an upstream service (OpenAI-compatible JSON,\n+SSE streaming, echo, configurable errors). Started as a session-scoped pytest\n+fixture so the OAGW service under test can proxy to it.\n+\"\"\"\n+import asyncio\n+import json\n+import time\n+\n+from aiohttp import web\n+\n+\n+# ---------------------------------------------------------------------------\n+# Handlers\n+# ---------------------------------------------------------------------------\n+\n+async def handle_health(_request: web.Request) -> web.Response:\n+    return web.json_response({\"status\": \"ok\"})\n+\n+\n+async def handle_echo(request: web.Request) -> web.Response:\n+    \"\"\"Return received headers and body as JSON.\"\"\"\n+    body = await request.read()\n+    headers = {k.lower(): v for k, v in request.headers.items()}\n+    return web.json_response({\n+        \"headers\": headers,\n+        \"body\": body.decode(\"utf-8\", errors=\"replace\"),\n+    })\n+\n+\n+async def handle_chat_completions(_request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible chat completion response.\"\"\"\n+    return web.json_response({\n+        \"id\": \"chatcmpl-mock-123\",\n+        \"object\": \"chat.completion\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\n+            \"index\": 0,\n+            \"message\": {\"role\": \"assistant\", \"content\": \"Hello from mock server\"},\n+            \"finish_reason\": \"stop\",\n+        }],\n+        \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 20, \"total_tokens\": 30},\n+    })\n+\n+\n+async def handle_models(_request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible model list.\"\"\"\n+    return web.json_response({\n+        \"object\": \"list\",\n+        \"data\": [\n+            {\"id\": \"gpt-4\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+            {\"id\": \"gpt-3.5-turbo\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+        ],\n+    })\n+\n+\n+async def handle_stream_chat_completions(request: web.Request) -> web.StreamResponse:\n+    \"\"\"SSE streaming chat completion.\"\"\"\n+    resp = web.StreamResponse(\n+        status=200,\n+        headers={\"Content-Type\": \"text/event-stream\", \"Cache-Control\": \"no-cache\"},\n+    )\n+    await resp.prepare(request)\n+\n+    words = [\"Hello\", \" from\", \" mock\", \" server\"]\n+    for i, word in enumerate(words):\n+        delta = {}\n+        if i == 0:\n+            delta[\"role\"] = \"assistant\"\n+        delta[\"content\"] = word\n+        chunk = {\n+            \"id\": \"chatcmpl-mock-stream\",\n+            \"object\": \"chat.completion.chunk\",\n+            \"created\": 1_234_567_890,\n+            \"model\": \"gpt-4-mock\",\n+            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": None}],\n+        }\n+        await resp.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())\n+        await asyncio.sleep(0.01)\n+\n+    # Final chunk with finish_reason\n+    final = {\n+        \"id\": \"chatcmpl-mock-stream\",\n+        \"object\": \"chat.completion.chunk\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}],\n+    }\n+    await resp.write(f\"data: {json.dumps(final)}\\n\\n\".encode())\n+    await resp.write(b\"data: [DONE]\\n\\n\")\n+    await resp.write_eof()\n+    return resp\n+\n+\n+async def handle_error_code(request: web.Request) -> web.Response:\n+    \"\"\"Return a configurable HTTP error status.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response(\n+        {\"error\": {\"message\": f\"Simulated error {code}\", \"type\": \"server_error\", \"code\": f\"error_{code}\"}},\n+        status=code,\n+    )\n+\n+\n+async def handle_error_timeout(_request: web.Request) -> web.Response:\n+    \"\"\"Sleep long enough for the gateway proxy timeout to fire.\"\"\"\n+    await asyncio.sleep(30)\n+    return web.Response(text=\"should not reach here\")\n+\n+\n+async def handle_status(request: web.Request) -> web.Response:\n+    \"\"\"Return configurable status code.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response({\"status\": code, \"description\": f\"Status {code}\"}, status=code)\n+\n+\n+# ---------------------------------------------------------------------------\n+# App factory\n+# ---------------------------------------------------------------------------\n+\n+def create_app() -> web.Application:\n+    app = web.Application()\n+    app.router.add_get(\"/health\", handle_health)\n+    app.router.add_post(\"/echo\", handle_echo)\n+    app.router.add_post(\"/v1/chat/completions\", handle_chat_completions)\n+    app.router.add_get(\"/v1/models\", handle_models)\n+    app.router.add_post(\"/v1/chat/completions/stream\", handle_stream_chat_completions)\n+    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/error/{code}\", handle_error_code)\n+    app.router.add_get(\"/status/{code}\", handle_status)\n+    return app\n+\n+\n+# ---------------------------------------------------------------------------\n+# Server lifecycle (used by conftest.py fixture)\n+# ---------------------------------------------------------------------------\n+\n+class MockUpstreamServer:\n+    \"\"\"Manages the mock upstream lifecycle for pytest fixtures.\"\"\"\n+\n+    def __init__(self, host: str = \"127.0.0.1\", port: int = 19876):\n+        self.host = host\n+        self.port = port\n+        self._runner: web.AppRunner | None = None\n+\n+    async def start(self) -> None:\n+        app = create_app()\n+        self._runner = web.AppRunner(app)\n+        await self._runner.setup()\n+        site = web.TCPSite(self._runner, self.host, self.port)\n+        await site.start()\n+\n+    async def stop(self) -> None:\n+        if self._runner:\n+            await self._runner.cleanup()\n+            self._runner = None\n+\n+    @property\n+    def base_url(self) -> str:\n+        return f\"http://127.0.0.1:{self.port}\"","path":"testing/e2e/modules/oagw/mock_upstream.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Now moot — we changed the default to 127.0.0.1, so base_url returning http://127.0.0.1:{port} matches the bind address.","created_at":"2026-02-17T17:07:32Z","updated_at":"2026-02-17T17:07:32Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095387","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095387"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095387"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095387/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":139,"original_start_line":139,"start_side":"RIGHT","line":161,"original_line":161,"side":"RIGHT","in_reply_to_id":2818055414,"author_association":"MEMBER","original_position":161,"position":161,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095652","pull_request_review_id":3815179568,"id":2818095652,"node_id":"PRRC_kwDOPaLyBs6n-Lok","diff_hunk":"@@ -0,0 +1,69 @@\n+\"\"\"E2E tests for OAGW auth injection (API key plugin).\"\"\"\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+APIKEY_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.apikey.v1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_apikey_auth_injects_bearer_header(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):\n+    \"\"\"Auth plugin injects Authorization: Bearer <secret> into upstream request.\"\"\"\n+    alias = unique_alias(\"auth-key\")\n+    auth_config = {\n+        \"type\": APIKEY_AUTH_PLUGIN_ID,\n+        \"sharing\": \"private\",\n+        \"config\": {\n+            \"header\": \"authorization\",\n+            \"prefix\": \"Bearer \",\n+            \"secret_ref\": \"cred://openai-key\",\n+        },\n+    }\n+\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        try:\n+            upstream = await create_upstream(\n+                client, oagw_base_url, oagw_headers, mock_upstream_url,\n+                alias=alias, auth=auth_config,\n+            )\n+        except httpx.HTTPStatusError as exc:\n+            if exc.response.status_code in (400, 500):\n+                pytest.skip(\n+                    f\"Cannot create upstream with auth config (cred_store may not be available): \"\n+                    f\"{exc.response.status_code} {exc.response.text[:200]}\"\n+                )\n+            raise\n+\n+        uid = upstream[\"id\"]\n+        await create_route(\n+            client, oagw_base_url, oagw_headers, uid, [\"POST\"], \"/echo\",\n+        )\n+\n+        resp = await client.post(\n+            f\"{oagw_base_url}/oagw/v1/proxy/{alias}/echo\",\n+            headers={**oagw_headers, \"content-type\": \"application/json\"},\n+            json={\"test\": True},\n+        )\n+\n+        if resp.status_code in (401, 500):\n+            await delete_upstream(client, oagw_base_url, oagw_headers, uid)\n+            pytest.skip(\n+                f\"Auth injection failed (cred_store may not have test secret): \"\n+                f\"{resp.status_code} {resp.text[:200]}\"\n+            )\n+\n+        assert resp.status_code == 200, f\"Expected 200, got {resp.status_code}: {resp.text[:500]}\"\n+\n+        echoed = resp.json().get(\"headers\", {})\n+        auth_header = echoed.get(\"authorization\", \"\")\n+        assert auth_header.startswith(\"Bearer \"), (\n+            f\"Expected 'Bearer ...' in authorization header, got: {auth_header!r}\"\n+        )\n+        # The value after \"Bearer \" should be a non-empty resolved secret.\n+        secret_value = auth_header[len(\"Bearer \"):]\n+        assert len(secret_value) > 0, \"Resolved secret is empty\"\n+\n+        await delete_upstream(client, oagw_base_url, oagw_headers, uid)","path":"testing/e2e/modules/oagw/test_auth_injection.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Test cleanup is handled by delete_upstream at the end of each test. If an assertion fails mid-test, the upstream leaks — but since each test uses a unique alias (unique_alias()), leaked resources don't interfere with other tests. The session-scoped app resets on restart. Acceptable for e2e tests.","created_at":"2026-02-17T17:07:35Z","updated_at":"2026-02-17T17:07:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095652","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095652"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095652"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095652/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":10,"original_start_line":10,"start_side":"RIGHT","line":69,"original_line":69,"side":"RIGHT","in_reply_to_id":2818055419,"author_association":"MEMBER","original_position":69,"position":69,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095694","pull_request_review_id":3815179598,"id":2818095694,"node_id":"PRRC_kwDOPaLyBs6n-LpO","diff_hunk":"@@ -0,0 +1,783 @@\n+use std::sync::Arc;\n+\n+use modkit_macros::domain_model;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ServiceGatewayClientV1;\n+use oagw_sdk::body::Body;\n+use oagw_sdk::error::ServiceGatewayError;\n+use uuid::Uuid;\n+\n+use super::{ControlPlaneService, DataPlaneService};\n+use crate::domain::error::DomainError;\n+use crate::domain::model;\n+\n+/// Facade that implements the public `ServiceGatewayClientV1` trait by\n+/// delegating to the internal CP and DP services.\n+#[domain_model]\n+pub(crate) struct ServiceGatewayClientV1Facade {\n+    cp: Arc<dyn ControlPlaneService>,\n+    dp: Arc<dyn DataPlaneService>,\n+}\n+\n+impl ServiceGatewayClientV1Facade {\n+    pub(crate) fn new(cp: Arc<dyn ControlPlaneService>, dp: Arc<dyn DataPlaneService>) -> Self {\n+        Self { cp, dp }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl ServiceGatewayClientV1 for ServiceGatewayClientV1Facade {\n+    async fn create_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_create_upstream_to_domain(req);\n+        let result = self.cp.create_upstream(&ctx, internal_req).await;\n+        result.map(upstream_to_sdk).map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .get_upstream(&ctx, id)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_upstreams(\n+        &self,\n+        ctx: SecurityContext,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Upstream>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_upstreams(&ctx, &q)\n+            .await\n+            .map(|v| v.into_iter().map(upstream_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateUpstreamRequest,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        let internal_req = sdk_update_upstream_to_domain(req);\n+        self.cp\n+            .update_upstream(&ctx, id, internal_req)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_upstream(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn create_route(\n+        &self,\n+        ctx: SecurityContext,\n+        req: oagw_sdk::CreateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_create_route_to_domain(req);\n+        self.cp\n+            .create_route(&ctx, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn get_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .get_route(&ctx, id)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn list_routes(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        query: &oagw_sdk::ListQuery,\n+    ) -> Result<Vec<oagw_sdk::Route>, ServiceGatewayError> {\n+        let q = model::ListQuery {\n+            top: query.top,\n+            skip: query.skip,\n+        };\n+        self.cp\n+            .list_routes(&ctx, upstream_id, &q)\n+            .await\n+            .map(|v| v.into_iter().map(route_to_sdk).collect())\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn update_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+        req: oagw_sdk::UpdateRouteRequest,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        let internal_req = sdk_update_route_to_domain(req);\n+        self.cp\n+            .update_route(&ctx, id, internal_req)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn delete_route(\n+        &self,\n+        ctx: SecurityContext,\n+        id: Uuid,\n+    ) -> Result<(), ServiceGatewayError> {\n+        self.cp\n+            .delete_route(&ctx, id)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_upstream(\n+        &self,\n+        ctx: SecurityContext,\n+        alias: &str,\n+    ) -> Result<oagw_sdk::Upstream, ServiceGatewayError> {\n+        self.cp\n+            .resolve_upstream(&ctx, alias)\n+            .await\n+            .map(upstream_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn resolve_route(\n+        &self,\n+        ctx: SecurityContext,\n+        upstream_id: Uuid,\n+        method: &str,\n+        path: &str,\n+    ) -> Result<oagw_sdk::Route, ServiceGatewayError> {\n+        self.cp\n+            .resolve_route(&ctx, upstream_id, method, path)\n+            .await\n+            .map(route_to_sdk)\n+            .map_err(domain_err_to_sdk)\n+    }\n+\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, ServiceGatewayError> {\n+        self.dp\n+            .proxy_request(ctx, req)\n+            .await\n+            .map_err(domain_err_to_sdk)\n+    }\n+}\n+\n+// ---------------------------------------------------------------------------\n+// DomainError → ServiceGatewayError\n+// ---------------------------------------------------------------------------\n+\n+fn domain_err_to_sdk(err: DomainError) -> ServiceGatewayError {\n+    match err {\n+        DomainError::NotFound { entity, id } => ServiceGatewayError::RouteNotFound {\n+            instance: format!(\"{entity}/{id}\"),\n+        },\n+        DomainError::Conflict { detail } => ServiceGatewayError::ValidationError {\n+            detail,\n+            instance: String::new(),\n+        },\n+        DomainError::Validation { detail, instance } => {\n+            ServiceGatewayError::ValidationError { detail, instance }\n+        }\n+        DomainError::UpstreamDisabled { alias } => ServiceGatewayError::UpstreamDisabled {\n+            detail: format!(\"upstream '{alias}' is disabled\"),\n+            instance: String::new(),\n+        },\n+        DomainError::Internal { message } => ServiceGatewayError::DownstreamError {\n+            detail: message,\n+            instance: String::new(),\n+        },\n+        DomainError::MissingTargetHost { instance } => {\n+            ServiceGatewayError::MissingTargetHost { instance }\n+        }\n+        DomainError::InvalidTargetHost { instance } => {\n+            ServiceGatewayError::InvalidTargetHost { instance }\n+        }\n+        DomainError::UnknownTargetHost { detail, instance } => {\n+            ServiceGatewayError::UnknownTargetHost { detail, instance }\n+        }\n+        DomainError::AuthenticationFailed { detail, instance } => {\n+            ServiceGatewayError::AuthenticationFailed { detail, instance }\n+        }\n+        DomainError::PayloadTooLarge { detail, instance } => {\n+            ServiceGatewayError::PayloadTooLarge { detail, instance }\n+        }\n+        DomainError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        } => ServiceGatewayError::RateLimitExceeded {\n+            detail,\n+            instance,\n+            retry_after_secs,\n+        },\n+        DomainError::SecretNotFound { detail, instance } => {\n+            ServiceGatewayError::SecretNotFound { detail, instance }\n+        }\n+        DomainError::DownstreamError { detail, instance } => {\n+            ServiceGatewayError::DownstreamError { detail, instance }\n+        }\n+        DomainError::ProtocolError { detail, instance } => {\n+            ServiceGatewayError::ProtocolError { detail, instance }\n+        }\n+        DomainError::ConnectionTimeout { detail, instance } => {\n+            ServiceGatewayError::ConnectionTimeout { detail, instance }\n+        }\n+        DomainError::RequestTimeout { detail, instance } => {\n+            ServiceGatewayError::RequestTimeout { detail, instance }\n+        }\n+    }","path":"modules/system/oagw/oagw/src/domain/services/client.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood — I've noted that the coarse error mapping in the SDK facade is intentional for the initial release. The design prioritizes a minimal error surface now, with plans to add finer granularity as the SDK matures.\n\n<!-- [add_learning]\nRepository cyberfabric/cyberfabric-core, OAGW module: The ServiceGatewayClientV1Facade in modules/system/oagw/oagw/src/domain/services/client.rs intentionally uses coarse error mapping (e.g., all DomainError::NotFound variants map to ServiceGatewayError::RouteNotFound) for the initial implementation. This minimal error surface is deliberate, with finer error granularity planned as the SDK stabilizes.\n</learning>\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:07:36Z","updated_at":"2026-02-17T17:07:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095694","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095694"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095694"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095694/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":202,"original_start_line":202,"start_side":"RIGHT","line":262,"original_line":261,"side":"RIGHT","in_reply_to_id":2818055389,"author_association":"CONTRIBUTOR","original_position":261,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095787","pull_request_review_id":3815179680,"id":2818095787,"node_id":"PRRC_kwDOPaLyBs6n-Lqr","diff_hunk":"@@ -0,0 +1,911 @@\n+// REST DTOs for the OAGW API.\n+//\n+// These types own serde annotations and JSON schema concerns. They convert\n+// to/from internal domain types via `From` impls for the service layer boundary.\n+\n+use std::collections::HashMap;\n+\n+use serde::{Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+use crate::domain::model as domain;\n+\n+// ---------------------------------------------------------------------------\n+// Shared enums\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Endpoint / Server\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]\n+pub struct Endpoint {\n+    #[serde(default)]\n+    pub scheme: Scheme,\n+    pub host: String,\n+    #[serde(default = \"default_port\")]\n+    pub port: u16,\n+}\n+\n+fn default_port() -> u16 {\n+    443\n+}","path":"modules/system/oagw/oagw/src/api/rest/dto.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood! I appreciate the confirmation. I'll look forward to the fix in the follow-up PR. 👍\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:07:37Z","updated_at":"2026-02-17T17:07:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095787","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095787"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095787"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095787/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":41,"original_start_line":41,"start_side":"RIGHT","line":52,"original_line":52,"side":"RIGHT","in_reply_to_id":2818055383,"author_association":"CONTRIBUTOR","original_position":52,"position":52,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095795","pull_request_review_id":3815179690,"id":2818095795,"node_id":"PRRC_kwDOPaLyBs6n-Lqz","diff_hunk":"@@ -0,0 +1,114 @@\n+\"\"\"E2E tests for OAGW body validation guardrails.\"\"\"\n+import asyncio\n+from urllib.parse import urlparse\n+\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+\n+async def _raw_http_request(host: str, port: int, raw_request: bytes, timeout: float = 10.0) -> str:\n+    \"\"\"Send a raw HTTP request and return the raw response as a string.\"\"\"\n+    reader, writer = await asyncio.wait_for(\n+        asyncio.open_connection(host, port), timeout=timeout,\n+    )\n+    writer.write(raw_request)\n+    await writer.drain()\n+    response = await asyncio.wait_for(reader.read(8192), timeout=timeout)\n+    writer.close()\n+    return response.decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _parse_status_code(raw_response: str) -> int:\n+    \"\"\"Extract the HTTP status code from a raw response.\"\"\"\n+    # e.g. \"HTTP/1.1 400 Bad Request\\r\\n...\"\n+    first_line = raw_response.split(\"\\r\\n\", 1)[0]\n+    return int(first_line.split(\" \", 2)[1])\n+\n+\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):","path":"testing/e2e/modules/oagw/test_body_validation.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Same as above — unique aliases prevent cross-test interference. Acceptable for e2e tests.","created_at":"2026-02-17T17:07:37Z","updated_at":"2026-02-17T17:07:37Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095795","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095795"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818095795"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818095795/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":30,"original_start_line":30,"start_side":"RIGHT","line":33,"original_line":33,"side":"RIGHT","in_reply_to_id":2818055424,"author_association":"MEMBER","original_position":33,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096151","pull_request_review_id":3815180034,"id":2818096151,"node_id":"PRRC_kwDOPaLyBs6n-LwX","diff_hunk":"@@ -0,0 +1,114 @@\n+\"\"\"E2E tests for OAGW body validation guardrails.\"\"\"\n+import asyncio\n+from urllib.parse import urlparse\n+\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+\n+async def _raw_http_request(host: str, port: int, raw_request: bytes, timeout: float = 10.0) -> str:\n+    \"\"\"Send a raw HTTP request and return the raw response as a string.\"\"\"\n+    reader, writer = await asyncio.wait_for(\n+        asyncio.open_connection(host, port), timeout=timeout,\n+    )\n+    writer.write(raw_request)\n+    await writer.drain()\n+    response = await asyncio.wait_for(reader.read(8192), timeout=timeout)\n+    writer.close()\n+    return response.decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _parse_status_code(raw_response: str) -> int:\n+    \"\"\"Extract the HTTP status code from a raw response.\"\"\"\n+    # e.g. \"HTTP/1.1 400 Bad Request\\r\\n...\"\n+    first_line = raw_response.split(\"\\r\\n\", 1)[0]\n+    return int(first_line.split(\" \", 2)[1])\n+\n+\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):\n+    \"\"\"Non-integer Content-Length returns 400.\"\"\"\n+    alias = unique_alias(\"body-cl\")\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        upstream = await create_upstream(\n+            client, oagw_base_url, oagw_headers, mock_upstream_url, alias=alias,\n+        )\n+        uid = upstream[\"id\"]\n+        await create_route(\n+            client, oagw_base_url, oagw_headers, uid, [\"POST\"], \"/v1/test\",\n+        )\n+\n+        # httpx/h11 rejects invalid Content-Length client-side, so use raw socket.\n+        parsed = urlparse(oagw_base_url)\n+        host = parsed.hostname or \"127.0.0.1\"\n+        port = parsed.port or 80\n+","path":"testing/e2e/modules/oagw/test_body_validation.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"E2E tests are always run against a local HTTP server (127.0.0.1:8086). HTTPS is not used in the test environment. If someone configures an HTTPS base URL, the raw socket test would fail — but that's a misconfiguration, not a test bug.","created_at":"2026-02-17T17:07:42Z","updated_at":"2026-02-17T17:07:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818096151","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096151"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818096151"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096151/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":45,"original_start_line":45,"start_side":"RIGHT","line":49,"original_line":49,"side":"RIGHT","in_reply_to_id":2818055428,"author_association":"MEMBER","original_position":49,"position":49,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096778","pull_request_review_id":3815180679,"id":2818096778,"node_id":"PRRC_kwDOPaLyBs6n-L6K","diff_hunk":"@@ -0,0 +1,123 @@\n+use std::sync::Arc;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::plugin::{AuthContext, AuthPlugin, PluginError};\n+use serde::Deserialize;\n+\n+/// Configuration for the API key auth plugin.\n+#[derive(Debug, Deserialize)]\n+struct ApiKeyConfig {\n+    /// Header name to set (e.g. \"Authorization\", \"X-API-Key\").\n+    header: String,\n+    /// Prefix prepended to the secret value (e.g. \"Bearer \").\n+    #[serde(default)]\n+    prefix: String,\n+    /// Secret reference to resolve (e.g. \"cred://openai-key\").\n+    secret_ref: String,\n+}\n+\n+/// Auth plugin that resolves a secret reference and injects it as a header value.\n+pub struct ApiKeyAuthPlugin {\n+    credential_resolver: Arc<dyn CredentialResolver>,\n+}\n+\n+impl ApiKeyAuthPlugin {\n+    #[must_use]\n+    pub fn new(credential_resolver: Arc<dyn CredentialResolver>) -> Self {\n+        Self {\n+            credential_resolver,\n+        }\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl AuthPlugin for ApiKeyAuthPlugin {\n+    async fn authenticate(&self, ctx: &mut AuthContext) -> Result<(), PluginError> {\n+        let config: ApiKeyConfig = serde_json::from_value(\n+            serde_json::to_value(&ctx.config)\n+                .map_err(|e| PluginError::Internal(format!(\"invalid apikey auth config: {e}\")))?,\n+        )\n+        .map_err(|e| PluginError::Internal(format!(\"invalid apikey auth config: {e}\")))?;\n+\n+        let secret = self\n+            .credential_resolver\n+            .resolve(&config.secret_ref)\n+            .await\n+            .map_err(|_| PluginError::SecretNotFound(config.secret_ref.clone()))?;","path":"modules/system/oagw/oagw/src/infra/plugin/apikey_auth.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, that makes sense — the in-memory resolver is indeed simple enough that the current mapping is adequate. When you integrate a real credential store with richer failure modes, the error-variant distinction will become useful. Thanks for noting it for that future work.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:07:51Z","updated_at":"2026-02-17T17:07:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818096778","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096778"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818096778"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818096778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":42,"original_start_line":42,"start_side":"RIGHT","line":46,"original_line":46,"side":"RIGHT","in_reply_to_id":2818055395,"author_association":"CONTRIBUTOR","original_position":46,"position":46,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097043","pull_request_review_id":3815180980,"id":2818097043,"node_id":"PRRC_kwDOPaLyBs6n-L-T","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }\n+            }\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+\n+        // 7. Build URL.\n+        // path_suffix is the full path from the proxy URL; strip the route prefix\n+        // so we get: endpoint + route_path + remaining_suffix.\n+        let route_path = route\n+            .match_rules\n+            .http\n+            .as_ref()\n+            .map_or(\"/\", |h| h.path.as_str());\n+        let remaining_suffix = path_suffix.strip_prefix(route_path).unwrap_or(\"\");\n+        let url = request_builder::build_upstream_url(\n+            endpoint,\n+            route_path,\n+            remaining_suffix,\n+            &query_params,\n+        )?;\n+\n+        // 8. Forward request with timeout on response headers.\n+        let send_future = self\n+            .http_client\n+            .request(method, &url)\n+            .headers(outbound_headers)\n+            .body(body_bytes)\n+            .send();\n+\n+        let timeout = self.request_timeout;\n+        let response = tokio::time::timeout(timeout, send_future)\n+            .await\n+            .map_err(|_| DomainError::RequestTimeout {\n+                detail: format!(\"request to {url} timed out after {timeout:?}\"),\n+                instance: instance_uri.clone(),\n+            })?\n+            .map_err(|e| {\n+                if e.is_connect() {\n+                    DomainError::ConnectionTimeout {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                } else {\n+                    DomainError::DownstreamError {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                }\n+            })?;\n+\n+        // 9. Build streaming response.\n+        let status = response.status();\n+        let resp_headers = response.headers().clone();\n+\n+        let body_stream: BodyStream = Box::pin(\n+            response\n+                .bytes_stream()\n+                .map(|r| r.map_err(|e| Box::new(e) as BoxError)),\n+        );\n+\n+        let mut resp = http::Response::builder()\n+            .status(status)\n+            .body(Body::Stream(body_stream))\n+            .map_err(|e| DomainError::DownstreamError {\n+                detail: format!(\"failed to build response: {e}\"),\n+                instance: instance_uri,\n+            })?;\n+\n+        *resp.headers_mut() = resp_headers;\n+        resp.extensions_mut().insert(ErrorSource::Upstream);","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, thank you for confirming! I appreciate you validating the finding and committing to address it in the follow-up. The fix should be straightforward—just call `headers::sanitize_response_headers(&mut resp_headers)` after cloning the headers and before assigning them to the response.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:07:55Z","updated_at":"2026-02-17T17:07:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097043","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097043"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097043"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097043/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":300,"original_start_line":297,"start_side":"RIGHT","line":320,"original_line":316,"side":"RIGHT","in_reply_to_id":2818055405,"author_association":"CONTRIBUTOR","original_position":316,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097580","pull_request_review_id":3815181516,"id":2818097580,"node_id":"PRRC_kwDOPaLyBs6n-MGs","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, thank you for the clarification! I understand now—the HashMap<String, String> conversion is an intentional architectural boundary to keep the domain layer transport-agnostic per DE0308, and the auth flow only deals with known UTF-8 headers like Authorization. That makes sense, and I appreciate you explaining the trade-off.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/oagw/src/infra/proxy/service.rs:178-221\nTimestamp: 2026-02-17T17:07:53.470Z\nLearning: In the OAGW module (modules/system/oagw), auth plugins use HashMap<String, String> for AuthContext.headers to satisfy DDD layer rule DE0308 (no http types in domain). The conversion from HeaderMap to HashMap intentionally drops non-UTF8 and multi-value headers because auth plugins operate on a transport-agnostic context and only handle specific known headers like Authorization. This trade-off is accepted by design.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:02Z","updated_at":"2026-02-17T17:08:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097580","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097580"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097580"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097580/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":181,"original_start_line":178,"start_side":"RIGHT","line":224,"original_line":221,"side":"RIGHT","in_reply_to_id":2818055396,"author_association":"CONTRIBUTOR","original_position":221,"position":224,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097866","pull_request_review_id":3815181820,"id":2818097866,"node_id":"PRRC_kwDOPaLyBs6n-MLK","diff_hunk":"@@ -0,0 +1,211 @@\n+\"\"\"Shared helpers for OAGW E2E tests.\"\"\"\n+import re\n+import uuid\n+\n+import httpx\n+\n+# ---------------------------------------------------------------------------\n+# OAGW GTS type catalog — mirrors the Rust catalog in domain/type_catalog.rs\n+# ---------------------------------------------------------------------------\n+\n+# Schema GTS identifiers (7)\n+UPSTREAM_SCHEMA = \"gts.x.core.oagw.upstream.v1~\"\n+ROUTE_SCHEMA = \"gts.x.core.oagw.route.v1~\"\n+PROTOCOL_SCHEMA = \"gts.x.core.oagw.protocol.v1~\"\n+AUTH_PLUGIN_SCHEMA = \"gts.x.core.oagw.auth_plugin.v1~\"\n+GUARD_PLUGIN_SCHEMA = \"gts.x.core.oagw.guard_plugin.v1~\"\n+TRANSFORM_PLUGIN_SCHEMA = \"gts.x.core.oagw.transform_plugin.v1~\"\n+PROXY_SCHEMA = \"gts.x.core.oagw.proxy.v1~\"\n+\n+# Protocol instances (2)\n+HTTP_PROTOCOL_ID = \"gts.x.core.oagw.protocol.v1~x.core.oagw.http.v1\"\n+GRPC_PROTOCOL_ID = \"gts.x.core.oagw.protocol.v1~x.core.oagw.grpc.v1\"\n+\n+# Auth plugin instances (6)\n+NOOP_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.noop.v1\"\n+APIKEY_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.apikey.v1\"\n+BASIC_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.basic.v1\"\n+BEARER_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.bearer.v1\"\n+OAUTH2_CLIENT_CRED_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.oauth2_client_cred.v1\"\n+OAUTH2_CLIENT_CRED_BASIC_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.oauth2_client_cred_basic.v1\"\n+\n+# Guard plugin instances (2)\n+TIMEOUT_GUARD_PLUGIN_ID = \"gts.x.core.oagw.guard_plugin.v1~x.core.oagw.timeout.v1\"\n+CORS_GUARD_PLUGIN_ID = \"gts.x.core.oagw.guard_plugin.v1~x.core.oagw.cors.v1\"\n+\n+# Transform plugin instances (3)\n+LOGGING_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.logging.v1\"\n+METRICS_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.metrics.v1\"\n+REQUEST_ID_TRANSFORM_PLUGIN_ID = \"gts.x.core.oagw.transform_plugin.v1~x.core.oagw.request_id.v1\"\n+\n+# Grouped for assertions\n+OAGW_SCHEMAS = [\n+    UPSTREAM_SCHEMA, ROUTE_SCHEMA, PROTOCOL_SCHEMA,\n+    AUTH_PLUGIN_SCHEMA, GUARD_PLUGIN_SCHEMA, TRANSFORM_PLUGIN_SCHEMA,\n+    PROXY_SCHEMA,\n+]\n+\n+OAGW_INSTANCES = [\n+    HTTP_PROTOCOL_ID, GRPC_PROTOCOL_ID,\n+    NOOP_AUTH_PLUGIN_ID, APIKEY_AUTH_PLUGIN_ID, BASIC_AUTH_PLUGIN_ID,\n+    BEARER_AUTH_PLUGIN_ID, OAUTH2_CLIENT_CRED_AUTH_PLUGIN_ID,\n+    OAUTH2_CLIENT_CRED_BASIC_AUTH_PLUGIN_ID,\n+    TIMEOUT_GUARD_PLUGIN_ID, CORS_GUARD_PLUGIN_ID,\n+    LOGGING_TRANSFORM_PLUGIN_ID, METRICS_TRANSFORM_PLUGIN_ID,\n+    REQUEST_ID_TRANSFORM_PLUGIN_ID,\n+]\n+\n+ALL_OAGW_GTS_IDS = OAGW_SCHEMAS + OAGW_INSTANCES\n+\n+\n+async def register_oagw_types(\n+    client: httpx.AsyncClient,\n+    base_url: str,\n+    headers: dict,\n+) -> httpx.Response:\n+    \"\"\"Register all OAGW GTS schemas and instances via the types-registry REST API.\n+\n+    Idempotent — safe to call when types are already registered at startup.\n+    \"\"\"\n+    entities = []\n+    for gts_id in OAGW_SCHEMAS:\n+        entities.append({\n+            \"$id\": f\"gts://{gts_id}\",\n+            \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+            \"type\": \"object\",\n+        })\n+    for gts_id in OAGW_INSTANCES:\n+        entities.append({\"$id\": gts_id})\n+\n+    resp = await client.post(\n+        f\"{base_url}/types-registry/v1/entities\",\n+        headers={**headers, \"content-type\": \"application/json\"},\n+        json={\"entities\": entities},\n+    )\n+    return resp\n+\n+\n+async def list_oagw_types(\n+    client: httpx.AsyncClient,\n+    base_url: str,\n+    headers: dict,\n+) -> list[dict]:\n+    \"\"\"List all OAGW entities registered in the types-registry via REST API.\n+\n+    Queries with namespace=oagw to scope to OAGW entities.\n+    Returns the list of entity dicts from the response.\n+    \"\"\"\n+    resp = await client.get(\n+        f\"{base_url}/types-registry/v1/entities\",\n+        headers=headers,\n+        params={\"namespace\": \"oagw\"},\n+    )\n+    resp.raise_for_status()\n+    return resp.json().get(\"entities\", [])\n+\n+\n+def unique_alias(prefix: str = \"e2e\") -> str:\n+    \"\"\"Generate a unique alias to avoid cross-test collisions.\"\"\"\n+    short = uuid.uuid4().hex[:8]\n+    return f\"{prefix}-{short}\"\n+\n+\n+def parse_gts_uuid(gts_id: str) -> str:\n+    \"\"\"Extract the UUID from a GTS identifier (e.g., 'gts.x.core.oagw.upstream.v1~<uuid>').\"\"\"\n+    if \"~\" in gts_id:\n+        return gts_id.rsplit(\"~\", 1)[-1]\n+    # Fallback: try regex for both hyphenated and non-hyphenated UUIDs.\n+    match = re.search(r\"[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\", gts_id, re.IGNORECASE)\n+    if not match:\n+        raise ValueError(f\"No UUID found in GTS identifier: {gts_id}\")\n+    return match.group(0)","path":"testing/e2e/modules/oagw/helpers.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood! Since `parse_gts_uuid` is only called with well-known GTS IDs containing UUIDs in your test suite, and protocol IDs with non-UUID suffixes aren't passed to it, the early return is safe for your current usage. Thanks for the context—no change needed.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:07Z","updated_at":"2026-02-17T17:08:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097866","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097866"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097866"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097866/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":113,"original_start_line":113,"start_side":"RIGHT","line":121,"original_line":121,"side":"RIGHT","in_reply_to_id":2818055407,"author_association":"CONTRIBUTOR","original_position":121,"position":121,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097918","pull_request_review_id":3815181876,"id":2818097918,"node_id":"PRRC_kwDOPaLyBs6n-ML-","diff_hunk":"@@ -0,0 +1,173 @@\n+\"\"\"Standalone mock upstream HTTP server for OAGW E2E tests.\n+\n+Provides endpoints that simulate an upstream service (OpenAI-compatible JSON,\n+SSE streaming, echo, configurable errors). Started as a session-scoped pytest\n+fixture so the OAGW service under test can proxy to it.\n+\"\"\"\n+import asyncio\n+import json\n+import time\n+\n+from aiohttp import web\n+\n+\n+# ---------------------------------------------------------------------------\n+# Handlers\n+# ---------------------------------------------------------------------------\n+\n+async def handle_health(_request: web.Request) -> web.Response:\n+    return web.json_response({\"status\": \"ok\"})\n+\n+\n+async def handle_echo(request: web.Request) -> web.Response:\n+    \"\"\"Return received headers and body as JSON.\"\"\"\n+    body = await request.read()\n+    headers = {k.lower(): v for k, v in request.headers.items()}\n+    return web.json_response({\n+        \"headers\": headers,\n+        \"body\": body.decode(\"utf-8\", errors=\"replace\"),\n+    })\n+\n+\n+async def handle_chat_completions(_request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible chat completion response.\"\"\"\n+    return web.json_response({\n+        \"id\": \"chatcmpl-mock-123\",\n+        \"object\": \"chat.completion\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\n+            \"index\": 0,\n+            \"message\": {\"role\": \"assistant\", \"content\": \"Hello from mock server\"},\n+            \"finish_reason\": \"stop\",\n+        }],\n+        \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 20, \"total_tokens\": 30},\n+    })\n+\n+\n+async def handle_models(_request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible model list.\"\"\"\n+    return web.json_response({\n+        \"object\": \"list\",\n+        \"data\": [\n+            {\"id\": \"gpt-4\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+            {\"id\": \"gpt-3.5-turbo\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+        ],\n+    })\n+\n+\n+async def handle_stream_chat_completions(request: web.Request) -> web.StreamResponse:\n+    \"\"\"SSE streaming chat completion.\"\"\"\n+    resp = web.StreamResponse(\n+        status=200,\n+        headers={\"Content-Type\": \"text/event-stream\", \"Cache-Control\": \"no-cache\"},\n+    )\n+    await resp.prepare(request)\n+\n+    words = [\"Hello\", \" from\", \" mock\", \" server\"]\n+    for i, word in enumerate(words):\n+        delta = {}\n+        if i == 0:\n+            delta[\"role\"] = \"assistant\"\n+        delta[\"content\"] = word\n+        chunk = {\n+            \"id\": \"chatcmpl-mock-stream\",\n+            \"object\": \"chat.completion.chunk\",\n+            \"created\": 1_234_567_890,\n+            \"model\": \"gpt-4-mock\",\n+            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": None}],\n+        }\n+        await resp.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())\n+        await asyncio.sleep(0.01)\n+\n+    # Final chunk with finish_reason\n+    final = {\n+        \"id\": \"chatcmpl-mock-stream\",\n+        \"object\": \"chat.completion.chunk\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}],\n+    }\n+    await resp.write(f\"data: {json.dumps(final)}\\n\\n\".encode())\n+    await resp.write(b\"data: [DONE]\\n\\n\")\n+    await resp.write_eof()\n+    return resp\n+\n+\n+async def handle_error_code(request: web.Request) -> web.Response:\n+    \"\"\"Return a configurable HTTP error status.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response(\n+        {\"error\": {\"message\": f\"Simulated error {code}\", \"type\": \"server_error\", \"code\": f\"error_{code}\"}},\n+        status=code,\n+    )\n+\n+\n+async def handle_error_timeout(_request: web.Request) -> web.Response:\n+    \"\"\"Sleep long enough for the gateway proxy timeout to fire.\"\"\"\n+    await asyncio.sleep(30)\n+    return web.Response(text=\"should not reach here\")\n+\n+\n+async def handle_status(request: web.Request) -> web.Response:\n+    \"\"\"Return configurable status code.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response({\"status\": code, \"description\": f\"Status {code}\"}, status=code)\n+\n+\n+# ---------------------------------------------------------------------------\n+# App factory\n+# ---------------------------------------------------------------------------\n+\n+def create_app() -> web.Application:\n+    app = web.Application()\n+    app.router.add_get(\"/health\", handle_health)\n+    app.router.add_post(\"/echo\", handle_echo)\n+    app.router.add_post(\"/v1/chat/completions\", handle_chat_completions)\n+    app.router.add_get(\"/v1/models\", handle_models)\n+    app.router.add_post(\"/v1/chat/completions/stream\", handle_stream_chat_completions)\n+    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/error/{code}\", handle_error_code)\n+    app.router.add_get(\"/status/{code}\", handle_status)\n+    return app\n+\n+\n+# ---------------------------------------------------------------------------\n+# Server lifecycle (used by conftest.py fixture)\n+# ---------------------------------------------------------------------------\n+\n+class MockUpstreamServer:\n+    \"\"\"Manages the mock upstream lifecycle for pytest fixtures.\"\"\"\n+\n+    def __init__(self, host: str = \"127.0.0.1\", port: int = 19876):\n+        self.host = host\n+        self.port = port\n+        self._runner: web.AppRunner | None = None\n+\n+    async def start(self) -> None:\n+        app = create_app()\n+        self._runner = web.AppRunner(app)\n+        await self._runner.setup()\n+        site = web.TCPSite(self._runner, self.host, self.port)\n+        await site.start()\n+\n+    async def stop(self) -> None:\n+        if self._runner:\n+            await self._runner.cleanup()\n+            self._runner = None\n+\n+    @property\n+    def base_url(self) -> str:\n+        return f\"http://127.0.0.1:{self.port}\"","path":"testing/e2e/modules/oagw/mock_upstream.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, you're right that the default now matches! \n\nThe concern would only surface if someone later passes a custom `host` to `MockUpstreamServer(host=\"0.0.0.0\", ...)` — in that case, `base_url` would still return `\"http://127.0.0.1:...\"` instead of `\"http://0.0.0.0:...\"`. But if the tests always rely on the default and won't override the host, this is fine in practice.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:07Z","updated_at":"2026-02-17T17:08:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097918","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097918"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818097918"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818097918/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":139,"original_start_line":139,"start_side":"RIGHT","line":161,"original_line":161,"side":"RIGHT","in_reply_to_id":2818055414,"author_association":"CONTRIBUTOR","original_position":161,"position":161,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098110","pull_request_review_id":3815182050,"id":2818098110,"node_id":"PRRC_kwDOPaLyBs6n-MO-","diff_hunk":"@@ -0,0 +1,114 @@\n+\"\"\"E2E tests for OAGW body validation guardrails.\"\"\"\n+import asyncio\n+from urllib.parse import urlparse\n+\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+\n+async def _raw_http_request(host: str, port: int, raw_request: bytes, timeout: float = 10.0) -> str:\n+    \"\"\"Send a raw HTTP request and return the raw response as a string.\"\"\"\n+    reader, writer = await asyncio.wait_for(\n+        asyncio.open_connection(host, port), timeout=timeout,\n+    )\n+    writer.write(raw_request)\n+    await writer.drain()\n+    response = await asyncio.wait_for(reader.read(8192), timeout=timeout)\n+    writer.close()\n+    return response.decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _parse_status_code(raw_response: str) -> int:\n+    \"\"\"Extract the HTTP status code from a raw response.\"\"\"\n+    # e.g. \"HTTP/1.1 400 Bad Request\\r\\n...\"\n+    first_line = raw_response.split(\"\\r\\n\", 1)[0]\n+    return int(first_line.split(\" \", 2)[1])\n+\n+\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):","path":"testing/e2e/modules/oagw/test_body_validation.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood. The current pattern with `mock_upstream` as a parameter is acceptable for your e2e test suite despite the lint warning. The unique aliases ensure proper test isolation, which is the key concern for integration tests.\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:10Z","updated_at":"2026-02-17T17:08:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818098110","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098110"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818098110"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098110/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":30,"original_start_line":30,"start_side":"RIGHT","line":33,"original_line":33,"side":"RIGHT","in_reply_to_id":2818055424,"author_association":"CONTRIBUTOR","original_position":33,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098965","pull_request_review_id":3815183107,"id":2818098965,"node_id":"PRRC_kwDOPaLyBs6n-McV","diff_hunk":"@@ -0,0 +1,69 @@\n+\"\"\"E2E tests for OAGW auth injection (API key plugin).\"\"\"\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+APIKEY_AUTH_PLUGIN_ID = \"gts.x.core.oagw.auth_plugin.v1~x.core.oagw.apikey.v1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_apikey_auth_injects_bearer_header(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):\n+    \"\"\"Auth plugin injects Authorization: Bearer <secret> into upstream request.\"\"\"\n+    alias = unique_alias(\"auth-key\")\n+    auth_config = {\n+        \"type\": APIKEY_AUTH_PLUGIN_ID,\n+        \"sharing\": \"private\",\n+        \"config\": {\n+            \"header\": \"authorization\",\n+            \"prefix\": \"Bearer \",\n+            \"secret_ref\": \"cred://openai-key\",\n+        },\n+    }\n+\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        try:\n+            upstream = await create_upstream(\n+                client, oagw_base_url, oagw_headers, mock_upstream_url,\n+                alias=alias, auth=auth_config,\n+            )\n+        except httpx.HTTPStatusError as exc:\n+            if exc.response.status_code in (400, 500):\n+                pytest.skip(\n+                    f\"Cannot create upstream with auth config (cred_store may not be available): \"\n+                    f\"{exc.response.status_code} {exc.response.text[:200]}\"\n+                )\n+            raise\n+\n+        uid = upstream[\"id\"]\n+        await create_route(\n+            client, oagw_base_url, oagw_headers, uid, [\"POST\"], \"/echo\",\n+        )\n+\n+        resp = await client.post(\n+            f\"{oagw_base_url}/oagw/v1/proxy/{alias}/echo\",\n+            headers={**oagw_headers, \"content-type\": \"application/json\"},\n+            json={\"test\": True},\n+        )\n+\n+        if resp.status_code in (401, 500):\n+            await delete_upstream(client, oagw_base_url, oagw_headers, uid)\n+            pytest.skip(\n+                f\"Auth injection failed (cred_store may not have test secret): \"\n+                f\"{resp.status_code} {resp.text[:200]}\"\n+            )\n+\n+        assert resp.status_code == 200, f\"Expected 200, got {resp.status_code}: {resp.text[:500]}\"\n+\n+        echoed = resp.json().get(\"headers\", {})\n+        auth_header = echoed.get(\"authorization\", \"\")\n+        assert auth_header.startswith(\"Bearer \"), (\n+            f\"Expected 'Bearer ...' in authorization header, got: {auth_header!r}\"\n+        )\n+        # The value after \"Bearer \" should be a non-empty resolved secret.\n+        secret_value = auth_header[len(\"Bearer \"):]\n+        assert len(secret_value) > 0, \"Resolved secret is empty\"\n+\n+        await delete_upstream(client, oagw_base_url, oagw_headers, uid)","path":"testing/e2e/modules/oagw/test_auth_injection.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood — that's a pragmatic trade-off for e2e tests where unique aliases prevent cross-test interference and the session-scoped environment resets between runs. The leak-on-failure approach is acceptable in this context.\n\nOne minor note: the `mock_upstream` parameter is unused in the function body (Ruff warning ARG001). If the fixture only needs to run for side effects (starting the mock server), you can use `@pytest.mark.usefixtures(\"mock_upstream\")` instead of accepting it as a parameter. This cleans up the signature without changing the cleanup behavior:\n\n```python\n`@pytest.mark.usefixtures`(\"mock_upstream\")\n`@pytest.mark.asyncio`\nasync def test_apikey_auth_injects_bearer_header(\n    oagw_base_url, oagw_headers, mock_upstream_url,\n):\n    # ... rest of test\n```\n\nThis is optional cleanup—your current approach works fine for e2e tests.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: testing/e2e/modules/oagw/test_auth_injection.py:10-69\nTimestamp: 2026-02-17T17:08:14.022Z\nLearning: Repository cyberfabric/cyberfabric-core: For e2e tests in testing/e2e/modules/oagw/, resource cleanup on test failure is not required in try/finally blocks. Tests use unique aliases (via unique_alias()) to prevent cross-test interference, and the session-scoped app resets on restart. Leak-on-failure is acceptable for e2e test pragmatics.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:23Z","updated_at":"2026-02-17T17:08:23Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818098965","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098965"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818098965"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818098965/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":10,"original_start_line":10,"start_side":"RIGHT","line":69,"original_line":69,"side":"RIGHT","in_reply_to_id":2818055419,"author_association":"CONTRIBUTOR","original_position":69,"position":69,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818099625","pull_request_review_id":3815184056,"id":2818099625,"node_id":"PRRC_kwDOPaLyBs6n-Mmp","diff_hunk":"@@ -0,0 +1,114 @@\n+\"\"\"E2E tests for OAGW body validation guardrails.\"\"\"\n+import asyncio\n+from urllib.parse import urlparse\n+\n+import httpx\n+import pytest\n+\n+from .helpers import create_route, create_upstream, delete_upstream, unique_alias\n+\n+\n+async def _raw_http_request(host: str, port: int, raw_request: bytes, timeout: float = 10.0) -> str:\n+    \"\"\"Send a raw HTTP request and return the raw response as a string.\"\"\"\n+    reader, writer = await asyncio.wait_for(\n+        asyncio.open_connection(host, port), timeout=timeout,\n+    )\n+    writer.write(raw_request)\n+    await writer.drain()\n+    response = await asyncio.wait_for(reader.read(8192), timeout=timeout)\n+    writer.close()\n+    return response.decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _parse_status_code(raw_response: str) -> int:\n+    \"\"\"Extract the HTTP status code from a raw response.\"\"\"\n+    # e.g. \"HTTP/1.1 400 Bad Request\\r\\n...\"\n+    first_line = raw_response.split(\"\\r\\n\", 1)[0]\n+    return int(first_line.split(\" \", 2)[1])\n+\n+\n+@pytest.mark.asyncio\n+async def test_invalid_content_length_returns_400(\n+    oagw_base_url, oagw_headers, mock_upstream_url, mock_upstream,\n+):\n+    \"\"\"Non-integer Content-Length returns 400.\"\"\"\n+    alias = unique_alias(\"body-cl\")\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        upstream = await create_upstream(\n+            client, oagw_base_url, oagw_headers, mock_upstream_url, alias=alias,\n+        )\n+        uid = upstream[\"id\"]\n+        await create_route(\n+            client, oagw_base_url, oagw_headers, uid, [\"POST\"], \"/v1/test\",\n+        )\n+\n+        # httpx/h11 rejects invalid Content-Length client-side, so use raw socket.\n+        parsed = urlparse(oagw_base_url)\n+        host = parsed.hostname or \"127.0.0.1\"\n+        port = parsed.port or 80\n+","path":"testing/e2e/modules/oagw/test_body_validation.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, understood — thank you for clarifying the test environment constraints. Since OAGW E2E tests are designed to run exclusively against the local HTTP server, the HTTPS concern doesn't apply here. I've noted this for future reference.\n\n---\n\n<details>\n<summary>✏️ Learnings added</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: testing/e2e/modules/oagw/test_body_validation.py:45-49\nTimestamp: 2026-02-17T17:08:23.581Z\nLearning: In the cyberfabric/cyberfabric-core repository, OAGW E2E tests (testing/e2e/modules/oagw/) are always run against a local HTTP server (127.0.0.1:8086) and do not use HTTPS. Raw socket helpers in these tests are designed for HTTP-only environments.\n```\n\n> Note: Learnings are effective only in the context of similar code segments. To apply general coding guidelines, please configure [review instructions](https://docs.coderabbit.ai/guides/review-instructions). You can manage existing learnings in the [app](https://app.coderabbit.ai/learnings).\n\n</details>\n\n\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:08:32Z","updated_at":"2026-02-17T17:08:33Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818099625","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818099625"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818099625"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818099625/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":45,"original_start_line":45,"start_side":"RIGHT","line":49,"original_line":49,"side":"RIGHT","in_reply_to_id":2818055428,"author_association":"CONTRIBUTOR","original_position":49,"position":49,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818171531","pull_request_review_id":3815265856,"id":2818171531,"node_id":"PRRC_kwDOPaLyBs6n-eKL","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }\n+            }\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+\n+        // 7. Build URL.\n+        // path_suffix is the full path from the proxy URL; strip the route prefix\n+        // so we get: endpoint + route_path + remaining_suffix.\n+        let route_path = route\n+            .match_rules\n+            .http\n+            .as_ref()\n+            .map_or(\"/\", |h| h.path.as_str());\n+        let remaining_suffix = path_suffix.strip_prefix(route_path).unwrap_or(\"\");\n+        let url = request_builder::build_upstream_url(\n+            endpoint,\n+            route_path,\n+            remaining_suffix,\n+            &query_params,\n+        )?;\n+\n+        // 8. Forward request with timeout on response headers.\n+        let send_future = self\n+            .http_client\n+            .request(method, &url)\n+            .headers(outbound_headers)\n+            .body(body_bytes)\n+            .send();\n+\n+        let timeout = self.request_timeout;\n+        let response = tokio::time::timeout(timeout, send_future)\n+            .await\n+            .map_err(|_| DomainError::RequestTimeout {\n+                detail: format!(\"request to {url} timed out after {timeout:?}\"),\n+                instance: instance_uri.clone(),\n+            })?\n+            .map_err(|e| {\n+                if e.is_connect() {\n+                    DomainError::ConnectionTimeout {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                } else {\n+                    DomainError::DownstreamError {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                }\n+            })?;\n+\n+        // 9. Build streaming response.\n+        let status = response.status();\n+        let resp_headers = response.headers().clone();\n+\n+        let body_stream: BodyStream = Box::pin(\n+            response\n+                .bytes_stream()\n+                .map(|r| r.map_err(|e| Box::new(e) as BoxError)),\n+        );\n+\n+        let mut resp = http::Response::builder()\n+            .status(status)\n+            .body(Body::Stream(body_stream))\n+            .map_err(|e| DomainError::DownstreamError {\n+                detail: format!(\"failed to build response: {e}\"),\n+                instance: instance_uri,\n+            })?;\n+\n+        *resp.headers_mut() = resp_headers;\n+        resp.extensions_mut().insert(ErrorSource::Upstream);","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"striped-zebra-dev","id":225538363,"node_id":"U_kgDODXFxOw","avatar_url":"https://avatars.githubusercontent.com/u/225538363?v=4","gravatar_id":"","url":"https://api.github.com/users/striped-zebra-dev","html_url":"https://github.com/striped-zebra-dev","followers_url":"https://api.github.com/users/striped-zebra-dev/followers","following_url":"https://api.github.com/users/striped-zebra-dev/following{/other_user}","gists_url":"https://api.github.com/users/striped-zebra-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/striped-zebra-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/striped-zebra-dev/subscriptions","organizations_url":"https://api.github.com/users/striped-zebra-dev/orgs","repos_url":"https://api.github.com/users/striped-zebra-dev/repos","events_url":"https://api.github.com/users/striped-zebra-dev/events{/privacy}","received_events_url":"https://api.github.com/users/striped-zebra-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed.","created_at":"2026-02-17T17:24:02Z","updated_at":"2026-02-17T17:24:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818171531","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818171531"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818171531"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818171531/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":300,"original_start_line":297,"start_side":"RIGHT","line":320,"original_line":316,"side":"RIGHT","in_reply_to_id":2818055405,"author_association":"MEMBER","original_position":316,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818174443","pull_request_review_id":3815269600,"id":2818174443,"node_id":"PRRC_kwDOPaLyBs6n-e3r","diff_hunk":"@@ -0,0 +1,320 @@\n+use std::collections::HashMap;\n+use std::sync::Arc;\n+use std::time::Duration;\n+\n+use crate::domain::credential::CredentialResolver;\n+use crate::domain::error::DomainError;\n+use crate::domain::model::{PassthroughMode, PathSuffixMode};\n+use crate::domain::plugin::AuthContext;\n+use futures_util::StreamExt;\n+use http::{HeaderMap, HeaderName, HeaderValue};\n+use modkit_security::SecurityContext;\n+use oagw_sdk::api::ErrorSource;\n+use oagw_sdk::body::{Body, BodyStream, BoxError};\n+\n+use crate::domain::services::{ControlPlaneService, DataPlaneService};\n+\n+use crate::domain::rate_limit::RateLimiter;\n+use crate::infra::plugin::AuthPluginRegistry;\n+\n+use super::headers;\n+use super::request_builder;\n+\n+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);\n+const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);\n+\n+/// Data Plane service implementation: proxy orchestration and plugin execution.\n+pub struct DataPlaneServiceImpl {\n+    cp: Arc<dyn ControlPlaneService>,\n+    http_client: reqwest::Client,\n+    auth_registry: AuthPluginRegistry,\n+    rate_limiter: RateLimiter,\n+    request_timeout: Duration,\n+}\n+\n+impl DataPlaneServiceImpl {\n+    /// # Errors\n+    ///\n+    /// Returns an error if the HTTP client cannot be built.\n+    pub fn new(\n+        cp: Arc<dyn ControlPlaneService>,\n+        credential_resolver: Arc<dyn CredentialResolver>,\n+    ) -> anyhow::Result<Self> {\n+        let http_client = reqwest::Client::builder()\n+            .connect_timeout(CONNECT_TIMEOUT)\n+            // No overall timeout — SSE streams run indefinitely.\n+            // Request-header timeout is applied via tokio::time::timeout below.\n+            .build()?;\n+\n+        let auth_registry = AuthPluginRegistry::with_builtins(credential_resolver);\n+        let rate_limiter = RateLimiter::new();\n+\n+        Ok(Self {\n+            cp,\n+            http_client,\n+            auth_registry,\n+            rate_limiter,\n+            request_timeout: REQUEST_TIMEOUT,\n+        })\n+    }\n+\n+    /// Override the request timeout.\n+    #[must_use]\n+    pub fn with_request_timeout(mut self, timeout: Duration) -> Self {\n+        self.request_timeout = timeout;\n+        self\n+    }\n+}\n+\n+#[async_trait::async_trait]\n+impl DataPlaneService for DataPlaneServiceImpl {\n+    async fn proxy_request(\n+        &self,\n+        ctx: SecurityContext,\n+        req: http::Request<Body>,\n+    ) -> Result<http::Response<Body>, DomainError> {\n+        let instance_uri = req.uri().to_string();\n+\n+        // Parse alias and path_suffix from URI (collect to owned before consuming req).\n+        let (alias, path_suffix) = {\n+            let path = req.uri().path();\n+            let trimmed = path.strip_prefix('/').unwrap_or(path);\n+            match trimmed.find('/') {\n+                Some(pos) => (trimmed[..pos].to_string(), trimmed[pos..].to_string()),\n+                None => (trimmed.to_string(), String::new()),\n+            }\n+        };\n+\n+        // Parse query parameters with proper URL decoding.\n+        let query_params: Vec<(String, String)> = req\n+            .uri()\n+            .query()\n+            .map(|q| {\n+                form_urlencoded::parse(q.as_bytes())\n+                    .map(|(k, v)| (k.into_owned(), v.into_owned()))\n+                    .collect()\n+            })\n+            .unwrap_or_default();\n+\n+        let (parts, body) = req.into_parts();\n+        let method = parts.method;\n+        let req_headers = parts.headers;\n+\n+        // Convert Body to Bytes for the outbound HTTP request.\n+        let body_bytes = body\n+            .into_bytes()\n+            .await\n+            .map_err(|e| DomainError::Validation {\n+                detail: format!(\"failed to read request body: {e}\"),\n+                instance: instance_uri.clone(),\n+            })?;\n+\n+        // 1. Resolve upstream by alias.\n+        let upstream = self.cp.resolve_upstream(&ctx, &alias).await?;\n+\n+        // 2. Resolve route.\n+        let route = self\n+            .cp\n+            .resolve_route(&ctx, upstream.id, method.as_ref(), &path_suffix)\n+            .await?;\n+\n+        // 2b. Validate query parameters against route's allowlist.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && !query_params.is_empty()\n+        {\n+            for (key, _) in &query_params {\n+                if !http_match.query_allowlist.contains(key) {\n+                    return Err(DomainError::Validation {\n+                        detail: format!(\n+                            \"query parameter '{}' is not in the route's query_allowlist\",\n+                            key\n+                        ),\n+                        instance: instance_uri,\n+                    });\n+                }\n+            }\n+        }\n+\n+        // 2c. Enforce path_suffix_mode.\n+        if let Some(ref http_match) = route.match_rules.http\n+            && http_match.path_suffix_mode == PathSuffixMode::Disabled\n+        {\n+            let route_path = &http_match.path;\n+            let extra = path_suffix.strip_prefix(route_path.as_str()).unwrap_or(\"\");\n+            if !extra.is_empty() {\n+                return Err(DomainError::Validation {\n+                    detail: format!(\n+                        \"path suffix not allowed: route path_suffix_mode is disabled but request has extra path '{}'\",\n+                        extra\n+                    ),\n+                    instance: instance_uri,\n+                });\n+            }\n+        }\n+\n+        // 3. Prepare outbound headers (passthrough + strip).\n+        let mode = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or(PassthroughMode::None, |r| r.passthrough);\n+        let allowlist: Vec<String> = upstream\n+            .headers\n+            .as_ref()\n+            .and_then(|h| h.request.as_ref())\n+            .map_or_else(Vec::new, |r| r.passthrough_allowlist.clone());\n+        let mut outbound_headers = headers::apply_passthrough(&req_headers, &mode, &allowlist);\n+        headers::strip_hop_by_hop(&mut outbound_headers);\n+        headers::strip_internal_headers(&mut outbound_headers);\n+\n+        // 4. Execute auth plugin.\n+        if let Some(ref auth) = upstream.auth {\n+            let plugin = self.auth_registry.resolve(&auth.plugin_type).map_err(|e| {\n+                DomainError::AuthenticationFailed {\n+                    detail: e.to_string(),\n+                    instance: instance_uri.clone(),\n+                }\n+            })?;\n+            let auth_headers: HashMap<String, String> = outbound_headers\n+                .iter()\n+                .filter_map(|(k, v)| {\n+                    v.to_str()\n+                        .ok()\n+                        .map(|s| (k.as_str().to_string(), s.to_string()))\n+                })\n+                .collect();\n+            let mut auth_ctx = AuthContext {\n+                headers: auth_headers,\n+                config: auth.config.clone().unwrap_or_default(),\n+            };\n+            plugin\n+                .authenticate(&mut auth_ctx)\n+                .await\n+                .map_err(|e| match e {\n+                    crate::domain::plugin::PluginError::SecretNotFound(ref s) => {\n+                        DomainError::SecretNotFound {\n+                            detail: s.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::Rejected(ref msg) => {\n+                        DomainError::Validation {\n+                            detail: msg.clone(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                    crate::domain::plugin::PluginError::AuthFailed(_)\n+                    | crate::domain::plugin::PluginError::Internal(_) => {\n+                        DomainError::AuthenticationFailed {\n+                            detail: e.to_string(),\n+                            instance: instance_uri.clone(),\n+                        }\n+                    }\n+                })?;\n+            outbound_headers = HeaderMap::new();\n+            for (k, v) in &auth_ctx.headers {\n+                if let (Ok(name), Ok(val)) = (\n+                    HeaderName::from_bytes(k.as_bytes()),\n+                    HeaderValue::from_str(v),\n+                ) {\n+                    outbound_headers.insert(name, val);\n+                }\n+            }\n+        }\n+\n+        // 5. Apply header rules + set Host.\n+        if let Some(ref hc) = upstream.headers\n+            && let Some(ref rules) = hc.request\n+        {\n+            headers::apply_header_rules(&mut outbound_headers, rules);\n+        }\n+        let endpoint =\n+            upstream\n+                .server\n+                .endpoints\n+                .first()\n+                .ok_or_else(|| DomainError::DownstreamError {\n+                    detail: \"upstream has no endpoints\".into(),\n+                    instance: instance_uri.clone(),\n+                })?;\n+        headers::set_host_header(&mut outbound_headers, &endpoint.host, endpoint.port);\n+\n+        // 6. Check rate limit (upstream then route).\n+        if let Some(ref rl) = upstream.rate_limit {\n+            let key = format!(\"upstream:{}\", upstream.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+        if let Some(ref rl) = route.rate_limit {\n+            let key = format!(\"route:{}\", route.id);\n+            self.rate_limiter.try_consume(&key, rl, &instance_uri)?;\n+        }\n+\n+        // 7. Build URL.\n+        // path_suffix is the full path from the proxy URL; strip the route prefix\n+        // so we get: endpoint + route_path + remaining_suffix.\n+        let route_path = route\n+            .match_rules\n+            .http\n+            .as_ref()\n+            .map_or(\"/\", |h| h.path.as_str());\n+        let remaining_suffix = path_suffix.strip_prefix(route_path).unwrap_or(\"\");\n+        let url = request_builder::build_upstream_url(\n+            endpoint,\n+            route_path,\n+            remaining_suffix,\n+            &query_params,\n+        )?;\n+\n+        // 8. Forward request with timeout on response headers.\n+        let send_future = self\n+            .http_client\n+            .request(method, &url)\n+            .headers(outbound_headers)\n+            .body(body_bytes)\n+            .send();\n+\n+        let timeout = self.request_timeout;\n+        let response = tokio::time::timeout(timeout, send_future)\n+            .await\n+            .map_err(|_| DomainError::RequestTimeout {\n+                detail: format!(\"request to {url} timed out after {timeout:?}\"),\n+                instance: instance_uri.clone(),\n+            })?\n+            .map_err(|e| {\n+                if e.is_connect() {\n+                    DomainError::ConnectionTimeout {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                } else {\n+                    DomainError::DownstreamError {\n+                        detail: e.to_string(),\n+                        instance: instance_uri.clone(),\n+                    }\n+                }\n+            })?;\n+\n+        // 9. Build streaming response.\n+        let status = response.status();\n+        let resp_headers = response.headers().clone();\n+\n+        let body_stream: BodyStream = Box::pin(\n+            response\n+                .bytes_stream()\n+                .map(|r| r.map_err(|e| Box::new(e) as BoxError)),\n+        );\n+\n+        let mut resp = http::Response::builder()\n+            .status(status)\n+            .body(Body::Stream(body_stream))\n+            .map_err(|e| DomainError::DownstreamError {\n+                detail: format!(\"failed to build response: {e}\"),\n+                instance: instance_uri,\n+            })?;\n+\n+        *resp.headers_mut() = resp_headers;\n+        resp.extensions_mut().insert(ErrorSource::Upstream);","path":"modules/system/oagw/oagw/src/infra/proxy/service.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, thank you for addressing this! The sanitization ensures hop-by-hop and internal headers won't leak to clients through the upstream response path.\n\n<!-- <review_comment_addressed> -->\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n---\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: testing/e2e/modules/oagw/test_body_validation.py:45-49\nTimestamp: 2026-02-17T17:08:23.581Z\nLearning: In the cyberfabric/cyberfabric-core repository, OAGW E2E tests (testing/e2e/modules/oagw/) are always run against a local HTTP server (127.0.0.1:8086) and do not use HTTPS. Raw socket helpers in these tests are designed for HTTP-only environments.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T17:24:36Z","updated_at":"2026-02-17T17:24:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818174443","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818174443"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818174443"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818174443/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":300,"original_start_line":297,"start_side":"RIGHT","line":320,"original_line":316,"side":"RIGHT","in_reply_to_id":2818055405,"author_association":"CONTRIBUTOR","original_position":316,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2819563503","pull_request_review_id":3816829176,"id":2819563503,"node_id":"PRRC_kwDOPaLyBs6oDx_v","diff_hunk":"@@ -0,0 +1,16 @@\n+use axum::Router;\n+use axum::routing::any;\n+\n+use super::super::handlers;\n+\n+/// Register the proxy catch-all route.\n+///\n+/// Uses manual route registration because the proxy endpoint accepts all HTTP\n+/// methods on a wildcard path, which doesn't fit the OperationBuilder's\n+/// single-method pattern.\n+pub(super) fn register(router: Router) -> Router {\n+ 
eb.json_response({\n+        \"id\": \"chatcmpl-mock-123\",\n+        \"object\": \"chat.completion\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\n+            \"index\": 0,\n+            \"message\": {\"role\": \"assistant\", \"content\": \"Hello from mock server\"},\n+            \"finish_reason\": \"stop\",\n+        }],\n+        \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 20, \"total_tokens\": 30},\n+    })\n+\n+\n+async def handle_models(request: web.Request) -> web.Response:\n+    \"\"\"OpenAI-compatible model list.\"\"\"\n+    return web.json_response({\n+        \"object\": \"list\",\n+        \"data\": [\n+            {\"id\": \"gpt-4\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+            {\"id\": \"gpt-3.5-turbo\", \"object\": \"model\", \"created\": 1_234_567_890, \"owned_by\": \"openai\"},\n+        ],\n+    })\n+\n+\n+async def handle_stream_chat_completions(request: web.Request) -> web.StreamResponse:\n+    \"\"\"SSE streaming chat completion.\"\"\"\n+    resp = web.StreamResponse(\n+        status=200,\n+        headers={\"Content-Type\": \"text/event-stream\", \"Cache-Control\": \"no-cache\"},\n+    )\n+    await resp.prepare(request)\n+\n+    words = [\"Hello\", \" from\", \" mock\", \" server\"]\n+    for i, word in enumerate(words):\n+        delta = {}\n+        if i == 0:\n+            delta[\"role\"] = \"assistant\"\n+        delta[\"content\"] = word\n+        chunk = {\n+            \"id\": \"chatcmpl-mock-stream\",\n+            \"object\": \"chat.completion.chunk\",\n+            \"created\": 1_234_567_890,\n+            \"model\": \"gpt-4-mock\",\n+            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": None}],\n+        }\n+        await resp.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())\n+        await asyncio.sleep(0.01)\n+\n+    # Final chunk with finish_reason\n+    final = {\n+        \"id\": \"chatcmpl-mock-stream\",\n+        \"object\": \"chat.completion.chunk\",\n+        \"created\": 1_234_567_890,\n+        \"model\": \"gpt-4-mock\",\n+        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}],\n+    }\n+    await resp.write(f\"data: {json.dumps(final)}\\n\\n\".encode())\n+    await resp.write(b\"data: [DONE]\\n\\n\")\n+    await resp.write_eof()\n+    return resp\n+\n+\n+async def handle_error_code(request: web.Request) -> web.Response:\n+    \"\"\"Return a configurable HTTP error status.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response(\n+        {\"error\": {\"message\": f\"Simulated error {code}\", \"type\": \"server_error\", \"code\": f\"error_{code}\"}},\n+        status=code,\n+    )\n+\n+\n+async def handle_error_timeout(request: web.Request) -> web.Response:\n+    \"\"\"Sleep long enough for the gateway proxy timeout to fire.\"\"\"\n+    await asyncio.sleep(30)\n+    return web.Response(text=\"should not reach here\")\n+\n+\n+async def handle_status(request: web.Request) -> web.Response:\n+    \"\"\"Return configurable status code.\"\"\"\n+    code = int(request.match_info[\"code\"])\n+    return web.json_response({\"status\": code, \"description\": f\"Status {code}\"}, status=code)\n+\n+\n+# ---------------------------------------------------------------------------\n+# App factory\n+# ---------------------------------------------------------------------------\n+\n+def create_app() -> web.Application:\n+    app = web.Application()\n+    app.router.add_get(\"/health\", handle_health)\n+    app.router.add_post(\"/echo\", handle_echo)\n+    app.router.add_post(\"/v1/chat/completions\", handle_chat_completions)\n+    app.router.add_get(\"/v1/models\", handle_models)\n+    app.router.add_post(\"/v1/chat/completions/stream\", handle_stream_chat_completions)\n+    app.router.add_get(\"/error/{code}\", handle_error_code)\n+    app.router.add_get(\"/error/timeout\", handle_error_timeout)\n+    app.router.add_get(\"/status/{code}\", handle_status)","path":"testing/e2e/modules/oagw/mock_upstream.py","commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, thank you for confirming! You're absolutely right that the tests currently work because the gateway's proxy timeout (2s) fires before the handler's 30s sleep completes, effectively masking the route order issue. Fixing the registration order will make the mock server's behavior more explicit and prevent any surprising int() conversion errors if the route is accessed directly. Appreciate the fix!\n\n<!-- <review_comment_addressed> -->\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:45:53Z","updated_at":"2026-02-17T16:45:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817998740","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817998740"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817998740"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817998740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":129,"start_side":"RIGHT","line":null,"original_line":131,"side":"RIGHT","in_reply_to_id":2817227558,"author_association":"CONTRIBUTOR","original_position":131,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817999179","pull_request_review_id":3815072407,"id":2817999179,"node_id":"PRRC_kwDOPaLyBs6n90FL","diff_hunk":"@@ -0,0 +1,94 @@\n+\"\"\"Pytest configuration and fixtures for OAGW E2E tests.\"\"\"\n+import asyncio\n+import os\n+import threading\n+\n+import httpx\n+import pytest\n+\n+from .mock_upstream import MockUpstreamServer\n+\n+\n+# ---------------------------------------------------------------------------\n+# Environment-driven fixtures\n+# ---------------------------------------------------------------------------\n+\n+@pytest.fixture\n+def oagw_base_url():\n+    \"\"\"OAGW service base URL.\"\"\"\n+    return os.getenv(\"E2E_OAGW_BASE_URL\", \"http://localhost:8086\")\n+\n+\n+@pytest.fixture\n+def mock_upstream_url():\n+    \"\"\"Mock upstream base URL (must be reachable by the OAGW service).\"\"\"\n+    return os.getenv(\"E2E_MOCK_UPSTREAM_URL\", \"http://127.0.0.1:19876\")\n+\n+\n+@pytest.fixture\n+def tenant_id():\n+    \"\"\"Fixed tenant UUID for test isolation.\"\"\"\n+    return \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\"\n+\n+\n+@pytest.fixture\n+def oagw_headers(tenant_id):\n+    \"\"\"Standard headers for OAGW requests (tenant + optional auth).\"\"\"\n+    headers = {\"x-tenant-id\": tenant_id}\n+    token = os.getenv(\"E2E_AUTH_TOKEN\")\n+    if token:\n+        headers[\"Authorization\"] = f\"Bearer {token}\"\n+    return headers\n+\n+\n+# ---------------------------------------------------------------------------\n+# Session-scoped mock upstream server\n+# ---------------------------------------------------------------------------\n+\n+@pytest.fixture(scope=\"session\")\n+def mock_upstream():\n+    \"\"\"Start the mock upstream server for the entire test session.\"\"\"\n+    url = os.getenv(\"E2E_MOCK_UPSTREAM_URL\", \"http://127.0.0.1:19876\")\n+\n+    # If a custom URL is set, assume the mock is managed externally.\n+    if os.getenv(\"E2E_MOCK_UPSTREAM_EXTERNAL\"):\n+        yield\n+        return\n+\n+    # Parse port from URL.\n+    port = int(url.rsplit(\":\", 1)[-1].split(\"/\")[0])\n+    server = MockUpstreamServer(host=\"0.0.0.0\", port=port)\n+\n+    # Run the mock server in a background thread with its own event loop\n+    # so it can actually serve requests while tests run.\n+    loop = asyncio.new_event_loop()\n+    loop.run_until_complete(server.start())\n+\n+    thread = threading.Thread(target=loop.run_forever, daemon=True)\n+    thread.start()\n+\n+    yield server\n+\n+    loop.call_soon_threadsafe(loop.stop)\n+    thread.join(timeout=5)\n+    loop.run_until_complete(server.stop())\n+    loop.close()","path":"testing/e2e/modules/oagw/conftest.py","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"9031712ef4dde3cb0703f060c3283df2114d94ec","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"`@striped-zebra-dev`, thanks for the explanation! You're correct that `run_until_complete()` can work on a stopped loop — it will run the event loop until the coroutine completes, even after `run_forever()` has been stopped in the background thread. The subtle point is that the loop is now running in a different thread (main thread) than it was during `run_forever()` (background thread), which can occasionally be fragile depending on what `server.stop()` does internally.\n\nThat said, if `server.stop()` is simple and you haven't observed failures in practice, deferring the cleanup to a follow-up is perfectly reasonable. The current code should work for your use case. Thanks for planning to refactor it for clarity!\n\n---\n\n<details>\n<summary>🧠 Learnings used</summary>\n\n```\nLearnt from: striped-zebra-dev\nRepo: cyberfabric/cyberfabric-core PR: 624\nFile: modules/system/oagw/DESIGN.md:257-305\nTimestamp: 2026-02-17T16:39:13.974Z\nLearning: Repository cyberfabric/cyberfabric-core: This project does not use \"openspec\"; do not request openspec proposals or spec-delta files. For OAGW and related modules, the canonical design sources are modules/system/oagw/DESIGN.md and ADRs under modules/system/oagw/docs, with future work tracked in those documents.\n```\n\n</details>\n\n\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:45:59Z","updated_at":"2026-02-17T16:45:59Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817999179","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817999179"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2817999179"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2817999179/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":72,"original_start_line":72,"start_side":"RIGHT","line":75,"original_line":75,"side":"RIGHT","in_reply_to_id":2817227553,"author_association":"CONTRIBUTOR","original_position":75,"position":75,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055369","pull_request_review_id":3815132047,"id":2818055369,"node_id":"PRRC_kwDOPaLyBs6n-BzJ","diff_hunk":"@@ -0,0 +1,254 @@\n+use std::pin::Pin;\n+\n+use bytes::Bytes;\n+use futures_core::Stream;\n+\n+/// Boxed error type for body stream errors.\n+pub type BoxError = Box<dyn std::error::Error + Send + Sync>;\n+\n+/// A streaming body.\n+pub type BodyStream = Pin<Box<dyn Stream<Item = Result<Bytes, BoxError>> + Send>>;\n+\n+/// Unified body type for gateway proxy requests and responses.\n+///\n+/// Covers every protocol through a single `proxy_request` call:\n+/// - `Empty` — no body (GET, HEAD, DELETE)\n+/// - `Bytes` — buffered body (small JSON payloads, typical API calls)\n+/// - `Stream` — streaming body (SSE, chunked transfer, large payloads,\n+///   **and WebSocket messages** serialized as byte chunks)\n+///\n+/// # Protocol mapping\n+///\n+/// | Protocol  | Request Body          | Response Body          |\n+/// |-----------|-----------------------|------------------------|\n+/// | HTTP      | `Body::Bytes`/`Empty` | `Body::Bytes`          |\n+/// | SSE       | `Body::Bytes`/`Empty` | `Body::Stream`         |\n+/// | WebSocket | `Body::Stream`        | `Body::Stream`         |\n+pub enum Body {\n+    /// No body.\n+    Empty,\n+    /// Fully buffered body.\n+    Bytes(Bytes),\n+    /// Streaming body (SSE responses, WebSocket messages, chunked transfers).\n+    Stream(BodyStream),\n+}\n+\n+impl std::fmt::Debug for Body {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        match self {\n+            Body::Empty => write!(f, \"Body::Empty\"),\n+            Body::Bytes(b) => write!(f, \"Body::Bytes({} bytes)\", b.len()),\n+            Body::Stream(_) => write!(f, \"Body::Stream(...)\"),\n+        }\n+    }\n+}\n+\n+impl Body {\n+    /// Returns `true` if this is an empty body.\n+    #[must_use]\n+    pub fn is_empty(&self) -> bool {\n+        matches!(self, Body::Empty)\n+    }","path":"modules/system/oagw/oagw-sdk/src/body.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**`is_empty` misses zero-length `Body::Bytes`.**\n\nEven though `From<Bytes>` maps empty bytes to `Body::Empty`, callers can still construct `Body::Bytes(Bytes::new())`, and `is_empty` will return false for an empty payload. Consider treating empty `Bytes` as empty.  \n\n\n<details>\n<summary>🔧 Suggested fix</summary>\n\n```diff\n pub fn is_empty(&self) -> bool {\n-    matches!(self, Body::Empty)\n+    matches!(self, Body::Empty) || matches!(self, Body::Bytes(b) if b.is_empty())\n }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw-sdk/src/body.rs` around lines 46 - 51, The is_empty\nmethod on Body only checks for Body::Empty but should also treat a Body::Bytes\ncontaining zero-length bytes as empty; update the Body::is_empty implementation\nto return true for Body::Empty OR when matching Body::Bytes(b) and b.is_empty(),\nso callers creating Body::Bytes(Bytes::new()) are handled the same as\nBody::Empty.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-17T16:58:02Z","updated_at":"2026-02-17T17:07:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055369","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055369"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/624#discussion_r2818055369"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/624"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":46,"original_start_line":46,"start_side":"RIGHT","line":51,"original_line":51,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":51,"position":51,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2818055383","pull_request_review_id":3815132047,"id":2818055383,"node_id":"PRRC_kwDOPaLyBs6n-BzX","diff_hunk":"@@ -0,0 +1,911 @@\n+// REST DTOs for the OAGW API.\n+//\n+// These types own serde annotations and JSON schema concerns. They convert\n+// to/from internal domain types via `From` impls for the service layer boundary.\n+\n+use std::collections::HashMap;\n+\n+use serde::{Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+use crate::domain::model as domain;\n+\n+// ---------------------------------------------------------------------------\n+// Shared enums\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum SharingMode {\n+    #[default]\n+    Private,\n+    Inherit,\n+    Enforce,\n+}\n+\n+// ---------------------------------------------------------------------------\n+// Endpoint / Server\n+// ---------------------------------------------------------------------------\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default, utoipa::ToSchema)]\n+#[serde(rename_all = \"snake_case\")]\n+pub enum Scheme {\n+    Http,\n+    #[default]\n+    Https,\n+    Wss,\n+    Wt,\n+    Grpc,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]\n+pub struct Endpoint {\n+    #[serde(default)]\n+    pub scheme: Scheme,\n+    pub host: String,\n+    #[serde(default = \"default_port\")]\n+    pub port: u16,\n+}\n+\n+fn default_port() -> u16 {\n+    443\n+}","path":"modules/system/oagw/oagw/src/api/rest/dto.rs","commit_id":"04cea814632df97d508624362a221003b4b2f36e","original_commit_id":"6113a8871feef1cbab6dc2024bb50aecb7fa07c2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n<details>\n<summary>🧩 Analysis chain</summary>\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Scan for Endpoint defaults/normalization or scheme/port validation.\nrg -n \"default_port|struct Endpoint|scheme.*port|port.*scheme|normalize_port|validate.*port\" modules/system/oagw -g'*.rs'\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 4710\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check the From implementation in rest/dto.rs and context around request_builder.rs\necho \"=== REST DTO Endpoint struct and From implementation ===\"\nsed -n '41,80p' modules/system/oagw/oagw/src/api/rest/dto.rs\n\necho \"\"\necho \"=== Request builder is_default_port usage ===\"\nsed -n '25,35p' modules/system/oagw/oagw/src/infra/proxy/request_builder.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 1773\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Find From implementation for dto::Endpoint\nrg -A 10 \"impl From.*Endpoint\" modules/system/oagw/oagw/src/api/rest/dto.rs\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 562\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check domain::Endpoint and any normalization logic\necho \"=== Domain Endpoint struct ===\"\nsed -n '36,50p' modules/system/oagw/oagw/src/domain/model.rs\n\necho \"\"\necho \"=== Check for any validate/normalize functions on Endpoint ===\"\nrg -A 5 \"fn.*validate.*endpoint|fn.*normalize.*endpoint|impl.*Endpoint.*{\" modules/system/oagw/oagw/src/domain/model.rs | head -30\n```\n\nRepository: cyberfabric/cyberfabric-core\n\nLength of output: 709\n\n---\n\n\n\n</details>\n\n**Default port always 443, even for HTTP endpoints.**\n\nWhen a client omits the `port` field from an HTTP endpoint, serde defaults it to 443 (line 46). The `From` implementation (lines 54-60) passes this value directly to the domain model without considering the scheme. This results in semantically incorrect endpoints like `http://example.com:443`. The `is_default_port()` check in request_builder.rs only affects URL formatting and does not correct the underlying port value in the domain model.\n\nMake the port optional and resolve it based on scheme during conversion:\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n pub struct Endpoint {\n     #[serde(default)]\n     pub scheme: Scheme,\n     pub host: String,\n-    #[serde(default = \"default_port\")]\n-    pub port: u16,\n+    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+    pub port: Option<u16>,\n }\n-\n-fn default_port() -> u16 {\n-    443\n-}\n```\n\n```diff\n impl From<Endpoint> for domain::Endpoint {\n     fn from(v: Endpoint) -> Self {\n+        let port = v.port.unwrap_or_else(|| match v.scheme {\n+            Scheme::Http => 80,\n+            _ => 443,\n+        });\n         Self {\n             scheme: v.scheme.into(),\n             host: v.host,\n-            port: v.port,\n+            port,\n         }\n     }\n }\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@modules/system/oagw/oagw/src/api/rest/dto.rs` around lines 41 - 52, The\nEndpoint DTO currently sets port to 443 by default causing HTTP endpoints to get\nport 443; change Endpoint.port to Option<u16> (remove/default_port), update\nserde to default to None, and update the From<Endpoint> conversion logic to\nresolve the actual port: if port.is_some() use it, otherwise set 80 for\nScheme::Http and 443 for other schemes (e.g., Scheme::Https). Adjust or remove\nthe default_port() function and ensure the From implementation (the conversion\nfrom this DTO to the domain Endpoint) applies this scheme-based resolution so\nthe domain model never receives a wrong default port.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:eagle -->\n\n<!-- This is an 
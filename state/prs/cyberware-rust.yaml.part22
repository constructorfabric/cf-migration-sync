side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618918754","pull_request_review_id":3577551064,"id":2618918754,"node_id":"PRRC_kwDOPaLyBs6cGYdi","diff_hunk":"@@ -0,0 +1,110 @@\n+//! DE0101: No Serde in Contract Models\n+//!\n+//! Contract models MUST NOT have `serde::Serialize` or `serde::Deserialize` derives.\n+//! Serde is a serialization concern that belongs in the API layer (DTOs).\n+//!\n+//! ## Example: Bad\n+//!\n+//! ```rust,ignore\n+//! // src/contract/user.rs - WRONG\n+//! use serde::{Deserialize, Serialize};\n+//!\n+//! #[derive(Debug, Clone, Serialize, Deserialize)]  // ❌ Serde in contract\n+//! pub struct User {\n+//!     pub id: UserId,\n+//!     pub name: String,\n+//!     pub email: Email,\n+//! }\n+//! ```\n+//!\n+//! ## Example: Good\n+//!\n+//! ```rust,ignore","path":"dylint_lints/contract_lints/src/de01_contract_layer/de0101_no_serde_in_contract.rs","commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","original_commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This doctest should not be ignored if these are correct","created_at":"2025-12-15T10:52:02Z","updated_at":"2025-12-15T11:17:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618918754","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618918754"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618918754"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618918754/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618921567","pull_request_review_id":3577551064,"id":2618921567,"node_id":"PRRC_kwDOPaLyBs6cGZJf","diff_hunk":"@@ -0,0 +1,102 @@\n+//! DE0102: No ToSchema in Contract Models\n+//!\n+//! Contract models MUST NOT have `utoipa::ToSchema` derive.\n+//! ToSchema is for OpenAPI documentation, which is an API layer concern.\n+//!\n+//! ## Example: Bad\n+//!\n+//! ```rust,ignore\n+//! // src/contract/product.rs - WRONG\n+//! use utoipa::ToSchema;\n+//!\n+//! #[derive(Debug, Clone, ToSchema)]  // ❌ ToSchema in contract\n+//! pub struct Product {\n+//!     pub id: ProductId,\n+//!     pub name: String,\n+//!     pub price: Money,\n+//! }\n+//! ```\n+//!\n+//! ## Example: Good\n+//!\n+//! ```rust,ignore","path":"dylint_lints/contract_lints/src/de01_contract_layer/de0102_no_toschema_in_contract.rs","commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","
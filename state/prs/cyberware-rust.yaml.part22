         arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2025-12-03T08:12:02Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584061715","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584061715"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584061715"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584061715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":60,"side":"RIGHT","in_reply_to_id":2581301942,"author_association":"MEMBER","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584063702","pull_request_review_id":3531689941,"id":2584063702,"node_id":"PRRC_kwDOPaLyBs6aBa7W","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2025-12-03T08:12:48Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584063702","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584063702"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584063702"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584063702/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":88,"side":"RIGHT","in_reply_to_id":2581303207,"author_association":"MEMBER","original_position":88,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584065262","pull_request_review_id":3531689941,"id":2584065262,"node_id":"PRRC_kwDOPaLyBs6aBbTu","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {\n+        let total_bytes = sys.total_memory();\n+        let available_bytes = sys.available_memory();\n+        let used_bytes = sys.used_memory();\n+        let used_percent = if total_bytes > 0 {\n+            ((used_bytes as f64 / total_bytes as f64) * 100.0) as u32\n+        } else {\n+            0\n+        };\n+\n+        Ok(MemoryInfo {\n+            total_bytes,\n+            available_bytes,\n+            used_bytes,\n+            used_percent,\n+        })\n+    }\n+\n+    fn collect_host_info(&self) -> Result<HostInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2025-12-03T08:13:25Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584065262","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584065262"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584065262"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584065262/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":106,"side":"RIGHT","in_reply_to_id":2581305346,"author_association":"MEMBER","original_position":106,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584077064","pull_request_review_id":3531689941,"id":2584077064,"node_id":"PRRC_kwDOPaLyBs6aBeMI","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {\n+        let total_bytes = sys.total_memory();\n+        let available_bytes = sys.available_memory();\n+        let used_bytes = sys.used_memory();\n+        let used_percent = if total_bytes > 0 {\n+            ((used_bytes as f64 / total_bytes as f64) * 100.0) as u32\n+        } else {\n+            0\n+        };\n+\n+        Ok(MemoryInfo {\n+            total_bytes,\n+            available_bytes,\n+            used_bytes,\n+            used_percent,\n+        })\n+    }\n+\n+    fn collect_host_info(&self) -> Result<HostInfo, NodeInfoError> {\n+        let hostname = hostname::get()\n+            .map(|h| h.to_string_lossy().to_string())\n+            .unwrap_or_else(|_| \"unknown\".to_string());\n+\n+        let uptime_seconds = System::uptime();\n+\n+        // Collect all IP addresses\n+        let mut ip_addresses = Vec::new();\n+\n+        // First, add the primary IP (default route interface)\n+        if let Ok(primary_ip) = local_ip_address::local_ip() {\n+            ip_addresses.push(primary_ip.to_string());\n+        }\n+\n+        // Then add all other network interface IPs\n+        if let Ok(all_ips) = local_ip_address::list_afinet_netifas() {\n+            for (_name, ip) in all_ips {\n+                let ip_str = ip.to_string();\n+                // Skip if already added as primary\n+                if !ip_addresses.contains(&ip_str) {\n+                    // Skip loopback addresses\n+                    if !ip.is_loopback() {\n+                        ip_addresses.push(ip_str);\n+                    }\n+                }\n+            }\n+        }\n+\n+        Ok(HostInfo {\n+            hostname,\n+            uptime_seconds,\n+            ip_addresses,\n+        })\n+    }\n+\n+    fn collect_gpu_info(&self) -> Result<Vec<GpuInfo>, NodeInfoError> {\n+        // Use platform-specific GPU detection\n+        #[cfg(target_os = \"macos\")]\n+        {\n+            super::gpu_collector_macos::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"linux\")]\n+        {\n+            super::gpu_collector_linux::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"windows\")]\n+        {\n+            super::gpu_collector_windows::collect_gpu_info()\n+        }\n+        #[cfg(not(any(target_os = \"macos\", target_os = \"linux\", target_os = \"windows\")))]\n+        {\n+            Ok(Vec::new())","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"fixed","created_at":"2025-12-03T08:18:01Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584077064","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584077064"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584077064"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584077064/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":158,"side":"RIGHT","in_reply_to_id":2581307366,"author_association":"MEMBER","original_position":158,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584082301","pull_request_review_id":3531689941,"id":2584082301,"node_id":"PRRC_kwDOPaLyBs6aBfd9","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {\n+        let total_bytes = sys.total_memory();\n+        let available_bytes = sys.available_memory();\n+        let used_bytes = sys.used_memory();\n+        let used_percent = if total_bytes > 0 {\n+            ((used_bytes as f64 / total_bytes as f64) * 100.0) as u32\n+        } else {\n+            0\n+        };\n+\n+        Ok(MemoryInfo {\n+            total_bytes,\n+            available_bytes,\n+            used_bytes,\n+            used_percent,\n+        })\n+    }\n+\n+    fn collect_host_info(&self) -> Result<HostInfo, NodeInfoError> {\n+        let hostname = hostname::get()\n+            .map(|h| h.to_string_lossy().to_string())\n+            .unwrap_or_else(|_| \"unknown\".to_string());\n+\n+        let uptime_seconds = System::uptime();\n+\n+        // Collect all IP addresses\n+        let mut ip_addresses = Vec::new();\n+\n+        // First, add the primary IP (default route interface)\n+        if let Ok(primary_ip) = local_ip_address::local_ip() {\n+            ip_addresses.push(primary_ip.to_string());\n+        }\n+\n+        // Then add all other network interface IPs\n+        if let Ok(all_ips) = local_ip_address::list_afinet_netifas() {\n+            for (_name, ip) in all_ips {\n+                let ip_str = ip.to_string();\n+                // Skip if already added as primary\n+                if !ip_addresses.contains(&ip_str) {\n+                    // Skip loopback addresses\n+                    if !ip.is_loopback() {\n+                        ip_addresses.push(ip_str);\n+                    }\n+                }\n+            }\n+        }\n+\n+        Ok(HostInfo {\n+            hostname,\n+            uptime_seconds,\n+            ip_addresses,\n+        })\n+    }\n+\n+    fn collect_gpu_info(&self) -> Result<Vec<GpuInfo>, NodeInfoError> {\n+        // Use platform-specific GPU detection\n+        #[cfg(target_os = \"macos\")]\n+        {\n+            super::gpu_collector_macos::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"linux\")]\n+        {\n+            super::gpu_collector_linux::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"windows\")]\n+        {\n+            super::gpu_collector_windows::collect_gpu_info()\n+        }\n+        #[cfg(not(any(target_os = \"macos\", target_os = \"linux\", target_os = \"windows\")))]\n+        {\n+            Ok(Vec::new())\n+        }\n+    }\n+\n+    fn collect_battery_info(&self) -> Option<BatteryInfo> {\n+        // Use starship-battery for cross-platform battery detection\n+        use starship_battery::Manager;\n+\n+        let manager = Manager::new().ok()?;\n+        let mut batteries = manager.batteries().ok()?;\n+\n+        if let Some(Ok(battery)) = batteries.next() {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"can you please make a fix in that PR?","created_at":"2025-12-03T08:19:52Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584082301","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584082301"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584082301"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584082301/reactions
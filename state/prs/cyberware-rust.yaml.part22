9Z","updated_at":"2025-12-22T22:00:57Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/143#discussion_r2641361727","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/143","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2641361727"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/143#discussion_r2641361727"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/143"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2641361727/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":154,"side":"RIGHT","author_association":"MEMBER","original_position":30,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642338640","pull_request_review_id":3607037182,"id":2642338640,"node_id":"PRRC_kwDOPaLyBs6dfuNQ","diff_hunk":"@@ -0,0 +1,76 @@\n+use axum::extract::Request;\n+use axum::http::StatusCode;\n+use axum::middleware::Next;\n+use axum::response::{IntoResponse, Response};\n+use dashmap::DashMap;\n+use http::Method;\n+use std::sync::Arc;\n+\n+use modkit::api::{OperationSpec, Problem};\n+\n+const BASE_FEATURE: &str = \"gts.x.core.lic.feat.v1~x.core.global.base.v1\";\n+\n+type LicenseKey = (Method, String);\n+\n+#[derive(Clone)]\n+pub struct LicenseRequirementMap {\n+    requirements: Arc<DashMap<LicenseKey, String>>,\n+}\n+\n+impl LicenseRequirementMap {\n+    #[must_use]\n+    pub fn from_specs(specs: &[OperationSpec]) -> Self {\n+        let requirements = DashMap::new();\n+\n+        for spec in specs {\n+            if let Some(req) = spec.license_requirement.as_ref() {\n+                requirements.insert(\n+                    (spec.method.clone(), spec.path.clone()),\n+                    req.license_name.clone(),\n+                );\n+            }\n+        }\n+\n+        Self {\n+            requirements: Arc::new(requirements),\n+        }\n+    }\n+\n+    fn get(&self, method: &Method, path: &str) -> Option<String> {\n+        self.requirements\n+            .get(&(method.clone(), path.to_owned()))\n+            .map(|v| v.value().clone())\n+    }\n+}\n+\n+pub async fn license_validation_middleware(","path":"modules/api_ingress/src/middleware/license_validation.rs","commit_id":"17c504cfbaaf58f1ade0be7a7c6807b563521e85","original_commit_id":"cbc58ed53f78bf76344f82b667a017d51c861f85","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I can explain my concerns.\r\n\r\nAt the moment, we have OperationBuilder, which is largely independent of a specific API Gateway or its implementation, and that is a good thing. It allows us to give ModKit users the option to replace api_ingress with their own API Gateway, for example for scaling purposes or for other reasons.\r\nFor instance, in a cloud environment we could allow using Tyk as the API Gateway.\r\n\r\nAdding highly specialized custom middleware makes this system no longer gateway-agnostic and may cause problems later if hyperspot user wants to use a different API Gateway.","created_at":"2025-12-23T08:12:19Z","updated_at":"2025-12-23T08:12:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/143#discussion_r2642338640","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/143","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642338640"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/143#discussion_r2642338640"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/143"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642338640/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":46,"original_line":46,"side":"RIGHT","in_reply_to_id":2641329014,"author_association":"MEMBER","original_position":46,"position":46,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2645488365","pull_request_review_id":3610763871,"id":2645488365,"node_id":"PRRC_kwDOPaLyBs6drvLt","diff_hunk":"@@ -130,6 +130,16 @@ impl AsRef<str> for Action {\n \n impl AuthReqAction for Action {}\n \n+struct License;\n+\n+impl AsRef<str> for License {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"","path":"modules/api_ingress/tests/auth_middleware.rs","commit_id":"17c504cfbaaf58f1ade0be7a7c6807b563521e85","original_commit_id":"cbc58ed53f78bf76344f82b667a017d51c861f85","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-20
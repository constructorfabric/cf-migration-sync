 Self {\n-            service: arc_swap::ArcSwapOption::new(self.service.load().as_ref().map(|s| s.clone())),\n+            service: arc_swap::ArcSwapOption::new(self.service.load().as_ref().map(Clone::clone)),","path":"examples/modkit/users_info/users_info/src/module.rs","commit_id":"0f8098229471803c734ef0dac44290ab677f143c","original_commit_id":"3de959c73b23c423bb103dff0909048857411607","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Is this recommended by the linter? Looks to me that a `YourStruct::clone`\r\n\r\nthis is indeed a Clippy lint recommendation.\r\n\r\nThe specific lint is clippy::redundant_closure_for_method_calls (also known as map_clone). Clippy suggests using Clone::clone (or the method reference directly) instead of a closure when the closure just calls a method on its argument.","created_at":"2025-12-15T15:25:58Z","updated_at":"2025-12-15T15:25:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619878016","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619878016"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619878016"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619878016/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":48,"original_line":48,"side":"RIGHT","in_reply_to_id":2619664266,"author_association":"MEMBER","original_position":14,"position":14,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619916147","pull_request_review_id":3578860492,"id":2619916147,"node_id":"PRRC_kwDOPaLyBs6cKL9z","diff_hunk":"@@ -29,29 +29,36 @@ impl PluginRegistry {\n         self.plugins.insert(name.into(), plugin);\n     }\n \n-    /// Get a plugin by name\n+    /// Get a plugin by name.\n+    ///\n+    /// # Errors\n+    /// Returns `ConfigError::UnknownPlugin` if no plugin with the given name exists.\n     pub fn get(&self, name: &str) -> Result<&Arc<dyn ClaimsPlugin>, ConfigError> {\n         self.plugins\n             .get(name)\n-            .ok_or_else(|| ConfigError::UnknownPlugin(name.to_string()))\n+            .ok_or_else(|| ConfigError::UnknownPlugin(name.to_owned()))\n     }\n \n     /// Check if a plugin exists\n+    #[must_use]","path":"libs/modkit-auth/src/auth_mode.rs","commit_id":"0f8098229471803c734ef0dac44290ab677f143c","original_commit_id":"3de959c73b23c423bb103dff0909048857411607","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The lint clippy::must_use_candidate suggests adding #[must_use] to functions that:\r\n\r\n- Return a value\r\n- Have no side effects\r\n- Where ignoring the return value is almost certainly a mistake\r\n\r\nWhen #[must_use] is a bad shortcut:\r\n\r\n```\r\n// BAD - function has side effects, return value is optional\r\n#[must_use] \r\n\r\n // Wrong! Silencing lint incorrectly\r\npub fn save_and_return_id(&mut self) -> Option<Id> { ... }\r\n```\r\n\r\nThe current usage is idiomatic Rust. Standard library uses #[must_use] on len(), is_empty(), contains() etc. for the same reason.","created_at":"2025-12-15T15:34:15Z","updated_at":"2025-12-15T15:34:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619916147","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619916147"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619916147"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619916147/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":43,"original_line":43,"side":"RIGHT","in_reply_to_id":2619672007,"author_association":"MEMBER","original_position":26,"position":26,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619924691","pull_request_review_id":3578873951,"id":2619924691,"node_id":"PRRC_kwDOPaLyBs6cKODT","diff_hunk":"@@ -64,8 +62,7 @@ impl MigrationTrait for Migration {\n                 DB::Sqlite => {\n                     // SQLite cannot modify columns; add directly with NOT NULL + DEFAULT\n                     let sql = format!(\n-                        \"ALTER TABLE \\\"users\\\" ADD COLUMN \\\"tenant_id\\\" TEXT NOT NULL DEFAULT '{}'\",\n-                        root_tenant\n+                        \"ALTER TABLE \\\"users\\\" ADD COLUMN \\\"tenant_id\\\" TEXT NOT NULL DEFAULT '{root_tenant}'\"","path":"examples/modkit/users_info/users_info/src/infra/storage/migrations/add_tenant_support_002.rs","commit_id":"3de959c73b23c423bb103dff0909048857411607","original_commit_id":"3de959c73b23c423bb103dff0909048857411607","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixed","created_at":"2025-12-15T15:36:44Z","updated_at":"2025-12-15T15:36:44Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619924691","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619924691"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619924691"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619924691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":65,"side":"RIGHT","in_reply_to_id":2619657197,"author_association":"MEMBER","original_position":21,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619970378","pull_request_review_id":3578939822,"id":2619970378,"node_id":"PRRC_kwDOPaLyBs6cKZNK","diff_hunk":"@@ -45,7 +45,7 @@ impl Default for UsersInfo {\n impl Clone for UsersInfo {\n     fn clone(&self) -> Self {\n         Self {\n-            service: arc_swap::ArcSwapOption::new(self.service.load().as_ref().map(|s| s.clone())),\n+            service: arc_swap::ArcSwapOption::new(self.service.load().as_ref().map(Clone::clone)),","path":"examples/modkit/users_info/users_info/src/module.rs","commit_id":"0f8098229471803c734ef0dac44290ab677f143c","original_commit_id":"3de959c73b23c423bb103dff0909048857411607","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Clone::clone passed to map is monomorphized at compile time. The compiler generates a direct function call for the specific type, not a trait object.\r\n\r\nOkay, good to know :) ","created_at":"2025-12-15T15:52:49Z","updated_at":"2025-12-15T15:52:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619970378","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619970378"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/90#discussion_r2619970378"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/90"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2619970378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":48,"original_line":48,"side":"RIGHT","in_reply_to_id":2619664266,"author_association":"MEMBER","original_position":14,"position":14,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":89,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/89","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #89] feat(dylint): introduce dylint - architectural compliance linter framework","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89","id":3101935345,"node_id":"PR_kwDOPaLyBs6448bx","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/89","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/89.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/89.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/89","number":89,"state":"closed","locked":false,"title":"feat(dylint): introduce dylint - architectural compliance linter framework","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Introduce custom dylint linters to enforce Hyperspot's modular architecture guidelines at compile time. This provides automated validation of layer separation, DTO placement, and API conventions.\r\n\r\n**DE01 - Contract Layer** (transport-agnostic contracts):\r\n- DE0101: No Serde derives in contract models\r\n- DE0102: No ToSchema derives in contract models\r\n- DE0103: No HTTP types (StatusCode, Headers) in contracts\r\n\r\n**DE02 - API Layer** (REST implementation patterns):\r\n- DE0201: DTOs (*Dto suffix) only allowed in api/rest/\r\n- DE0202: DTOs not referenced outside API layer\r\n- DE0203: DTOs must have Serialize/Deserialize derives\r\n- DE0204: DTOs must have ToSchema derive for OpenAPI\r\n\r\n**DE08 - REST Conventions**:\r\n- DE0801: API endpoints must include version (/v1/, /v2/, etc.)\r\n\r\nIntegrated tests:\r\n- `dylint_lints/contract_lints/ui/` - test crate with proper module structure (contract/, domain/, api/rest/) for path-based lint testing\r\n- `dylint_lints/test_ui.py` - auto-discovers test files, compiles with dylint, validates expected violations using comment markers:\r\n  - `// Should trigger DExxxx` - expected violations\r\n  - `// Should NOT trigger DExxxx` - correct patterns\r\n\r\nMakefile targets:\r\n`make dylint` - Run project compliance dylint lints on the workspace\r\n`make dylint-list` - List all custom project compliance lints\r\n`make dylint-tests` - Test dylint lints on UI test cases (compile and verify violations)","created_at":"2025-12-15T10:32:53Z","updated_at":"2025-12-15T17:07:43Z","closed_at":"2025-12-15T17:07:43Z","merged_at":"2025-12-15T17:07:43Z","merge_commit_sha":"3a64fe16871ef983a4733540221a86e8dc92c684","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/89/comments","sta
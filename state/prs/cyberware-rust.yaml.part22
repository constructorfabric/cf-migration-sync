":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/1","id":3256550744,"node_id":"IC_kwDOPaLyBs7CGwVY","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-05T00:09:43Z","updated_at":"2025-09-05T22:35:59Z","body":"TODO:\r\n 1. ~~Eliminate `panic!/unwrap()` from libraries (registry, ingress, db locks, operation builder). Use proper error types.~~\r\n2. Stabilize OpenAPI schema deduplication — canonical names + conflict checks.\r\n3. Ensure graceful HTTP shutdown with lifecycle integration.\r\n4. Keep `api_ingress` thin (gateway + OpenAPI registry); move sample routes to `examples/`.\r\n5. Enforce domain → contract → HTTP error mapping into `ProblemResponse`.\r\n6. CI: add workflows (fmt, clippy, tests, deny, audit, sccache).\r\n7. Add `rust-toolchain.toml`, `justfile/Makefile`, clean up docs (remove “latest updates” logs).\r\n\r\n** Nice-to-haves: **\r\n\r\n* Metrics/logs for router rebuilds.\r\n* Trace propagation (`request_id`, domain fields).\r\n* Feature-gate heavy deps/assets.\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3256550744/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2319643139","pull_request_review_id":3181647913,"id":2319643139,"node_id":"PRRC_kwDOPaLyBs6KQvID","diff_hunk":"@@ -0,0 +1,737 @@\n+use async_trait::async_trait;\n+use std::sync::Arc;\n+\n+use arc_swap::ArcSwap;\n+use dashmap::DashMap;\n+\n+use anyhow::Result;\n+use axum::http::Method;\n+use axum::{middleware::from_fn, routing::get, Router};\n+use modkit::api::OpenApiRegistry;\n+use modkit::lifecycle::ReadySignal;\n+use parking_lot::Mutex;\n+use schemars::JsonSchema;\n+use serde::{Deserialize, Serialize};\n+use std::net::SocketAddr;\n+use std::time::Duration;\n+use tokio_util::sync::CancellationToken;\n+use tower_http::{\n+    cors::CorsLayer,\n+    limit::RequestBodyLimitLayer,\n+    request_id::{PropagateRequestIdLayer, SetRequestIdLayer},\n+    timeout::TimeoutLayer,\n+};\n+\n+mod assets;\n+\n+mod config;\n+pub mod error;\n+mod model;\n+mod openapi;\n+pub mod request_id;\n+mod router_cache;\n+mod web;\n+\n+pub use config::ApiIngressConfig;\n+use router_cache::RouterCache;\n+\n+#[cfg(test)]\n+pub mod example_user_module;\n+\n+use model::ComponentsRegistry;\n+\n+/// Standard API error response (TODO: good to register in OpenAPI once and reuse)\n+#[derive(Serialize, Deserialize, JsonSchema, Debug, Clone)]\n+pub struct ErrorResponse {\n+    /// Error message\n+    pub error: String,\n+    /// HTTP status code\n+    pub code: u16,\n+    /// RFC3339 timestamp when the error occurred\n+    pub timestamp: String,\n+    /// Optional request ID for tracking\n+    pub request_id: Option<String>,\n+}\n+\n+impl ErrorResponse {","path":"modules/api_ingress/src/lib.rs","commit_id":"d0b12edf7d19d9b47b81f8c899e24d60573bf01d","original_com
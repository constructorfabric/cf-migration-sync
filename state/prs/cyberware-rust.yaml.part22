es and their metadata\n+pub struct NodeStorage {\n+    nodes: RwLock<HashMap<Uuid, CachedNodeData>>,\n+}\n+\n+impl NodeStorage {\n+    pub fn new() -> Self {\n+        Self {\n+            nodes: RwLock::new(HashMap::new()),\n+        }\n+    }\n+\n+    /// Register or update a node\n+    pub fn upsert_node(&self, node: Node) {\n+        let mut nodes = self.nodes.write().unwrap();","path":"modules/nodes_registry/src/domain/node_storage.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We hope that the lock won't be poisoned","created_at":"2025-12-02T14:15:56Z","updated_at":"2025-12-02T14:15:56Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581384252","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581384252"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581384252"},"pull_request":{"
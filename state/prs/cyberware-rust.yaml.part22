yLnJz) | 98.23% | [2 Missing :warning: ](https://app.codecov.io/gh/hypernetix/hyperspot/pull/136?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None) |\n| [...ypes-registry/types-registry/src/api/rest/error.rs](https://app.codecov.io/gh/hypernetix/hyperspot/pull/136?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None#diff-bW9kdWxlcy90eXBlcy1yZWdpc3RyeS90eXBlcy1yZWdpc3RyeS9zcmMvYXBpL3Jlc3QvZXJyb3IucnM=) | 99.04% | [1 Missing :warning: ](https://app.codecov.io/gh/hypernetix/hyperspot/pull/136?src=pr&el=tree&utm_medium=referral&utm_source=github&utm_content=comment&utm_campaign=pr+comments&utm_term=None) |\n\n:loudspeaker: Thoughts on this report? [Let us know!](https://github.com/codecov/feedback/issues/255)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3677694721/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637261045","pull_request_review_id":3601212709,"id":2637261045,"node_id":"PRRC_kwDOPaLyBs6dMWj1","diff_hunk":"@@ -0,0 +1,345 @@\n+//! REST DTOs for the Types Registry module.\n+\n+use serde::{Deserialize, Serialize};\n+use utoipa::ToSchema;\n+use uuid::Uuid;\n+\n+use types_registry_sdk::{\n+    GtsEntity, GtsEntityKind, RegisterResult, RegisterSummary, SegmentMatchScope,\n+};\n+\n+/// Response DTO for a GTS entity.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct GtsEntityDto {\n+    /// Deterministic UUID generated from the GTS ID.\n+    pub id: Uuid,\n+    /// The full GTS identifier string.\n+    pub gts_id: String,\n+    /// The kind of entity: \"type\" or \"instance\".\n+    pub kind: String,\n+    /// The entity content (schema for types, object for instances).\n+    pub content: serde_json::Value,\n+    /// Optional description of the entity.\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub description: Option<String>,\n+    /// Vendor from the primary segment.","path":"modules/types-registry/types-registry/src/api/rest/dto.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's not clear what is 'primary' segment here, is it 'left-most' or 'right-most' ?","created_at":"2025-12-20T18:22:41Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637261045","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637261045"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637261045"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637261045/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":26,"side":"RIGHT","author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637283626","pull_request_review_id":3601212709,"id":2637283626,"node_id":"PRRC_kwDOPaLyBs6dMcEq","diff_hunk":"@@ -0,0 +1,345 @@\n+//! REST DTOs for the Types Registry module.\n+\n+use serde::{Deserialize, Serialize};\n+use utoipa::ToSchema;\n+use uuid::Uuid;\n+\n+use types_registry_sdk::{\n+    GtsEntity, GtsEntityKind, RegisterResult, RegisterSummary, SegmentMatchScope,\n+};\n+\n+/// Response DTO for a GTS entity.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct GtsEntityDto {\n+    /// Deterministic UUID generated from the GTS ID.\n+    pub id: Uuid,\n+    /// The full GTS identifier string.\n+    pub gts_id: String,\n+    /// The kind of entity: \"type\" or \"instance\".\n+    pub kind: String,\n+    /// The entity content (schema for types, object for instances).\n+    pub content: serde_json::Value,\n+    /// Optional description of the entity.\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub description: Option<String>,\n+    /// Vendor from the primary segment.","path":"modules/types-registry/types-registry/src/api/rest/dto.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Also, why it's needed at all and why there is no `type` and version if it's needed?","created_at":"2025-12-20T19:15:49Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637283626","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637283626"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637283626"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637283626/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":26,"side":"RIGHT","author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637284608","pull_request_review_id":3601212709,"id":2637284608,"node_id":"PRRC_kwDOPaLyBs6dMcUA","diff_hunk":"@@ -0,0 +1,141 @@\n+//! REST error mapping for the Types Registry module.\n+\n+use modkit::api::prelude::StatusCode;\n+use modkit::api::problem::Problem;\n+\n+use crate::domain::error::DomainError;\n+\n+impl From<DomainError> for Problem {\n+    fn from(e: DomainError) -> Self {\n+        let trace_id = tracing::Span::current()\n+            .id()\n+            .map(|id| id.into_u64().to_string());\n+\n+        let (status, code, title, detail) = match &e {\n+            DomainError::InvalidGtsId(msg) => (\n+                StatusCode::BAD_REQUEST,\n+                \"TYPES_REGISTRY_INVALID_GTS_ID\",\n+                \"Invalid GTS ID\",\n+                msg.clone(),\n+            ),\n+            DomainError::NotFound(id) => (\n+                StatusCode::NOT_FOUND,\n+                \"TYPES_REGISTRY_NOT_FOUND\",\n+                \"Entity not found\",\n+                format!(\"No entity with GTS ID: {id}\"),\n+            ),\n+            DomainError::AlreadyExists(id) => (\n+                StatusCode::CONFLICT,\n+                \"TYPES_REGISTRY_ALREADY_EXISTS\",","path":"modules/types-registry/types-registry/src/api/rest/error.rs","commit_id":"03122ef31548011d5ab76cad0d0d279b58a71a0a","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe it's needed to keep API idempotent and return OK if already exists with the same content.\r\n\r\nAlso, we can have an API parameter - force - to override the previous content:\r\n- if 'force' is not set AND item already exists AND it's content is different - return AlreadyExists\r\n- if 'force' is set AND item already exists AND it's content is different AND there is special overwrite permission (?) -  then overwrite","created_at":"2025-12-20T19:17:25Z","updated_at":"2025-12-22T09:42:24Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637284608","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637284608"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637284608"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637284608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":29,"original_line":29,"side":"RIGHT","author_association":"MEMBER","original_position":29,"position":29,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637286826","pull_request_review_id":3601212709,"id":2637286826,"node_id":"PRRC_kwDOPaLyBs6dMc2q","diff_hunk":"@@ -0,0 +1,141 @@\n+//! REST error mapping for the Types Registry module.\n+\n+use modkit::api::prelude::StatusCode;\n+use modkit::api::problem::Problem;\n+\n+use crate::domain::error::DomainError;\n+\n+impl From<DomainError> for Problem {\n+    fn from(e: DomainError) -> Self {\n+        let trace_id = tracing::Span::current()\n+            .id()\n+            .map(|id| id.into_u64().to_string());\n+\n+        let (status, code, title, detail) = match &e {\n+            DomainError::InvalidGtsId(msg) => (\n+                StatusCode::BAD_REQUEST,\n+                \"TYPES_REGISTRY_INVALID_GTS_ID\",\n+                \"Invalid GTS ID\",\n+                msg.clone(),\n+            ),\n+            DomainError::NotFound(id) => (\n+                StatusCode::NOT_FOUND,\n+                \"TYPES_REGISTRY_NOT_FOUND\",\n+                \"Entity not found\",\n+                format!(\"No entity with GTS ID: {id}\"),\n+            ),\n+            DomainError::AlreadyExists(id) => (\n+                StatusCode::CONFLICT,\n+                \"TYPES_REGISTRY_ALREADY_EXISTS\",\n+                \"Entity already exists\",\n+                format!(\"Entity with GTS ID already exists: {id}\"),\n+            ),\n+            DomainError::ValidationFailed(msg) => (\n+                StatusCode::UNPROCESSABLE_ENTITY,\n+                \"TYPES_REGISTRY_VALIDATION_FAILED\",\n+                \"Validation failed\",\n+                msg.clone(),\n+            ),\n+            DomainError::NotInProductionMode => (\n+                StatusCode::SERVICE_UNAVAILABLE,\n+                \"TYPES_REGISTRY_NOT_IN_PRODUCTION\",\n+                \"Not in production mode\",\n+                \"The types registry is not yet in production mode\".to_owned(),","path":"modules/types-registry/types-registry/src/api/rest/error.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe the 'production mode' term was temporary and we need some better name for errors, because production is in the same group as 'dev', 'staging', 'production'. Also it's not 'mode', but state.\n\nI'd suggest to use 'not in ready state' terminology\n\n","created_at":"2025-12-20T19:21:44Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637286826","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637286826"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637286826"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637286826/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":43,"side":"RIGHT","author_association":"MEMBER","original_position":43,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637287084","pull_request_review_id":3601212709,"id":2637287084,"node_id":"PRRC_kwDOPaLyBs6dMc6s","diff_hunk":"@@ -0,0 +1,141 @@\n+//! REST error mapping for the Types Registry module.\n+\n+use modkit::api::prelude::StatusCode;\n+use modkit::api::problem::Problem;\n+\n+use crate::domain::error::DomainError;\n+\n+impl From<DomainError> for Problem {\n+    fn from(e: DomainError) -> Self {\n+        let trace_id = tracing::Span::current()\n+            .id()\n+            .map(|id| id.into_u64().to_string());\n+\n+        let (status, code, title, detail) = match &e {\n+            DomainError::InvalidGtsId(msg) => (\n+                StatusCode::BAD_REQUEST,\n+                \"TYPES_REGISTRY_INVALID_GTS_ID\",\n+                \"Invalid GTS ID\",\n+                msg.clone(),\n+            ),\n+            DomainError::NotFound(id) => (\n+                StatusCode::NOT_FOUND,\n+                \"TYPES_REGISTRY_NOT_FOUND\",\n+                \"Entity not found\",\n+                format!(\"No entity with GTS ID: {id}\"),\n+            ),\n+            DomainError::AlreadyExists(id) => (\n+                StatusCode::CONFLICT,\n+                \"TYPES_REGISTRY_ALREADY_EXISTS\",\n+                \"Entity already exists\",\n+                format!(\"Entity with GTS ID already exists: {id}\"),\n+            ),\n+            DomainError::ValidationFailed(msg) => (\n+                StatusCode::UNPROCESSABLE_ENTITY,\n+                \"TYPES_REGISTRY_VALIDATION_FAILED\",\n+                \"Validation failed\",\n+                msg.clone(),\n+            ),\n+            DomainError::NotInProductionMode => (\n+                StatusCode::SERVICE_UNAVAILABLE,\n+                \"TYPES_REGISTRY_NOT_IN_PRODUCTION\",\n+                \"Not in production mode\",\n+                \"The types registry is not yet in production mode\".to_owned(),\n+            ),\n+            DomainError::ProductionCommitFailed(errors) => {","path":"modules/types-registry/types-registry/src/api/rest/error.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not sure it's correct term, what is ProductionCommit?","created_at":"2025-12-20T19:22:16Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637287084","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637287084"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637287084"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637287084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":45,"side":"RIGHT","author_association":"MEMBER","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290415","pull_request_review_id":3601212709,"id":2637290415,"node_id":"PRRC_kwDOPaLyBs6dMduv","diff_hunk":"@@ -0,0 +1,312 @@\n+//! Domain service for the Types Registry module.\n+\n+use std::sync::Arc;\n+\n+use types_registry_sdk::{GtsEntity, ListQuery, RegisterResult};\n+\n+use super::error::DomainError;\n+use super::repo::GtsRepository;\n+\n+/// Domain service for GTS entity operations.\n+///\n+/// This service orchestrates business logic and delegates storage\n+/// operations to the repository.\n+pub struct TypesRegistryService {\n+    repo: Arc<dyn GtsRepository>,\n+}\n+\n+impl TypesRegistryService {\n+    /// Creates a new `TypesRegistryService` with the given repository.\n+    #[must_use]\n+    pub fn new(repo: Arc<dyn GtsRepository>) -> Self {\n+        Self { repo }\n+    }\n+\n+    /// Registers GTS entities in batch.\n+    ///\n+    /// Returns a `RegisterResult` for each input entity, preserving order.\n+    #[must_use]\n+    pub fn register(&self, entities: Vec<serde_json::Value>) -> Vec<RegisterResult> {\n+        let is_production = self.repo.is_production();","path":"modules/types-registry/types-registry/src/domain/service.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's better to name variable as 'need_validation', yet you can set it to true/false based on self.repo.is_production() (or self.repo.is_ready())","created_at":"2025-12-20T19:30:47Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637290415","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290415"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637290415"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290415/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":30,"side":"RIGHT","author_association":"MEMBER","original_position":30,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290593","pull_request_review_id":3601212709,"id":2637290593,"node_id":"PRRC_kwDOPaLyBs6dMdxh","diff_hunk":"@@ -0,0 +1,312 @@\n+//! Domain service for the Types Registry module.\n+\n+use std::sync::Arc;\n+\n+use types_registry_sdk::{GtsEntity, ListQuery, RegisterResult};\n+\n+use super::error::DomainError;\n+use super::repo::GtsRepository;\n+\n+/// Domain service for GTS entity operations.\n+///\n+/// This service orchestrates business logic and delegates storage\n+/// operations to the repository.\n+pub struct TypesRegistryService {\n+    repo: Arc<dyn GtsRepository>,\n+}\n+\n+impl TypesRegistryService {\n+    /// Creates a new `TypesRegistryService` with the given repository.\n+    #[must_use]\n+    pub fn new(repo: Arc<dyn GtsRepository>) -> Self {\n+        Self { repo }\n+    }\n+\n+    /// Registers GTS entities in batch.\n+    ///\n+    /// Returns a `RegisterResult` for each input entity, preserving order.\n+    #[must_use]\n+    pub fn register(&self, entities: Vec<serde_json::Value>) -> Vec<RegisterResult> {\n+        let is_production = self.repo.is_production();\n+        let mut results = Vec::with_capacity(entities.len());\n+\n+        for entity in entities {\n+            let gts_id = Self::extract_gts_id(&entity);\n+            let result = match self.repo.register(&entity, is_production) {\n+                Ok(registered) => RegisterResult::Ok(registered),\n+                Err(e) => RegisterResult::Err {\n+                    gts_id,\n+                    error: e.into(),\n+                },\n+            };\n+            results.push(result);\n+        }\n+\n+        results\n+    }\n+\n+    /// Retrieves a single GTS entity by its identifier.\n+    pub fn get(&self, gts_id: &str) -> Result<GtsEntity, DomainError> {\n+        self.repo.get(gts_id)\n+    }\n+\n+    /// Lists GTS entities matching the given query.\n+    pub fn list(&self, query: &ListQuery) -> Result<Vec<GtsEntity>, DomainError> {\n+        self.repo.list(query)\n+    }\n+\n+    /// Switches the registry from configuration mode to production mode.\n+    ///\n+    /// This validates all entities in temporary storage and moves them\n+    /// to persistent storage if validation succeeds.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Returns `ProductionCommitFailed` with typed `ValidationError` structs\n+    /// containing the GTS ID and error message for each failing entity.\n+    pub fn switch_to_production(&self) -> Result<(), DomainError> {","path":"modules/types-registry/types-registry/src/domain/service.rs","commit_id":"522b26396da785d37773a0fcc9df4765236871e8","original_commit_id":"522b26396da785d37773a0fcc9df4765236871e8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"... switch_to_ready(..)","created_at":"2025-12-20T19:31:08Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637290593","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290593"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637290593"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637290593/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":67,"side":"RIGHT","author_association":"MEMBER","original_position":67,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637299506","pull_request_review_id":3601212709,"id":2637299506,"node_id":"PRRC_kwDOPaLyBs6dMf8y","diff_hunk":"@@ -0,0 +1,185 @@\n+//! REST handlers for the Types Registry module.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::{Extension, Path, Query};\n+use axum::Json;\n+use modkit::api::prelude::*;\n+use types_registry_sdk::RegisterSummary;\n+\n+use super::dto::{\n+    GtsEntityDto, ListEntitiesQuery, ListEntitiesResponse, RegisterEntitiesRequest,\n+    RegisterEntitiesResponse, RegisterResultDto, RegisterSummaryDto,\n+};\n+use crate::domain::error::DomainError;\n+use crate::domain::service::TypesRegistryService;\n+\n+pub type TypesRegistryResult<T> = ApiResult<T, DomainError>;\n+pub type TypesRegistryApiError = ApiError<DomainError>;\n+\n+/// POST /api/v1/types-registry/entities\n+///\n+/// Register GTS entities in batch.\n+pub async fn register_entities(\n+    Extension(service): Extension<Arc<TypesRegistryService>>,\n+    Json(req): Json<RegisterEntitiesRequest>,\n+) -> TypesRegistryResult<(StatusCode, Json<RegisterEntitiesResponse>)> {\n+    let results = service.register(req.entities);","path":"modules/types-registry/types-registry/src/api/rest/handlers.rs","commit_id":"12f5efd54270bec32ab656a2c3ce7ff8c90cfe1c","original_commit_id":"12f5efd54270bec32ab656a2c3ce7ff8c90cfe1c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"REST API must not work while service is not ready (not in production) and must always validate entities on registration. For internal (system) types registered through direct ABI it's OK, but not for REST API\n\nMoreover, we should return some error for every REST API request until service is not ready.","created_at":"2025-12-20T19:51:43Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637299506","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637299506"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637299506"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637299506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":27,"side":"RIGHT","author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637304996","pull_request_review_id":3601212709,"id":2637304996,"node_id":"PRRC_kwDOPaLyBs6dMhSk","diff_hunk":"@@ -0,0 +1,589 @@\n+//! In-memory repository implementation using gts-rust.\n+\n+use std::sync::atomic::{AtomicBool, Ordering};\n+\n+use gts::{GtsConfig, GtsID, GtsOps, GtsWildcard};","path":"modules/types-registry/types-registry/src/infra/storage/in_memory_repo.rs","commit_id":"12f5efd54270bec32ab656a2c3ce7ff8c90cfe1c","original_commit_id":"12f5efd54270bec32ab656a2c3ce7ff8c90cfe1c","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why we take GtsID, GtsConfig, directly from gts::\nbut, say, GtsIdSegment is taken from types_registry_sdk:: ?","created_at":"2025-12-20T20:05:14Z","updated_at":"2025-12-20T20:06:02Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637304996","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637304996"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637304996"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637304996/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":5,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637307180","pull_request_review_id":3601247507,"id":2637307180,"node_id":"PRRC_kwDOPaLyBs6dMh0s","diff_hunk":"@@ -0,0 +1,461 @@\n+\"\"\"E2E tests for types-registry error handling and edge cases.\"\"\"\n+import httpx\n+import pytest\n+import time\n+\n+_counter = int(time.time() * 1000) % 1000000\n+\n+\n+def unique_type_id(name: str) -> str:\n+    \"\"\"Generate a unique type GTS ID.\"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"gts.e2etest.err.models.{name}{_counter}.v1~\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_error_response_format_rfc9457(base_url, auth_headers):\n+    \"\"\"\n+    Test that error responses follow RFC-9457 Problem Details format.\n+    \n+    Verifies standardized error response structure.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        nonexistent_id = \"gts.nonexistent.vendor.pkg.ns.type.v1~\"\n+        \n+        response = await client.get(\n+            f\"{base_url}/types-registry/v1/entities/{nonexistent_id}\",\n+            headers=auth_headers,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 404\n+        \n+        if response.headers.get(\"content-type\", \"\").startswith(\"application/problem+json\"):\n+            data = response.json()\n+            assert \"type\" in data or \"title\" in data or \"status\" in data, (\n+                \"RFC-9457 response should have type, title, or status\"\n+            )\n+\n+\n+@pytest.mark.asyncio\n+async def test_missing_content_type_header(base_url, auth_headers):\n+    \"\"\"\n+    Test POST without Content-Type header.\n+    \n+    Verifies proper handling of missing headers.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            content=b'{\"entities\": []}',\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code in (200, 400, 415), (\n+            f\"Expected 200, 400, or 415, got {response.status_code}\"\n+        )\n+\n+\n+@pytest.mark.asyncio\n+async def test_wrong_content_type_header(base_url, auth_headers):\n+    \"\"\"\n+    Test POST with wrong Content-Type header.\n+    \n+    Verifies handling of unsupported media types.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers={**auth_headers, \"Content-Type\": \"text/plain\"},\n+            content=b'{\"entities\": []}',\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code in (200, 400, 415), (\n+            f\"Expected 200, 400, or 415, got {response.status_code}\"\n+        )\n+\n+\n+@pytest.mark.asyncio\n+async def test_empty_request_body(base_url, auth_headers):\n+    \"\"\"\n+    Test POST with empty request body.\n+    \n+    Verifies proper error handling for empty body.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers={**auth_headers, \"Content-Type\": \"application/json\"},\n+            content=b'',\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code in (400, 422), (\n+            f\"Expected 400 or 422 for empty body, got {response.status_code}\"\n+        )\n+\n+\n+@pytest.mark.asyncio\n+async def test_missing_entities_field(base_url, auth_headers):\n+    \"\"\"\n+    Test POST without 'entities' field in request body.\n+    \n+    Verifies validation of required request fields.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json={\"other_field\": \"value\"},\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code in (400, 422), (\n+            f\"Expected 400 or 422 for missing 'entities' field, got {response.status_code}\"\n+        )\n+\n+\n+@
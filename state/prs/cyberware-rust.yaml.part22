":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618934746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618936299","pull_request_review_id":3577551064,"id":2618936299,"node_id":"PRRC_kwDOPaLyBs6cGcvr","diff_hunk":"@@ -0,0 +1,24 @@\n+[workspace]\n+members = [\"contract_lints\"]\n+exclude = [\"contract_lints/ui\"]\n+resolver = \"2\"\n+\n+[workspace.package]\n+version = \"0.1.0\"\n+edition = \"2021\"","path":"dylint_lints/Cargo.toml","commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","original_commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"edition 2024 for all new workspaces or projects","created_at":"2025-12-15T10:57:07Z","updated_at":"2025-12-15T11:17:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618936299","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618936299"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618936299"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618936299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":8,"original_line":8,"side":"RIGHT","author_association":"MEMBER","original_position":8,"position":8,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618959938","pull_request_review_id":3577551064,"id":2618959938,"node_id":"PRRC_kwDOPaLyBs6cGihC","diff_hunk":"@@ -0,0 +1,389 @@\n+#!/usr/bin/env python3\n+\"\"\"\n+Test dylint lints on UI test cases.\n+Compiles the UI test crate and verifies expected violations are detected.\n+\"\"\"\n+\n+import subprocess\n+import sys\n+import os\n+import re\n+from pathlib import Path\n+from collections import defaultdict\n+\n+\n+def supports_color():\n+    \"\"\"Check if the terminal supports ANSI colors.\"\"\"\n+    # No color if output is not a TTY (e.g., piped to file)\n+    if not hasattr(sys.stdout, 'isatty') or not sys.stdout.isatty():\n+        return False\n+    # Check for explicit NO_COLOR environment variable\n+    if os.environ.get('NO_COLOR'):\n+        return False\n+    # Check TERM environment variable\n+    term = os.environ.get('TERM', '')\n+    if term == 'dumb':\n+        return False\n+    # Windows needs special handling\n+    if sys.platform == 'win32':\n+        # Windows 10+ supports ANSI if TERM is set or if running in modern terminal\n+        return 'ANSICON' in os.environ or term or os.environ.get('WT_SESSION')\n+    return True\n+\n+\n+# ANSI colors (only if terminal supports it)\n+if supports_color():\n+    GREEN = '\\033[92m'\n+    RED = '\\033[91m'\n+    YELLOW = '\\033[93m'\n+    BLUE = '\\033[94m'\n+    RESET = '\\033[0m'\n+    BOLD = '\\033[1m'\n+    DIM = '\\033[2m'\n+else:\n+    GREEN = RED = YELLOW = BLUE = RESET = BOLD = DIM = ''\n+\n+\n+def get_toolchain_info():\n+    \"\"\"Get host toolchain and rustup toolchain from rust-toolchain.toml.\"\"\"\n+    result = subprocess.run(\n+        ['rustc', '--version', '--verbose'],\n+        capture_output=True, text=True\n+    )\n+    host = None\n+    for line in result.stdout.split('\\n'):\n+        if line.startswith('host:'):\n+            host = line.split(':')[1].strip()\n+            break\n+\n+    script_dir = Path(__file__).parent\n+    toolchain_file = script_dir / 'rust-toolchain.toml'\n+    rustup_toolchain = 'nightly'\n+    if toolchain_file.exists():\n+        with open(toolchain_file) as f:\n+            for line in f:\n+                if 'channel' in line:\n+                    match = re.search(r'\"([^\"]+)\"', line)\n+                    if match:\n+                        rustup_toolchain = match.group(1)\n+                    break\n+\n+    return host, rustup_toolchain\n+\n+\n+def find_dylint_lib(script_dir):\n+    \"\"\"Find the dylint library in target/release.\"\"\"\n+    target_dir = script_dir / 'target' / 'release'\n+\n+    for ext in ['.dylib', '.so', '.dll']:\n+        pattern = f'libcontract_lints@*{ext}' if ext != '.dll' else f'contract_lints@*{ext}'\n+        libs = list(target_dir.glob(pattern))\n+        if libs:\n+            return libs[0].resolve()\n+\n+    return None\n+\n+\n+def build_dylint_lints(script_dir, rustup_toolchain, host):\n+    \"\"\"Build the dylint lints and ensure proper naming.\"\"\"\n+    print(\"Building dylint lints...\")\n+\n+    result = subprocess.run(\n+        ['cargo', 'build', '--release', '--quiet'],\n+        cwd=script_dir,\n+        capture_output=True, text=True\n+    )\n+\n+    if result.returncode != 0:\n+        print(f\"{RED}Build failed:{RESET}\")\n+        print(result.stderr)\n+        return None\n+\n+    target_dir = script_dir / 'target' / 'release'\n+    lib_name = f\"libcontract_lints@{rustup_toolchain}-{host}\"\n+\n+    for src_ext, dst_ext in [('.dylib', '.dylib'), ('.so', '.so'), ('.dll', '.dll')]:\n+        src = target_dir / f\"libcontract_lints{src_ext}\"\n+        if src_ext == '.dll':\n+            src = target_dir / f\"contract_lints{src_ext}\"\n+        if src.exists():\n+            dst = target_dir / f\"{lib_name}{dst_ext}\"\n+            if src_ext == '.dll':\n+                dst = target_dir / f\"contract_lints@{rustup_toolchain}-{host}{dst_ext}\"\n+            try:\n+                import shutil","path":"dylint_lints/test_ui.py","commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","original_commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why is this try expect? shutil should be available in all modern python3 versions\r\nWhat are the implications of a failure here? Should be handled ","created_at":"2025-12-15T11:04:56Z","updated_at":"2025-12-15T11:17:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618959938","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618959938"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618959938"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618959938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":114,"original_line":114,"side":"RIGHT","author_association":"MEMBER","original_position":114,"position":114,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618973924","pull_request_review_id":3577551064,"id":2618973924,"node_id":"PRRC_kwDOPaLyBs6cGl7k","diff_hunk":"","path":"dylint_lints/contract_lints/ui/src/lib.rs","commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","original_commit_id":"2189aebc0b2ee44c96c74dcd9b56017a38f07c82","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@Artifizer I don't fully understand why this `ui` crate is full of _test\r\nWhy was not used `examples` or `tests` in the main crate?","created_at":"2025-12-15T11:09:30Z","updated_at":"2025-12-15T11:17:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618973924","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618973924"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/89#discussion_r2618973924"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/89"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2618973924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"}],"source_reviews":[]},{"source_pr_number":88,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/88","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #88] feat(dylint): introduce dylint - architectural compliance linter framework","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"dylint-rules","pr_head_sha":"3a1e69f8f0a8a02ebede29ae2c64d1d2ac01e4a2","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/88","id":3101901680,"node_id":"PR_kwDOPaLyBs6440Nw","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/88","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/88.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/88.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/88","number":88,"state":"closed","locked":false,"title":"feat(dylint): introduce dylint - architectural compliance linter framework","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"    feat(dylint): introduce dylint - architectural compliance linter framework\r\n    \r\n    Introduce custom dylint linters to enforce Hyperspot's modular\r\n    architecture guidelines at compile time. This provides automated\r\n    validation of layer separation, DTO placement, and API conventions.\r\n    \r\n    **DE01 - Contract Layer** (transport-agnostic contracts):\r\n    - DE0101: No Serde derives in contract models\r\n    - DE0102: No ToSchema derives in contract models\r\n    - DE0103: No HTTP types (StatusCode, Headers) in contracts\r\n    \r\n    **DE02 - API Layer** (REST implementation patterns):\r\n    - DE0201: DTOs (*Dto suffix) only allowed in api/rest/\r\n    - DE0202: DTOs not referenced outside API layer\r\n    - DE0203: DTOs must have Serialize/Deserialize derives\r\n    - DE0204: DTOs must have ToSchema derive for OpenAPI\r\n    \r\n    **DE08 - REST Conventions**:\r\n    - DE0801: API endpoints must include version (/v1/, /v2/, etc.)\r\n    \r\n    - `dylint_lints/contract_lints/ui/` - test crate with proper module\r\n      structure (contract/, domain/, api/rest/) for path-based lint testing\r\n    - `dylint_lints/test_ui.py` - auto-discovers test files, compiles with\r\n      dylint, validates expected violations using comment markers:\r\n      - `// Should trigger DExxxx` - expected violations\r\n      - `// Should NOT trigger DExxxx` - correct patterns\r\n    \r\n    `make dylint` - Run project compliance dylint lints on the workspace\r\n    `make dylint-list` - List all custom project compliance lints\r\n    `make dylint-tests` - Test dylint lints on UI test cases (compile and verify violations)\r\n    \r\n    Signed-off-by: Artifizer <artifizer@gmail.com>","created_at":"2025-12-15T10:23:37Z","updated_at":"2025-12-15T10:28:16Z","closed_at":"2025-12-15T10:28:16Z","merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/88/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/88/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/88/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/3a1e69f8f0a8a02ebede29ae2c64d1d2ac01e4a2","head":{"label":"Artifizer:dylint-rules","ref":"dylint-rules","sha":"3a1e69f8f0a8a02ebede29a
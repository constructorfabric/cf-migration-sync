atch,\n+    Delete,\n+    Head,\n+    Options,\n+}\n+\n+impl HttpMethod {\n+    /// Convert to uppercase string representation.\n+    #[must_use]\n+    #[allow(clippy::trivially_copy_pass_by_ref)] // Consistent API with other enums\n+    pub fn as_str(&self) -> &'static str {","path":"modules/oagw/oagw-sdk/src/models.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is not correct, you need to implement AsStr trait:\r\nhttps://docs.rs/enum_str/latest/enum_str/trait.AsStr.html\r\npub trait AsStr {\r\n    // Required method\r\n    fn as_str(&self) -> &str;\r\n}","created_at":"2025-12-29T13:16:49Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650950883","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650950883"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650950883"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650950883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":30,"side":"RIGHT","author_association":"MEMBER","original_position":30,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650952017","pull_request_review_id":3615733354,"id":2650952017,"node_id":"PRRC_kwDOPaLyBs6eAlFR","diff_hunk":"@@ -0,0 +1,338 @@\n+//! OAGW domain models.\n+//!\n+//! These are transport-agnostic models used across the SDK.\n+//! Note: NO serde derives here - these are pure domain models.\n+\n+use bytes::Bytes;\n+use chrono::{DateTime, Utc};\n+use std::collections::HashMap;\n+use std::pin::Pin;\n+use uuid::Uuid;\n+\n+use crate::retry::RetryIntent;\n+\n+/// HTTP method for outbound requests.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n+pub enum HttpMethod {\n+    Get,\n+    Post,\n+    Put,\n+    Patch,\n+    Delete,\n+    Head,\n+    Options,\n+}\n+\n+impl HttpMethod {\n+    /// Convert to uppercase string representation.\n+    #[must_use]\n+    #[allow(clippy::trivially_copy_pass_by_ref)] // Consistent API with other enums\n+    pub fn as_str(&self) -> &'static str {\n+        match self {\n+            Self::Get => \"GET\",\n+            Self::Post => \"POST\",\n+            Self::Put => \"PUT\",\n+            Self::Patch => \"PATCH\",\n+            Self::Delete => \"DELETE\",\n+            Self::Head => \"HEAD\",\n+            Self::Options => \"OPTIONS\",\n+        }\n+    }\n+}\n+\n+impl std::fmt::Display for HttpMethod {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        write!(f, \"{}\", self.as_str())\n+    }\n+}\n+\n+/// Request to invoke an outbound API.\n+#[derive(Debug, Clone)]\n+pub struct OagwInvokeRequest {\n+    /// Optional link ID to use (if not provided, OAGW selects based on route).\n+    pub link_id: Option<Uuid>,\n+    /// Route ID identifying the downstream API configuration.\n+    pub route_id: Uuid,\n+    /// HTTP method for the request.\n+    pub method: HttpMethod,\n+    /// Path to append to the route's base URL.\n+    pub path: String,\n+    /// Optional query parameters.\n+    pub query: Option<HashMap<String, String>>,\n+    /// Optional custom headers.\n+    pub headers: Option<HashMap<String, String>>,\n+    /// Optional request body.\n+    pub body: Option<Bytes>,\n+    /// Optional timeout override in milliseconds.\n+    pub timeout_ms: Option<u64>,\n+    /// Retry intent (default: no retry).\n+    pub retry_intent: RetryIntent,\n+}\n+\n+impl Default for OagwInvokeRequest {\n+    fn default() -> Self {\n+        Self {\n+            link_id: None,\n+            route_id: Uuid::nil(),\n+            method: HttpMethod::Get,\n+            path: String::new(),\n+            query: None,\n+            headers: None,\n+            body: None,\n+            timeout_ms: None,\n+            retry_intent: RetryIntent::default(),\n+        }\n+    }\n+}\n+\n+/// Response from an outbound API invocation.\n+#[derive(Debug, Clone)]\n+pub struct OagwInvokeResponse {","path":"modules/oagw/oagw-sdk/src/models.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","star
ers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"?","created_at":"2025-12-17T19:24:12Z","updated_at":"2025-12-17T19:27:38Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/127#discussion_r2628360162","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/127","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2628360162"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/127#discussion_r2628360162"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/127"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2628360162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2628369194","pull_request_review_id":3589289658,"id":2628369194,"node_id":"PRRC_kwDOPaLyBs6cqbsq","diff_hunk":"@@ -0,0 +1,135 @@\n+use uuid::Uuid;\n+\n+#[derive(Clone)]\n+pub struct Permission {\n+    resource: String,\n+    action: String,\n+}\n+\n+impl Permission {\n+    #[must_use]\n+    pub fn resource(&self) -> &str {\n+        &self.resource\n+    }\n+\n+    #[must_use]\n+    pub fn action(&self) -> &str {\n+        &self.action\n+    }\n+}\n+\n+#[derive(Clone)]\n+pub struct SecurityContext {\n+    tenant_id: Uuid,\n+    subject_id: Uuid,\n+    permissions: Vec<Permission>,\n+    environment: Vec<(String, String)>,\n+}\n+\n+impl SecurityContext {\n+    /// Get the tenant ID associated with the security context\n+    pub fn tenant_id(&self) -> Uuid {\n+        self.tenant_id\n+    }\n+\n+    /// Get the subject ID (user, service, or system) associated with the security context\n+    pub fn subject_id(&self) -> Uuid {\n+        self.subject_id\n+    }\n+\n+    // resource:uuid\n+    // gts.htx.events.tenant.v1~{uuid}:edit\n+    // gts.htx.events.topic.v1~vendor.tenants.v1:publish\n+    // gts.htx.events.topic.v1~*:publish\n+    // gts.htx.events.subject_types.v1~vendor.xxx.*:subscribe\n+\n+    /// Get the permissions assigned to the security context\n+    pub fn permissions(&self) -> Vec<Permission> {\n+        self.permissions.clone()\n+    }\n+\n+    /// Get the environmental attributes associated with the security context\n+    /// (e.g., IP address, device type, location, time, etc.)\n+    pub fn environment(&self) -> Vec<(String, String)> {\n+        self.environment.clone()\n+    }\n+\n+    pub fn builder() -> SecurityContextBuilder {\n+        SecurityContextBuilder::default()\n+    }\n+\n+    pub fn anonymous() -> Self {\n+        SecurityContextBuilder::default().build()\n+    }\n+}\n+\n+#[derive(Default)]\n+pub struct SecurityContextBuilder {\n+    tenant_id: Option<Uuid>,\n+    subject_id: Option<Uuid>,\n+    permissions: Vec<Permission>,\n+    environment: Vec<(String, String)>,\n+}\n+\n+impl SecurityContextBuilder {\n+    pub fn tenant_id(mut self, tenant_id: Uuid) -> Self {\n+        self.tenant_id = Some(tenant_id);\n+        self\n+    }\n+\n+    pub fn subject_id(mut self, subject_id: Uuid) -> Self {\n+        self.subject_id = Some(subject_id);\n+        self\n+    }\n+\n+    pub fn add_permission(mut self, resource: &str, action: &str) -> Self {\n+        self.permissions.push(Permission {\n+            resource: resource.to_string(),\n+            action: action.to_string(),\n+        });\n+        self\n+    }\n+\n+    pub fn add_environment_attribute(mut self, key: &str, value: &str) -> Self {\n+        self.environment.push((key.to_string(), value.to_string()));\n+        self\n+    }\n+\n+    pub fn build(self) -> SecurityContext {\n+        SecurityContext {\n+            tenant_id: self.tenant_id.unwrap_or_else(Uuid::nil),","path":"libs/modkit-security/src/context.rs","commit_id":"e5ec0d0dc97426721c5bdb1a25ad81eb0f7c9a99","original_commit_id":"69fb872481e3879e89bbe3f9782701fa45816a95","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"MINOR: Uuid should implemnt Default so we can do like: self.tenant_id.unwrap_or_default()","created_at":"2025-12-17T19:27:24Z","updated_at":"2025-12-17T19:27:38Z","html_ur
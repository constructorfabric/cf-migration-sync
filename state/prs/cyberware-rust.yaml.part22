/cyberware-rust/pulls/comments/2584085550"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584085550"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584085550/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","in_reply_to_id":2581311061,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584100516","pull_request_review_id":3531689941,"id":2584100516,"node_id":"PRRC_kwDOPaLyBs6aBj6k","diff_hunk":"@@ -0,0 +1,195 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use std::collections::HashMap;\n+use std::sync::RwLock;\n+use uuid::Uuid;\n+\n+/// Cached node data with timestamps\n+#[derive(Debug, Clone)]\n+struct CachedNodeData {\n+    node: Node,\n+    sysinfo: Option<NodeSysInfo>,\n+    /// System-collected capabilities from modkit-node-info\n+    syscap_system: Option<NodeSysCap>,\n+    /// Custom capabilities set through service interface\n+    syscap_custom: HashMap<String, SysCap>,\n+}\n+\n+/// In-memory storage for nodes and their metadata\n+pub struct NodeStorage {\n+    nodes: RwLock<HashMap<Uuid, CachedNodeData>>,\n+}\n+\n+impl NodeStorage {\n+    pub fn new() -> Self {\n+        Self {\n+            nodes: RwLock::new(HashMap::new()),\n+        }\n+    }\n+\n+    /// Register or update a node\n+    pub fn upsert_node(&self, node: Node) {\n+        let mut nodes = self.nodes.write().unwrap();","path":"modules/nodes_registry/src/domain/node_storage.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, you are right, let me implement proper handling of lock poisoning","created_at":"2025-12-03T08:26:21Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584100516","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584100516"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584100516"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584100516/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":31,"side":"RIGHT","in_reply_to_id":2581384252,"author_association":"MEMBER","original_position":31,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584105538","pull_request_review_id":3531689941,"id":2584105538,"node_id":"PRRC_kwDOPaLyBs6aBlJC","diff_hunk":"@@ -0,0 +1,195 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use std::collections::HashMap;\n+use std::sync::RwLock;\n+use uuid::Uuid;\n+\n+/// Cached node data with timestamps\n+#[derive(Debug, Clone)]\n+struct CachedNodeData {\n+    node: Node,\n+    sysinfo: Option<NodeSysInfo>,\n+    /// System-collected capabilities from modkit-node-info\n+    syscap_system: Option<NodeSysCap>,\n+    /// Custom capabilities set through service interface\n+    syscap_custom: HashMap<String, SysCap>,\n+}\n+\n+/// In-memory storage for nodes and their metadata\n+pub struct NodeStorage {\n+    nodes: RwLock<HashMap<Uuid, CachedNodeData>>,\n+}\n+\n+impl NodeStorage {\n+    pub fn new() -> Self {\n+        Self {\n+            nodes: RwLock::new(HashMap::new()),\n+        }\n+    }\n+\n+    /// Register or update a node\n+    pub fn upsert_node(&self, node: Node) {\n+        let mut nodes = self.nodes.write().unwrap();\n+        nodes.insert(\n+            node.id,\n+            CachedNodeData {\n+                node,\n+                sysinfo: None,\n+                syscap_system: None,\n+                syscap_custom: HashMap::new(),\n+            },\n+        );\n+    }\n+\n+    /// Get a node by ID\n+    pub fn get_node(&self, id: Uuid) -> Option<Node> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.get(&id).map(|data| data.node.clone())\n+    }\n+\n+    /// List all nodes\n+    pub fn list_nodes(&self) -> Vec<Node> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.values().map(|data| data.node.clone()).collect()\n+    }\n+\n+    /// Update sysinfo for a node\n+    pub fn update_sysinfo(&self, node_id: Uuid, sysinfo: NodeSysInfo) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.sysinfo = Some(sysinfo);\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Get sysinfo for a node\n+    pub fn get_sysinfo(&self, node_id: Uuid) -> Option<NodeSysInfo> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.get(&node_id).and_then(|data| data.sysinfo.clone())\n+    }\n+\n+    /// Update system-collected syscap for a node\n+    pub fn update_syscap_system(&self, node_id: Uuid, syscap: NodeSysCap) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.syscap_system = Some(syscap);\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Get merged syscap for a node (system + custom)\n+    pub fn get_syscap(&self, node_id: Uuid) -> Option<NodeSysCap> {\n+        let nodes = self.nodes.read().unwrap();\n+        if let Some(data) = nodes.get(&node_id) {\n+            // Merge system and custom capabilities\n+            let mut cap_map: HashMap<String, SysCap> = HashMap::new();\n+\n+            // Add system capabilities first\n+            if let Some(ref syscap_system) = data.syscap_system {\n+                for cap in &syscap_system.capabilities {\n+                    cap_map.insert(cap.key.clone(), cap.clone());\n+                }\n+            }\n+\n+            // Override/add custom capabilities\n+            for (key, cap) in &data.syscap_custom {\n+                cap_map.insert(key.clone(), cap.clone());\n+            }\n+\n+            if cap_map.is_empty() {\n+                None\n+            } else {\n+                Some(NodeSysCap {\n+                    node_id,\n+                    capabilities: cap_map.into_values().collect(),\n+                    collected_at: chrono::Utc::now(),\n+                })\n+            }\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Set custom syscap entries (add or update)\n+    pub fn set_custom_syscap(&self, node_id: Uuid, caps: Vec<SysCap>) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            for cap in caps {\n+                data.syscap_custom.insert(cap.key.clone(), cap);\n+            }\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Remove custom syscap entries by key\n+    pub fn remove_custom_syscap(&self, node_id: Uuid, keys: Vec<String>) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            for key in keys {\n+                data.syscap_custom.remove(&key);\n+            }\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Clear all custom syscap entries for a node\n+    pub fn clear_custom_syscap(&self, node_id: Uuid) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.syscap_custom.clear();\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Check if a system syscap entry needs refresh based on cache TTL\n+    #[allow(dead_code)]\n+    pub fn needs_syscap_refresh(&self, node_id: Uuid, key: &str) -> bool {\n+        let nodes = self.nodes.read().unwrap();\n+        if let Some(data) = nodes.get(&node_id) {\n+            if let Some(ref syscap_system) = data.syscap_system {\n+                if let Some(cap) = syscap_system.capabilities.iter().find(|c| c.key == key) {\n+                    let now = chrono::Utc::now().timestamp();\n+                    let age_secs = now - cap.fetched_at_secs;","path":"modules/nodes_registry/src/domain/node_storage.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubuserc
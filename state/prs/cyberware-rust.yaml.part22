it","multi-tenancy","multi-tier","rust","saas","security","serverless","xaas"],"visibility":"private","forks":19,"open_issues":263,"watchers":32,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/20"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/20"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/20"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/20/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/20/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/20/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/e280ea38a5f08317b27f1fb528762de2d4269d98"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":19,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/19","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #19] feat(tracing,api): integrate OTEL tracing + unify API response helpers","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/open_tracing","pr_head_sha":"f255e1058d986789261f58f6ea900002434d81e3","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19","id":2883376211,"node_id":"PR_kwDOPaLyBs6r3NRT","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/19","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/19.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/19.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/19","number":19,"state":"closed","locked":false,"title":"feat(tracing,api): integrate OTEL tracing + unify API response helpers","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"### Tracing / Telemetry\r\n- modkit: add `telemetry::init` to build OpenTelemetryLayer from config\r\n- modkit: add graceful `shutdown_tracing()`\r\n- modkit: new `http::client::TracedClient` auto-injects W3C trace headers\r\n- modkit: add `http::otel` helpers for tracecontext extract/inject\r\n- runtime/logging: unify init with optional OTEL layer\r\n- api_ingress: add request_id propagation + trace layer (status/latency/trace_id)\r\n- api_ingress: propagate parent trace context from incoming headers\r\n- tests: config parsing, OTEL init, TracedClient header injection\r\n- Both Jaeger and Uptrace are supported (tested)\r\n\r\n### API / Developer Ergonomics\r\n- modkit/api: split response helpers into new `response.rs`\r\n  - `JsonBody<T>`, `JsonPage<T>` aliases\r\n  - `ok_json`, `created_json`, `no_content` sugar functions\r\n  - `to_response` convenience\r\n- modkit/api: keep `ApiError` + add unified `ApiResult<T,D>`\r\n- modkit/api: add `prelude` module re-exporting errors + responses\r\n- users_info example: migrate handlers to use `UsersResult<T>`, Json aliases, and helpers\r\n  - `created_json` for POST\r\n  - `no_content` for DELETE\r\n  - `JsonPage` for cursor pagination\r\n\r\n### Misc\r\n- cleaned up logging module layering (otel vs non-otel paths)","created_at":"2025-10-02T23:43:14Z","updated_at":"2025-10-04T20:40:34Z","closed_at":"2025-10-04T20:40:34Z","merged_at":"2025-10-04T20:40:34Z","merge_commit_sha":"c85813724ffb9f94192c2f4ac1e3a194184b37cd","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/19/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/f255e1058d986789261f58f6ea900002434d81e3","head":{"label":"modcrafter77:feature/open_tracing","ref":"feature/open_tracing","sha":"f255e1058d986789261f58f6ea900002434d81e3","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.co
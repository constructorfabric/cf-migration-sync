rust/pull/53#discussion_r2591173338","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2591173338"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2591173338"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2591173338/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":872,"side":"RIGHT","in_reply_to_id":2590984095,"author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592416208","pull_request_review_id":3544404870,"id":2592416208,"node_id":"PRRC_kwDOPaLyBs6ahSHQ","diff_hunk":"","path":"libs/modkit-auth/src/providers/jwks.rs","commit_id":"1e288145c843aeb278df9f5ebcdf013e55abb9bb","original_commit_id":"1e288145c843aeb278df9f5ebcdf013e55abb9bb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I didn't want to change that signature because for now it's not crazy to panic at the initialization by writing tests to control it. However, I think a better approach is to return Result, for sure","created_at":"2025-12-05T11:47:40Z","updated_at":"2025-12-05T11:47:40Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592416208","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592416208"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592416208"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592416208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":68,"original_line":68,"side":"RIGHT","in_reply_to_id":2590976940,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592419055","pull_request_review_id":3544408321,"id":2592419055,"node_id":"PRRC_kwDOPaLyBs6ahSzv","diff_hunk":"@@ -1,3 +1,5 @@\n+#![allow(clippy::unwrap_used, clippy::expect_used)]","path":"examples/modkit/users_info/tests/cursor_pagination.rs","commit_id":"d22fc46b3eb3f2cc1e86449fe9a06d0be2391459","original_commit_id":"9be764378413fb7cefeb0b8c59737871bdb25f0d","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@Artifizer what you have is right, however there is one small issues.\r\n`#![cfg_attr(test, allow(clippy::unwrap_used, clippy::expect_used))]` works for the unit tests. The integration tests from the `tests/` folder are not receiving that directive. By writing allow-expect-in-tests and unwrap, we save from writing that directive, but in integration tests we still need to write the allow :( ","created_at":"2025-12-05T11:48:47Z","updated_at":"2025-12-05T11:48:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592419055","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592419055"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592419055"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592419055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","in_reply_to_id":2590491860,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592423790","pull_request_review_id":3544414793,"id":2592423790,"node_id":"PRRC_kwDOPaLyBs6ahT9u","diff_hunk":"@@ -101,6 +101,8 @@ pub fn init_tracing(\n         if let Some(hmap) = build_headers_from_cfg_and_env(cfg) {\n             b = b.with_headers(hmap);\n         }\n+        #[allow(clippy::expect_used)]\n+        // We should panic during the initialization if the builder fails\n         b.build().expect(\"build OTLP HTTP exporter\")","path":"libs/modkit/src/telemetry/init.rs","commit_id":"d22fc46b3eb3f2cc1e86449fe9a06d0be2391459","original_commit_id":"1e288145c843aeb278df9f5ebcdf013e55abb9bb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, I agree, that can be also reduced.\r\nAlso, as I mentioned in the other comment, I added the two directives in the clippy.toml to safe the `#![cfg_attr(test, allow(clippy::unwrap_used, clippy::expect_used))]` but sadly we still need to include in every integration test from tests folder the unwrap and expect allowed","created_at":"2025-12-05T11:50:36Z","updated_at":"2025-12-05T11:50:36Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592423790","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592423790"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592423790"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592423790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":106,"original_line":106,"side":"RIGHT","in_reply_to_id":2590998820,"author_association":"MEMBER","original_position":6,"position":6,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592704613","pull_request_review_id":3544782689,"id":2592704613,"node_id":"PRRC_kwDOPaLyBs6aiYhl","diff_hunk":"@@ -952,6 +904,33 @@ where\n     })\n }\n \n+fn build_cursor<E: EntityTrait>(\n+    rows: &[E::Model],\n+    effective_order: &ODataOrderBy,\n+    fmap: &FieldMap<E>,\n+    tiebreaker: (&str, SortDir),\n+    q: &ODataQuery,\n+    direction: &str,\n+) -> Result<Option<String>, ODataError> {\n+    rows.first()","path":"libs/modkit-db/src/odata/core.rs","commit_id":"93b90630131e75ecf48023966a4d49a8422589ee","original_commit_id":"93b90630131e75ecf48023966a4d49a8422589ee","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You are using rows.first() in the helper function but original code using  rows.last() and  rows.first() dependin on condition. It's strange why unit tests didn't catch it. Please fix an issue and coresponding tests.\nbuild_cursor_from_rows looks ok because it's using `use_last` parameter","created_at":"2025-12-05T13:30:30Z","updated_at":"2025-12-05T13:36:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592704613","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592704613"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592704613"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592704613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":915,"side":"RIGHT","author_association":"MEMBER","original_position":92,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592717564","pull_request_review_id":3544782689,"id":2592717564,"node_id":"PRRC_kwDOPaLyBs6aibr8","diff_hunk":"@@ -952,6 +904,33 @@ where\n     })\n }\n \n+fn build_cursor<E: EntityTrait>(\n+    rows: &[E::Model],\n+    effective_order: &ODataOrderBy,\n+    fmap: &FieldMap<E>,\n+    tiebreaker: (&str, SortDir),\n+    q: &ODataQuery,\n+    direction: &str,\n+) -> Result<Option<String>, ODataError> {\n+    rows.first()\n+        .map(|m| {\n+            build_cursor_for_model::<E>(\n+                m,\n+                effective_order,\n+                fmap,\n+                tiebreaker.1,\n+                q.filter_hash.clone(),\n+                direction,\n+            )\n+            .map(|c| c.encode().map_err(|_| ODataError::InvalidCursor))","path":"libs/modkit-db/src/odata/core.rs","commit_id":"93b90630131e75ecf48023966a4d49a8422589ee","original_commit_id":"93b90630131e75ecf48023966a4d49a8422589ee","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That part of the refactor still wraps `Result` inside another `Result`, which creates unnecessary complexity in the control flow. Specifically, the code performs `map()` to produce `Result<Result<String, _>, _>`, then calls `transpose()` and finally `and_then()` to flatten it back. \n\nThis works, but it harms readability and increases cognitive overhead for anyone trying to understand the intent. A more direct `and_then()` on the first `Result` would avoid creating the nested structure entirely and keep the error propagation straightforward.","created_at":"2025-12-05T13:35:08Z","updated_at":"2025-12-05T13:36:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592717564","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592717564"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592717564"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592717564/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":925,"side":"RIGHT","author_association":"MEMBER","original_position":102,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592722499","pull_request_review_id":3544782689,"id":2592722499,"node_id":"PRRC_kwDOPaLyBs6aic5D","diff_hunk":"@@ -576,6 +552,28 @@ where\n     })\n }\n \n+/// Build a cursor from rows, using either the first or last row\n+fn build_cursor_from_rows<E, F, M: ODataFieldMapping<F, Entity = E>>(\n+    rows: &[<E as EntityTrait>::Model],\n+    effective_order: &ODataOrderBy,\n+    filter_hash: Option<&str>,\n+    direction: &str,\n+    use_last: bool,\n+) -> Result<Option<String>, ODataError>\n+where\n+    F: FilterField,\n+    E: EntityTrait,\n+{\n+    let row = if use_last { rows.last() } else { rows.first() };\n+\n+    row.map(|m| build_cursor_from_model::<F, M>(m, effective_order, filter_hash, direction))","path":"libs/modkit-db/src/odata/sea_orm_filter.rs","commit_id":"d22fc46b3eb3f2cc1e86449fe9a06d0be2391459","original_commit_id":"93b90630131e75ecf48023966a4d49a8422589ee","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why is not just:\n```Rust\nrow.map(|m| {\n    build_cursor_from_model::<F, M>(m, effective_order, filter_hash, direction)\n        .and_then(|c| c.encode().map_err(|_| ODataError::InvalidCursor))\n})\n.transpose()\n```\n\n?","created_at":"2025-12-05T13:36:46Z","updated_at":"2025-12-05T13:36:54Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592722499","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/53","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2592722499"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/53#discussion_r2592722499"},"
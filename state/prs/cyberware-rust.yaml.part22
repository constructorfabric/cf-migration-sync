ma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"let's reduce this boilerplate by using derive","created_at":"2025-12-02T15:04:42Z","updated_at":"2025-12-02T15:04:42Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581593135","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581593135"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581593135"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581593135/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":30,"original_line":31,"side":"RIGHT","author_association":"MEMBER","original_position":31,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581798930","pull_request_review_id":3530884282,"id":2581798930,"node_id":"PRRC_kwDOPaLyBs6Z4yAS","diff_hunk":"@@ -0,0 +1,118 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Linux using NVML for NVIDIA GPUs, fallback to lspci\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to lspci for AMD/Intel/other GPUs\n+    tracing::debug!(\"NVML not available, falling back to lspci\");\n+    collect_gpus_via_lspci()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {\n+        match nvml.device_by_index(i) {\n+            Ok(device) => {\n+                let model = device\n+                    .name()\n+                    .unwrap_or_else(|_| \"Unknown NVIDIA GPU\".to_string());\n+\n+                // Get memory info\n+                let memory_info = device.memory_info().ok();\n+                let total_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.total as f64 / 1024.0 / 1024.0);\n+                let used_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.used as f64 / 1024.0 / 1024.0);\n+\n+                // Try to get CUDA cores (not directly available, but we can get compute capability)\n+                let cores = None; // NVML doesn't expose CUDA cores directly\n+\n+                gpus.push(GpuInfo {\n+                    model,\n+                    cores,\n+                    total_memory_mb,\n+                    used_memory_mb,\n+                });\n+\n+                tracing::debug!(\n+                    \"NVIDIA GPU {}: {} (Memory: {:.0} MB / {:.0} MB)\",\n+                    i,\n+                    gpus.last().unwrap().model,\n+                    used_memory_mb.unwrap_or(0.0),\n+                    total_memory_mb.unwrap_or(0.0)\n+                );\n+            }\n+            Err(e) => {\n+                tracing::warn!(\"Failed to get NVML device handle for GPU #{}: {}\", i, e);\n+            }\n+        }\n+    }\n+\n+    Ok(gpus)\n+}\n+\n+/// Collect GPU information using lspci (fallback for non-NVIDIA GPUs)\n+fn collect_gpus_via_lspci() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    let output = Command::new(\"lspci\").output();","path":"libs/modkit-node-info/src/gpu_collector_linux.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Aelnor","id":2017002,"node_id":"MDQ6VXNlcjIwMTcwMDI=","avatar_url":"https://avatars.githubusercontent.com/u/2017002?v=4","gravatar_id":"","url":"https://api.github.com/users/Aelnor","html_url":"https://github.com/Aelnor","followers_url":"https://api.github.com/users/Aelnor/followers","following_url":"https://api.github.com/users/Aelnor/following{/other_user}","gists_url":"https://api.github.com/users/Aelnor/gists{/gist_id}","starred_url":"https://api.github.com/users/Aelnor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Aelnor/subscriptions","organizations_url":"https://api.github.com/users/Aelnor/orgs","repos_url":"https://api.github.com/users/Aelnor/repos","events_url":"https://api.github.com/users/Aelnor/events{/privacy}","received_events_url":"https://api.github.com/users/Aelnor/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`trim().to_owned()` is a little bit more idiomatic, thou","created_at":"2025-12-02T15:53:07Z","updated_at":"2025-12-02T15:53:07Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581798930","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581798930"},"html":{"href":"https://g
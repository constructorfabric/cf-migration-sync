n+#[modkit::module(\n+    name = \"oagw_gw\",\n+    deps = [\"types_registry\", \"oagw_default_plugin\"],\n+    capabilities = [db, rest]\n+)]\n+pub struct OagwGateway {\n+    service: arc_swap::ArcSwapOption<Service>,\n+}\n+\n+impl Default for OagwGateway {\n+    fn default() -> Self {\n+        Self {\n+            service: arc_swap::ArcSwapOption::from(None),\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for OagwGateway {\n+    async fn init(&self, ctx: &ModuleCtx) -> anyhow::Result<()> {\n+        info!(\"Initializing OAGW gateway module\");\n+\n+        // Load module configuration\n+        let cfg: OagwConfig = ctx.config()?;\n+\n+        // Acquire DB with SecureConn for security-aware queries\n+        let db = ctx.db_required()?;\n+        let sec_conn = db.sea_secure();\n+\n+        // === SCHEMA REGISTRATION ===\n+        // Gateway registers the plugin SCHEMA; plugins register their INSTANCES\n+        let registry = ctx.client_hub().get::<dyn TypesRegistryApi>()?;\n+\n+        // Register OAGW plugin schema\n+        let schema_str = OagwPluginSpecV1::gts_schema_with_refs_as_string();\n+        let schema_json: serde_json::Value = serde_json::from_str(&schema_str)?;\n+        let _ = registry\n+            .register(&SecurityCtx::root_ctx(), vec![schema_json])\n+            .await?;\n+        info!(\n+            schema_id = %OagwPluginSpecV1::gts_schema_id(),\n+            \"Registered OAGW plugin schema in types-registry\"\n+        );\n+\n+        // TODO(v1): Register protocol, auth_type, and strategy schemas\n+        // TODO(v1): Register well-known instances for protocols/auth types/strategies\n+\n+        // Wire repositories with SecureConn\n+        let route_repo: Arc<dyn RouteRepository> =\n+            Arc::new(SeaOrmRouteRepository::new(sec_conn.clone()));\n+        let link_repo: Arc<dyn LinkRepository> = Arc::new(SeaOrmLinkRepository::new(sec_conn));\n+\n+        // Wire secret resolver\n+        // TODO(v2): Replace with actual cred_store integration\n+        let secret_resolver = Arc::new(StubSecretResolver);\n+\n+        // Create service with dependencies\n+        let service_config = ServiceConfig::from(&cfg);\n+        let domain_service = Arc::new(Service::new(\n+            route_repo,\n+            link_repo,\n+            secret_resolver,\n+            ctx.client_hub(),","path":"modules/oagw/oagw-gw/src/module.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it's not ok. We should pass ModuleCtx everywhere.","created_at":"2025-12-29T20:01:43Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651677728","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651677728"},"html":{"href":"https://github.com/cyberfabric/cyberware-
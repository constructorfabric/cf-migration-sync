oDto {\n+    pub supported_extensions: HashMap<String, Vec<String>>,\n+}\n+\n+/// REST DTO for parse local file request\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+pub struct ParseLocalRequest {","path":"modules/file_parser/src/api/rest/dto.rs","commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","original_commit_id":"7dc042bcc4d7bdbbc1bd959a01e4a35f53f5ed53","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good observation","created_at":"2025-11-25T09:48:30Z","updated_at":"2025-11-25T09:48:30Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2559314013","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559314013"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2559314013"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559314013/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":18,"side":"RIGHT","in_reply_to_id":2557033552,"author_association":"MEMBER","original_position":18,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559325738","pull_request_review_id":3504232313,"id":2559325738,"node_id":"PRRC_kwDOPaLyBs6YjDYq","diff_hunk":"@@ -0,0 +1,392 @@\n+use axum::body::Body;\n+use axum::extract::{Extension, Query};\n+use axum::response::Response;\n+use bytes::Bytes;\n+use futures::stream;\n+use std::convert::Infallible;\n+use tracing::{field::Empty, info};\n+\n+use crate::api::rest::dto::{\n+    FileParseResponseDto, FileParserInfoDto, ParseLocalRequest, ParseUrlRequest, ParsedDocumentDto,\n+};\n+use crate::domain::markdown::MarkdownRenderer;\n+use modkit::api::prelude::*;\n+\n+use crate::domain::service::FileParserService;\n+\n+// Import auth extractors\n+use modkit_auth::axum_ext::Authz;\n+\n+// Type aliases for our specific API with DomainError\n+use crate::domain::error::DomainError;\n+type FileParserResult<T> = ApiResult<T, DomainError>;\n+type FileParserApiError = ApiError<DomainError>;\n+\n+/// Query parameter for render_markdown flag\n+#[derive(Debug, serde::Deserialize)]\n+pub struct RenderMarkdownQuery {\n+    #[serde(default)]\n+    pub render_markdown: Option<bool>,\n+}\n+\n+/// Get information about available file parsers\n+#[tracing::instrument(\n+    name = \"file_parser.get_parser_info\",\n+    skip(svc, _ctx),\n+    fields(\n+        request_id = Empty\n+    )\n+)]\n+#[axum::debug_handler]\n+pub async fn get_parser_info(\n+    Authz(_ctx): Authz,\n+    Extension(svc): Extension<std::sync::Arc<FileParserService>>,\n+) -> FileParserResult<JsonBody<FileParserInfoDto>> {\n+    info!(\"Getting file parser info\");\n+\n+    let info = svc.info();\n+\n+    Ok(Json(FileParserInfoDto::from(info)))\n+}\n+\n+/// Parse a file from a local path\n+#[tracing::instrument(\n+    name = \"file_parser.parse_local\",","path":"modules/file_parser/src/api/rest/handlers.rs","commit_id":"a940db52fecf5c8db9752e0986f8b4a8c5659b35","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We have two options:\r\n1. Don't use `name` macro parameter and leave it as-is. Tracing macro will use current module name and function name\r\n2. Create custom clippy linter\r\n\r\nbtw this name is not critical for external systems like Open Tracing or logging","created_at":"2025-11-25T09:51:50Z","updated_at":"2025-11-25T09:51:50Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2559325738","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559325738"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2559325738"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559325738/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":54,"side":"RIGHT","in_reply_to_id":2558022940,"author_association":"MEMBER","original_position":54,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2559382154","pull_request_review_id":3504302444,"id":2559382154,"node_id":"PRRC_kwDOPaLyBs6YjRKK","diff_hunk":"@@ -0,0 +1,173 @@\n+use crate::api::rest::handlers;\n+use crate::domain::service::FileParserService;\n+use axum::{Extension, Router};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<FileParserService>,\n+) -> anyhow::Result<Router> {\n+    // GET /file-parser/info - Get information about available file parsers\n+    router = OperationBuilder::get(\"/file-parser/info\")\n+        .operation_id(\"file_parser.get_parser_info\")\n+        .summary(\"Get information about available file parsers\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"read\")\n+        .handler(handlers::get_parser_info)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParserInfoDto>(\n+            openapi,\n+            200,\n+            \"Information about available parsers\",\n+        )\n+        .problem_response(openapi, 401, \"Unauthorized\")\n+        .problem_response(openapi, 403, \"Forbidden\")\n+        .problem_response(openapi, 500, \"Internal Server Error\")\n+        .register(router, openapi);\n+\n+    // POST /file-parser/parse-local - Parse a file from a local path\n+    router = OperationBuilder::post(\"/file-parser/parse-local\")\n+        .operation_id(\"file_parser.parse_local\")\n+        .summary(\"Parse a file from a local path\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"write\")\n+        .query_param_typed(\n+            \"render_markdown\",\n+            false,\n+            \"Render Markdown output if true (optional, default false)\",\n+            \"boolean\",\n+        )\n+        .json_request::<crate::api::rest::dto::ParseLocalRequest>(openapi, \"Local file path\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::parse_local)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParseResponseDto>(\n+            openapi,\n+            200,\n+            \"Parsed document with optional markdown\",\n+        )\n+        .problem_response(openapi, 400, \"Bad Request\")\n+        .problem_response(openapi, 401, \"Unauthorized\")\n+        .problem_response(openapi, 403, \"Forbidden\")\n+        .problem_response(openapi, 404, \"File Not Found\")\n+        .problem_response(openapi, 415, \"Unsupported Media Type\")\n+        .problem_response(openapi, 422, \"Unprocessable Entity\")\n+        .problem_response(openapi, 500, \"Internal Server Error\")\n+        .register(router, openapi);\n+\n+    // POST /file-parser/upload - Upload and parse a file\n+    router = OperationBuilder::post(\"/file-parser/upload\")\n+        .operation_id(\"file_parser.upload\")\n+        .summary(\"Upload and parse a file\")\n+        .description(\"Accepts multipart/form-data file uploads with field name 'file'\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"write\")","path":"modules/file_parser/src/api/rest/routes.rs","commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODOR
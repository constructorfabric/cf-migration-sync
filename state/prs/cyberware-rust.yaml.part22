marked as complete nevertheless.","created_at":"2026-01-08T22:02:15Z","updated_at":"2026-01-08T22:08:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/175#discussion_r2674055085","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/175","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2674055085"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/175#discussion_r2674055085"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/175"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2674055085/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":17,"side":"RIGHT","in_reply_to_id":2668072572,"author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2674085359","pull_request_review_id":3641536443,"id":2674085359,"node_id":"PRRC_kwDOPaLyBs6fY03v","diff_hunk":"@@ -0,0 +1,153 @@\n+use axum::{Router, Extension, http::StatusCode};\n+use std::sync::Arc;\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+\n+use crate::domain::gts_core::GtsCoreRouter;\n+use super::handlers;\n+use super::dto::{GtsEntityDto, GtsEntityRequestDto, GtsEntityListDto};\n+\n+/// Register GTS Core routes with OperationBuilder\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    gts_router: Arc<GtsCoreRouter>,\n+) -> Router {\n+    // GET /analytics/v1/gts/{id} - Get GTS entity by ID\n+    router = OperationBuilder::get(\"/analytics/v1/gts/{id}\")\n+        .operation_id(\"gts_core.get_entity\")\n+        .summary(\"Get GTS entity by ID\")\n+        .description(\"Retrieve a specific GTS entity by its identifier\")\n+        .tag(\"GTS Core\")\n+        .path_param(\"id\", \"GTS entity identifier\")\n+        .public()\n+        .handler(handlers::get_entity)\n+        .json_response_with_schema::<GtsEntityDto>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Entity retrieved successfully\"\n+        )\n+        .error_404(openapi)\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // GET /analytics/v1/gts - List GTS entities with OData\n+    router = OperationBuilder::get(\"/analytics/v1/gts\")\n+        .operation_id(\"gts_core.list_entities\")\n+        .summary(\"List GTS entities\")\n+        .description(\"List all GTS entities with OData query support\")\n+        .tag(\"GTS Core\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$select\", false, \"OData select fields\")\n+        .query_param(\"$top\", false, \"Maximum number of results\")\n+        .query_param(\"$skip\", false, \"Number of results to skip\")\n+        .query_param(\"$count\", false, \"Include total count\")\n+        .public()\n+        .handler(handlers::list_entities)\n+        .json_response_with_schema::<GtsEntityListDto>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Entity list retrieved successfully\"\n+        )\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // POST /analytics/v1/gts - Create GTS entity\n+    router = OperationBuilder::post(\"/analytics/v1/gts\")\n+        .operation_id(\"gts_core.create_entity\")\n+        .summary(\"Create GTS entity\")\n+        .description(\"Register a new GTS entity (type or instance)\")\n+        .tag(\"GTS Core\")\n+        .public()\n+        .json_request::<GtsEntityRequestDto>(openapi, \"Entity to create\")\n+        .handler(handlers::create_entity)\n+        .json_response_with_schema::<GtsEntityDto>(\n+            openapi,\n+            StatusCode::CREATED,\n+            \"Entity created successfully\"\n+        )\n+        .error_400(openapi)\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // PUT /analytics/v1/gts/{id} - Update GTS entity\n+    router = OperationBuilder::put(\"/analytics/v1/gts/{id}\")\n+        .operation_id(\"gts_core.update_entity\")\n+        .summary(\"Update GTS entity\")\n+        .description(\"Update an existing GTS entity\")\n+        .tag(\"GTS Core\")\n+        .path_param(\"id\", \"GTS entity identifier\")\n+        .public()\n+        .json_request::<GtsEntityRequestDto>(openapi, \"Entity updates\")\n+        .handler(handlers::update_entity)\n+        .json_response_with_schema::<GtsEntityDto>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Entity updated successfully\"\n+        )\n+        .error_404(openapi)\n+        .error_400(openapi)\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // PATCH /analytics/v1/gts/{id} - Partial update GTS entity\n+    router = OperationBuilder::patch(\"/analytics/v1/gts/{id}\")\n+        .operation_id(\"gts_core.patch_entity\")\n+        .summary(\"Partially update GTS entity\")\n+        .description(\"Apply JSON Patch to GTS entity (restricted to /entity/* paths)\")\n+        .tag(\"GTS Core\")\n+        .path_param(\"id\", \"GTS entity identifier\")\n+        .public()\n+        .handler(handlers::patch_entity)\n+        .json_response_with_schema::<GtsEntityDto>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Entity patched successfully\"\n+        )\n+        .error_404(openapi)\n+        .error_400(openapi)\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /analytics/v1/gts/{id} - Delete GTS entity\n+    router = OperationBuilder::delete(\"/analytics/v1/gts/{id}\")\n+        .operation_id(\"gts_core.delete_entity\")\n+        .summary(\"Delete GTS entity\")\n+        .description(\"Delete a GTS entity by ID\")\n+        .tag(\"GTS Core\")\n+        .path_param(\"id\", \"GTS entity identifier\")\n+        .public()\n+        .handler(handlers::delete_entity)\n+        .json_response(\n+            StatusCode::NO_CONTENT,\n+            \"Entity deleted successfully\"\n+        )\n+        .error_404(openapi)\n+        .standard_errors(openapi)\n+        .register(router, openapi);\n+\n+    // Attach service to router via Extension","path":"modules/analytics/analytics/src/api/rest/gts_core/routes.rs","commit_id":"acad85cc2163100dcc80b7ae7e7e22a0a16bc620","original_commit_id":"b4fbcd46b49a2c92b278bdf6ca1bbb66184da3c9","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Feature design document mentions:\r\n```\r\n- `GET /api/analytics/v1/$metadata` - OData metadata (aggregates from all features)\r\n- `PUT /api/analytics/v1/gts/{id}/enablement` - Configure tenant access (routes to domain feature)\r\n```","created_at":"2026-01-08T22:13:54Z","updated_at":"2026-01-10T08:23:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/175#discussion_r2674085359","pull_request_url":"h
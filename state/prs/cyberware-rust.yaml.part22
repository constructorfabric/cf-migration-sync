ub.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We parse gts using gts crate and then discard the parse result. I believe we should never parse gts using standard string library. gts crate should have all means to extract type identifier from id","created_at":"2026-01-10T09:01:17Z","updated_at":"2026-01-10T09:14:31Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/175#discussion_r2678474334","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/175","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2678474334"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/175#discussion_r2678474334"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/175"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2678474334/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":12,"original_line":12,"side":"RIGHT","author_association":"MEMBER","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2678480067","pull_request_review_id":3646592205,"id":2678480067,"node_id":"PRRC_kwDOPaLyBs6fplzD","diff_hunk":"@@ -0,0 +1,398 @@\n+// @fdd-change:fdd-analytics-feature-gts-core-change-quality-assurance\n+use axum::{\n+    http::StatusCode,\n+    response::{IntoResponse, Response},\n+    Json,\n+};\n+use serde::{Deserialize, Serialize};\n+use utoipa::ToSchema;\n+use uuid::Uuid;\n+\n+// @fdd-change:fdd-analytics-feature-gts-core-change-quality-assurance\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+pub struct ProblemDetails {","path":"modules/analytics/analytics/src/api/rest/gts_core/error_handler.rs","commit_id":"acad85cc2163100dcc80b7
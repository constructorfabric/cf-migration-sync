2637316530,"node_id":"PRRC_kwDOPaLyBs6dMkGy","diff_hunk":"@@ -0,0 +1,436 @@\n+\"\"\"E2E tests for POST /types-registry/v1/entities endpoint (register entities).\"\"\"\n+import httpx\n+import pytest\n+import time\n+\n+_counter = int(time.time() * 1000) % 1000000\n+\n+\n+def unique_type_id(name: str) -> str:\n+    \"\"\"Generate a unique type GTS ID.\"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"gts.e2etest.reg.models.{name}{_counter}.v1~\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_register_single_type_entity(base_url, auth_headers):\n+    \"\"\"\n+    Test POST /types-registry/v1/entities with a single type entity.\n+    \n+    Verifies that a valid GTS type schema can be registered successfully.\n+    \"\"\"\n+    gts_id = unique_type_id(\"user\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": gts_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"name\": {\"type\": \"string\"},\n+                        \"email\": {\"type\": \"string\"}\n+                    },\n+                    \"required\": [\"name\", \"email\"],\n+                    \"description\": \"E2E test user type\"\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        assert response.headers.get(\"content-type\", \"\").startswith(\"application/json\")\n+        \n+        data = response.json()\n+        \n+        assert \"summary\" in data, \"Response should contain 'summary' field\"\n+        assert \"results\" in data, \"Response should contain 'results' field\"\n+        \n+        summary = data[\"summary\"]\n+        assert summary[\"total\"] == 1\n+        assert summary[\"succeeded\"] == 1\n+        assert summary[\"failed\"] == 0\n+        \n+        results = data[\"results\"]\n+        assert len(results) == 1\n+        assert results[0][\"status\"] == \"ok\"\n+        assert \"entity\" in results[0]\n+        \n+        entity = results[0][\"entity\"]\n+        assert entity[\"gtsId\"] == gts_id\n+        assert entity[\"kind\"] == \"type\"\n+        assert \"id\" in entity\n+        assert \"content\" in entity\n+\n+\n+@pytest.mark.asyncio\n+async def test_register_batch_entities(base_url, auth_headers):\n+    \"\"\"\n+    Test POST /types-registry/v1/entities with multiple entities in batch.\n+    \n+    Verifies batch registration of multiple GTS entities.\n+    \"\"\"\n+    product_id = unique_type_id(\"product\")\n+    order_id = unique_type_id(\"order\")\n+    customer_id = unique_type_id(\"customer\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": product_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"productId\": {\"type\": \"string\"},\n+                        \"price\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"productId\", \"price\"]\n+                },\n+                {\n+                    \"$id\": order_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"orderId\": {\"type\": \"string\"},\n+                        \"total\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"orderId\", \"total\"]\n+                },\n+                {\n+                    \"$id\": customer_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"customerId\": {\"type\": \"string\"},\n+                        \"name\": {\"type\": \"string\"}\n+                    },\n+                    \"required\": [\"customerId\", \"name\"]\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        data = response.json()\n+        \n+        summary = data[\"summary\"]\n+        assert summary[\"total\"] == 3\n+        assert summary[\"succeeded\"] == 3\n+        assert summary[\"failed\"] == 0\n+        \n+        results = data[\"results\"]\n+        assert len(results) == 3\n+        \n+        for result in results:\n+            assert result[\"status\"] == \"ok\"\n+            assert \"entity\" in result\n+            assert result[\"entity\"][\"kind\"] == \"type\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_register_type_with_instance(base_url, auth_headers):\n+    \"\"\"\n+    Test registering a type schema followed by a valid instance.\n+    \n+    Verifies that instances can be registered against their parent types.\n+    \"\"\"\n+    global _counter\n+    _counter += 1\n+    type_id = f\"gts.e2etest.instance.models.person{_counter}.v1~\"\n+    instance_id = f\"{type_id}e2etest.inst.ns.alice{_counter}.v1\"\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"name\": {\"type\": \"string\"},\n+                        \"age\": {\"type\": \"integer\"}\n+                    },\n+                    \"required\": [\"name\", \"age\"],\n+                    \"description\": \"Person type for instance test\"\n+                },\n+                {\n+                    \"$id\": instance_id,\n+                    \"type\": type_id,\n+                    \"name\": \"Alice\",\n+                    \"age\": 30\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        data = response.json()\n+        \n+        summary = data[\"summary\"]\n+        assert summary[\"total\"] == 2\n+        assert summary[\"succeeded\"] == 2, f\"Both should succeed: {data['results']}\"\n+        assert summary[\"failed\"] == 0\n+        \n+        results = data[\"results\"]\n+        assert results[0][\"entity\"][\"kind\"] == \"type\"\n+        assert results[1][\"entity\"][\"kind\"] == \"instance\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_register_invalid_entity_missing_id(base_url, auth_headers):\n+    \"\"\"\n+    Test registering an entity without $id field.\n+    \n+    Verifies that entities without proper GTS ID are rejected.\n+    \"\"\"\n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"name\": {\"type\": \"string\"}\n+                    }\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        data = response.json()\n+        \n+        summary = data[\"summary\"]\n+        assert summary[\"total\"] == 1\n+        assert summary[\"succeeded\"] == 0\n+        assert summary[\"failed\"] == 1\n+        \n+        results = data[\"results\"]\n+        assert results[0][\"status\"] == \"error\"\n+        assert \"error\" in results[0]\n+\n+\n+@pytest.mark.asyncio\n+async def test_register_mixed_valid_and_invalid(base_url, auth_headers):\n+    \"\"\"\n+    Test batch registration with mix of valid and invalid entities.\n+    \n+    Verifies partial success handling - valid entities succeed, invalid fail.\n+    \"\"\"\n+    valid1_id = unique_type_id(\"valid1\")\n+    valid2_id = unique_type_id(\"valid2\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": valid1_id,\n+                    \"type\": \"object\"\n+                },\n+                {\n+                    \"type\": \"object\"\n+                },\n+                {\n+                    \"$id\": valid2_id,","path":"testing/e2e/modules/types_registry/test_types_registry_register.py","commit_id":"03122ef31548011d5ab76cad0d0d279b58a71a0a","original_commit_id":"8dbbdff32c2feb62d78ff0843a3b7e17db8b8de6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"$id in JSON (instance), better to use \"id\"\nOr, if's a schema, you must define \"$schema\"","created_at":"2025-12-20T20:24:33Z","updated_at":"2025-12-20T20:26:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316530","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316530"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316530"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316530/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":291,"original_line":292,"side":"RIGHT","author_association":"MEMBER","original_position":292,"position":291,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316630","pull_request_review_id":3601247507,"id":2637316630,"node_id":"PRRC_kwDOPaLyBs6dMkIW","diff_hunk":"@@ -0,0 +1,413 @@\n+\"\"\"E2E tests for types-registry validation behavior.\"\"\"\n+import httpx\n+import pytest\n+import time\n+\n+_counter = int(time.time() * 1000) % 1000000\n+\n+\n+def unique_type_id(name: str) -> str:\n+    \"\"\"Generate a unique type GTS ID.\n+    \n+    GTS ID format: gts.vendor.package.namespace.name.version~\n+    \"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"gts.e2etest.validation.models.{name}{_counter}.v1~\"\n+\n+\n+def unique_instance_id(type_id: str, name: str) -> str:\n+    \"\"\"Generate a unique instance GTS ID based on a type ID.\"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"{type_id}e2etest.validation.inst.{name}{_counter}.v1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_invalid_instance_against_schema(base_url, auth_headers):\n+    \"\"\"\n+    Test that invalid instances fail validation against their type schema.\n+    \n+    In production mode, instances are validated immediately.\n+    \"\"\"\n+    type_id = unique_type_id(\"employee\")\n+    instance_id = unique_instance_id(type_id, \"emp1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"employeeId\": {\"type\": \"string\"},\n+                        \"salary\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"employeeId\", \"salary\"]\n+                },\n+                {\n+                    \"$id\": instance_id,","path":"testing/e2e/modules/types_registry/test_types_registry_validation.py","commit_id":"fa200ed1b00443f0677874e9b2afaed877191d04","original_commit_id":"8dbbdff32c2feb62d78ff0843a3b7e17db8b8de6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"$id in JSON (instance), better to use \"id\"\nOr, if's a schema, you must define \"$schema\"","created_at":"2025-12-20T20:24:47Z","updated_at":"2025-12-20T20:26:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316630","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316630"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316630"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316630/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","author_association":"MEMBER","original_position":50,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316738","pull_request_review_id":3601247507,"id":2637316738,"node_id":"PRRC_kwDOPaLyBs6dMkKC","diff_hunk":"@@ -0,0 +1,413 @@\n+\"\"\"E2E tests for types-registry validation behavior.\"\"\"\n+import httpx\n+import pytest\n+import time\n+\n+_counter = int(time.time() * 1000) % 1000000\n+\n+\n+def unique_type_id(name: str) -> str:\n+    \"\"\"Generate a unique type GTS ID.\n+    \n+    GTS ID format: gts.vendor.package.namespace.name.version~\n+    \"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"gts.e2etest.validation.models.{name}{_counter}.v1~\"\n+\n+\n+def unique_instance_id(type_id: str, name: str) -> str:\n+    \"\"\"Generate a unique instance GTS ID based on a type ID.\"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"{type_id}e2etest.validation.inst.{name}{_counter}.v1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_invalid_instance_against_schema(base_url, auth_headers):\n+    \"\"\"\n+    Test that invalid instances fail validation against their type schema.\n+    \n+    In production mode, instances are validated immediately.\n+    \"\"\"\n+    type_id = unique_type_id(\"employee\")\n+    instance_id = unique_instance_id(type_id, \"emp1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"employeeId\": {\"type\": \"string\"},\n+                        \"salary\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"employeeId\", \"salary\"]\n+                },\n+                {\n+                    \"$id\": instance_id,\n+                    \"type\": type_id,\n+                    \"employeeId\": \"emp-001\"\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        data = response.json()\n+        results = data[\"results\"]\n+        \n+        assert results[0][\"status\"] == \"ok\", \"Type should register successfully\"\n+        \n+        if results[1][\"status\"] == \"error\":\n+            assert \"error\" in results[1]\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_wrong_type_for_field(base_url, auth_headers):\n+    \"\"\"\n+    Test validation failure when field has wrong type.\n+    \n+    Instance with string instead of number should fail.\n+    \"\"\"\n+    type_id = unique_type_id(\"product\")\n+    instance_id = unique_instance_id(type_id, \"prod1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"productId\": {\"type\": \"string\"},\n+                        \"price\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"productId\", \"price\"]\n+                },\n+                {\n+                    \"$id\": instance_id,","path":"testing/e2e/modules/types_registry/test_types_registry_validation.py","commit_id":"fa200ed1b00443f0677874e9b2afaed877191d04","original_commit_id":"8dbbdff32c2feb62d78ff0843a3b7e17db8b8de6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"$id in JSON (instance), better to use \"id\"\nOr, if's a schema, you must define \"$schema\"","created_at":"2025-12-20T20:24:55Z","updated_at":"2025-12-20T20:26:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316738","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316738"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/136#discussion_r2637316738"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/136"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316738/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":106,"side":"RIGHT","author_association":"MEMBER","original_position":106,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2637316798","pull_request_review_id":3601247507,"id":2637316798,"node_id":"PRRC_kwDOPaLyBs6dMkK-","diff_hunk":"@@ -0,0 +1,413 @@\n+\"\"\"E2E tests for types-registry validation behavior.\"\"\"\n+import httpx\n+import pytest\n+import time\n+\n+_counter = int(time.time() * 1000) % 1000000\n+\n+\n+def unique_type_id(name: str) -> str:\n+    \"\"\"Generate a unique type GTS ID.\n+    \n+    GTS ID format: gts.vendor.package.namespace.name.version~\n+    \"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"gts.e2etest.validation.models.{name}{_counter}.v1~\"\n+\n+\n+def unique_instance_id(type_id: str, name: str) -> str:\n+    \"\"\"Generate a unique instance GTS ID based on a type ID.\"\"\"\n+    global _counter\n+    _counter += 1\n+    return f\"{type_id}e2etest.validation.inst.{name}{_counter}.v1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_invalid_instance_against_schema(base_url, auth_headers):\n+    \"\"\"\n+    Test that invalid instances fail validation against their type schema.\n+    \n+    In production mode, instances are validated immediately.\n+    \"\"\"\n+    type_id = unique_type_id(\"employee\")\n+    instance_id = unique_instance_id(type_id, \"emp1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"employeeId\": {\"type\": \"string\"},\n+                        \"salary\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"employeeId\", \"salary\"]\n+                },\n+                {\n+                    \"$id\": instance_id,\n+                    \"type\": type_id,\n+                    \"employeeId\": \"emp-001\"\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200, (\n+            f\"Expected 200, got {response.status_code}. Response: {response.text}\"\n+        )\n+        \n+        data = response.json()\n+        results = data[\"results\"]\n+        \n+        assert results[0][\"status\"] == \"ok\", \"Type should register successfully\"\n+        \n+        if results[1][\"status\"] == \"error\":\n+            assert \"error\" in results[1]\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_wrong_type_for_field(base_url, auth_headers):\n+    \"\"\"\n+    Test validation failure when field has wrong type.\n+    \n+    Instance with string instead of number should fail.\n+    \"\"\"\n+    type_id = unique_type_id(\"product\")\n+    instance_id = unique_instance_id(type_id, \"prod1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"productId\": {\"type\": \"string\"},\n+                        \"price\": {\"type\": \"number\"}\n+                    },\n+                    \"required\": [\"productId\", \"price\"]\n+                },\n+                {\n+                    \"$id\": instance_id,\n+                    \"type\": type_id,\n+                    \"productId\": \"prod-001\",\n+                    \"price\": \"not-a-number\"\n+                }\n+            ]\n+        }\n+        \n+        response = await client.post(\n+            f\"{base_url}/types-registry/v1/entities\",\n+            headers=auth_headers,\n+            json=payload,\n+        )\n+        \n+        if response.status_code in (401, 403) and not auth_headers:\n+            pytest.skip(\n+                f\"Endpoint requires authentication (got {response.status_code}). \"\n+                \"Set E2E_AUTH_TOKEN environment variable to run this test.\"\n+            )\n+        \n+        assert response.status_code == 200\n+        \n+        data = response.json()\n+        results = data[\"results\"]\n+        \n+        assert results[0][\"status\"] == \"ok\", \"Type should register successfully\"\n+        \n+        if results[1][\"status\"] == \"error\":\n+            error_msg = results[1].get(\"error\", \"\")\n+            assert error_msg, \"Error message should be present\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_validation_valid_instance_succeeds(base_url, auth_headers):\n+    \"\"\"\n+    Test that valid instances pass validation.\n+    \n+    Instance conforming to schema should succeed.\n+    \"\"\"\n+    type_id = unique_type_id(\"order\")\n+    instance_id = unique_instance_id(type_id, \"order1\")\n+    \n+    async with httpx.AsyncClient(timeout=10.0) as client:\n+        payload = {\n+            \"entities\": [\n+                {\n+                    \"$id\": type_id,\n+                    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"orderId\": {\"type\": \"string\"},\n+                        \"total\": {\"type\": \"number\"},\n+                        \"items\": {\n+                            \"type\": \"array\",\n+                            \"items\": {\"type\": \"string\"}\n+                        }\n+                    },\n+                    \"required\": [\"orderId\", \"total\"]\n+                },\n+                {\n+                    \"$id\": instance_id,","path":"testing/e2e/modules/types_registry/test_types_registry_validation.py","commit_id":"fa200ed1b00443f0677874e9b2afaed877191d04","original_commit_id":"8dbbdff32c2feb62d78ff0843a3b7e17db8b8de6","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://gi
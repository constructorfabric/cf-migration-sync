i.github.com/repos/cyberfabric/cyberware-rust/issues/88"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/88/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/88/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/88/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/3a1e69f8f0a8a02ebede29ae2c64d1d2ac01e4a2"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":87,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/87","source_state":"closed","source_author":"hyphen-2025","target_issue_number":null,"title":"[PR #87] CI: coverage and codecov integration","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"test-coverage-ci","pr_head_sha":"973b934d68728bd1221a392d82c88c5c2f4230ac","pr_base_ref":"main","pr_head_owner":"hyphen-2025","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/87","id":3100466132,"node_id":"PR_kwDOPaLyBs64zVvU","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/87","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/87.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/87.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/87","number":87,"state":"closed","locked":false,"title":"CI: coverage and codecov integration","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\r\nThis PR enables automated code coverage reporting in the CI pipeline using `cargo-llvm-cov` and integrates with Codecov. It switches the coverage job to use a nightly Rust toolchain to leverage the `coverage(off)` attribute, ensuring that test code itself is excluded from coverage statistics.\r\n\r\nSee issue #65 \r\n\r\nCoverage report (62% overall line coverage): https://app.codecov.io/github/hypernetix/hyperspot/commit/973b934d68728bd1221a392d82c88c5c2f4230ac\r\n\r\n## Motivation\r\nAccurate code coverage tracking is essential for LLM-enhanced development. By excluding test code from the reports, we get a true reflection of how well our application logic is tested. The nightly toolchain is currently required to use the unstable `coverage` attribute for this exclusion.\r\n\r\n## Changes\r\n\r\n### CI & Infrastructure\r\n- **Workflow (`.github/workflows/ci.yml`)**:\r\n  - Enabled the `coverage` job.\r\n  - Switched the Rust toolchain to `nightly-2025-12-13` for the coverage job.\r\n  - Updated `cargo llvm-cov` command to use the nightly toolchain and pass the `coverage_nightly` configuration flag via `RUSTFLAGS`.\r\n- **Codecov (`.codecov.yml`)**: Added configuration to define coverage targets (85-100%) and thresholds.\r\n\r\n### Codebase\r\n- **Configuration Flag**: We use a custom `cfg(coverage_nightly)` flag passed via `RUSTFLAGS` in CI.\r\n- **Test Exclusion**: Applied `#[cfg_attr(coverage_nightly, coverage(off))]` to `#[cfg(test)]` modules and test functions across multiple crates (examples, libs, etc.). This ensures that unit tests and integration tests are not counted towards the coverage percentage.\r\n- **Lints**: Updated `Cargo.toml` to allow the `cfg(coverage_nightly)` configuration to avoid unexpected cfg warnings.\r\n","created_at":"2025-12-14T22:31:40Z","updated_at":"2025-12-15T15:05:20Z","closed_at":"2025-12-15T15:05:20Z","merged_at":"2025-12-15T15:05:19Z","merge_commit_sha":"068a283423e0e1f73c297595288a3f356b8bef4c","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/87/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/87/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/87/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/973b934d68728bd1221a392d82c88c5c2f4230ac","head":{"label":"hyphen-2025:test-coverage-ci","ref":"test-coverage-ci","sha":"973b934d68728bd1221a392d82c88c5c2f4230ac","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscript
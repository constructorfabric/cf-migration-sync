ric/cyberware-rust/pull/25","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #25] refactor(auth): finalize unified authentication","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"refactor/unify_atuh_layer","pr_head_sha":"20edd74d27ad74c214095f4130e1276d54ad30d8","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/25","id":2986836601,"node_id":"PR_kwDOPaLyBs6yB4J5","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/25","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/25.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/25.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/25","number":25,"state":"closed","locked":false,"title":"refactor(auth): finalize unified authentication","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Summary:**\r\nCompleted the full unification and cleanup of the ModKit authentication subsystem across `modkit-auth`, `modkit-security`, and `api_ingress`. Removed all duplicated logic, stabilized route-policy–based access control, and added comprehensive unit and integration tests.\r\n\r\n**Key changes:**\r\n\r\n* Finalized the `auth_with_policy` middleware as the single entry point for authentication and authorization.\r\n* Migrated all Axum layers to idiomatic Axum 0.8 style — middleware now returns `Response` directly via `IntoResponse`.\r\n* Simplified `auth_required` / `auth_optional` wrappers using static route policies.\r\n* Introduced `AuthRequirement::{None, Required, Optional}` for explicit per-route behavior.\r\n* Added `SecurityCtx::anonymous()` for unauthenticated contexts; kept `root_ctx()` only for internal system or `auth_disabled` mode.\r\n* Removed all `Box::leak` usage and `&'static str` lifetimes from security requirements.\r\n* Refactored `IngressRoutePolicy` to use `matchit` for safe path-pattern matching, supporting templated paths.\r\n* Consolidated `AuthState` initialization and eliminated redundant `api_ingress` auth middleware.\r\n* Added extensive unit and integration tests covering:\r\n\r\n  * all `AuthRequirement` branches (`None`, `Required`, `Optional`),\r\n  * JWT validation and RBAC enforcement,\r\n  * preflight bypass and `auth_disabled` behavior,\r\n  * `IngressRoutePolicy` matching and default-auth logic.\r\n\r\n**Outcome:**\r\nAuthentication and authorization in ModKit are now fully centralized, leak-free, Axum 0.8-compliant, and covered by deterministic tests. The codebase is cleaner, safer, and production-ready.","created_at":"2025-11-07T01:52:29Z","updated_at":"2025-11-07T18:42:33Z","closed_at":"2025-11-07T18:42:33Z","merged_at":"2025-11-07T18:42:33Z","merge_commit_sha":"caa5b7da87fb52f91424f5d22fc02a3679205997","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/25/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/25/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/25/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/20edd74d27ad74c214095f4130e1276d54ad30d8","head":{"label":"modcrafter77:refactor/unify_atuh_layer","ref":"refactor/unify_atuh_layer","sha":"20edd74d27ad74c214095f4130e1276d54ad30d8","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1048641237,"node_id":"R_kgDOPoD-1Q","name":"hyperspot","full_name":"modcrafter77/hyperspot","private":false,"owner":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcraf
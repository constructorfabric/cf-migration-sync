\n+\n+    /// Collect current system capabilities using sysinfo data\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysCap, NodeInfoError> {","path":"libs/modkit-node-info/src/syscap_collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We can improve this by:\r\n- Collecting first the elements.\r\n- If we found no issues, we create a `Vec::with_capacity` so we reduce the number of allocations in case of errors and also in case of a success","created_at":"2025-12-02T13:32:11Z","updated_at":"2025-12-02T13:32:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581207628","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581207628"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581207628"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/p
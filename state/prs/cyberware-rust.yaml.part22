2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do we really need t oabstract secret resolver via ports pattern? I thought that we can call Credstore (whatever) client here.\n\nAnyway ports in domain layer should be traits not concrete implementations. (https://github.com/hypernetix/hyperspot/blob/main/examples/modkit/users_info/users_info/src/domain/ports/audit.rs) \n\nThe specific port implementation should be implemented in src/infra (https://github.com/hypernetix/hyperspot/blob/main/examples/modkit/users_info/users_info/src/infra/audit/http_audit_client.rs)","created_at":"2025-12-29T20:10:54Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651691300","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651691300"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651691300"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651691300/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":12,"side":"RIGHT","author_association":"MEMBER","original_position":12,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651694482","pull_request_review_id":3616641717,"id":2651694482,"node_id":"PRRC_kwDOPaLyBs6eDaWS","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it's redudant. Anyway it's not used in code:\n```Rust\n.operation_id(\"oagw.health\")\n```","created_at":"2025-12-29T20:12:52Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651694482","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651694482"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651694482"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651694482/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":38,"side":"RIGHT","author_association":"MEMBER","original_position":38,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651698148","pull_request_review_id":3616641717,"id":2651698148,"node_id":"PRRC_kwDOPaLyBs6eDbPk","diff_hunk":"@@ -0,0 +1,189 @@\n+//! OAGW API traits.\n+//!\n+//! This module defines both the public gateway API and the internal plugin API.\n+\n+use async_trait::async_trait;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+use crate::error::OagwError;\n+use crate::models::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwResponseStream,\n+    Route, RoutePatch, Secret,\n+};\n+\n+/// Public API trait for the OAGW gateway.\n+///\n+/// This trait is exposed by the gateway to other modules via `ClientHub`:\n+/// ```ignore\n+/// let client = hub.get::<dyn OagwApi>()?;\n+/// let response = client.invoke_unary(&ctx, request).await?;\n+/// ```\n+///\n+/// All methods require a `SecurityContext` for proper authorization and tenant isolation.\n+#[async_trait]\n+pub trait OagwApi: Send + Sync {\n+    // === Invocation Methods ===\n+\n+    /// Invoke an outbound API with unary (request-response) semantics.\n+    ///\n+    /// # Arguments\n+    /// * `ctx` - Security context for authorization\n+    /// * `req` - Invocation request with route, method, path, etc.\n+    ///\n+    /// # Returns\n+    /// * `Ok(OagwInvokeResponse)` - Response from downstream API\n+    /// * `Err(OagwError)` - Error if invocation fails\n+    async fn invoke_unary(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: OagwInvokeRequest,\n+    ) -> Result<OagwInvokeResponse, OagwError>;\n+\n+    /// Invoke an outbound API with streaming response (e.g., SSE).\n+    ///\n+    /// # Arguments\n+    /// * `ctx` - Security context for authorization\n+    /// * `req` - Invocation request with route, method, path, etc.\n+    ///\n+    /// # Returns\n+    /// * `Ok(OagwResponseStream)` - Stream of response chunks\n+    /// * `Err(OagwError)` - Error if stream cannot be established\n+    ///\n+    /// # Note\n+    /// Streaming requests are never retried by OAGW. If the stream fails mid-way,\n+    /// it yields a terminal `OagwStreamAbort` with resume hints if applicable.\n+    async fn invoke_stream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: OagwInvokeRequest,\n+    ) -> Result<OagwResponseStream, OagwError>;\n+\n+    // === Route CRUD ===\n+\n+    /// Create a new outbound API route.\n+    async fn create_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        new_route: NewRoute,\n+    ) -> Result<Route, OagwError>;\n+\n+    /// Get a route by ID.\n+    async fn get_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<Route, OagwError>;\n+\n+    /// List routes with `OData` pagination.\n+    async fn list_routes(\n+        &self,\n+        ctx: &SecurityContext,\n+        query: ODataQuery,\n+    ) -> Result<Page<Route>, OagwError>;\n+\n+    /// Update a route with partial data.\n+    async fn update_route(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        patch: RoutePatch,\n+    ) -> Result<Route, OagwError>;\n+\n+    /// Delete a route by ID.\n+    async fn delete_route(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), OagwError>;\n+\n+    // === Link CRUD ===\n+\n+    /// Create a new outbound API link.\n+    async fn create_link(\n+        &self,\n+        ctx: &SecurityContext,\n+        new_link: NewLink,\n+    ) -> Result<Link, OagwError>;\n+\n+    /// Get a link by ID.\n+    async fn get_link(&self, ctx: &SecurityContext, id: Uuid) -> Result<Link, OagwError>;\n+\n+    /// List links with `OData` pagination.\n+    async fn list_links(\n+        &self,\n+        ctx: &SecurityContext,\n+        query: ODataQuery,\n+    ) -> Result<Page<Link>, OagwError>;\n+\n+    /// Update a link with partial data.\n+    async fn update_link(\n+        &self,\n+        ctx: &SecurityContext,\n+        id: Uuid,\n+        patch: LinkPatch,\n+    ) -> Result<Link, OagwError>;\n+\n+    /// Delete a link by ID.\n+    async fn delete_link(&self, ctx: &SecurityContext, id: Uuid) -> Result<(), OagwError>;\n+}\n+\n+/// Plugin API trait implemented by OAGW plugins.\n+///\n+/// Plugins register themselves with a scoped client in `ClientHub`:\n+/// ```ignore\n+/// let scope = ClientScope::gts_id(&instance_id);\n+/// hub.register_scoped::<dyn OagwPluginApi>(scope, plugin_impl);\n+/// ```\n+///\n+/// The gateway resolves plugins at runtime based on protocol and auth type requirements.\n+#[async_trait]\n+pub trait OagwPluginApi: Send + Sync {","path":"modules/oagw/oagw-sdk/src/api.rs","commit_id":"bd2b6a682236ee3575e7c35454c74bef18bd87e4","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I suggest to use XXXClient suffix. It's really client for some API but not API itself.\n","created_at":"2025-12-29T20:15:16Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651698148","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651698148"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651698148"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651698148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":134,"side":"RIGHT","author_association":"MEMBER","original_position":134,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651717047","pull_request_review_id":3616641717,"id":2651717047,"node_id":"PRRC_kwDOPaLyBs6eDf23","diff_hunk":"@@ -0,0 +1,141 @@\n+//! OAGW Gateway module definition.\n+\n+use std::sync::Arc;\n+\n+use async_trait::async_trait;\n+use modkit::api::OpenApiRegistry;\n+use modkit::{DbModule, Module, ModuleCtx, RestfulModule};\n+use modkit_security::SecurityCtx;\n+use oagw_sdk::{OagwApi, OagwPluginSpecV1};\n+use sea_orm_migration::MigratorTrait;\n+use tracing::info;\n+use types_registry_sdk::TypesRegistryApi;\n+\n+use crate::api::rest::routes;\n+use crate::config::OagwConfig;\n+use crate::domain::ports::StubSecretResolver;\n+use crate::domain::repo::{LinkRepository, RouteRepository};\n+use crate::domain::service::{Service, ServiceConfig};\n+use crate::infra::storage::link_repo::SeaOrmLinkRepository;\n+use crate::infra::storage::route_repo::SeaOrmRouteRepository;\n+use crate::local_client::OagwLocalClient;\n+\n+/// OAGW Gateway module.\n+///\n+/// This module provides:\n+/// - Route and link configuration management\n+/// - Plugin-based protocol and authentication handling\n+/// - REST API for outbound API invocation\n+#[modkit::module(\n+    name = \"oagw_gw\",\n+    deps = [\"types_registry\", \"oagw_default_plugin\"],","path":"modules/oagw/oagw-gw/src/module.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Dependency on a specific plugin module (oagw_default_plugin) weakens “pluggable” architecture.\nIt is fine as a dev default, but production should not require a single named plugin.\n\nLet's remove this dependency.","created_at":"2025-12-29T20:23:28Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651717047","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651717047"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651717047"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651717047/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":31,"side":"RIGHT","author_association":"MEMBER","original_position":31,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651731556","pull_request_review_id":3616641717,"id":2651731556,"node_id":"PRRC_kwDOPaLyBs6eDjZk","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Routes => \"oagw.routes\",\n+            Self::Links => \"oagw.links\",\n+            Self::Invoke => \"oagw.invoke\",\n+            Self::Health => \"oagw.health\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+/// Action enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Action {\n+    Create,\n+    Read,\n+    Update,\n+    Delete,\n+    Execute,\n+}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Create => \"create\",\n+            Self::Read => \"read\",\n+            Self::Update => \"update\",\n+            Self::Delete => \"delete\",\n+            Self::Execute => \"execute\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+/// Register all OAGW REST routes.\n+#[allow(clippy::too_many_lines)] // Route registration is naturally verbose\n+#[allow(clippy::unnecessary_wraps)] // Result needed for error propagation in future\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<Service>,\n+) -> anyhow::Result<Router> {\n+    // === Health Endpoints (public, no auth) ===\n+\n+    // GET /oagw/v1/health - Liveness probe\n+    router = OperationBuilder::get(\"/oagw/v1/health\")\n+        .operation_id(\"oagw.health\")\n+        .summary(\"Liveness probe\")\n+        .description(\"Returns healthy if the service is running\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is healthy\")\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/ready - Readiness probe\n+    router = OperationBuilder::get(\"/oagw/v1/ready\")\n+        .operation_id(\"oagw.ready\")\n+        .summary(\"Readiness probe\")\n+        .description(\"Returns healthy if the service is ready to accept requests\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::ready)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is ready\")\n+        .problem_response(\n+            openapi,\n+            StatusCode::SERVICE_UNAVAILABLE,\n+            \"Service not ready\",\n+        )\n+        .register(router, openapi);\n+\n+    // === Route Endpoints ===\n+\n+    // POST /oagw/v1/routes - Create route\n+    router = OperationBuilder::post(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.create_route\")\n+        .summary(\"Create a new outbound API route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateRouteRequest>(openapi, \"Route configuration\")\n+        .handler(handlers::create_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::CREATED, \"Route created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes - List routes\n+    router = OperationBuilder::get(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.list_routes\")\n+        .summary(\"List outbound API routes\")\n+        .description(\"Returns a paginated list of routes with OData query support\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$orderby\", false, \"OData ordering expression\")\n+        .handler(handlers::list_routes)\n+        .json_response_with_schema::<Page<RouteDto>>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Paginated list of routes\",\n+        )\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId} - Get route\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.get_route\")\n+        .summary(\"Get a route by ID\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::get_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route found\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // PATCH /oagw/v1/routes/{routeId} - Update route\n+    router = OperationBuilder::patch(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.update_route\")\n+        .summary(\"Update a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .json_request::<UpdateRouteRequest>(openapi, \"Route update data\")\n+        .handler(handlers::update_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route updated\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId} - Delete route\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.delete_route\")\n+        .summary(\"Delete a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Delete)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::delete_route)\n+        .json_response(StatusCode::NO_CONTENT, \"Route deleted\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId}/health - Route health (v3)\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}/health\")\n+        .operation_id(\"oagw.route_health\")\n+        .summary(\"Check route health\")\n+        .description(\"Returns health status of a route including circuit breaker states\")\n+        .tag(\"oagw-health\")\n+        .require_auth(&Resource::Health, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::route_health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Route health status\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId}/cache/tokens - Clear token cache (v3)\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}/cache/tokens\")\n+        .operation_id(\"oagw.clear_token_cache\")\n+        .summary(\"Clear cached tokens for a route\")\n+        .description(\"Evicts all cached OAuth tokens associated with this route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::clear_token_cache)\n+        .json_response(StatusCode::NO_CONTENT, \"Token cache cleared\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // === Link Endpoints ===\n+\n+    // POST /oagw/v1/links - Create link\n+    router = OperationBuilder::post(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.create_link\")\n+        .summary(\"Create a new outbound API link\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateLinkRequest>(openapi, \"Link configuration\")\n+        .handler(handlers::create_link)\n+        .json_response_with_schema::<LinkDto>(openapi, StatusCode::CREATED, \"Link created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi) // Route not found\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/links - List links\n+    router = OperationBuilder::get(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.list_links\")\n+        .summary(\"List outbound API links\")\n+        .description(\"Returns a paginated list of links with OData query support\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$orderby\", false, \"OData ordering expression\")\n+        .handler(handlers::list_links)\n+        .json_response_with_schema::<Page<LinkDto>>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Paginated list of links\",\n+        )\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/links/{linkId} - Get link\n+    router = OperationBuilder::get(\"/oagw/v1/links/{linkId}\")\n+        .operation_id(\"oagw.get_link\")\n+        .summary(\"Get a link by ID\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"linkId\", \"Link UUID\")\n+        .handler(handlers::get_link)\n+        .json_response_with_schema::<LinkDto>(openapi, StatusCode::OK, \"Link found\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // PATCH /oagw/v1/links/{linkId} - Update link\n+    router = OperationBuilder::patch(\"/oagw/v1/links/{linkId}\")\n+        .operation_id(\"oagw.update_link\")\n+        .summary(\"Update a link\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"linkId\", \"Link UUID\")\n+        .json_request::<UpdateLinkRequest>(openapi, \"Link update data\")\n+        .handler(handlers::update_link)\n+        .json_response_with_schema::<LinkDto>(openapi, StatusCode::OK, \"Link updated\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/links/{linkId} - Delete link\n+    router = OperationBuilder::delete(\"/oagw/v1/links/{linkId}\")\n+        .operation_id(\"oagw.delete_link\")\n+        .summary(\"Delete a link\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Delete)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"linkId\", \"Link UUID\")\n+        .handler(handlers::delete_link)\n+        .json_response(StatusCode::NO_CONTENT, \"Link deleted\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // === Invocation Endpoint ===\n+\n+    // POST /oagw/v1/invoke - Invoke outbound API\n+    router = OperationBuilder::post(\"/oagw/v1/invoke\")","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think we will have too many hops here. Let's imagine completion call:\nVendor client GET /v1/chat/completions -> API Gateway -> LLM Inference module (?) -> API Gateway -> OAGW -> OAGW Plugin -> real API (OpenAI API for ex.)\n\nIn case of Out Of Process modules the number of hops is increasing.\n\n","created_at":"2025-12-29T20:33:01Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651731556","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651731556"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651731556"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651731556/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":346,"side":"RIGHT","author_association":"MEMBER","original_position":346,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651738773","pull_request_review_id":3616641717,"id":2651738773,"node_id":"PRRC_kwDOPaLyBs6eDlKV","diff_hunk":"@@ -0,0 +1,162 @@\n+//! SeaORM repository implementation for links.\n+\n+use async_trait::async_trait;\n+use modkit_db::secure::SecureConn;\n+use modkit_odata::{ODataQuery, Page, PageInfo};\n+use modkit_security::AccessScope;\n+use oagw_sdk::{Link, LinkPatch, NewLink};\n+use sea_orm::{ActiveValue, ColumnTrait, Condition, Order};\n+use uuid::Uuid;\n+\n+use super::entity::link;\n+use super::mapper::new_link_to_active_model;\n+use crate::domain::repo::LinkRepository;\n+\n+/// SeaORM implementation of LinkRepository.\n+pub struct SeaOrmLinkRepository {\n+    conn: SecureConn,\n+}\n+\n+impl SeaOrmLinkRepository {\n+    /// Create a new repository instance.\n+    pub fn new(conn: SecureConn) -> Self {\n+        Self { conn }\n+    }\n+}\n+\n+#[async_trait]\n+impl LinkRepository for SeaOrmLinkRepository {\n+    async fn find_by_id(&self, scope: &AccessScope, id: Uuid) -> anyhow::Result<Option<Link>> {\n+        let link_opt = self\n+            .conn\n+            .find_by_id::<link::Entity>(scope, id)?\n+            .one(self.conn.conn())\n+            .await?;\n+\n+        Ok(link_opt.map(Link::from))\n+    }\n+\n+    async fn find_enabled_by_route(\n+        &self,\n+        scope: &AccessScope,\n+        route_id: Uuid,\n+    ) -> anyhow::Result<Vec<Link>> {\n+        let base_query = self.conn.find::<link::Entity>(scope);\n+\n+        let filter_cond = Condition::all()\n+            .add(link::Column::RouteId.eq(route_id))\n+            .add(link::Column::Enabled.eq(true));\n+\n+        let links: Vec<link::Model> = base_query\n+            .filter(filter_cond)\n+            .order_by(link::Column::Priority, Order::Asc)\n+            .all(self.conn.conn())\n+            .await?;\n+\n+        Ok(links.into_iter().map(Link::from).collect())\n+    }\n+\n+    async fn list_page(\n+        &self,\n+        scope: &AccessScope,\n+        query: ODataQuery,\n+    ) -> anyhow::Result<Page<Link>> {","path":"modules/oagw/oagw-gw/src/infra/storage/link_repo.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If we want to have pagination here this method is wrong:\n1. Wrong signature. Please check: https://github.com/Artifizer/hyperspot/blob/06cb74af0d049ca1275effdd774700db9fae15b8/examples/modkit/users_info/users_info/src/infra/storage/sea_orm_repo.rs#L190\n\n2. Wrong returning result: https://github.com/Artifizer/hyperspot/blob/06cb74af0d049ca1275effdd774700db9fae15b8/examples/modkit/users_info/users_info/src/infra/storage/sea_orm_repo.rs#L203C7-L214C15\n","created_at":"2025-12-29T20:38:27Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651738773","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651738773"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651738773"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651738773/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":63,"side":"RIGHT","author_association":"MEMBER","original_position":63,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651740224","pull_request_review_id":3616641717,"id":2651740224,"node_id":"PRRC_kwDOPaLyBs6eDlhA","diff_hunk":"","path":"modules/oagw/oagw-gw/src/infra/storage/link_repo.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't understand why do we need this repo. Links are a part of common data model of OAGW. Let's implemnt all these links operations in main repo. ","created_at":"2025-12-29T20:39:40Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651740224","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651740224"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651740224"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651740224/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651751375","pull_request_review_id":3616641717,"id":2651751375,"node_id":"PRRC_kwDOPaLyBs6eDoPP","diff_hunk":"","path":"modules/oagw/oagw-gw/src/infra/storage/entity.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This layout (multiple SeaORM entities defined as submodules in a single file) is technically valid and will work correctly with SeaORM. BUT!\n\n### File organization\n\n* Defining multiple entities in a single file is acceptable, but diverges from the typical SeaORM convention (one entity per file)\n* This may complicate future use of `sea-orm-cli generate entity` and increase merge conflicts as the schema grows\n* Consider splitting entities into separate files if the module expands like:\n   1. The file entities/mod.rs for re-export\n   2. route, link, route_protocol: separate files\n\n### Cross-tenant consistency between `link` and `route`\n\n* `link` stores both `tenant_id` and `route_id`, but there is no DB-level constraint ensuring `link.tenant_id == route.tenant_id`.\n* This invariant must be enforced at the service layer; otherwise, it is possible to create a link referencing a route owned by a different tenant.\n* Recommendation: add explicit validation on create/update paths and cover this with tests.\n\n### Join table primary key design\n\n* `route_protocol` uses a surrogate `id` as the primary key.\n* This allows duplicate `(route_id, protocol_gts_id)` rows unless a unique constraint exists.\n* Recommendation: add a unique constraint on `(route_id, protocol_gts_id)` to preserve logical integrity.\n\n### Use of raw `String` for GTS identifiers\n\n* Fields such as `auth_type_gts_id`, `strategy_gts_id`, and `protocol_gts_id` are modeled as `String`.\n* This weakens type safety and makes misconfiguration possible at runtime.\n* Recommendation: We already have a typed wrapper like `GtsInstanceId`\n\n","created_at":"2025-12-29T20:48:18Z","updated_at":"2025-12-29T20:49:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651751375","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651751375"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651751375"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651751375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817400","pull_request_review_id":3616793131,"id":2651817400,"node_id":"PRRC_kwDOPaLyBs6eD4W4","diff_hunk":"@@ -0,0 +1,299 @@\n+# Module Code Generation Pipeline\n+\n+This document defines a repeatable, **human-controlled** pipeline for generating new modules with LLMs.\n+It is designed to be:\n+\n+- **LLM-actionable** (unambiguous inputs/outputs and prompt templates)\n+- **Human-auditable** (review gates, checklists, clear phase boundaries)\n+- **Project-aligned** (ModKit + DDD-light + SDK pattern, observability, security)\n+\n+## Roles\n+\n+- **Human owner**: decides scope, accepts/declines changes, merges PRs.\n+- **TOP-GRADE LLM**: creates architecture/code skeletons and higher-level reasoning.\n+- **LOW-GRADE LLM**: fixes compilation/lints without changing intended behavior.\n+\n+## Non-negotiable project constraints\n+\n+- Follow:\n+  - `guidelines/NEW_MODULE.md`\n+  - `docs/MODKIT_UNIFIED_SYSTEM.md`\n+  - `docs/TRACING_SETUP.md`\n+- SDK pattern:\n+  - `<module>-sdk` contains **public API** (traits/models/errors; transport-agnostic)\n+  - `<module>` contains **implementation** (domain, infra, REST, local client)\n+- All SDK API methods take `&SecurityCtx`.\n+- REST is wired via ModKit `OperationBuilder` (type-safe routes + OpenAPI).\n+- Always keep `make all` green before moving to the next phase.\n+\n+## Standard artifacts (authoritative filenames)\n+\n+All are under `modules/{module_name}/docs/`:\n+\n+- `1_INTENT_DESIGN.md`\n+- `2_INTENT_FACTS.md`\n+- `3_INTENT_SCENARIOS.md`\n+- `4_ACTUAL_DESIGN.md`\n+- `5_ACTUAL_FACTS.md`\n+- `6_ACTUAL_SCENARIOS.md`\n+- `7_INTENT_VS_ACTUAL.md`\n+\n+\n+## Code generation flow\n+\n+- Follow the 5 phases below separately\n+- Stop after every phase, submit a PR and get approvals from stakeholders\n+\n+| # | Phase | Delivery |\n+| --- | --- | --- |\n+| 1 | Intent design | `1_INTENT_DESIGN.md` |\n+| 2 | Intent facts + scenarios | `2_INTENT_FACTS.md`, `3_INTENT_SCENARIOS.md` |\n+| 3 | Code for v1 scenarios | all the needed modules code, compilable, v2+ code stubs, actual design `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` |\n+| 4 | Tests for v1 scenarios | all the needed modules tests, compilable, v2+ code stubs |\n+\n+For v2+ - repeat 3,4 above, actualize the code, tests, `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` after each phase.\n+\n+## Phase 1: Intent design\n+\n+Phase 1 outcome:\n+- `1_INTENT_DESIGN.md` - generated, cross-reviewed by models, reviewed by humans, committed\n+\n+### 1.1 - Prepare environment\n+\n+1. Install needed tools (e.g. Windsurf, Cursor, Github Copilot)\n+2. Pick model tiers for this project.\n+   - TOP-GRADE example: Claude Opus 4.5, GPT 5.2\n+   - LOW-GRADE example: SWE-1.5, Codex\n+\n+### 1.2 - Scaffold module layout\n+\n+1. Create module folder: `modules/{module_name}/`\n+2. Create docs folder: `modules/{module_name}/docs/`\n+3. Ensure you follow the canonical layout and SDK pattern from `guidelines/NEW_MODULE.md`.\n+\n+### 1.3 - Write intent design (`1_INTENT_DESIGN.md`)\n+\n+Use your favorite SDD (e.g. openspec-proposal) to generate `1_INTENT_DESIGN.md`.\n+\n+Prompt (for TOP-GRADE models):\n+\n+```\n+Create `modules/{module_name}/docs/1_INTENT_DESIGN.md`.\n+\n+Input: my description of the module purpose + use cases.\n+\n+Must follow:\n+- guidelines/NEW_MODULE.md\n+- docs/MODKIT_UNIFIED_SYSTEM.md\n+\n+Output must include:\n+- Module category (generic/gateway/worker)\n+- Public API surface (SDK trait methods)\n+- Data model overview\n+- Persistence needs\n+- Security/tenancy assumptions (SecurityCtx usage)\n+- Observability plan (tracing + logs)\n+- GTS schema and instances definitions\n+```\n+\n+### 1.4 - Pre-PR self-review\n+\n+- Review the scope and missing invariants.\n+- Review by other independent cloud models **ChatGPT**, **Gemini** and **Claude**\n+\n+```\n+Review my 1_INTENT_DESIGN.md, criticize it, identify clear gaps regarding the industry","path":"guidelines/CODE_GEN_PIPELINE.md","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, this is a conceptual placeholder that will be refined later; however modern models already handle such loosely defined tasks quite well.","created_at":"2025-12-29T21:38:07Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651817400","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817400"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651817400"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817400/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":105,"side":"RIGHT","in_reply_to_id":2650844727,"author_association":"MEMBER","original_position":105,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817827","pull_request_review_id":3616793131,"id":2651817827,"node_id":"PRRC_kwDOPaLyBs6eD4dj","diff_hunk":"@@ -0,0 +1,299 @@\n+# Module Code Generation Pipeline\n+\n+This document defines a repeatable, **human-controlled** pipeline for generating new modules with LLMs.\n+It is designed to be:\n+\n+- **LLM-actionable** (unambiguous inputs/outputs and prompt templates)\n+- **Human-auditable** (review gates, checklists, clear phase boundaries)\n+- **Project-aligned** (ModKit + DDD-light + SDK pattern, observability, security)\n+\n+## Roles\n+\n+- **Human owner**: decides scope, accepts/declines changes, merges PRs.\n+- **TOP-GRADE LLM**: creates architecture/code skeletons and higher-level reasoning.\n+- **LOW-GRADE LLM**: fixes compilation/lints without changing intended behavior.\n+\n+## Non-negotiable project constraints\n+\n+- Follow:\n+  - `guidelines/NEW_MODULE.md`\n+  - `docs/MODKIT_UNIFIED_SYSTEM.md`\n+  - `docs/TRACING_SETUP.md`\n+- SDK pattern:\n+  - `<module>-sdk` contains **public API** (traits/models/errors; transport-agnostic)\n+  - `<module>` contains **implementation** (domain, infra, REST, local client)\n+- All SDK API methods take `&SecurityCtx`.\n+- REST is wired via ModKit `OperationBuilder` (type-safe routes + OpenAPI).\n+- Always keep `make all` green before moving to the next phase.\n+\n+## Standard artifacts (authoritative filenames)\n+\n+All are under `modules/{module_name}/docs/`:\n+\n+- `1_INTENT_DESIGN.md`\n+- `2_INTENT_FACTS.md`\n+- `3_INTENT_SCENARIOS.md`\n+- `4_ACTUAL_DESIGN.md`\n+- `5_ACTUAL_FACTS.md`\n+- `6_ACTUAL_SCENARIOS.md`\n+- `7_INTENT_VS_ACTUAL.md`\n+\n+\n+## Code generation flow\n+\n+- Follow the 5 phases below separately\n+- Stop after every phase, submit a PR and get approvals from stakeholders\n+\n+| # | Phase | Delivery |\n+| --- | --- | --- |\n+| 1 | Intent design | `1_INTENT_DESIGN.md` |\n+| 2 | Intent facts + scenarios | `2_INTENT_FACTS.md`, `3_INTENT_SCENARIOS.md` |\n+| 3 | Code for v1 scenarios | all the needed modules code, compilable, v2+ code stubs, actual design `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` |\n+| 4 | Tests for v1 scenarios | all the needed modules tests, compilable, v2+ code stubs |\n+\n+For v2+ - repeat 3,4 above, actualize the code, tests, `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` after each phase.\n+\n+## Phase 1: Intent design\n+\n+Phase 1 outcome:\n+- `1_INTENT_DESIGN.md` - generated, cross-reviewed by models, reviewed by humans, committed\n+\n+### 1.1 - Prepare environment\n+\n+1. Install needed tools (e.g. Windsurf, Cursor, Github Copilot)\n+2. Pick model tiers for this project.\n+   - TOP-GRADE example: Claude Opus 4.5, GPT 5.2\n+   - LOW-GRADE example: SWE-1.5, Codex\n+\n+### 1.2 - Scaffold module layout\n+\n+1. Create module folder: `modules/{module_name}/`\n+2. Create docs folder: `modules/{module_name}/docs/`\n+3. Ensure you follow the canonical layout and SDK pattern from `guidelines/NEW_MODULE.md`.\n+\n+### 1.3 - Write intent design (`1_INTENT_DESIGN.md`)\n+\n+Use your favorite SDD (e.g. openspec-proposal) to generate `1_INTENT_DESIGN.md`.\n+\n+Prompt (for TOP-GRADE models):\n+\n+```\n+Create `modules/{module_name}/docs/1_INTENT_DESIGN.md`.\n+\n+Input: my description of the module purpose + use cases.\n+\n+Must follow:\n+- guidelines/NEW_MODULE.md\n+- docs/MODKIT_UNIFIED_SYSTEM.md\n+\n+Output must include:\n+- Module category (generic/gateway/worker)\n+- Public API surface (SDK trait methods)\n+- Data model overview\n+- Persistence needs\n+- Security/tenancy assumptions (SecurityCtx usage)\n+- Observability plan (tracing + logs)\n+- GTS schema and instances definitions\n+```\n+\n+### 1.4 - Pre-PR self-review\n+\n+- Review the scope and missing invariants.\n+- Review by other independent cloud models **ChatGPT**, **Gemini** and **Claude**\n+\n+```\n+Review my 1_INTENT_DESIGN.md, criticize it, identify clear gaps regarding the industry\n+practices, suggest recommendations, write a summary of the review.\n+```\n+\n+### 1.5 - Submit PR\n+\n+- Submit a PR, get approvals from stakeholder and commit `1_INTENT_DESIGN.md`.\n+\n+\n+## Phase 2: Derive facts + scenarios\n+\n+Phase 2 outcome:\n+- `2_INTENT_FACTS.md` - generated, cross-reviewed by models, reviewed by humans, committed\n+- `3_INTENT_SCENARIOS.md` - generated, cross-reviewed by models, reviewed by humans, committed\n+\n+### 2.1 - Prepare facts and scenarios\n+\n+Prompt (for TOP-GRADE models):\n+\n+```\n+/openspec-proposal\n+\n+Read: modules/{module_name}/docs/1_INTENT_DESIGN.md\n+\n+Generate:\n+- modules/{module_name}/docs/2_INTENT_FACTS.md - commonly used facts across scenarios\n+- modules/{module_name}/docs/3_INTENT_SCENARIOS.md - individual module scenarios - API, jobs if any, etc.\n+\n+Rules:\n+- Facts must follow `FACTS_TAXONOMY.md`, you can use existing IDs or create new ones.","path":"guidelines/CODE_GEN_PIPELINE.md","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"No, it needs to be added","created_at":"2025-12-29T21:38:24Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651817827","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817827"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651817827"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651817827/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":134,"side":"RIGHT","in_reply_to_id":2649895852,"author_association":"MEMBER","original_position":134,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651821549","pull_request_review_id":3616793131,"id":2651821549,"node_id":"PRRC_kwDOPaLyBs6eD5Xt","diff_hunk":"@@ -0,0 +1,340 @@\n+//! REST DTOs for OAGW.\n+//!\n+//! These DTOs have serde and utoipa derives for REST serialization.\n+\n+use chrono::{DateTime, Utc};\n+use oagw_sdk::{\n+    HttpMethod, Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse,\n+    RetryIntent, Route, RoutePatch,\n+};\n+use serde::{Deserialize, Serialize};\n+use std::collections::HashMap;\n+use utoipa::ToSchema;\n+use uuid::Uuid;\n+\n+// === Route DTOs ===\n+\n+/// Response DTO for a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct RouteDto {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub base_url: String,\n+    pub rate_limit_req_per_min: i32,\n+    pub auth_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub cache_ttl_sec: Option<i32>,\n+    pub supported_protocols: Vec<String>,\n+    pub created_at: DateTime<Utc>,\n+    pub updated_at: DateTime<Utc>,\n+}\n+\n+impl From<Route> for RouteDto {\n+    fn from(route: Route) -> Self {\n+        Self {\n+            id: route.id,\n+            tenant_id: route.tenant_id,\n+            base_url: route.base_url,\n+            rate_limit_req_per_min: route.rate_limit_req_per_min,\n+            auth_type_gts_id: route.auth_type_gts_id,\n+            cache_ttl_sec: route.cache_ttl_sec,\n+            supported_protocols: route.supported_protocols,\n+            created_at: route.created_at,\n+            updated_at: route.updated_at,\n+        }\n+    }\n+}\n+\n+/// Request DTO for creating a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct CreateRouteRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub id: Option<Uuid>,\n+    pub base_url: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub rate_limit_req_per_min: Option<i32>,\n+    pub auth_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub cache_ttl_sec: Option<i32>,\n+    #[serde(default)]\n+    pub supported_protocols: Vec<String>,\n+}\n+\n+impl CreateRouteRequest {\n+    /// Convert to domain model with tenant ID from security context.\n+    pub fn into_new_route(self, tenant_id: Uuid) -> NewRoute {\n+        NewRoute {\n+            id: self.id,\n+            tenant_id,\n+            base_url: self.base_url,\n+            rate_limit_req_per_min: self.rate_limit_req_per_min,\n+            auth_type_gts_id: self.auth_type_gts_id,\n+            cache_ttl_sec: self.cache_ttl_sec,\n+            supported_protocols: self.supported_protocols,\n+        }\n+    }\n+}\n+\n+/// Request DTO for updating a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct UpdateRouteRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub base_url: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub rate_limit_req_per_min: Option<i32>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub auth_type_gts_id: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    #[allow(clippy::option_option)] // Intentional: distinguish set-to-null from not-set\n+    pub cache_ttl_sec: Option<Option<i32>>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub supported_protocols: Option<Vec<String>>,\n+}\n+\n+impl From<UpdateRouteRequest> for RoutePatch {\n+    fn from(req: UpdateRouteRequest) -> Self {\n+        Self {\n+            base_url: req.base_url,\n+            rate_limit_req_per_min: req.rate_limit_req_per_min,\n+            auth_type_gts_id: req.auth_type_gts_id,\n+            cache_ttl_sec: req.cache_ttl_sec,\n+            supported_protocols: req.supported_protocols,\n+        }\n+    }\n+}\n+\n+// === Link DTOs ===\n+\n+/// Response DTO for a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct LinkDto {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub secret_ref: Uuid,\n+    pub route_id: Uuid,\n+    pub secret_type_gts_id: String,\n+    pub enabled: bool,\n+    pub priority: i32,\n+    pub strategy_gts_id: String,\n+    pub created_at: DateTime<Utc>,\n+    pub updated_at: DateTime<Utc>,\n+}\n+\n+impl From<Link> for LinkDto {\n+    fn from(link: Link) -> Self {\n+        Self {\n+            id: link.id,\n+            tenant_id: link.tenant_id,\n+            secret_ref: link.secret_ref,\n+            route_id: link.route_id,\n+            secret_type_gts_id: link.secret_type_gts_id,\n+            enabled: link.enabled,\n+            priority: link.priority,\n+            strategy_gts_id: link.strategy_gts_id,\n+            created_at: link.created_at,\n+            updated_at: link.updated_at,\n+        }\n+    }\n+}\n+\n+/// Request DTO for creating a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct CreateLinkRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub id: Option<Uuid>,\n+    pub secret_ref: Uuid,\n+    pub route_id: Uuid,\n+    pub secret_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub enabled: Option<bool>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub priority: Option<i32>,\n+    pub strategy_gts_id: String,\n+}\n+\n+impl CreateLinkRequest {\n+    /// Convert to domain model with tenant ID from security context.\n+    pub fn into_new_link(self, tenant_id: Uuid) -> NewLink {\n+        NewLink {\n+            id: self.id,\n+            tenant_id,\n+            secret_ref: self.secret_ref,\n+            route_id: self.route_id,\n+            secret_type_gts_id: self.secret_type_gts_id,\n+            enabled: self.enabled,\n+            priority: self.priority,\n+            strategy_gts_id: self.strategy_gts_id,\n+        }\n+    }\n+}\n+\n+/// Request DTO for updating a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct UpdateLinkRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub secret_ref: Option<Uuid>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub secret_type_gts_id: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub enabled: Option<bool>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub priority: Option<i32>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub strategy_gts_id: Option<String>,\n+}\n+\n+impl From<UpdateLinkRequest> for LinkPatch {\n+    fn from(req: UpdateLinkRequest) -> Self {\n+        Self {\n+            secret_ref: req.secret_ref,\n+            secret_type_gts_id: req.secret_type_gts_id,\n+            enabled: req.enabled,\n+            priority: req.priority,\n+            strategy_gts_id: req.strategy_gts_id,\n+        }\n+    }\n+}\n+\n+// === Invocation DTOs ===\n+\n+/// HTTP method for invocation requests.\n+#[derive(Debug, Clone, Copy, Serialize, Deserialize, ToSchema, PartialEq, Eq)]\n+#[serde(rename_all = \"UPPERCASE\")]\n+pub enum HttpMethodDto {","path":"modules/oagw/oagw-gw/src/api/rest/dto.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe it's because Dto must be a part of contract and dependency agnostic","created_at":"2025-12-29T21:41:32Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651821549","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651821549"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651821549"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651821549/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":209,"side":"RIGHT","in_reply_to_id":2650865676,"author_association":"MEMBER","original_position":209,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651829627","pull_request_review_id":3616793131,"id":2651829627,"node_id":"PRRC_kwDOPaLyBs6eD7V7","diff_hunk":"@@ -0,0 +1,145 @@\n+//! REST error mapping for OAGW.\n+\n+use http::StatusCode;\n+use modkit::api::problem::Problem;\n+\n+use crate::domain::error::DomainError;\n+\n+/// Convert DomainError to Problem for REST responses.\n+impl From<DomainError> for Problem {","path":"modules/oagw/oagw-gw/src/api/rest/error.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@MikeFalcon77 what do you think?","created_at":"2025-12-29T21:48:17Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651829627","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651829627"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651829627"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651829627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":9,"side":"RIGHT","in_reply_to_id":2650870336,"author_association":"MEMBER","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651830459","pull_request_review_id":3616793131,"id":2651830459,"node_id":"PRRC_kwDOPaLyBs6eD7i7","diff_hunk":"@@ -0,0 +1,223 @@\n+//! REST handlers for OAGW.\n+//!\n+//! Handlers are thin: parse/validate input, call domain service, map errors to Problem.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::{Extension, Path};\n+use axum::http::Uri;\n+use axum::Json;\n+use modkit::api::odata::OData;\n+use modkit::api::prelude::*;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use crate::domain::service::Service;\n+\n+// === Health Endpoints ===\n+\n+/// GET /oagw/v1/health - Liveness probe (no auth required).\n+pub async fn health() -> ApiResult<JsonBody<HealthResponse>> {\n+    Ok(Json(HealthResponse::default()))\n+}\n+\n+/// GET /oagw/v1/ready - Readiness probe (no auth required).\n+///\n+/// TODO(v2): Check database connectivity and other critical dependencies.\n+pub async fn ready() -> ApiResult<JsonBody<HealthResponse>> {\n+    // TODO(v2): Implement actual readiness checks\n+    Ok(Json(HealthResponse::default()))\n+}\n+\n+// === Route Endpoints ===\n+\n+/// POST /oagw/v1/routes - Create a new route.\n+#[tracing::instrument(skip(ctx, svc, req), fields(base_url = %req.base_url))]\n+pub async fn create_route(\n+    uri: Uri,\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(svc): Extension<Arc<Service>>,\n+    Json(req): Json<CreateRouteRequest>,\n+) -> ApiResult<impl axum::response::IntoResponse> {\n+    let tenant_id = ctx.tenant_id();\n+    let new_route = req.into_new_route(tenant_id);\n+\n+    let route = svc.create_route(&ctx, new_route).await?;\n+    let id_str = route.id.to_string();\n+\n+    Ok(created_json(RouteDto::from(route), &uri, &id_str))\n+}\n+\n+/// GET /oagw/v1/routes - List routes with OData pagination.\n+#[tracing::instrument(skip(ctx, svc))]\n+pub async fn list_routes(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(svc): Extension<Arc<Service>>,\n+    OData(query): OData,","path":"modules/oagw/oagw-gw/src/api/rest/handlers.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, in the future versions","created_at":"2025-12-29T21:48:56Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651830459","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651830459"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651830459"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651830459/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":60,"side":"RIGHT","in_reply_to_id":2650876056,"author_association":"MEMBER","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651838950","pull_request_review_id":3616793131,"id":2651838950,"node_id":"PRRC_kwDOPaLyBs6eD9nm","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Routes => \"oagw.routes\",\n+            Self::Links => \"oagw.links\",\n+            Self::Invoke => \"oagw.invoke\",\n+            Self::Health => \"oagw.health\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+/// Action enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Action {\n+    Create,\n+    Read,\n+    Update,\n+    Delete,\n+    Execute,\n+}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Create => \"create\",\n+            Self::Read => \"read\",\n+            Self::Update => \"update\",\n+            Self::Delete => \"delete\",\n+            Self::Execute => \"execute\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+/// Register all OAGW REST routes.\n+#[allow(clippy::too_many_lines)] // Route registration is naturally verbose\n+#[allow(clippy::unnecessary_wraps)] // Result needed for error propagation in future\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<Service>,\n+) -> anyhow::Result<Router> {\n+    // === Health Endpoints (public, no auth) ===\n+\n+    // GET /oagw/v1/health - Liveness probe\n+    router = OperationBuilder::get(\"/oagw/v1/health\")\n+        .operation_id(\"oagw.health\")\n+        .summary(\"Liveness probe\")\n+        .description(\"Returns healthy if the service is running\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is healthy\")\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/ready - Readiness probe","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In Kubernetes, readiness and liveness (“health”) probes serve different, very intentional purposes. Mixing them up causes real production issues, so this distinction matters.\n\nReadiness: Can the pod handle traffic right now?\nIf it fails, Kubernetes stops sending traffic but does not restart the pod. This code will be implemented in v2 as it's mentioned in the \"handlers::ready\" handler comments\n\nLiveness (health): Is the pod still alive?\nIf it fails, Kubernetes restarts the pod.\n\nSo we can use readiness for temporary or external issues; use liveness only when the process is broken and needs a restart.","created_at":"2025-12-29T21:56:27Z","updated_at":"2025-12-29T22:04:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651838950","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651838950"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2651838950"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2651838950/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":96,"side":"RIGHT","in_reply_to_id":2650884736,"author_association":"MEMBER","original_position":96,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655329839","pull_request_review_id":3620813224,"id":2655329839,"node_id":"PRRC_kwDOPaLyBs6eRR4v","diff_hunk":"@@ -0,0 +1,470 @@\n+//! Domain service for OAGW.\n+//!\n+//! This service orchestrates all business logic for outbound API invocations,\n+//! route/link management, and plugin selection.\n+\n+use std::sync::Arc;\n+\n+use modkit::client_hub::ClientHub;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::{AccessScope, PolicyEngineRef, SecurityContext};\n+use oagw_sdk::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwPluginApi,\n+    OagwResponseStream, Route, RoutePatch,\n+};\n+use tracing::{info_span, instrument, Instrument};\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+use super::ports::SecretResolver;\n+use super::repo::{LinkRepository, RouteRepository};\n+use crate::config::OagwConfig;\n+\n+/// Service configuration extracted from module config.\n+#[derive(Debug, Clone)]\n+pub struct ServiceConfig {\n+    /// Default connection timeout in milliseconds.\n+    pub default_connection_timeout_ms: u64,\n+    /// Default request timeout in milliseconds.\n+    pub default_request_timeout_ms: u64,\n+}\n+\n+impl From<&OagwConfig> for ServiceConfig {\n+    fn from(cfg: &OagwConfig) -> Self {\n+        Self {\n+            default_connection_timeout_ms: cfg.default_connection_timeout_ms,\n+            default_request_timeout_ms: cfg.default_request_timeout_ms,\n+        }\n+    }\n+}\n+\n+/// Domain service for OAGW operations.\n+pub struct Service {\n+    policy_engine: PolicyEngineRef,\n+    route_repo: Arc<dyn RouteRepository>,\n+    link_repo: Arc<dyn LinkRepository>,\n+    secret_resolver: Arc<dyn SecretResolver>,\n+    client_hub: Arc<ClientHub>,","path":"modules/oagw/oagw-gw/src/domain/service.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, good catch. We should not inject ClientHub into domain/services.\r\n\r\nThe service should be assembled from explicit dependencies (ports), e.g. API client traits, repositories, publishers.\r\n\r\nClientHub is fine as an infrastructure-level registry, but it must be used only during wiring/composition (module init/runtime bootstrap) to resolve those ports and pass them into the service.\r\n\r\nIf we want stricter DDD, we can formalize ports in the domain layer and implement thin adapters in the infra layer that delegate to the actual API clients (local or gRPC). But I think it's too much for most our cases.","created_at":"2025-12-31T12:25:10Z","updated_at":"2025-12-31T12:25:10Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2655329839","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655329839"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2655329839"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2655329839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":47,"side":"RIGHT","in_reply_to_id":2650907075,"author_association":"MEMBER","original_position":47,"position":1,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":163,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/163","source_state":"closed","source_author":"MikeFalcon77","target_issue_number":null,"title":"[PR #163]  refactor(plugin-modules):: correct OpenAPI schema and simplify plugi…","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"refactor/thr_sample_refactor","pr_head_sha":"1f6d8d7859510b4affac5e48d6783f15c50455c1","pr_base_ref":"main","pr_head_owner":"MikeFalcon77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/163","id":3131685357,"node_id":"PR_kwDOPaLyBs66qbnt","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/163","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/163.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/163.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/163","number":163,"state":"closed","locked":false,"title":" refactor(plugin-modules):: correct OpenAPI schema and simplify plugi…","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","receiv
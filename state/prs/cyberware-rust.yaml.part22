lse,"forks_count":19,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":263,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["account-management","agentic-ai","ai","benchmarks","cloud","genai","llm","microservices","middleware","modkit","multi-tenancy","multi-tier","rust","saas","security","serverless","xaas"],"visibility":"private","forks":19,"open_issues":263,"watchers":32,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/19"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/19"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/19/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/19/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/f255e1058d986789261f58f6ea900002434d81e3"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":18,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/18","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #18] feat: add JSON-driven error catalog with compile-time validation","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"refactor/ergo_and_docs","pr_head_sha":"805418661f8202a5739a130cc2ff6b9a177421e2","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/18","id":2872565904,"node_id":"PR_kwDOPaLyBs6rN-CQ","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/18","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/18.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/18.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/18","number":18,"state":"closed","locked":false,"title":"feat: add JSON-driven error catalog with compile-time validation","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Implement a type-safe error catalog system that reads error definitions from JSON at compile time and generates strongly-typed error handling code.\r\n\r\n## New Error Catalog System\r\n\r\n### Core Infrastructure\r\n- Add modkit-errors: Runtime helpers for catalog-driven Problem building\r\n  - ErrDef struct for static error definitions\r\n  - \to_problem() method to build Problems from catalog entries\r\n\r\n- Add modkit-errors-macro: Proc-macro for compile-time code generation\r\n  - declare_errors! macro reads JSON and generates error artifacts\r\n  - Validates error codes, statuses, and titles at compile time\r\n  - Auto-generates type URLs (https://errors.example.com/<code>)\r\n  - Ensures Cargo rebuilds when JSON changes via include_str!\r\n\r\n### Integration in users_info Module\r\n- Add gts/errors.json with 8 error definitions\r\n- Normalize validation errors to 422 status (invalid_email stays 400)\r\n- Migrate error mapping to use catalog via ErrorCode::to_response()\r\n- Remove hardcoded error codes, titles, and status values\r\n\r\n## Additional ModKit Improvements (https://github.com/hypernetix/hyperspot/issues/15)\r\n\r\n### Error Handling\r\n- Refactor error_layer to manually attach instance/trace_id\r\n- Remove finalize helpers in favor of direct builder pattern\r\n- Improve Problem API with builder methods\r\n\r\n### API & Runtime\r\n- Enhance operation_builder with additional features\r\n- Add runtime tests module with comprehensive test coverage\r\n- Add capability suggestion for unknown macro capabilities","created_at":"2025-09-30T01:24:47Z","updated_at":"2025-10-06T20:51:43Z","closed_at":"2025-10-06T20:51:43Z","merged_at":"2025-10-06T20:51:43Z","merge_commit_sha":"d50f92809615f41158afd5958cd063188e0561cf","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/18/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/18/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/18/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/st
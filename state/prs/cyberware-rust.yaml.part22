yBs6aBlq7","diff_hunk":"@@ -0,0 +1,154 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use crate::domain::error::DomainError;\n+use crate::domain::node_storage::NodeStorage;\n+use modkit_node_info::NodeInfoCollector;\n+use std::sync::Arc;\n+\n+/// Service for managing nodes and their metadata\n+#[derive(Clone)]\n+pub struct Service {\n+    storage: Arc<NodeStorage>,\n+    node_info_collector: Arc<NodeInfoCollector>,\n+}\n+\n+impl Service {\n+    pub fn new() -> Self {\n+        let node_info_collector = Arc::new(NodeInfoCollector::new());\n+        let current_node = node_info_collector.create_current_node();\n+        let storage = Arc::new(NodeStorage::new());\n+\n+        // Check if hardware detection failed (hybrid UUID with zeros on left)\n+        let uuid_bytes = current_node.id.as_bytes();\n+        let is_fallback = uuid_bytes[0..8].iter().all(|&b| b == 0);","path":"modules/nodes_registry/src/domain/service.rs","commit_id":"b7df5ffb8af41ec58ae082492f44b11b8d7629ba","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"would you please make it in a PR?","created_at":"2025-12-03T08:28:54Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584107707","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584107707"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584107707"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584107707/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","in_reply_to_id":2581392981,"author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584314121","pull_request_review_id":3531689941,"id":2584314121,"node_id":"PRRC_kwDOPaLyBs6aCYEJ","diff_hunk":"@@ -0,0 +1,154 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use crate::domain::error::DomainError;\n+use crate::domain::node_storage::NodeStorage;\n+use modkit_node_info::NodeInfoCollector;\n+use std::sync::Arc;\n+\n+/// Service for managing nodes and their metadata\n+#[derive(Clone)]\n+pub struct Service {\n+    storage: Arc<NodeStorage>,\n+    node_info_collector: Arc<NodeInfoCollector>,\n+}\n+\n+impl Service {\n+    pub fn new() -> Self {\n+        let node_info_collector = Arc::new(NodeInfoCollector::new());\n+        let current_node = node_info_collector.create_current_node();\n+        let storage = Arc::new(NodeStorage::new());\n+\n+        // Check if hardware detection failed (hybrid UUID with zeros on left)\n+        let uuid_bytes = current_node.id.as_bytes();\n+        let is_fallback = uuid_bytes[0..8].iter().all(|&b| b == 0);\n+\n+        if is_fallback {\n+            tracing::warn!(\n+                node_id = %current_node.id,\n+                \"Hardware UUID detection failed, using fallback UUID (00000000-0000-0000-xxxx-xxxxxxxxxxxx)\"\n+            );\n+        } else {\n+            tracing::info!(\n+                node_id = %current_node.id,\n+                hostname = %current_node.hostname,\n+                ip_address = ?current_node.ip_address,\n+                \"Initialized node with hardware-based UUID\"\n+            );\n+        }\n+\n+        storage.upsert_node(current_node);\n+\n+        Self {\n+            storage,\n+            node_info_collector,\n+        }\n+    }\n+\n+    /// Get a node by ID\n+    pub async fn get_node(&self, id: uuid::Uuid) -> Result<Node, DomainError> {\n+        self.storage\n+            .get_node(id)\n+            .ok_or(DomainError::NodeNotFound(id))\n+    }\n+\n+    /// List all nodes\n+    pub async fn list_nodes(&self) -> Result<Vec<Node>, DomainError> {\n+        Ok(self.storage.list_nodes())\n+    }\n+\n+    /// Get system information for a node (with caching)\n+    pub async fn get_node_sysinfo(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, DomainError> {\n+        // Check if node exists\n+        if self.storage.get_node(node_id).is_none() {\n+            return Err(DomainError::NodeNotFound(node_id));\n+        }\n+\n+        // Try to get cached sysinfo\n+        if let Some(cached) = self.storage.get_sysinfo(node_id) {\n+            return Ok(cached);\n+        }\n+\n+        // Collect fresh sysinfo\n+        let sysinfo = self\n+            .node_info_collector\n+            .collect_sysinfo(node_id)\n+            .map_err(|e| DomainError::SysInfoCollectionFailed(e.to_string()))?;","path":"modules/nodes_registry/src/domain/service.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id"
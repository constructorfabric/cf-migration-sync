DtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"# Production Changes\r\n## Database Transaction API change\r\n- Changed transaction closure signatures in DbHandle:\r\nwith_pg_tx(), with_mysql_tx(), and with_sqlite_tx() \r\n- Removed separate Fut generic parameter, using for<'a> lifetime bounds instead\r\n\r\n## OData Value Display Implementation\r\n\r\nAdded Display trait for modkit_odata::ast::Value\r\nEnables string representation of OData values for debugging and logging\r\nSupports all value types (Null, Bool, Number, String, etc.)\r\n\r\n# Test changes\r\n\r\n## Test Module Organization\r\n\r\n- Restructured test modules in modkit-db/src/odata/:\r\n- Disabled tests are rewritten\r\n- Moved tests from monolithic tests.rs to organized module structure\r\n- Sqlite in-memory tests are used for less brittle tests\r\n\r\n## CodeCov report improvement\r\nmodkit-db coverage: from 60% to 81%\r\noverall coverage: from 67% to 70%\r\n\r\nhttps://app.codecov.io/github/hypernetix/hyperspot/commit/9966c7a415f892c305546b8da9bf28da23cae059/tree/libs?dropdown=coverage","created_at":"2025-12-28T21:11:09Z","updated_at":"2026-01-05T19:31:34Z","closed_at":"2026-01-05T19:31:34Z","merged_at":"2026-01-05T19:31:34Z","merge_commit_sha":"838126f0b13355315efc738dcfe54a65a83bb251","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/168/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/168/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/168/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/b48b3d11d8b12a81a3d1effe7d3b8fae60805021","head":{"label":"hyphen-2025:improve_tests","ref":"improve_tests","sha":"b48b3d11d8b12a81a3d1effe7d3b8fae60805021","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1112608981,"node_id":"R_kgDOQlEQ1Q","name":"hyperspot","full_name":"hyphen-2025/hyperspot","private":false,"owner":{"login":"hyphen-2025","id":
\n+    fn parse(pattern: &str) -> Self {","path":"libs/modkit-auth/src/authorizer.rs","commit_id":"f2a6230b0e377f3f85cc7d8f333efd8838a7e2ee","original_commit_id":"f2a6230b0e377f3f85cc7d8f333efd8838a7e2ee","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"https://doc.rust-lang.org/std/str/trait.FromStr.html\r\nYou need to implement the FromStr trait, that implicit includes the parse and the from_str methods to do automatic conversions","created_at":"2025-12-17T10:04:15Z","updated_at":"2025-12-17T10:18:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/126#discussion_r2626396213","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/126","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626396213"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/126#discussion_r2626396213"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/126"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626396213/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":17,"side":"RIGHT","author_association":"MEMBER","original_position":33,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626433390","pull_request_review_id":3586950115,"id":2626433390,"node_id":"PRRC_kwDOPaLyBs6cjDFu","diff_hunk":"@@ -120,6 +120,14 @@ pub struct ParamSpec {\n     pub param_type: String, // JSON Schema type (string, integer, etc.)\n }\n \n+pub trait RbacResource {","path":"libs/modkit/src/api/operation_builder.rs","commit_id":"f2a6230b0e377f3f85cc7d8f333efd8838a7e2ee","original_commit_id":"f2a6230b0e377f3f85cc7d8f333efd8838a7e2ee","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`RbacAction` and `RbacResource` are re-implementing https://doc.rust-lang.org/std/convert/trait.AsRef.html\r\nThe correct approach would be:\r\n\r\n```rust\r\nuse std::convert::AsRef;\r\n\r\npub trait RbacResource: AsRef<str> {}\r\n\r\npub trait RbacAction: AsRef<str> {}\r\n\r\nenum Resource {\r\n    Users,\r\n}\r\n\r\nenum Action {\r\n    Read,\r\n    Delete,\r\n    Update,\r\n    Create,\r\n}\r\n\r\nimpl AsRef<str> for Resource {\r\n    fn as_ref(&self) -> &'static str {\r\n        match self {\r\n            Resource::Users => \"users\",\r\n        }\r\n    }\r\n}\r\n\r\nimpl AsRef<str> for Action {\r\n    fn as_ref(&self) -> &'static str {\r\n        match self {\r\n            Action::Read => \"read\",\r\n            Action::Delete => \"delete\",\r\n            Action::Update => \"update\",\r\n            Action::Create => \"create\",\r\n        }\r\n    }\r\n}\r\n\r\nimpl RbacResource for Resource {}\r\nimpl RbacAction for Action {}\r\n```","created_at":"2025-12-17T10:15:30Z","updated_at":"2025-12-17T10:18:17Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/126#discussion_r2626433390","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/126","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626433390"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/126#discussion_r2626433390"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/126"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626433390/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":123,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2626451219","pull_request_review_id":3587012956,"id":2626451219,"node_id":"PRRC_kwDOPaLyBs6cjHcT","diff_hunk":"@@ -120,6 +120,14 @@ pub struct ParamSpec {\n     pub param_type: String, // JSON Schema type (string, integer, etc.)\n }\n \n+pub trait RbacResource {","path":"libs/modkit/src/api/operati
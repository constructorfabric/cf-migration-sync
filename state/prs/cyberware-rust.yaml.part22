contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]}},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3821233479","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/142#issuecomment-3821233479","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/142","id":3821233479,"node_id":"IC_kwDOPaLyBs7jw2VH","user":{"login":"hitengajjar","id":17683811,"node_id":"MDQ6VXNlcjE3NjgzODEx","avatar_url":"https://avatars.githubusercontent.com/u/17683811?v=4","gravatar_id":"","url":"https://api.github.com/users/hitengajjar","html_url":"https://github.com/hitengajjar","followers_url":"https://api.github.com/users/hitengajjar/followers","following_url":"https://api.github.com/users/hitengajjar/following{/other_user}","gists_url":"https://api.github.com/users/hitengajjar/gists{/gist_id}","starred_url":"https://api.github.com/users/hitengajjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hitengajjar/subscriptions","organizations_url":"https://api.github.com/users/hitengajjar/orgs","repos_url":"https://api.github.com/users/hitengajjar/repos","events_url":"https://api.github.com/users/hitengajjar/events{/privacy}","received_events_url":"https://api.github.com/users/hitengajjar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-30T01:11:24Z","updated_at":"2026-01-30T01:11:24Z","body":"We are moving to FDD and won't rely on OpenSpec, hence no need for this PR.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/comments/3821233479/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471433","pull_request_review_id":3714191006,"id":2734471433,"node_id":"PRRC_kwDOPaLyBs6i_LkJ","diff_hunk":"@@ -0,0 +1,122 @@\n+# [OpenSpec](https://github.com/Fission-AI/OpenSpec) Guideline for Hyperspot\n+\n+This guide provides the standard process for AI-driven development in the Hyperspot mono-repo using [OpenSpec](https://github.com/Fission-AI/OpenSpec). It is designed to enable parallel development across multiple teams and modules without conflicts.\n+\n+## Core Concept: Module-Centric Namespaces\n+\n+To support parallel development in this mono-repo, OpenSpec is organized by **module namespaces**. This ensures that changes to one module do not conflict with others and ownership is clear.\n+\n+## Directory Structure\n+\n+All specs and changes MUST follow the module-prefixed convention:\n+\n+```\n+openspec/\n+├── changes/\n+│   ├── [module-name]-[change-id]/    # e.g., settings-service-add-audit-logs\n+│   │   ├── proposal.md           # The \"Why\" and \"What\"\n+│   │   ├── tasks.md              # Implementation checklist\n+│   │   └── specs/                # Delta changes\n+│   │       └── [module-name]-[capability]/\n+│   │           └── spec.md\n+│   └── archive/                  # Completed and merged changes\n+├── specs/\n+│   ├── [module-name]-[capability]/   # e.g., settings-service-core\n+│   │   ├── spec.md               # Current Truth (Requirements & Scenarios)\n+│   │   └── design.md             # Technical patterns & decisions\n+│   └── shared/                   # Cross-cutting concerns (requires coordination)\n+```\n+\n+## Workflow\n+\n+### 1. Naming Your Change\n+Always prefix your change ID with the module name to prevent collisions with syntax `[module-name]-[change-id]`.\n+- **Correct**: `settings-service-add-retention-policy`\n+- **Incorrect**: `add-retention-policy` (Ambiguous in a mono-repo)\n+\n+### 2. Scoping Your Specs\n+Specs live in `openspec/specs/[module-name]-[capability]`.\n+- If you are adding a new capability to the Settings Module, create `openspec/specs/settings-service-newcap`.\n+- **Granularity**: Avoid monolithic specs. Break them down by capability (e.g., `api`, `storage`, `events`).\n+\n+### 3. Parallel Development Process\n+1. **Pull Latest**: Ensure you have the latest `openspec/` state.\n+2. **Create Branch**: `git checkout -b feature/<your-feature-name>`\n+3. **Scaffold Change**:\n+   ```bash\n+   # Create the change directory structure\n+   mkdir -p openspec/changes/[module-name]-[change-id]/specs/[module-name]-[capability]\n+   \n+   # Initialize documents\n+   touch openspec/changes/[module-name]-[change-id]/{proposal.md,tasks.md}\n+   ```\n+4. **Write Proposal**: Define what and why in `proposal.md`.\n+5. **Write Deltas**: Define requirements in `specs/[module-name]-[capability]/spec.md`.\n+   - Use `## ADDED Requirements`, `## MODIFIED Requirements`, etc.\n+   - See `openspec/AGENTS.md` for strict syntax rules.\n+6. **Validate**: `openspec validate [module-name]-[change-id] --strict`\n+7. **Implement**: Code the solution based on the spec.\n+8. **Archive**: After deployment/merge, move to `changes/archive/`.\n+\n+## DOs and DON'Ts\n+\n+### DO\n+- **DO** use the `[module-name]-` prefix for all change IDs and spec directories.\n+- **DO** keep capabilities focused (e.g., `settings-service-api`, `settings-service-storage`) rather than one giant `settings-service` spec.\n+- **DO** reference `openspec/AGENTS.md` for the core syntax rules (Requirements MUST have Scenarios).\n+- **DO** use `openspec validate` frequently to catch syntax errors early.\n+- **DO** consult `guidelines/NEW_MODULE.md` when creating a new module to ensure the OpenSpec structure is initialized correctly.\n+\n+### DON'T\n+- **DON'T** modify files in `openspec/specs/` directly. Always use a Change Proposal in `openspec/changes/`.\n+- **DON'T** create top-level specs without a module prefix (unless it's truly global/shared like `shared-auth`).\n+- **DON'T** merge a PR if `openspec validate` fails.\n+- **DON'T** overwrite another module's specs. Stick to your namespace.\n+\n+## Integration with ModKit\n+\n+When creating a new module using `guidelines/NEW_MODULE.md`:\n+\n+1.  **Initialize Specs**: Immediately create `openspec/specs/[module-name]-core`.\n+2.  **Define Contract**: Use the spec to define the module's `contract` (public API) before implementation.\n+3.  **Iterate**: Use Change Proposals for every significant feature addition to the module.\n+\n+## Example: Settings Service Module Structure\n+\n+The Settings Service module serves as a reference implementation of the OpenSpec structure. Here's how it's organized:\n+\n+### Core Specifications\n+```\n+openspec/specs/settings-service-core/\n+├── spec.md         # Core requirements and scenarios\n+└── design.md       # Technical design decisions\n+└── tasks.md        # Implementation checklist\n+```","path":"guidelines/OPENSPEC.md","commit_id":"f710286e200b1e682b09fa087173659f91898e3e","original_commit_id":"f710286e200b1e682b09fa087173659f91898e3e","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Inconsistency with defined directory structure. Line 93 shows `tasks.md` in the specs directory (`openspec/specs/settings-service-core/`), but the structure definition at lines 24-26 only specifies `spec.md` and `design.md` for specs directories. According to lines 17-19, `tasks.md` belongs in the changes directory structure, not in the specs directory.\n\n```markdown\n# Should be:\nopenspec/specs/settings-service-core/\n├── spec.md         # Core requirements and scenarios\n└── design.md       # Technical design decisions\n```\n```suggestion\n```\nopenspec/specs/settings-service-core/\n├── spec.md         # Core requirements and scenarios\n└── design.md       # Technical design decisions\n```\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/142?chatWithGeneratedComment=6a504b78-4a04-4a63-887c-63426d751a29\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-28T01:22:39Z","updated_at":"2026-01-28T01:22:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/142#discussion_r2734471433","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/142","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471433"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/142#discussion_r2734471433"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/142"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471433/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":89,"original_start_line":89,"start_side":"RIGHT","line":94,"original_line":94,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":94,"position":94,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471502","pull_request_review_id":3714191006,"id":2734471502,"node_id":"PRRC_kwDOPaLyBs6i_LlO","diff_hunk":"@@ -0,0 +1,122 @@\n+# [OpenSpec](https://github.com/Fission-AI/OpenSpec) Guideline for Hyperspot\n+\n+This guide provides the standard process for AI-driven development in the Hyperspot mono-repo using [OpenSpec](https://github.com/Fission-AI/OpenSpec). It is designed to enable parallel development across multiple teams and modules without conflicts.\n+\n+## Core Concept: Module-Centric Namespaces\n+\n+To support parallel development in this mono-repo, OpenSpec is organized by **module namespaces**. This ensures that changes to one module do not conflict with others and ownership is clear.\n+\n+## Directory Structure\n+\n+All specs and changes MUST follow the module-prefixed convention:\n+\n+```\n+openspec/\n+├── changes/\n+│   ├── [module-name]-[change-id]/    # e.g., settings-service-add-audit-logs\n+│   │   ├── proposal.md           # The \"Why\" and \"What\"\n+│   │   ├── tasks.md              # Implementation checklist\n+│   │   └── specs/                # Delta changes\n+│   │       └── [module-name]-[capability]/\n+│   │           └── spec.md\n+│   └── archive/                  # Completed and merged changes\n+├── specs/\n+│   ├── [module-name]-[capability]/   # e.g., settings-service-core\n+│   │   ├── spec.md               # Current Truth (Requirements & Scenarios)\n+│   │   └── design.md             # Technical patterns & decisions\n+│   └── shared/                   # Cross-cutting concerns (requires coordination)\n+```\n+\n+## Workflow\n+\n+### 1. Naming Your Change\n+Always prefix your change ID with the module name to prevent collisions with syntax `[module-name]-[change-id]`.\n+- **Correct**: `settings-service-add-retention-policy`\n+- **Incorrect**: `add-retention-policy` (Ambiguous in a mono-repo)\n+\n+### 2. Scoping Your Specs\n+Specs live in `openspec/specs/[module-name]-[capability]`.\n+- If you are adding a new capability to the Settings Module, create `openspec/specs/settings-service-newcap`.\n+- **Granularity**: Avoid monolithic specs. Break them down by capability (e.g., `api`, `storage`, `events`).\n+\n+### 3. Parallel Development Process\n+1. **Pull Latest**: Ensure you have the latest `openspec/` state.\n+2. **Create Branch**: `git checkout -b feature/<your-feature-name>`\n+3. **Scaffold Change**:\n+   ```bash\n+   # Create the change directory structure\n+   mkdir -p openspec/changes/[module-name]-[change-id]/specs/[module-name]-[capability]\n+   \n+   # Initialize documents\n+   touch openspec/changes/[module-name]-[change-id]/{proposal.md,tasks.md}\n+   ```\n+4. **Write Proposal**: Define what and why in `proposal.md`.\n+5. **Write Deltas**: Define requirements in `specs/[module-name]-[capability]/spec.md`.\n+   - Use `## ADDED Requirements`, `## MODIFIED Requirements`, etc.\n+   - See `openspec/AGENTS.md` for strict syntax rules.\n+6. **Validate**: `openspec validate [module-name]-[change-id] --strict`\n+7. **Implement**: Code the solution based on the spec.\n+8. **Archive**: After deployment/merge, move to `changes/archive/`.\n+\n+## DOs and DON'Ts\n+\n+### DO\n+- **DO** use the `[module-name]-` prefix for all change IDs and spec directories.\n+- **DO** keep capabilities focused (e.g., `settings-service-api`, `settings-service-storage`) rather than one giant `settings-service` spec.\n+- **DO** reference `openspec/AGENTS.md` for the core syntax rules (Requirements MUST have Scenarios).\n+- **DO** use `openspec validate` frequently to catch syntax errors early.\n+- **DO** consult `guidelines/NEW_MODULE.md` when creating a new module to ensure the OpenSpec structure is initialized correctly.\n+\n+### DON'T\n+- **DON'T** modify files in `openspec/specs/` directly. Always use a Change Proposal in `openspec/changes/`.\n+- **DON'T** create top-level specs without a module prefix (unless it's truly global/shared like `shared-auth`).\n+- **DON'T** merge a PR if `openspec validate` fails.\n+- **DON'T** overwrite another module's specs. Stick to your namespace.\n+\n+## Integration with ModKit\n+\n+When creating a new module using `guidelines/NEW_MODULE.md`:\n+\n+1.  **Initialize Specs**: Immediately create `openspec/specs/[module-name]-core`.\n+2.  **Define Contract**: Use the spec to define the module's `contract` (public API) before implementation.\n+3.  **Iterate**: Use Change Proposals for every significant feature addition to the module.\n+\n+## Example: Settings Service Module Structure\n+\n+The Settings Service module serves as a reference implementation of the OpenSpec structure. Here's how it's organized:\n+\n+### Core Specifications\n+```\n+openspec/specs/settings-service-core/\n+├── spec.md         # Core requirements and scenarios\n+└── design.md       # Technical design decisions\n+└── tasks.md        # Implementation checklist\n+```\n+\n+### Example Change Proposal\n+```\n+openspec/changes/settings-service-add-tenant-hierarchy/\n+├── proposal.md     # Why and what's changing\n+├── tasks.md        # Implementation checklist\n+├── design.md       # Technical design decision\n+└── specs/\n+    └── settings-service-tenant/\n+        └── spec.md # Added/MODIFIED tenant hierarchy requirements\n+```","path":"guidelines/OPENSPEC.md","commit_id":"f710286e200b1e682b09fa087173659f91898e3e","original_commit_id":"f710286e200b1e682b09fa087173659f91898e3e","user":{"login":"graphite-app[bot]","id":96075541,"node_id":"BOT_kgDOBbn_FQ","avatar_url":"https://avatars.githubusercontent.com/in/158384?v=4","gravatar_id":"","url":"https://api.github.com/users/graphite-app%5Bbot%5D","html_url":"https://github.com/apps/graphite-app","followers_url":"https://api.github.com/users/graphite-app%5Bbot%5D/followers","following_url":"https://api.github.com/users/graphite-app%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/graphite-app%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/graphite-app%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphite-app%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/graphite-app%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/graphite-app%5Bbot%5D/repos","events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/graphite-app%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"Inconsistency with defined directory structure. Line 101 shows `design.md` in the changes directory, but the structure definition at lines 16-21 only specifies `proposal.md`, `tasks.md`, and `specs/` subdirectory for changes directories. According to line 26, `design.md` belongs in the specs directory structure (`openspec/specs/`), not in changes. This creates conflicting guidance about where design documents should be placed.\n\n```markdown\n# If design.md should be in changes, update lines 16-21 to include it\n# If design.md should only be in specs, remove line 101 from the example\n```\n```suggestion\n\n```\nopenspec/changes/settings-service-add-tenant-hierarchy/\n├── proposal.md     # Why and what's changing\n├── tasks.md        # Implementation checklist\n└── specs/\n    └── settings-service-tenant/\n        └── spec.md # Added/MODIFIED tenant hierarchy requirements\n```\n\n```\n  \n\n*Spotted by [Graphite Agent](https://app.graphite.com/diamond/?org=hypernetix&ref=ai-review-comment)*<i class='graphite__hidden'><br /><br /><a href=\"https://app.graphite.com/github/pr/hypernetix/hyperspot/142?chatWithGeneratedComment=8553a481-273e-4252-bafc-284a74116981\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://static.graphite.dev/github-diamond-fix-in-graphite-light.svg\"><img alt=\"Fix in Graphite\" src=\"https://static.graphite.dev/github-diamond-fix-in-graphite-dark.svg\"></picture></a></i><i class='graphite__hidden'><br /><br />Is this helpful? React 👍 or 👎 to let us know.</i>","created_at":"2026-01-28T01:22:41Z","updated_at":"2026-01-28T01:22:43Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/142#discussion_r2734471502","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/142","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471502"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/142#discussion_r2734471502"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/142"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2734471502/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":97,"original_start_line":97,"start_side":"RIGHT","line":105,"original_line":105,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":105,"position":105,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":141,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/141","source_state":"closed","source_author":"nanoandrew4","target_issue_number":null,"title":"[PR #141] Restructure and reimplement Dylint lints","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"dylint-restructure","pr_head_sha":"ed513fcadd9c05daa4f6c6fe113d464579631316","pr_base_ref":"main","pr_head_owner":"nanoandrew4","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141","id":3120744659,"node_id":"PR_kwDOPaLyBs66AsjT","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/141","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/141.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/141.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/141","number":141,"state":"closed","locked":false,"title":"Restructure and reimplement Dylint lints","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This PR restructures the existing lints and re-implements them to make proper use of the AST/HIL, instead of relying on raw string matches or regexes. The restructuring aims to follow dylints best practices and houses each lint in its own folder, complete with its dependencies and test cases.\r\n\r\nOne limitation from dylint is when tests need external dependencies to run, you must use `ui_test_examples`, which copies the test files into a temporary directory for running the tests, which does not respect the original structure of the `ui` folder. This means that for all the lints that rely on file paths, the tests would always fail, since even if you put the files in `ui/contract/your_test_file.rs`, when the tests are run the intermediate `contract` directory is removed, and the lints won't know what module they belong to. This has been worked around by adding support for a simulated directory, which is marked by a comment on the first line of the test file that looks as follows: `// simulated_dir=/hyperspot/modules/some_module/api/rest/`. When the code detects it is in a temporary directory and sees this comment, it will use the path specified in the comment instead of the real one, which will allow the lints to run in the tests. Open to suggestions on how to improve this.\r\n\r\nAlso added two jobs to the CI workflow, one for running the lint tests, and one for running the lints against all our crates to make sure the code complies with the lints.","created_at":"2025-12-21T15:31:18Z","updated_at":"2025-12-23T18:04:08Z","closed_at":"2025-12-23T18:04:08Z","merged_at":"2025-12-23T18:04:08Z","merge_commit_sha":"63db059bb2a21678a68ae6bc73a85423b778bb17","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/141/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/ed513fcadd9c05daa4f6c6fe113d464579631316","head":{"label":"nanoandrew4:dylint-restructure","ref":"dylint-restructure","sha":"ed513fcadd9c05daa4f6c6fe113d464579631316","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1113712159,"node_id":"R_kgDOQmHmHw","name":"hyperspot","full_name":"nanoandrew4/hyperspot","private":false,"owner":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","
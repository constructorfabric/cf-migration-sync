e_local\",\n+    skip(svc, req_body, _ctx, query),\n+    fields(\n+        file_path = %req_body.file_path,\n+        render_markdown = ?query.render_markdown,\n+        request_id = Empty\n+    )\n+)]\n+#[axum::debug_handler]\n+pub async fn parse_local(\n+    Authz(_ctx): Authz,\n+    Extension(svc): Extension<std::sync::Arc<FileParserService>>,\n+    Query(query): Query<RenderMarkdownQuery>,\n+    Json(req_body): Json<ParseLocalRequest>,\n+) -> FileParserResult<JsonBody<FileParseResponseDto>> {\n+    let render_md = query.render_markdown.unwrap_or(false);\n+\n+    info!(\n+        file_path = %req_body.file_path,\n+        render_markdown = render_md,\n+        \"Parsing file from local path\"\n+    );\n+\n+    let path = std::path::Path::new(&req_body.file_path);\n+    let document = svc\n+        .parse_local(path)\n+        .await\n+        .map_err(FileParserApiError::from_domain)?;\n+\n+    // Optionally render markdown\n+    let markdown = if render_md {\n+        Some(MarkdownRenderer::render(&document))\n+    } else {\n+        None\n+    };\n+\n+    let response = FileParseResponseDto {\n+        document: ParsedDocumentDto::from(document),\n+        markdown,\n+    };\n+\n+    Ok(Json(response))\n+}\n+\n+/// Upload and parse a file\n+#[tracing::instrument(\n+    name = \"file_parser.upload\",","path":"modules/file_parser/src/api/rest/handlers.rs","commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":" `file_parser.upload` or `file_parser.upload_and_parse` ?","created_at":"2025-11-24T23:58:30Z","updated_at":"2025-11-25T00:43:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558074457","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558074457"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558074457"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558074457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":100,"side":"RIGHT","author_association":"MEMBER","original_position":100,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558119829","pull_request_review_id":3501335634,"id":2558119829,"node_id":"PRRC_kwDOPaLyBs6Yec-V","diff_hunk":"@@ -0,0 +1,173 @@\n+use crate::api::rest::handlers;\n+use crate::domain::service::FileParserService;\n+use axum::{Extension, Router};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<FileParserService>,\n+) -> anyhow::Result<Router> {\n+    // GET /file-parser/info - Get information about available file parsers\n+    router = OperationBuilder::get(\"/file-parser/info\")\n+        .operation_id(\"file_parser.get_parser_info\")\n+        .summary(\"Get information about available file parsers\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"read\")\n+        .handler(handlers::get_parser_info)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParserInfoDto>(\n+            openapi,\n+            200,\n+            \"Information about available parsers\",\n+        )\n+        .problem_response(openapi, 401, \"Unauthorized\")\n+        .problem_response(openapi, 403, \"Forbidden\")\n+        .problem_response(openapi, 500, \"Internal Server Error\")\n+        .register(router, openapi);\n+\n+    // POST /file-parser/parse-local - Parse a file from a local path\n+    router = OperationBuilder::post(\"/file-parser/parse-local\")\n+        .operation_id(\"file_parser.parse_local\")\n+        .summary(\"Parse a file from a local path\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"write\")\n+        .query_param_typed(\n+            \"render_markdown\",\n+            false,\n+            \"Render Markdown output if true (optional, default false)\",\n+            \"boolean\",\n+        )\n+        .json_request::<crate::api::rest::dto::ParseLocalRequest>(openapi, \"Local file path\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::parse_local)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParseResponseDto>(\n+            openapi,\n+            200,\n+            \"Parsed document with optional markdown\",\n+        )\n+        .problem_response(openapi, 400, \"Bad Request\")","path":"modules/file_parser/src/api/rest/routes.rs","commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This pattern looks disappointing a bit, is it fully ideomatic? :)","created_at":"2025-11-25T00:31:01Z","updated_at":"2025-11-25T00:43:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558119829","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558119829"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558119829"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558119829/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":49,"side":"RIGHT","author_association":"MEMBER","original_position":49,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558122510","pull_request_review_id":3501335634,"id":2558122510,"node_id":"PRRC_kwDOPaLyBs6YedoO","diff_hunk":"@@ -0,0 +1,173 @@\n+use crate::api::rest::handlers;\n+use crate::domain::service::FileParserService;\n+use axum::{Extension, Router};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use std::sync::Arc;\n+\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<FileParserService>,\n+) -> anyhow::Result<Router> {\n+    // GET /file-parser/info - Get information about available file parsers\n+    router = OperationBuilder::get(\"/file-parser/info\")\n+        .operation_id(\"file_parser.get_parser_info\")\n+        .summary(\"Get information about available file parsers\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"read\")\n+        .handler(handlers::get_parser_info)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParserInfoDto>(\n+            openapi,\n+            200,\n+            \"Information about available parsers\",\n+        )\n+        .problem_response(openapi, 401, \"Unauthorized\")\n+        .problem_response(openapi, 403, \"Forbidden\")\n+        .problem_response(openapi, 500, \"Internal Server Error\")\n+        .register(router, openapi);\n+\n+    // POST /file-parser/parse-local - Parse a file from a local path\n+    router = OperationBuilder::post(\"/file-parser/parse-local\")\n+        .operation_id(\"file_parser.parse_local\")\n+        .summary(\"Parse a file from a local path\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"write\")\n+        .query_param_typed(\n+            \"render_markdown\",\n+            false,\n+            \"Render Markdown output if true (optional, default false)\",\n+            \"boolean\",\n+        )\n+        .json_request::<crate::api::rest::dto::ParseLocalRequest>(openapi, \"Local file path\")\n+        .allow_content_types(&[\"application/json\"])\n+        .handler(handlers::parse_local)\n+        .json_response_with_schema::<crate::api::rest::dto::FileParseResponseDto>(\n+            openapi,\n+            200,\n+            \"Parsed document with optional markdown\",\n+        )\n+        .problem_response(openapi, 400, \"Bad Request\")\n+        .problem_response(openapi, 401, \"Unauthorized\")\n+        .problem_response(openapi, 403, \"Forbidden\")\n+        .problem_response(openapi, 404, \"File Not Found\")\n+        .problem_response(openapi, 415, \"Unsupported Media Type\")\n+        .problem_response(openapi, 422, \"Unprocessable Entity\")\n+        .problem_response(openapi, 500, \"Internal Server Error\")\n+        .register(router, openapi);\n+\n+    // POST /file-parser/upload - Upload and parse a file\n+    router = OperationBuilder::post(\"/file-parser/upload\")\n+        .operation_id(\"file_parser.upload\")\n+        .summary(\"Upload and parse a file\")\n+        .description(\"Accepts multipart/form-data file uploads with field name 'file'\")\n+        .tag(\"File Parser\")\n+        .require_auth(\"file_parser\", \"write\")","path":"modules/file_parser/src/api/rest/routes.rs","commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"can we fail compilation (or any other sast) if .require_auth() is not used (forgotten)?\nIf auth is not needed, I'd prefer an empty call, but not missing require_auth()","created_at":"2025-11-25T00:32:43Z","updated_at":"2025-11-25T00:43:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558122510","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558122510"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558122510"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558122510/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":64,"side":"RIGHT","author_association":"MEMBER","original_position":64,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2558126205","pull_request_review_id":3501335634,"id":2558126205,"node_id":"PRRC_kwDOPaLyBs6Yeeh9","diff_hunk":"@@ -0,0 +1,249 @@\n+use async_trait::async_trait;\n+use std::path::Path;\n+\n+use crate::domain::error::DomainError;\n+use crate::domain::ir::{DocumentBuilder, ParsedBlock, ParsedSource};\n+use crate::domain::parser::FileParserBackend;\n+\n+/// HTML parser that converts HTML to structured blocks\n+pub struct HtmlParser;\n+\n+impl HtmlParser {\n+    pub fn new() -> Self {\n+        Self\n+    }\n+}\n+\n+impl Default for HtmlParser {\n+    fn default() -> Self {\n+        Self::new()\n+    }\n+}\n+\n+#[async_trait]\n+impl FileParserBackend for HtmlParser {\n+    fn id(&self) -> &'static str {\n+        \"html\"\n+    }\n+\n+    fn supported_extensions(&self) -> &'static [&'static str] {\n+        &[\"html\", \"htm\"]\n+    }\n+\n+    async fn parse_local_path(\n+        &self,\n+        path: &Path,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let content = tokio::fs::read(path)\n+            .await\n+            .map_err(|e| DomainError::io_error(format!(\"Failed to read file: {}\", e)))?;\n+\n+        let filename = path\n+            .file_name()\n+            .and_then(|s| s.to_str())\n+            .map(|s| s.to_string());\n+        let (blocks, title) =\n+            tokio::task::spawn_blocking(move || parse_html_bytes(&content, filename.as_deref()))\n+                .await\n+                .map_err(|e| DomainError::parse_error(format!(\"Task join error: {}\", e)))??;\n+\n+        let mut builder = DocumentBuilder::new(ParsedSource::LocalPath(path.display().to_string()))\n+            .content_type(\"text/html\")\n+            .blocks(blocks);\n+\n+        if let Some(t) = title {\n+            builder = builder.title(t);\n+        }\n+\n+        if let Some(filename) = path.file_name().and_then(|s| s.to_str()) {\n+            builder = builder.original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+\n+    async fn parse_bytes(\n+        &self,\n+        filename_hint: Option<&str>,\n+        _content_type: Option<&str>,\n+        bytes: bytes::Bytes,\n+    ) -> Result<crate::domain::ir::ParsedDocument, DomainError> {\n+        let filename_owned = filename_hint.map(|s| s.to_string());\n+        let (blocks, title) = tokio::task::spawn_blocking(move || {\n+            parse_html_bytes(&bytes, filename_owned.as_deref())\n+        })\n+        .await\n+        .map_err(|e| DomainError::parse_error(format!(\"Task join error: {}\", e)))??;\n+\n+        let source = ParsedSource::Uploaded {\n+            original_name: filename_hint.unwrap_or(\"unknown.html\").to_string(),\n+        };\n+\n+        let mut builder = DocumentBuilder::new(source)\n+            .content_type(\"text/html\")\n+            .blocks(blocks);\n+\n+        if let Some(t) = title {\n+            builder = builder.title(t);\n+        }\n+\n+        if let Some(filename) = filename_hint {\n+            builder = builder.original_filename(filename);\n+        }\n+\n+        Ok(builder.build())\n+    }\n+}\n+\n+fn parse_html_bytes(\n+    bytes: &[u8],\n+    filename: Option<&str>,\n+) -> Result<(Vec<ParsedBlock>, Option<String>), DomainError> {\n+    let html_str = String::from_utf8_lossy(bytes);\n+\n+    let dom = tl::parse(&html_str, tl::ParserOptions::default())\n+        .map_err(|e| DomainError::parse_error(format!(\"Failed to parse HTML: {}\", e)))?;\n+\n+    let parser = dom.parser();\n+    let mut blocks = Vec::new();\n+    let mut title = None;\n+\n+    // Try to extract title from <title> tag\n+    if let Some(title_node) = dom.query_selector(\"title\").and_then(|mut iter| iter.next()) {\n+        if let Some(node) = title_node.get(parser) {\n+            let text = node.inner_text(parser);\n+            title = Some(text.to_string());\n+        }\n+    }\n+\n+    // Fall back to filename if no title found\n+    if title.is_none() {\n+        title = filename.map(|s| s.to_string());\n+    }\n+\n+    // Extract body content\n+    if let Some(body) = dom.query_selector(\"body\").and_then(|mut iter| iter.next()) {\n+        if let Some(tag) = body.get(parser).and_then(|n| n.as_tag()) {\n+            extract_blocks_from_node(tag, parser, &mut blocks, 0);\n+        }\n+    } else {\n+        // Fallback: process all top-level nodes\n+        for node in dom.children() {\n+            if let Some(tag) = node.get(parser).and_then(|n| n.as_tag()) {\n+                extract_blocks_from_node(tag, parser, &mut blocks, 0);\n+            }\n+        }\n+    }\n+\n+    // Fallback: if no blocks extracted, treat as plain text\n+    if blocks.is_empty() {\n+        let text = dom.outer_html().trim().to_string();\n+        if !text.is_empty() {\n+            blocks.push(ParsedBlock::Paragraph { text });\n+        }\n+    }\n+\n+    Ok((blocks, title))\n+}\n+\n+fn extract_blocks_from_node(\n+    tag: &tl::HTMLTag,\n+    parser: &tl::Parser,\n+    blocks: &mut Vec<ParsedBlock>,\n+    list_level: u8,\n+) {\n+    let tag_name = tag.name().as_utf8_str();\n+\n+    match tag_name.as_ref() {\n+        \"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\" => {","path":"modules/file_parser/src/domain/parsers/html_parser.rs","commit_id":"9e3c7405e44dd3ec4f5dc7c936ebae96e2bb3440","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"are there any existing parsers!?","created_at":"2025-11-25T00:35:26Z","updated_at":"2025-11-25T00:43:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31#discussion_r2558126205","pull
ls/comments/2635311315","pull_request_review_id":3598862197,"id":2635311315,"node_id":"PRRC_kwDOPaLyBs6dE6jT","diff_hunk":"@@ -0,0 +1,311 @@\n+//! Public models for the `types-registry` module.\n+//!\n+//! These are transport-agnostic data structures that define the contract\n+//! between the `types-registry` module and its consumers.\n+\n+use serde::{de::DeserializeOwned, Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+// Re-export GtsIdSegment from gts-rust\n+pub use gts::GtsIdSegment;\n+\n+/// The kind of GTS entity.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum GtsEntityKind {\n+    /// A type definition (GTS ID ends with `~`)\n+    Type,\n+    /// An instance of a type (GTS ID does not end with `~`)\n+    Instance,\n+}\n+\n+impl GtsEntityKind {\n+    /// Returns `true` if this is a type definition.\n+    #[must_use]\n+    pub const fn is_type(self) -> bool {\n+        matches!(self, Self::Type)\n+    }\n+\n+    /// Returns `true` if this is an instance.\n+    #[must_use]\n+    pub const fn is_instance(self) -> bool {\n+        matches!(self, Self::Instance)\n+    }\n+}\n+\n+/// A registered GTS entity.\n+///\n+/// This represents either a type definition or an instance that has been\n+/// registered in the Types Registry.\n+///\n+/// # Type Parameter\n+///\n+/// - `C`: The content type. Use `serde_json::Value` for dynamic content,\n+///   or a concrete struct for type-safe access.\n+///\n+/// # Example\n+///\n+/// ```ignore\n+/// // Dynamic entity (default)\n+/// let entity: GtsEntity = registry.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+///\n+/// // Type-safe entity\n+/// let entity: GtsEntity<MySchema> = registry.get(&ctx, gts_id).await?;\n+/// ```\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct GtsEntity<C = serde_json::Value>\n+where\n+    C: Serialize + DeserializeOwned + Clone,\n+{\n+    /// Deterministic UUID generated from the GTS ID.\n+    ///\n+    /// This UUID is generated using UUID v5 with a GTS namespace,","path":"modules/types-registry/types-registry-sdk/src/models.rs","commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"added in the comment","created_at":"2025-12-19T14:41:22Z","updated_at":"2025-12-19T14:41:22Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635311315","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635311315"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635311315"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635311315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":61,"side":"RIGHT","in_reply_to_id":2634985626,"author_association":"MEMBER","original_position":61,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635311639","pull_request_review_id":3598862532,"id":2635311639,"node_id":"PRRC_kwDOPaLyBs6dE6oX","diff_hunk":"@@ -0,0 +1,311 @@\n+//! Public models for the `types-registry` module.\n+//!\n+//! These are transport-agnostic data structures that define the contract\n+//! between the `types-registry` module and its consumers.\n+\n+use serde::{de::DeserializeOwned, Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+// Re-export GtsIdSegment from gts-rust\n+pub use gts::GtsIdSegment;\n+\n+/// The kind of GTS entity.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum GtsEntityKind {\n+    /// A type definition (GTS ID ends with `~`)\n+    Type,\n+    /// An instance of a type (GTS ID does not end with `~`)\n+    Instance,\n+}\n+\n+impl GtsEntityKind {\n+    /// Returns `true` if this is a type definition.\n+    #[must_use]\n+    pub const fn is_type(self) -> bool {\n+        matches!(self, Self::Type)\n+    }\n+\n+    /// Returns `true` if this is an instance.\n+    #[must_use]\n+    pub const fn is_instance(self) -> bool {\n+        matches!(self, Self::Instance)\n+    }\n+}\n+\n+/// A registered GTS entity.\n+///\n+/// This represents either a type definition or an instance that has been\n+/// registered in the Types Registry.\n+///\n+/// # Type Parameter\n+///\n+/// - `C`: The content type. Use `serde_json::Value` for dynamic content,\n+///   or a concrete struct for type-safe access.\n+///\n+/// # Example\n+///\n+/// ```ignore\n+/// // Dynamic entity (default)\n+/// let entity: GtsEntity = registry.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+///\n+/// // Type-safe entity\n+/// let entity: GtsEntity<MySchema> = registry.get(&ctx, gts_id).await?;\n+/// ```\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct GtsEntity<C = serde_json::Value>\n+where\n+    C: Serialize + DeserializeOwned + Clone,\n+{\n+    /// Deterministic UUID generated from the GTS ID.\n+    ///\n+    /// This UUID is generated using UUID v5 with a GTS namespace,\n+    /// ensuring the same GTS ID always produces the same UUID.\n+    pub id: Uuid,\n+\n+    /// The full GTS identifier string.\n+    ///\n+    /// For types: `gts.vendor.package.namespace.name.version~`\n+    /// For instances: `gts.vendor.package.namespace.name.version~instance.id`\n+    pub gts_id: String,\n+\n+    /// All parsed segments from the GTS ID.\n+    ///\n+    /// For simple IDs, this contains one segment.\n+    /// For chained IDs (instances), this contains multiple segments.\n+    pub segments: Vec<GtsIdSegment>,\n+\n+    /// The kind of entity (Type or Instance).\n+    pub kind: GtsEntityKind,\n+\n+    /// The entity content (schema for types, object for instances).\n+    pub content: C,\n+\n+    /// Optional description of the entity.\n+    pub description: Option<String>,\n+}\n+\n+/// Type alias for dynamic GTS entities using `serde_json::Value` as content.\n+pub type DynGtsEntity = GtsEntity<serde_json::Value>;","path":"modules/types-registry/types-registry-sdk/src/models.rs","commit_id":"25a4db2e48c5155c97163bb1b926b771a8d18301","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"added","created_at":"2025-12-19T14:41:27Z","updated_at":"2025-12-19T14:41:27Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635311639","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635311639"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635311639"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635311639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":86,"original_line":88,"side":"RIGHT","in_reply_to_id":2634981807,"author_association":"MEMBER","original_position":88,"position":86,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312071","pull_request_review_id":3598862957,"id":2635312071,"node_id":"PRRC_kwDOPaLyBs6dE6vH","diff_hunk":"@@ -0,0 +1,311 @@\n+//! Public models for the `types-registry` module.\n+//!\n+//! These are transport-agnostic data structures that define the contract\n+//! between the `types-registry` module and its consumers.\n+\n+use serde::{de::DeserializeOwned, Deserialize, Serialize};\n+use uuid::Uuid;\n+\n+// Re-export GtsIdSegment from gts-rust\n+pub use gts::GtsIdSegment;\n+\n+/// The kind of GTS entity.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum GtsEntityKind {\n+    /// A type definition (GTS ID ends with `~`)\n+    Type,\n+    /// An instance of a type (GTS ID does not end with `~`)\n+    Instance,\n+}\n+\n+impl GtsEntityKind {\n+    /// Returns `true` if this is a type definition.\n+    #[must_use]\n+    pub const fn is_type(self) -> bool {\n+        matches!(self, Self::Type)\n+    }\n+\n+    /// Returns `true` if this is an instance.\n+    #[must_use]\n+    pub const fn is_instance(self) -> bool {\n+        matches!(self, Self::Instance)\n+    }\n+}\n+\n+/// A registered GTS entity.\n+///\n+/// This represents either a type definition or an instance that has been\n+/// registered in the Types Registry.\n+///\n+/// # Type Parameter\n+///\n+/// - `C`: The content type. Use `serde_json::Value` for dynamic content,\n+///   or a concrete struct for type-safe access.\n+///\n+/// # Example\n+///\n+/// ```ignore\n+/// // Dynamic entity (default)\n+/// let entity: GtsEntity = registry.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+///\n+/// // Type-safe entity\n+/// let entity: GtsEntity<MySchema> = registry.get(&ctx, gts_id).await?;\n+/// ```\n+#[derive(Debug, Clone, PartialEq)]\n+pub struct GtsEntity<C = serde_json::Value>\n+where\n+    C: Serialize + DeserializeOwned + Clone,\n+{\n+    /// Deterministic UUID generated from the GTS ID.\n+    ///\n+    /// This UUID is generated using UUID v5 with a GTS namespace,\n+    /// ensuring the same GTS ID always produces the same UUID.\n+    pub id: Uuid,\n+\n+    /// The full GTS identifier string.\n+    ///\n+    /// For types: `gts.vendor.package.namespace.name.version~`\n+    /// For instances: `gts.vendor.package.namespace.name.version~instance.id`\n+    pub gts_id: String,\n+\n+    /// All parsed segments from the GTS ID.\n+    ///\n+    /// For simple IDs, this contains one segment.\n+    /// For chained IDs (instances), this contains multiple segments.\n+    pub segments: Vec<GtsIdSegment>,\n+\n+    /// The kind of entity (Type or Instance).\n+    pub kind: GtsEntityKind,\n+\n+    /// The entity content (schema for types, object for instances).\n+    pub content: C,\n+\n+    /// Optional description of the entity.\n+    pub description: Option<String>,\n+}\n+\n+/// Type alias for dynamic GTS entities using `serde_json::Value` as content.\n+pub type DynGtsEntity = GtsEntity<serde_json::Value>;\n+\n+impl<C> GtsEntity<C>\n+where\n+    C: Serialize + DeserializeOwned + Clone,\n+{\n+    /// Creates a new `GtsEntity` with the given components.\n+    #[must_use]\n+    pub fn new(\n+        id: Uuid,\n+        gts_id: impl Into<String>,\n+        segments: Vec<GtsIdSegment>,\n+        kind: GtsEntityKind,\n+        content: C,\n+        description: Option<String>,\n+    ) -> Self {\n+        Self {\n+            id,\n+            gts_id: gts_id.into(),\n+            segments,\n+            kind,\n+            content,\n+            description,\n+        }\n+    }\n+\n+    /// Returns `true` if this entity is a type definition.\n+    #[must_use]\n+    pub const fn is_type(&self) -> bool {\n+        self.kind.is_type()\n+    }\n+\n+    /// Returns `true` if this entity is an instance.\n+    #[must_use]\n+    pub const fn is_instance(&self) -> bool {\n+        self.kind.is_instance()\n+    }\n+\n+    /// Returns the primary segment (first segment in the chain).\n+    #[must_use]\n+    pub fn primary_segment(&self) -> Option<&GtsIdSegment> {\n+        self.segments.first()\n+    }\n+\n+    /// Returns the vendor from the primary segment.\n+    #[must_use]\n+    pub fn vendor(&self) -> Option<&str> {\n+        self.primary_segment().map(|s| s.vendor.as_str())\n+    }\n+\n+    /// Returns the package from the primary segment.\n+    #[must_use]\n+    pub fn package(&self) -> Option<&str> {\n+        self.primary_segment().map(|s| s.package.as_str())\n+    }\n+\n+    /// Returns the namespace from the primary segment.\n+    #[must_use]\n+    pub fn namespace(&self) -> Option<&str> {\n+        self.primary_segment().map(|s| s.namespace.as_str())\n+    }\n+}\n+\n+/// Query parameters for listing GTS entities.\n+///\n+/// All fields are optional. When a field is `None`, no filtering\n+/// is applied for that field.\n+///\n+/// # Example\n+///\n+/// ```\n+/// use types_registry_sdk::ListQuery;\n+///\n+/// // List all entities\n+/// let query = ListQuery::default();\n+///\n+/// // List only types from vendor \"acme\"\n+/// let query = ListQuery::default()\n+///     .with_is_type(true)\n+///     .with_vendor(\"acme\");\n+///\n+/// // List entities matching a pattern\n+/// let query = ListQuery::default()\n+///     .with_pattern(\"gts.acme.core.*\");\n+/// ```\n+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]\n+pub struct ListQuery {\n+    /// Optional wildcard pattern for GTS ID matching.\n+    ///\n+    /// Supports `*` as a wildcard character.\n+    pub pattern: Option<String>,\n+\n+    /// Filter for entity kind: `true` for types, `false` for instances.\n+    pub is_type: Option<bool>,\n+\n+    /// Filter by vendor (matches any segment).\n+    pub vendor: Option<String>,\n+\n+    /// Filter by package (matches any segment).\n+    pub package: Option<String>,\n+\n+    /// Filter by namespace (matches any segment).\n+    pub namespace: Option<String>,\n+}\n+\n+impl ListQuery {\n+    /// Creates a new empty `ListQuery`.\n+    #[must_use]\n+    pub fn new() -> Self {\n+        Self::default()\n+    }\n+\n+    /// Sets the pattern filter.\n+    #[must_use]\n+    pub fn with_pattern(mut self, pattern: impl Into<String>) -> Self {","path":"modules/types-registry/types-registry-sdk/src/models.rs","commit_id":"25a4db2e48c5155c97163bb1b926b771a8d18301","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"added","created_at":"2025-12-19T14:41:34Z","updated_at":"2025-12-19T14:41:35Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635312071","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312071"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635312071"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312071/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":586,"original_line":202,"side":"RIGHT","in_reply_to_id":2634955066,"author_association":"MEMBER","original_position":202,"position":586,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312345","pull_request_review_id":3598863306,"id":2635312345,"node_id":"PRRC_kwDOPaLyBs6dE6zZ","diff_hunk":"@@ -0,0 +1,80 @@\n+//! `TypesRegistryApi` trait definition.\n+//!\n+//! This trait defines the public API for the `types-registry` module.\n+//! All methods require a `SecurityCtx` for authorization and access control.\n+\n+use async_trait::async_trait;\n+use modkit_security::SecurityCtx;\n+\n+use crate::error::TypesRegistryError;\n+use crate::models::{GtsEntity, ListQuery};\n+\n+/// Public API trait for the `types-registry` module.\n+///\n+/// This trait can be consumed by other modules via `ClientHub`:\n+/// ```ignore\n+/// let client = hub.get::<dyn TypesRegistryApi>()?;\n+/// let entity = client.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+/// ```\n+///\n+/// All methods require a `SecurityCtx` for proper authorization and access control.\n+#[async_trait]\n+pub trait TypesRegistryApi: Send + Sync {\n+    /// Register GTS entities (types or instances) in batch.\n+    ///\n+    /// Each JSON value in the input should contain a valid GTS entity\n+    /// with a `$id` field containing the GTS identifier.\n+    ///\n+    /// # Arguments\n+    ///\n+    /// * `ctx` - Security context for authorization\n+    /// * `entities` - JSON values representing GTS entities to register\n+    ///\n+    /// # Returns\n+    ///\n+    /// A vector of registered `GtsEntity` objects on success.\n+    ///\n+    /// # Errors\n+    ///\n+    /// * `InvalidGtsId` - If any entity has an invalid GTS ID format\n+    /// * `AlreadyExists` - If any entity with the same GTS ID already exists\n+    /// * `ValidationFailed` - If any entity fails schema validation\n+    async fn register(\n+        &self,\n+        ctx: &SecurityCtx,\n+        entities: Vec<serde_json::Value>,\n+    ) -> Result<Vec<GtsEntity>, TypesRegistryError>;","path":"modules/types-registry/types-registry-sdk/src/api.rs","commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"done","created_at":"2025-12-19T14:41:40Z","updated_at":"2025-12-19T14:41:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635312345","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312345"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635312345"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635312345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":46,"side":"RIGHT","in_reply_to_id":2634942671,"author_association":"MEMBER","original_position":46,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635708953","pull_request_review_id":3598784768,"id":2635708953,"node_id":"PRRC_kwDOPaLyBs6dGboZ","diff_hunk":"@@ -0,0 +1,80 @@\n+//! `TypesRegistryApi` trait definition.\n+//!\n+//! This trait defines the public API for the `types-registry` module.\n+//! All methods require a `SecurityCtx` for authorization and access control.\n+\n+use async_trait::async_trait;\n+use modkit_security::SecurityCtx;\n+\n+use crate::error::TypesRegistryError;\n+use crate::models::{GtsEntity, ListQuery};\n+\n+/// Public API trait for the `types-registry` module.\n+///\n+/// This trait can be consumed by other modules via `ClientHub`:\n+/// ```ignore\n+/// let client = hub.get::<dyn TypesRegistryApi>()?;\n+/// let entity = client.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+/// ```\n+///\n+/// All methods require a `SecurityCtx` for proper authorization and access control.\n+#[async_trait]\n+pub trait TypesRegistryApi: Send + Sync {","path":"modules/types-registry/types-registry-sdk/src/api.rs","commit_id":"25a4db2e48c5155c97163bb1b926b771a8d18301","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm OK","created_at":"2025-12-19T16:52:10Z","updated_at":"2025-12-19T16:54:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635708953","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635708953"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2635708953"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2635708953/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":22,"original_line":22,"side":"RIGHT","in_reply_to_id":2634876647,"author_association":"MEMBER","original_position":22,"position":22,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2636882795","pull_request_review_id":3600816644,"id":2636882795,"node_id":"PRRC_kwDOPaLyBs6dK6Nr","diff_hunk":"@@ -0,0 +1,151 @@\n+# Types Registry SDK\n+\n+SDK crate for the Types Registry module, providing the public API contracts for GTS (Global Type System) entity management.\n+\n+## Overview\n+\n+This crate defines the transport-agnostic interface for the Types Registry module:\n+\n+- **`TypesRegistryApi`** - Async trait for inter-module communication\n+- **`GtsEntity`** - Model representing registered GTS entities (types and instances)\n+- **`ListQuery`** - Query builder for filtering entity listings\n+- **`TypesRegistryError`** - Error types for all operations\n+\n+## Usage\n+\n+### Getting the Client\n+\n+Consumers obtain the client from `ClientHub`:\n+\n+```rust\n+use types_registry_sdk::{TypesRegistryApi, ListQuery};\n+\n+// Get the client from ClientHub\n+let client = hub.get::<dyn TypesRegistryApi>()?;\n+```\n+\n+### Registering Entities\n+\n+```rust\n+use serde_json::json;\n+\n+// Register a type schema\n+let schemas = vec![\n+    json!({\n+        \"$id\": \"gts.acme.core.events.user_created.v1~\",\n+        \"type\": \"object\",\n+        \"properties\": {\n+            \"user_id\": { \"type\": \"string\" },\n+            \"email\": { \"type\": \"string\" }\n+        }\n+    })\n+];\n+\n+let entities = client.register(&ctx, schemas).await?;\n+```\n+\n+### Listing Entities\n+\n+```rust\n+use types_registry_sdk::ListQuery;\n+\n+// List all entities\n+let all = client.list(&ctx, ListQuery::default()).await?;\n+\n+// List only types from vendor \"acme\"\n+let query = ListQuery::new()\n+    .with_is_type(true)\n+    .with_vendor(\"acme\");\n+let acme_types = client.list(&ctx, query).await?;\n+\n+// List entities matching a pattern\n+let query = ListQuery::new()\n+    .with_pattern(\"gts.acme.core.*\");\n+let matched = client.list(&ctx, query).await?;\n+```\n+\n+### Getting a Single Entity\n+\n+```rust\n+let entity = client.get(&ctx, \"gts.acme.core.events.user_created.v1~\").await?;\n+\n+println!(\"GTS ID: {}\", entity.gts_id);\n+println!(\"Kind: {:?}\", entity.kind);\n+println!(\"Vendor: {:?}\", entity.vendor());\n+```\n+\n+## Models\n+\n+### GtsEntity\n+\n+Represents a registered GTS entity:\n+\n+```rust\n+pub struct GtsEntity<C = serde_json::Value> {\n+    pub id: Uuid,                    // Deterministic UUID from GTS ID\n+    pub gts_id: String,              // Full GTS identifier\n+    pub segments: Vec<GtsIdSegment>, // Parsed segments\n+    pub kind: GtsEntityKind,         // Type or Instance\n+    pub content: C,                  // Schema or object content\n+    pub description: Option<String>, // Optional description","path":"modules/types-registry/types-registry-sdk/README.md","commit_id":"25a4db2e48c5155c97163bb1b926b771a8d18301","original_commit_id":"eb403747e7f7362067daf8c5687ca00d72982345","user":{"login":"alizid10","id":247960800,"node_id":"U_kgDODseU4A","avatar_url":"https://avatars.githubusercontent.com/u/247960800?v=4","gravatar_id":"","url":"https://api.github.com/users/alizid10","html_url":"https://github.com/alizid10","followers_url":"https://api.github.com/users/alizid10/followers","following_url":"https://api.github.com/users/alizid10/following{/other_user}","gists_url":"https://api.github.com/users/alizid10/gists{/gist_id}","starred_url":"https://api.github.com/users/alizid10/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alizid10/subscriptions","organizations_url":"https://api.github.com/users/alizid10/orgs","repos_url":"https://api.github.com/users/alizid10/repos","events_url":"https://api.github.com/users/alizid10/events{/privacy}","received_events_url":"https://api.github.com/users/alizid10/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"it's there already: \"id\"","created_at":"2025-12-20T07:16:47Z","updated_at":"2025-12-20T07:16:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2636882795","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2636882795"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/125#discussion_r2636882795"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/125"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2636882795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":90,"original_line":90,"side":"RIGHT","in_reply_to_id":2635252429,"author_association":"MEMBER","original_position":90,"position":90,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":124,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/124","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #124] refactor: implement dump replacement of all APIs from \"/{resource}\" to \"/{service-name}/v{maj}/{resourc
:{\n+    FileParseResponseDto, FileParserInfoDto, ParseLocalRequest, ParseUrlRequest, ParsedDocumentDto,\n+};\n+use crate::domain::markdown::MarkdownRenderer;\n+use modkit::api::prelude::*;\n+\n+use crate::domain::service::FileParserService;\n+\n+// Import auth extractors\n+use modkit_auth::axum_ext::Authz;\n+\n+// Type aliases for our specific API with DomainError\n+use crate::domain::error::DomainError;\n+type FileParserResult<T> = ApiResult<T, DomainError>;\n+type FileParserApiError = ApiError<DomainError>;\n+\n+/// Query parameter for render_markdown flag\n+#[derive(Debug, serde::Deserialize)]\n+pub struct RenderMarkdownQuery {\n+    #[serde(default)]\n+    pub render_markdown: Option<bool>,\n+}\n+\n+/// Get information about available file parsers\n+#[tracing::instrument(\n+    name = \"file_parser.get_parser_info\",\n+    skip(svc, _ctx),\n+    fields(\n+        request_id = Empty\n+    )\n+)]\n+#[axum::debug_handler]\n+pub async fn get_parser_info(\n+    Authz(_ctx): Authz,\n+    Extension(svc): Extension<std::sync::Arc<FileParserService>>,\n+) -> FileParserResult<JsonBody<FileParserInfoDto>> {\n+    info!(\"Getting file parser info\");\n+\n+    let info = svc.info();\n+\n+    Ok(Json(FileParserInfoDto::from(info)))\n+}\n+\n+/// Parse a file from a local path\n+#[tracing::instrument(\n+    name = \"file_parser.parse_local\",","path":"modules/file_parser/src/api/rest/handlers.rs","commit_id":"a940db52fecf5c8db9752e0986f8b4a8c5659b35","original_commit_id":"892676b82f1ca19c53b6f383b867e889fe5fe449","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url"
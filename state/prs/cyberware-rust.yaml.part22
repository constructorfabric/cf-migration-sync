s://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2580759031/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2580775651","pull_request_review_id":3529588982,"id":2580775651,"node_id":"PRRC_kwDOPaLyBs6Z04Lj","diff_hunk":"@@ -0,0 +1,120 @@\n+use machine_uid;\n+use uuid::Uuid;\n+\n+/// Get a permanent hardware-based UUID for this machine.\n+/// This UUID is the actual hardware identifier and will remain consistent\n+/// across reboots and application restarts.\n+///\n+/// Platform-specific implementations:\n+/// - macOS: Uses IOPlatformUUID from IOKit (already a UUID)\n+/// - Linux: Uses /etc/machine-id or /var/lib/dbus/machine-id (converted to UUID)\n+/// - Windows: Uses MachineGuid from registry (already a UUID)\n+///\n+/// Returns a hybrid UUID (00000000-0000-0000-xxxx-xxxxxxxxxxxx) if detection fails,\n+/// where the left part is all zeros and the right part is random for uniqueness.\n+pub fn get_hardware_uuid() -> Uuid {\n+    match machine_uid::get() {\n+        Ok(machine_id) => {\n+            // Try to parse the machine_id as a UUID directly\n+            match Uuid::parse_str(&machine_id) {\n+                Ok(uuid) => {\n+                    tracing::debug!(\n+                        machine_id = %machine_id,\n+                        node_uuid = %uuid,\n+                        \"Using hardware UUID\"\n+                    );\n+                    uuid\n+                }\n+                Err(parse_err) => {\n+                    // If it's not a valid UUID format, hash it to create one\n+                    tracing::warn!(\n+                        machine_id = %machine_id,\n+                        error = %parse_err,\n+                        \"Machine ID is not a valid UUID, using hash-based UUID\"\n+                    );\n+\n+                    // Use UUID v5 to create a deterministic UUID from the machine ID\n+                    const HYPERSPOT_NAMESPACE: Uuid = Uuid::from_bytes([","path":"libs/modkit-node-info/src/hardware_uuid.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Where this static bytes come from? We would need to document them or collect this and future namespaces in another module or another place that it's not lost from inside of a function","created_at":"2025-12-02T11:28:50Z","updated_at":"2025-12-02T11:30:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2580775651","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2580
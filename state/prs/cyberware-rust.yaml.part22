t/issues/32/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/32/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/32/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/3f1b95c3c232471937b32195ce33fb068d55d647"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":31,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/31","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #31] feat: add file_parser module and improve Axum path handling","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/file_parser_module_latest","pr_head_sha":"9e3c7405e44dd3ec4f5dc7c936ebae96e2bb3440","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/31","id":3040687185,"node_id":"PR_kwDOPaLyBs61PTRR","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/31","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/31.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/31.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/31","number":31,"state":"closed","locked":false,"title":"feat: add file_parser module and improve Axum path handling","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"- Add new file_parser module with multi-format document parsing capabilities and modernize path handling to use Axum 0.8+ syntax throughout the framework.\r\n\r\nFile Parser Module:\r\n- Implement unified document parsing for PDF, DOCX, HTML, and plain text\r\n- Add intermediate representation (IR) for structured content extraction\r\n- Support markdown conversion for parsed documents\r\n- Provide REST API endpoints for file parsing operations\r\n\r\nPath Handling Improvements:\r\n- Add normalize_to_axum_path() and axum_to_openapi_path() helper functions\r\n- Update OperationBuilder to store paths in Axum 0.8+ format ({id}, {*path})\r\n- Update MIME validation middleware to use MatchedPath extension for accurate route matching\r\n\r\nMiddleware Enhancements:\r\n- Implement per-operation MIME type validation with 415 responses\r\n- Use Axum's MatchedPath extension for reliable parameter route matching\r\n- Improve fallback handling for unmatched routes","created_at":"2025-11-24T16:32:52Z","updated_at":"2025-11-30T09:14:01Z","closed_at":"2025-11-30T09:14:01Z","merged_at":"2025-11-30T09:14:01Z","merge_commit_sha":"50d247a159a0046cd0448633e501fbeed58ec7f9","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfab
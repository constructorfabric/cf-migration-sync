).one(tx).await\n+}\n+\n+/// Update user's settings\n+pub async fn update<TX>(","path":"modules/settings/src/infra/storage/entity.rs","commit_id":"582f8a5a47e89b907ae19ac5d7c3132b5e13ed97","original_commit_id":"0175334f86971d59a81934aea680ae412723760f","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"what if we have a generic upsert (save) method that handles DB timeout/retries, and such ","created_at":"2025-09-10T09:40:16Z","updated_at":"2025-09-10T09:53:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/6#discussion_r2336184703","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/6","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2336184703"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/6#discussion_r2336184703"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/6"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2336184703/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray
SysInfoCollector;\n+use std::sync::Arc;\n+\n+/// Collects system capabilities for the current node\n+pub struct SysCapCollector {\n+    sysinfo_collector: Arc<SysInfoCollector>,\n+}\n+\n+impl SysCapCollector {\n+    pub fn new() -> Self {\n+        Self {\n+            sysinfo_collector: Arc::new(SysInfoCollector::new()),\n+        }\n+    }\n+\n+    /// Helper to create a SysCap with cache metadata\n+    fn create_syscap(\n+        key: String,\n+        category: String,\n+        name: String,\n+        display_name: String,\n+        present: bool,\n+        version: Option<String>,\n+        amount: Option<f64>,\n+        amount_dimension: Option<String>,\n+        details: Option<String>,\n+        cache_ttl_secs: u64,\n+    ) -> SysCap {\n+        SysCap {\n+            key,\n+            category,\n+            name,\n+            display_name,\n+            present,\n+            version,\n+            amount,\n+            amount_dimension,\n+            details,\n+            cache_ttl_secs,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        }\n+    }\n+\n+    /// Collect current system capabilities using sysinfo data\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysCap, NodeInfoError> {\n+        // Collect sysinfo first to use its data\n+        let sysinfo = self.sysinfo_collector.collect(node_id)?;\n+\n+        let mut capabilities = Vec::new();\n+\n+        // Collect hardware capabilities using sysinfo data\n+        capabilities.extend(self.collect_hardware_caps(&sysinfo)?);\n+\n+        // Collect OS capabilities using sysinfo data\n+        capabilities.extend(self.collect_os_caps(&sysinfo)?);\n+\n+        // Collect GPU capabilities using sysinfo data\n+        capabilities.extend(self.collect_gpu_caps(&sysinfo)?);\n+\n+        // Collect battery capabilities using sysinfo data\n+        capabilities.extend(self.collect_battery_caps(&sysinfo)?);\n+\n+        // Collect software capabilities\n+        capabilities.extend(self.collect_software_caps()?);\n+\n+        Ok(NodeSysCap {\n+            node_id,\n+            capabilities,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_hardware_caps(&self, sysinfo: &NodeSysInfo) -> Result<Vec<SysCap>, NodeInfoError> {\n+        let mut caps = Vec::new();\n+\n+        // Architecture detection from sysinfo\n+        let arch = &sysinfo.os.arch;\n+        caps.push(Self::create_syscap(\n+            format!(\"hardware:{}\", arch),\n+            \"hardware\".to_string(),\n+            arch.to_string(),\n+            arch.to_uppercase(),\n+            true,\n+            None,\n+            None,\n+            None,\n+            Some(format!(\"{} architecture detected\", arch)),\n+            3600, // 1 hour cache (never changes)\n+        ));\n+\n+        // RAM detection from sysinfo\n+        let total_gb = sysinfo.memory.total_bytes as f64 / (1024.0 * 1024.0 * 1024.0);\n+        caps.push(Self::create_syscap(\n+            \"hardware:ram\".to_string(),\n+            \"hardware\".to_string(),\n+            \"ram\".to_string(),\n+            \"RAM\".to_string(),\n+            true,\n+            None,\n+            Some(total_gb),\n+            Some(\"GB\".to_string()),\n+            Some(format!(\n+                \"Total: {:.2} GB, Used: {}%\",\n+                total_gb, sysinfo.memory.used_percent\n+            )),\n+            5, // 5 seconds cache (changes frequently)\n+        ));\n+\n+        // CPU capability from sysinfo\n+        caps.push(Self::create_syscap(\n+            \"hardware:cpu\".to_string(),\n+            \"hardware\".to_string(),\n+            \"cpu\".to_string(),\n+            \"CPU\".to_string(),\n+            true,\n+            Some(sysinfo.cpu.model.clone()),\n+            Some(sysinfo.cpu.cores as f64),\n+            Some(\"cores\".to_string()),\n+            Some(format!(\n+                \"{} with {} cores @ {:.0} MHz\",\n+                sysinfo.cpu.model, sysinfo.cpu.cores, sysinfo.cpu.frequency_mhz\n+            )),\n+            600, // 10 minutes cache (changes rarely)\n+        ));\n+\n+        Ok(caps)\n+    }\n+\n+    fn collect_os_caps(&self, sysinfo: &NodeSysInfo) -> Result<Vec<SysCap>, NodeInfoError> {\n+        let mut caps = Vec::new();","path":"libs/modkit-node-info/src/syscap_collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"same here","created_at":"2025-12-03T08:04:25Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584040959","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584040959"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2584040959"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":
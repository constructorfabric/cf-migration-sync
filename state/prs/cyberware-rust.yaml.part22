 display_name: String,\n+        present: bool,\n+        version: Option<String>,\n+        amount: Option<f64>,\n+        amount_dimension: Option<String>,\n+        details: Option<String>,\n+        cache_ttl_secs: u64,\n+    ) -> SysCap {\n+        SysCap {\n+            key,\n+            category,\n+            name,\n+            display_name,\n+            present,\n+            version,\n+            amount,\n+            amount_dimension,\n+            details,\n+            cache_ttl_secs,\n+            fetched_at_secs: chrono::Utc::now().timestamp(),\n+        }\n+    }\n+\n+    /// Collect current system capabilities using sysinfo data\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysCap, NodeInfoError> {","path":"libs/modkit-node-info/src/syscap_collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"could you please make it as separate PR? I mean combine all the ideomatic Rust optimizations as single PR","created_at":"202
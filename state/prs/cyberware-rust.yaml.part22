es\n+\n+- **Human owner**: decides scope, accepts/declines changes, merges PRs.\n+- **TOP-GRADE LLM**: creates architecture/code skeletons and higher-level reasoning.\n+- **LOW-GRADE LLM**: fixes compilation/lints without changing intended behavior.\n+\n+## Non-negotiable project constraints\n+\n+- Follow:\n+  - `guidelines/NEW_MODULE.md`\n+  - `docs/MODKIT_UNIFIED_SYSTEM.md`\n+  - `docs/TRACING_SETUP.md`\n+- SDK pattern:\n+  - `<module>-sdk` contains **public API** (traits/models/errors; transport-agnostic)\n+  - `<module>` contains **implementation** (domain, infra, REST, local client)\n+- All SDK API methods take `&SecurityCtx`.\n+- REST is wired via ModKit `OperationBuilder` (type-safe routes + OpenAPI).\n+- Always keep `make all` green before moving to the next phase.\n+\n+## Standard artifacts (authoritative filenames)\n+\n+All are under `modules/{module_name}/docs/`:\n+\n+- `1_INTENT_DESIGN.md`\n+- `2_INTENT_FACTS.md`\n+- `3_INTENT_SCENARIOS.md`\n+- `4_ACTUAL_DESIGN.md`\n+- `5_ACTUAL_FACTS.md`\n+- `6_ACTUAL_SCENARIOS.md`\n+- `7_INTENT_VS_ACTUAL.md`\n+\n+\n+## Code generation flow\n+\n+- Follow the 5 phases below separately\n+- Stop after every phase, submit a PR and get approvals from stakeholders\n+\n+| # | Phase | Delivery |\n+| --- | --- | --- |\n+| 1 | Intent design | `1_INTENT_DESIGN.md` |\n+| 2 | Intent facts + scenarios | `2_INTENT_FACTS.md`, `3_INTENT_SCENARIOS.md` |\n+| 3 | Code for v1 scenarios | all the needed modules code, compilable, v2+ code stubs, actual design `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` |\n+| 4 | Tests for v1 scenarios | all the needed modules tests, compilable, v2+ code stubs |\n+\n+For v2+ - repeat 3,4 above, actualize the code, tests, `4_ACTUAL_DESIGN.md`, `5_ACTUAL_FACTS.md`, `6_ACTUAL_SCENARIOS.md`, `7_INTENT_VS_ACTUAL.md` after each phase.","path":"guidelines/CODE_GEN_PIPELINE.md","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"what is v2+? It needs clarification","created_at":"2025-12-29T12:20:29Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650854882","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650854882"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650854882"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650854882/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":54,"side":"RIGHT","author_association":"MEMBER","original_position":54,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650860672","pull_request_review_id":3615759387,"id":2650860672,"node_id":"PRRC_kwDOPaLyBs6eAOyA","diff_hunk":"@@ -0,0 +1,470 @@\n+//! Domain service for OAGW.\n+//!\n+//! This service orchestrates all business logic for outbound API invocations,\n+//! route/link management, and plugin selection.\n+\n+use std::sync::Arc;\n+\n+use modkit::client_hub::ClientHub;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::{AccessScope, PolicyEngineRef, SecurityContext};\n+use oagw_sdk::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwPluginApi,\n+    OagwResponseStream, Route, RoutePatch,\n+};\n+use tracing::{info_span, instrument, Instrument};\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+use super::ports::SecretResolver;\n+use super::repo::{LinkRepository, RouteRepository};\n+use crate::config::OagwConfig;\n+\n+/// Service configuration extracted from module config.\n+#[derive(Debug, Clone)]\n+pub struct ServiceConfig {\n+    /// Default connection timeout in milliseconds.\n+    pub default_connection_timeout_ms: u64,\n+    /// Default request timeout in milliseconds.\n+    pub default_request_timeout_ms: u64,\n+}\n+\n+impl From<&OagwConfig> for ServiceConfig {\n+    fn from(cfg: &OagwConfig) -> Self {\n+        Self {\n+            default_connection_timeout_ms: cfg.default_connection_timeout_ms,\n+            default_request_timeout_ms: cfg.default_request_timeout_ms,\n+        }\n+    }\n+}\n+\n+/// Domain service for OAGW operations.\n+pub struct Service {\n+    policy_engine: PolicyEngineRef,\n+    route_repo: Arc<dyn RouteRepository>,\n+    link_repo: Arc<dyn LinkRepository>,\n+    secret_resolver: Arc<dyn SecretResolver>,\n+    client_hub: Arc<ClientHub>,\n+    config: ServiceConfig,\n+}\n+\n+impl Service {\n+    /// Create a new service instance.\n+    pub fn new(\n+        route_repo: Arc<dyn RouteRepository>,\n+        link_repo: Arc<dyn LinkRepository>,\n+        secret_resolver: Arc<dyn SecretResolver>,\n+        client_hub: Arc<ClientHub>,\n+        config: ServiceConfig,\n+    ) -> Self {\n+        Self {\n+            policy_engine: Arc::new(modkit_security::DummyPolicyEngine),","path":"modules/oagw/oagw-gw/src/domain/service.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Construction of policy_engine inside new violates DI principles. Dependency should be passed via constructor.","created_at":"2025-12-29T12:23:58Z","updated_at":"2025-12-29T13:39:19Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650860672","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650860672"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650860672"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650860672/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":61,"side":"RIGHT","author_association":"MEMBER","original_position":61,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650861157","pull_request_review_id":3615733354,"id":2650861157,"node_id":"PRRC_kwDOPaLyBs6eAO5l","diff_hunk":"@@ -0,0 +1,55 @@\n+[package]\n+name = \"oagw-gw\"\n+version.workspace = true\n+publish = false\n+edition.workspace = true\n+license.workspace = true\n+authors.workspace = true\n+description = \"OAGW (Outbound API Gateway) module implementation\"\n+\n+[lints]\n+workspace = true\n+\n+[dependencies]\n+# SDK - public API, models, and errors\n+oagw-sdk = { path = \"../oagw-sdk\" }\n+\n+# Core dependencies\n+anyhow = { workspace = true }\n+async-trait = { workspace = true }\n+tokio = { workspace = true }\n+tracing = { workspace = true }\n+inventory = { workspace = true }\n+serde = { workspace = true }\n+serde_json = { workspace = true }\n+utoipa = { workspace = true }\n+axum = { workspace = true, features = [\"macros\"] }\n+tower-http = { workspace = true, features = [\"timeout\"] }","path":"modules/oagw/oagw-gw/Cargo.toml","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"no need to specify features that are already on the top-level","created_at":"2025-12-29T12:24:16Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650861157","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650861157"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650861157"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650861157/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":27,"side":"RIGHT","author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650865676","pull_request_review_id":3615733354,"id":2650865676,"node_id":"PRRC_kwDOPaLyBs6eAQAM","diff_hunk":"@@ -0,0 +1,340 @@\n+//! REST DTOs for OAGW.\n+//!\n+//! These DTOs have serde and utoipa derives for REST serialization.\n+\n+use chrono::{DateTime, Utc};\n+use oagw_sdk::{\n+    HttpMethod, Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse,\n+    RetryIntent, Route, RoutePatch,\n+};\n+use serde::{Deserialize, Serialize};\n+use std::collections::HashMap;\n+use utoipa::ToSchema;\n+use uuid::Uuid;\n+\n+// === Route DTOs ===\n+\n+/// Response DTO for a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct RouteDto {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub base_url: String,\n+    pub rate_limit_req_per_min: i32,\n+    pub auth_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub cache_ttl_sec: Option<i32>,\n+    pub supported_protocols: Vec<String>,\n+    pub created_at: DateTime<Utc>,\n+    pub updated_at: DateTime<Utc>,\n+}\n+\n+impl From<Route> for RouteDto {\n+    fn from(route: Route) -> Self {\n+        Self {\n+            id: route.id,\n+            tenant_id: route.tenant_id,\n+            base_url: route.base_url,\n+            rate_limit_req_per_min: route.rate_limit_req_per_min,\n+            auth_type_gts_id: route.auth_type_gts_id,\n+            cache_ttl_sec: route.cache_ttl_sec,\n+            supported_protocols: route.supported_protocols,\n+            created_at: route.created_at,\n+            updated_at: route.updated_at,\n+        }\n+    }\n+}\n+\n+/// Request DTO for creating a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct CreateRouteRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub id: Option<Uuid>,\n+    pub base_url: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub rate_limit_req_per_min: Option<i32>,\n+    pub auth_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub cache_ttl_sec: Option<i32>,\n+    #[serde(default)]\n+    pub supported_protocols: Vec<String>,\n+}\n+\n+impl CreateRouteRequest {\n+    /// Convert to domain model with tenant ID from security context.\n+    pub fn into_new_route(self, tenant_id: Uuid) -> NewRoute {\n+        NewRoute {\n+            id: self.id,\n+            tenant_id,\n+            base_url: self.base_url,\n+            rate_limit_req_per_min: self.rate_limit_req_per_min,\n+            auth_type_gts_id: self.auth_type_gts_id,\n+            cache_ttl_sec: self.cache_ttl_sec,\n+            supported_protocols: self.supported_protocols,\n+        }\n+    }\n+}\n+\n+/// Request DTO for updating a route.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct UpdateRouteRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub base_url: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub rate_limit_req_per_min: Option<i32>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub auth_type_gts_id: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    #[allow(clippy::option_option)] // Intentional: distinguish set-to-null from not-set\n+    pub cache_ttl_sec: Option<Option<i32>>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub supported_protocols: Option<Vec<String>>,\n+}\n+\n+impl From<UpdateRouteRequest> for RoutePatch {\n+    fn from(req: UpdateRouteRequest) -> Self {\n+        Self {\n+            base_url: req.base_url,\n+            rate_limit_req_per_min: req.rate_limit_req_per_min,\n+            auth_type_gts_id: req.auth_type_gts_id,\n+            cache_ttl_sec: req.cache_ttl_sec,\n+            supported_protocols: req.supported_protocols,\n+        }\n+    }\n+}\n+\n+// === Link DTOs ===\n+\n+/// Response DTO for a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct LinkDto {\n+    pub id: Uuid,\n+    pub tenant_id: Uuid,\n+    pub secret_ref: Uuid,\n+    pub route_id: Uuid,\n+    pub secret_type_gts_id: String,\n+    pub enabled: bool,\n+    pub priority: i32,\n+    pub strategy_gts_id: String,\n+    pub created_at: DateTime<Utc>,\n+    pub updated_at: DateTime<Utc>,\n+}\n+\n+impl From<Link> for LinkDto {\n+    fn from(link: Link) -> Self {\n+        Self {\n+            id: link.id,\n+            tenant_id: link.tenant_id,\n+            secret_ref: link.secret_ref,\n+            route_id: link.route_id,\n+            secret_type_gts_id: link.secret_type_gts_id,\n+            enabled: link.enabled,\n+            priority: link.priority,\n+            strategy_gts_id: link.strategy_gts_id,\n+            created_at: link.created_at,\n+            updated_at: link.updated_at,\n+        }\n+    }\n+}\n+\n+/// Request DTO for creating a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct CreateLinkRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub id: Option<Uuid>,\n+    pub secret_ref: Uuid,\n+    pub route_id: Uuid,\n+    pub secret_type_gts_id: String,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub enabled: Option<bool>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub priority: Option<i32>,\n+    pub strategy_gts_id: String,\n+}\n+\n+impl CreateLinkRequest {\n+    /// Convert to domain model with tenant ID from security context.\n+    pub fn into_new_link(self, tenant_id: Uuid) -> NewLink {\n+        NewLink {\n+            id: self.id,\n+            tenant_id,\n+            secret_ref: self.secret_ref,\n+            route_id: self.route_id,\n+            secret_type_gts_id: self.secret_type_gts_id,\n+            enabled: self.enabled,\n+            priority: self.priority,\n+            strategy_gts_id: self.strategy_gts_id,\n+        }\n+    }\n+}\n+\n+/// Request DTO for updating a link.\n+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]\n+#[serde(rename_all = \"camelCase\")]\n+pub struct UpdateLinkRequest {\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub secret_ref: Option<Uuid>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub secret_type_gts_id: Option<String>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub enabled: Option<bool>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub priority: Option<i32>,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub strategy_gts_id: Option<String>,\n+}\n+\n+impl From<UpdateLinkRequest> for LinkPatch {\n+    fn from(req: UpdateLinkRequest) -> Self {\n+        Self {\n+            secret_ref: req.secret_ref,\n+            secret_type_gts_id: req.secret_type_gts_id,\n+            enabled: req.enabled,\n+            priority: req.priority,\n+            strategy_gts_id: req.strategy_gts_id,\n+        }\n+    }\n+}\n+\n+// === Invocation DTOs ===\n+\n+/// HTTP method for invocation requests.\n+#[derive(Debug, Clone, Copy, Serialize, Deserialize, ToSchema, PartialEq, Eq)]\n+#[serde(rename_all = \"UPPERCASE\")]\n+pub enum HttpMethodDto {","path":"modules/oagw/oagw-gw/src/api/rest/dto.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why? we already have axum::http or http package","created_at":"2025-12-29T12:27:00Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650865676","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650865676"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650865676"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650865676/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":209,"side":"RIGHT","author_association":"MEMBER","original_position":209,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650870336","pull_request_review_id":3615733354,"id":2650870336,"node_id":"PRRC_kwDOPaLyBs6eARJA","diff_hunk":"@@ -0,0 +1,145 @@\n+//! REST error mapping for OAGW.\n+\n+use http::StatusCode;\n+use modkit::api::problem::Problem;\n+\n+use crate::domain::error::DomainError;\n+\n+/// Convert DomainError to Problem for REST responses.\n+impl From<DomainError> for Problem {","path":"modules/oagw/oagw-gw/src/api/rest/error.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why this implementation lives here? Very confusing, should live in the domain::error","created_at":"2025-12-29T12:29:51Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650870336","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650870336"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650870336"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650870336/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":9,"side":"RIGHT","author_association":"MEMBER","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650875132","pull_request_review_id":3615773952,"id":2650875132,"node_id":"PRRC_kwDOPaLyBs6eAST8","diff_hunk":"@@ -0,0 +1,470 @@\n+//! Domain service for OAGW.\n+//!\n+//! This service orchestrates all business logic for outbound API invocations,\n+//! route/link management, and plugin selection.\n+\n+use std::sync::Arc;\n+\n+use modkit::client_hub::ClientHub;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::{AccessScope, PolicyEngineRef, SecurityContext};\n+use oagw_sdk::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwPluginApi,\n+    OagwResponseStream, Route, RoutePatch,\n+};\n+use tracing::{info_span, instrument, Instrument};\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+use super::ports::SecretResolver;\n+use super::repo::{LinkRepository, RouteRepository};\n+use crate::config::OagwConfig;\n+\n+/// Service configuration extracted from module config.\n+#[derive(Debug, Clone)]\n+pub struct ServiceConfig {\n+    /// Default connection timeout in milliseconds.\n+    pub default_connection_timeout_ms: u64,\n+    /// Default request timeout in milliseconds.\n+    pub default_request_timeout_ms: u64,\n+}\n+\n+impl From<&OagwConfig> for ServiceConfig {\n+    fn from(cfg: &OagwConfig) -> Self {\n+        Self {\n+            default_connection_timeout_ms: cfg.default_connection_timeout_ms,\n+            default_request_timeout_ms: cfg.default_request_timeout_ms,\n+        }\n+    }\n+}\n+\n+/// Domain service for OAGW operations.\n+pub struct Service {\n+    policy_engine: PolicyEngineRef,\n+    route_repo: Arc<dyn RouteRepository>,\n+    link_repo: Arc<dyn LinkRepository>,\n+    secret_resolver: Arc<dyn SecretResolver>,\n+    client_hub: Arc<ClientHub>,\n+    config: ServiceConfig,\n+}\n+\n+impl Service {\n+    /// Create a new service instance.\n+    pub fn new(\n+        route_repo: Arc<dyn RouteRepository>,\n+        link_repo: Arc<dyn LinkRepository>,\n+        secret_resolver: Arc<dyn SecretResolver>,\n+        client_hub: Arc<ClientHub>,\n+        config: ServiceConfig,\n+    ) -> Self {\n+        Self {\n+            policy_engine: Arc::new(modkit_security::DummyPolicyEngine),\n+            route_repo,\n+            link_repo,\n+            secret_resolver,\n+            client_hub,\n+            config,\n+        }\n+    }\n+\n+    /// Convert SecurityContext to AccessScope for repository operations.\n+    async fn prepare_scope(&self, ctx: &SecurityContext) -> Result<AccessScope, DomainError> {\n+        ctx.scope(self.policy_engine.clone())\n+            .include_tenant_children()\n+            .prepare()\n+            .await\n+            .map_err(|e| DomainError::Authorization(e.to_string()))\n+    }\n+\n+    // === Invocation Methods ===\n+\n+    /// Invoke an outbound API with unary semantics.\n+    #[instrument(skip(self, ctx, req), fields(route_id = %req.route_id, method = %req.method))]\n+    pub async fn invoke_unary(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: OagwInvokeRequest,\n+    ) -> Result<OagwInvokeResponse, DomainError> {\n+        let start = std::time::Instant::now();\n+        let scope = self.prepare_scope(ctx).await?;\n+\n+        // Step 1.3: Route Resolution\n+        let route = self.resolve_route(&scope, req.route_id).await?;\n+\n+        // Step 1.4: Link Selection\n+        let link = self.select_link(&scope, &route, req.link_id).await?;\n+\n+        // TODO(v2): Step 1.5 - Rate Limit Check\n+        // TODO(v3): Check circuit breaker state\n+\n+        // Step 1.6: Plugin Selection\n+        let plugin = self.select_plugin()?;\n+\n+        // Step 1.7: Secret Resolution\n+        let secret = self\n+            .secret_resolver\n+            .get_secret(ctx, link.secret_ref)\n+            .await?;\n+\n+        // Step 1.8: Authentication Preparation is handled by plugin\n+\n+        // Step 1.9-1.11: Request Construction and Plugin Invocation\n+        let timeout_ms = req\n+            .timeout_ms\n+            .unwrap_or(self.config.default_request_timeout_ms);\n+\n+        let invoke_req = OagwInvokeRequest {\n+            timeout_ms: Some(timeout_ms),\n+            ..req\n+        };\n+\n+        let response = plugin\n+            .invoke_unary(ctx, &link, &route, &secret, invoke_req)\n+            .instrument(info_span!(\"plugin_invoke\"))\n+            .await\n+            .map_err(|e| match e {\n+                oagw_sdk::OagwError::ConnectionTimeout => DomainError::ConnectionTimeout,\n+                oagw_sdk::OagwError::RequestTimeout => DomainError::RequestTimeout,\n+                oagw_sdk::OagwError::DownstreamError {\n+                    status_code,\n+                    retry_after_sec,\n+                } => DomainError::DownstreamError {\n+                    status_code,\n+                    retry_after_sec,\n+                },\n+                other => DomainError::Database(anyhow::anyhow!(\"{other}\")),\n+            })?;\n+\n+        // TODO(v3): Step 1.12 - Circuit Breaker Update\n+        // TODO(v2): Step 1.13 - Audit Logging\n+        // TODO(v2): Step 1.14 - Metrics Recording\n+\n+        // Duration in ms is always small enough for u64 in practice\n+        #[allow(clippy::cast_possible_truncation)]\n+        let duration_ms = start.elapsed().as_millis() as u64;\n+        tracing::info!(\n+            duration_ms,\n+            status_code = response.status_code,\n+            link_id = %link.id,\n+            \"Invocation completed\"\n+        );\n+\n+        Ok(response)\n+    }\n+\n+    /// Invoke an outbound API with streaming response.\n+    #[instrument(skip(self, ctx, req), fields(route_id = %req.route_id, method = %req.method))]\n+    pub async fn invoke_stream(\n+        &self,\n+        ctx: &SecurityContext,\n+        req: OagwInvokeRequest,\n+    ) -> Result<OagwResponseStream, DomainError> {\n+        // TODO(v2): Implement streaming invocation\n+        // For v1, streaming is not supported\n+        tracing::warn!(\"Streaming invocation not yet implemented (v2)\");\n+\n+        let scope = self.prepare_scope(ctx).await?;\n+\n+        // Resolve route and link for validation\n+        let route = self.resolve_route(&scope, req.route_id).await?;\n+        let link = self.select_link(&scope, &route, req.link_id).await?;\n+        let plugin = self.select_plugin()?;\n+        let secret = self\n+            .secret_resolver\n+            .get_secret(ctx, link.secret_ref)\n+            .await?;\n+\n+        let timeout_ms = req\n+            .timeout_ms\n+            .unwrap_or(self.config.default_request_timeout_ms);\n+\n+        let invoke_req = OagwInvokeRequest {\n+            timeout_ms: Some(timeout_ms),\n+            ..req\n+        };\n+\n+        plugin\n+            .invoke_stream(ctx, &link, &route, &secret, invoke_req)\n+            .await\n+            .map_err(|e| DomainError::Database(anyhow::anyhow!(\"{e}\")))\n+    }\n+\n+    // === Route Resolution ===\n+\n+    /// Resolve a route by ID with tenant scoping.\n+    async fn resolve_route(\n+        &self,\n+        scope: &AccessScope,\n+        route_id: Uuid,\n+    ) -> Result<Route, DomainError> {\n+        self.route_repo\n+            .find_by_id(scope, route_id)\n+            .await?\n+            .ok_or(DomainError::RouteNotFound { id: route_id })\n+    }\n+\n+    // === Link Selection ===\n+\n+    /// Select a link for invocation.\n+    ///\n+    /// If `link_id` is provided, use that specific link.\n+    /// Otherwise, select the best available link based on priority.\n+    async fn select_link(\n+        &self,\n+        scope: &AccessScope,\n+        route: &Route,\n+        link_id: Option<Uuid>,\n+    ) -> Result<Link, DomainError> {\n+        if let Some(id) = link_id {\n+            // Step 1.4a: Use specified link directly\n+            let link = self\n+                .link_repo\n+                .find_by_id(scope, id)\n+                .await?\n+                .ok_or(DomainError::LinkNotFound { id })?;\n+\n+            // Verify link is enabled and belongs to the route\n+            if !link.enabled {\n+                return Err(DomainError::LinkNotFound { id });\n+            }\n+            if link.route_id != route.id {\n+                return Err(DomainError::Validation {\n+                    field: \"link_id\".to_string(),\n+                    message: format!(\"Link {id} does not belong to route {}\", route.id),\n+                });\n+            }\n+            return Ok(link);\n+        }\n+\n+        // Step 1.4b: Auto-select link\n+        let links = self\n+            .link_repo\n+            .find_enabled_by_route(scope, route.id)\n+            .await?;\n+\n+        if links.is_empty() {\n+            return Err(DomainError::LinkUnavailable { route_id: route.id });\n+        }\n+\n+        // TODO(v3): Filter out links with open circuit breakers\n+        // TODO(v4): Apply strategy-based selection (sticky session, round robin)\n+\n+        // v1: Select first available link by priority (already sorted)\n+        let mut sorted_links = links;\n+        sorted_links.sort_by_key(|l| l.priority);\n+\n+        sorted_links\n+            .into_iter()\n+            .next()\n+            .ok_or(DomainError::LinkUnavailable { route_id: route.id })\n+    }\n+\n+    // === Plugin Selection ===\n+\n+    /// Select a plugin that supports the route's protocol and auth type.\n+    ///\n+    /// TODO(v1): Implement full plugin discovery via types-registry.\n+    /// For now, returns the first registered plugin from ClientHub.\n+    fn select_plugin(&self) -> Result<Arc<dyn OagwPluginApi>, DomainError> {","path":"modules/oagw/oagw-gw/src/domain/service.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is cutting corner for v1. \r\n\r\nsuggestion: it would be helpful to have ACTUAL_vs_INTENT on the stage of implementation PR like this, so that these kind of simplifications become transparent","created_at":"2025-12-29T12:32:41Z","updated_at":"2025-12-29T12:32:41Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650875132","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650875132"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650875132"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650875132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":268,"side":"RIGHT","author_association":"MEMBER","original_position":268,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650876056","pull_request_review_id":3615733354,"id":2650876056,"node_id":"PRRC_kwDOPaLyBs6eASiY","diff_hunk":"@@ -0,0 +1,223 @@\n+//! REST handlers for OAGW.\n+//!\n+//! Handlers are thin: parse/validate input, call domain service, map errors to Problem.\n+\n+use std::sync::Arc;\n+\n+use axum::extract::{Extension, Path};\n+use axum::http::Uri;\n+use axum::Json;\n+use modkit::api::odata::OData;\n+use modkit::api::prelude::*;\n+use modkit_security::SecurityContext;\n+use uuid::Uuid;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use crate::domain::service::Service;\n+\n+// === Health Endpoints ===\n+\n+/// GET /oagw/v1/health - Liveness probe (no auth required).\n+pub async fn health() -> ApiResult<JsonBody<HealthResponse>> {\n+    Ok(Json(HealthResponse::default()))\n+}\n+\n+/// GET /oagw/v1/ready - Readiness probe (no auth required).\n+///\n+/// TODO(v2): Check database connectivity and other critical dependencies.\n+pub async fn ready() -> ApiResult<JsonBody<HealthResponse>> {\n+    // TODO(v2): Implement actual readiness checks\n+    Ok(Json(HealthResponse::default()))\n+}\n+\n+// === Route Endpoints ===\n+\n+/// POST /oagw/v1/routes - Create a new route.\n+#[tracing::instrument(skip(ctx, svc, req), fields(base_url = %req.base_url))]\n+pub async fn create_route(\n+    uri: Uri,\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(svc): Extension<Arc<Service>>,\n+    Json(req): Json<CreateRouteRequest>,\n+) -> ApiResult<impl axum::response::IntoResponse> {\n+    let tenant_id = ctx.tenant_id();\n+    let new_route = req.into_new_route(tenant_id);\n+\n+    let route = svc.create_route(&ctx, new_route).await?;\n+    let id_str = route.id.to_string();\n+\n+    Ok(created_json(RouteDto::from(route), &uri, &id_str))\n+}\n+\n+/// GET /oagw/v1/routes - List routes with OData pagination.\n+#[tracing::instrument(skip(ctx, svc))]\n+pub async fn list_routes(\n+    Extension(ctx): Extension<SecurityContext>,\n+    Extension(svc): Extension<Arc<Service>>,\n+    OData(query): OData,","path":"modules/oagw/oagw-gw/src/api/rest/handlers.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"do we want to support $select? ","created_at":"2025-12-29T12:33:11Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650876056","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650876056"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650876056"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650876056/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":60,"side":"RIGHT","author_association":"MEMBER","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650884736","pull_request_review_id":3615733354,"id":2650884736,"node_id":"PRRC_kwDOPaLyBs6eAUqA","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Routes => \"oagw.routes\",\n+            Self::Links => \"oagw.links\",\n+            Self::Invoke => \"oagw.invoke\",\n+            Self::Health => \"oagw.health\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+/// Action enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Action {\n+    Create,\n+    Read,\n+    Update,\n+    Delete,\n+    Execute,\n+}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Create => \"create\",\n+            Self::Read => \"read\",\n+            Self::Update => \"update\",\n+            Self::Delete => \"delete\",\n+            Self::Execute => \"execute\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+/// Register all OAGW REST routes.\n+#[allow(clippy::too_many_lines)] // Route registration is naturally verbose\n+#[allow(clippy::unnecessary_wraps)] // Result needed for error propagation in future\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<Service>,\n+) -> anyhow::Result<Router> {\n+    // === Health Endpoints (public, no auth) ===\n+\n+    // GET /oagw/v1/health - Liveness probe\n+    router = OperationBuilder::get(\"/oagw/v1/health\")\n+        .operation_id(\"oagw.health\")\n+        .summary(\"Liveness probe\")\n+        .description(\"Returns healthy if the service is running\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is healthy\")\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/ready - Readiness probe","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why are we exposing two handlers that do the same? By convention there's the health endpoint to check the liveness of the services","created_at":"2025-12-29T12:38:07Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650884736","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650884736"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650884736"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650884736/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":96,"side":"RIGHT","author_association":"MEMBER","original_position":96,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650890926","pull_request_review_id":3615733354,"id":2650890926,"node_id":"PRRC_kwDOPaLyBs6eAWKu","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Routes => \"oagw.routes\",\n+            Self::Links => \"oagw.links\",\n+            Self::Invoke => \"oagw.invoke\",\n+            Self::Health => \"oagw.health\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+/// Action enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Action {\n+    Create,\n+    Read,\n+    Update,\n+    Delete,\n+    Execute,\n+}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Create => \"create\",\n+            Self::Read => \"read\",\n+            Self::Update => \"update\",\n+            Self::Delete => \"delete\",\n+            Self::Execute => \"execute\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+/// Register all OAGW REST routes.\n+#[allow(clippy::too_many_lines)] // Route registration is naturally verbose\n+#[allow(clippy::unnecessary_wraps)] // Result needed for error propagation in future\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<Service>,\n+) -> anyhow::Result<Router> {\n+    // === Health Endpoints (public, no auth) ===\n+\n+    // GET /oagw/v1/health - Liveness probe\n+    router = OperationBuilder::get(\"/oagw/v1/health\")\n+        .operation_id(\"oagw.health\")\n+        .summary(\"Liveness probe\")\n+        .description(\"Returns healthy if the service is running\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is healthy\")\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/ready - Readiness probe\n+    router = OperationBuilder::get(\"/oagw/v1/ready\")\n+        .operation_id(\"oagw.ready\")\n+        .summary(\"Readiness probe\")\n+        .description(\"Returns healthy if the service is ready to accept requests\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::ready)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is ready\")\n+        .problem_response(\n+            openapi,\n+            StatusCode::SERVICE_UNAVAILABLE,\n+            \"Service not ready\",\n+        )\n+        .register(router, openapi);\n+\n+    // === Route Endpoints ===\n+\n+    // POST /oagw/v1/routes - Create route\n+    router = OperationBuilder::post(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.create_route\")\n+        .summary(\"Create a new outbound API route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateRouteRequest>(openapi, \"Route configuration\")\n+        .handler(handlers::create_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::CREATED, \"Route created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes - List routes\n+    router = OperationBuilder::get(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.list_routes\")\n+        .summary(\"List outbound API routes\")\n+        .description(\"Returns a paginated list of routes with OData query support\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$orderby\", false, \"OData ordering expression\")\n+        .handler(handlers::list_routes)\n+        .json_response_with_schema::<Page<RouteDto>>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Paginated list of routes\",\n+        )\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId} - Get route\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.get_route\")\n+        .summary(\"Get a route by ID\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::get_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route found\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // PATCH /oagw/v1/routes/{routeId} - Update route\n+    router = OperationBuilder::patch(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.update_route\")\n+        .summary(\"Update a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .json_request::<UpdateRouteRequest>(openapi, \"Route update data\")\n+        .handler(handlers::update_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route updated\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId} - Delete route\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.delete_route\")\n+        .summary(\"Delete a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Delete)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::delete_route)\n+        .json_response(StatusCode::NO_CONTENT, \"Route deleted\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId}/health - Route health (v3)\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}/health\")\n+        .operation_id(\"oagw.route_health\")\n+        .summary(\"Check route health\")\n+        .description(\"Returns health status of a route including circuit breaker states\")\n+        .tag(\"oagw-health\")\n+        .require_auth(&Resource::Health, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::route_health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Route health status\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId}/cache/tokens - Clear token cache (v3)\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}/cache/tokens\")\n+        .operation_id(\"oagw.clear_token_cache\")\n+        .summary(\"Clear cached tokens for a route\")\n+        .description(\"Evicts all cached OAuth tokens associated with this route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::clear_token_cache)\n+        .json_response(StatusCode::NO_CONTENT, \"Token cache cleared\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // === Link Endpoints ===\n+\n+    // POST /oagw/v1/links - Create link\n+    router = OperationBuilder::post(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.create_link\")\n+        .summary(\"Create a new outbound API link\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateLinkRequest>(openapi, \"Link configuration\")\n+        .handler(handlers::create_link)\n+        .json_response_with_schema::<LinkDto>(openapi, StatusCode::CREATED, \"Link created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi) // Route not found\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/links - List links\n+    router = OperationBuilder::get(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.list_links\")\n+        .summary(\"List outbound API links\")\n+        .description(\"Returns a paginated list of links with OData query support\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"this is not how we do it, please, refer to the example:\r\nhttps://github.com/hypernetix/hyperspot/blob/main/examples/modkit/users_info/users_info/src/api/rest/routes.rs#L91","created_at":"2025-12-29T12:41:46Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650890926","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650890926"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650890926"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650890926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":279,"side":"RIGHT","author_association":"MEMBER","original_position":279,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650891462","pull_request_review_id":3615733354,"id":2650891462,"node_id":"PRRC_kwDOPaLyBs6eAWTG","diff_hunk":"@@ -0,0 +1,375 @@\n+//! REST route registration for OAGW.\n+\n+use std::sync::Arc;\n+\n+use axum::{Extension, Router};\n+use http::StatusCode;\n+use modkit::api::operation_builder::{AuthReqAction, AuthReqResource, LicenseFeature};\n+use modkit::api::{OpenApiRegistry, OperationBuilder};\n+use modkit_odata::Page;\n+\n+use super::dto::{\n+    CreateLinkRequest, CreateRouteRequest, HealthResponse, InvokeRequest, InvokeResponse, LinkDto,\n+    RouteDto, UpdateLinkRequest, UpdateRouteRequest,\n+};\n+use super::handlers;\n+use crate::domain::service::Service;\n+\n+/// License feature for OAGW.\n+struct OagwLicense;\n+\n+impl AsRef<str> for OagwLicense {\n+    fn as_ref(&self) -> &'static str {\n+        \"gts.x.core.lic.feat.v1~x.core.global.base.v1\"\n+    }\n+}\n+\n+impl LicenseFeature for OagwLicense {}\n+\n+/// Resource enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Resource {\n+    Routes,\n+    Links,\n+    Invoke,\n+    Health,\n+}\n+\n+impl AsRef<str> for Resource {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Routes => \"oagw.routes\",\n+            Self::Links => \"oagw.links\",\n+            Self::Invoke => \"oagw.invoke\",\n+            Self::Health => \"oagw.health\",\n+        }\n+    }\n+}\n+\n+impl AuthReqResource for Resource {}\n+\n+/// Action enum for authorization.\n+#[derive(Debug, Clone, Copy)]\n+pub enum Action {\n+    Create,\n+    Read,\n+    Update,\n+    Delete,\n+    Execute,\n+}\n+\n+impl AsRef<str> for Action {\n+    fn as_ref(&self) -> &'static str {\n+        match self {\n+            Self::Create => \"create\",\n+            Self::Read => \"read\",\n+            Self::Update => \"update\",\n+            Self::Delete => \"delete\",\n+            Self::Execute => \"execute\",\n+        }\n+    }\n+}\n+\n+impl AuthReqAction for Action {}\n+\n+/// Register all OAGW REST routes.\n+#[allow(clippy::too_many_lines)] // Route registration is naturally verbose\n+#[allow(clippy::unnecessary_wraps)] // Result needed for error propagation in future\n+pub fn register_routes(\n+    mut router: Router,\n+    openapi: &dyn OpenApiRegistry,\n+    service: Arc<Service>,\n+) -> anyhow::Result<Router> {\n+    // === Health Endpoints (public, no auth) ===\n+\n+    // GET /oagw/v1/health - Liveness probe\n+    router = OperationBuilder::get(\"/oagw/v1/health\")\n+        .operation_id(\"oagw.health\")\n+        .summary(\"Liveness probe\")\n+        .description(\"Returns healthy if the service is running\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is healthy\")\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/ready - Readiness probe\n+    router = OperationBuilder::get(\"/oagw/v1/ready\")\n+        .operation_id(\"oagw.ready\")\n+        .summary(\"Readiness probe\")\n+        .description(\"Returns healthy if the service is ready to accept requests\")\n+        .tag(\"oagw-health\")\n+        .public()\n+        .handler(handlers::ready)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Service is ready\")\n+        .problem_response(\n+            openapi,\n+            StatusCode::SERVICE_UNAVAILABLE,\n+            \"Service not ready\",\n+        )\n+        .register(router, openapi);\n+\n+    // === Route Endpoints ===\n+\n+    // POST /oagw/v1/routes - Create route\n+    router = OperationBuilder::post(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.create_route\")\n+        .summary(\"Create a new outbound API route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateRouteRequest>(openapi, \"Route configuration\")\n+        .handler(handlers::create_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::CREATED, \"Route created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes - List routes\n+    router = OperationBuilder::get(\"/oagw/v1/routes\")\n+        .operation_id(\"oagw.list_routes\")\n+        .summary(\"List outbound API routes\")\n+        .description(\"Returns a paginated list of routes with OData query support\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$orderby\", false, \"OData ordering expression\")\n+        .handler(handlers::list_routes)\n+        .json_response_with_schema::<Page<RouteDto>>(\n+            openapi,\n+            StatusCode::OK,\n+            \"Paginated list of routes\",\n+        )\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId} - Get route\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.get_route\")\n+        .summary(\"Get a route by ID\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::get_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route found\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // PATCH /oagw/v1/routes/{routeId} - Update route\n+    router = OperationBuilder::patch(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.update_route\")\n+        .summary(\"Update a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .json_request::<UpdateRouteRequest>(openapi, \"Route update data\")\n+        .handler(handlers::update_route)\n+        .json_response_with_schema::<RouteDto>(openapi, StatusCode::OK, \"Route updated\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId} - Delete route\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}\")\n+        .operation_id(\"oagw.delete_route\")\n+        .summary(\"Delete a route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Delete)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::delete_route)\n+        .json_response(StatusCode::NO_CONTENT, \"Route deleted\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/routes/{routeId}/health - Route health (v3)\n+    router = OperationBuilder::get(\"/oagw/v1/routes/{routeId}/health\")\n+        .operation_id(\"oagw.route_health\")\n+        .summary(\"Check route health\")\n+        .description(\"Returns health status of a route including circuit breaker states\")\n+        .tag(\"oagw-health\")\n+        .require_auth(&Resource::Health, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::route_health)\n+        .json_response_with_schema::<HealthResponse>(openapi, StatusCode::OK, \"Route health status\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // DELETE /oagw/v1/routes/{routeId}/cache/tokens - Clear token cache (v3)\n+    router = OperationBuilder::delete(\"/oagw/v1/routes/{routeId}/cache/tokens\")\n+        .operation_id(\"oagw.clear_token_cache\")\n+        .summary(\"Clear cached tokens for a route\")\n+        .description(\"Evicts all cached OAuth tokens associated with this route\")\n+        .tag(\"oagw-routes\")\n+        .require_auth(&Resource::Routes, &Action::Update)\n+        .require_license_features::<OagwLicense>([])\n+        .path_param(\"routeId\", \"Route UUID\")\n+        .handler(handlers::clear_token_cache)\n+        .json_response(StatusCode::NO_CONTENT, \"Token cache cleared\")\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // === Link Endpoints ===\n+\n+    // POST /oagw/v1/links - Create link\n+    router = OperationBuilder::post(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.create_link\")\n+        .summary(\"Create a new outbound API link\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Create)\n+        .require_license_features::<OagwLicense>([])\n+        .json_request::<CreateLinkRequest>(openapi, \"Link configuration\")\n+        .handler(handlers::create_link)\n+        .json_response_with_schema::<LinkDto>(openapi, StatusCode::CREATED, \"Link created\")\n+        .error_400(openapi)\n+        .error_401(openapi)\n+        .error_403(openapi)\n+        .error_404(openapi) // Route not found\n+        .error_409(openapi)\n+        .error_500(openapi)\n+        .register(router, openapi);\n+\n+    // GET /oagw/v1/links - List links\n+    router = OperationBuilder::get(\"/oagw/v1/links\")\n+        .operation_id(\"oagw.list_links\")\n+        .summary(\"List outbound API links\")\n+        .description(\"Returns a paginated list of links with OData query support\")\n+        .tag(\"oagw-links\")\n+        .require_auth(&Resource::Links, &Action::Read)\n+        .require_license_features::<OagwLicense>([])\n+        .query_param_typed(\n+            \"$top\",\n+            false,\n+            \"Maximum number of items to return\",\n+            \"integer\",\n+        )\n+        .query_param_typed(\"$skip\", false, \"Number of items to skip\", \"integer\")\n+        .query_param(\"$filter\", false, \"OData filter expression\")\n+        .query_param(\"$orderby\", false, \"OData ordering expression\")","path":"modules/oagw/oagw-gw/src/api/rest/routes.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"same situation, please, refer to example:\r\nhttps://github.com/hypernetix/hyperspot/blob/main/examples/modkit/users_info/users_info/src/api/rest/routes.rs#L93","created_at":"2025-12-29T12:42:08Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650891462","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650891462"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650891462"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650891462/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":280,"side":"RIGHT","author_association":"MEMBER","original_position":280,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650896905","pull_request_review_id":3615733354,"id":2650896905,"node_id":"PRRC_kwDOPaLyBs6eAXoJ","diff_hunk":"@@ -0,0 +1,49 @@\n+//! Output ports (interfaces) for domain services.\n+\n+use async_trait::async_trait;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::Secret;\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+\n+/// Port for resolving secrets from cred_store.\n+#[async_trait]\n+pub trait SecretResolver: Send + Sync {","path":"modules/oagw/oagw-gw/src/domain/ports.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why we have this trait here? If this is a placeholder for credstore... fine, but looks like it should reside in the modkit-security","created_at":"2025-12-29T12:45:23Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650896905","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650896905"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650896905"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650896905/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":12,"side":"RIGHT","author_association":"MEMBER","original_position":12,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650899140","pull_request_review_id":3615733354,"id":2650899140,"node_id":"PRRC_kwDOPaLyBs6eAYLE","diff_hunk":"@@ -0,0 +1,49 @@\n+//! Output ports (interfaces) for domain services.\n+\n+use async_trait::async_trait;\n+use modkit_security::SecurityContext;\n+use oagw_sdk::Secret;\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+\n+/// Port for resolving secrets from cred_store.\n+#[async_trait]\n+pub trait SecretResolver: Send + Sync {\n+    /// Get a secret by its reference UUID.\n+    async fn get_secret(\n+        &self,\n+        ctx: &SecurityContext,\n+        secret_ref: Uuid,\n+    ) -> Result<Secret, DomainError>;\n+}\n+\n+/// Stub implementation of SecretResolver for v1.\n+///\n+/// TODO(v2): Replace with actual cred_store integration.\n+#[derive(Debug, Default)]\n+pub struct StubSecretResolver;\n+\n+#[async_trait]\n+impl SecretResolver for StubSecretResolver {\n+    async fn get_secret(\n+        &self,\n+        _ctx: &SecurityContext,\n+        secret_ref: Uuid,\n+    ) -> Result<Secret, DomainError> {\n+        // TODO(v2): Implement actual cred_store lookup via CredStoreApi\n+        // For v1, return a stub secret for testing\n+        tracing::warn!(\n+            secret_ref = %secret_ref,\n+            \"Using stub secret resolver - replace with cred_store integration\"\n+        );\n+\n+        Ok(Secret {\n+            id: secret_ref,\n+            secret_type_gts_id: \"gts.x.core.oagw.auth_type.v1~x.core.auth.bearer_token.v1\"","path":"modules/oagw/oagw-gw/src/domain/ports.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"this type is a stub also? if not, we should be use a const","created_at":"2025-12-29T12:46:50Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650899140","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650899140"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650899140"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650899140/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":43,"side":"RIGHT","author_association":"MEMBER","original_position":43,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907075","pull_request_review_id":3615807659,"id":2650907075,"node_id":"PRRC_kwDOPaLyBs6eAaHD","diff_hunk":"@@ -0,0 +1,470 @@\n+//! Domain service for OAGW.\n+//!\n+//! This service orchestrates all business logic for outbound API invocations,\n+//! route/link management, and plugin selection.\n+\n+use std::sync::Arc;\n+\n+use modkit::client_hub::ClientHub;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::{AccessScope, PolicyEngineRef, SecurityContext};\n+use oagw_sdk::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwPluginApi,\n+    OagwResponseStream, Route, RoutePatch,\n+};\n+use tracing::{info_span, instrument, Instrument};\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+use super::ports::SecretResolver;\n+use super::repo::{LinkRepository, RouteRepository};\n+use crate::config::OagwConfig;\n+\n+/// Service configuration extracted from module config.\n+#[derive(Debug, Clone)]\n+pub struct ServiceConfig {\n+    /// Default connection timeout in milliseconds.\n+    pub default_connection_timeout_ms: u64,\n+    /// Default request timeout in milliseconds.\n+    pub default_request_timeout_ms: u64,\n+}\n+\n+impl From<&OagwConfig> for ServiceConfig {\n+    fn from(cfg: &OagwConfig) -> Self {\n+        Self {\n+            default_connection_timeout_ms: cfg.default_connection_timeout_ms,\n+            default_request_timeout_ms: cfg.default_request_timeout_ms,\n+        }\n+    }\n+}\n+\n+/// Domain service for OAGW operations.\n+pub struct Service {\n+    policy_engine: PolicyEngineRef,\n+    route_repo: Arc<dyn RouteRepository>,\n+    link_repo: Arc<dyn LinkRepository>,\n+    secret_resolver: Arc<dyn SecretResolver>,\n+    client_hub: Arc<ClientHub>,","path":"modules/oagw/oagw-gw/src/domain/service.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is a violation of DI and DDD principles. \r\n\r\nClientHub is a struct, not a trait, and it does not belong to domain. And basically such injection says that Service depends on every client that might possible exist. Injecting ClientHub is basically infamours ServiceLocator antipattern.\r\n\r\nA better approach would be for Service to depend on something like oagw-specific plugin registry trait. \r\nAn implementation of this trait (infrastructure) is an adapter around ClientHub.\r\n\r\nWith current approach how would one unit-test business logic in domain service?","created_at":"2025-12-29T12:51:19Z","updated_at":"2025-12-29T12:51:20Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650907075","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907075"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650907075"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":47,"side":"RIGHT","author_association":"MEMBER","original_position":47,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907410","pull_request_review_id":3615733354,"id":2650907410,"node_id":"PRRC_kwDOPaLyBs6eAaMS","diff_hunk":"","path":"modules/oagw/oagw-gw/src/domain/repo.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Can someone explain why we need traits here? For testing purposes?","created_at":"2025-12-29T12:51:32Z","updated_at":"2025-12-29T13:17:55Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650907410","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907410"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650907410"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650907410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650911537","pull_request_review_id":3615812369,"id":2650911537,"node_id":"PRRC_kwDOPaLyBs6eAbMx","diff_hunk":"@@ -0,0 +1,470 @@\n+//! Domain service for OAGW.\n+//!\n+//! This service orchestrates all business logic for outbound API invocations,\n+//! route/link management, and plugin selection.\n+\n+use std::sync::Arc;\n+\n+use modkit::client_hub::ClientHub;\n+use modkit_odata::{ODataQuery, Page};\n+use modkit_security::{AccessScope, PolicyEngineRef, SecurityContext};\n+use oagw_sdk::{\n+    Link, LinkPatch, NewLink, NewRoute, OagwInvokeRequest, OagwInvokeResponse, OagwPluginApi,\n+    OagwResponseStream, Route, RoutePatch,\n+};\n+use tracing::{info_span, instrument, Instrument};\n+use uuid::Uuid;\n+\n+use super::error::DomainError;\n+use super::ports::SecretResolver;\n+use super::repo::{LinkRepository, RouteRepository};\n+use crate::config::OagwConfig;\n+\n+/// Service configuration extracted from module config.\n+#[derive(Debug, Clone)]\n+pub struct ServiceConfig {\n+    /// Default connection timeout in milliseconds.\n+    pub default_connection_timeout_ms: u64,\n+    /// Default request timeout in milliseconds.\n+    pub default_request_timeout_ms: u64,\n+}\n+\n+impl From<&OagwConfig> for ServiceConfig {\n+    fn from(cfg: &OagwConfig) -> Self {\n+        Self {\n+            default_connection_timeout_ms: cfg.default_connection_timeout_ms,\n+            default_request_timeout_ms: cfg.default_request_timeout_ms,\n+        }\n+    }\n+}\n+\n+/// Domain service for OAGW operations.\n+pub struct Service {\n+    policy_engine: PolicyEngineRef,\n+    route_repo: Arc<dyn RouteRepository>,\n+    link_repo: Arc<dyn LinkRepository>,\n+    secret_resolver: Arc<dyn SecretResolver>,\n+    client_hub: Arc<ClientHub>,\n+    config: ServiceConfig,\n+}\n+\n+impl Service {","path":"modules/oagw/oagw-gw/src/domain/service.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"hyphen-2025","id":248559081,"node_id":"U_kgDODtC16Q","avatar_url":"https://avatars.githubusercontent.com/u/248559081?v=4","gravatar_id":"","url":"https://api.github.com/users/hyphen-2025","html_url":"https://github.com/hyphen-2025","followers_url":"https://api.github.com/users/hyphen-2025/followers","following_url":"https://api.github.com/users/hyphen-2025/following{/other_user}","gists_url":"https://api.github.com/users/hyphen-2025/gists{/gist_id}","starred_url":"https://api.github.com/users/hyphen-2025/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hyphen-2025/subscriptions","organizations_url":"https://api.github.com/users/hyphen-2025/orgs","repos_url":"https://api.github.com/users/hyphen-2025/repos","events_url":"https://api.github.com/users/hyphen-2025/events{/privacy}","received_events_url":"https://api.github.com/users/hyphen-2025/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In current form Service does too many things:\r\n- CRUD of routes\r\n- CRUD of links\r\n- link resolution\r\n- Invokations\r\n\r\nThese are separate concerns","created_at":"2025-12-29T12:54:04Z","updated_at":"2025-12-29T12:54:26Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650911537","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650911537"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/164#discussion_r2650911537"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/164"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650911537/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":51,"side":"RIGHT","author_association":"MEMBER","original_position":51,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2650911725","pull_request_review_id":3615733354,"id":2650911725,"node_id":"PRRC_kwDOPaLyBs6eAbPt","diff_hunk":"","path":"modules/oagw/oagw-gw/src/infra/storage/entity.rs","commit_id":"18b44005d235f0c87434397e8bb0310fa2e0928d","original_commit_id":"06cb74af0d049ca1275effdd774700db9fae15b8","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions
ly_to_id":2581285332,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582531695","pull_request_review_id":3531791325,"id":2582531695,"node_id":"PRRC_kwDOPaLyBs6Z7k5v","diff_hunk":"@@ -0,0 +1,118 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Linux using NVML for NVIDIA GPUs, fallback to lspci\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to lspci for AMD/Intel/other GPUs\n+    tracing::debug!(\"NVML not available, falling back to lspci\");\n+    collect_gpus_via_lspci()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {","path":"libs/modkit-node-info/src/gpu_collector_linux.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Using a manual `for` loop in this case is preferable to rewriting the logic into a chained iterator with closures.\n\nThe loop contains multiple side effects: logging, fallbacks, conditional push, error handling, and different code paths depending on NVML responses. Translating this into `map` or `filter_map` creates a long closure with imperative logic hidden inside a functional style construct. This does not improve readability or maintainability, and makes control flow harder to follow","created_at":"2025-12-02T19:24:46Z","updated_at":"2025-12-02T19:24:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582531695","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582531695"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582531695"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582531695/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":35,"side":"RIGHT","in_reply_to_id":2581246155,"author_association":"MEMBER","original_position":35,"position":36,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582537318","pull_request_review_id":3531798194,"id":2582537318,"node_id":"PRRC_kwDOPaLyBs6Z7mRm","diff_hunk":"@@ -0,0 +1,128 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Windows using NVML for NVIDIA GPUs, fallback to WMIC\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to WMIC for other GPUs\n+    tracing::debug!(\"NVML not available, falling back to WMIC\");\n+    collect_gpus_via_wmic()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {","path":"libs/modkit-node-info/src/gpu_collector_windows.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/MikeFalcon77/following{/other_user}","gists_url":"https://api.github.com/users/MikeFalcon77/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeFalcon77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeFalcon77/subscriptions","organizations_url":"https://api.github.com/users/MikeFalcon77/orgs","repos_url":"https://api.github.com/users/MikeFalcon77/repos","events_url":"https://api.github.com/users/MikeFalcon77/events{/privacy}","received_events_url":"https://api.github.com/users/MikeFalcon77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Please see my comment about the same concern.\n","created_at":"2025-12-02T19:27:04Z","updated_at":"2025-12-02T19:27:09Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582537318","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582537318"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582537318"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582537318/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":35,"side":"RIGHT","in_reply_to_id":2581269373,"author_association":"MEMBER","original_position":35,"position":36,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582567617","pull_request_review_id":3531689941,"id":2582567617,"node_id":"PRRC_kwDOPaLyBs6Z7trB","diff_hunk":"@@ -0,0 +1,128 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Windows using NVML for NVIDIA GPUs, fallback to WMIC\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to WMIC for other GPUs\n+    tracing::debug!(\"NVML not available, falling back to WMIC\");\n+    collect_gpus_via_wmic()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {\n+        match nvml.device_by_index(i) {\n+            Ok(device) => {\n+                let model = device\n+                    .name()\n+                    .unwrap_or_else(|_| \"Unknown NVIDIA GPU\".to_string());\n+\n+                // Get memory info\n+                let memory_info = device.memory_info().ok();\n+                let total_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.total as f64 / 1024.0 / 1024.0);\n+                let used_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.used as f64 / 1024.0 / 1024.0);\n+\n+                // NVML doesn't expose CUDA cores directly\n+                let cores = None;\n+\n+                gpus.push(GpuInfo {\n+                    model,\n+                    cores,\n+                    total_memory_mb,\n+                    used_memory_mb,\n+                });\n+\n+                tracing::debug!(\n+                    \"NVIDIA GPU {}: {} (Memory: {:.0} MB / {:.0} MB)\",\n+                    i,\n+                    gpus.last().unwrap().model,\n+                    used_memory_mb.unwrap_or(0.0),\n+                    total_memory_mb.unwrap_or(0.0)\n+                );\n+            }\n+            Err(e) => {\n+                tracing::warn!(\"Failed to get NVML device handle for GPU #{}: {}\", i, e);\n+            }\n+        }\n+    }\n+\n+    Ok(gpus)\n+}\n+\n+/// Collect GPU information using WMIC (fallback for non-NVIDIA GPUs)\n+fn collect_gpus_via_wmic() -> Result<Vec<GpuInfo>, NodeInfoError> {","path":"libs/modkit-node-info/src/gpu_collector_windows.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tests are no there yet, we'll have CI in github workflows on all platforms\r\nhttps://github.com/hypernetix/hyperspot/issues/39","created_at":"2025-12-02T19:40:47Z","updated_at":"2025-12-03T09:36:47Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582567617","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582567617"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2582567617"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2582567617/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":79,"side":"RIGHT","in_reply_to_id":2581290915,"author_association":"MEMBER","original_position":79,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2584036335","pull_request_review_id":3531689941,"id":2584036335,"node_id":"PRRC_kwDOPaLyBs6aBUPv","diff_hunk":"@@ -0,0 +1,120 @@\n+use machine_uid;\n+use uuid::Uuid;\n+\n+/// Get a permanent hardware-based UUID for this machine.\n+/// This UUID is the actual hardware identifier and will remain consistent\n+/// across reboots and application restarts.\n+///\n+/// Platform-specific implementations:\n+/// - macOS: Uses IOPlatformUUID from IOKit (already a UUID)\n+/// - Linux: Uses /etc/machine-id or /var/lib/dbus/machine-id (converted to UUID)\n+/// - Windows: Uses MachineGuid from registry (already a UUID)\n+///\n+/// Returns a hybrid UUID (00000000-0000-0000-xxxx-xxxxxxxxxxxx) if detection fails,\n+/// where the left part is all zeros and the right part is random for uniqueness.\n+pub fn get_hardware_uuid() -> Uuid {\n+    match machine_uid::get() {\n+        Ok(machine_id) => {\n+            // Try to parse the machine_id as a UUID directly\n+            match Uuid::parse_str(&machine_id) {\n+                Ok(uuid) => {\n+                    tracing::debug!(\n+                        machine_id = %machine_id,\n+                        node_uuid = %uuid,\n+                        \"Using hardware UUID\"\n+                    );\n+                    uuid\n+                }\n+                Err(parse_err) => {\n+                    // If it's not a valid UUID format, hash it to create one\n+                    tracing::warn!(\n+                        machine_id = %machine_id,\n+                        error = %parse_err,\n+                        \"Machine ID is not a valid UUID, using hash-based UUID\"\n+                    );\n+\n+                    // Use UUID v5 to create a deterministic UUID from the machine ID\n+                    const HYPERSPOT_NAMESPACE: Uuid = Uuid::from_bytes([","path":"libs/modkit-node-info/src/hardware_uuid.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https:/
.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"let's do the following as we are working with specific versions.\r\nLoad here all dependencies and use them in the [dependencies] and [dev-dependencies] section.\r\nSo we don't have a bunch of different versions scatter everywhere around lints","created_at":"2025-12-22T12:17:39Z","updated_at":"2025-12-22T12:17:39Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/141#discussion_r2639692821","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2639692821"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/141#discussion_r2639692821"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2639692821/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":2,"original_line":2,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642780118","pull_request_review_id":3607563489,"id":2642780118,"node_id":"PRRC_kwDOPaLyBs6dhZ_W","diff_hunk":"@@ -0,0 +1,21 @@\n+// simulated_dir=/hyperspot/modules/some_module/contract/\n+use serde::Deserialize;\n+\n+#[allow(dead_code)]\n+// Should trigger DE0101 - Serde in contract\n+#[derive(Debug, Clone, Deserialize)]\n+pub struct Order {\n+    pub id: String,\n+    pub total: f64,\n+}\n+\n+#[allow(dead_code)]\n+// Should trigger DE0101 - Serde in contract","path":"dylint_lints/de01_contract_layer/de0101_no_serde_in_contract/ui/deserialize.rs","commit_id":"ed513fcadd9c05daa4f6c6fe113d464579631316","original_commit_id":"ed513fcadd9c05daa4f6c6fe113d464579631316","user":{"login":"nanoandrew4","id":14365320,"node_id":"MDQ6VXNlcjE0MzY1MzIw","avatar_url":"https://avatars.githubusercontent.com/u/14365320?v=4","gravatar_id":"","url":"https://api.github.com/users/nanoandrew4","html_url":"https://github.com/nanoandrew4","followers_url":"https://api.github.com/users/nanoandrew4/followers","following_url":"https://api.github.com/users/nanoandrew4/following{/other_user}","gists_url":"https://api.github.com/users/nanoandrew4/gists{/gist_id}","starred_url":"https://api.github.com/users/nanoandrew4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nanoandrew4/subscriptions","organizations_url":"https://api.github.com/users/nanoandrew4/orgs","repos_url":"https://api.github.com/users/nanoandrew4/repos","events_url":"https://api.github.com/users/nanoandrew4/events{/privacy}","received_events_url":"https://api.github.com/users/nanoandrew4/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"These comments are now enforced by the unit tests in each lint. If we were to change `Should trigger` for `Should not trigger`, or if we delete the comment altogether, the unit tests would fail, since that struct expects to have a lint error raised on it based on its use of `Deserialize`. This allows us to regain some of the atomicity that was spoken of, and override the `.stderr` files with more confidence, since this will act as an additional layer of intent checking for the tests.","created_at":"2025-12-23T10:56:35Z","updated_at":"2025-12-23T10:56:51Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/141#discussion_r2642780118","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642780118"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/141#discussion_r2642780118"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2642780118/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":13,"original_line":13,"side":"RIGHT","author_association":"MEMBER","original_position":13,"position":13,"subject_type":"line"}],"source_reviews":[{"id":3603117275,"node_id":"PRR_kwDOPaLyBs7WwzTb","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"can you add also the vscode/windsurf directives to the rust-analyzer?","state":"COMMENTED","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/141#pullrequestreview-3603117275","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/141","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/141#pullrequestreview-3603117275"},"pull_request":{"href":"h
thub.com/repos/cyberfabric/cyberware-rust/releases{/id}","deployments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/deployments","created_at":"2025-08-07T20:30:28Z","updated_at":"2026-05-30T15:05:39Z","pushed_at":"2026-05-30T15:05:34Z","git_url":"git://github.com/cyberfabric/cyberware-rust.git","ssh_url":"git@github.com:cyberfabric/cyberware-rust.git","clone_url":"https://github.com/cyberfabric/cyberware-rust.git","svn_url":"https://github.com/cyberfabric/cyberware-rust","homepage":"https://www.cyberfabric.org","size":28496,"stargazers_count":32,"watchers_count":32,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":19,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":263,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["account-management","agentic-ai","ai","benchmarks","cloud","genai","llm","microservices","middleware","modkit","multi-tenancy","multi-tier","rust","saas","security","serverless","xaas"],"visibility":"private","forks":19,"open_issues":263,"watchers":32,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/27"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/27"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/27/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/e46a7d653a9cc65537bb2a9043910217c9486eba"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":26,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/26","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #26] Feature/secure orm explicit scope columns","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/secure-orm-explicit-scope-columns","pr_head_sha":"e49520f9d0d83f717cb40c06544c8872cfa10b90","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/26","id":2993318650,"node_id":"PR_kwDOPaLyBs6yamr6","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/26","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/26.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/26.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/26","number":26,"state":"closed","locked":false,"title":"Feature/secure orm explicit scope columns","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"feat(security, db, ingress): enforce explicit Scopable contract, root tenant scope, and on-prem auth mode\r\n\r\n- **modkit-db / macros**\r\n  - Updated `#[derive(Scopable)]` to require explicit declaration for all scope-related columns:\r\n    - Each entity must specify either `<name>_col = \"...\"` or `no_<name>` for:\r\n      `tenant_col`, `resource_col`, `owner_col`, and `type_col`.\r\n    - Removed all implicit defaults (e.g. `resource_col = \"id\"`).\r\n    - Added strict validation at macro level:\r\n      - Exactly one alternative must be present per field.\r\n      - `unrestricted` cannot be combined with any of the above.\r\n      - Missing declarations now produce compile-time errors.\r\n  - Generated trait implementation now returns `Option<Self::Column>` for all four fields.\r\n\r\n- **modkit-security**\r\n  - Added explicit `is_root` flag to `AccessScope` to distinguish\r\n    root context from an empty/unauthorized one.\r\n  - Implemented `AccessScope::root_tenant()` and `AccessScope::is_root()`.\r\n  - Updated `is_empty()` to never treat root scopes as empty.\r\n  - Adjusted `SecurityCtx::root_ctx()` to use the new `root_tenant()` constructor.\r\n\r\n- **modkit-db / secure**\r\n  - Updated `build_scope_condition()` to handle root scopes:\r\n    - Empty scope → `WHERE false` (deny all).\r\n    - Root scope without filters → `Condition::all()` (allow all).\r\n    - Root scope with filters → apply only non-tenant filters.\r\n  - secure_insert is fixed\r\n  - Modified `SimpleTenantFilter`:\r\n    - Skips tenant filtering entirely for root scopes.\r\n    - Keeps existing deny-all semantics for tenant-scoped entities missing a tenant column.\r\n\r\n- **api_ingress**\r\n  - Added explicit `AuthMode` enum: `Required | Optional | Disabled`.\r\n  - Implemented `with_auth_layers()` helper to attach correct Axum middleware:\r\n    - `Required` → `auth_required`\r\n    - `Optional` → `auth_optional`\r\n    - `Disabled` → injects `SecurityCtx::root_ctx()` for all requests\r\n      (default mode for single-user on-prem deployments without IdP)\r\n\r\n**Result:**\r\nSecurity and ORM layers now enforce strict compile-time Scopable contracts\r\nand fully support single-tenant (root) mode for on-prem deployments.\r\nEmpty/unauthorized scopes still deny all by default, preserving isolation guarantees.","created_at":"2025-11-10T01:37:26Z","updated_at":"2025-11-12T07:51:44Z","closed_at":"2025-11-12T07:51:43Z","merged_at":"2025-11-12T07:51:43Z","merge_commit_sha":"c40c8df4415be0288fc54ab9d35685b8c94647e7","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/26/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/26/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/26/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/e49520f9d0d83f717cb40c06544c8872cfa10b90","head":{"label":"modcrafter77:feature/secure-orm-explicit-scope-columns","ref":"feature/secure-orm-explicit-scope-columns","sha":"e49520f9d0d83f717cb40c06544c8872cfa10b90","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/m
ap::DashMap;\n+use http::Method;\n+use std::sync::Arc;\n+\n+use modkit::api::{OperationSpec, Problem};\n+\n+const BASE_FEATURE: &str = \"gts.x.core.lic.feat.v1~x.core.global.base.v1\";\n+\n+type LicenseKey = (Method, String);\n+\n+#[derive(Clone)]\n+pub struct LicenseRequirementMap {\n+    requirements: Arc<DashMap<LicenseKey, String>>,\n+}\n+\n+impl LicenseRequirementMap {\n+    #[must_use]\n+    pub fn from_specs(specs: &[OperationSpec]) -> Self {\n+        let requirements = DashMap::new();\n+\n+        for spec in specs {\n+            if let Some(req) = spec.license_requirement.as_ref() {\n+                requirements.insert(\n+                    (spec.method.clone(), spec.path.clone()),\n+                    req.license_name.clone(),\n+                );\n+            }\n+        }\n+\n+        Self {\n+            requirements: Arc::new(requirements),\n+        }\n+    }\n+\n+    fn get(&self, method: &Method, path: &str) -> Option<String> {\n+        self.requirements\n+            .get(&(method.clone(), path.to_owned()))\n+            .map(|v| v.value().clone())\n+    }\n+}\n+\n+pub async fn license_validation_middleware(","path":"modules/api_ingress/src/middleware/license_validation.rs","commit_id":"17c504cfbaaf58f1ade0be7a7c6807b563521e85","original_commit_id":"cbc58ed53f78bf76344f82b667a017d51c861f85","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/A
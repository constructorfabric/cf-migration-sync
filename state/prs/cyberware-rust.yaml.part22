Self {\n+        Self {\n+            service: arc_swap::ArcSwapOption::empty(),\n+        }\n+    }\n+}\n+\n+#[async_trait]\n+impl Module for NodesRegistry {\n+    async fn init(&self, ctx: &ModuleCtx) -> Result<()> {\n+        let _cfg: NodesRegistryConfig = ctx.config()?;\n+\n+        // Create the service\n+        let service = Service::new();\n+        self.service.store(Some(Arc::new(service.clone())));\n+\n+        // Expose the client to the ClientHub\n+        let api: Arc<dyn NodesRegistryApi> =\n+            Arc::new(NodesRegistryLocalClient::new(Arc::new(service)));\n+        expose_nodes_registry_client(ctx, &api)?;\n+\n+        tracing::info!(\"Nodes registry module initialized\");\n+        Ok(())\n+    }\n+\n+    fn as_any(&self) -> &dyn std::any::Any {","path":"modules/nodes_registry/src/module.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"would you make a PR?","created_at":"2025-12-03T09:34:05Z","updated_at":"2025-12-03T09:36:47Z","htm
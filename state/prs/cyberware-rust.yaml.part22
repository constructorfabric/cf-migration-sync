::example1_user_not_found_v1().to_problem(\"User not found\");\n+\n+    assert_eq!(problem.status, 404);\n+    assert_eq!(problem.title, \"User Not Found\");\n+    assert_eq!(\n+        problem.code,\n+        \"gts.hx.core.errors.err.v1~hx.example1.user.not_found.v1\"\n+    );\n+    assert_eq!(problem.detail, \"User not found\");\n+    assert_eq!(\n+        problem.type_url,\n+        \"https://errors.example.com/gts.hx.core.errors.err.v1~hx.example1.user.not_found.v1\"\n+    );\n+}\n+\n+#[test]\n+fn error_code_def_is_consistent() {\n+    let def = ErrorCode::gts_hx_core_errors_err_v1_hx_example1_user_email_conflict_v1.def();\n+\n+    assert_eq!(def.status, 409);\n+    assert_eq!(def.title, \"Email Already Exists\");\n+    assert_eq!(\n+        def.code,\n+        \"gts.hx.core.errors.err.v1~hx.example1.user.email_conflict.v1\"\n+    );\n+    assert_eq!(\n+        def.type_url,\n+        \"https://errors.example.com/gts.hx.core.errors.err.v1~hx.example1.user.email_conflict.v1\"\n+    );\n+}\n+\n+#[test]\n+fn all_error_codes_have_valid_status() {\n+    // Test all error codes to ensure they have valid HTTP status codes\n+    let codes = [\n+        ErrorCode::gts_hx_core_errors_err_v1_hx_example1_user_not_found_v1,","path":"examples/modkit/users_info/tests/errors_catalog.rs","commit_id":"805418661f8202a5739a130cc2ff6b9a177421e2","original_commit_id":"805418661f8202a5739a130cc2ff6b9a177421e2","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"as discussed, let's get rid of long names","created_at":"2025-10-06T20:27:29Z","updated_at":"2025-10-06T20:51:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/18#discussion_r2408408661","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/18","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2408408661"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/18#discussion_r2408408661"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/18"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2408408661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":57,"original_line":57,"side":"RIGHT","author_association":"MEMBER","original_position":57,"position":57,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":17,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/17","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #17] refactor(Framework Improvements feedback)","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"refactor/correctness_and_dx","pr_head_sha":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17","id":2866990088,"node_id":"PR_kwDOPaLyBs6q4swI","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/17","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/17.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/17.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/17","number":17,"state":"closed","locked":false,"title":"refactor(Framework Improvements feedback)","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"# Cycle Detection in RegistryBuilder\r\n\r\n# Unified OData Errors\r\n- All OData operations use a single error type\r\n- Consistent error messages and codes\r\n- Better error categorization (parsing vs validation vs cursor issues)\r\n\r\n# Typed Module Configurations\r\n-  `ConfigProviderExt` with `module_config_typed<T>()`\r\n- *Helper Function**: `module_config_typed()` for `dyn ConfigProvider`\r\n- Error Type: `ConfigError` with structured error variants\r\n\r\n# Centralized Error Mapping\r\n-  **Middleware**: `error_mapping_middleware()` for request context extraction\r\n-  **Trait**: `IntoProblemResponse` for consistent error conversion\r\n- **Function**: `map_error_to_problem()` for centralized mapping\r\n-  **Coverage**: `ApiError`, `ConfigError`, `ODataError`, `anyhow::Error`\r\n\r\n# Enhanced Task Lifecycle Management\r\n- No panics are silently swallowed\r\n- Task identification in logs for debugging\r\n- Proper cleanup on shutdown with timeout handling\r\n- Enhanced error reporting for task failures","created_at":"2025-09-28T00:52:35Z","updated_at":"2025-09-28T12:08:07Z","closed_at":"2025-09-28T12:08:07Z","merged_at":"2025-09-28T12:08:07Z","merge_commit_sha":"a557df0149e7f8d69891519dedbcdc60f33458cf","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/17/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","head":{"label":"modcrafter77:refactor/correctness_and_dx","ref":"refactor/correctness_and_dx","sha":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/su
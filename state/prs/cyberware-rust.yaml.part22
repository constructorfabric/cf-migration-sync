 UsersInfoError {\n-    fn from(page_error: odata_core::ODataPageError) -> Self {\n-        use odata_core::ODataPageError::*;\n-        match page_error {\n+// Convert OData errors to contract-safe errors\n+impl From<odata_core::Error> for UsersInfoError {","path":"examples/modkit/users_info/src/contract/error.rs","commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","original_commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks like over-engineering but actually not.\r\nWe keep a dedicated UsersInfoError (with mappers from domain/OData errors) in the contract layer because it provides a stable, safe boundary for clients:\r\n- isolates them from internal domain/infra changes,\r\n- prevents leaking sensitive/internal error details,\r\n- allows us to version/evolve internals without breaking API consumers,\r\n- keeps external dependencies (like odata_core) out of the public contract.\r\n","created_at":"2025-09-28T01:06:22Z","updated_at":"2025-09-28T01:09:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2384417149","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2384417149"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2384417149"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2384417149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":59,"original_line":59,"side":"RIGHT","author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2384417353","pull_request_review_id":3275222118,"id":2384417353,"node_id":"PRRC_kwDOPaLyBs6OH1JJ","diff_hunk":"@@ -0,0 +1,240 @@\n+//! Centralized error mapping for Axum\n+//!\n+//! This module provides utilities for automatically converting all framework\n+//! and module errors into consistent RFC 9457 Problem+JSON responses, eliminating\n+//! per-route boilerplate.\n+\n+use axum::{\n+    extract::Request,\n+    http::{HeaderMap, StatusCode},\n+    middleware::Next,\n+    response::Response,\n+};\n+use std::any::Any;\n+\n+use crate::api::problem::{Problem, ProblemResponse};\n+use crate::context::ConfigError;\n+use odata_core::Error as ODataError;\n+\n+/// Middleware function that provides centralized error mapping\n+///\n+/// This middleware can be applied to routes to automatically extract request context\n+/// and provide it to error handlers. The actual error conversion happens in the\n+/// `IntoProblemResponse` trait implementations and `map_error_to_problem` function.\n+pub async fn error_mapping_middleware(request: Request, next: Next) -> Response {\n+    let _uri = request.uri().clone();\n+    let _headers = request.headers().clone();\n+\n+    let response = next.run(request).await;\n+\n+    // If the response is already successful or is already a Problem response, pass it through\n+    if response.status().is_success() || is_problem_response(&response) {\n+        return response;\n+    }\n+\n+    // For error responses, the actual error conversion should happen in the handlers\n+    // using the IntoProblemResponse trait or map_error_to_problem function\n+    // This middleware provides the infrastructure for extracting request context\n+    response\n+}\n+\n+/// Check if a response is already a Problem+JSON response\n+fn is_problem_response(response: &Response) -> bool {\n+    response\n+        .headers()\n+        .get(axum::http::header::CONTENT_TYPE)\n+        .and_then(|v| v.to_str().ok())\n+        .map(|ct| ct.contains(\"application/problem+json\"))\n+        .unwrap_or(false)\n+}\n+\n+/// Extract trace ID from headers or generate one\n+pub fn extract_trace_id(headers: &HeaderMap) -> Option<String> {\n+    // Try to get trace ID from various common headers\n+    headers\n+        .get(\"x-trace-id\")\n+        .or_else(|| headers.get(\"x-request-id\"))\n+        .or_else(|| headers.get(\"traceparent\"))\n+        .and_then(|v| v.to_str().ok())\n+        .map(|s| s.to_string())\n+        .or_else(|| {\n+            // Try to get from current tracing span\n+            tracing::Span::current()\n+                .id()\n+                .map(|id| id.into_u64().to_string())\n+        })\n+}\n+\n+/// Centralized error mapping function\n+///\n+/// This function provides a single place to convert all framework and module errors\n+/// into consistent Problem responses with proper trace IDs and instance paths.\n+pub fn map_error_to_problem(\n+    error: &dyn Any,\n+    instance: &str,\n+    trace_id: Option<String>,\n+) -> ProblemResponse {\n+    // Try to downcast to known error types\n+    if let Some(odata_err) = error.downcast_ref::<ODataError>() {\n+        let mut problem = crate::api::odata::error::odata_error_to_problem(odata_err, instance);\n+        if let Some(tid) = trace_id {\n+            problem.0 = problem.0.with_trace_id(tid);\n+        }\n+        return problem;\n+    }\n+\n+    if let Some(config_err) = error.downcast_ref::<ConfigError>() {\n+        let problem = match config_err {\n+            ConfigError::ModuleNotFound { module } => Problem::new(\n+                StatusCode::INTERNAL_SERVER_ERROR,\n+                \"Configuration Error\",\n+                format!(\"Module '{}' configuration not found\", module),\n+            )\n+            .with_code(\"CONFIG_MODULE_NOT_FOUND\")\n+            .with_type(\"https://errors.example.com/CONFIG_MODULE_NOT_FOUND\"),","path":"libs/modkit/src/api/error_layer.rs","commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","original_commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Need to think about error type uri.","created_at":"2025-09-28T01:07:13Z","updated_at":"2025-09-28T01:09:08Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2384417353","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2384417353"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2384417353"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2384417353/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":94,"original_line":94,"side":"RIGHT","author_association":"MEMBER","original_position":94,"position":94,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2385309264","pull_request_review_id":3276138216,"id":2385309264,"node_id":"PRRC_kwDOPaLyBs6OLO5Q","diff_hunk":"@@ -0,0 +1,240 @@\n+//! Centralized error mapping for Axum\n+//!\n+//! This module provides utilities for automatically converting all framework\n+//! and module errors into consistent RFC 9457 Problem+JSON responses, eliminating\n+//! per-route boilerplate.\n+\n+use axum::{\n+    extract::Request,\n+    http::{HeaderMap, StatusCode},\n+    middleware::Next,\n+    response::Response,\n+};\n+use std::any::Any;\n+\n+use crate::api::problem::{Problem, ProblemResponse};\n+use crate::context::ConfigError;\n+use odata_core::Error as ODataError;\n+\n+/// Middleware function that provides centralized error mapping\n+///\n+/// This middleware can be applied to routes to automatically extract request context\n+/// and provide it to error handlers. The actual error conversion happens in the\n+/// `IntoProblemResponse` trait implementations and `map_error_to_problem` function.\n+pub async fn error_mapping_middleware(request: Request, next: Next) -> Response {\n+    let _uri = request.uri().clone();\n+    let _headers = request.headers().clone();\n+\n+    let response = next.run(request).await;\n+\n+    // If the response is already successful or is already a Problem response, pass it through\n+    if response.status().is_success() || is_problem_response(&response) {\n+        return response;\n+    }\n+\n+    // For error responses, the actual error conversion should happen in the handlers\n+    // using the IntoProblemResponse trait or map_error_to_problem function\n+    // This middleware provides the infrastructure for extracting request context\n+    response\n+}\n+\n+/// Check if a response is already a Problem+JSON response\n+fn is_problem_response(response: &Response) -> bool {\n+    response\n+        .headers()\n+        .get(axum::http::header::CONTENT_TYPE)\n+        .and_then(|v| v.to_str().ok())\n+        .map(|ct| ct.contains(\"application/problem+json\"))\n+        .unwrap_or(false)\n+}\n+\n+/// Extract trace ID from headers or generate one\n+pub fn extract_trace_id(headers: &HeaderMap) -> Option<String> {\n+    // Try to get trace ID from various common headers\n+    headers\n+        .get(\"x-trace-id\")\n+        .or_else(|| headers.get(\"x-request-id\"))\n+        .or_else(|| headers.get(\"traceparent\"))\n+        .and_then(|v| v.to_str().ok())\n+        .map(|s| s.to_string())\n+        .or_else(|| {\n+            // Try to get from current tracing span\n+            tracing::Span::current()\n+                .id()\n+                .map(|id| id.into_u64().to_string())\n+        })\n+}\n+\n+/// Centralized error mapping function\n+///\n+/// This function provides a single place to convert all framework and module errors\n+/// into consistent Problem responses with proper trace IDs and instance paths.\n+pub fn map_error_to_problem(\n+    error: &dyn Any,\n+    instance: &str,\n+    trace_id: Option<String>,\n+) -> ProblemResponse {\n+    // Try to downcast to known error types\n+    if let Some(odata_err) = error.downcast_ref::<ODataError>() {\n+        let mut problem = crate::api::odata::error::odata_error_to_problem(odata_err, instance);\n+        if let Some(tid) = trace_id {\n+            problem.0 = problem.0.with_trace_id(tid);\n+        }\n+        return problem;\n+    }\n+\n+    if let Some(config_err) = error.downcast_ref::<ConfigError>() {\n+        let problem = match config_err {\n+            ConfigError::ModuleNotFound { module } => Problem::new(\n+                StatusCode::INTERNAL_SERVER_ERROR,\n+                \"Configuration Error\",\n+                format!(\"Module '{}' configuration not found\", module),\n+            )\n+            .with_code(\"CONFIG_MODULE_NOT_FOUND\")\n+            .with_type(\"https://errors.example.com/CONFIG_MODULE_NOT_FOUND\"),","path":"libs/modkit/src/api/error_layer.rs","commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","original_commit_id":"c84d0afc3bc5f01dd20e0d172a8a19836a3b7ab0","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"can we manage error definitions in JSONs and do something like this?\r\n\r\nIt would allow us to have a gts/ folder in every module where we define:\r\n- errors.json\r\n- events.json\r\n- settings.json\r\n- ...\r\n\r\nAnd so later we can autogenerate Rust code (macro) for the defined types, thus we would achieve more declarative extensions definition approach and strict compile time validation at the same time\r\n\r\n```\r\n// build.rs\r\n// Purpose: validate errors.json at build time and emit a strongly-typed, macro-backed catalog.\r\nuse std::{env, fs, path::PathBuf};\r\n\r\nfn main() {\r\n    println!(\"cargo:rerun-if-changed=errors.json\");\r\n    let manifest_dir = PathBuf::from(env::var(\"CARGO_MANIFEST_DIR\").unwrap());\r\n    let json_path = manifest_dir.join(\"errors.json\");\r\n    let data = fs::read_to_string(&json_path)\r\n        .expect(\"errors.json: cannot read\");\r\n    let entries: Vec<Entry> = serde_json::from_str(&data)\r\n        .expect(\"errors.json: invalid JSON\");\r\n    validate(&entries);\r\n\r\n    let out_dir = PathBuf::from(env::var(\"OUT_DIR\").unwrap());\r\n    let out = out_dir.join(\"errors_catalog.rs\");\r\n    fs::write(out, render(&entries))\r\n        .expect(\"cannot write generated catalog\");\r\n}\r\n\r\n#[derive(serde::Deserialize)]\r\nstruct Entry {\r\n    status: u16,\r\n    title: String,\r\n    code: String, // e.g. \"gts.hx.core.err.v1~hx.core.module.config_invalid_structure.v1\"\r\n}\r\n\r\nfn validate(entries: &[Entry]) {\r\n    use std::collections::HashSet;\r\n    let mut seen = HashSet::new();\r\n    for e in entries {\r\n        assert!(seen.insert(&e.code), \"duplicate code: {}\", e.code);\r\n        assert!(e.status >= 100 && e.status <= 599, \"bad HTTP status: {}\", e.status);\r\n        assert!(!e.title.trim().is_empty(), \"empty title for {}\", e.code);\r\n    }\r\n}\r\n\r\nfn render(entries: &[Entry]) -> String {\r\n    let mut defs = String::new();\r\n    let mut map_items = String::new();\r\n    let mut match_arms = String::new();\r\n\r\n    for (i, e) in entries.iter().enumerate() {\r\n        let const_name = format!(\"DEF_{}\", i);\r\n        let ty = format!(\"https://errors.example.com/{}\", e.code);\r\n        defs.push_str(&format!(\r\n            \"pub const {name}: ErrDef = ErrDef{{ status: {status}, title: {title:?}, code: {code:?}, r#type: {ty:?} }};\\n\",\r\n            name=const_name, status=e.status, title=e.title, code=e.code, ty=ty\r\n        ));\r\n        map_items.push_str(&format!(\"    {code:?} => &{const_name},\\n\", code=e.code, const_name));\r\n        match_arms.push_str(&format!(\r\n            r#\"    ({code:?}) => ({status}u16, {title:?}, {code:?}, {ty:?}),\"#,\r\n            code=e.code, status=e.status, title=e.title, ty=ty\r\n        ));\r\n        match_arms.push('\\n');\r\n    }\r\n\r\n    format!(r#\"\r\n        // @generated by build.rs — do not edit.\r\n        use phf::phf_map;\r\n\r\n        pub struct ErrDef {{\r\n            pub status: u16,\r\n            pub title: &'static str,\r\n            pub code:  &'static str,\r\n            pub r#type: &'static str,\r\n        }}\r\n\r\n        {defs}\r\n\r\n        pub static ERRORS_BY_CODE: phf::Map<&'static str, &'static ErrDef> = phf_map! {{\r\n        {map_items}\r\n        }};\r\n\r\n        // Compile-time guard: non-existent codes won't match and will fail to compile.\r\n        #[macro_export]\r\n        macro_rules! __error_tuple_from_catalog {{\r\n        {match_arms}\r\n            ($unknown:literal) => {{\r\n                compile_error!(\"Unknown error code literal — not present in errors.json\");\r\n            }};\r\n        }}\r\n    \"#,\r\n        defs=defs, map_items=map_items, match_arms=match_arms\r\n    )\r\n}\r\n\r\n-----\r\n\r\n// Cargo.toml (add these)\r\n# Purpose: build-time parsing and generated map\r\n[build-dependencies]\r\nserde = { version = \"1\", features = [\"derive\"] }\r\nserde_json = \"1\"\r\n\r\n[dependencies]\r\nphf = { version = \"0.11\", features = [\"macros\"] }\r\nhttp = \"1\"            # for StatusCode (or use axum's re-export)\r\n\r\n-----\r\n\r\n// errors.json  (project root)\r\n// Purpose: single source of truth for errors\r\n[\r\n  {\r\n    \"status\": 500,\r\n    \"title\": \"Configuration Error\",\r\n    \"code\": \"gts.hx.core.err.v1~hx.core.module.config_invalid_structure.v1\"\r\n  },\r\n  {\r\n    \"status\": 404,\r\n    \"title\": \"Module Not Found\",\r\n    \"code\": \"gts.hx.core.err.v1~hx.core.module.config_not_found.v1\"\r\n  }\r\n]\r\n\r\n-----\r\n\r\n// src/errors/catalog.rs\r\n// Purpose: expose catalog, and a macro that builds a Problem from a code literal.\r\n#![allow(non_upper_case_globals)]\r\ninclude!(concat!(env!(\"OUT_DIR\"), \"/errors_catalog.rs\"));\r\n\r\n#[macro_export]\r\nmacro_rules! problem_from_catalog {\r\n    // Detail via format!-style args\r\n    ($code:literal, $($arg:tt)*) => {{\r\n        let (status, title, code, ty) = $crate::__error_tuple_from_catalog!($code);\r\n        $crate::Problem::new(\r\n            ::http::StatusCode::from_u16(status).unwrap(), // status validated in build.rs\r\n            title,\r\n            format!($($arg)*),\r\n        )\r\n        .with_code(code)\r\n        .with_type(ty)\r\n    }};\r\n    // Static detail\r\n    ($code:literal) => {{\r\n        let (status, title, code, ty) = $crate::__error_tuple_from_catalog!($code);\r\n        $crate::Problem::new(\r\n            ::http::StatusCode::from_u16(status).unwrap(),\r\n            title,\r\n            \"\",\r\n        )\r\n        .with_code(code)\r\n        .with_type(ty)\r\n    }};\r\n}\r\n\r\n-----\r\n\r\n// src/handlers/config.rs\r\n// Purpose: use the macro — one code literal, zero duplication.\r\nmatch err {\r\n    ConfigError::InvalidModuleStructure { module } => {\r\n        problem_from_catalog!(\r\n            \"gts.hx.core.err.v1~hx.core.module.config_invalid_structure.v1\",\r\n            \"Module '{}' has invalid configuration structure\",\r\n            module\r\n        )\r\n    }\r\n    // ...\r\n}","created_at":"2025-09-28T10:08:32Z","updated_at":"2025-09-28T11:37:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2385309264","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2385309264"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/17#discussion_r2385309264"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/17"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2385309264/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":94,"original_line":94,"side":"RIGHT","in_reply_to_id":2384417353,"author_association":"MEMBER","original_position":94,"position":94,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":12,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/12","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #12] feat(pagination and orderby): centralize pagination and enforce cursor+orderby exclusion policy","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/order_pagination_and_more","pr_head_sha":"355b80b7e2fc1ad94da7a2cdfb2e79fced8a600a","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/12","id":2846063183,"node_id":"PR_kwDOPaLyBs6po3pP","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/12","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/12.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/12.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/12","number":12,"state":"closed","locked":false,"title":"feat(pagination and orderby): centralize pagination and enforce cursor+orderby exclusion policy","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\r\nImplements centralized OData pagination system with strict cursor+orderby policy enforcement, improved error handling, and comprehensive testing.\r\n\r\n## Key Changes\r\n\r\n### Core Features\r\n- **Centralized Pagination**: Move pagination logic to libs/db/odata.rs with single `paginate_with_odata` function handling filter, cursor, order, overfetch, and cursor building\r\n- **Policy Enforcement**: Implement \"cursor ⇒ no $orderby\" rule - returns HTTP 400 ORDER_WITH_CURSOR when both parameters are provided\r\n- **Enhanced Error Handling**: Add `ODataPageError::OrderWithCursor` variant with proper Problem (RFC 9457) response mapping\r\n\r\n### Order Derivation Logic\r\n- **From Cursor**: When cursor present, derive order from `cursor.s` signed tokens using `ODataOrderBy::from_signed_tokens`\r\n- **From Query**: When cursor absent, use client $orderby with tiebreaker appended\r\n- **Validation**: All order fields validated against allowlist via FieldMap\r\n\r\n### Error & Type Improvements\r\n- **Problem Mapping**: Centralized OData error to Problem response conversion\r\n- **Type Complexity**: Add CursorExtractor type alias to reduce clippy warnings\r\n- **Iterator Optimization**: Replace needless range loops with iterator patterns\r\n\r\n### Testing & Integration\r\n- **Policy Tests**: New tests in odata_policy_tests.rs for cursor+orderby conflict\r\n- **Integration Tests**: End-to-end validation in users_info module\r\n- **Test Fixes**: URL encoding fixes and updated expectations for new behavior\r\n- **Error Mapping**: Update users_info error handling for new ODataPageError variants","created_at":"2025-09-20T07:45:14Z","updated_at":"2025-09-24T22:41:23Z","closed_at":"2025-09-24T22:41:23Z","merged_at":"2025-09-24T22:41:23Z","merge_commit_sha":"2c6825877199717da8429065c4573e7a380cb557","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/12/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/12/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/12/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/355b80b7e2fc1ad94da7a2cdfb2e79fced8a600a","head":{"label":"modcrafter77:feature/order_pagination_and_more","ref":"feature/order_pagination_and_more","sha":"355b80b7e2fc1ad94da7a2cdfb2e79fced8a600a","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://gi
lls/comments/2641329014","pull_request_review_id":3605843750,"id":2641329014,"node_id":"PRRC_kwDOPaLyBs6db3t2","diff_hunk":"@@ -0,0 +1,76 @@\n+use axum::extract::Request;\n+use axum::http::StatusCode;\n+use axum::middleware::Next;\n+use axum::response::{IntoResponse, Response};\n+use dashmap::DashMap;\n+use http::Method;\n+use std::sync::Arc;\n+\n+use modkit::api::{OperationSpec, Problem};\n+\n+const BASE_FEATURE: &str = \"gts.x.core.lic.feat.v1~x.core.global.base.v1\";\n+\n+type LicenseKey = (Method, String);\n+\n+#[derive(Clone)]\n+pub struct LicenseRequirementMap {\n+    requirements: Arc<DashMap<LicenseKey, String>>,\n+}\n+\n+impl LicenseRequirementMap {\n+    #[must_use]\n+    pub fn from_specs(specs: &[OperationSpec]) -> Self {\n+        let requirements = DashMap::new();\n+\n+        for spec in specs {\n+            if let Some(req) = spec.license_requirement.as_ref() {\n+                requirements.insert(\n+                    (spec.method.clone(), spec.path.clone()),\n+                    req.license_name.clone(),\n+                );\n+            }\n+        }\n+\n+        Self {\n+            requirements: Arc::new(requirements),\n+        }\n+    }\n+\n+    fn get(&self, method: &Method, path: &str) -> Option<String> {\n+        self.requirements\n+            .get(&(method.clone(), path.to_owned()))\n+            .map(|v| v.value().clone())\n+    }\n+}\n+\n+pub async fn license_validation_middleware(","path":"modules/api_ingress/src/middleware/license_validation.rs","commit_id":"17c504cfbaaf58f1ade0be7a7c6807b563521e85","original_commit_id":"cbc58ed53f78bf76344f82b667a017d51c861f85","user":{"login":"MikeFalcon77","id":3686170,"node_id":"MDQ6VXNlcjM2ODYxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/3686170?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeFalcon77","html_url":"https://github.com/MikeFalcon77","followers_url":"https://api.github.com/users/MikeFalcon77/followers","following_url":"https://api.github.com/users/M
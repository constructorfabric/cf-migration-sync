     // Collect battery capabilities using sysinfo data\n+        capabilities.extend(self.collect_battery_caps(&sysinfo)?);\n+\n+        // Collect software capabilities\n+        capabilities.extend(self.collect_software_caps()?);\n+\n+        Ok(NodeSysCap {\n+            node_id,\n+            capabilities,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_hardware_caps(&self, sysinfo: &NodeSysInfo) -> Result<Vec<SysCap>, NodeInfoError> {\n+        let mut caps = Vec::new();\n+\n+        // Architecture detection from sysinfo\n+        let arch = &sysinfo.os.arch;\n+        caps.push(Self::create_syscap(\n+            format!(\"hardware:{}\", arch),\n+            \"hardware\".to_string(),\n+            arch.to_string(),\n+            arch.to_uppercase(),\n+            true,\n+            None,\n+            None,\n+            None,\n+            Some(format!(\"{} architecture detected\", arch)),\n+            3600, // 1 hour cache (never changes)\n+        ));\n+\n+        // RAM detection from sysinfo\n+        let total_gb = sysinfo.memory.total_bytes as f64 / (1024.0 * 1024.0 * 1024.0);\n+        caps.push(Self::create_syscap(\n+            \"hardware:ram\".to_string(),\n+            \"hardware\".to_string(),\n+            \"ram\".to_string(),\n+            \"RAM\".to_string(),\n+            true,\n+            None,\n+            Some(total_gb),\n+            Some(\"GB\".to_string()),\n+            Some(format!(\n+                \"Total: {:.2} GB, Used: {}%\",\n+                total_gb, sysinfo.memory.used_percent\n+            )),\n+            5, // 5 seconds cache (changes frequently)\n+        ));\n+\n+        // CPU capability from sysinfo\n+        caps.push(Self::create_syscap(\n+            \"hardware:cpu\".to_string(),\n+            \"hardware\".to_string(),\n+            \"cpu\".to_string(),\n+            \"CPU\".to_string(),\n+            true,\n+            Some(sysinfo.cpu.model.clone()),\n+            Some(sysinfo.cpu.cores as f64),\n+            Some(\"cores\".to_string()),\n+            Some(format!(\n+                \"{} with {} cores @ {:.0} MHz\",\n+                sysinfo.cpu.model, sysinfo.cpu.cores, sysinfo.cpu.frequency_mhz\n+            )),\n+            600, // 10 minutes cache (changes rarely)\n+        ));\n+\n+        Ok(caps)\n+    }\n+\n+    fn collect_os_caps(&self, sysinfo: &NodeSysInfo) -> Result<Vec<SysCap>, NodeInfoError> {\n+        let mut caps = Vec::new();\n+\n+        let os = std::env::consts::OS;\n+        caps.push(Self::create_syscap(\n+            format!(\"os:{}\", os),\n+            \"os\".to_string(),\n+            os.to_string(),\n+            match os {\n+                \"macos\" => \"macOS\",\n+                \"linux\" => \"Linux\",\n+                \"windows\" => \"Windows\",\n+                _ => os,\n+            }\n+            .to_string(),\n+            true,\n+            Some(sysinfo.os.version.clone()),\n+            None,\n+            None,\n+            Some(format!(\n+                \"Platform: {}, Version: {}, Arch: {}\",\n+                sysinfo.os.name, sysinfo.os.version, sysinfo.os.arch\n+            )),\n+            120, // 2 minutes cache (OS doesn't change much)\n+        ));\n+\n+        Ok(caps)\n+    }\n+\n+    fn collect_gpu_caps(&self, sysinfo: &NodeSysInfo) -> Result<Vec<SysCap>, NodeInfoError> {\n+        let mut caps = Vec::new();\n+\n+        for (i, gpu) in sysinfo.gpus.iter().enumerate() {","path":"libs/modkit-node-info/src/syscap_collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Instead of creating a Vec::new, you better do `sysinfo.gpus.iter().enumerate().map(...).collect()`","created_at":"2025-12-02T13:36:12Z","updated_at":"2025-12-02T13:36:13Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581226837","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581226837"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581226837"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581226837/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":208,"original_line":163,"side":"RIGHT","author_association":"MEMBER","original_position":163,"position":208,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581227053","pull_request_review_id":3530181186,"id":2581227053,"node_id":"PRRC_kwDOPaLyBs6Z2mYt","diff_hunk":"@@ -0,0 +1,154 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use crate::domain::error::DomainError;\n+use crate::domain::node_storage::NodeStorage;\n+use modkit_node_info::NodeInfoCollector;\n+use std::sync::Arc;\n+\n+/// Service for managing nodes and their metadata\n+#[derive(Clone)]\n+pub struct Service {\n+    storage: Arc<NodeStorage>,\n+    node_info_collector: Arc<NodeInfoCollector>,\n+}\n+\n+impl Service {\n+    pub fn new() -> Self {\n+        let node_info_collector = Arc::new(NodeInfoCollector::new());\n+        let current_node = node_info_collector.create_current_node();\n+        let storage = Arc::new(NodeStorage::new());\n+\n+        // Check if hardware detection failed (hybrid UUID with zeros on left)\n+        let uuid_bytes = current_node.id.as_bytes();\n+        let is_fallback = uuid_bytes[0..8].iter().all(|&b| b == 0);","path":"modules/nodes_registry/src/domain/service.rs","commit_id":"b7df5ffb8af41ec58ae082492f44b11b8d7629ba","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Let's replace this iterator with simple zero-slice check, like:\n\nfn is_fallback_uuid(id: &uuid::Uuid) -> bool {\n    let bytes = id.as_bytes();\n    bytes[..8] == [0u8; 8]\n}","created_at":"2025-12-02T13:36:15Z","updated_at":"2025-12-02T14:35:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581227053","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581227053"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581227053"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581227053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581237833","pull_request_review_id":3530194289,"id":2581237833,"node_id":"PRRC_kwDOPaLyBs6Z2pBJ","diff_hunk":"@@ -0,0 +1,84 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use crate::syscap_collector::SysCapCollector;\n+use crate::sysinfo_collector::SysInfoCollector;\n+use std::sync::Arc;\n+\n+/// Main collector for node information\n+pub struct NodeInfoCollector {","path":"libs/modkit-node-info/src/collector.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We might need to consider `#[derive(Default)]` more to not manually implement the trait all the time","created_at":"2025-12-02T13:39:03Z","updated_at":"2025-12-02T13:39:03Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581237833","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581237833"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581237833"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581237833/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":8,"original_line":8,"side":"RIGHT","author_association":"MEMBER","original_position":8,"position":8,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581246155","pull_request_review_id":3530204249,"id":2581246155,"node_id":"PRRC_kwDOPaLyBs6Z2rDL","diff_hunk":"@@ -0,0 +1,118 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Linux using NVML for NVIDIA GPUs, fallback to lspci\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to lspci for AMD/Intel/other GPUs\n+    tracing::debug!(\"NVML not available, falling back to lspci\");\n+    collect_gpus_via_lspci()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {","path":"libs/modkit-node-info/src/gpu_collector_linux.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is a `flat_map` iterator","created_at":"2025-12-02T13:41:01Z","updated_at":"2025-12-02T13:41:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581246155","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581246155"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581246155"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581246155/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":35,"side":"RIGHT","author_association":"MEMBER","original_position":35,"position":36,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581263881","pull_request_review_id":3530225343,"id":2581263881,"node_id":"PRRC_kwDOPaLyBs6Z2vYJ","diff_hunk":"@@ -0,0 +1,118 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Linux using NVML for NVIDIA GPUs, fallback to lspci\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to lspci for AMD/Intel/other GPUs\n+    tracing::debug!(\"NVML not available, falling back to lspci\");\n+    collect_gpus_via_lspci()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {\n+        match nvml.device_by_index(i) {\n+            Ok(device) => {\n+                let model = device\n+                    .name()\n+                    .unwrap_or_else(|_| \"Unknown NVIDIA GPU\".to_string());\n+\n+                // Get memory info\n+                let memory_info = device.memory_info().ok();\n+                let total_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.total as f64 / 1024.0 / 1024.0);\n+                let used_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.used as f64 / 1024.0 / 1024.0);\n+\n+                // Try to get CUDA cores (not directly available, but we can get compute capability)\n+                let cores = None; // NVML doesn't expose CUDA cores directly\n+\n+                gpus.push(GpuInfo {\n+                    model,\n+                    cores,\n+                    total_memory_mb,\n+                    used_memory_mb,\n+                });\n+\n+                tracing::debug!(\n+                    \"NVIDIA GPU {}: {} (Memory: {:.0} MB / {:.0} MB)\",\n+                    i,\n+                    gpus.last().unwrap().model,\n+                    used_memory_mb.unwrap_or(0.0),\n+                    total_memory_mb.unwrap_or(0.0)\n+                );\n+            }\n+            Err(e) => {\n+                tracing::warn!(\"Failed to get NVML device handle for GPU #{}: {}\", i, e);\n+            }\n+        }\n+    }\n+\n+    Ok(gpus)\n+}\n+\n+/// Collect GPU information using lspci (fallback for non-NVIDIA GPUs)\n+fn collect_gpus_via_lspci() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    let output = Command::new(\"lspci\").output();","path":"libs/modkit-node-info/src/gpu_collector_linux.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I would reduce the dependency of the environment by leveraging the inner use of that command like:\r\n```rust\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\nfn main() -> std::io::Result<()> {\r\n    let pci_path = Path::new(\"/sys/bus/pci/devices\");\r\n\r\n    for entry in fs::read_dir(pci_path)? {\r\n        let entry = entry?;\r\n        let dev_path = entry.path();\r\n\r\n        let vendor = fs::read_to_string(dev_path.join(\"vendor\"))?\r\n            .trim()\r\n            .to_string();\r\n        let device = fs::read_to_string(dev_path.join(\"device\"))?\r\n            .trim()\r\n            .to_string();\r\n        let class  = fs::read_to_string(dev_path.join(\"class\"))?\r\n            .trim()\r\n            .to_string();\r\n\r\n        println!(\r\n            \"{}: vendor={} device={} class={}\",\r\n            dev_path.file_name().unwrap().to_string_lossy(),\r\n            vendor,\r\n            device,\r\n            class\r\n        );\r\n    }\r\n\r\n    Ok(())\r\n}\r\n```","created_at":"2025-12-02T13:45:12Z","updated_at":"2025-12-02T13:45:12Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581263881","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581263881"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581263881"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581263881/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":81,"original_line":80,"side":"RIGHT","author_association":"MEMBER","original_position":80,"position":81,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581269373","pull_request_review_id":3530232225,"id":2581269373,"node_id":"PRRC_kwDOPaLyBs6Z2wt9","diff_hunk":"@@ -0,0 +1,128 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Windows using NVML for NVIDIA GPUs, fallback to WMIC\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to WMIC for other GPUs\n+    tracing::debug!(\"NVML not available, falling back to WMIC\");\n+    collect_gpus_via_wmic()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {","path":"libs/modkit-node-info/src/gpu_collector_windows.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"another `flat_map` iterator, looks like this common functionality can be generalize to reduce code duplication","created_at":"2025-12-02T13:46:24Z","updated_at":"2025-12-02T13:46:25Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581269373","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581269373"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581269373"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581269373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":35,"side":"RIGHT","author_association":"MEMBER","original_position":35,"position":36,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581270189","pull_request_review_id":3530181186,"id":2581270189,"node_id":"PRRC_kwDOPaLyBs6Z2w6t","diff_hunk":"@@ -0,0 +1,154 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use crate::domain::error::DomainError;\n+use crate::domain::node_storage::NodeStorage;\n+use modkit_node_info::NodeInfoCollector;\n+use std::sync::Arc;\n+\n+/// Service for managing nodes and their metadata\n+#[derive(Clone)]\n+pub struct Service {\n+    storage: Arc<NodeStorage>,\n+    node_info_collector: Arc<NodeInfoCollector>,\n+}\n+\n+impl Service {\n+    pub fn new() -> Self {\n+        let node_info_collector = Arc::new(NodeInfoCollector::new());\n+        let current_node = node_info_collector.create_current_node();\n+        let storage = Arc::new(NodeStorage::new());\n+\n+        // Check if hardware detection failed (hybrid UUID with zeros on left)\n+        let uuid_bytes = current_node.id.as_bytes();\n+        let is_fallback = uuid_bytes[0..8].iter().all(|&b| b == 0);\n+\n+        if is_fallback {\n+            tracing::warn!(\n+                node_id = %current_node.id,\n+                \"Hardware UUID detection failed, using fallback UUID (00000000-0000-0000-xxxx-xxxxxxxxxxxx)\"\n+            );\n+        } else {\n+            tracing::info!(\n+                node_id = %current_node.id,\n+                hostname = %current_node.hostname,\n+                ip_address = ?current_node.ip_address,\n+                \"Initialized node with hardware-based UUID\"\n+            );\n+        }\n+\n+        storage.upsert_node(current_node);\n+\n+        Self {\n+            storage,\n+            node_info_collector,\n+        }\n+    }\n+\n+    /// Get a node by ID\n+    pub async fn get_node(&self, id: uuid::Uuid) -> Result<Node, DomainError> {\n+        self.storage\n+            .get_node(id)\n+            .ok_or(DomainError::NodeNotFound(id))\n+    }\n+\n+    /// List all nodes\n+    pub async fn list_nodes(&self) -> Result<Vec<Node>, DomainError> {\n+        Ok(self.storage.list_nodes())\n+    }\n+\n+    /// Get system information for a node (with caching)\n+    pub async fn get_node_sysinfo(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, DomainError> {\n+        // Check if node exists\n+        if self.storage.get_node(node_id).is_none() {\n+            return Err(DomainError::NodeNotFound(node_id));\n+        }\n+\n+        // Try to get cached sysinfo\n+        if let Some(cached) = self.storage.get_sysinfo(node_id) {\n+            return Ok(cached);\n+        }\n+\n+        // Collect fresh sysinfo\n+        let sysinfo = self\n+            .node_info_collector\n+            .collect_sysinfo(node_id)\n+            .map_err(|e| DomainError::SysInfoCollectionFailed(e.to_string()))?;","path":"modules/nodes_registry/src/domain/service.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"looks like a error conversion is wrong.\nNodeInfoError::X -> String -> DomainError::X(String).\n\nThe better way: \n1. collect should return NodeInfoError \n2. In domain:\n     .collect_sysinfo(node_id)\n    .map_err(DomainError::from)?;\n3. Implement impl From<NodeInfoError> for DomainError","created_at":"2025-12-02T13:46:37Z","updated_at":"2025-12-02T14:35:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581270189","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581270189"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581270189"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581270189/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":74,"side":"RIGHT","author_association":"MEMBER","original_position":74,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581275081","pull_request_review_id":3530239095,"id":2581275081,"node_id":"PRRC_kwDOPaLyBs6Z2yHJ","diff_hunk":"@@ -0,0 +1,54 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use regex::Regex;\n+use std::process::Command;\n+\n+/// Collect GPU information on macOS using system_profiler\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    let output = Command::new(\"system_profiler\")\n+        .arg(\"SPDisplaysDataType\")\n+        .output()\n+        .map_err(|e| {\n+            NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to run system_profiler: {}\", e))\n+        })?;\n+\n+    if !output.status.success() {\n+        return Ok(Vec::new());\n+    }\n+\n+    let output_str = String::from_utf8_lossy(&output.stdout);\n+    let mut gpus = Vec::new();\n+\n+    // Parse GPU model names\n+    let model_regex = Regex::new(r\"Chipset Model: (.+)\")","path":"libs/modkit-node-info/src/gpu_collector_macos.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Compiling regex onthefly is always a bad idea","created_at":"2025-12-02T13:47:48Z","updated_at":"2025-12-02T13:47:48Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581275081","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581275081"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581275081"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581275081/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":23,"side":"RIGHT","author_association":"MEMBER","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581280261","pull_request_review_id":3530181186,"id":2581280261,"node_id":"PRRC_kwDOPaLyBs6Z2zYF","diff_hunk":"@@ -0,0 +1,195 @@\n+use crate::contract::{Node, NodeSysCap, NodeSysInfo, SysCap};\n+use std::collections::HashMap;\n+use std::sync::RwLock;\n+use uuid::Uuid;\n+\n+/// Cached node data with timestamps\n+#[derive(Debug, Clone)]\n+struct CachedNodeData {\n+    node: Node,\n+    sysinfo: Option<NodeSysInfo>,\n+    /// System-collected capabilities from modkit-node-info\n+    syscap_system: Option<NodeSysCap>,\n+    /// Custom capabilities set through service interface\n+    syscap_custom: HashMap<String, SysCap>,\n+}\n+\n+/// In-memory storage for nodes and their metadata\n+pub struct NodeStorage {\n+    nodes: RwLock<HashMap<Uuid, CachedNodeData>>,\n+}\n+\n+impl NodeStorage {\n+    pub fn new() -> Self {\n+        Self {\n+            nodes: RwLock::new(HashMap::new()),\n+        }\n+    }\n+\n+    /// Register or update a node\n+    pub fn upsert_node(&self, node: Node) {\n+        let mut nodes = self.nodes.write().unwrap();\n+        nodes.insert(\n+            node.id,\n+            CachedNodeData {\n+                node,\n+                sysinfo: None,\n+                syscap_system: None,\n+                syscap_custom: HashMap::new(),\n+            },\n+        );\n+    }\n+\n+    /// Get a node by ID\n+    pub fn get_node(&self, id: Uuid) -> Option<Node> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.get(&id).map(|data| data.node.clone())\n+    }\n+\n+    /// List all nodes\n+    pub fn list_nodes(&self) -> Vec<Node> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.values().map(|data| data.node.clone()).collect()\n+    }\n+\n+    /// Update sysinfo for a node\n+    pub fn update_sysinfo(&self, node_id: Uuid, sysinfo: NodeSysInfo) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.sysinfo = Some(sysinfo);\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Get sysinfo for a node\n+    pub fn get_sysinfo(&self, node_id: Uuid) -> Option<NodeSysInfo> {\n+        let nodes = self.nodes.read().unwrap();\n+        nodes.get(&node_id).and_then(|data| data.sysinfo.clone())\n+    }\n+\n+    /// Update system-collected syscap for a node\n+    pub fn update_syscap_system(&self, node_id: Uuid, syscap: NodeSysCap) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.syscap_system = Some(syscap);\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Get merged syscap for a node (system + custom)\n+    pub fn get_syscap(&self, node_id: Uuid) -> Option<NodeSysCap> {\n+        let nodes = self.nodes.read().unwrap();\n+        if let Some(data) = nodes.get(&node_id) {\n+            // Merge system and custom capabilities\n+            let mut cap_map: HashMap<String, SysCap> = HashMap::new();\n+\n+            // Add system capabilities first\n+            if let Some(ref syscap_system) = data.syscap_system {\n+                for cap in &syscap_system.capabilities {\n+                    cap_map.insert(cap.key.clone(), cap.clone());\n+                }\n+            }\n+\n+            // Override/add custom capabilities\n+            for (key, cap) in &data.syscap_custom {\n+                cap_map.insert(key.clone(), cap.clone());\n+            }\n+\n+            if cap_map.is_empty() {\n+                None\n+            } else {\n+                Some(NodeSysCap {\n+                    node_id,\n+                    capabilities: cap_map.into_values().collect(),\n+                    collected_at: chrono::Utc::now(),\n+                })\n+            }\n+        } else {\n+            None\n+        }\n+    }\n+\n+    /// Set custom syscap entries (add or update)\n+    pub fn set_custom_syscap(&self, node_id: Uuid, caps: Vec<SysCap>) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            for cap in caps {\n+                data.syscap_custom.insert(cap.key.clone(), cap);\n+            }\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Remove custom syscap entries by key\n+    pub fn remove_custom_syscap(&self, node_id: Uuid, keys: Vec<String>) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            for key in keys {\n+                data.syscap_custom.remove(&key);\n+            }\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Clear all custom syscap entries for a node\n+    pub fn clear_custom_syscap(&self, node_id: Uuid) -> bool {\n+        let mut nodes = self.nodes.write().unwrap();\n+        if let Some(data) = nodes.get_mut(&node_id) {\n+            data.syscap_custom.clear();\n+            true\n+        } else {\n+            false\n+        }\n+    }\n+\n+    /// Check if a system syscap entry needs refresh based on cache TTL\n+    #[allow(dead_code)]\n+    pub fn needs_syscap_refresh(&self, node_id: Uuid, key: &str) -> bool {\n+        let nodes = self.nodes.read().unwrap();\n+        if let Some(data) = nodes.get(&node_id) {\n+            if let Some(ref syscap_system) = data.syscap_system {\n+                if let Some(cap) = syscap_system.capabilities.iter().find(|c| c.key == key) {\n+                    let now = chrono::Utc::now().timestamp();\n+                    let age_secs = now - cap.fetched_at_secs;","path":"modules/nodes_registry/src/domain/node_storage.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In some cases (clock skew, system date/time change) age_secs may be set to negative value. And a cache won't be invalidated.\nLet's do something like: let age_secs = (now - cap.fetched_at_secs).max(0);","created_at":"2025-12-02T13:48:56Z","updated_at":"2025-12-02T14:35:01Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581280261","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581280261"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581280261"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581280261/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":161,"side":"RIGHT","author_association":"MEMBER","original_position":161,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581285332","pull_request_review_id":3530250669,"id":2581285332,"node_id":"PRRC_kwDOPaLyBs6Z20nU","diff_hunk":"","path":"libs/modkit-node-info/src/gpu_collector_macos.rs","commit_id":"9f1449d8875c0463182713735c6032131e9929a5","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"question as TODO: how do we test this code?","created_at":"2025-12-02T13:50:04Z","updated_at":"2025-12-02T13:50:04Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581285332","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581285332"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581285332"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581285332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581290915","pull_request_review_id":3530257103,"id":2581290915,"node_id":"PRRC_kwDOPaLyBs6Z21-j","diff_hunk":"@@ -0,0 +1,128 @@\n+use crate::error::NodeInfoError;\n+use crate::model::GpuInfo;\n+use std::process::Command;\n+\n+/// Collect GPU information on Windows using NVML for NVIDIA GPUs, fallback to WMIC\n+pub fn collect_gpu_info() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    // Try NVML first for NVIDIA GPUs\n+    if let Ok(nvidia_gpus) = collect_nvidia_gpus() {\n+        if !nvidia_gpus.is_empty() {\n+            tracing::debug!(\"Found {} NVIDIA GPU(s) via NVML\", nvidia_gpus.len());\n+            return Ok(nvidia_gpus);\n+        }\n+    }\n+\n+    // Fallback to WMIC for other GPUs\n+    tracing::debug!(\"NVML not available, falling back to WMIC\");\n+    collect_gpus_via_wmic()\n+}\n+\n+/// Collect NVIDIA GPU information using NVML\n+fn collect_nvidia_gpus() -> Result<Vec<GpuInfo>, NodeInfoError> {\n+    use nvml_wrapper::Nvml;\n+\n+    // Initialize NVML\n+    let nvml = Nvml::init().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"NVML initialization failed: {}\", e))\n+    })?;\n+\n+    let device_count = nvml.device_count().map_err(|e| {\n+        NodeInfoError::SysInfoCollectionFailed(format!(\"Failed to get NVML device count: {}\", e))\n+    })?;\n+\n+    let mut gpus = Vec::new();\n+\n+    for i in 0..device_count {\n+        match nvml.device_by_index(i) {\n+            Ok(device) => {\n+                let model = device\n+                    .name()\n+                    .unwrap_or_else(|_| \"Unknown NVIDIA GPU\".to_string());\n+\n+                // Get memory info\n+                let memory_info = device.memory_info().ok();\n+                let total_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.total as f64 / 1024.0 / 1024.0);\n+                let used_memory_mb = memory_info\n+                    .as_ref()\n+                    .map(|m| m.used as f64 / 1024.0 / 1024.0);\n+\n+                // NVML doesn't expose CUDA cores directly\n+                let cores = None;\n+\n+                gpus.push(GpuInfo {\n+                    model,\n+                    cores,\n+                    total_memory_mb,\n+                    used_memory_mb,\n+                });\n+\n+                tracing::debug!(\n+                    \"NVIDIA GPU {}: {} (Memory: {:.0} MB / {:.0} MB)\",\n+                    i,\n+                    gpus.last().unwrap().model,\n+                    used_memory_mb.unwrap_or(0.0),\n+                    total_memory_mb.unwrap_or(0.0)\n+                );\n+            }\n+            Err(e) => {\n+                tracing::warn!(\"Failed to get NVML device handle for GPU #{}: {}\", i, e);\n+            }\n+        }\n+    }\n+\n+    Ok(gpus)\n+}\n+\n+/// Collect GPU information using WMIC (fallback for non-NVIDIA GPUs)\n+fn collect_gpus_via_wmic() -> Result<Vec<GpuInfo>, NodeInfoError> {","path":"libs/modkit-node-info/src/gpu_collector_windows.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Same comments as on Mac and Linux:\r\nHow could we get the same output without relying on environment","created_at":"2025-12-02T13:51:34Z","updated_at":"2025-12-02T13:51:34Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581290915","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581290915"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581290915"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581290915/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":79,"side":"RIGHT","author_association":"MEMBER","original_position":79,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581298860","pull_request_review_id":3530267003,"id":2581298860,"node_id":"PRRC_kwDOPaLyBs6Z236s","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"why it accepts a _sys argument but it doesn't use it?\r\nwhy it returns a Result  if it always return Ok?","created_at":"2025-12-02T13:53:58Z","updated_at":"2025-12-02T13:53:58Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581298860","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581298860"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581298860"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581298860/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":48,"side":"RIGHT","author_association":"MEMBER","original_position":48,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581301942","pull_request_review_id":3530270648,"id":2581301942,"node_id":"PRRC_kwDOPaLyBs6Z24q2","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why returns a `Result` if it never returns Error?","created_at":"2025-12-02T13:54:52Z","updated_at":"2025-12-02T13:54:53Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581301942","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581301942"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581301942"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581301942/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":60,"side":"RIGHT","author_association":"MEMBER","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581303207","pull_request_review_id":3530272214,"id":2581303207,"node_id":"PRRC_kwDOPaLyBs6Z24-n","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why returns a Result if it never returns Error?","created_at":"2025-12-02T13:55:14Z","updated_at":"2025-12-02T13:55:15Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581303207","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581303207"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581303207"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581303207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":88,"side":"RIGHT","author_association":"MEMBER","original_position":88,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581305346","pull_request_review_id":3530274560,"id":2581305346,"node_id":"PRRC_kwDOPaLyBs6Z25gC","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {\n+        let total_bytes = sys.total_memory();\n+        let available_bytes = sys.available_memory();\n+        let used_bytes = sys.used_memory();\n+        let used_percent = if total_bytes > 0 {\n+            ((used_bytes as f64 / total_bytes as f64) * 100.0) as u32\n+        } else {\n+            0\n+        };\n+\n+        Ok(MemoryInfo {\n+            total_bytes,\n+            available_bytes,\n+            used_bytes,\n+            used_percent,\n+        })\n+    }\n+\n+    fn collect_host_info(&self) -> Result<HostInfo, NodeInfoError> {","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://api.github.com/users/Bechma/events{/privacy}","received_events_url":"https://api.github.com/users/Bechma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why returns a Result if it never returns Error?","created_at":"2025-12-02T13:55:48Z","updated_at":"2025-12-02T13:55:49Z","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581305346","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581305346"},"html":{"href":"https://github.com/cyberfabric/cyberware-rust/pull/35#discussion_r2581305346"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581305346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":106,"side":"RIGHT","author_association":"MEMBER","original_position":106,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2581307366","pull_request_review_id":3530276853,"id":2581307366,"node_id":"PRRC_kwDOPaLyBs6Z25_m","diff_hunk":"@@ -0,0 +1,190 @@\n+use crate::error::NodeInfoError;\n+use crate::model::*;\n+use sysinfo::System;\n+\n+/// Collects system information for the current node\n+pub struct SysInfoCollector {\n+    system: std::sync::Mutex<System>,\n+}\n+\n+impl SysInfoCollector {\n+    pub fn new() -> Self {\n+        let system = System::new_all();\n+        Self {\n+            system: std::sync::Mutex::new(system),\n+        }\n+    }\n+\n+    /// Collect current system information\n+    pub fn collect(&self, node_id: uuid::Uuid) -> Result<NodeSysInfo, NodeInfoError> {\n+        let mut sys = self\n+            .system\n+            .lock()\n+            .map_err(|e| NodeInfoError::SysInfoCollectionFailed(e.to_string()))?;\n+\n+        // Refresh system information\n+        sys.refresh_cpu_all();\n+        sys.refresh_memory();\n+\n+        let os_info = self.collect_os_info(&sys)?;\n+        let cpu_info = self.collect_cpu_info(&sys)?;\n+        let memory_info = self.collect_memory_info(&sys)?;\n+        let host_info = self.collect_host_info()?;\n+        let gpus = self.collect_gpu_info()?;\n+        let battery = self.collect_battery_info();\n+\n+        Ok(NodeSysInfo {\n+            node_id,\n+            os: os_info,\n+            cpu: cpu_info,\n+            memory: memory_info,\n+            host: host_info,\n+            gpus,\n+            battery,\n+            collected_at: chrono::Utc::now(),\n+        })\n+    }\n+\n+    fn collect_os_info(&self, _sys: &System) -> Result<OsInfo, NodeInfoError> {\n+        let name = System::name().unwrap_or_else(|| std::env::consts::OS.to_string());\n+        let version = System::os_version().unwrap_or_else(|| \"unknown\".to_string());\n+        let arch = std::env::consts::ARCH.to_string();\n+\n+        Ok(OsInfo {\n+            name,\n+            version,\n+            arch,\n+        })\n+    }\n+\n+    fn collect_cpu_info(&self, sys: &System) -> Result<CpuInfo, NodeInfoError> {\n+        let cpus = sys.cpus();\n+        let num_cpus = cpus.len() as u32;\n+\n+        let model = if let Some(cpu) = cpus.first() {\n+            cpu.brand().to_string()\n+        } else {\n+            \"Unknown\".to_string()\n+        };\n+\n+        // Get physical core count\n+        let cores = sys.physical_core_count().unwrap_or(num_cpus as usize) as u32;\n+\n+        // Get average frequency\n+        let frequency_mhz = if !cpus.is_empty() {\n+            cpus.iter().map(|cpu| cpu.frequency() as f64).sum::<f64>() / cpus.len() as f64\n+        } else {\n+            0.0\n+        };\n+\n+        Ok(CpuInfo {\n+            model,\n+            num_cpus,\n+            cores,\n+            frequency_mhz,\n+        })\n+    }\n+\n+    fn collect_memory_info(&self, sys: &System) -> Result<MemoryInfo, NodeInfoError> {\n+        let total_bytes = sys.total_memory();\n+        let available_bytes = sys.available_memory();\n+        let used_bytes = sys.used_memory();\n+        let used_percent = if total_bytes > 0 {\n+            ((used_bytes as f64 / total_bytes as f64) * 100.0) as u32\n+        } else {\n+            0\n+        };\n+\n+        Ok(MemoryInfo {\n+            total_bytes,\n+            available_bytes,\n+            used_bytes,\n+            used_percent,\n+        })\n+    }\n+\n+    fn collect_host_info(&self) -> Result<HostInfo, NodeInfoError> {\n+        let hostname = hostname::get()\n+            .map(|h| h.to_string_lossy().to_string())\n+            .unwrap_or_else(|_| \"unknown\".to_string());\n+\n+        let uptime_seconds = System::uptime();\n+\n+        // Collect all IP addresses\n+        let mut ip_addresses = Vec::new();\n+\n+        // First, add the primary IP (default route interface)\n+        if let Ok(primary_ip) = local_ip_address::local_ip() {\n+            ip_addresses.push(primary_ip.to_string());\n+        }\n+\n+        // Then add all other network interface IPs\n+        if let Ok(all_ips) = local_ip_address::list_afinet_netifas() {\n+            for (_name, ip) in all_ips {\n+                let ip_str = ip.to_string();\n+                // Skip if already added as primary\n+                if !ip_addresses.contains(&ip_str) {\n+                    // Skip loopback addresses\n+                    if !ip.is_loopback() {\n+                        ip_addresses.push(ip_str);\n+                    }\n+                }\n+            }\n+        }\n+\n+        Ok(HostInfo {\n+            hostname,\n+            uptime_seconds,\n+            ip_addresses,\n+        })\n+    }\n+\n+    fn collect_gpu_info(&self) -> Result<Vec<GpuInfo>, NodeInfoError> {\n+        // Use platform-specific GPU detection\n+        #[cfg(target_os = \"macos\")]\n+        {\n+            super::gpu_collector_macos::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"linux\")]\n+        {\n+            super::gpu_collector_linux::collect_gpu_info()\n+        }\n+        #[cfg(target_os = \"windows\")]\n+        {\n+            super::gpu_collector_windows::collect_gpu_info()\n+        }\n+        #[cfg(not(any(target_os = \"macos\", target_os = \"linux\", target_os = \"windows\")))]\n+        {\n+            Ok(Vec::new())","path":"libs/modkit-node-info/src/sysinfo_collector.rs","commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","original_commit_id":"cd016458e787a957b27bd6428b13c3a669112e98","user":{"login":"Bechma","id":19294519,"node_id":"MDQ6VXNlcjE5Mjk0NTE5","avatar_url":"https://avatars.githubusercontent.com/u/19294519?v=4","gravatar_id":"","url":"https://api.github.com/users/Bechma","html_url":"https://github.com/Bechma","followers_url":"https://api.github.com/users/Bechma/followers","following_url":"https://api.github.com/users/Bechma/following{/other_user}","gists_url":"https://api.github.com/users/Bechma/gists{/gist_id}","starred_url":"https://api.github.com/users/Bechma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bechma/subscriptions","organizations_url":"https://api.github.com/users/Bechma/orgs","repos_url":"https://api.github.com/users/Bechma/repos","events_url":"https://ap
re-rust/pull/12#discussion_r2377227344"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/12"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments/2377227344/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":125,"original_line":125,"side":"RIGHT","author_association":"MEMBER","original_position":78,"position":78,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":11,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/11","source_state":"closed","source_author":"modcrafter77","target_issue_number":null,"title":"[PR #11] feat: Add comprehensive OData $filter support","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"feature/secure-orm","pr_head_sha":"0692b41e889fdac32c9ea4d7ef1105e95ee17e66","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/11","id":2841893039,"node_id":"PR_kwDOPaLyBs6pY9iv","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/11","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/11.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/11.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/11","number":11,"state":"closed","locked":false,"title":"feat: Add comprehensive OData $filter support","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"feat: Add comprehensive OData $filter support with transport-agnostic architecture\r\n\r\n- Add new `odata-core` crate with parser-agnostic AST and type conversions\r\n  - Define core AST types (Expr, CompareOperator, Value) with proper traits\r\n  - Implement conversion from odata-params to core AST via feature flag\r\n  - Add ergonomic `ODataFilter` wrapper with From<Option<Expr>>\r\n\r\n- Implement OData → SeaORM compilation in `libs/db`\r\n  - Add type-safe field mapping with FieldKind and FieldMap<E>\r\n  - Compile OData AST to sea_orm::Condition with proper type coercion\r\n  - Support string functions (contains, startswith, endswith) via LIKE\r\n  - Handle null comparisons, IN operations, and complex expressions\r\n  - Add ODataExt trait for seamless Select<E> integration\r\n\r\n- Add first-class OData HTTP extractor in `modkit`\r\n  - Implement extract_odata_filter() with validation and complexity limits\r\n  - Add ergonomic OData extractor struct with FromRequestParts\r\n\r\n- Integrate OData filtering in users_info example\r\n  - Add OData filter support to REST API handlers using OData extractor\r\n  - Update service and repository layers to handle ODataFilter\r\n  - Implement proper error handling flow from DB to HTTP layer","created_at":"2025-09-18T23:17:16Z","updated_at":"2025-09-19T20:15:36Z","closed_at":"2025-09-19T20:15:36Z","merged_at":"2025-09-19T20:15:36Z","merge_commit_sha":"3f2f4ba13a55f
s_mirrored":0,"pr_head_ref":"refactor/odata_filter_strings","pr_head_sha":"e46a7d653a9cc65537bb2a9043910217c9486eba","pr_base_ref":"main","pr_head_owner":"modcrafter77","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27","id":3017238099,"node_id":"PR_kwDOPaLyBs6z12ZT","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/27","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/27.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/27.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/27","number":27,"state":"closed","locked":false,"title":"refactor(odata+secure-orm):","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Refactor OData pipeline to type-safe FilterNode<F> architecture, remove legacy FieldMap, and integrate dynamic DB engine tracing\r\n\r\n- Introduced unified FilterKind and new type-safe OData filter system:\r\n  - Added FilterField trait, FilterOp, FilterNode<F>, ODataValue, and error model\r\n  - Implemented full AST converter (modkit_odata AST → FilterNode<F>)\r\n  - Added generic filter-to-Condition mapping (sea_orm_filter)\r\n  - Replaced legacy FieldMap with enum-based field mapping\r\n\r\n- Added ODataFilterable derive macro:\r\n  - Generates *DtoFilterField enums with name() and kind() metadata\r\n  - Validates #[odata(filter(kind = \"...\"))] attributes\r\n  - Removed all string-based filter mappings from module code\r\n\r\n- Updated pagination:\r\n  - Added paginate_odata with type-safe filtering, ordering and cursor logic\r\n  - Removed unnecessary E::Column: Copy bound\r\n  - Unified cursor encoding/decoding across field kinds\r\n\r\n- Refactored users_info example:\r\n  - Added UserODataMapper with FieldToColumn and ODataFieldMapping\r\n  - Replaced deprecated USER_FMAP usage\r\n  - Updated SeaORM repository to use type-safe filtering and pagination\r\n\r\n- Introduced dynamic DB engine tracing:\r\n  - Added SecureConn::db_engine() helper\r\n  - Replaced all hardcoded db.system=\"sqlite\" with %self.sec.db_engine()\r\n\r\n- Added new integration and macro tests for filter derivation, parsing, type validation, and Condition generation","created_at":"2025-11-17T12:06:35Z","updated_at":"2025-11-18T14:32:07Z","closed_at":"2025-11-18T14:32:07Z","merged_at":"2025-11-18T14:32:07Z","merge_commit_sha":"2a5b2d93b89ebecb4749c48ed9aa0aad06d0541b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/27/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/27/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/e46a7d653a9cc65537bb2a9043910217c9486eba","head":{"label":"modcrafter77:refactor/odata_filter_strings","ref":"refactor/odata_filter_strings","sha":"e46a7d653a9cc65537bb2a9043910217c9486eba","user":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_url":"https://api.github.com/users/modcrafter77/events{/privacy}","received_events_url":"https://api.github.com/users/modcrafter77/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1048641237,"node_id":"R_kgDOPoD-1Q","name":"hyperspot","full_name":"modcrafter77/hyperspot","private":false,"owner":{"login":"modcrafter77","id":216291417,"node_id":"U_kgDODORYWQ","avatar_url":"https://avatars.githubusercontent.com/u/216291417?v=4","gravatar_id":"","url":"https://api.github.com/users/modcrafter77","html_url":"https://github.com/modcrafter77","followers_url":"https://api.github.com/users/modcrafter77/followers","following_url":"https://api.github.com/users/modcrafter77/following{/other_user}","gists_url":"https://api.github.com/users/modcrafter77/gists{/gist_id}","starred_url":"https://api.github.com/users/modcrafter77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modcrafter77/subscriptions","organizations_url":"https://api.github.com/users/modcrafter77/orgs","repos_url":"https://api.github.com/users/modcrafter77/repos","events_
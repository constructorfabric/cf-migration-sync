view_comments":[],"source_reviews":[]},{"source_pr_number":35,"source_url":"https://github.com/cyberfabric/cyberware-rust/pull/35","source_state":"closed","source_author":"Artifizer","target_issue_number":null,"title":"[PR #35] feat: Multi-node registry with intelligent caching and custom capabilities","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"9f1449d8875c0463182713735c6032131e9929a5","pr_base_ref":"main","pr_head_owner":"Artifizer","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35","id":3062456488,"node_id":"PR_kwDOPaLyBs62iWCo","html_url":"https://github.com/cyberfabric/cyberware-rust/pull/35","diff_url":"https://github.com/cyberfabric/cyberware-rust/pull/35.diff","patch_url":"https://github.com/cyberfabric/cyberware-rust/pull/35.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/35","number":35,"state":"closed","locked":false,"title":"feat: Multi-node registry with intelligent caching and custom capabilities","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"    \r\n    Implementation of the nodes registry module to support multiple nodes with\r\n    intelligent caching, custom capabilities, and force refresh functionality.\r\n    \r\n    - **modkit-node-info**: Standalone system information collection library\r\n      - Hardware-based UUID detection with hybrid fallback\r\n      - Cross-platform GPU detection (macOS/Linux/Windows)\r\n      - System capabilities with cache metadata (per-capability TTL)\r\n      - IP address detection (primary + all network IPs)\r\n      - Cache-aware capabilities for intelligent refresh\r\n    \r\n    - **Multi-node support**: Store and manage multiple nodes in memory\r\n    - **Intelligent caching**: Per-capability TTL with automatic refresh\r\n    - **Custom capabilities**: Modules can report software capabilities (e.g., LM Studio)\r\n    - **Cache invalidation**: Force refresh endpoints for fresh data\r\n    - **System + Custom merging**: Automatic merging with custom overriding system\r\n    - **Thread-safe storage**: Concurrent access with RwLock protection\r\n    \r\n    - GET /nodes - Get a list of all nodes in the deployment\r\n      - Implemented `details` query parameter to include sysinfo/syscap in node responses\r\n      - Added `force_refresh` parameter to invalidate cache and refresh all capabilities\r\n    - GET /nodes/{ID}/ - Get detailed information about a specific node\r\n    - GET /nodes/{id}/syscap - Get system capabilities (hardware, software features) for a specific node\r\n    - GET /nodes/{id}/sysinfo - Get detailed system information (OS, CPU, memory, etc.) for a specific node\r\n    \r\n    - Architecture: 1 hour (static)\r\n    - RAM: 5 seconds (dynamic)\r\n    - CPU: 10 minutes (rarely changes)\r\n    - OS: 2 minutes (rarely changes)\r\n    - GPU: 10 seconds (can change)\r\n    - Battery: 3 seconds (very dynamic)\r\n    - Custom: 60 seconds (module-defined)","created_at":"2025-12-02T07:58:19Z","updated_at":"2025-12-03T19:08:16Z","closed_at":"2025-12-03T19:08:16Z","merged_at":"2025-12-03T19:08:16Z","merge_commit_sha":"17257fa273806a150f51f13560693d5363681698","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/35/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/issues/35/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-rust/statuses/9f1449d8875c0463182713735c6032131e9929a5","head":{"label":"Artifizer:main","ref":"main","sha":"9f1449d8875c0463182713735c6032131e9929a5","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1051869828,"node_id":"R_kgDOPrJChA","name":"cyberfabric-core-detached","full_name":"Artifizer/cyberfabric-core-detached","private":false,"owner":{"login":"Artifizer","id":192502778,"node
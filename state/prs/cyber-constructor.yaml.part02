ntains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n    def test_workspace_active_in_human_output(self):\n        \"\"\"Human formatter renders active workspace info.\"\"\"\n        from cypilot.commands.adapter_info import _human_info\n        from cypilot.utils.ui import is_json_mode, set_json_mode\n        prev_json_mode = is_json_mode()\n        set_json_mode(False)\n        try:\n            data = {\n                \"project_root\": \"/tmp/test\",\n                \"workspace\": {\n                    \"active\": True,\n                    \"location\": \"inline (core.toml)\",\n                    \"sources_count\": 2,\n                },\n            }\n            buf = io.StringIO()\n            with redirect_stderr(buf):\n                _human_info(data)\n            output = buf.getvalue()\n            self.assertIn(\"Workspace\", output)\n            self.assertIn(\"inline (core.toml)\", output)\n            self.assertIn(\"2\", output)\n        finally:\n            set_json_mode(prev_json_mode)\n\n    def test_workspace_error_in_human_output(self):\n        \"\"\"Human formatter renders workspace error as warning.\"\"\"\n        from cypilot.commands.adapter_info import _human_info\n        from cypilot.utils.ui import is_json_mode, set_json_mode\n        prev_json_mode = is_json_mode()\n        set_json_mode(False)\n        try:\n            data = {\n                \"project_root\": \"/tmp/test\",\n                \"workspace\": {\n                    \"active\": False,\n                    \"error\": \"config parse failed\",\n                },\n            }\n            buf = io.StringIO()\n            with redirect_stderr(buf):\n                _human_info(data)\n            output = buf.getvalue()\n            self.assertIn(\"config parse failed\", output)\n        finally:\n            set_json_mode(prev_json_mode)\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Ruff (0.15.5)</summary>\n\n[error] 622-622: Probable insecure usage of temporary file or directory: \"/tmp/test\"\n\n(S108)\n\n---\n\n[error] 646-646: Probable insecure usage of temporary file or directory: \"/tmp/test\"\n\n(S108)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@tests/test_adapter_info.py` around lines 615 - 658, The tests\ntest_workspace_active_in_human_output and test_workspace_error_in_human_output\ntoggle the global JSON mode with set_json_mode(False) but restore it by\nhard-coding set_json_mode(True), which can leak state; change both tests to\ncapture the current mode before setting human mode (e.g., prev =\nset_json_mode(...) or call a getter if available), set_json_mode(False) for the\ntest, and in the finally block restore the original value via\nset_json_mode(prev) so the global JSON mode is returned to whatever it was\nbefore the test; keep references to _human_info and redirect_stderr unchanged.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @nonameffh\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-12T20:31:58Z","updated_at":"2026-03-14T17:15:55Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214231","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214231"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214231"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":615,"start_side":"RIGHT","line":null,"original_line":658,"side":"RIGHT","author_association":"NONE","original_position":104,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214236","pull_request_review_id":3939564910,"id":2927214236,"node_id":"PRRC_kwDOQ7VXwc6ueb6c","diff_hunk":"@@ -0,0 +1,221 @@\n+---\n+cypilot: true\n+type: workflow\n+name: cypilot-workspace\n+description: Multi-repo workspace setup — discover repos, configure sources, generate workspace config, validate\n+version: 1.0\n+purpose: Guide workspace federation setup for cross-repo traceability\n+---\n+\n+# Cypilot Workspace Workflow\n+\n+ALWAYS open and follow `{cypilot_path}/.core/skills/cypilot/SKILL.md` FIRST WHEN {cypilot_mode} is `off`","path":"workflows/workspace.md","commit_id":"63b1e3edbd685cedf29e15256c45fe0d61839b87","original_commit_id":"63b1e3edbd685cedf29e15256c45fe0d61839b87","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Route agents through `config/AGENTS.md` / `.gen/AGENTS.md` first.**\n\nThis entry instruction points agents straight at `.core/.../SKILL.md`, which bypasses the generated and project-level routing files that Cypilot expects them to follow first.\n\n<details>\n<summary>📝 Suggested wording</summary>\n\n```diff\n-ALWAYS open and follow `{cypilot_path}/.core/skills/cypilot/SKILL.md` FIRST WHEN {cypilot_mode} is `off`\n+ALWAYS open and follow `{cypilot_path}/config/AGENTS.md` FIRST.\n+When working with Cypilot AI agents, ALWAYS open and follow `{cypilot_path}/.gen/AGENTS.md` FIRST.\n```\n</details>\n\n\nBased on learnings, ALWAYS open and follow `{cypilot_path}/config/AGENTS.md` FIRST when starting any Cypilot work, and ALWAYS open and follow `{cypilot_path}/.gen/AGENTS.md` FIRST when working with Cypilot AI agents.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@workflows/workspace.md` at line 12, Update the instruction that currently\ndirects agents to open `{cypilot_path}/.core/skills/cypilot/SKILL.md` first when\n`{cypilot_mode}` is `off`; instead, make it explicitly require opening\n`config/AGENTS.md` first for any Cypilot work and `.gen/AGENTS.md` first when\nworking with Cypilot AI agents before falling back to\n`{cypilot_path}/.core/skills/cypilot/SKILL.md`, so replace or rewrite the line\nreferencing `{cypilot_path}/.core/skills/cypilot/SKILL.md` to reference\n`config/AGENTS.md` and `.gen/AGENTS.md` as described.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits ea38fb8 to 890e99b","created_at":"2026-03-12T20:31:58Z","updated_at":"2026-03-14T10:46:35Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214236","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214236"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214236"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214236/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":12,"side":"RIGHT","author_association":"NONE","original_position":12,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214240","pull_request_review_id":3939564910,"id":2927214240,"node_id":"PRRC_kwDOQ7VXwc6ueb6g","diff_hunk":"@@ -0,0 +1,221 @@\n+---\n+cypilot: true\n+type: workflow\n+name: cypilot-workspace\n+description: Multi-repo workspace setup — discover repos, configure sources, generate workspace config, validate\n+version: 1.0\n+purpose: Guide workspace federation setup for cross-repo traceability\n+---\n+\n+# Cypilot Workspace Workflow\n+\n+ALWAYS open and follow `{cypilot_path}/.core/skills/cypilot/SKILL.md` FIRST WHEN {cypilot_mode} is `off`\n+\n+**Type**: Operation\n+**Role**: Any\n+**Output**: `.cypilot-workspace.toml` or inline `[workspace]` in `config/core.toml`\n+\n+---\n+\n+## Overview\n+\n+This workflow guides multi-repo workspace setup — discovering repos in nested sub-directories, configuring source roles, generating workspace config, and validating cross-repo traceability.\n+\n+### Routing\n+\n+This workflow is invoked through the main Cypilot workflows or directly via workspace commands:\n+\n+| User Intent | Route | Example |\n+|-------------|-------|---------|\n+| Create/configure workspace | **generate.md** → workspace.md | \"setup multi-repo workspace\", \"add source repo\" |\n+| Check workspace status | **analyze.md** (workspace target) | \"check workspace\", \"show workspace sources\" |\n+\n+**Direct invocation** via workspace quick commands skips Protocol Guard.\n+\n+---\n+\n+## Table of Contents\n+\n+1. [Phase 1: Discover](#phase-1-discover)\n+2. [Phase 2: Configure](#phase-2-configure)\n+3. [Phase 3: Generate](#phase-3-generate)\n+4. [Phase 4: Validate](#phase-4-validate)\n+\n+---\n+\n+## Prerequisite Checklist\n+\n+- [ ] Agent has read SKILL.md\n+- [ ] Agent understands multi-repo workspace concepts\n+- [ ] Agent knows workspace can be standalone `.cypilot-workspace.toml` or inline in `config/core.toml`\n+\n+---\n+\n+## Phase 1: Discover\n+\n+**Goal**: Scan the filesystem neighborhood for repos that could be workspace sources.\n+\n+### Steps\n+\n+1. **Identify current project root**\n+   ```bash\n+   python3 {cypilot_path}/.core/skills/cypilot/scripts/cypilot.py --json info\n+   ```\n+\n+2. **Scan nested sub-directories** for repos with `.git` or `AGENTS.md` with `@cpt:root-agents` marker\n+   ```bash\n+   python3 {cypilot_path}/.core/skills/cypilot/scripts/cypilot.py --json workspace-init --dry-run\n+   ```\n+\n+3. **Present discovered repos** to user with:\n+   - Repo name and path\n+   - Whether cypilot directory was found\n+   - Inferred role (artifacts / codebase / kits / full)\n+\n+### Decision Point\n+\n+- [ ] User confirms which repos to include as workspace sources\n+- [ ] User specifies preferred workspace location (super-root standalone file vs inline in current repo)\n+\n+---\n+\n+## Phase 2: Configure\n+\n+**Goal**: Define source roles and workspace structure based on user preferences.\n+\n+### Steps\n+\n+1. **For each selected source**, confirm:\n+   - **Name**: Human-readable key for the source (e.g., \"docs-repo\", \"shared-kits\")\n+   - **Path**: Relative filesystem path from workspace file location\n+   - **Role**: What the source contributes (`artifacts`, `codebase`, `kits`, or `full`)\n+   - **Adapter**: Path to cypilot directory within the source (auto-discovered via AGENTS.md), or `null` if none\n+\n+2. **Confirm traceability settings**:\n+   - Cross-repo traceability enabled? (`cross_repo`, default: yes) — enables workspace-aware path resolution\n+   - Resolve remote IDs? (`resolve_remote_ids`, default: yes) — expands remote source artifact IDs into the union set for cross-reference validation. Both must be true for remote IDs to be included.\n+\n+3. **Confirm workspace location**:\n+   - Option A: Standalone `.cypilot-workspace.toml` at the parent directory containing the repos\n+   - Option B: Inline `[workspace]` section in current repo's `config/core.toml`","path":"workflows/workspace.md","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"63b1e3edbd685cedf29e15256c45fe0d61839b87","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Clarify that only project-root standalone workspaces are auto-discovered.**\n\nOption A currently reads like any parent/super-root `.cypilot-workspace.toml` will be picked up automatically. Discovery only falls back to a standalone file at the current `project_root`; a file outside that root needs an explicit `workspace = \"<path>\"` entry in `config/core.toml`.\n\n<details>\n<summary>📝 Suggested wording</summary>\n\n```diff\n-   - Option A: Standalone `.cypilot-workspace.toml` at the parent directory containing the repos\n+   - Option A: Standalone `.cypilot-workspace.toml` at the current project root, or at another path referenced explicitly from `config/core.toml`\n```\n</details>\n\n\nBased on learnings, `find_workspace_config()` falls back only to `.cypilot-workspace.toml` at `project_root`; there is NO parent directory traversal beyond `project_root`.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@workflows/workspace.md` around lines 98 - 100, Update the workflow docs to\nclarify discovery behavior: state that find_workspace_config() only\nauto-discovers a standalone .cypilot-workspace.toml located at the current\nproject_root (no parent-directory traversal), and that any workspace file\noutside project_root must be referenced explicitly via workspace = \"<path>\" in\nconfig/core.toml; mention the two options as \"Option A: standalone\n.cypilot-workspace.toml at project_root (auto-discovered)\" and \"Option B: inline\n[workspace] in config/core.toml (or external path via workspace = \\\"<path>\\\")\"\nto remove ambiguity.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @nonameffh\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-12T20:31:58Z","updated_at":"2026-03-14T17:18:19Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214240","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214240"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2927214240"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2927214240/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":99,"original_start_line":98,"start_side":"RIGHT","line":101,"original_line":100,"side":"RIGHT","author_association":"NONE","original_position":100,"position":101,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108866","pull_request_review_id":3948636542,"id":2935108866,"node_id":"PRRC_kwDOQ7VXwc6u8jUC","diff_hunk":"@@ -709,6 +720,229 @@ Check PR status: comment severity classification, CI status, merge conflict stat\n \n ---\n \n+## Workspace Commands\n+\n+Multi-repo workspace federation commands manage cross-repo artifact traceability without merging adapters.\n+\n+### workspace-init\n+\n+Initialize a multi-repo workspace by scanning nested sub-directories for repos with Cypilot adapters.\n+\n+```\n+cpt workspace-init [--root DIR] [--output PATH] [--inline] [--force] [--max-depth N] [--dry-run]\n+```","path":".bootstrap/.core/architecture/specs/cli.md","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"0cedd3e652071742f6515aae6d74dbba9b7307f2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Add language identifiers to fenced command blocks.**\n\nLines 731, 777, 825, and 906 use unlabeled fenced code blocks, which triggers markdownlint MD040 and will keep docs lint noisy.\n\n\n<details>\n<summary>💡 Suggested fix</summary>\n\n```diff\n-```\n+```bash\n cpt workspace-init [--root DIR] [--output PATH] [--inline] [--force] [--max-depth N] [--dry-run]\n ```\n@@\n-```\n+```bash\n cpt workspace-add --name NAME (--path PATH | --url URL) [--branch BRANCH] [--role ROLE] [--adapter PATH] [--inline] [--force]\n ```\n@@\n-```\n+```bash\n cpt workspace-info\n ```\n@@\n-```\n+```bash\n cpt workspace-sync [--source NAME] [--dry-run] [--force]\n ```\n```\n</details>\n\n\nAlso applies to: 777-779, 825-827, 906-908\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.21.0)</summary>\n\n[warning] 731-731: Fenced code blocks should have a language specified\n\n(MD040, fenced-code-language)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n````\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/architecture/specs/cli.md around lines 731 - 733, The\nfenced command blocks in .bootstrap/.core/architecture/specs/cli.md (for the\ncommand snippets \"cpt workspace-init [--root DIR] ...\", \"cpt workspace-add\n--name NAME ...\", \"cpt workspace-info\", and \"cpt workspace-sync [--source NAME]\n...\") are unlabeled and trigger markdownlint MD040; edit each of those\ntriple-backtick blocks to add a language identifier (use bash) immediately after\nthe opening backticks so they become ```bash ... ``` for each of the four\ncommand snippets to satisfy the linter.\n````\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:hawk -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @nonameffh\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-14T10:45:37Z","updated_at":"2026-03-14T17:17:47Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108866","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108866"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108866"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108866/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":731,"original_start_line":731,"start_side":"RIGHT","line":733,"original_line":733,"side":"RIGHT","author_association":"NONE","original_position":69,"position":69,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108868","pull_request_review_id":3948636542,"id":2935108868,"node_id":"PRRC_kwDOQ7VXwc6u8jUE","diff_hunk":"@@ -709,6 +720,229 @@ Check PR status: comment severity classification, CI status, merge conflict stat\n \n ---\n \n+## Workspace Commands\n+\n+Multi-repo workspace federation commands manage cross-repo artifact traceability without merging adapters.\n+\n+### workspace-init\n+\n+Initialize a multi-repo workspace by scanning nested sub-directories for repos with Cypilot adapters.\n+\n+```\n+cpt workspace-init [--root DIR] [--output PATH] [--inline] [--force] [--max-depth N] [--dry-run]\n+```\n+\n+| Option | Description |\n+|--------|-------------|\n+| `--root DIR` | Directory to scan for nested repo sub-dirs (default: current project root) |\n+| `--output PATH` | Where to write `.cypilot-workspace.toml` (default: scan root) |\n+| `--inline` | Write workspace config inline into current repo's `config/core.toml` instead of standalone file |\n+| `--force` | Force reinitialization when a workspace config already exists |\n+| `--max-depth N` | Maximum directory depth for nested repo scanning (default: 3). Limits filesystem traversal to prevent unbounded scanning. |\n+| `--dry-run` | Print what would be generated without writing files |\n+\n+**Behavior**:\n+1. Find project root (`.git` or `AGENTS.md` with `@cpt:root-agents` marker).\n+2. Scan nested sub-directories (up to `--max-depth` levels, default 3) for project directories with Cypilot adapters. Symlinks are not followed during scanning to prevent loops and traversal issues.\n+3. For each discovered repo: resolve adapter path, compute relative source path, infer role based on directory heuristics:\n+   - Detect capabilities: source directories (`src/`, `lib/`, `app/`, `pkg/`), documentation directories (`docs/`, `architecture/`, `requirements/`), kits directory (`kits/`)\n+   - If multiple capabilities present → `full`\n+   - If only kits → `kits`; only docs → `artifacts`; only source → `codebase`\n+   - If no recognized directories → `full` (default)\n+4. Build workspace config with version and discovered sources.\n+5. Check for existing workspace — reject cross-type conflicts (inline vs standalone) and require `--force` to reinitialize.\n+6. Write config: standalone `.cypilot-workspace.toml` or inline `[workspace]` section in `config/core.toml`.\n+\n+**Constraints**: `--inline` and `--output` are mutually exclusive. `--inline` always writes to `config/core.toml`.\n+\n+**Output** (JSON):\n+```json\n+{\n+  \"status\": \"CREATED\",\n+  \"message\": \"Workspace config created at .cypilot-workspace.toml\",\n+  \"config_path\": \".cypilot-workspace.toml\",\n+  \"sources_count\": 3,\n+  \"sources\": [\"repo-a\", \"repo-b\", \"repo-c\"]\n+}\n+```\n+\n+**Exit**: 0 on success, 1 on error.\n+\n+---\n+\n+### workspace-add\n+\n+Add a source to workspace config.\n+\n+```\n+cpt workspace-add --name NAME (--path PATH | --url URL) [--branch BRANCH] [--role ROLE] [--adapter PATH] [--inline] [--force]\n+```\n+\n+| Option | Description |\n+|--------|-------------|\n+| `--name NAME` | Source name (human-readable key, required) |\n+| `--path PATH` | Path to the source repo (relative to workspace file or project root). Validated at add-time; returns error if directory not found. |\n+| `--url URL` | Git remote URL (HTTPS or SSH) for the source |","path":".bootstrap/.core/architecture/specs/cli.md","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"0cedd3e652071742f6515aae6d74dbba9b7307f2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify `workspace-add --path` behavior for unreachable directories.**\n\nLine 784 says missing local paths are rejected at add-time, but workspace flows elsewhere describe adding sources and reporting reachability at runtime. Pick one behavior and make this section consistent to avoid operator confusion.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/architecture/specs/cli.md around lines 784 - 785, The docs\ncurrently contradict on workspace-add behavior for local paths: update the\ndescription for the CLI flag `--path PATH` under `workspace-add` to be\nconsistent with the chosen behavior (either \"validated at add-time and returns\nan error if directory not found\" or \"accepted at add-time and reachability\nreported at runtime\"); explicitly state which behavior applies, align the\nsentence for `--path PATH` with other workspace flow docs that describe\nreachability checks, and ensure the `--url URL` line remains unchanged;\nreference `workspace-add` and the flags `--path PATH`/`--url URL` when making\nthe single-line wording consistent.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:hawk -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits ea38fb8 to 890e99b","created_at":"2026-03-14T10:45:37Z","updated_at":"2026-03-14T10:46:40Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108868","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108868"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108868"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":784,"original_start_line":784,"start_side":"RIGHT","line":785,"original_line":785,"side":"RIGHT","author_association":"NONE","original_position":121,"position":121,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108869","pull_request_review_id":3948636542,"id":2935108869,"node_id":"PRRC_kwDOQ7VXwc6u8jUF","diff_hunk":"@@ -0,0 +1,436 @@\n+---\n+cypilot: true\n+type: requirement\n+name: Multi-Repo Workspace\n+version: 1.0\n+purpose: Define workspace federation for multi-repo traceability\n+---\n+\n+# Cypilot Workspace Specification\n+\n+<!-- toc -->\n+\n+- [Overview](#overview)\n+- [Design Principles](#design-principles)\n+- [Workspace Configuration](#workspace-configuration)\n+  - [Standalone File](#standalone-file)\n+  - [Inline in Config](#inline-in-config)\n+- [Source Entries](#source-entries)\n+  - [Roles](#roles)\n+- [Discovery Order](#discovery-order)\n+- [Path Resolution](#path-resolution)\n+- [Cross-Repo Traceability](#cross-repo-traceability)\n+  - [Traceability Settings](#traceability-settings)\n+  - [Artifact Path Resolution Contract](#artifact-path-resolution-contract)\n+  - [Scan Warning Logging](#scan-warning-logging)\n+- [Artifacts Registry v1.2](#artifacts-registry-v12)\n+- [CLI Commands](#cli-commands)\n+  - [Removing Sources](#removing-sources)\n+  - [Switching Workspace Type](#switching-workspace-type)\n+- [Backward Compatibility](#backward-compatibility)\n+- [Graceful Degradation](#graceful-degradation)\n+- [Git URL Sources](#git-url-sources)\n+- [Cross-Repo Editing](#cross-repo-editing)\n+- [Examples](#examples)\n+  - [Scenario: Working from code-repo referencing docs-repo](#scenario-working-from-code-repo-referencing-docs-repo)\n+  - [Scenario: Parent workspace with nested repos](#scenario-parent-workspace-with-nested-repos)\n+\n+<!-- /toc -->\n+\n+---\n+\n+## Overview\n+\n+Cypilot workspaces provide a **federation layer** for multi-repo projects. Each repo keeps its own independent adapter.\n+The workspace configuration maps named sources (repos) and their roles, enabling cross-repo artifact traceability\n+without merging adapters.\n+\n+**Project root**: the repository root directory that contains the Cypilot adapter directory (e.g., the directory containing `.bootstrap/` or `cypilot/`). All adapter-relative paths resolve from this directory.\n+\n+**Use cases:**\n+\n+- PM defines PRDs in a docs repo, design in another, code in yet another\n+- Shared kit packages live in a separate repo\n+- Mono-repo with submodules (existing pattern) AND multi-repo with nested sub-directories\n+- Working from a parent directory while referencing artifacts in nested repos\n+\n+---\n+\n+## Design Principles\n+\n+| Principle                                  | Description                                                                                                                                                                     |\n+|--------------------------------------------|---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n+| **cwd determines primary**                 | The primary source MUST always be determined by which repo contains the current working directory. No `primary` field.                                                          |\n+| **Federation with remote adapter context** | Each repo MUST own its adapter config. When editing files in a remote source that has its own Cypilot adapter, the remote source's adapter rules/templates MUST be applied — not the primary repo's adapter. Sources without an adapter fall back to the primary repo's adapter context. |\n+| **Opt-in**                                 | Absence of workspace config MUST produce exact current single-repo behavior. Zero changes for existing setups.                                                                  |\n+| **Local paths first**                      | Inline workspace config (`core.toml`) source paths MUST be local filesystem only. Standalone workspace configs support both local paths and Git URL sources.                    |\n+| **Git URL sources**                        | Standalone workspace config (`.cypilot-workspace.toml`) MUST support Git URL sources with working directory configuration, namespace resolution rules, and branch pinning.      |\n+| **Graceful degradation**                   | Missing source repos MUST emit warnings but MUST NOT block operations on available sources.                                                                                     |\n+\n+---\n+\n+## Workspace Configuration\n+\n+### Standalone File\n+\n+File: `.cypilot-workspace.toml`\n+\n+Can be placed at the **project root** (directory containing nested repo sub-directories) or anywhere reachable by the\n+discovery algorithm.\n+\n+```toml\n+version = \"1.0\"\n+\n+[sources.docs-repo]\n+path = \"../docs-repo\"\n+adapter = \"cypilot\"\n+role = \"artifacts\"\n+\n+[sources.code-repo]\n+path = \"../code-repo\"\n+adapter = \".bootstrap\"\n+role = \"codebase\"\n+\n+[sources.shared-kits]\n+path = \"../shared-kits\"\n+role = \"kits\"\n+\n+[traceability]\n+cross_repo = true\n+resolve_remote_ids = true\n+```\n+\n+### Inline in Config\n+\n+A repo can declare workspace participation from within its own `config/core.toml`.\n+\n+**Reference to external workspace file (in core.toml):**\n+\n+```toml\n+workspace = \"../.cypilot-workspace.toml\"\n+```\n+\n+**Inline workspace definition (in core.toml):**\n+\n+```toml\n+[workspace.sources.docs]\n+path = \"../docs-repo\"\n+\n+[workspace.sources.shared-kits]\n+path = \"../shared-kits\"\n+role = \"kits\"\n+```\n+\n+---\n+\n+## Source Entries\n+\n+Each source entry has the following fields. The `adapter` field refers to the source's **Cypilot directory** — the directory containing `.core/`, `.gen/`, and `config/` (e.g., `cypilot/`, `.bootstrap/`). When omitted, Cypilot auto-discovers it via the source's `AGENTS.md`.\n+\n+| Field    | Type   | Required                          | Default     | Description                                                                                                     |\n+|----------|--------|-----------------------------------|-------------|-----------------------------------------------------------------------------------------------------------------|\n+| `path`   | string | Yes (unless `url` is set)         | —           | Local filesystem path, resolved relative to workspace file location. Takes precedence over `url` when both set. |","path":".bootstrap/.core/requirements/workspace.md","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"0cedd3e652071742f6515aae6d74dbba9b7307f2","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Clarify `path` resolution for standalone vs inline workspace configs.**\n\nLine 132 currently implies a single resolution base, but inline workspace source paths resolve relative to project root (Lines 169-170). The table entry should reflect both modes.\n\n<details>\n<summary>✏️ Suggested diff</summary>\n\n```diff\n-| `path`   | string | Yes (unless `url` is set)         | —           | Local filesystem path, resolved relative to workspace file location. Takes precedence over `url` when both set. |\n+| `path`   | string | Yes (unless `url` is set)         | —           | Local filesystem path. In standalone workspace files it resolves relative to the workspace file; in inline `core.toml` workspace config it resolves relative to the project root. Takes precedence over `url` when both set. |\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/requirements/workspace.md at line 132, Update the table\nentry for the `path` field to clarify both resolution modes: state that when\n`path` is used in a standalone workspace file it is resolved relative to the\nworkspace file's location, but when used in an inline workspace configuration it\nis resolved relative to the project root; also keep the note that `path` takes\nprecedence over `url` when both are set. Reference the `path` table entry and\nthe inline workspace behavior described elsewhere to ensure consistency.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:hawk -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commits ea38fb8 to 890e99b","created_at":"2026-03-14T10:45:37Z","updated_at":"2026-03-14T10:46:38Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108869","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108869"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2935108869"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108869/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":133,"original_line":132,"side":"RIGHT","author_association":"NONE","original_position":132,"position":133,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2935108870","pull_request_review_id":3948636542,"id":2935108870,"node_id":"PRRC_kwDOQ7VXwc6u8jUG","diff_hunk":"@@ -12,6 +12,65 @@\n from ..utils.ui import ui\n # @cpt-end:cpt-cypilot-flow-traceability-validation-validate:p1:inst-validate-imports\n \n+# @cpt-begin:cpt-cypilot-algo-workspace-determine-target:p1:inst-validate-source-flag\n+def _resolve_source_context(source_name: str, ws_ctx: Optional[\"WorkspaceContext\"]) -> Optional[\"CypilotContext\"]:","path":".bootstrap/.core/skills/cypilot/scripts/cypilot/commands/validate.py","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id
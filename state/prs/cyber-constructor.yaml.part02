ching for pr-review.json anywhere in repo ===\"\nfind . -name \"*pr*review*\" -type f 2>/dev/null\n\necho -e \"\\n=== Checking .cypilot-adapter directory ===\"\nfind ./.cypilot-adapter -type f 2>/dev/null | head -20\n\necho -e \"\\n=== Checking for any json files in .cypilot-adapter ===\"\nfind ./.cypilot-adapter -name \"*.json\" -type f 2>/dev/null\n```\n\nRepository: cyberfabric/cyber-pilot\n\nLength of output: 1425\n\n---\n\n🏁 Script executed:\n\n```shell\n#!/bin/bash\n# Check pr.py main function and command parsing\n\necho \"=== Checking pr.py main() function ===\"\nsed -n '851,900p' ./skills/scripts/pr.py\n\necho -e \"\\n=== Full main function ===\"\nawk '/^def main\\(\\):/,/^def / {print NR\": \"$0}' ./skills/scripts/pr.py | head -60\n\necho -e \"\\n=== Checking if 'list' is exposed as a command ===\"\ngrep -n \"list\" ./skills/scripts/pr.py | grep -i \"command\\|argparse\\|if.*list\"\n\necho -e \"\\n=== Checking file size and line count of pr.py ===\"\nwc -l ./skills/scripts/pr.py\n```\n\nRepository: cyberfabric/cyber-pilot\n\nLength of output: 1742\n\n---\n\n\n\n</details>\n\n**Fix path reference and address missing configuration file.**\n\nThe infrastructure exists but the workflow has critical issues:\n\n1. **Incorrect path**: The workflow references `pr.py` at `.cypilot/skills/scripts/pr.py`, but the actual script is at `./skills/scripts/pr.py` (no `.cypilot/` prefix).\n\n2. **Missing configuration**: The `pr-review.json` file referenced at line 44 (`{cypilot_adapter_path}/pr-review.json`) does not exist in the repository. This will cause execution failures.\n\n3. **Commands verified**: The `pr.py` script does implement the required `list`, `status`, and `reorder` commands as documented.\n\nUpdate the workflow paths to match the actual script location, and either create the missing `pr-review.json` configuration file or remove the reference if it is not essential.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@workflows/pr-status.md` around lines 43 - 98, Update the workflow to point to\nthe real script location and resolve the missing config: replace occurrences of\n\".cypilot/skills/scripts/pr.py\" with \"./skills/scripts/pr.py\" so the documented\nScript entry and the listed Run commands (e.g., \"python3\n.cypilot/skills/scripts/pr.py list/status/reorder\") use the existing pr.py, and\neither add the referenced configuration file pr-review.json at the expected\n{cypilot_adapter_path} or remove the \"{cypilot_adapter_path}/pr-review.json\"\nConfig entry (and any template references) so the workflow no longer references\na non-existent pr-review.json; verify updates touch the workflow entries that\nname pr.py, the Config line referencing pr-review.json, and any templates block.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:puma -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-02-11T16:09:54Z","updated_at":"2026-02-11T18:08:01Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794147026","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794147026"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794147026"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794147026/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":43,"start_side":"RIGHT","line":null,"original_line":98,"side":"RIGHT","author_association":"NONE","original_position":98,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149090","pull_request_review_id":3785782870,"id":2794149090,"node_id":"PRRC_kwDOQ7VXwc6mi1Ti","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)\n+\n+\n+def _load_pr_config():\n+    \"\"\"Load PR review config from adapter's pr-review.json.\n+\n+    Resolution order:\n+    1. {project_root}/{cypilotAdapterPath}/pr-review.json\n+    2. {project_root}/.cypilot-adapter/pr-review.json (default)\n+    \"\"\"\n+    adapter_path = \".cypilot-adapter\"\n+    if os.path.exists(_CYPILOT_CONFIG_PATH):\n+        with open(_CYPILOT_CONFIG_PATH) as f:\n+            core = json.load(f)\n+        adapter_path = core.get(\n+            \"cypilotAdapterPath\", adapter_path,\n+        )\n+    pr_cfg_path = os.path.join(\n+        ROOT, adapter_path, \"pr-review.json\",\n+    )\n+    if not os.path.exists(pr_cfg_path):\n+        return {}\n+    with open(pr_cfg_path) as f:\n+        return json.load(f)\n+\n+\n+_PR_CFG = _load_pr_config()\n+\n+# PR data directory (default .prs/, overridable in pr-review.json)\n+PRS_DIR = os.path.join(\n+    ROOT, _PR_CFG.get(\"dataDir\", \".prs\"),\n+)\n+TEMPLATES_DIR = os.path.join(\n+    ROOT,\n+    _PR_CFG.get(\n+        \"templatesDir\", \".cypilot/templates/pr\",\n+    ),\n+)\n+# Local config path (exclude list, etc.)\n+CONFIG_PATH = os.path.join(ROOT, \".prs\", \"config.yaml\")\n+\n+\n+def _run(cmd, **kwargs):\n+    result = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kwargs)\n+    if result.returncode != 0 and kwargs.get(\"check\", False):\n+        print(result.stderr, file=sys.stderr)\n+        sys.exit(result.returncode)\n+    return result\n+\n+\n+def _load_exclude_list():\n+    \"\"\"Load exclude_prs list from .prs/config.yaml.\n+\n+    Parses lines under `exclude_prs:` that start with `- `.\n+    Returns a set of PR number strings.\n+    \"\"\"\n+    excludes = set()\n+    if not os.path.exists(CONFIG_PATH):\n+        return excludes\n+    in_section = False\n+    with open(CONFIG_PATH) as f:\n+        for line in f:\n+            stripped = line.strip()\n+            if stripped == \"exclude_prs:\":\n+                in_section = True\n+                continue\n+            if in_section:\n+                if stripped.startswith(\"- \"):\n+                    val = stripped[2:].strip().strip('\"').strip(\"'\")\n+                    if val:\n+                        excludes.add(val)\n+                elif stripped and not stripped.startswith(\"#\"):\n+                    in_section = False\n+    return excludes\n+\n+\n+def _list_open_prs():\n+    \"\"\"Return list of open PR numbers via gh CLI.\"\"\"\n+    result = _run([\n+        \"gh\", \"pr\", \"list\",\n+        \"--json\", \"number,title,author,state,url\",\n+        \"--limit\", \"100\",\n+    ])\n+    if result.returncode != 0:\n+        print(\n+            f\"Failed to list PRs: {result.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+    return json.loads(result.stdout)\n+\n+\n+def _owner_repo():\n+    \"\"\"Return (owner, repo) from gh CLI.\"\"\"\n+    r = _run([\n+        \"gh\", \"repo\", \"view\",\n+        \"--json\", \"nameWithOwner\",\n+        \"-q\", \".nameWithOwner\",\n+    ])\n+    if r.returncode != 0:\n+        return None, None\n+    parts = r.stdout.strip().split(\"/\", 1)\n+    return (parts[0], parts[1]) if len(parts) == 2 else (None, None)\n+\n+\n+_META_FIELDS = \",\".join([\n+    \"title\", \"body\", \"files\", \"comments\",\n+    \"reviews\", \"labels\", \"author\", \"state\",\n+    \"baseRefName\", \"headRefName\",\n+    \"url\", \"createdAt\", \"updatedAt\",\n+    \"reviewRequests\", \"statusCheckRollup\",\n+    \"mergeStateStatus\", \"reviewDecision\",\n+])\n+\n+_REVIEW_THREADS_QUERY = (\n+    \"query($owner:String!,$repo:String!,$n:Int!){\"\n+    \"repository(owner:$owner,name:$repo){\"\n+    \"pullRequest(number:$n){\"\n+    \"reviewThreads(first:100){nodes{\"\n+    \"id isResolved isOutdated path line startLine \"\n+    \"comments(first:50){nodes{\"\n+    \"id author{login}body createdAt url\"\n+    \"}}}}\"\n+    \"}}}\"\n+)\n+\n+\n+def fetch(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    os.makedirs(pr_dir, exist_ok=True)","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"e4e64c42967ff9f20d952d2def8a69f4d21e1e43","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n1\\. <b><i>pr_number</i></b> not validated <code>📘 Rule violation</code> <code>⛨ Security</code>\n\n<pre>\nUser-controlled <b><i>pr_number</i></b> is used to construct filesystem paths and passed into GitHub CLI\ncommands without validation, enabling path traversal (e.g., <b><i>../...</i></b>) and writing outside <b><i>.prs/</i></b>.\nThis violates security-first input handling expectations for external inputs (CLI args).\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\n`pr_number` comes from CLI arguments and is used directly in filesystem paths (`.prs/{pr_number}`) and GitHub CLI calls without validation. This permits path traversal (e.g., `../outside`) and unsafe file writes.\n\n## Issue Context\nThis script is a helper CLI, but it still processes external input (`sys.argv`) and writes files to disk. Compliance requires validation/sanitization of external inputs.\n\n## Fix Focus Areas\n- skills/scripts/pr.py[171-173]\n- skills/scripts/pr.py[851-937]\n- skills/scripts/pr.py[882-921]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T16:10:20Z","updated_at":"2026-02-11T16:10:21Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149090","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149090"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149090"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":215,"original_start_line":171,"start_side":"RIGHT","line":217,"original_line":173,"side":"RIGHT","author_association":"NONE","original_position":173,"position":217,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149093","pull_request_review_id":3785782870,"id":2794149093,"node_id":"PRRC_kwDOQ7VXwc6mi1Tl","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)\n+\n+\n+def _load_pr_config():\n+    \"\"\"Load PR review config from adapter's pr-review.json.\n+\n+    Resolution order:\n+    1. {project_root}/{cypilotAdapterPath}/pr-review.json\n+    2. {project_root}/.cypilot-adapter/pr-review.json (default)\n+    \"\"\"\n+    adapter_path = \".cypilot-adapter\"\n+    if os.path.exists(_CYPILOT_CONFIG_PATH):\n+        with open(_CYPILOT_CONFIG_PATH) as f:\n+            core = json.load(f)\n+        adapter_path = core.get(\n+            \"cypilotAdapterPath\", adapter_path,\n+        )\n+    pr_cfg_path = os.path.join(\n+        ROOT, adapter_path, \"pr-review.json\",\n+    )\n+    if not os.path.exists(pr_cfg_path):\n+        return {}\n+    with open(pr_cfg_path) as f:\n+        return json.load(f)\n+\n+\n+_PR_CFG = _load_pr_config()\n+\n+# PR data directory (default .prs/, overridable in pr-review.json)\n+PRS_DIR = os.path.join(\n+    ROOT, _PR_CFG.get(\"dataDir\", \".prs\"),\n+)\n+TEMPLATES_DIR = os.path.join(\n+    ROOT,\n+    _PR_CFG.get(\n+        \"templatesDir\", \".cypilot/templates/pr\",\n+    ),\n+)\n+# Local config path (exclude list, etc.)\n+CONFIG_PATH = os.path.join(ROOT, \".prs\", \"config.yaml\")\n+\n+\n+def _run(cmd, **kwargs):\n+    result = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kwargs)\n+    if result.returncode != 0 and kwargs.get(\"check\", False):\n+        print(result.stderr, file=sys.stderr)\n+        sys.exit(result.returncode)\n+    return result\n+\n+\n+def _load_exclude_list():\n+    \"\"\"Load exclude_prs list from .prs/config.yaml.\n+\n+    Parses lines under `exclude_prs:` that start with `- `.\n+    Returns a set of PR number strings.\n+    \"\"\"\n+    excludes = set()\n+    if not os.path.exists(CONFIG_PATH):\n+        return excludes\n+    in_section = False\n+    with open(CONFIG_PATH) as f:\n+        for line in f:\n+            stripped = line.strip()\n+            if stripped == \"exclude_prs:\":\n+                in_section = True\n+                continue\n+            if in_section:\n+                if stripped.startswith(\"- \"):\n+                    val = stripped[2:].strip().strip('\"').strip(\"'\")\n+                    if val:\n+                        excludes.add(val)\n+                elif stripped and not stripped.startswith(\"#\"):\n+                    in_section = False\n+    return excludes\n+\n+\n+def _list_open_prs():\n+    \"\"\"Return list of open PR numbers via gh CLI.\"\"\"\n+    result = _run([\n+        \"gh\", \"pr\", \"list\",\n+        \"--json\", \"number,title,author,state,url\",\n+        \"--limit\", \"100\",\n+    ])\n+    if result.returncode != 0:\n+        print(\n+            f\"Failed to list PRs: {result.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+    return json.loads(result.stdout)\n+\n+\n+def _owner_repo():\n+    \"\"\"Return (owner, repo) from gh CLI.\"\"\"\n+    r = _run([\n+        \"gh\", \"repo\", \"view\",\n+        \"--json\", \"nameWithOwner\",\n+        \"-q\", \".nameWithOwner\",\n+    ])\n+    if r.returncode != 0:\n+        return None, None\n+    parts = r.stdout.strip().split(\"/\", 1)\n+    return (parts[0], parts[1]) if len(parts) == 2 else (None, None)\n+\n+\n+_META_FIELDS = \",\".join([\n+    \"title\", \"body\", \"files\", \"comments\",\n+    \"reviews\", \"labels\", \"author\", \"state\",\n+    \"baseRefName\", \"headRefName\",\n+    \"url\", \"createdAt\", \"updatedAt\",\n+    \"reviewRequests\", \"statusCheckRollup\",\n+    \"mergeStateStatus\", \"reviewDecision\",\n+])\n+\n+_REVIEW_THREADS_QUERY = (\n+    \"query($owner:String!,$repo:String!,$n:Int!){\"\n+    \"repository(owner:$owner,name:$repo){\"\n+    \"pullRequest(number:$n){\"\n+    \"reviewThreads(first:100){nodes{\"\n+    \"id isResolved isOutdated path line startLine \"\n+    \"comments(first:50){nodes{\"\n+    \"id author{login}body createdAt url\"\n+    \"}}}}\"\n+    \"}}}\"\n+)\n+\n+\n+def fetch(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    os.makedirs(pr_dir, exist_ok=True)\n+\n+    # 1. PR metadata (expanded fields)\n+    meta = _run([\n+        \"gh\", \"pr\", \"view\", pr_number,\n+        \"--json\", _META_FIELDS,\n+    ])\n+    if meta.returncode != 0:\n+        print(\n+            f\"Failed to fetch PR #{pr_number}: \"\n+            f\"{meta.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+    with open(meta_path, \"w\") as f:\n+        json.dump(\n+            json.loads(meta.stdout), f,\n+            indent=2, ensure_ascii=False,\n+        )\n+        f.write(\"\\n\")\n+    print(\n+        f\"  Saved metadata → \"\n+        f\"{os.path.relpath(meta_path, ROOT)}\"\n+    )\n+\n+    # 2. Diff\n+    diff = _run([\"gh\", \"pr\", \"diff\", pr_number])\n+    if diff.returncode != 0:\n+        print(\n+            f\"Failed to fetch diff for PR \"\n+            f\"#{pr_number}: {diff.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    diff_path = os.path.join(pr_dir, \"diff.patch\")\n+    with open(diff_path, \"w\") as f:\n+        f.write(diff.stdout)\n+    print(\n+        f\"  Saved diff → \"\n+        f\"{os.path.relpath(diff_path, ROOT)}\"\n+    )\n+\n+    # 3. Review comments (REST — keeps diff_hunk etc.)\n+    comments = _run([\n+        \"gh\", \"api\",\n+        f\"repos/{{owner}}/{{repo}}/pulls/\"\n+        f\"{pr_number}/comments\",\n+        \"--paginate\",\n+    ])\n+    if comments.returncode == 0:\n+        rc_path = os.path.join(\n+            pr_dir, \"review_comments.json\"\n+        )\n+        with open(rc_path, \"w\") as f:\n+            json.dump(\n+                json.loads(comments.stdout), f,\n+                indent=2, ensure_ascii=False,\n+            )\n+            f.write(\"\\n\")\n+        print(\n+            f\"  Saved review comments → \"\n+            f\"{os.path.relpath(rc_path, ROOT)}\"\n+        )\n+\n+    # 4. Review threads via GraphQL (isResolved)\n+    owner, repo = _owner_repo()\n+    if owner and repo:\n+        threads = _run([\n+            \"gh\", \"api\", \"graphql\",\n+            \"-f\", f\"query={_REVIEW_THREADS_QUERY}\",\n+            \"-F\", f\"n={pr_number}\",\n+            \"-f\", f\"owner={owner}\",\n+            \"-f\", f\"repo={repo}\",\n+        ])\n+        if threads.returncode == 0:\n+            threads_path = os.path.join(\n+                pr_dir, \"review_threads.json\"\n+            )\n+            with open(threads_path, \"w\") as f:\n+                json.dump(\n+                    json.loads(threads.stdout), f,\n+                    indent=2, ensure_ascii=False,\n+                )\n+                f.write(\"\\n\")\n+            print(\n+                f\"  Saved review threads → \"\n+                f\"{os.path.relpath(threads_path, ROOT)}\"\n+            )\n+\n+    print(f\"  ✓ PR #{pr_number} fetched\")\n+\n+\n+BOTS = {\n+    \"coderabbitai\", \"coderabbitai[bot]\",\n+    \"qodo-code-review\", \"qodo-code-review[bot]\",\n+    \"github-actions\", \"github-actions[bot]\",\n+    \"github-advanced-security\", \"github-advanced-security[bot]\",\n+    \"dependabot\", \"dependabot[bot]\",\n+    \"renovate\", \"renovate[bot]\",\n+}\n+\n+\n+def _is_bot(login: str) -> bool:\n+    return login in BOTS or login.endswith(\"[bot]\")\n+\n+\n+def _quote(text: str) -> str:\n+    lines = (text or \"\").strip().splitlines()\n+    return \"\\n\".join(\"> \" + ln for ln in lines) if lines else \"> (empty)\"\n+\n+\n+_STATE_ICON = {\n+    \"OPEN\": \"🟢\", \"CLOSED\": \"🔴\", \"MERGED\": \"🟣\",\n+}\n+_REVIEW_ICON = {\n+    \"APPROVED\": \"✅\",\n+    \"CHANGES_REQUESTED\": \"❌\",\n+    \"COMMENTED\": \"💬\",\n+    \"DISMISSED\": \"👀\",\n+    \"PENDING\": \"⏳\",\n+}\n+_CI_ICON = {\n+    \"SUCCESS\": \"✅\", \"FAILURE\": \"❌\",\n+    \"PENDING\": \"⏳\", \"ERROR\": \"⚠️\",\n+}\n+\n+\n+def _load_diff_hunks(pr_dir):\n+    \"\"\"Build url → diff_hunk lookup from REST data.\"\"\"\n+    rc_path = os.path.join(\n+        pr_dir, \"review_comments.json\"\n+    )\n+    if not os.path.exists(rc_path):\n+        return {}\n+    with open(rc_path) as f:\n+        comments = json.loads(f.read())\n+    hunks = {}\n+    for c in comments:\n+        url = c.get(\"html_url\", \"\")\n+        hunk = c.get(\"diff_hunk\", \"\")\n+        if url and hunk:\n+            hunks[url] = hunk\n+    return hunks\n+\n+\n+def _has_quote_match(original_body, reply_body):\n+    \"\"\"Check if reply quotes text from the original.\"\"\"\n+    quoted = []\n+    for line in reply_body.splitlines():\n+        s = line.strip()\n+        if s.startswith(\">\"):\n+            txt = s.lstrip(\">\").strip()\n+            if txt and not txt.startswith(\"@\"):\n+                quoted.append(txt.lower())\n+    if not quoted:\n+        return False\n+    orig_lower = original_body.lower()\n+    return any(q in orig_lower for q in quoted)\n+\n+\n+def _detect_pr_replies(comments, pr_author):\n+    \"\"\"Return set of comment URLs that the author replied to.\"\"\"\n+    replied = set()\n+    human = [\n+        c for c in comments\n+        if not _is_bot(\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+    ]\n+    for i, c in enumerate(human):\n+        c_author = (\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if c_author == pr_author:\n+            continue\n+        c_body = c.get(\"body\") or \"\"\n+        c_url = c.get(\"url\", \"\")\n+        # Check subsequent author comments for quote\n+        for j in range(i + 1, len(human)):\n+            r = human[j]\n+            r_author = (\n+                r.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+            if r_author != pr_author:\n+                continue\n+            r_body = r.get(\"body\") or \"\"\n+            if _has_quote_match(c_body, r_body):\n+                replied.add(c_url)\n+                break\n+    return replied\n+\n+\n+def _format_conversation(comments, diff_hunk=\"\"):\n+    \"\"\"Format a thread as a chat with optional code.\"\"\"\n+    ln = []\n+    if diff_hunk:\n+        ln.append(\"```diff\")\n+        hunk_lines = diff_hunk.strip().splitlines()\n+        # Keep last 12 lines for context\n+        if len(hunk_lines) > 12:\n+            ln.append(\"  ...\")\n+            hunk_lines = hunk_lines[-12:]\n+        for hl in hunk_lines:\n+            ln.append(hl)\n+        ln.append(\"```\")\n+        ln.append(\"\")\n+    for c in comments:\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        date = c.get(\"createdAt\", \"\")[:10]\n+        body = (c.get(\"body\") or \"\").strip()\n+        ln.append(f\"> **@{author}** ({date}):\")\n+        ln.append(\">\")\n+        for bl in body.splitlines():\n+            ln.append(f\"> {bl}\")\n+        ln.append(\"\")\n+    return ln\n+\n+\n+def _load_review_threads(pr_dir):\n+    \"\"\"Load review threads from GraphQL data.\"\"\"\n+    path = os.path.join(pr_dir, \"review_threads.json\")\n+    if not os.path.exists(path):\n+        return []\n+    with open(path) as f:\n+        data = json.load(f)\n+    try:\n+        return (\n+            data[\"data\"][\"repository\"]\n+            [\"pullRequest\"][\"reviewThreads\"][\"nodes\"]\n+        )\n+    except (KeyError, TypeError):\n+        return []\n+\n+\n+def _reviewer_table(meta):\n+    \"\"\"Build deduplicated reviewer list with latest state.\"\"\"\n+    pr_author = meta[\"author\"][\"login\"]\n+    reviewers = {}\n+    # Submitted reviews (last state wins)\n+    for r in meta.get(\"reviews\", []):\n+        login = r.get(\"author\", {}).get(\"login\", \"?\")\n+        if login == pr_author:\n+            continue\n+        state = r.get(\"state\", \"COMMENTED\")\n+        reviewers[login] = state\n+    # Pending review requests (only if no review yet)\n+    for rr in meta.get(\"reviewRequests\", []):\n+        login = rr.get(\"login\", \"\")\n+        if not login:\n+            # Team review request\n+            login = rr.get(\"name\", \"?\")\n+        if login and login not in reviewers:\n+            reviewers[login] = \"PENDING\"\n+    return reviewers\n+\n+\n+def _ci_summary(meta):\n+    \"\"\"Summarise CI status from statusCheckRollup.\"\"\"\n+    checks = meta.get(\"statusCheckRollup\", [])\n+    if not checks:\n+        return \"—\"\n+    states = {}\n+    for c in checks:\n+        # gh CLI normalises to __typename/state/status\n+        s = (\n+            c.get(\"conclusion\")\n+            or c.get(\"state\")\n+            or c.get(\"status\")\n+            or \"PENDING\"\n+        ).upper()\n+        states[s] = states.get(s, 0) + 1\n+    parts = []\n+    for s in [\"SUCCESS\", \"FAILURE\", \"ERROR\", \"PENDING\",\n+              \"NEUTRAL\", \"SKIPPED\"]:\n+        if s in states:\n+            icon = _CI_ICON.get(s, \"\")\n+            parts.append(f\"{icon} {s}: {states[s]}\")\n+    return \", \".join(parts) if parts else \"—\"\n+\n+\n+def status(pr_number: str):\n+    # Always fetch the latest PR data before report\n+    fetch(pr_number)\n+\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+\n+    with open(meta_path) as f:\n+        meta = json.load(f)\n+\n+    pr_author = meta[\"author\"][\"login\"]\n+    pr_title = meta.get(\"title\", \"\")\n+    pr_url = meta.get(\"url\", \"\")\n+    pr_state = meta.get(\"state\", \"?\")\n+    pr_created = meta.get(\"createdAt\", \"\")[:10]\n+    pr_updated = meta.get(\"updatedAt\", \"\")[:10]\n+    merge_state = meta.get(\"mergeStateStatus\", \"—\")\n+    review_decision = meta.get(\"reviewDecision\", \"—\")\n+    state_icon = _STATE_ICON.get(pr_state, \"\")\n+    ci_text = _ci_summary(meta)\n+\n+    # --- Load data ---\n+    all_threads = _load_review_threads(pr_dir)\n+    diff_hunks = _load_diff_hunks(pr_dir)\n+    resolved_threads = [\n+        t for t in all_threads if t.get(\"isResolved\")\n+    ]\n+    unresolved_threads = [\n+        t for t in all_threads\n+        if not t.get(\"isResolved\")\n+    ]\n+\n+    # --- Unresolved → unreplied code threads ---\n+    code_threads = []\n+    for t in unresolved_threads:\n+        comments = (\n+            t.get(\"comments\", {}).get(\"nodes\", [])\n+        )\n+        if not comments:\n+            continue\n+        humans = [\n+            c for c in comments\n+            if not _is_bot(\n+                c.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+        ]\n+        if not humans:\n+            continue\n+        last = comments[-1]\n+        last_author = (\n+            last.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if last_author == pr_author:\n+            continue\n+        first = comments[0]\n+        participants = list(dict.fromkeys(\n+            c.get(\"author\", {}).get(\"login\", \"?\")\n+            for c in comments\n+        ))\n+        code_threads.append({\n+            \"path\": t.get(\"path\", \"?\"),\n+            \"line\": (\n+                t.get(\"line\")\n+                or t.get(\"startLine\")\n+                or \"?\"\n+            ),\n+            \"url\": first.get(\"url\", \"\"),\n+            \"last_author\": last_author,\n+            \"participants\": participants,\n+            \"comments\": comments,\n+        })\n+\n+    # --- PR-level comments: split unreplied vs replied ---\n+    replied_urls = _detect_pr_replies(\n+        meta.get(\"comments\", []), pr_author\n+    )\n+    pr_unreplied = []\n+    pr_replied = []\n+    for c in meta.get(\"comments\", []):\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        if _is_bot(author) or author == pr_author:\n+            continue\n+        entry = {\n+            \"url\": c.get(\"url\", \"\"),\n+            \"author\": author,\n+            \"date\": c.get(\"createdAt\", \"\")[:10],\n+            \"body\": c.get(\"body\", \"\"),\n+        }\n+        if entry[\"url\"] in replied_urls:\n+            pr_replied.append(entry)\n+        else:\n+            pr_unreplied.append(entry)\n+\n+    # --- Reviewers ---\n+    reviewers = _reviewer_table(meta)\n+\n+    # --- Counts for summary table ---\n+    n_code_unresolved = len(code_threads)\n+    n_code_resolved = len(resolved_threads)\n+    n_pr_unreplied = len(pr_unreplied)\n+    n_pr_replied = len(pr_replied)\n+\n+    # ===== Build report =====\n+    ln = []\n+\n+    # ── Header ──\n+    ln.append(f\"# PR #{pr_number}: {pr_title}\")\n+    ln.append(\"\")\n+    ln.append(\"| Field | Value |\")\n+    ln.append(\"|---|---|\")\n+    ln.append(f\"| **URL** | {pr_url} |\")\n+    ln.append(f\"| **Author** | @{pr_author} |\")\n+    ln.append(\n+        f\"| **State** | {state_icon} {pr_state} |\"\n+    )\n+    ln.append(f\"| **Created** | {pr_created} |\")\n+    ln.append(f\"| **Updated** | {pr_updated} |\")\n+    ln.append(f\"| **CI Status** | {ci_text} |\")\n+    ln.append(\n+        f\"| **Merge Status** | {merge_state} |\"\n+    )\n+    ln.append(\n+        f\"| **Review Decision** | {review_decision} |\"\n+    )\n+    ln.append(\n+        f\"| **Code comments** \"\n+        f\"| {n_code_unresolved} unresolved / \"\n+        f\"{n_code_resolved} resolved / \"\n+        f\"0 suspicious |\"\n+    )\n+    ln.append(\n+        f\"| **PR comments** \"\n+        f\"| {n_pr_unreplied} unreplied / \"\n+        f\"{n_pr_replied} replied / \"\n+        f\"0 suspicious |\"\n+    )\n+    ln.append(\"\")\n+\n+    # ── PR Description ──\n+    body = (meta.get(\"body\") or \"\").strip()\n+    if body:\n+        ln.append(\"## PR Description\")\n+        ln.append(\"\")\n+        preview = body[:2000]\n+        if len(body) > 2000:\n+            preview += \"\\n\\n_(truncated)_\"\n+        ln.append(_quote(preview))\n+        ln.append(\"\")\n+\n+    # ── Reviewers ──\n+    ln.append(\"## Reviewers\")\n+    ln.append(\"\")\n+    if reviewers:\n+        ln.append(\"| Reviewer | Status |\")\n+        ln.append(\"|---|---|\")\n+        for login, st in sorted(reviewers.items()):\n+            icon = _REVIEW_ICON.get(st, \"\")\n+            ln.append(\n+                f\"| @{login} | {icon} {st} |\"\n+            )\n+    else:\n+        ln.append(\"No reviewers assigned.\")\n+    ln.append(\"\")\n+\n+    # ── Action Items ──\n+    ln.append(\"## Action Items\")\n+    ln.append(\"\")\n+    action_idx = 0\n+    for login, st in sorted(reviewers.items()):\n+        if st == \"CHANGES_REQUESTED\":\n+            action_idx += 1\n+            ln.append(\n+                f\"{action_idx}. ❌ **@{login}** \"\n+                f\"requested changes — \"\n+                f\"needs re-review\"\n+            )\n+    for login, st in sorted(reviewers.items()):\n+        if st == \"PENDING\":\n+            action_idx += 1\n+            ln.append(\n+                f\"{action_idx}. ⏳ Awaiting review \"\n+                f\"from **@{login}**\"\n+            )\n+    for ct in code_threads:\n+        action_idx += 1\n+        ln.append(\n+            f\"{action_idx}. 💬 Reply to \"\n+            f\"**@{ct['last_author']}** on \"\n+            f\"`{ct['path']}:{ct['line']}`\"\n+        )\n+    for pc in pr_unreplied:\n+        action_idx += 1\n+        ln.append(\n+            f\"{action_idx}. 💬 Address \"\n+            f\"**@{pc['author']}**'s \"\n+            f\"PR comment ({pc['date']})\"\n+        )\n+    if action_idx == 0:\n+        ln.append(\"None — all caught up! 🎉\")\n+    ln.append(\"\")\n+\n+    # ── Unreplied Code Comments ──\n+    ln.append(\"## Unreplied Code Comments\")\n+    ln.append(\"\")\n+    if not code_threads:\n+        ln.append(\"None.\")\n+        ln.append(\"\")\n+    for ct in code_threads:\n+        path = ct[\"path\"]\n+        line = ct[\"line\"]\n+        url = ct[\"url\"]\n+        participants = \", \".join(\n+            f\"@{p}\" for p in ct[\"participants\"]\n+        )\n+        ln.append(f\"### [{path}:{line}]({url})\")\n+        ln.append(\"\")\n+        ln.append(\"- **Severity**: TBD\")\n+        ln.append(\n+            f\"- **Awaiting reply from**: @{pr_author}\"\n+        )\n+        ln.append(\n+            f\"- **Participants**: {participants}\"\n+        )\n+        ln.append(\"\")\n+        hunk = diff_hunks.get(url, \"\")\n+        ln.extend(\n+            _format_conversation(\n+                ct[\"comments\"], hunk\n+            )\n+        )\n+        ln.append(\"---\")\n+        ln.append(\"\")\n+\n+    # ── Unreplied PR Comments ──\n+    ln.append(\"## Unreplied PR Comments\")\n+    ln.append(\"\")\n+    if not pr_unreplied:\n+        ln.append(\"None.\")\n+        ln.append(\"\")\n+    for pc in pr_unreplied:\n+        ln.append(\n+            f\"### [PR Comment]({pc['url']})\"\n+        )\n+        ln.append(\"\")\n+        ln.append(\"- **Severity**: TBD\")\n+        ln.append(\n+            f\"- **Asked by**: @{pc['author']}\"\n+        )\n+        ln.append(\n+            f\"- **Awaiting reply from**: @{pr_author}\"\n+        )\n+        ln.append(f\"- **Date**: {pc['date']}\")\n+        ln.append(\"\")\n+        ln.append(_quote(pc[\"body\"]))\n+        ln.append(\"\")\n+        ln.append(\"---\")\n+        ln.append(\"\")\n+\n+    # ── Suspicious Resolutions ──\n+    ln.append(\"## Suspicious Resolutions\")\n+    ln.append(\"\")\n+    ln.append(\"None.\")\n+    ln.append(\"\")\n+\n+    # ── Resolved Comments (Audit Required) ──\n+    ln.append(\"## Resolved Comments (Audit Required)\")\n+    ln.append(\"\")\n+    if not resolved_threads:\n+        ln.append(\"None.\")\n+        ln.append(\"\")\n+    for rt in resolved_threads:\n+        comments = (\n+            rt.get(\"comments\", {}).get(\"nodes\", [])\n+        )\n+        if not comments:\n+            continue\n+        first = comments[0]\n+        path = rt.get(\"path\", \"?\")\n+        line = (\n+            rt.get(\"line\")\n+            or rt.get(\"startLine\")\n+            or \"?\"\n+        )\n+        url = first.get(\"url\", \"\")\n+        participants = list(dict.fromkeys(\n+            c.get(\"author\", {}).get(\"login\", \"?\")\n+            for c in comments\n+        ))\n+        parts_str = \", \".join(\n+            f\"@{p}\" for p in participants\n+        )\n+        ln.append(f\"### [{path}:{line}]({url})\")\n+        ln.append(\"\")\n+        ln.append(\n+            \"- **Status**: \"\n+            \"✅ RESOLVED — AI VERIFIED\"\n+        )\n+        ln.append(\n+            f\"- **Participants**: {parts_str}\"\n+        )\n+        ln.append(\"\")\n+        hunk = diff_hunks.get(url, \"\")\n+        ln.extend(\n+            _format_conversation(comments, hunk)\n+        )\n+        ln.append(\"---\")\n+        ln.append(\"\")\n+\n+    report_path = os.path.join(\n+        pr_dir, \"status-report.md\"\n+    )\n+    with open(report_path, \"w\") as f:\n+        f.write(\"\\n\".join(ln))\n+    print(\n+        f\"  ✓ Status report → \"\n+        f\"{os.path.relpath(report_path, ROOT)}\"\n+    )\n+\n+\n+_SEV_ORDER = {\n+    \"CRITICAL\": 0, \"HIGH\": 1,\n+    \"MEDIUM\": 2, \"LOW\": 3, \"TBD\": 4,\n+}\n+\n+\n+def reorder(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    report_path = os.path.join(pr_dir, \"status-report.md\")\n+    if not os.path.exists(report_path):\n+        print(\n+            f\"No status report for PR #{pr_number}.\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    with open(report_path) as f:\n+        content = f.read()\n+\n+    # Split into sections by \"## Unreplied Code Comments\"\n+    # and \"## Unreplied PR Comments\", reorder each block.\n+    def _reorder_section(text):\n+        # Split into individual comment blocks by \"---\"\n+        blocks = re.split(r\"\\n---\\n\", text)\n+        blocks = [b for b in blocks if b.strip()]\n+\n+        def _sev(block):\n+            m = re.search(\n+                r\"\\*\\*Severity\\*\\*:\\s*(\\w+)\", block\n+            )\n+            if m:\n+                return _SEV_ORDER.get(m.group(1), 99)\n+            return 99\n+\n+        blocks.sort(key=_sev)\n+        return \"\\n---\\n\\n\".join(blocks)\n+\n+    # Find and reorder code comments section\n+    code_match = re.search(\n+        r\"(## Unreplied Code Comments\\n\\n)(.*?)\"\n+        r\"(## Unreplied PR Comments)\",\n+        content, re.DOTALL,\n+    )\n+    if code_match:\n+        body = code_match.group(2)\n+        if \"None.\" not in body:\n+            reordered = _reorder_section(body)\n+            content = (\n+                content[:code_match.start(2)]\n+                + reordered + \"\\n\\n\"\n+                + content[code_match.start(3):]\n+            )\n+\n+    # Find and reorder PR comments section\n+    # (ends at \"## Suspicious\" or \"## Resolved\" or EOF)\n+    pr_match = re.search(\n+        r\"(## Unreplied PR Comments\\n\\n)(.*?)\"\n+        r\"(## Suspicious Resolutions\"\n+        r\"|## Resolved Comments|$)\",\n+        content, re.DOTALL,\n+    )\n+    if pr_match:\n+        body = pr_match.group(2)\n+        if \"None.\" not in body:\n+            reordered = _reorder_section(body)\n+            content = (\n+                content[:pr_match.start(2)]\n+                + reordered + \"\\n\\n\"\n+                + content[pr_match.start(3):]\n+            )\n+\n+    with open(report_path, \"w\") as f:\n+        f.write(content)\n+    print(f\"  ✓ PR #{pr_number} status report reordered\")\n+\n+\n+def main():\n+    if len(sys.argv) < 2:\n+        print(\n+            \"Usage: pr.py \"\n+            \"{list|fetch|status|reorder} \"\n+            \"[PR_NUMBER]\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    cmd = sys.argv[1]\n+\n+    if cmd == \"list\":\n+        prs = _list_open_prs()\n+        excludes = _load_exclude_list()\n+        for pr in prs:\n+            num = str(pr[\"number\"])\n+            marker = \" [excluded]\" if num in excludes else \"\"\n+            author = pr.get(\"author\", {}).get(\"login\", \"?\")\n+            title = pr.get(\"title\", \"\")\n+            print(f\"  #{num}\\t@{author}\\t{title}{marker}\")\n+        total = len(prs)\n+        excluded = sum(\n+            1 for pr in prs\n+            if str(pr[\"number\"]) in excludes\n+        )\n+        print(\n+            f\"\\n  {total} open PR(s), \"\n+            f\"{excluded} excluded\"\n+        )\n+\n+    elif cmd == \"fetch\":\n+        if len(sys.argv) < 3:\n+            print(\n+                \"Usage: pr.py fetch <PR_NUMBER|ALL>\",\n+                file=sys.stderr,\n+            )\n+            sys.exit(1)\n+        arg = sys.argv[2]\n+        if arg.upper() == \"ALL\":\n+            prs = _list_open_prs()\n+            excludes = _load_exclude_list()\n+            for pr in prs:\n+                num = str(pr[\"number\"])\n+                if num in excludes:\n+                    print(f\"  Skipping PR #{num} (excluded)\")\n+                    continue\n+                fetch(num)\n+        else:\n+            fetch(arg)\n+\n+    elif cmd == \"status\":\n+        if len(sys.argv) < 3:\n+            print(\n+                \"Usage: pr.py status <PR_NUMBER|ALL>\",\n+                file=sys.stderr,\n+            )\n+            sys.exit(1)\n+        arg = sys.argv[2]\n+        if arg.upper() == \"ALL\":\n+            excludes = _load_exclude_list()\n+            for d in sorted(os.listdir(PRS_DIR)):\n+                if d in excludes:\n+                    print(f\"  Skipping PR #{d} (excluded)\")\n+                    continue\n+                p = os.path.join(PRS_DIR, d, \"meta.json\")\n+                if os.path.isfile(p):\n+                    status(d)\n+        else:","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"e4e64c42967ff9f20d952d2def8a69f4d21e1e43","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n2\\. Missing <b><i>.prs</i></b> dir guard <code>📘 Rule violation</code> <code>⛯ Reliability</code>\n\n<pre>\n<b><i>pr.py status ALL</i></b> calls <b><i>os.listdir(PRS_DIR)</i></b> without ensuring the directory exists, which can\ncrash on first run. This is an unhandled edge case that reduces robustness.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\n`status ALL` assumes `.prs/` exists and calls `os.listdir(PRS_DIR)` unconditionally, which can raise `FileNotFoundError` and crash.\n\n## Issue Context\nThe script creates `.prs/{ID}` during `fetch`, but a user may run `status ALL` before any `fetch` has been executed.\n\n## Fix Focus Areas\n- skills/scripts/pr.py[72-75]\n- skills/scripts/pr.py[902-921]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T16:10:20Z","updated_at":"2026-02-11T16:10:21Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149093","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149093"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149093"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":954,"original_start_line":910,"start_side":"RIGHT","line":969,"original_line":919,"side":"RIGHT","author_association":"NONE","original_position":919,"position":969,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149095","pull_request_review_id":3785782870,"id":2794149095,"node_id":"PRRC_kwDOQ7VXwc6mi1Tn","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)\n+\n+\n+def _load_pr_config():\n+    \"\"\"Load PR review config from adapter's pr-review.json.\n+\n+    Resolution order:\n+    1. {project_root}/{cypilotAdapterPath}/pr-review.json\n+    2. {project_root}/.cypilot-adapter/pr-review.json (default)\n+    \"\"\"\n+    adapter_path = \".cypilot-adapter\"\n+    if os.path.exists(_CYPILOT_CONFIG_PATH):\n+        with open(_CYPILOT_CONFIG_PATH) as f:\n+            core = json.load(f)\n+        adapter_path = core.get(\n+            \"cypilotAdapterPath\", adapter_path,\n+        )\n+    pr_cfg_path = os.path.join(\n+        ROOT, adapter_path, \"pr-review.json\",\n+    )\n+    if not os.path.exists(pr_cfg_path):\n+        return {}\n+    with open(pr_cfg_path) as f:\n+        return json.load(f)\n+\n+\n+_PR_CFG = _load_pr_config()\n+\n+# PR data directory (default .prs/, overridable in pr-review.json)\n+PRS_DIR = os.path.join(\n+    ROOT, _PR_CFG.get(\"dataDir\", \".prs\"),\n+)\n+TEMPLATES_DIR = os.path.join(\n+    ROOT,\n+    _PR_CFG.get(\n+        \"templatesDir\", \".cypilot/templates/pr\",\n+    ),\n+)\n+# Local config path (exclude list, etc.)\n+CONFIG_PATH = os.path.join(ROOT, \".prs\", \"config.yaml\")\n+\n+\n+def _run(cmd, **kwargs):\n+    result = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kwargs)\n+    if result.returncode != 0 and kwargs.get(\"check\", False):\n+        print(result.stderr, file=sys.stderr)\n+        sys.exit(result.returncode)\n+    return result\n+\n+\n+def _load_exclude_list():\n+    \"\"\"Load exclude_prs list from .prs/config.yaml.\n+\n+    Parses lines under `exclude_prs:` that start with `- `.\n+    Returns a set of PR number strings.\n+    \"\"\"\n+    excludes = set()\n+    if not os.path.exists(CONFIG_PATH):\n+        return excludes\n+    in_section = False\n+    with open(CONFIG_PATH) as f:\n+        for line in f:\n+            stripped = line.strip()\n+            if stripped == \"exclude_prs:\":\n+                in_section = True\n+                continue\n+            if in_section:\n+                if stripped.startswith(\"- \"):\n+                    val = stripped[2:].strip().strip('\"').strip(\"'\")\n+                    if val:\n+                        excludes.add(val)\n+                elif stripped and not stripped.startswith(\"#\"):\n+                    in_section = False\n+    return excludes\n+\n+\n+def _list_open_prs():\n+    \"\"\"Return list of open PR numbers via gh CLI.\"\"\"\n+    result = _run([\n+        \"gh\", \"pr\", \"list\",\n+        \"--json\", \"number,title,author,state,url\",\n+        \"--limit\", \"100\",\n+    ])\n+    if result.returncode != 0:\n+        print(\n+            f\"Failed to list PRs: {result.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+    return json.loads(result.stdout)\n+\n+\n+def _owner_repo():\n+    \"\"\"Return (owner, repo) from gh CLI.\"\"\"\n+    r = _run([\n+        \"gh\", \"repo\", \"view\",\n+        \"--json\", \"nameWithOwner\",\n+        \"-q\", \".nameWithOwner\",\n+    ])\n+    if r.returncode != 0:\n+        return None, None\n+    parts = r.stdout.strip().split(\"/\", 1)\n+    return (parts[0], parts[1]) if len(parts) == 2 else (None, None)\n+\n+\n+_META_FIELDS = \",\".join([\n+    \"title\", \"body\", \"files\", \"comments\",\n+    \"reviews\", \"labels\", \"author\", \"state\",\n+    \"baseRefName\", \"headRefName\",\n+    \"url\", \"createdAt\", \"updatedAt\",\n+    \"reviewRequests\", \"statusCheckRollup\",\n+    \"mergeStateStatus\", \"reviewDecision\",\n+])\n+\n+_REVIEW_THREADS_QUERY = (\n+    \"query($owner:String!,$repo:String!,$n:Int!){\"\n+    \"repository(owner:$owner,name:$repo){\"\n+    \"pullRequest(number:$n){\"\n+    \"reviewThreads(first:100){nodes{\"\n+    \"id isResolved isOutdated path line startLine \"\n+    \"comments(first:50){nodes{\"\n+    \"id author{login}body createdAt url\"\n+    \"}}}}\"\n+    \"}}}\"\n+)\n+\n+\n+def fetch(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    os.makedirs(pr_dir, exist_ok=True)\n+\n+    # 1. PR metadata (expanded fields)\n+    meta = _run([\n+        \"gh\", \"pr\", \"view\", pr_number,\n+        \"--json\", _META_FIELDS,\n+    ])\n+    if meta.returncode != 0:\n+        print(\n+            f\"Failed to fetch PR #{pr_number}: \"\n+            f\"{meta.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+    with open(meta_path, \"w\") as f:\n+        json.dump(\n+            json.loads(meta.stdout), f,\n+            indent=2, ensure_ascii=False,\n+        )\n+        f.write(\"\\n\")\n+    print(\n+        f\"  Saved metadata → \"\n+        f\"{os.path.relpath(meta_path, ROOT)}\"\n+    )\n+\n+    # 2. Diff\n+    diff = _run([\"gh\", \"pr\", \"diff\", pr_number])\n+    if diff.returncode != 0:\n+        print(\n+            f\"Failed to fetch diff for PR \"\n+            f\"#{pr_number}: {diff.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    diff_path = os.path.join(pr_dir, \"diff.patch\")\n+    with open(diff_path, \"w\") as f:\n+        f.write(diff.stdout)\n+    print(\n+        f\"  Saved diff → \"\n+        f\"{os.path.relpath(diff_path, ROOT)}\"\n+    )\n+\n+    # 3. Review comments (REST — keeps diff_hunk etc.)\n+    comments = _run([\n+        \"gh\", \"api\",\n+        f\"repos/{{owner}}/{{repo}}/pulls/\"\n+        f\"{pr_number}/comments\",\n+        \"--paginate\",\n+    ])\n+    if comments.returncode == 0:\n+        rc_path = os.path.join(\n+            pr_dir, \"review_comments.json\"\n+        )\n+        with open(rc_path, \"w\") as f:\n+            json.dump(\n+                json.loads(comments.stdout), f,\n+                indent=2, ensure_ascii=False,\n+            )\n+            f.write(\"\\n\")\n+        print(\n+            f\"  Saved review comments → \"\n+            f\"{os.path.relpath(rc_path, ROOT)}\"\n+        )\n+\n+    # 4. Review threads via GraphQL (isResolved)\n+    owner, repo = _owner_repo()\n+    if owner and repo:\n+        threads = _run([\n+            \"gh\", \"api\", \"graphql\",\n+            \"-f\", f\"query={_REVIEW_THREADS_QUERY}\",\n+            \"-F\", f\"n={pr_number}\",\n+            \"-f\", f\"owner={owner}\",\n+            \"-f\", f\"repo={repo}\",\n+        ])\n+        if threads.returncode == 0:\n+            threads_path = os.path.join(\n+                pr_dir, \"review_threads.json\"\n+            )\n+            with open(threads_path, \"w\") as f:\n+                json.dump(\n+                    json.loads(threads.stdout), f,\n+                    indent=2, ensure_ascii=False,\n+                )\n+                f.write(\"\\n\")\n+            print(\n+                f\"  Saved review threads → \"\n+                f\"{os.path.relpath(threads_path, ROOT)}\"\n+            )\n+\n+    print(f\"  ✓ PR #{pr_number} fetched\")\n+\n+\n+BOTS = {\n+    \"coderabbitai\", \"coderabbitai[bot]\",\n+    \"qodo-code-review\", \"qodo-code-review[bot]\",\n+    \"github-actions\", \"github-actions[bot]\",\n+    \"github-advanced-security\", \"github-advanced-security[bot]\",\n+    \"dependabot\", \"dependabot[bot]\",\n+    \"renovate\", \"renovate[bot]\",\n+}\n+\n+\n+def _is_bot(login: str) -> bool:\n+    return login in BOTS or login.endswith(\"[bot]\")\n+\n+\n+def _quote(text: str) -> str:\n+    lines = (text or \"\").strip().splitlines()\n+    return \"\\n\".join(\"> \" + ln for ln in lines) if lines else \"> (empty)\"\n+\n+\n+_STATE_ICON = {\n+    \"OPEN\": \"🟢\", \"CLOSED\": \"🔴\", \"MERGED\": \"🟣\",\n+}\n+_REVIEW_ICON = {\n+    \"APPROVED\": \"✅\",\n+    \"CHANGES_REQUESTED\": \"❌\",\n+    \"COMMENTED\": \"💬\",\n+    \"DISMISSED\": \"👀\",\n+    \"PENDING\": \"⏳\",\n+}\n+_CI_ICON = {\n+    \"SUCCESS\": \"✅\", \"FAILURE\": \"❌\",\n+    \"PENDING\": \"⏳\", \"ERROR\": \"⚠️\",\n+}\n+\n+\n+def _load_diff_hunks(pr_dir):\n+    \"\"\"Build url → diff_hunk lookup from REST data.\"\"\"\n+    rc_path = os.path.join(\n+        pr_dir, \"review_comments.json\"\n+    )\n+    if not os.path.exists(rc_path):\n+        return {}\n+    with open(rc_path) as f:\n+        comments = json.loads(f.read())\n+    hunks = {}\n+    for c in comments:\n+        url = c.get(\"html_url\", \"\")\n+        hunk = c.get(\"diff_hunk\", \"\")\n+        if url and hunk:\n+            hunks[url] = hunk\n+    return hunks\n+\n+\n+def _has_quote_match(original_body, reply_body):\n+    \"\"\"Check if reply quotes text from the original.\"\"\"\n+    quoted = []\n+    for line in reply_body.splitlines():\n+        s = line.strip()\n+        if s.startswith(\">\"):\n+            txt = s.lstrip(\">\").strip()\n+            if txt and not txt.startswith(\"@\"):\n+                quoted.append(txt.lower())\n+    if not quoted:\n+        return False\n+    orig_lower = original_body.lower()\n+    return any(q in orig_lower for q in quoted)\n+\n+\n+def _detect_pr_replies(comments, pr_author):\n+    \"\"\"Return set of comment URLs that the author replied to.\"\"\"\n+    replied = set()\n+    human = [\n+        c for c in comments\n+        if not _is_bot(\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+    ]\n+    for i, c in enumerate(human):\n+        c_author = (\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if c_author == pr_author:\n+            continue\n+        c_body = c.get(\"body\") or \"\"\n+        c_url = c.get(\"url\", \"\")\n+        # Check subsequent author comments for quote\n+        for j in range(i + 1, len(human)):\n+            r = human[j]\n+            r_author = (\n+                r.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+            if r_author != pr_author:\n+                continue\n+            r_body = r.get(\"body\") or \"\"\n+            if _has_quote_match(c_body, r_body):\n+                replied.add(c_url)\n+                break\n+    return replied\n+\n+\n+def _format_conversation(comments, diff_hunk=\"\"):\n+    \"\"\"Format a thread as a chat with optional code.\"\"\"\n+    ln = []\n+    if diff_hunk:\n+        ln.append(\"```diff\")\n+        hunk_lines = diff_hunk.strip().splitlines()\n+        # Keep last 12 lines for context\n+        if len(hunk_lines) > 12:\n+            ln.append(\"  ...\")\n+            hunk_lines = hunk_lines[-12:]\n+        for hl in hunk_lines:\n+            ln.append(hl)\n+        ln.append(\"```\")\n+        ln.append(\"\")\n+    for c in comments:\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        date = c.get(\"createdAt\", \"\")[:10]\n+        body = (c.get(\"body\") or \"\").strip()\n+        ln.append(f\"> **@{author}** ({date}):\")\n+        ln.append(\">\")\n+        for bl in body.splitlines():\n+            ln.append(f\"> {bl}\")\n+        ln.append(\"\")\n+    return ln\n+\n+\n+def _load_review_threads(pr_dir):\n+    \"\"\"Load review threads from GraphQL data.\"\"\"\n+    path = os.path.join(pr_dir, \"review_threads.json\")\n+    if not os.path.exists(path):\n+        return []\n+    with open(path) as f:\n+        data = json.load(f)\n+    try:\n+        return (\n+            data[\"data\"][\"repository\"]\n+            [\"pullRequest\"][\"reviewThreads\"][\"nodes\"]\n+        )\n+    except (KeyError, TypeError):\n+        return []\n+\n+\n+def _reviewer_table(meta):\n+    \"\"\"Build deduplicated reviewer list with latest state.\"\"\"\n+    pr_author = meta[\"author\"][\"login\"]\n+    reviewers = {}\n+    # Submitted reviews (last state wins)\n+    for r in meta.get(\"reviews\", []):\n+        login = r.get(\"author\", {}).get(\"login\", \"?\")\n+        if login == pr_author:\n+            continue\n+        state = r.get(\"state\", \"COMMENTED\")\n+        reviewers[login] = state\n+    # Pending review requests (only if no review yet)\n+    for rr in meta.get(\"reviewRequests\", []):\n+        login = rr.get(\"login\", \"\")\n+        if not login:\n+            # Team review request\n+            login = rr.get(\"name\", \"?\")\n+        if login and login not in reviewers:\n+            reviewers[login] = \"PENDING\"\n+    return reviewers\n+\n+\n+def _ci_summary(meta):\n+    \"\"\"Summarise CI status from statusCheckRollup.\"\"\"\n+    checks = meta.get(\"statusCheckRollup\", [])\n+    if not checks:\n+        return \"—\"\n+    states = {}\n+    for c in checks:\n+        # gh CLI normalises to __typename/state/status\n+        s = (\n+            c.get(\"conclusion\")\n+            or c.get(\"state\")\n+            or c.get(\"status\")\n+            or \"PENDING\"\n+        ).upper()\n+        states[s] = states.get(s, 0) + 1\n+    parts = []\n+    for s in [\"SUCCESS\", \"FAILURE\", \"ERROR\", \"PENDING\",\n+              \"NEUTRAL\", \"SKIPPED\"]:\n+        if s in states:\n+            icon = _CI_ICON.get(s, \"\")\n+            parts.append(f\"{icon} {s}: {states[s]}\")\n+    return \", \".join(parts) if parts else \"—\"\n+\n+\n+def status(pr_number: str):\n+    # Always fetch the latest PR data before report\n+    fetch(pr_number)\n+\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+\n+    with open(meta_path) as f:\n+        meta = json.load(f)\n+\n+    pr_author = meta[\"author\"][\"login\"]\n+    pr_title = meta.get(\"title\", \"\")\n+    pr_url = meta.get(\"url\", \"\")\n+    pr_state = meta.get(\"state\", \"?\")\n+    pr_created = meta.get(\"createdAt\", \"\")[:10]\n+    pr_updated = meta.get(\"updatedAt\", \"\")[:10]\n+    merge_state = meta.get(\"mergeStateStatus\", \"—\")\n+    review_decision = meta.get(\"reviewDecision\", \"—\")\n+    state_icon = _STATE_ICON.get(pr_state, \"\")\n+    ci_text = _ci_summary(meta)\n+\n+    # --- Load data ---\n+    all_threads = _load_review_threads(pr_dir)\n+    diff_hunks = _load_diff_hunks(pr_dir)\n+    resolved_threads = [\n+        t for t in all_threads if t.get(\"isResolved\")\n+    ]\n+    unresolved_threads = [\n+        t for t in all_threads\n+        if not t.get(\"isResolved\")\n+    ]\n+\n+    # --- Unresolved → unreplied code threads ---\n+    code_threads = []\n+    for t in unresolved_threads:\n+        comments = (\n+            t.get(\"comments\", {}).get(\"nodes\", [])\n+        )\n+        if not comments:\n+            continue\n+        humans = [\n+            c for c in comments\n+            if not _is_bot(\n+                c.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+        ]\n+        if not humans:\n+            continue\n+        last = comments[-1]\n+        last_author = (\n+            last.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if last_author == pr_author:\n+            continue\n+        first = comments[0]\n+        participants = list(dict.fromkeys(\n+            c.get(\"author\", {}).get(\"login\", \"?\")\n+            for c in comments\n+        ))\n+        code_threads.append({\n+            \"path\": t.get(\"path\", \"?\"),\n+            \"line\": (\n+                t.get(\"line\")\n+                or t.get(\"startLine\")\n+                or \"?\"\n+            ),\n+            \"url\": first.get(\"url\", \"\"),\n+            \"last_author\": last_author,\n+            \"participants\": participants,\n+            \"comments\": comments,\n+        })\n+\n+    # --- PR-level comments: split unreplied vs replied ---\n+    replied_urls = _detect_pr_replies(\n+        meta.get(\"comments\", []), pr_author\n+    )\n+    pr_unreplied = []\n+    pr_replied = []\n+    for c in meta.get(\"comments\", []):\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        if _is_bot(author) or author == pr_author:\n+            continue\n+        entry = {\n+            \"url\": c.get(\"url\", \"\"),\n+            \"author\": author,\n+            \"date\": c.get(\"createdAt\", \"\")[:10],\n+            \"body\": c.get(\"body\", \"\"),\n+        }\n+        if entry[\"url\"] in replied_urls:\n+            pr_replied.append(entry)\n+        else:\n+            pr_unreplied.append(entry)\n+\n+    # --- Reviewers ---\n+    reviewers = _reviewer_table(meta)\n+\n+    # --- Counts for summary table ---\n+    n_code_unresolved = len(code_threads)\n+    n_code_resolved = len(resolved_threads)\n+    n_pr_unreplied = len(pr_unreplied)\n+    n_pr_replied = len(pr_replied)\n+\n+    # ===== Build report =====\n+    ln = []\n+\n+    # ── Header ──\n+    ln.append(f\"# PR #{pr_number}: {pr_title}\")\n+    ln.append(\"\")\n+    ln.append(\"| Field | Value |\")\n+    ln.append(\"|---|---|\")\n+    ln.append(f\"| **URL** | {pr_url} |\")\n+    ln.append(f\"| **Author** | @{pr_author} |\")\n+    ln.append(\n+        f\"| **State** | {state_icon} {pr_state} |\"\n+    )\n+    ln.append(f\"| **Created** | {pr_created} |\")\n+    ln.append(f\"| **Updated** | {pr_updated} |\")\n+    ln.append(f\"| **CI Status** | {ci_text} |\")\n+    ln.append(\n+        f\"| **Merge Status** | {merge_state} |\"\n+    )\n+    ln.append(\n+        f\"| **Review Decision** | {review_decision} |\"\n+    )\n+    ln.append(\n+        f\"| **Code comments** \"\n+        f\"| {n_code_unresolved} unresolved / \"\n+        f\"{n_code_resolved} resolved / \"\n+        f\"0 suspicious |\"\n+    )\n+    ln.append(\n+        f\"| **PR comments** \"\n+        f\"| {n_pr_unreplied} unreplied / \"\n+        f\"{n_pr_replied} replied / \"\n+        f\"0 suspicious |\"\n+    )\n+    ln.append(\"\")\n+\n+    # ── PR Description ──\n+    body = (meta.get(\"body\") or \"\").strip()\n+    if body:\n+        ln.append(\"## PR Description\")\n+        ln.append(\"\")\n+        preview = body[:2000]\n+        if len(body) > 2000:\n+            preview += \"\\n\\n_(truncated)_\"\n+        ln.append(_quote(preview))\n+        ln.append(\"\")","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"e4e64c42967ff9f20d952d2def8a69f4d21e1e43","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n3\\. Pr text logged unredacted <code>📘 Rule violation</code> <code>⛨ Security</code>\n\n<pre>\nThe generated status report includes PR descriptions and comment bodies verbatim, which can contain\nsecrets/PII and is written to disk under <b><i>.prs/</i></b>. This violates secure logging expectations to avoid\nsensitive data in log-like outputs.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nThe script writes PR descriptions and comment/review-thread bodies verbatim into `.prs/{ID}/status-report.md`, which can persist secrets/PII to disk and function like unstructured logging.\n\n## Issue Context\nPR bodies/comments are externally sourced and may contain credentials, tokens, emails, or other sensitive content. Compliance requires avoiding sensitive data in logs.\n\n## Fix Focus Areas\n- skills/scripts/pr.py[368-392]\n- skills/scripts/pr.py[594-604]\n- skills/scripts/pr.py[689-713]\n- skills/scripts/pr.py[764-772]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T16:10:20Z","updated_at":"2026-02-11T16:10:21Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149095","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149095"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149095"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":639,"original_start_line":595,"start_side":"RIGHT","line":647,"original_line":603,"side":"RIGHT","author_association":"NONE","original_position":603,"position":647,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149098","pull_request_review_id":3785782870,"id":2794149098,"node_id":"PRRC_kwDOQ7VXwc6mi1Tq","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"e4e64c42967ff9f20d952d2def8a69f4d21e1e43","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n4\\. Wrong config path <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\n<b><i>pr.py</i></b> looks for project config at <b><i>{root}/.cypilot/.cypilot-config.json</i></b>, but the rest of the repo\ndefines <b><i>.cypilot-config.json</i></b> at the project root. This prevents honoring <b><i>cypilotAdapterPath</i></b>\noverrides and can break PR config resolution.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\n`skills/scripts/pr.py` loads the core config from `{ROOT}/.cypilot/.cypilot-config.json`, but the canonical project config file is `{project-root}/.cypilot-config.json`. This breaks reading `cypilotAdapterPath` overrides.\n\n## Issue Context\nCypilot core code and documentation consistently use `.cypilot-config.json` at the project root.\n\n## Fix Focus Areas\n- skills/scripts/pr.py[41-67]\n- skills/cypilot/scripts/cypilot/constants.py[10-13]\n- skills/cypilot/scripts/cypilot/utils/files.py[26-57]\n- skills/cypilot/SKILL.md[292-297]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T16:10:20Z","updated_at":"2026-02-11T16:10:21Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149098","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149098"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149098"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149098/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":57,"original_start_line":41,"start_side":"RIGHT","line":60,"original_line":44,"side":"RIGHT","author_association":"NONE","original_position":44,"position":60,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149101","pull_request_review_id":3785782870,"id":2794149101,"node_id":"PRRC_kwDOQ7VXwc6mi1Tt","diff_hunk":"@@ -0,0 +1,150 @@\n+---\n+cypilot: true\n+type: workflow\n+name: cypilot-pr-review\n+description: Review GitHub PRs using LLM-powered analysis with configurable prompts and checklists\n+version: 1.0\n+purpose: Read-only PR review — fetch diffs/metadata from GitHub, analyze against checklists, produce structured review reports\n+---\n+\n+ALWAYS open and follow `{cypilot_path}/skills/cypilot/SKILL.md` FIRST WHEN {cypilot_mode} is `off`\n+\n+# PR Review Workflow\n+\n+**Type**: Analysis\n+**Role**: Reviewer\n+**Output**: `.prs/{ID}/review.md`\n+\n+---\n+\n+## Routing\n+\n+| User Intent | Route | Example |\n+|-------------|-------|---------|\n+| Review a specific PR | **pr-review.md** | \"review PR 123\", `/cypilot-pr-review 123` |\n+| Review all open PRs | **pr-review.md** | \"review all PRs\", `/cypilot-pr-review ALL` |\n+| Check PR status | **pr-status.md** | \"PR status 123\", `/cypilot-pr-status ALL` |\n+\n+---\n+\n+## Overview\n+\n+Accepts one argument: a PR number (e.g. `123`) or `ALL`.\n+Also triggered by natural-language prompts like `cypilot review PR 123`,\n+`review PR #59`, or `cypilot review PR https://github.com/org/repo/pull/123`.\n+\n+All review is **read-only** — the LLM reads the downloaded diff file and\n+the current repo source without modifying the local working tree.\n+\n+**IMPORTANT**: Every review request MUST re-fetch and re-analyze from scratch.\n+NEVER reuse data or analysis from a previous run in this conversation.\n+Previous results are stale the moment a new review request arrives.\n+\n+---\n+\n+## Paths\n+\n+- **Script**: `python3 .cypilot/skills/scripts/pr.py`\n+- **Config**: `{cypilot_adapter_path}/pr-review.json`\n+- **Templates**: `.cypilot/templates/pr/`\n+- **Checklists**: `docs/checklists/` (PRD.md, DESIGN.md, ADR.md, etc.)\n+- **Prompts**: `.cypilot/prompts/pr/`\n+- **PR data**: `.prs/{ID}/`\n+- **Exclude list**: `.prs/config.yaml` → `exclude_prs`\n+\n+## Prerequisites\n+\n+- [ ] `gh` CLI installed and authenticated (`gh auth status`)\n+- [ ] Repository has GitHub remote configured\n+- [ ] `{cypilot_adapter_path}/pr-review.json` has `prompts` configured\n+","path":"workflows/pr-review.md","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"e4e64c42967ff9f20d952d2def8a69f4d21e1e43","user":{"login":"qodo-code-review[bot]","id":151058649,"node_id":"BOT_kgDOCQD42Q","avatar_url":"https://avatars.githubusercontent.com/in/484649?v=4","gravatar_id":"","url":"https://api.github.com/users/qodo-code-review%5Bbot%5D","html_url":"https://github.com/apps/qodo-code-review","followers_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/followers","following_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/repos","events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/qodo-code-review%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"<img src=\"https://www.qodo.ai/wp-content/uploads/2025/12/v2-action-required.svg\" height=\"20\" alt=\"Action required\">\n\n5\\. Workflow structure fails <code>🐞 Bug</code> <code>✓ Correctness</code>\n\n<pre>\n<b><i>workflows/pr-review.md</i></b> and <b><i>workflows/pr-status.md</i></b> don’t include the required `## Prerequisite\nChecklist` section name and appear to lack any explicit conclusion/“next steps” language required by\nrepo tests. This will fail CI workflow-structure validation.\n</pre>\n\n\n<details>\n<summary><strong>Agent Prompt</strong></summary>\n\n```\n## Issue description\nNew workflow markdown files must satisfy the repo’s workflow-structure tests. They currently use `## Prerequisites` (not the required `## Prerequisite Checklist`) and lack an explicit conclusion/next-steps section.\n\n## Issue Context\n`tests/test_core_structure.py` enforces both the prerequisite checklist heading and presence of conclusion keywords.\n\n## Fix Focus Areas\n- workflows/pr-review.md[55-60]\n- workflows/pr-review.md[136-150]\n- workflows/pr-status.md[49-53]\n- workflows/pr-status.md[111-122]\n- tests/test_core_structure.py[136-144]\n- tests/test_core_structure.py[294-301]\n```\n\n<code>ⓘ Copy this prompt and use it to remediate the issue with your preferred AI generation tools</code>\n</details>","created_at":"2026-02-11T16:10:21Z","updated_at":"2026-02-11T16:10:21Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149101","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149101"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794149101"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794149101/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":55,"original_start_line":55,"start_side":"RIGHT","line":60,"original_line":60,"side":"RIGHT","author_association":"NONE","original_position":60,"position":60,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794372008","pull_request_review_id":3786034388,"id":2794372008,"node_id":"PRRC_kwDOQ7VXwc6mjruo","diff_hunk":"@@ -0,0 +1,148 @@\n+---\n+cypilot: true\n+type: workflow\n+name: cypilot-pr-review\n+description: Review GitHub PRs using LLM-powered analysis with configurable prompts and checklists\n+version: 1.0\n+purpose: Read-only PR review — fetch diffs/metadata from GitHub, analyze against checklists, produce structured review reports\n+---\n+\n+ALWAYS open and follow `{cypilot_path}/skills/cypilot/SKILL.md` FIRST WHEN {cypilot_mode} is `off`\n+\n+# PR Review Workflow\n+\n+**Type**: Analysis\n+**Role**: Reviewer\n+**Output**: `.prs/{ID}/review.md`\n+\n+---\n+\n+## Routing\n+\n+| User Intent | Route | Example |\n+|-------------|-------|---------|\n+| Review a specific PR | **pr-review.md** | \"review PR 123\", `/cypilot-pr-review 123` |\n+| Review all open PRs | **pr-review.md** | \"review all PRs\", `/cypilot-pr-review ALL` |\n+| Check PR status | **pr-status.md** | \"PR status 123\", `/cypilot-pr-status ALL` |\n+\n+---\n+\n+## Overview\n+\n+Accepts one argument: a PR number (e.g. `123`) or `ALL`.\n+Also triggered by natural-language prompts like `cypilot review PR 123`,\n+`review PR #59`, or `cypilot review PR https://github.com/org/repo/pull/123`.\n+\n+All review is **read-only** — the LLM reads the downloaded diff file and\n+the current repo source without modifying the local working tree.\n+\n+**IMPORTANT**: Every review request MUST re-fetch and re-analyze from scratch.\n+NEVER reuse data or analysis from a previous run in this conversation.\n+Previous results are stale the moment a new review request arrives.\n+\n+---\n+\n+## Paths\n+\n+- **Script**: `python3 .cypilot/skills/scripts/pr.py`\n+- **Config**: `{cypilot_adapter_path}/pr-review.json`","path":"workflows/pr-review.md","commit_id":"236668678c254616d403211946a19cd31922076c","original_commit_id":"e16210e9c3036053510bf8141f01fb1748c55979","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Fix script path and missing config reference.**\n\nThe workflow points to `.cypilot/skills/scripts/pr.py` and `{cypilot_adapter_path}/pr-review.json`. If the script actually lives at `./skills/scripts/pr.py` and the config file is absent, this workflow will fail at runtime. Update the path to the real script location and either add the config file or remove the reference if not required.\n\n<details>\n<summary>🛠️ Proposed update</summary>\n\n```diff\n-- **Script**: `python3 .cypilot/skills/scripts/pr.py`\n-- **Config**: `{cypilot_adapter_path}/pr-review.json`\n+- **Script**: `python3 ./skills/scripts/pr.py`\n+- **Config**: `{cypilot_adapter_path}/pr-review.json`  # ensure this file exists or remove this line\n```\n\n```diff\n-Run: `python3 .cypilot/skills/scripts/pr.py list`\n+Run: `python3 ./skills/scripts/pr.py list`\n\n-Run: `python3 .cypilot/skills/scripts/pr.py fetch <ARG>`\n+Run: `python3 ./skills/scripts/pr.py fetch <ARG>`\n```\n</details>\n\n\n\nAlso applies to: 65-75\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@workflows/pr-review.md` around lines 47 - 48, The workflow references an\nincorrect script path `.cypilot/skills/scripts/pr.py` and a missing config\n`{cypilot_adapter_path}/pr-review.json`; update the script entry to point to the\nactual script location (e.g., `./skills/scripts/pr.py`) and either add the\nreferenced `pr-review.json` config under the adapter path or remove the\n`{cypilot_adapter_path}/pr-review.json` reference from the workflow if that\nconfig is not required; ensure any other occurrences (notably the same\nreferences around lines 65-75) are updated consistently so the workflow executes\nthe correct script and does not reference a nonexistent config.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:triton:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-11T16:49:35Z","updated_at":"2026-02-11T16:49:36Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794372008","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794372008"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794372008"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794372008/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":47,"start_side":"RIGHT","line":null,"original_line":48,"side":"RIGHT","author_association":"NONE","original_position":48,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794478132","pull_request_review_id":3786146746,"id":2794478132,"node_id":"PRRC_kwDOQ7VXwc6mkFo0","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)\n+\n+\n+def _load_pr_config():\n+    \"\"\"Load PR review config from adapter's pr-review.json.\n+\n+    Resolution order:\n+    1. {project_root}/{cypilotAdapterPath}/pr-review.json\n+    2. {project_root}/.cypilot-adapter/pr-review.json (default)\n+    \"\"\"\n+    adapter_path = \".cypilot-adapter\"\n+    if os.path.exists(_CYPILOT_CONFIG_PATH):\n+        with open(_CYPILOT_CONFIG_PATH) as f:\n+            core = json.load(f)\n+        adapter_path = core.get(\n+            \"cypilotAdapterPath\", adapter_path,\n+        )\n+    pr_cfg_path = os.path.join(\n+        ROOT, adapter_path, \"pr-review.json\",\n+    )\n+    if not os.path.exists(pr_cfg_path):\n+        return {}\n+    with open(pr_cfg_path) as f:\n+        return json.load(f)\n+\n+\n+_PR_CFG = _load_pr_config()\n+\n+# PR data directory (default .prs/, overridable in pr-review.json)\n+PRS_DIR = os.path.join(\n+    ROOT, _PR_CFG.get(\"dataDir\", \".prs\"),\n+)\n+TEMPLATES_DIR = os.path.join(\n+    ROOT,\n+    _PR_CFG.get(\n+        \"templatesDir\", \".cypilot/templates/pr\",\n+    ),\n+)\n+# Local config path (exclude list, etc.)\n+CONFIG_PATH = os.path.join(ROOT, \".prs\", \"config.yaml\")\n+\n+\n+def _run(cmd, **kwargs):\n+    result = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kwargs)\n+    if result.returncode != 0 and kwargs.get(\"check\", False):\n+        print(result.stderr, file=sys.stderr)\n+        sys.exit(result.returncode)\n+    return result\n+\n+\n+def _load_exclude_list():\n+    \"\"\"Load exclude_prs list from .prs/config.yaml.\n+\n+    Parses lines under `exclude_prs:` that start with `- `.\n+    Returns a set of PR number strings.\n+    \"\"\"\n+    excludes = set()\n+    if not os.path.exists(CONFIG_PATH):\n+        return excludes\n+    in_section = False\n+    with open(CONFIG_PATH) as f:\n+        for line in f:\n+            stripped = line.strip()\n+            if stripped == \"exclude_prs:\":\n+                in_section = True\n+                continue\n+            if in_section:\n+                if stripped.startswith(\"- \"):\n+                    val = stripped[2:].strip().strip('\"').strip(\"'\")\n+                    if val:\n+                        excludes.add(val)\n+                elif stripped and not stripped.startswith(\"#\"):\n+                    in_section = False\n+    return excludes\n+\n+\n+def _list_open_prs():\n+    \"\"\"Return list of open PR numbers via gh CLI.\"\"\"\n+    result = _run([\n+        \"gh\", \"pr\", \"list\",\n+        \"--json\", \"number,title,author,state,url\",\n+        \"--limit\", \"100\",\n+    ])\n+    if result.returncode != 0:\n+        print(\n+            f\"Failed to list PRs: {result.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+    return json.loads(result.stdout)\n+\n+\n+def _owner_repo():\n+    \"\"\"Return (owner, repo) from gh CLI.\"\"\"\n+    r = _run([\n+        \"gh\", \"repo\", \"view\",\n+        \"--json\", \"nameWithOwner\",\n+        \"-q\", \".nameWithOwner\",\n+    ])\n+    if r.returncode != 0:\n+        return None, None\n+    parts = r.stdout.strip().split(\"/\", 1)\n+    return (parts[0], parts[1]) if len(parts) == 2 else (None, None)\n+\n+\n+_META_FIELDS = \",\".join([\n+    \"title\", \"body\", \"files\", \"comments\",\n+    \"reviews\", \"labels\", \"author\", \"state\",\n+    \"baseRefName\", \"headRefName\",\n+    \"url\", \"createdAt\", \"updatedAt\",\n+    \"reviewRequests\", \"statusCheckRollup\",\n+    \"mergeStateStatus\", \"reviewDecision\",\n+])\n+\n+_REVIEW_THREADS_QUERY = (\n+    \"query($owner:String!,$repo:String!,$n:Int!){\"\n+    \"repository(owner:$owner,name:$repo){\"\n+    \"pullRequest(number:$n){\"\n+    \"reviewThreads(first:100){nodes{\"\n+    \"id isResolved isOutdated path line startLine \"\n+    \"comments(first:50){nodes{\"\n+    \"id author{login}body createdAt url\"\n+    \"}}}}\"\n+    \"}}}\"\n+)\n+\n+\n+def fetch(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    os.makedirs(pr_dir, exist_ok=True)\n+\n+    # 1. PR metadata (expanded fields)\n+    meta = _run([\n+        \"gh\", \"pr\", \"view\", pr_number,\n+        \"--json\", _META_FIELDS,\n+    ])\n+    if meta.returncode != 0:\n+        print(\n+            f\"Failed to fetch PR #{pr_number}: \"\n+            f\"{meta.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+    with open(meta_path, \"w\") as f:\n+        json.dump(\n+            json.loads(meta.stdout), f,\n+            indent=2, ensure_ascii=False,\n+        )\n+        f.write(\"\\n\")\n+    print(\n+        f\"  Saved metadata → \"\n+        f\"{os.path.relpath(meta_path, ROOT)}\"\n+    )\n+\n+    # 2. Diff\n+    diff = _run([\"gh\", \"pr\", \"diff\", pr_number])\n+    if diff.returncode != 0:\n+        print(\n+            f\"Failed to fetch diff for PR \"\n+            f\"#{pr_number}: {diff.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    diff_path = os.path.join(pr_dir, \"diff.patch\")\n+    with open(diff_path, \"w\") as f:\n+        f.write(diff.stdout)\n+    print(\n+        f\"  Saved diff → \"\n+        f\"{os.path.relpath(diff_path, ROOT)}\"\n+    )\n+\n+    # 3. Review comments (REST — keeps diff_hunk etc.)\n+    comments = _run([\n+        \"gh\", \"api\",\n+        f\"repos/{{owner}}/{{repo}}/pulls/\"\n+        f\"{pr_number}/comments\",\n+        \"--paginate\",\n+    ])\n+    if comments.returncode == 0:\n+        rc_path = os.path.join(\n+            pr_dir, \"review_comments.json\"\n+        )\n+        with open(rc_path, \"w\") as f:\n+            json.dump(\n+                json.loads(comments.stdout), f,\n+                indent=2, ensure_ascii=False,\n+            )\n+            f.write(\"\\n\")\n+        print(\n+            f\"  Saved review comments → \"\n+            f\"{os.path.relpath(rc_path, ROOT)}\"\n+        )\n+\n+    # 4. Review threads via GraphQL (isResolved)\n+    owner, repo = _owner_repo()\n+    if owner and repo:\n+        threads = _run([\n+            \"gh\", \"api\", \"graphql\",\n+            \"-f\", f\"query={_REVIEW_THREADS_QUERY}\",\n+            \"-F\", f\"n={pr_number}\",\n+            \"-f\", f\"owner={owner}\",\n+            \"-f\", f\"repo={repo}\",\n+        ])\n+        if threads.returncode == 0:\n+            threads_path = os.path.join(\n+                pr_dir, \"review_threads.json\"\n+            )\n+            with open(threads_path, \"w\") as f:\n+                json.dump(\n+                    json.loads(threads.stdout), f,\n+                    indent=2, ensure_ascii=False,\n+                )\n+                f.write(\"\\n\")\n+            print(\n+                f\"  Saved review threads → \"\n+                f\"{os.path.relpath(threads_path, ROOT)}\"\n+            )\n+\n+    print(f\"  ✓ PR #{pr_number} fetched\")\n+\n+\n+BOTS = {\n+    \"coderabbitai\", \"coderabbitai[bot]\",\n+    \"qodo-code-review\", \"qodo-code-review[bot]\",\n+    \"github-actions\", \"github-actions[bot]\",\n+    \"github-advanced-security\", \"github-advanced-security[bot]\",\n+    \"dependabot\", \"dependabot[bot]\",\n+    \"renovate\", \"renovate[bot]\",\n+}\n+\n+\n+def _is_bot(login: str) -> bool:\n+    return login in BOTS or login.endswith(\"[bot]\")\n+\n+\n+def _quote(text: str) -> str:\n+    lines = (text or \"\").strip().splitlines()\n+    return \"\\n\".join(\"> \" + ln for ln in lines) if lines else \"> (empty)\"\n+\n+\n+_STATE_ICON = {\n+    \"OPEN\": \"🟢\", \"CLOSED\": \"🔴\", \"MERGED\": \"🟣\",\n+}\n+_REVIEW_ICON = {\n+    \"APPROVED\": \"✅\",\n+    \"CHANGES_REQUESTED\": \"❌\",\n+    \"COMMENTED\": \"💬\",\n+    \"DISMISSED\": \"👀\",\n+    \"PENDING\": \"⏳\",\n+}\n+_CI_ICON = {\n+    \"SUCCESS\": \"✅\", \"FAILURE\": \"❌\",\n+    \"PENDING\": \"⏳\", \"ERROR\": \"⚠️\",\n+}\n+\n+\n+def _load_diff_hunks(pr_dir):\n+    \"\"\"Build url → diff_hunk lookup from REST data.\"\"\"\n+    rc_path = os.path.join(\n+        pr_dir, \"review_comments.json\"\n+    )\n+    if not os.path.exists(rc_path):\n+        return {}\n+    with open(rc_path) as f:\n+        comments = json.loads(f.read())\n+    hunks = {}\n+    for c in comments:\n+        url = c.get(\"html_url\", \"\")\n+        hunk = c.get(\"diff_hunk\", \"\")\n+        if url and hunk:\n+            hunks[url] = hunk\n+    return hunks\n+\n+\n+def _has_quote_match(original_body, reply_body):\n+    \"\"\"Check if reply quotes text from the original.\"\"\"\n+    quoted = []\n+    for line in reply_body.splitlines():\n+        s = line.strip()\n+        if s.startswith(\">\"):\n+            txt = s.lstrip(\">\").strip()\n+            if txt and not txt.startswith(\"@\"):\n+                quoted.append(txt.lower())\n+    if not quoted:\n+        return False\n+    orig_lower = original_body.lower()\n+    return any(q in orig_lower for q in quoted)\n+\n+\n+def _detect_pr_replies(comments, pr_author):\n+    \"\"\"Return set of comment URLs that the author replied to.\"\"\"\n+    replied = set()\n+    human = [\n+        c for c in comments\n+        if not _is_bot(\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+    ]\n+    for i, c in enumerate(human):\n+        c_author = (\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if c_author == pr_author:\n+            continue\n+        c_body = c.get(\"body\") or \"\"\n+        c_url = c.get(\"url\", \"\")\n+        # Check subsequent author comments for quote\n+        for j in range(i + 1, len(human)):\n+            r = human[j]\n+            r_author = (\n+                r.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+            if r_author != pr_author:\n+                continue\n+            r_body = r.get(\"body\") or \"\"\n+            if _has_quote_match(c_body, r_body):\n+                replied.add(c_url)\n+                break\n+    return replied\n+\n+\n+def _format_conversation(comments, diff_hunk=\"\"):\n+    \"\"\"Format a thread as a chat with optional code.\"\"\"\n+    ln = []\n+    if diff_hunk:\n+        ln.append(\"```diff\")\n+        hunk_lines = diff_hunk.strip().splitlines()\n+        # Keep last 12 lines for context\n+        if len(hunk_lines) > 12:\n+            ln.append(\"  ...\")\n+            hunk_lines = hunk_lines[-12:]\n+        for hl in hunk_lines:\n+            ln.append(hl)\n+        ln.append(\"```\")\n+        ln.append(\"\")\n+    for c in comments:\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        date = c.get(\"createdAt\", \"\")[:10]\n+        body = (c.get(\"body\") or \"\").strip()\n+        ln.append(f\"> **@{author}** ({date}):\")\n+        ln.append(\">\")\n+        for bl in body.splitlines():\n+            ln.append(f\"> {bl}\")\n+        ln.append(\"\")\n+    return ln\n+\n+\n+def _load_review_threads(pr_dir):\n+    \"\"\"Load review threads from GraphQL data.\"\"\"\n+    path = os.path.join(pr_dir, \"review_threads.json\")\n+    if not os.path.exists(path):\n+        return []\n+    with open(path) as f:\n+        data = json.load(f)\n+    try:\n+        return (\n+            data[\"data\"][\"repository\"]\n+            [\"pullRequest\"][\"reviewThreads\"][\"nodes\"]\n+        )\n+    except (KeyError, TypeError):\n+        return []\n+\n+\n+def _reviewer_table(meta):\n+    \"\"\"Build deduplicated reviewer list with latest state.\"\"\"\n+    pr_author = meta[\"author\"][\"login\"]\n+    reviewers = {}\n+    # Submitted reviews (last state wins)\n+    for r in meta.get(\"reviews\", []):\n+        login = r.get(\"author\", {}).get(\"login\", \"?\")\n+        if login == pr_author:\n+            continue\n+        state = r.get(\"state\", \"COMMENTED\")\n+        reviewers[login] = state\n+    # Pending review requests (only if no review yet)\n+    for rr in meta.get(\"reviewRequests\", []):\n+        login = rr.get(\"login\", \"\")\n+        if not login:\n+            # Team review request\n+            login = rr.get(\"name\", \"?\")\n+        if login and login not in reviewers:\n+            reviewers[login] = \"PENDING\"\n+    return reviewers\n+\n+\n+def _ci_summary(meta):\n+    \"\"\"Summarise CI status from statusCheckRollup.\"\"\"\n+    checks = meta.get(\"statusCheckRollup\", [])\n+    if not checks:\n+        return \"—\"\n+    states = {}\n+    for c in checks:\n+        # gh CLI normalises to __typename/state/status\n+        s = (\n+            c.get(\"conclusion\")\n+            or c.get(\"state\")\n+            or c.get(\"status\")\n+            or \"PENDING\"\n+        ).upper()\n+        states[s] = states.get(s, 0) + 1\n+    parts = []\n+    for s in [\"SUCCESS\", \"FAILURE\", \"ERROR\", \"PENDING\",\n+              \"NEUTRAL\", \"SKIPPED\"]:\n+        if s in states:\n+            icon = _CI_ICON.get(s, \"\")\n+            parts.append(f\"{icon} {s}: {states[s]}\")\n+    return \", \".join(parts) if parts else \"—\"\n+\n+\n+def status(pr_number: str):\n+    # Always fetch the latest PR data before report\n+    fetch(pr_number)\n+\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+\n+    with open(meta_path) as f:\n+        meta = json.load(f)\n+\n+    pr_author = meta[\"author\"][\"login\"]\n+    pr_title = meta.get(\"title\", \"\")\n+    pr_url = meta.get(\"url\", \"\")\n+    pr_state = meta.get(\"state\", \"?\")\n+    pr_created = meta.get(\"createdAt\", \"\")[:10]\n+    pr_updated = meta.get(\"updatedAt\", \"\")[:10]\n+    merge_state = meta.get(\"mergeStateStatus\", \"—\")\n+    review_decision = meta.get(\"reviewDecision\", \"—\")\n+    state_icon = _STATE_ICON.get(pr_state, \"\")\n+    ci_text = _ci_summary(meta)\n+\n+    # --- Load data ---\n+    all_threads = _load_review_threads(pr_dir)\n+    diff_hunks = _load_diff_hunks(pr_dir)\n+    resolved_threads = [\n+        t for t in all_threads if t.get(\"isResolved\")\n+    ]\n+    unresolved_threads = [\n+        t for t in all_threads\n+        if not t.get(\"isResolved\")\n+    ]\n+\n+    # --- Unresolved → unreplied code threads ---\n+    code_threads = []\n+    for t in unresolved_threads:\n+        comments = (\n+            t.get(\"comments\", {}).get(\"nodes\", [])\n+        )\n+        if not comments:\n+            continue\n+        humans = [\n+            c for c in comments\n+            if not _is_bot(\n+                c.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+        ]\n+        if not humans:\n+            continue\n+        last = comments[-1]\n+        last_author = (\n+            last.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if last_author == pr_author:\n+            continue","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"df59d93a7ecdf2f706e69152f32000604878d4da","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Use the last human comment when deciding “awaiting reply.”**\n\nRight now the last comment can be a bot, which creates false action items and incorrect `last_author`.\n\n<details>\n<summary>✅ Suggested fix</summary>\n\n```diff\n-        last = comments[-1]\n-        last_author = (\n-            last.get(\"author\", {}).get(\"login\", \"\")\n-        )\n+        last_human = humans[-1]\n+        last_author = (\n+            last_human.get(\"author\", {}).get(\"login\", \"\")\n+        )\n         if last_author == pr_author:\n             continue\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@skills/scripts/pr.py` around lines 488 - 509, The code selects the raw last\ncomment (variable last) which can be a bot, causing incorrect awaiting-reply\ndetection; instead, after filtering human comments into humans (using _is_bot),\nuse the last human comment (e.g., humans[-1]) to derive last_author and the\nawaiting-reply check against pr_author; ensure you continue/skip when humans is\nempty and replace usages of last/last_author with the last human comment\nreference in the code_threads/unresolved_threads handling.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-11T17:10:19Z","updated_at":"2026-02-11T17:10:20Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794478132","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794478132"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794478132"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794478132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":532,"original_start_line":488,"start_side":"RIGHT","line":553,"original_line":509,"side":"RIGHT","author_association":"NONE","original_position":509,"position":553,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794508400","pull_request_review_id":3786177893,"id":2794508400,"node_id":"PRRC_kwDOQ7VXwc6mkNBw","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"df59d93a7ecdf2f706e69152f32000604878d4da","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Fallback root detection can overshoot the repo.**\n\nIf `git` isn’t available, the hardcoded 4-level climb (Lines 29–35) assumes the script lives under `.cypilot/skills/scripts/`. In this repo it’s under `skills/scripts/`, so the fallback resolves one directory above the repo. Consider walking up until `.git` or `.cypilot/.cypilot-config.json` is found.  \n\n\n<details>\n<summary>🔧 Example fix</summary>\n\n```diff\n-    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n-    return os.path.dirname(\n-        os.path.dirname(\n-            os.path.dirname(\n-                os.path.dirname(os.path.abspath(__file__))\n-            )\n-        )\n-    )\n+    # Fallback: walk up to find repo markers\n+    here = os.path.abspath(__file__)\n+    for _ in range(6):\n+        here = os.path.dirname(here)\n+        if os.path.isdir(os.path.join(here, \".git\")):\n+            return here\n+        if os.path.exists(os.path.join(here, \".cypilot\", \".cypilot-config.json\")):\n+            return here\n+    return os.path.dirname(os.path.abspath(__file__))\n```\n</details>\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 Ruff (0.15.0)</summary>\n\n[error] 22-22: Starting a process with a partial executable path\n\n(S607)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nIn `@skills/scripts/pr.py` around lines 18 - 36, The fallback in\n_find_project_root currently climbs a fixed number of parent directories which\ncan overshoot; change the fallback to iteratively walk up parent directories\nfrom os.path.abspath(__file__) until you find a repository marker (a .git\ndirectory or .cypilot/.cypilot-config.json) or reach the filesystem root,\nreturning that directory if found, otherwise return the original top-most\ncandidate; update only the fallback path logic inside _find_project_root and\nkeep the git-based branch intact.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:eagle -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @Artifizer\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-02-11T17:17:07Z","updated_at":"2026-02-11T18:14:53Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794508400","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794508400"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/64#discussion_r2794508400"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794508400/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":18,"original_start_line":18,"start_side":"RIGHT","line":52,"original_line":36,"side":"RIGHT","author_association":"NONE","original_position":36,"position":52,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2794508410","pull_request_review_id":3786177893,"id":2794508410,"node_id":"PRRC_kwDOQ7VXwc6mkNB6","diff_hunk":"@@ -0,0 +1,940 @@\n+#!/usr/bin/env python3\n+\"\"\"PR review helper – fetch PR diffs, metadata, and generate status reports.\n+\n+Cypilot skill: lives in .cypilot/skills/scripts/pr.py\n+Resolves all paths relative to the project root (detected via git).\n+\n+All review is done in read-only mode: the script downloads diffs and\n+metadata from GitHub but never modifies the local working tree.\n+\"\"\"\n+\n+import json\n+import os\n+import re\n+import subprocess\n+import sys\n+\n+\n+def _find_project_root():\n+    \"\"\"Find project root via git rev-parse.\"\"\"\n+    try:\n+        result = subprocess.run(\n+            [\"git\", \"rev-parse\", \"--show-toplevel\"],\n+            capture_output=True, text=True,\n+        )\n+        if result.returncode == 0:\n+            return result.stdout.strip()\n+    except FileNotFoundError:\n+        pass\n+    # Fallback: three levels up from this script (.cypilot/skills/scripts/)\n+    return os.path.dirname(\n+        os.path.dirname(\n+            os.path.dirname(\n+                os.path.dirname(os.path.abspath(__file__))\n+            )\n+        )\n+    )\n+\n+\n+ROOT = _find_project_root()\n+\n+# Resolve adapter path from cypilot core config, then load PR config\n+_CYPILOT_CONFIG_PATH = os.path.join(\n+    ROOT, \".cypilot\", \".cypilot-config.json\",\n+)\n+\n+\n+def _load_pr_config():\n+    \"\"\"Load PR review config from adapter's pr-review.json.\n+\n+    Resolution order:\n+    1. {project_root}/{cypilotAdapterPath}/pr-review.json\n+    2. {project_root}/.cypilot-adapter/pr-review.json (default)\n+    \"\"\"\n+    adapter_path = \".cypilot-adapter\"\n+    if os.path.exists(_CYPILOT_CONFIG_PATH):\n+        with open(_CYPILOT_CONFIG_PATH) as f:\n+            core = json.load(f)\n+        adapter_path = core.get(\n+            \"cypilotAdapterPath\", adapter_path,\n+        )\n+    pr_cfg_path = os.path.join(\n+        ROOT, adapter_path, \"pr-review.json\",\n+    )\n+    if not os.path.exists(pr_cfg_path):\n+        return {}\n+    with open(pr_cfg_path) as f:\n+        return json.load(f)\n+\n+\n+_PR_CFG = _load_pr_config()\n+\n+# PR data directory (default .prs/, overridable in pr-review.json)\n+PRS_DIR = os.path.join(\n+    ROOT, _PR_CFG.get(\"dataDir\", \".prs\"),\n+)\n+TEMPLATES_DIR = os.path.join(\n+    ROOT,\n+    _PR_CFG.get(\n+        \"templatesDir\", \".cypilot/templates/pr\",\n+    ),\n+)\n+# Local config path (exclude list, etc.)\n+CONFIG_PATH = os.path.join(ROOT, \".prs\", \"config.yaml\")\n+\n+\n+def _run(cmd, **kwargs):\n+    result = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kwargs)\n+    if result.returncode != 0 and kwargs.get(\"check\", False):\n+        print(result.stderr, file=sys.stderr)\n+        sys.exit(result.returncode)\n+    return result\n+\n+\n+def _load_exclude_list():\n+    \"\"\"Load exclude_prs list from .prs/config.yaml.\n+\n+    Parses lines under `exclude_prs:` that start with `- `.\n+    Returns a set of PR number strings.\n+    \"\"\"\n+    excludes = set()\n+    if not os.path.exists(CONFIG_PATH):\n+        return excludes\n+    in_section = False\n+    with open(CONFIG_PATH) as f:\n+        for line in f:\n+            stripped = line.strip()\n+            if stripped == \"exclude_prs:\":\n+                in_section = True\n+                continue\n+            if in_section:\n+                if stripped.startswith(\"- \"):\n+                    val = stripped[2:].strip().strip('\"').strip(\"'\")\n+                    if val:\n+                        excludes.add(val)\n+                elif stripped and not stripped.startswith(\"#\"):\n+                    in_section = False\n+    return excludes\n+\n+\n+def _list_open_prs():\n+    \"\"\"Return list of open PR numbers via gh CLI.\"\"\"\n+    result = _run([\n+        \"gh\", \"pr\", \"list\",\n+        \"--json\", \"number,title,author,state,url\",\n+        \"--limit\", \"100\",\n+    ])\n+    if result.returncode != 0:\n+        print(\n+            f\"Failed to list PRs: {result.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+    return json.loads(result.stdout)\n+\n+\n+def _owner_repo():\n+    \"\"\"Return (owner, repo) from gh CLI.\"\"\"\n+    r = _run([\n+        \"gh\", \"repo\", \"view\",\n+        \"--json\", \"nameWithOwner\",\n+        \"-q\", \".nameWithOwner\",\n+    ])\n+    if r.returncode != 0:\n+        return None, None\n+    parts = r.stdout.strip().split(\"/\", 1)\n+    return (parts[0], parts[1]) if len(parts) == 2 else (None, None)\n+\n+\n+_META_FIELDS = \",\".join([\n+    \"title\", \"body\", \"files\", \"comments\",\n+    \"reviews\", \"labels\", \"author\", \"state\",\n+    \"baseRefName\", \"headRefName\",\n+    \"url\", \"createdAt\", \"updatedAt\",\n+    \"reviewRequests\", \"statusCheckRollup\",\n+    \"mergeStateStatus\", \"reviewDecision\",\n+])\n+\n+_REVIEW_THREADS_QUERY = (\n+    \"query($owner:String!,$repo:String!,$n:Int!){\"\n+    \"repository(owner:$owner,name:$repo){\"\n+    \"pullRequest(number:$n){\"\n+    \"reviewThreads(first:100){nodes{\"\n+    \"id isResolved isOutdated path line startLine \"\n+    \"comments(first:50){nodes{\"\n+    \"id author{login}body createdAt url\"\n+    \"}}}}\"\n+    \"}}}\"\n+)\n+\n+\n+def fetch(pr_number: str):\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    os.makedirs(pr_dir, exist_ok=True)\n+\n+    # 1. PR metadata (expanded fields)\n+    meta = _run([\n+        \"gh\", \"pr\", \"view\", pr_number,\n+        \"--json\", _META_FIELDS,\n+    ])\n+    if meta.returncode != 0:\n+        print(\n+            f\"Failed to fetch PR #{pr_number}: \"\n+            f\"{meta.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+    with open(meta_path, \"w\") as f:\n+        json.dump(\n+            json.loads(meta.stdout), f,\n+            indent=2, ensure_ascii=False,\n+        )\n+        f.write(\"\\n\")\n+    print(\n+        f\"  Saved metadata → \"\n+        f\"{os.path.relpath(meta_path, ROOT)}\"\n+    )\n+\n+    # 2. Diff\n+    diff = _run([\"gh\", \"pr\", \"diff\", pr_number])\n+    if diff.returncode != 0:\n+        print(\n+            f\"Failed to fetch diff for PR \"\n+            f\"#{pr_number}: {diff.stderr}\",\n+            file=sys.stderr,\n+        )\n+        sys.exit(1)\n+\n+    diff_path = os.path.join(pr_dir, \"diff.patch\")\n+    with open(diff_path, \"w\") as f:\n+        f.write(diff.stdout)\n+    print(\n+        f\"  Saved diff → \"\n+        f\"{os.path.relpath(diff_path, ROOT)}\"\n+    )\n+\n+    # 3. Review comments (REST — keeps diff_hunk etc.)\n+    comments = _run([\n+        \"gh\", \"api\",\n+        f\"repos/{{owner}}/{{repo}}/pulls/\"\n+        f\"{pr_number}/comments\",\n+        \"--paginate\",\n+    ])\n+    if comments.returncode == 0:\n+        rc_path = os.path.join(\n+            pr_dir, \"review_comments.json\"\n+        )\n+        with open(rc_path, \"w\") as f:\n+            json.dump(\n+                json.loads(comments.stdout), f,\n+                indent=2, ensure_ascii=False,\n+            )\n+            f.write(\"\\n\")\n+        print(\n+            f\"  Saved review comments → \"\n+            f\"{os.path.relpath(rc_path, ROOT)}\"\n+        )\n+\n+    # 4. Review threads via GraphQL (isResolved)\n+    owner, repo = _owner_repo()\n+    if owner and repo:\n+        threads = _run([\n+            \"gh\", \"api\", \"graphql\",\n+            \"-f\", f\"query={_REVIEW_THREADS_QUERY}\",\n+            \"-F\", f\"n={pr_number}\",\n+            \"-f\", f\"owner={owner}\",\n+            \"-f\", f\"repo={repo}\",\n+        ])\n+        if threads.returncode == 0:\n+            threads_path = os.path.join(\n+                pr_dir, \"review_threads.json\"\n+            )\n+            with open(threads_path, \"w\") as f:\n+                json.dump(\n+                    json.loads(threads.stdout), f,\n+                    indent=2, ensure_ascii=False,\n+                )\n+                f.write(\"\\n\")\n+            print(\n+                f\"  Saved review threads → \"\n+                f\"{os.path.relpath(threads_path, ROOT)}\"\n+            )\n+\n+    print(f\"  ✓ PR #{pr_number} fetched\")\n+\n+\n+BOTS = {\n+    \"coderabbitai\", \"coderabbitai[bot]\",\n+    \"qodo-code-review\", \"qodo-code-review[bot]\",\n+    \"github-actions\", \"github-actions[bot]\",\n+    \"github-advanced-security\", \"github-advanced-security[bot]\",\n+    \"dependabot\", \"dependabot[bot]\",\n+    \"renovate\", \"renovate[bot]\",\n+}\n+\n+\n+def _is_bot(login: str) -> bool:\n+    return login in BOTS or login.endswith(\"[bot]\")\n+\n+\n+def _quote(text: str) -> str:\n+    lines = (text or \"\").strip().splitlines()\n+    return \"\\n\".join(\"> \" + ln for ln in lines) if lines else \"> (empty)\"\n+\n+\n+_STATE_ICON = {\n+    \"OPEN\": \"🟢\", \"CLOSED\": \"🔴\", \"MERGED\": \"🟣\",\n+}\n+_REVIEW_ICON = {\n+    \"APPROVED\": \"✅\",\n+    \"CHANGES_REQUESTED\": \"❌\",\n+    \"COMMENTED\": \"💬\",\n+    \"DISMISSED\": \"👀\",\n+    \"PENDING\": \"⏳\",\n+}\n+_CI_ICON = {\n+    \"SUCCESS\": \"✅\", \"FAILURE\": \"❌\",\n+    \"PENDING\": \"⏳\", \"ERROR\": \"⚠️\",\n+}\n+\n+\n+def _load_diff_hunks(pr_dir):\n+    \"\"\"Build url → diff_hunk lookup from REST data.\"\"\"\n+    rc_path = os.path.join(\n+        pr_dir, \"review_comments.json\"\n+    )\n+    if not os.path.exists(rc_path):\n+        return {}\n+    with open(rc_path) as f:\n+        comments = json.loads(f.read())\n+    hunks = {}\n+    for c in comments:\n+        url = c.get(\"html_url\", \"\")\n+        hunk = c.get(\"diff_hunk\", \"\")\n+        if url and hunk:\n+            hunks[url] = hunk\n+    return hunks\n+\n+\n+def _has_quote_match(original_body, reply_body):\n+    \"\"\"Check if reply quotes text from the original.\"\"\"\n+    quoted = []\n+    for line in reply_body.splitlines():\n+        s = line.strip()\n+        if s.startswith(\">\"):\n+            txt = s.lstrip(\">\").strip()\n+            if txt and not txt.startswith(\"@\"):\n+                quoted.append(txt.lower())\n+    if not quoted:\n+        return False\n+    orig_lower = original_body.lower()\n+    return any(q in orig_lower for q in quoted)\n+\n+\n+def _detect_pr_replies(comments, pr_author):\n+    \"\"\"Return set of comment URLs that the author replied to.\"\"\"\n+    replied = set()\n+    human = [\n+        c for c in comments\n+        if not _is_bot(\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+    ]\n+    for i, c in enumerate(human):\n+        c_author = (\n+            c.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if c_author == pr_author:\n+            continue\n+        c_body = c.get(\"body\") or \"\"\n+        c_url = c.get(\"url\", \"\")\n+        # Check subsequent author comments for quote\n+        for j in range(i + 1, len(human)):\n+            r = human[j]\n+            r_author = (\n+                r.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+            if r_author != pr_author:\n+                continue\n+            r_body = r.get(\"body\") or \"\"\n+            if _has_quote_match(c_body, r_body):\n+                replied.add(c_url)\n+                break\n+    return replied\n+\n+\n+def _format_conversation(comments, diff_hunk=\"\"):\n+    \"\"\"Format a thread as a chat with optional code.\"\"\"\n+    ln = []\n+    if diff_hunk:\n+        ln.append(\"```diff\")\n+        hunk_lines = diff_hunk.strip().splitlines()\n+        # Keep last 12 lines for context\n+        if len(hunk_lines) > 12:\n+            ln.append(\"  ...\")\n+            hunk_lines = hunk_lines[-12:]\n+        for hl in hunk_lines:\n+            ln.append(hl)\n+        ln.append(\"```\")\n+        ln.append(\"\")\n+    for c in comments:\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        date = c.get(\"createdAt\", \"\")[:10]\n+        body = (c.get(\"body\") or \"\").strip()\n+        ln.append(f\"> **@{author}** ({date}):\")\n+        ln.append(\">\")\n+        for bl in body.splitlines():\n+            ln.append(f\"> {bl}\")\n+        ln.append(\"\")\n+    return ln\n+\n+\n+def _load_review_threads(pr_dir):\n+    \"\"\"Load review threads from GraphQL data.\"\"\"\n+    path = os.path.join(pr_dir, \"review_threads.json\")\n+    if not os.path.exists(path):\n+        return []\n+    with open(path) as f:\n+        data = json.load(f)\n+    try:\n+        return (\n+            data[\"data\"][\"repository\"]\n+            [\"pullRequest\"][\"reviewThreads\"][\"nodes\"]\n+        )\n+    except (KeyError, TypeError):\n+        return []\n+\n+\n+def _reviewer_table(meta):\n+    \"\"\"Build deduplicated reviewer list with latest state.\"\"\"\n+    pr_author = meta[\"author\"][\"login\"]\n+    reviewers = {}\n+    # Submitted reviews (last state wins)\n+    for r in meta.get(\"reviews\", []):\n+        login = r.get(\"author\", {}).get(\"login\", \"?\")\n+        if login == pr_author:\n+            continue\n+        state = r.get(\"state\", \"COMMENTED\")\n+        reviewers[login] = state\n+    # Pending review requests (only if no review yet)\n+    for rr in meta.get(\"reviewRequests\", []):\n+        login = rr.get(\"login\", \"\")\n+        if not login:\n+            # Team review request\n+            login = rr.get(\"name\", \"?\")\n+        if login and login not in reviewers:\n+            reviewers[login] = \"PENDING\"\n+    return reviewers\n+\n+\n+def _ci_summary(meta):\n+    \"\"\"Summarise CI status from statusCheckRollup.\"\"\"\n+    checks = meta.get(\"statusCheckRollup\", [])\n+    if not checks:\n+        return \"—\"\n+    states = {}\n+    for c in checks:\n+        # gh CLI normalises to __typename/state/status\n+        s = (\n+            c.get(\"conclusion\")\n+            or c.get(\"state\")\n+            or c.get(\"status\")\n+            or \"PENDING\"\n+        ).upper()\n+        states[s] = states.get(s, 0) + 1\n+    parts = []\n+    for s in [\"SUCCESS\", \"FAILURE\", \"ERROR\", \"PENDING\",\n+              \"NEUTRAL\", \"SKIPPED\"]:\n+        if s in states:\n+            icon = _CI_ICON.get(s, \"\")\n+            parts.append(f\"{icon} {s}: {states[s]}\")\n+    return \", \".join(parts) if parts else \"—\"\n+\n+\n+def status(pr_number: str):\n+    # Always fetch the latest PR data before report\n+    fetch(pr_number)\n+\n+    pr_dir = os.path.join(PRS_DIR, pr_number)\n+    meta_path = os.path.join(pr_dir, \"meta.json\")\n+\n+    with open(meta_path) as f:\n+        meta = json.load(f)\n+\n+    pr_author = meta[\"author\"][\"login\"]\n+    pr_title = meta.get(\"title\", \"\")\n+    pr_url = meta.get(\"url\", \"\")\n+    pr_state = meta.get(\"state\", \"?\")\n+    pr_created = meta.get(\"createdAt\", \"\")[:10]\n+    pr_updated = meta.get(\"updatedAt\", \"\")[:10]\n+    merge_state = meta.get(\"mergeStateStatus\", \"—\")\n+    review_decision = meta.get(\"reviewDecision\", \"—\")\n+    state_icon = _STATE_ICON.get(pr_state, \"\")\n+    ci_text = _ci_summary(meta)\n+\n+    # --- Load data ---\n+    all_threads = _load_review_threads(pr_dir)\n+    diff_hunks = _load_diff_hunks(pr_dir)\n+    resolved_threads = [\n+        t for t in all_threads if t.get(\"isResolved\")\n+    ]\n+    unresolved_threads = [\n+        t for t in all_threads\n+        if not t.get(\"isResolved\")\n+    ]\n+\n+    # --- Unresolved → unreplied code threads ---\n+    code_threads = []\n+    for t in unresolved_threads:\n+        comments = (\n+            t.get(\"comments\", {}).get(\"nodes\", [])\n+        )\n+        if not comments:\n+            continue\n+        humans = [\n+            c for c in comments\n+            if not _is_bot(\n+                c.get(\"author\", {}).get(\"login\", \"\")\n+            )\n+        ]\n+        if not humans:\n+            continue\n+        last = comments[-1]\n+        last_author = (\n+            last.get(\"author\", {}).get(\"login\", \"\")\n+        )\n+        if last_author == pr_author:\n+            continue\n+        first = comments[0]\n+        participants = list(dict.fromkeys(\n+            c.get(\"author\", {}).get(\"login\", \"?\")\n+            for c in comments\n+        ))\n+        code_threads.append({\n+            \"path\": t.get(\"path\", \"?\"),\n+            \"line\": (\n+                t.get(\"line\")\n+                or t.get(\"startLine\")\n+                or \"?\"\n+            ),\n+            \"url\": first.get(\"url\", \"\"),\n+            \"last_author\": last_author,\n+            \"participants\": participants,\n+            \"comments\": comments,\n+        })\n+\n+    # --- PR-level comments: split unreplied vs replied ---\n+    replied_urls = _detect_pr_replies(\n+        meta.get(\"comments\", []), pr_author\n+    )\n+    pr_unreplied = []\n+    pr_replied = []\n+    for c in meta.get(\"comments\", []):\n+        author = c.get(\"author\", {}).get(\"login\", \"?\")\n+        if _is_bot(author) or author == pr_author:\n+            continue\n+        entry = {\n+            \"url\": c.get(\"url\", \"\"),\n+            \"author\": author,\n+            \"date\": c.get(\"createdAt\", \"\")[:10],\n+            \"body\": c.get(\"body\", \"\"),\n+        }\n+        if entry[\"url\"] in replied_urls:\n+            pr_replied.append(entry)\n+        else:\n+            pr_unreplied.append(entry)\n+\n+    # --- Reviewers ---\n+    reviewers = _reviewer_table(meta)\n+\n+    # --- Counts for summary table ---\n+    n_code_unresolved = len(code_threads)\n+    n_code_resolved = len(resolved_threads)\n+    n_pr_unreplied = len(pr_unreplied)\n+    n_pr_replied = len(pr_replied)\n+\n+    # ===== Build report =====\n+    ln = []\n+\n+    # ── Header ──\n+    ln.append(f\"# PR #{pr_number}: {pr_title}\")\n+    ln.append(\"\")\n+    ln.append(\"| Field | Value |\")\n+    ln.append(\"|---|---|\")\n+    ln.append(f\"| **URL** | {pr_url} |\")\n+    ln.append(f\"| **Author** | @{pr_author} |\")\n+    ln.append(\n+        f\"| **State** | {state_icon} {pr_state} |\"\n+    )\n+    ln.append(f\"| **Created** | {pr_created} |\")\n+    ln.append(f\"| **Updated** | {pr_updated} |\")\n+    ln.append(f\"| **CI Status** | {ci_text} |\")\n+    ln.append(\n+        f\"| **Merge Status** | {merge_state} |\"\n+    )\n+    ln.append(\n+        f\"| **Review Decision** | {review_decision} |\"\n+    )\n+    ln.append(\n+        f\"| **Code comments** \"\n+        f\"| {n_code_unresolved} unresolved / \"\n+        f\"{n_code_resolved} resolved / \"\n+        f\"0 suspicious |\"\n+    )","path":"skills/scripts/pr.py","commit_id":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","original_commit_id":"df59d93a7ecdf2f706e69152f32000604878d4da","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.
mmary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/skills/cypilot/scripts/cypilot/commands/where_used.py at\nline 19, The variable binding for the context returned by\nresolve_target_and_artifacts is unused; rename the ctx variable to a throwaway\nname (e.g., _ctx or _) in the assignment target_id, ctx, artifacts_to_scan,\npath_to_source, err = resolve_target_and_artifacts(args) so linters stop\nflagging the unused binding; update that exact assignment expression to use the\nchosen underscore name and keep the other bindings unchanged.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 90abdc1","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-10T11:34:47Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856862","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856862"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856862"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":19,"side":"RIGHT","author_association":"NONE","original_position":21,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856885","pull_request_review_id":3918127689,"id":2907856885,"node_id":"PRRC_kwDOQ7VXwc6tUl_1","diff_hunk":"@@ -0,0 +1,192 @@\n+\"\"\"\n+workspace-add: Add a source to workspace config (standalone or inline).\n+\"\"\"\n+# @cpt-algo:cpt-cypilot-feature-workspace:p1\n+\n+import argparse\n+import json\n+from pathlib import Path\n+from typing import List\n+\n+\n+from ..utils.workspace import WorkspaceConfig, _json_error\n+\n+\n+def _add_to_standalone(args: argparse.Namespace, ws_cfg: WorkspaceConfig) -> int:\n+    \"\"\"Add source to an existing standalone .cypilot-workspace.toml.\"\"\"\n+    # @cpt-begin:cpt-cypilot-flow-workspace-add:p1:inst-add-source\n+    replaced = args.name in ws_cfg.sources\n+    ws_cfg.add_source(args.name, args.path, role=args.role, adapter=args.adapter, url=args.url, branch=args.branch)\n+    # @cpt-end:cpt-cypilot-flow-workspace-add:p1:inst-add-source\n+    # @cpt-begin:cpt-cypilot-flow-workspace-add:p1:inst-add-save\n+    # @cpt-begin:cpt-cypilot-state-workspace-config-lifecycle:p1:inst-config-update-standalone\n+    save_err = ws_cfg.save()\n+    if save_err:\n+        print(_json_error(save_err))\n+        return 1\n+    # @cpt-end:cpt-cypilot-state-workspace-config-lifecycle:p1:inst-config-update-standalone\n+    # @cpt-end:cpt-cypilot-flow-workspace-add:p1:inst-add-save\n+\n+    # @cpt-begin:cpt-cypilot-flow-workspace-add:p1:inst-add-return-ok\n+    source_info: dict = {\n+        \"name\": args.name,\n+        \"path\": args.path,\n+        \"role\": args.role,\n+        \"adapter\": args.adapter,\n+    }\n+    if args.url:\n+        source_info[\"url\"] = args.url\n+    if args.branch:\n+        source_info[\"branch\"] = args.branch\n+    verb = \"updated in\" if replaced else \"added to\"\n+    result: dict = {\n+        \"status\": \"ADDED\",\n+        \"message\": f\"Source '{args.name}' {verb} workspace\",\n+        \"config_path\": str(ws_cfg.workspace_file),\n+        \"source\": source_info,\n+    }\n+    if replaced:\n+        result[\"replaced\"] = True\n+    print(json.dumps(result, indent=2, ensure_ascii=False))\n+    return 0\n+    # @cpt-end:cpt-cypilot-flow-workspace-add:p1:inst-add-return-ok\n+\n+\n+# @cpt-begin:cpt-cypilot-state-workspace-config-lifecycle:p1:inst-config-update-inline\n+def _add_to_inline(args: argparse.Namespace, project_root: Path) -> int:\n+    \"\"\"Add source inline to the current repo's config/core.toml.\"\"\"\n+    # @cpt-end:cpt-cypilot-state-workspace-config-lifecycle:p1:inst-config-update-inline\n+    from ..utils.workspace import _load_inline_config\n+    from ..utils import toml_utils\n+\n+    config_path, existing, err = _load_inline_config(project_root)\n+    if err:\n+        print(_json_error(err))\n+        return 1\n+\n+    # Get or create inline workspace\n+    ws = existing.get(\"workspace\")\n+    if isinstance(ws, str):\n+        print(_json_error(\"Workspace is defined as external file reference. Run without --inline to add to standalone file.\"))\n+        return 1\n+\n+    if not isinstance(ws, dict):\n+        ws = {\"version\": \"1.0\", \"sources\": {}}\n+    if not isinstance(ws.get(\"sources\"), dict):\n+        ws[\"sources\"] = {}","path":".bootstrap/.core/skills/cypilot/scripts/cypilot/commands/workspace_add.py","commit_id":"63b1e3edbd685cedf29e15256c45fe0d61839b87","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Don't overwrite malformed `[workspace]` values during inline adds.**\n\nAny non-string, non-dict `workspace` value currently gets replaced with a fresh inline table. That hides config errors like `workspace = 42` and can discard the existing value instead of surfacing the problem.\n\n\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n     ws = existing.get(\"workspace\")\n     if isinstance(ws, str):\n         print(_json_error(\"Workspace is defined as external file reference. Run without --inline to add to standalone file.\"))\n         return 1\n \n-    if not isinstance(ws, dict):\n+    if ws is None:\n         ws = {\"version\": \"1.0\", \"sources\": {}}\n+    elif not isinstance(ws, dict):\n+        print(_json_error(\n+            f\"Malformed 'workspace' in {config_path}: expected inline table, got {type(ws).__name__}\"\n+        ))\n+        return 1\n     if not isinstance(ws.get(\"sources\"), dict):\n         ws[\"sources\"] = {}\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/skills/cypilot/scripts/cypilot/commands/workspace_add.py\naround lines 68 - 76, The code currently replaces any non-str, non-dict\nworkspace value (ws from existing.get(\"workspace\")) with a new inline dict,\nwhich hides malformed config like workspace = 42; modify the logic in\nworkspace_add.py so that if existing.get(\"workspace\") is present and not a dict\n(and not a str), you emit an error via _json_error (explaining the malformed\nworkspace) and return non-zero instead of creating a fresh\n{\"version\":\"1.0\",\"sources\":{}}; only create/initialize the inline workspace when\nno existing workspace key is present or when it is explicitly a dict.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 90abdc1","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-10T11:34:50Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856885","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856885"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856885"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856885/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":68,"start_side":"RIGHT","line":null,"original_line":76,"side":"RIGHT","author_association":"NONE","original_position":76,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856903","pull_request_review_id":3918127689,"id":2907856903,"node_id":"PRRC_kwDOQ7VXwc6tUmAH","diff_hunk":"@@ -0,0 +1,564 @@\n+# Feature: Multi-Repo Workspace Federation\n+\n+\n+<!-- toc -->\n+\n+- [1. Feature Context](#1-feature-context)\n+  - [1. Overview](#1-overview)\n+  - [2. Purpose](#2-purpose)\n+  - [3. Actors](#3-actors)\n+  - [4. References](#4-references)\n+  - [5. Non-Applicability](#5-non-applicability)\n+  - [6. Out of Scope](#6-out-of-scope)\n+- [2. Actor Flows (CDSL)](#2-actor-flows-cdsl)\n+  - [Workspace Initialization](#workspace-initialization)\n+  - [Workspace Source Management](#workspace-source-management)\n+  - [Workspace Info Display](#workspace-info-display)\n+- [3. Processes / Business Logic (CDSL)](#3-processes-business-logic-cdsl)","path":"architecture/features/workspace.md","commit_id":"34d4bd8f22245d3b7c58eb0df3c0d9895b5bb3d1","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Fix this TOC fragment.**\n\n`markdownlint` is flagging Line 17 with `MD051`, so the “Processes / Business Logic (CDSL)” entry does not resolve to its section. Regenerate the TOC or update the fragment to match the actual heading slug.\n\n<details>\n<summary>🧰 Tools</summary>\n\n<details>\n<summary>🪛 markdownlint-cli2 (0.21.0)</summary>\n\n[warning] 17-17: Link fragments should be valid\n\n(MD051, link-fragments)\n\n</details>\n\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@architecture/features/workspace.md` at line 17, The TOC entry \"[3. Processes\n/ Business Logic (CDSL)](`#3-processes-business-logic-cdsl`)\" has a mismatched\nfragment causing markdownlint MD051; update that TOC fragment to exactly match\nthe generated heading slug for the \"Processes / Business Logic (CDSL)\" heading\n(or regenerate the entire TOC) so the anchor resolves correctly—locate the TOC\nline shown and replace the fragment portion (the text inside #...) with the\nexact slug produced by the actual heading.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit 90abdc1","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-10T11:34:53Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856903","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856903"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856903"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":17,"side":"RIGHT","author_association":"NONE","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856907","pull_request_review_id":3918127689,"id":2907856907,"node_id":"PRRC_kwDOQ7VXwc6tUmAL","diff_hunk":"@@ -0,0 +1,564 @@\n+# Feature: Multi-Repo Workspace Federation\n+\n+\n+<!-- toc -->\n+\n+- [1. Feature Context](#1-feature-context)\n+  - [1. Overview](#1-overview)\n+  - [2. Purpose](#2-purpose)\n+  - [3. Actors](#3-actors)\n+  - [4. References](#4-references)\n+  - [5. Non-Applicability](#5-non-applicability)\n+  - [6. Out of Scope](#6-out-of-scope)\n+- [2. Actor Flows (CDSL)](#2-actor-flows-cdsl)\n+  - [Workspace Initialization](#workspace-initialization)\n+  - [Workspace Source Management](#workspace-source-management)\n+  - [Workspace Info Display](#workspace-info-display)\n+- [3. Processes / Business Logic (CDSL)](#3-processes-business-logic-cdsl)\n+  - [Find Workspace Config](#find-workspace-config)\n+  - [Discover Nested Repos](#discover-nested-repos)\n+  - [Resolve Source Path](#resolve-source-path)\n+  - [Infer Source Role](#infer-source-role)\n+  - [Load Workspace Context](#load-workspace-context)\n+  - [Resolve Artifact Path](#resolve-artifact-path)\n+  - [Collect Cross-Repo IDs](#collect-cross-repo-ids)\n+  - [Resolve Git URL Source](#resolve-git-url-source)\n+  - [Resolve Source Adapter Context](#resolve-source-adapter-context)\n+  - [Determine Target Source](#determine-target-source)\n+- [4. States (CDSL)](#4-states-cdsl)\n+  - [Source Reachability](#source-reachability)\n+  - [Config Lifecycle](#config-lifecycle)\n+- [5. Definitions of Done](#5-definitions-of-done)\n+  - [Workspace Initialization and Config](#workspace-initialization-and-config)\n+  - [Source Management](#source-management)\n+  - [Cross-Repo Traceability](#cross-repo-traceability)\n+  - [Graceful Degradation](#graceful-degradation)\n+  - [Backward Compatibility](#backward-compatibility)\n+  - [Git URL Source Resolution](#git-url-source-resolution)\n+  - [Cross-Repo Editing](#cross-repo-editing)\n+- [6. Implementation Modules](#6-implementation-modules)\n+- [7. Acceptance Criteria](#7-acceptance-criteria)\n+\n+<!-- /toc -->\n+\n+- [ ] `p1` - **ID**: `cpt-cypilot-featstatus-workspace`\n+\n+## 1. Feature Context\n+\n+- [ ] `p1` - `cpt-cypilot-feature-workspace`\n+\n+### 1. Overview\n+\n+Multi-repo workspace federation enabling nested sub-directory repo discovery, source configuration (standalone or inline), cross-repo artifact traceability, and graceful degradation when sources are unreachable. Projects without workspace config continue operating in single-repo mode with zero behavioral changes.\n+\n+### 2. Purpose\n+\n+Enables teams working across multiple repositories to federate their Cypilot-managed artifacts — discovering repos in nested sub-directories, resolving cross-repo artifact paths, and collecting IDs across workspace boundaries — without merging adapters or modifying individual project configs. Addresses PRD requirement for workspace federation (`cpt-cypilot-fr-core-workspace`) and extends the core traceability system (`cpt-cypilot-fr-core-traceability`) with cross-repo resolution.\n+\n+### 3. Actors\n+\n+| Actor | Role in Feature |\n+|-------|-----------------|\n+| `cpt-cypilot-actor-user` | Runs `workspace-init`, `workspace-add` (with `--inline` flag for inline mode), `workspace-info`; uses `validate --local-only` and `list-ids --source` |\n+| `cpt-cypilot-actor-cypilot-cli` | Discovers workspace config during context loading, resolves cross-repo paths, loads source contexts |\n+\n+### 4. References\n+\n+- **PRD**: [PRD.md](../PRD.md) — `cpt-cypilot-fr-core-workspace`, `cpt-cypilot-fr-core-traceability`\n+- **Design**: [DESIGN.md](../DESIGN.md) — `cpt-cypilot-component-config-manager`, `cpt-cypilot-component-traceability-engine`\n+- **CLI Spec**: [CLISPEC.md](../specs/CLISPEC.md)\n+- **Dependencies**: `cpt-cypilot-feature-core-infra`, `cpt-cypilot-feature-traceability-validation`\n+\n+### 5. Non-Applicability\n+\n+The following quality domains are not applicable to this feature:\n+\n+- **Performance**: All operations are local filesystem reads/writes on small TOML configs; no latency-sensitive or high-throughput paths\n+- **Security**: Local-path mode has no network access. Git URL sources perform `git clone`/`git fetch` via the user's existing Git CLI credentials — no custom authentication or credential handling. CLI arguments parsed by argparse with no untrusted input\n+- **Compliance**: No regulatory, privacy, or audit requirements\n+- **Usability (UI)**: CLI-only interaction with structured JSON output; no graphical UI\n+- **Operations**: No deployment, observability, or infrastructure concerns; standalone CLI commands\n+\n+### 6. Out of Scope\n+\n+- Workspace-level aggregate linting or test orchestration across sources\n+- Remote source authentication beyond Git CLI credentials\n+- Workspace-level dependency resolution between source packages\n+- Live file-watching or automatic re-discovery of sources\n+\n+## 2. Actor Flows (CDSL)\n+\n+### Workspace Initialization\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-flow-workspace-init`\n+\n+**Actors**:\n+\n+- `cpt-cypilot-actor-user`\n+- `cpt-cypilot-actor-cypilot-cli`\n+\n+**Success Scenarios**:\n+- User runs `workspace-init` → nested sub-directories scanned for repos, workspace config generated with discovered sources\n+- User runs `workspace-init --inline` → workspace config written inline into `config/core.toml`\n+- User runs `workspace-init --dry-run` → shows what would be generated without writing\n+\n+**Error Scenarios**:\n+- No project root found → error with instructions\n+- Scan root not found → error with path\n+- No repos discovered in nested sub-directories → creates empty workspace (sources: {})\n+- `--inline` with existing standalone workspace → error (prevents parallel configs)\n+- Standalone init with existing inline workspace → error (prevents parallel configs)\n+- Re-init without `--force` when workspace already exists → error suggesting `--force`\n+\n+**Steps**:\n+1. [x] - `p1` - User invokes `cypilot workspace-init [--root DIR] [--output PATH] [--inline] [--force] [--dry-run]` - `inst-user-workspace-init`\n+2. [x] - `p1` - Find project root from current directory - `inst-find-project-root`\n+3. [x] - `p1` - **IF** no project root found **RETURN** error: \"No project root found\" (exit 1) - `inst-if-no-root`\n+4. [x] - `p1` - Determine scan root: `--root` argument or project root itself - `inst-determine-scan-root`\n+5. [x] - `p1` - **IF** scan root not found **RETURN** error (exit 1) - `inst-if-no-scan-root`\n+6. [x] - `p1` - Algorithm: discover repos in nested sub-directories using `cpt-cypilot-algo-workspace-discover-nested` - `inst-discover-nested`\n+7. [x] - `p1` - Build workspace data with version and discovered sources (may be empty) - `inst-build-workspace-data`\n+8. [x] - `p1` - **IF** `--dry-run` **RETURN** DRY_RUN status with workspace preview (exit 0) - `inst-if-dry-run`\n+9. [x] - `p1` - **IF** existing workspace config found: **IF** cross-type conflict (inline vs standalone) **RETURN** error (exit 1); **IF** same type and no `--force` **RETURN** error suggesting `--force` (exit 1) - `inst-if-existing-ws`\n+10. [x] - `p1` - **IF** `--inline` write workspace inline to core.toml - `inst-if-inline`\n+11. [x] - `p1` - **ELSE** write standalone `.cypilot-workspace.toml` - `inst-else-standalone`\n+12. [x] - `p1` - **RETURN** JSON: `{status: CREATED, config_path, sources_count, sources}` (exit 0) - `inst-return-init-ok`\n+\n+### Workspace Source Management\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-flow-workspace-add`\n+\n+**Actors**:\n+\n+- `cpt-cypilot-actor-user`\n+- `cpt-cypilot-actor-cypilot-cli`\n+\n+**Success Scenarios**:\n+- User runs `workspace-add --name N --path P` → local source added to standalone workspace config\n+- User runs `workspace-add --name N --url U [--branch B]` → Git URL source added to standalone workspace config\n+- User runs `workspace-add --inline --name N --path P` → source added inline to core.toml\n+\n+**Error Scenarios**:\n+- No project root → error\n+- No workspace config found → error with init hint\n+- Git URL source with inline workspace → error (URLs not supported inline)\n+- `--inline` flag with existing standalone workspace → error (prevents parallel configs)\n+\n+**Steps**:\n+1. [x] - `p1` - User invokes `workspace-add --name N (--path P | --url U) [--branch B] [--role R] [--adapter A]` or `workspace-add --inline --name N --path P [--role R] [--adapter A]` - `inst-user-workspace-add`\n+2. [x] - `p1` - Find project root - `inst-add-find-root`\n+3. [x] - `p1` - **IF** no project root **RETURN** error (exit 1) - `inst-add-if-no-root`\n+4. [x] - `p1` - **IF** `--inline` flag set: check for existing standalone workspace; **IF** standalone exists **RETURN** error (exit 1); **ELSE** add to inline config - `inst-add-if-inline-flag`\n+5. [x] - `p1` - **ELSE** find existing workspace config using `cpt-cypilot-algo-workspace-find-config` - `inst-add-find-ws`\n+6. [x] - `p1` - **IF** no workspace config found **RETURN** error: \"Run workspace-init first\" (exit 1) - `inst-add-if-no-ws`\n+7. [x] - `p1` - **IF** existing workspace is inline, auto-route to inline add (no `--inline` flag required) - `inst-add-auto-detect-inline`\n+8. [x] - `p1` - Add source entry to config - `inst-add-source`\n+9. [x] - `p1` - Save updated config - `inst-add-save`\n+10. [x] - `p1` - **RETURN** JSON: `{status: ADDED, source}` (exit 0) - `inst-add-return-ok`\n+\n+### Workspace Info Display\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-flow-workspace-info`\n+\n+**Actors**:\n+\n+- `cpt-cypilot-actor-user`\n+- `cpt-cypilot-actor-cypilot-cli`\n+\n+**Success Scenarios**:\n+- User runs `workspace-info` → workspace config displayed with per-source reachability, artifact counts, traceability settings\n+\n+**Error Scenarios**:\n+- No project root → error\n+- No workspace config → ERROR status with hint\n+- Workspace config parse error → ERROR status\n+\n+**Steps**:\n+1. [x] - `p1` - User invokes `cypilot workspace-info` - `inst-user-workspace-info`\n+2. [x] - `p1` - Find project root - `inst-info-find-root`\n+3. [x] - `p1` - **IF** no project root **RETURN** error (exit 1) - `inst-info-if-no-root`\n+4. [x] - `p1` - Find workspace config using `cpt-cypilot-algo-workspace-find-config` - `inst-info-find-ws`\n+5. [x] - `p1` - **IF** config error **RETURN** ERROR status (exit 1) - `inst-info-if-error`\n+6. [x] - `p1` - **IF** no workspace **RETURN** ERROR status with hint (exit 1) - `inst-info-if-no-ws`\n+7. [x] - `p1` - **FOR EACH** source build status info (path, reachability, adapter, artifact counts) - `inst-info-foreach-source`\n+8. [x] - `p1` - Load workspace context if available, enrich with cross-repo stats - `inst-info-load-context`\n+9. [x] - `p1` - **RETURN** JSON: `{status: OK, version, sources, traceability}` (exit 0) - `inst-info-return-ok`\n+\n+## 3. Processes / Business Logic (CDSL)\n+\n+### Find Workspace Config\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-algo-workspace-find-config`\n+\n+**Input**: Project root path\n+\n+**Output**: `(WorkspaceConfig, None)` or `(None, error_message)` or `(None, None)` if no workspace\n+\n+**Steps**:\n+1. [x] - `p1` - Load project config from `core.toml` (via AGENTS.md cypilot_path) - `inst-find-load-project-config`\n+2. [x] - `p1` - **IF** project config not found: **IF** config file exists but failed to parse **RETURN** `(None, error)`; **ELSE** fall through to standalone auto-discovery (step 5) - `inst-find-if-no-config`\n+3. [x] - `p1` - **IF** project config has `workspace` key as string path - `inst-find-if-ws-string`\n+   1. [x] - `p1` - Resolve path relative to project root and load as standalone TOML - `inst-find-load-external`\n+   2. [x] - `p1` - **RETURN** `(WorkspaceConfig, None)` or `(None, error)` - `inst-find-return-external`\n+4. [x] - `p1` - **IF** project config has `workspace` key as dict - `inst-find-if-ws-dict`\n+   1. [x] - `p1` - Parse inline workspace config with `resolution_base` set to project root - `inst-find-parse-inline`\n+   2. [x] - `p1` - **RETURN** `(WorkspaceConfig, None)` - `inst-find-return-inline`\n+5. [x] - `p1` - **IF** `workspace` key absent or config not loaded: check for standalone `.cypilot-workspace.toml` at project root; **IF** file exists load and **RETURN** `(WorkspaceConfig, None)` or `(None, error)`; **ELSE RETURN** `(None, None)` — no workspace, single-repo mode - `inst-find-return-none`","path":"architecture/features/workspace.md","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Remove the standalone auto-discovery fallback from this feature spec.**\n\nThese sections still describe `find_workspace_config()` falling back to `.cypilot-workspace.toml` when `core.toml` has no `workspace` key. The implemented contract intentionally stays in single-repo mode unless the workspace is explicitly configured, so this doc would steer future work toward the wrong behavior.\n\n\n\nBased on learnings: `find_workspace_config()` intentionally does NOT perform implicit parent directory traversal or auto-discover standalone `.cypilot-workspace.toml` files. Workspace location MUST be explicitly configured via the `workspace` key in `core.toml`.\n\n\nAlso applies to: 409-410, 546-546\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@architecture/features/workspace.md` around lines 197 - 206, The spec\nincorrectly documents an auto-discovery fallback for find_workspace_config();\nremove the standalone `.cypilot-workspace.toml` fallback behavior from the\nfeature spec by deleting or updating the step labeled inst-find-return-none (and\nany duplicate references at lines noted like 409-410 and 546) so the doc clearly\nstates that workspace resolution only happens when the `workspace` key is\npresent in `core.toml` (either as a string or inline dict parsed by\ninst-find-parse-inline/inst-find-return-external/inst-find-return-inline) and\notherwise returns `(None, None)` to remain in single-repo mode.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:medusa:grasshopper -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-11T14:15:06Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856907","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856907"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856907"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856907/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":249,"original_start_line":197,"start_side":"RIGHT","line":258,"original_line":206,"side":"RIGHT","author_association":"NONE","original_position":206,"position":258,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856911","pull_request_review_id":3918127689,"id":2907856911,"node_id":"PRRC_kwDOQ7VXwc6tUmAP","diff_hunk":"@@ -336,6 +337,23 @@ The system MUST provide a unique ID system for all design elements using structu\n **Actors**:\n `cpt-cypilot-actor-user`, `cpt-cypilot-actor-ai-agent`, `cpt-cypilot-actor-ci-pipeline`\n \n+#### Multi-Repo Workspace Federation\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-fr-core-workspace`\n+\n+The system MUST support multi-repo workspace federation — discovering repositories in nested sub-directories, configuring sources, and enabling cross-repo artifact traceability without merging adapters. Workspace configuration MUST support two modes: standalone `.cypilot-workspace.toml` file and inline `[workspace]` section in `config/core.toml`. The system MUST discover workspace config by first checking the project's `core.toml` for a `workspace` key (string path or inline dict), then falling back to well-known standalone file `.cypilot-workspace.toml` at the project root — no implicit parent directory traversal. Each named source MUST map to a local filesystem path with optional adapter location and role (`artifacts`, `codebase`, `kits`, `full`). Source path resolution MUST be relative to the workspace file's parent directory (standalone) or project root (inline). The system MUST provide CLI commands: `workspace-init` (scan nested sub-directories for repos with `.git` or `AGENTS.md` marker, infer roles, generate config), `workspace-add` with `--inline` flag (add sources to standalone or inline config), `workspace-info` (display workspace status with per-source reachability). Cross-repo traceability MUST be controllable via `cross_repo` and `resolve_remote_ids` settings. The system MUST provide `--local-only` flag for `validate` to skip cross-repo resolution, and `--source` filter for `list-ids`. The system MUST degrade gracefully when sources are unreachable — emit warnings to stderr and continue with available sources. The system MUST be fully backward compatible — projects without workspace config operate in single-repo mode with zero behavioral changes.\n+\n+- [x] `p1` - **ID**: `cpt-cypilot-fr-core-workspace-git-sources`\n+\n+The system MUST support Git URL sources in standalone workspace configuration (`.cypilot-workspace.toml`). Each Git URL source MUST specify: a remote Git repository URL, an optional branch or ref, and namespace resolution rules that map the URL to a local working directory path (e.g., `gitlab.com/org/project.git` → `org/project`). The workspace MUST support a configurable working directory (defaulting to the current directory) under which cloned repos are resolved via namespace rules. Git URL sources MUST NOT be supported in inline workspace configuration (`config/core.toml`) — inline mode remains local-paths-only. The system MUST clone or fetch sources as needed and cache them locally. Branch configuration MUST allow workspace-level defaults and per-source overrides.","path":"architecture/PRD.md","commit_id":"b456721ad17005d5a2044968932b3bf30224e561","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Align the workspace PRD with the implemented discovery and resolve defaults.**\n\nLine 344 still specifies a fallback that auto-discovers `.cypilot-workspace.toml` at the project root, but the agreed contract for this feature is explicit configuration through `core.toml.workspace`; when that key is absent, Cypilot stays in single-repo mode. Line 348 also says the clone workdir defaults to the current directory, while the schema added in this PR defaults it to `.workspace-sources`. Please fix the PRD now so it does not become a second, conflicting source of truth. \n\n<details>\n<summary>📝 Suggested wording update</summary>\n\n```diff\n-The system MUST support multi-repo workspace federation — discovering repositories in nested sub-directories, configuring sources, and enabling cross-repo artifact traceability without merging adapters. Workspace configuration MUST support two modes: standalone `.cypilot-workspace.toml` file and inline `[workspace]` section in `config/core.toml`. The system MUST discover workspace config by first checking the project's `core.toml` for a `workspace` key (string path or inline dict), then falling back to well-known standalone file `.cypilot-workspace.toml` at the project root — no implicit parent directory traversal.\n+The system MUST support multi-repo workspace federation — discovering repositories in nested sub-directories, configuring sources, and enabling cross-repo artifact traceability without merging adapters. Workspace configuration MUST support two modes: a standalone `.cypilot-workspace.toml` file referenced from `config/core.toml`, and an inline `[workspace]` section in `config/core.toml`. The system MUST discover workspace config from the project's `core.toml` `workspace` key (string path or inline dict). When that key is absent, Cypilot remains in single-repo mode — there is no implicit standalone-file discovery or parent-directory traversal.\n@@\n-The workspace MUST support a configurable working directory (defaulting to the current directory) under which cloned repos are resolved via namespace rules.\n+The workspace MUST support a configurable working directory (default: `.workspace-sources`) under which cloned repos are resolved via namespace rules.\n```\n</details>\n\nBased on learnings, `find_workspace_config()` intentionally requires an explicit `workspace` entry in `core.toml`; standalone `.cypilot-workspace.toml` files must not be auto-discovered.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@architecture/PRD.md` around lines 344 - 348, Update the PRD to match the\nimplemented contract: remove the statement that the system falls back to\nauto-discovering a standalone .cypilot-workspace.toml at the project root and\ninstead state that workspace discovery requires an explicit workspace entry in\ncore.toml (i.e., core.toml.workspace) and that absence of that key keeps the\nproject in single-repo mode; also change the wording that the Git clone working\ndirectory defaults to the repository-local .workspace-sources (not the current\ndirectory) and note that standalone workspace files are only used when\nexplicitly referenced (per find_workspace_config()) and that inline workspace\nconfig (config/core.toml) does not support Git URL sources.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated reply by CodeRabbit -->\n\n✅ Confirmed as addressed by @nonameffh\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-11T14:29:09Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856911","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856911"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856911"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856911/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":344,"start_side":"RIGHT","line":null,"original_line":348,"side":"RIGHT","author_association":"NONE","original_position":20,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856912","pull_request_review_id":3918127689,"id":2907856912,"node_id":"PRRC_kwDOQ7VXwc6tUmAQ","diff_hunk":"@@ -267,6 +265,65 @@ Users can customize blueprints in `config/kits/{slug}/blueprints/`. Running `cpt\n \n ---\n \n+## Multi-Repo Workspaces\n+\n+Cypilot supports **multi-repo workspaces** — a federation layer that lets you work across multiple repositories while maintaining cross-repo traceability. Each repo keeps its own independent adapter; the workspace provides a map of named sources.\n+\n+**Use cases:**\n+- PRDs in a docs repo, design in another repo, code in yet another\n+- Shared kit packages in a separate repo\n+- Working from one repo while referencing artifacts in others\n+\n+### Quick Setup\n+\n+```bash\n+# Option A: Auto-discover nested repos and generate workspace\n+python3 cypilot/.core/skills/cypilot/scripts/cypilot.py workspace-init\n+\n+# Option B: Add sources individually\n+python3 cypilot/.core/skills/cypilot/scripts/cypilot.py workspace-add --name docs --path ../docs-repo --role artifacts\n+python3 cypilot/.core/skills/cypilot/scripts/cypilot.py workspace-add --name shared-kits --path ../shared-kits --role kits\n+\n+# Option C: Define workspace inline in your repo's config\n+python3 cypilot/.core/skills/cypilot/scripts/cypilot.py workspace-add --inline --name docs --path ../docs-repo\n+```\n+\n+### How It Works\n+\n+The **current working directory** always determines the primary repo. Other repos contribute artifacts, code, and kits for cross-referencing. No adapter merging — each repo owns its configuration.\n+\n+**Workspace config** can be:\n+- A standalone `.cypilot-workspace.toml` file at a super-root directory\n+- Inline in any repo's `config/core.toml` under the `[workspace]` section\n+- A reference from `core.toml` to an external workspace file\n+","path":"README.md","commit_id":"bbd9d67bfb716d0d6a2f03b0f3a46917a407740e","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Clarify that standalone workspace files must be referenced from `core.toml`.**\n\nThis reads as if a standalone `.cypilot-workspace.toml` at a super-root is enough on its own. In the current design, a repo only enters workspace mode when its `config/core.toml` has a `workspace` entry pointing to that file, or embeds the workspace inline. Based on learnings: `find_workspace_config()` intentionally does NOT perform implicit parent directory traversal or auto-discover standalone `.cypilot-workspace.toml` files; workspace location MUST be explicitly configured via the `workspace` key in `core.toml`.\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@README.md` around lines 295 - 299, The README's \"Workspace config\" section\nincorrectly implies a standalone .cypilot-workspace.toml at a super-root is\nsufficient; update the text to state that a repository only enters workspace\nmode when its config/core.toml either embeds a [workspace] section or has a\nworkspace key pointing to the standalone .cypilot-workspace.toml, because\nfind_workspace_config() does not auto-discover parent directories and requires\nexplicit workspace configuration in core.toml.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-09T20:48:29Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856912","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856912"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856912"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856912/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":295,"start_side":"RIGHT","line":null,"original_line":299,"side":"RIGHT","author_association":"NONE","original_position":82,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856913","pull_request_review_id":3918127689,"id":2907856913,"node_id":"PRRC_kwDOQ7VXwc6tUmAR","diff_hunk":"@@ -0,0 +1,140 @@\n+{\n+  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+  \"$id\": \"https://example.com/cypilot/workspace.schema.json\",\n+  \"title\": \"Cypilot Workspace Configuration (.cypilot-workspace.toml)\",\n+  \"description\": \"Federation layer for multi-repo workspace support. Maps named sources (repos) to local paths with roles. Standalone file uses TOML format.\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"required\": [\"version\", \"sources\"],\n+  \"examples\": [\n+    {\n+      \"version\": \"1.0\",\n+      \"sources\": {\n+        \"docs-repo\": {\n+          \"path\": \"../docs-repo\",\n+          \"adapter\": \".bootstrap\",\n+          \"role\": \"artifacts\"\n+        },\n+        \"code-repo\": {\n+          \"path\": \"../code-repo\",\n+          \"adapter\": \".bootstrap\",\n+          \"role\": \"codebase\"\n+        },\n+        \"shared-kits\": {\n+          \"path\": \"../shared-kits\",\n+          \"role\": \"kits\"\n+        },\n+        \"remote-lib\": {\n+          \"url\": \"https://gitlab.com/team/lib.git\",\n+          \"branch\": \"main\",\n+          \"role\": \"codebase\"\n+        }\n+      },\n+      \"traceability\": {\n+        \"cross_repo\": true,\n+        \"resolve_remote_ids\": true\n+      },\n+      \"resolve\": {\n+        \"workdir\": \".workspace-sources\",\n+        \"default_branch\": \"HEAD\",\n+        \"namespace\": {\n+          \"gitlab.com\": \"{org}/{repo}\"\n+        }\n+      }\n+    }\n+  ],\n+  \"properties\": {\n+    \"version\": {\n+      \"type\": \"string\",\n+      \"minLength\": 1,\n+      \"description\": \"Schema version (currently '1.0')\"\n+    },\n+    \"sources\": {\n+      \"type\": \"object\",\n+      \"description\": \"Named source repositories in the workspace. Keys are human-readable names.\",\n+      \"additionalProperties\": {\n+        \"$ref\": \"#/$defs/source_entry\"\n+      }\n+    },\n+    \"traceability\": {\n+      \"$ref\": \"#/$defs/traceability_config\"\n+    },\n+    \"resolve\": {\n+      \"$ref\": \"#/$defs/resolve_config\"\n+    }\n+  },\n+  \"$defs\": {\n+    \"source_entry\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"anyOf\": [\n+        {\"required\": [\"path\"]},\n+        {\"required\": [\"url\"]}\n+      ],\n+      \"properties\": {\n+        \"path\": {\n+          \"type\": \"string\",\n+          \"description\": \"Local filesystem path to the source repo. Resolved relative to workspace file location.\"\n+        },\n+        \"adapter\": {\n+          \"type\": \"string\",\n+          \"description\": \"Path to adapter directory within the source repo (e.g., '.bootstrap'). Omit if repo has no adapter.\"\n+        },\n+        \"role\": {\n+          \"type\": \"string\",\n+          \"enum\": [\"artifacts\", \"codebase\", \"kits\", \"full\"],\n+          \"default\": \"full\",\n+          \"description\": \"Constrains what the source contributes. 'artifacts' = only artifacts, 'codebase' = only code, 'kits' = only kits, 'full' = everything.\"\n+        },\n+        \"url\": {\n+          \"type\": \"string\",\n+          \"description\": \"Git remote URL (HTTPS or SSH). Only supported in standalone workspace files, not inline config.\"\n+        },\n+        \"branch\": {\n+          \"type\": \"string\",\n+          \"description\": \"Git branch or ref to checkout. Falls back to resolve.default_branch, then HEAD.\"\n+        }","path":"schemas/workspace.schema.json","commit_id":"9f1bd09558f424b565e977a1d2160e7304c3390c","original_commit_id":"b456721ad17005d5a2044968932b3bf30224e561","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟡 Minor_\n\n**Reject empty source fields at schema-validation time.**\n\n`source_entry` currently accepts `path = \"\"` or `url = \"\"` because these fields are only typed as strings. Those values will validate here and then fail later during source resolution. Adding at least `minLength: 1` to `path`, `adapter`, `url`, and `branch` keeps obviously broken workspace files out of the runtime path. \n\n<details>\n<summary>🩹 Suggested schema hardening</summary>\n\n```diff\n         \"path\": {\n           \"type\": \"string\",\n+          \"minLength\": 1,\n           \"description\": \"Local filesystem path to the source repo. Resolved relative to workspace file location.\"\n         },\n         \"adapter\": {\n           \"type\": \"string\",\n+          \"minLength\": 1,\n           \"description\": \"Path to adapter directory within the source repo (e.g., '.bootstrap'). Omit if repo has no adapter.\"\n         },\n@@\n         \"url\": {\n           \"type\": \"string\",\n+          \"minLength\": 1,\n           \"description\": \"Git remote URL (HTTPS or SSH). Only supported in standalone workspace files, not inline config.\"\n         },\n         \"branch\": {\n           \"type\": \"string\",\n+          \"minLength\": 1,\n           \"description\": \"Git branch or ref to checkout. Falls back to resolve.default_branch, then HEAD.\"\n         }\n```\n</details>\n\n<!-- suggestion_start -->\n\n<details>\n<summary>📝 Committable suggestion</summary>\n\n> ‼️ **IMPORTANT**\n> Carefully review the code before committing. Ensure that it accurately replaces the highlighted code, contains no missing lines, and has no issues with indentation. Thoroughly test & benchmark the code to ensure it meets the requirements.\n\n```suggestion\n        \"path\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"Local filesystem path to the source repo. Resolved relative to workspace file location.\"\n        },\n        \"adapter\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"Path to adapter directory within the source repo (e.g., '.bootstrap'). Omit if repo has no adapter.\"\n        },\n        \"role\": {\n          \"type\": \"string\",\n          \"enum\": [\"artifacts\", \"codebase\", \"kits\", \"full\"],\n          \"default\": \"full\",\n          \"description\": \"Constrains what the source contributes. 'artifacts' = only artifacts, 'codebase' = only code, 'kits' = only kits, 'full' = everything.\"\n        },\n        \"url\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"Git remote URL (HTTPS or SSH). Only supported in standalone workspace files, not inline config.\"\n        },\n        \"branch\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"Git branch or ref to checkout. Falls back to resolve.default_branch, then HEAD.\"\n        }\n```\n\n</details>\n\n<!-- suggestion_end -->\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn `@schemas/workspace.schema.json` around lines 75 - 96, The schema currently\nallows empty strings for the \"path\", \"adapter\", \"url\", and \"branch\" properties\nin workspace.schema.json which lets invalid source entries pass validation;\nupdate each of those property definitions (\"path\", \"adapter\", \"url\", \"branch\")\nto include \"minLength\": 1 so empty strings are rejected at schema-validation\ntime and invalid workspace files fail early.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:grasshopper -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->\n\n✅ Addressed in commit eaf5018","created_at":"2026-03-09T20:48:25Z","updated_at":"2026-03-12T19:52:58Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856913","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856913"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/81#discussion_r2907856913"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/81"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2907856913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":80,"original_start
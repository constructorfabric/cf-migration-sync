ts/pr/\n+    \"\"\"\n+    out: Dict[str, Any] = {}\n+    for k, v in data.items():\n+        new_key = _PR_REVIEW_KEY_MAP.get(k, k)\n+        if new_key == \"prompts\" and isinstance(v, list):\n+            out[new_key] = [_normalize_pr_review_entry(entry, kit_slug=kit_slug) for entry in v]\n+        else:\n+            out[new_key] = v\n+    return out","path":".bootstrap/.core/skills/cypilot/scripts/cypilot/commands/migrate.py","commit_id":"8ab9fa93954abece56e49d11d9aeffe67795b113","original_commit_id":"8eef1fb37f2df87ddc87cd98559bfc93fe010afc","user":{"login":"coderabbitai[bot]","id":136622811,"node_id":"BOT_kgDOCCSy2w","avatar_url":"https://avatars.githubusercontent.com/in/347564?v=4","gravatar_id":"","url":"https://api.github.com/users/coderabbitai%5Bbot%5D","html_url":"https://github.com/apps/coderabbitai","followers_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/followers","following_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/repos","events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/coderabbitai%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"_⚠️ Potential issue_ | _🟠 Major_\n\n**Validate `pr-review.json` root type before `Line 1584` iteration.**\n\n`_normalize_pr_review_data` assumes a dict and calls `.items()`. If the JSON root is malformed (list/string), this throws `AttributeError` (not caught by callers), causing avoidable migration failure.\n\n\n<details>\n<summary>💡 Suggested fix</summary>\n\n```diff\n-def _normalize_pr_review_data(\n-    data: Dict[str, Any],\n+def _normalize_pr_review_data(\n+    data: Any,\n     kit_slug: str = _PR_REVIEW_DEFAULT_KIT_SLUG,\n ) -> Dict[str, Any]:\n@@\n-    out: Dict[str, Any] = {}\n+    if not isinstance(data, dict):\n+        raise TypeError(\"pr-review.json root must be an object\")\n+\n+    out: Dict[str, Any] = {}\n     for k, v in data.items():\n```\n</details>\n\n<details>\n<summary>🤖 Prompt for AI Agents</summary>\n\n```\nVerify each finding against the current code and only fix it if needed.\n\nIn @.bootstrap/.core/skills/cypilot/scripts/cypilot/commands/migrate.py around\nlines 1574 - 1590, The function _normalize_pr_review_data currently assumes\n`data` is a dict and iterates with .items(); add an explicit type check at the\nstart (e.g., if not isinstance(data, dict)) and fail-fast with a clear exception\n(ValueError or TypeError) or return an empty dict as appropriate for migration\nflow, including the offending root type in the message; keep the rest of the\nlogic (key mapping via _PR_REVIEW_KEY_MAP and handling of \"prompts\" entries via\n_normalize_pr_review_entry) unchanged so callers can detect/handle malformed\npr-review.json roots.\n```\n\n</details>\n\n<!-- fingerprinting:phantom:poseidon:hawk -->\n\n<!-- This is an auto-generated comment by CodeRabbit -->","created_at":"2026-03-02T11:34:02Z","updated_at":"2026-03-02T11:34:04Z","html_url":"https://github.com/cyberfabric/cyber-constructor/pull/82#discussion_r2871938065","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/82","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments/2871938065"},"html":{"href":"https://github.com/cyberfabric/cyber-constructor/pull/82#discussion_r2871938065"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/82"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/com
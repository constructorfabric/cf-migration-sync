ric/cyber-constructor/pull/64","diff_url":"https://github.com/cyberfabric/cyber-constructor/pull/64.diff","patch_url":"https://github.com/cyberfabric/cyber-constructor/pull/64.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/issues/64","number":64,"state":"closed","locked":false,"title":"feat: add PR review and status workflows with Cypilot integration","user":{"login":"Artifizer","id":192502778,"node_id":"U_kgDOC3lb-g","avatar_url":"https://avatars.githubusercontent.com/u/192502778?v=4","gravatar_id":"","url":"https://api.github.com/users/Artifizer","html_url":"https://github.com/Artifizer","followers_url":"https://api.github.com/users/Artifizer/followers","following_url":"https://api.github.com/users/Artifizer/following{/other_user}","gists_url":"https://api.github.com/users/Artifizer/gists{/gist_id}","starred_url":"https://api.github.com/users/Artifizer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artifizer/subscriptions","organizations_url":"https://api.github.com/users/Artifizer/orgs","repos_url":"https://api.github.com/users/Artifizer/repos","events_url":"https://api.github.com/users/Artifizer/events{/privacy}","received_events_url":"https://api.github.com/users/Artifizer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"- Add PR review and status workflow commands for Windsurf/Cursor/Claude\r\n- Create PR management scripts with GitHub integration\r\n- Add PR templates for code reviews and status reports\r\n- Configure PR prompts for different artifact types (ADR, PRD, Design, Code)\r\n- Update Cypilot skill with PR workflow routing and quick commands\r\n- Add PR configuration and exclude list support\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added a PR review suite with dedicated review types (code, design, ADR, PRD), CLI quick-commands to list/fetch PRs, generate detailed PR status reports, and reorder report sections by severity.\n\n* **Documentation**\n  * Added structured review prompts, workflow guides, and standardized templates for consistent reviews, unresolved-comment auditing, severity-based ordering, and clear status reports.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","created_at":"2026-02-11T16:03:39Z","updated_at":"2026-02-11T18:14:57Z","closed_at":"2026-02-11T18:14:38Z","merged_at":"2026-02-11T18:14:38Z","merge_commit_sha":"0d8338c6340bb563e056bc862290c24460809065","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/64/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/issues/64/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyber-constructor/statuses/a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","head":{"label":"cyberfabric:cypilot-pr-workflow","ref":"cypilot-pr-workflow","sha":"a1ce6b83e73c88a16432f8e269c4ee77cb0e3858","user":{"login":"cyberfabric","id":249082402,"node_id":"O_kgDODtiyIg","avatar_url":"https://avatars.githubusercontent.com/u/249082402?v=4","gravatar_id":"","url":"https://api.github.com/users/cyberfabric","html_url":"https://github.com/cyberfabric","followers_url":"https://api.github.com/users/cyberfabric/followers","following_url":"https://api.github.com/users/cyberfabric/following{/other_user}","gists_url":"https://api.github.com/users/cyberfabric/gists{/gist_id}","starred_url":"https://api.github.com/users/cyberfabric/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cyberfabric/subscriptions","organizations_url":"https://api.github.com/users/cyberfabric/orgs","repos_url":
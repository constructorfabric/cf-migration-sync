https://api.github.com/repos/cyberfabric/cyberware-frontx/releases{/id}","deployments_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/deployments","created_at":"2025-10-13T18:06:58Z","updated_at":"2026-05-20T08:56:31Z","pushed_at":"2026-05-29T06:32:48Z","git_url":"git://github.com/cyberfabric/cyberware-frontx.git","ssh_url":"git@github.com:cyberfabric/cyberware-frontx.git","clone_url":"https://github.com/cyberfabric/cyberware-frontx.git","svn_url":"https://github.com/cyberfabric/cyberware-frontx","homepage":"https://cyberfabric.org","size":12550,"stargazers_count":15,"watchers_count":15,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":6,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":50,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ai","llm","nocode","react","saas","shadcn","tailwind","typescript"],"visibility":"private","forks":6,"open_issues":50,"watchers":15,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/131"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/131"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/131/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/76a6669f869deb5d52dc41a5008e35a122135c1d"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676427650","pull_request_review_id":3644199297,"id":2676427650,"node_id":"PRRC_kwDOQBxSA86fhwuC","diff_hunk":"@@ -0,0 +1,254 @@\n+# Change: Add Microfrontend Support\n+\n+## Why\n+\n+HAI3 applications need to compose functionality from multiple independently deployed microfrontends (MFEs). Vendors can create MFE extensions that integrate into host applications through well-defined extension points. This enables:\n+\n+1. **Independent Deployment**: MFEs can be deployed separately from the host application\n+2. **Vendor Extensibility**: Third parties can create extensions without modifying host code, using ANY UI framework (Vue 3, Angular, Svelte, etc.)\n+3. **Complete Runtime Isolation**: Each MFE maintains its own isolated runtime (state, TypeSystemPlugin, schema registry) with controlled communication ONLY through the contract\n+4. **Type-Safe Contracts**: Each runtime has its own TypeSystemPlugin instance - MFEs cannot discover host or other MFE schemas\n+5. **Framework Agnostic**: Host uses React, but MFEs can use any framework - no React/ReactDOM dependency for MFEs\n+\n+## What Changes\n+\n+### Core Architecture\n+\n+Each MFE and host has its **own FULLY ISOLATED runtime**:\n+- Own `@hai3/screensets` instance (NOT singleton)\n+- Own `TypeSystemPlugin` instance (NOT singleton) with isolated schema registry\n+- Own `@hai3/state` container\n+- Can use ANY UI framework (host uses React, MFEs can use Vue 3, Angular, Svelte, etc.)","path":"openspec/changes/add-microfrontend-support/proposal.md","commit_id":"857055e6df3343d7e78949a0f911f3ecc2173cc8","original_commit_id":"0c146565c7ab92c566d5ef92723d97f1bb958ddc","user":{"login":"Last-Christmas","id":253948635,"node_id":"U_kgDODyLy2w","avatar_url":"https://avatars.githubusercontent.com/u/253948635?v=4","gravatar_id":"","url":"https://api.github.com/users/Last-Christmas","html_url":"https://github.com/Last-Christmas","followers_url":"https://api.github.com/users/Last-Christmas/followers","following_url":"https://api.github.com/users/Last-Christmas/following{/other_user}","gists_url":"https://api.github.com/users/Last-Christmas/gists{/gist_id}","starred_url":"https://api.github.com/users/Last-Christmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Last-Christmas/subscriptions","organizations_url":"https://api.github.com/users/Last-Christmas/orgs","repos_url":"https://api.github.com/users/Last-Christmas/repos","events_url":"https://api.github.com/users/Last-Christmas/events{/privacy}","received_events_url":"https://api.github.com/users/Last-Christmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**question:**\r\n\r\n> host uses React\r\n\r\nIs this a strict limitation? Will MFEs only work if host uses React?","created_at":"2026-01-09T14:38:07Z","updated_at":"2026-01-29T07:49:20Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676427650","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676427650"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676427650"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676427650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":21,"side":"RIGHT","author_association":"MEMBER","original_position":21,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676435418","pull_request_review_id":3644199297,"id":2676435418,"node_id":"PRRC_kwDOQBxSA86fhyna","diff_hunk":"@@ -0,0 +1,254 @@\n+# Change: Add Microfrontend Support\n+\n+## Why\n+\n+HAI3 applications need to compose functionality from multiple independently deployed microfrontends (MFEs). Vendors can create MFE extensions that integrate into host applications through well-defined extension points. This enables:\n+\n+1. **Independent Deployment**: MFEs can be deployed separately from the host application\n+2. **Vendor Extensibility**: Third parties can create extensions without modifying host code, using ANY UI framework (Vue 3, Angular, Svelte, etc.)\n+3. **Complete Runtime Isolation**: Each MFE maintains its own isolated runtime (state, TypeSystemPlugin, schema registry) with controlled communication ONLY through the contract\n+4. **Type-Safe Contracts**: Each runtime has its own TypeSystemPlugin instance - MFEs cannot discover host or other MFE schemas\n+5. **Framework Agnostic**: Host uses React, but MFEs can use any framework - no React/ReactDOM dependency for MFEs\n+\n+## What Changes\n+\n+### Core Architecture\n+\n+Each MFE and host has its **own FULLY ISOLATED runtime**:\n+- Own `@hai3/screensets` instance (NOT singleton)\n+- Own `TypeSystemPlugin` instance (NOT singleton) with isolated schema registry\n+- Own `@hai3/state` container\n+- Can use ANY UI framework (host uses React, MFEs can use Vue 3, Angular, Svelte, etc.)\n+\n+Communication happens ONLY through the explicit contract (MfeBridge interface):\n+- **Shared properties** (parent to child, read-only)\n+- **Actions chain** delivered by ActionsChainsMediator to targets\n+\n+Internal runtime coordination (between host and MFE runtimes) uses PRIVATE mechanisms not exposed to MFE code.\n+\n+### Architectural Decision: Type System Plugin Abstraction\n+\n+The @hai3/screensets package abstracts the Type System as a **pluggable dependency**:\n+\n+1. **Opaque Type IDs**: The screensets package treats type IDs as opaque strings\n+2. **Required Plugin**: A `TypeSystemPlugin` must be provided at initialization\n+3. **Default Implementation**: GTS (`@globaltypesystem/gts-ts`) ships as the default plugin\n+4. **Extensibility**: Other Type System implementations can be plugged in\n+\n+**Key Principle**: When metadata about a type ID is needed, call plugin methods (`parseTypeId`, `getAttribute`, etc.) directly.\n+\n+**Plugin Interface:**\n+```typescript\n+interface TypeSystemPlugin {\n+  // Type ID operations\n+  isValidTypeId(id: string): boolean;\n+  buildTypeId(options: Record<string, unknown>): string;\n+  parseTypeId(id: string): Record<string, unknown>;\n+\n+  // Schema registry\n+  registerSchema(typeId: string, schema: JSONSchema): void;\n+  validateInstance(typeId: string, instance: unknown): ValidationResult;\n+  getSchema(typeId: string): JSONSchema | undefined;\n+\n+  // Query\n+  query(pattern: string, limit?: number): string[];\n+\n+  // Compatibility (REQUIRED)","path":"openspec/changes/add-microfrontend-support/proposal.md","commit_id":"76a6669f869deb5d52dc41a5008e35a122135c1d","original_commit_id":"0c146565c7ab92c566d5ef92723d97f1bb958ddc","user":{"login":"Last-Christmas","id":253948635,"node_id":"U_kgDODyLy2w","avatar_url":"https://avatars.githubusercontent.com/u/253948635?v=4","gravatar_id":"","url":"https://api.github.com/users/Last-Christmas","html_url":"https://github.com/Last-Christmas","followers_url":"https://api.github.com/users/Last-Christmas/followers","following_url":"https://api.github.com/users/Last-Christmas/following{/other_user}","gists_url":"https://api.github.com/users/Last-Christmas/gists{/gist_id}","starred_url":"https://api.github.com/users/Last-Christmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Last-Christmas/subscriptions","organizations_url":"https://api.github.com/users/Last-Christmas/orgs","repos_url":"https://api.github.com/users/Last-Christmas/repos","events_url":"https://api.github.com/users/Last-Christmas/events{/privacy}","received_events_url":"https://api.github.com/users/Last-Christmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**question:**\r\n> REQUIRED\r\n\r\nWhat does `REQUIRED` mean? Are other fields not required?","created_at":"2026-01-09T14:40:16Z","updated_at":"2026-01-29T07:49:20Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676435418","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676435418"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676435418"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676435418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":94,"original_line":56,"side":"RIGHT","author_association":"MEMBER","original_position":56,"position":94,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676455504","pull_request_review_id":3644199297,"id":2676455504,"node_id":"PRRC_kwDOQBxSA86fh3hQ","diff_hunk":"@@ -0,0 +1,254 @@\n+# Change: Add Microfrontend Support\n+\n+## Why\n+\n+HAI3 applications need to compose functionality from multiple independently deployed microfrontends (MFEs). Vendors can create MFE extensions that integrate into host applications through well-defined extension points. This enables:\n+\n+1. **Independent Deployment**: MFEs can be deployed separately from the host application\n+2. **Vendor Extensibility**: Third parties can create extensions without modifying host code, using ANY UI framework (Vue 3, Angular, Svelte, etc.)\n+3. **Complete Runtime Isolation**: Each MFE maintains its own isolated runtime (state, TypeSystemPlugin, schema registry) with controlled communication ONLY through the contract\n+4. **Type-Safe Contracts**: Each runtime has its own TypeSystemPlugin instance - MFEs cannot discover host or other MFE schemas\n+5. **Framework Agnostic**: Host uses React, but MFEs can use any framework - no React/ReactDOM dependency for MFEs\n+\n+## What Changes\n+\n+### Core Architecture\n+\n+Each MFE and host has its **own FULLY ISOLATED runtime**:\n+- Own `@hai3/screensets` instance (NOT singleton)\n+- Own `TypeSystemPlugin` instance (NOT singleton) with isolated schema registry\n+- Own `@hai3/state` container\n+- Can use ANY UI framework (host uses React, MFEs can use Vue 3, Angular, Svelte, etc.)\n+\n+Communication happens ONLY through the explicit contract (MfeBridge interface):\n+- **Shared properties** (parent to child, read-only)\n+- **Actions chain** delivered by ActionsChainsMediator to targets\n+\n+Internal runtime coordination (between host and MFE runtimes) uses PRIVATE mechanisms not exposed to MFE code.\n+\n+### Architectural Decision: Type System Plugin Abstraction\n+\n+The @hai3/screensets package abstracts the Type System as a **pluggable dependency**:\n+\n+1. **Opaque Type IDs**: The screensets package treats type IDs as opaque strings\n+2. **Required Plugin**: A `TypeSystemPlugin` must be provided at initialization\n+3. **Default Implementation**: GTS (`@globaltypesystem/gts-ts`) ships as the default plugin\n+4. **Extensibility**: Other Type System implementations can be plugged in\n+\n+**Key Principle**: When metadata about a type ID is needed, call plugin methods (`parseTypeId`, `getAttribute`, etc.) directly.\n+\n+**Plugin Interface:**\n+```typescript\n+interface TypeSystemPlugin {\n+  // Type ID operations\n+  isValidTypeId(id: string): boolean;\n+  buildTypeId(options: Record<string, unknown>): string;\n+  parseTypeId(id: string): Record<string, unknown>;\n+\n+  // Schema registry\n+  registerSchema(typeId: string, schema: JSONSchema): void;\n+  validateInstance(typeId: string, instance: unknown): ValidationResult;\n+  getSchema(typeId: string): JSONSchema | undefined;\n+\n+  // Query\n+  query(pattern: string, limit?: number): string[];\n+\n+  // Compatibility (REQUIRED)\n+  checkCompatibility(oldTypeId: string, newTypeId: string): CompatibilityResult;\n+\n+  // Attribute access (REQUIRED for dynamic schema resolution)\n+  getAttribute(typeId: string, path: string): AttributeResult;\n+}\n+```\n+\n+### HAI3 Internal TypeScript Types\n+\n+The MFE system uses these internal TypeScript interfaces. Each type has an `id: string` field as its identifier:\n+\n+**Core Types (6 types):**\n+\n+| TypeScript Interface | Fields | Purpose |\n+|---------------------|--------|---------|\n+| `MfeEntry` | `id, requiredProperties[], optionalProperties?[], actions[], domainActions[]` | Pure contract type (Abstract Base) |\n+| `ExtensionDomain` | `id, sharedProperties[], actions[], extensionsActions[], extensionsUiMeta, defaultActionTimeout` | Extension point contract |\n+| `Extension` | `id, domain, entry, uiMeta` | Extension binding |\n+| `SharedProperty` | `id, value` | Shared property instance |\n+| `Action` | `type, target, payload?, timeout?` | Action with self-identifying type ID and optional timeout override |\n+| `ActionsChain` | `action: Action, next?: ActionsChain, fallback?: ActionsChain` | Action chain for mediation (contains instances, no id) |\n+\n+**MF-Specific Types (2 types):**\n+\n+| TypeScript Interface | Fields | Purpose |\n+|---------------------|--------|---------|\n+| `MfManifest` | `id, remoteEntry, remoteName, sharedDependencies?[], entries?` | Module Federation manifest (standalone) |\n+| `MfeEntryMF` | `(extends MfeEntry) manifest, exposedModule` | Module Federation entry (derived) |\n+\n+**Note on MfeEntry Design:** MfeEntry is a **pure contract** type (abstract base) that defines ONLY the communication interface (properties, actions). Derived types like `MfeEntryMF` add loader-specific fields. This separation ensures the same entry contract works with any loader and allows future loaders (ESM, Import Maps) to add their own derived types.\n+\n+### GTS Type ID Format\n+\n+The GTS type ID format is: `gts.<vendor>.<package>.<namespace>.<type>.v<MAJOR>[.<MINOR>]~`","path":"openspec/changes/add-microfrontend-support/proposal.md","commit_id":"76a6669f869deb5d52dc41a5008e35a122135c1d","original_commit_id":"0c146565c7ab92c566d5ef92723d97f1bb958ddc","user":{"login":"Last-Christmas","id":253948635,"node_id":"U_kgDODyLy2w","avatar_url":"https://avatars.githubusercontent.com/u/253948635?v=4","gravatar_id":"","url":"https://api.github.com/users/Last-Christmas","html_url":"https://github.com/Last-Christmas","followers_url":"https://api.github.com/users/Last-Christmas/followers","following_url":"https://api.github.com/users/Last-Christmas/following{/other_user}","gists_url":"https://api.github.com/users/Last-Christmas/gists{/gist_id}","starred_url":"https://api.github.com/users/Last-Christmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Last-Christmas/subscriptions","organizations_url":"https://api.github.com/users/Last-Christmas/orgs","repos_url":"https://api.github.com/users/Last-Christmas/repos","events_url":"https://api.github.com/users/Last-Christmas/events{/privacy}","received_events_url":"https://api.github.com/users/Last-Christmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**question:** Shouldn't we reference other spec / external document that defines GTS? It looks like we're referencing something that already exists, it's not a part of MFE design itself.","created_at":"2026-01-09T14:46:05Z","updated_at":"2026-01-29T07:49:20Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676455504","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676455504"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676455504"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676455504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":166,"original_line":90,"side":"RIGHT","author_association":"MEMBER","original_position":90,"position":166,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676459827","pull_request_review_id":3644199297,"id":2676459827,"node_id":"PRRC_kwDOQBxSA86fh4kz","diff_hunk":"@@ -0,0 +1,254 @@\n+# Change: Add Microfrontend Support\n+\n+## Why\n+\n+HAI3 applications need to compose functionality from multiple independently deployed microfrontends (MFEs). Vendors can create MFE extensions that integrate into host applications through well-defined extension points. This enables:\n+\n+1. **Independent Deployment**: MFEs can be deployed separately from the host application\n+2. **Vendor Extensibility**: Third parties can create extensions without modifying host code, using ANY UI framework (Vue 3, Angular, Svelte, etc.)\n+3. **Complete Runtime Isolation**: Each MFE maintains its own isolated runtime (state, TypeSystemPlugin, schema registry) with controlled communication ONLY through the contract\n+4. **Type-Safe Contracts**: Each runtime has its own TypeSystemPlugin instance - MFEs cannot discover host or other MFE schemas\n+5. **Framework Agnostic**: Host uses React, but MFEs can use any framework - no React/ReactDOM dependency for MFEs\n+\n+## What Changes\n+\n+### Core Architecture\n+\n+Each MFE and host has its **own FULLY ISOLATED runtime**:\n+- Own `@hai3/screensets` instance (NOT singleton)\n+- Own `TypeSystemPlugin` instance (NOT singleton) with isolated schema registry\n+- Own `@hai3/state` container\n+- Can use ANY UI framework (host uses React, MFEs can use Vue 3, Angular, Svelte, etc.)\n+\n+Communication happens ONLY through the explicit contract (MfeBridge interface):\n+- **Shared properties** (parent to child, read-only)\n+- **Actions chain** delivered by ActionsChainsMediator to targets\n+\n+Internal runtime coordination (between host and MFE runtimes) uses PRIVATE mechanisms not exposed to MFE code.\n+\n+### Architectural Decision: Type System Plugin Abstraction\n+\n+The @hai3/screensets package abstracts the Type System as a **pluggable dependency**:\n+\n+1. **Opaque Type IDs**: The screensets package treats type IDs as opaque strings\n+2. **Required Plugin**: A `TypeSystemPlugin` must be provided at initialization\n+3. **Default Implementation**: GTS (`@globaltypesystem/gts-ts`) ships as the default plugin\n+4. **Extensibility**: Other Type System implementations can be plugged in\n+\n+**Key Principle**: When metadata about a type ID is needed, call plugin methods (`parseTypeId`, `getAttribute`, etc.) directly.\n+\n+**Plugin Interface:**\n+```typescript\n+interface TypeSystemPlugin {\n+  // Type ID operations\n+  isValidTypeId(id: string): boolean;\n+  buildTypeId(options: Record<string, unknown>): string;\n+  parseTypeId(id: string): Record<string, unknown>;\n+\n+  // Schema registry\n+  registerSchema(typeId: string, schema: JSONSchema): void;\n+  validateInstance(typeId: string, instance: unknown): ValidationResult;\n+  getSchema(typeId: string): JSONSchema | undefined;\n+\n+  // Query\n+  query(pattern: string, limit?: number): string[];\n+\n+  // Compatibility (REQUIRED)\n+  checkCompatibility(oldTypeId: string, newTypeId: string): CompatibilityResult;\n+\n+  // Attribute access (REQUIRED for dynamic schema resolution)\n+  getAttribute(typeId: string, path: string): AttributeResult;\n+}\n+```\n+\n+### HAI3 Internal TypeScript Types\n+\n+The MFE system uses these internal TypeScript interfaces. Each type has an `id: string` field as its identifier:\n+\n+**Core Types (6 types):**\n+\n+| TypeScript Interface | Fields | Purpose |\n+|---------------------|--------|---------|\n+| `MfeEntry` | `id, requiredProperties[], optionalProperties?[], actions[], domainActions[]` | Pure contract type (Abstract Base) |\n+| `ExtensionDomain` | `id, sharedProperties[], actions[], extensionsActions[], extensionsUiMeta, defaultActionTimeout` | Extension point contract |\n+| `Extension` | `id, domain, entry, uiMeta` | Extension binding |\n+| `SharedProperty` | `id, value` | Shared property instance |\n+| `Action` | `type, target, payload?, timeout?` | Action with self-identifying type ID and optional timeout override |\n+| `ActionsChain` | `action: Action, next?: ActionsChain, fallback?: ActionsChain` | Action chain for mediation (contains instances, no id) |\n+\n+**MF-Specific Types (2 types):**\n+\n+| TypeScript Interface | Fields | Purpose |\n+|---------------------|--------|---------|\n+| `MfManifest` | `id, remoteEntry, remoteName, sharedDependencies?[], entries?` | Module Federation manifest (standalone) |\n+| `MfeEntryMF` | `(extends MfeEntry) manifest, exposedModule` | Module Federation entry (derived) |\n+\n+**Note on MfeEntry Design:** MfeEntry is a **pure contract** type (abstract base) that defines ONLY the communication interface (properties, actions). Derived types like `MfeEntryMF` add loader-specific fields. This separation ensures the same entry contract works with any loader and allows future loaders (ESM, Import Maps) to add their own derived types.\n+\n+### GTS Type ID Format\n+\n+The GTS type ID format is: `gts.<vendor>.<package>.<namespace>.<type>.v<MAJOR>[.<MINOR>]~`\n+\n+### Type System Registration (via Plugin)\n+\n+When using the GTS plugin, the following types are registered with properly structured GTS type IDs:\n+\n+**Core Types (6 types):**\n+\n+| GTS Type ID | Purpose |\n+|-------------|---------|\n+| `gts.hai3.screensets.mfe.entry.v1~` | Pure contract type (Abstract Base) |\n+| `gts.hai3.screensets.ext.domain.v1~` | Extension point contract |","path":"openspec/changes/add-microfrontend-support/proposal.md","commit_id":"76a6669f869deb5d52dc41a5008e35a122135c1d","original_commit_id":"0c146565c7ab92c566d5ef92723d97f1bb958ddc","user":{"login":"Last-Christmas","id":253948635,"node_id":"U_kgDODyLy2w","avatar_url":"https://avatars.githubusercontent.com/u/253948635?v=4","gravatar_id":"","url":"https://api.github.com/users/Last-Christmas","html_url":"https://github.com/Last-Christmas","followers_url":"https://api.github.com/users/Last-Christmas/followers","following_url":"https://api.github.com/users/Last-Christmas/following{/other_user}","gists_url":"https://api.github.com/users/Last-Christmas/gists{/gist_id}","starred_url":"https://api.github.com/users/Last-Christmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Last-Christmas/subscriptions","organizations_url":"https://api.github.com/users/Last-Christmas/orgs","repos_url":"https://api.github.com/users/Last-Christmas/repos","events_url":"https://api.github.com/users/Last-Christmas/events{/privacy}","received_events_url":"https://api.github.com/users/Last-Christmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**question:** What are the reasons for using `ext` and not `mfe` here and below?","created_at":"2026-01-09T14:47:22Z","updated_at":"2026-01-29T07:49:20Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/131#discussion_r2676459827","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/131","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2676459827"},"html":{"hr
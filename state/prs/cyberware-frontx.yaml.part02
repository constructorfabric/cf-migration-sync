ics":["ai","llm","nocode","react","saas","shadcn","tailwind","typescript"],"visibility":"private","forks":6,"open_issues":50,"watchers":15,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/146"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/146"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/146"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/146/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/146/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/146/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/b8f9dbc0c116270a7d0f2d43e019ae1ae0059b1d"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":145,"source_url":"https://github.com/cyberfabric/cyberware-frontx/pull/145","source_state":"closed","source_author":"GuilleX7","target_issue_number":null,"title":"[PR #145] feat: add improved navigation specs","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"1a1f6dd5eae727e4c33f563021cdc86a4db481ab","pr_base_ref":"main","pr_head_owner":"GuilleX7","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/145","id":3193291937,"node_id":"PR_kwDOQBxSA86-VcSh","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/145","diff_url":"https://github.com/cyberfabric/cyberware-frontx/pull/145.diff","patch_url":"https://github.com/cyberfabric/cyberware-frontx/pull/145.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/145","number":145,"state":"closed","locked":false,"title":"feat: add improved navigation specs","user":{"login":"GuilleX7","id":5785918,"node_id":"MDQ6VXNlcjU3ODU5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/5785918?v=4","gravatar_id":"","url":"https://api.github.com/users/GuilleX7","html_url":"https://github.com/GuilleX7","followers_url":"https://api.github.com/users/GuilleX7/followers","following_url":"https://api.github.com/users/GuilleX7/following{/other_user}","gists_url":"https://api.github.com/users/GuilleX7/gists{/gist_id}","starred_url":"https://api.github.com/users/GuilleX7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GuilleX7/subscriptions","organizations_url":"https://api.github.com/users/GuilleX7/orgs","repos_url":"https://api.github.com/users/GuilleX7/repos","events_url":"https://api.github.com/users/GuilleX7/events{/privacy}","received_events_url":"https://api.github.com/users/GuilleX7/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This feature adds parameterized URL routing to HAI3, enabling screens to define custom URL patterns with named parameters (e.g., /users/:id, /orders/:orderId/items/:itemId). It's essential for deep linking, bookmarkable URLs, and RESTful URL patterns.\r\n\r\nHAI3 previously used flat routing (/{base}/{screenId}) with no parameter support, limiting the ability to create dynamic screens like user detail pages or order items.\r\n\r\nSample usage:\r\n```ts\r\n// Define a parameterized route\r\n{\r\n  menuItem: { id: 'user-detail', label: 'User', path: '/users/:id' },\r\n  screen: () => import('./UserDetailScreen'),\r\n}\r\n\r\n// Access params in screen\r\nconst { id } = useRouteParams();\r\n\r\n// Navigate programmatically\r\nnavigateToScreen('demo', 'user-detail', { id: '123' });\r\n// → URL becomes /users/123\r\n```\r\n\r\nSome design decisions:\r\n- path-to-regexp dependency (same lib used by Express/React Router)\r\n- Optional path property maintains full backward compatibility\r\n- React Context pattern for params (consistent with existing HAI3 patterns)\r\n- First-match-wins for route conflicts","created_at":"2026-01-21T00:17:29Z","updated_at":"2026-01-23T07:46:46Z","closed_at":"2026-01-23T07:46:46Z","merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[{"login":"dingoatemytokens","id":244849678,"node_id":"U_kgDODpgcDg","avatar_url":"https://avatars.githubusercontent.com/u/244849678?v=4","gravatar_id":"","url":"https://api.github.com/users/dingoatemytokens","html_url":"https://github.com/dingoatemytokens","followers_url":"https://api.github.com/users/dingoatemytokens/followers","following_url":"https://api.github.com/users/dingoatemytokens/following{/other_user}","gists_url":"https://api.github.com/users/dingoatemytokens/gists{/gist_id}","starred_url":"https://api.github.com/users/dingoatemytokens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dingoatemytokens/subscriptions","organizations_url":"https://api.github.com/users/dingoatemytokens/orgs","repos_url":"https://api.github.com/users/dingoatemytokens/repos","events_url":"https://api.github.com/users/dingoatemytokens/events{/privacy}","received_events_url":"https://api.github.com/users/dingoatemytokens/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/145/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/145/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/145/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/1a1f6dd5eae727e4c33f563021cdc86a4db481ab","head":{"label"
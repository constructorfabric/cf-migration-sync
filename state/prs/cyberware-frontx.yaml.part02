pi.github.com/repos/cyberfabric/cyberware-frontx/pulls/118/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/a575b52d5776b1500d8113cb9e65a596203dfbfa"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3707684099","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/118#issuecomment-3707684099","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/118","id":3707684099,"node_id":"IC_kwDOQBxSA87c_sUD","user":{"login":"dingoatemytokens","id":244849678,"node_id":"U_kgDODpgcDg","avatar_url":"https://avatars.githubusercontent.com/u/244849678?v=4","gravatar_id":"","url":"https://api.github.com/users/dingoatemytokens","html_url":"https://github.com/dingoatemytokens","followers_url":"https://api.github.com/users/dingoatemytokens/followers","following_url":"https://api.github.com/users/dingoatemytokens/following{/other_user}","gists_url":"https://api.github.com/users/dingoatemytokens/gists{/gist_id}","starred_url":"https://api.github.com/users/dingoatemytokens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dingoatemytokens/subscriptions","organizations_url":"https://api.github.com/users/dingoatemytokens/orgs","repos_url":"https://api.github.com/users/dingoatemytokens/repos","events_url":"https://api.github.com/users/dingoatemytokens/events{/privacy}","received_events_url":"https://api.github.com/users/dingoatemytokens/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-04T05:15:29Z","updated_at":"2026-01-04T22:37:38Z","body":"I'm trying to implement automatic reauth on 401 with subsequent retry, but it's impossible in the current plugin system because ApiPlugin.onError can only return Error | Promise<Error> - there's no way to short-circuit the error flow and return a successful retry result or call a retry mechanism from within the plugin. I propose extending the `ApiPlugin.onError` signature to accept a retry callback:\r\n```\r\nonError?(\r\n  error: Error,\r\n  context: ApiPluginRequestContext,\r\n  retry: (modifiedContext?: ApiPluginRequestContext) => Promise<unknown>\r\n): Error | Promise<Error> | Promise<unknown>;\r\n```\r\nThis would allow plugins to perform reauth and call retry() to repeat the request, returning the successful result instead of propagating the error","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3707684099/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3708940907","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/118#issuecomment-3708940907","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/118","id":3708940907,"node_id":"IC_kwDOQBxSA87dEfJr","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T04:55:41Z","updated_at":"2026-01-05T04:55:41Z","body":"> I'm trying to implement automatic reauth on 401 with subsequent retry, but it's impossible in the current plugin system because ApiPlugin.onError can only return Error | Promise - there's no way to short-circuit the error flow and return a successful retry result or call a retry mechanism from within the plugin. I propose extending the `ApiPlugin.onError` signature to accept a retry callback:\r\n> \r\n> ```\r\n> onError?(\r\n>   error: Error,\r\n>   context: ApiPluginRequestContext,\r\n>   retry: (modifiedContext?: ApiPluginRequestContext) => Promise<unknown>\r\n> ): Error | Promise<Error> | Promise<unknown>;\r\n> ```\r\n> \r\n> This would allow plugins to perform reauth and call retry() to repeat the request, returning the successful result instead of propagating the error\r\n\r\nupdated","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3708940907/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656776704","pull_request_review_id":3622165720,"id":2656776704,"node_id":"PRRC_kwDOQBxSA86eWzIA","diff_hunk":"@@ -0,0 +1,280 @@\n+# Global API Plugins Specification\n+\n+## Problem Statement\n+\n+The HAI3 API layer needs a flexible plugin architecture that allows cross-cutting concerns (logging, authentication, mocking, telemetry) to be applied across API services. The current implementation has revealed architectural issues that require a new approach:\n+\n+1. **Protocol-specific concerns mixed with generic plugin system** - REST and SSE have fundamentally different request/response models\n+2. **MockPlugin trying to be protocol-agnostic** - Leads to complex logic and unclear responsibilities\n+3. **Centralized plugin registry** - Makes protocol-level customization difficult\n+\n+**Corrective Update (Post-Implementation Review):**\n+Based on implementation review, the architecture is being refactored to a protocol-specific plugin model where each protocol manages its own plugin type and mocking stays in plugins but is protocol-aware.\n+\n+## User-Facing Behavior\n+\n+### Protocol-Level Plugin Registration\n+- **Global**: `RestProtocol.globalPlugins.add(...)` applies to all REST services\n+- **Global**: `SseProtocol.globalPlugins.add(...)` applies to all SSE services\n+- **Instance**: `restProtocol.plugins.add(...)` for service-specific plugins\n+- Type-safe: Each protocol only accepts its own plugin type\n+\n+### Mock Mode\n+- **REST**: `RestMockPlugin` returns fake responses via `{ shortCircuit: RestResponseContext }`\n+- **SSE**: `SseMockPlugin` returns fake EventSource via `{ shortCircuit: EventSourceLike }`\n+- Each mock plugin is honest about what it does - no cross-protocol logic\n+- Per-service mocking remains the preferred pattern for vertical slice compliance\n+\n+### Short-Circuit Pattern\n+- Protocol-specific short-circuit types prevent type confusion\n+- REST: `{ shortCircuit: RestResponseContext }` - returns response data\n+- SSE: `{ shortCircuit: EventSourceLike }` - returns mock event source\n+- Type guards: `isRestShortCircuit()`, `isSseShortCircuit()`\n+\n+## Non-Goals\n+\n+- Plugin communication/shared state between plugins\n+- Plugin versioning or compatibility checks\n+- Complex dependency graph with topological sorting\n+- Async `destroy()` hooks\n+- String-based plugin naming or identification\n+- Centralized `apiRegistry.plugins.*` namespace (moved to protocol level)\n+\n+## Requirements\n+\n+### Functional Requirements\n+\n+#### FR-1: Protocol-Specific Plugin Hooks\n+Each protocol defines its own plugin hook interfaces:\n+- `RestPluginHooks`: `onRequest`, `onResponse`\n+- `SsePluginHooks`: `onConnect`, `onEvent`\n+- `WsPluginHooks`: `onConnect`, `onMessage` (future)\n+\n+#### FR-2: Protocol-Specific Short-Circuit Types\n+Short-circuit responses are protocol-specific:\n+- REST: `{ shortCircuit: RestResponseContext }` - complete response\n+- SSE: `{ shortCircuit: EventSourceLike }` - mock event source to use\n+- Type guards prevent accidental cross-protocol usage\n+\n+#### FR-3: Protocol-Level Plugin Management\n+Plugin registration moves from central registry to protocol level:\n+- `RestProtocol.globalPlugins.add(plugin)` for global REST plugins\n+- `SseProtocol.globalPlugins.add(plugin)` for global SSE plugins\n+- `protocol.plugins.add(plugin)` for instance-specific plugins\n+- Plugin resolution: global plugins first, then instance plugins\n+\n+#### FR-4: Pure SseProtocol\n+SseProtocol becomes pure - no mock simulation logic:\n+- Single branch: \"did plugin short-circuit?\" -> use provided EventSource, else create real one\n+- Same code path after getting the source (attaching handlers)\n+- All mock simulation logic moves to `SseMockPlugin`\n+\n+#### FR-5: Protocol-Specific Mock Plugins\n+Mock plugins are protocol-aware and self-contained:\n+- `RestMockPlugin extends RestPluginWithConfig<RestMockConfig>`\n+- `SseMockPlugin extends SsePluginWithConfig<SseMockConfig>`\n+- SseMockPlugin creates and returns a fake EventSource\n+- Each is honest about what protocol it supports\n+\n+#### FR-6: Vertical Slice Architecture Support\n+The plugin system must support vertical slice architecture:\n+- Screensets must have zero footprint outside their folder\n+- Each screenset can register its own services with its own mock configuration\n+- No global mock state that screensets need to contribute to\n+\n+### Non-Functional Requirements\n+\n+#### NFR-1: Type Safety\n+All plugin-related code must use proper TypeScript typing:\n+- No ESLint disable comments for type-related rules\n+- Proper type guards instead of type assertions where possible\n+- Protocol-specific generics prevent cross-protocol type errors\n+\n+#### NFR-2: Performance\n+- Plugin chain execution should add minimal overhead\n+- Short-circuit should immediately stop the chain without unnecessary iterations\n+\n+## Scenarios / User Journeys\n+\n+### Scenario 1: REST Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/billing/services/BillingApiService.ts\n+class BillingApiService extends BaseApiService {\n+  constructor() {\n+    const restProtocol = new RestProtocol();\n+    super({ baseURL: '/api/billing' }, restProtocol);\n+\n+    // Register protocol-specific mock plugin\n+    restProtocol.plugins.add(new RestMockPlugin({\n+      mockMap: {\n+        'GET /api/billing/invoices': () => mockInvoices,\n+        'POST /api/billing/payment': (body) => mockPaymentResult(body),\n+      },\n+      delay: 100,\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 2: SSE Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/chat/services/ChatStreamService.ts\n+class ChatStreamService extends BaseApiService {\n+  constructor() {\n+    const sseProtocol = new SseProtocol();\n+    super({ baseURL: '/api/chat' }, sseProtocol);\n+\n+    // Register SSE-specific mock plugin that returns fake EventSource\n+    sseProtocol.plugins.add(new SseMockPlugin({\n+      mockStreams: {\n+        '/api/chat/stream': () => createMockEventSource([\n+          { event: 'message', data: 'Hello' },\n+          { event: 'message', data: ' World' },\n+          { event: 'done', data: '' },\n+        ]),\n+      },\n+      delay: 50, // delay between events\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 3: Cross-Cutting REST Plugin (Global)\n+\n+```typescript\n+// Register auth plugin globally for all REST services\n+RestProtocol.globalPlugins.add(new AuthRestPlugin({\n+  getToken: () => localStorage.getItem('token'),\n+}));\n+\n+// Later, any REST service will have auth applied\n+apiRegistry.register(BillingApiService); // Auth plugin runs for all requests\n+```\n+\n+### Scenario 4: Pure SseProtocol Implementation\n+\n+```typescript\n+// SseProtocol is now pure - single branch logic\n+class SseProtocol {\n+  connect(url: string, onMessage: (event: MessageEvent) => void): string {\n+    const connectionId = this.generateId();\n+\n+    // Execute plugin chain\n+    const context: SseConnectContext = { url, headers: {} };\n+    const result = await this.executePluginChain(context);\n+\n+    // Single branch: did plugin provide EventSource?\n+    const eventSource = isSseShortCircuit(result)\n+      ? result.shortCircuit  // Use plugin-provided EventSource\n+      : new EventSource(url); // Create real EventSource\n+\n+    // Same code path for both - just attach handlers\n+    this.attachHandlers(connectionId, eventSource, onMessage);\n+    return connectionId;\n+  }\n+}\n+```\n+\n+### Scenario 5: Cross-Cutting Plugin Implementing Multiple Protocols\n+\n+```typescript\n+// For plugins that need to work across protocols\n+class TelemetryPlugin extends ApiPluginBase implements RestPluginHooks, SsePluginHooks {\n+  // REST hooks\n+  onRequest(ctx: RestRequestContext) {\n+    this.trackRequest('REST', ctx.url);\n+    return ctx;\n+  }\n+\n+  onResponse(response: RestResponseContext) {\n+    this.trackResponse('REST', response.status);\n+    return response;\n+  }\n+\n+  // SSE hooks\n+  onConnect(ctx: SseConnectContext) {\n+    this.trackRequest('SSE', ctx.url);\n+    return ctx;\n+  }\n+\n+  onEvent(event: MessageEvent) {\n+    this.trackEvent('SSE', event.type);\n+    return event;\n+  }\n+}\n+\n+// Register with both protocols\n+RestProtocol.globalPlugins.add(telemetryPlugin);\n+SseProtocol.globalPlugins.add(telemetryPlugin);","path":"openspec/changes/archive/2025-12-31-add-global-api-plugins/spec.md","commit_id":"a575b52d5776b1500d8113cb9e65a596203dfbfa","original_commit_id":"0035dc07f082e03565df7983c2be6691e4796dbd","user":{"login":"dingoatemytokens","id":244849678,"node_id":"U_kgDODpgcDg","avatar_url":"https://avatars.githubusercontent.com/u/244849678?v=4","gravatar_id":"","url":"https://api.github.com/users/dingoatemytokens","html_url":"https://github.com/dingoatemytokens","followers_url":"https://api.github.com/users/dingoatemytokens/followers","following_url":"https://api.github.com/users/dingoatemytokens/following{/other_user}","gists_url":"https://api.github.com/users/dingoatemytokens/gists{/gist_id}","starred_url":"https://api.github.com/users/dingoatemytokens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dingoatemytokens/subscriptions","organizations_url":"https://api.github.com/users/dingoatemytokens/orgs","repos_url":"https://api.github.com/users/dingoatemytokens/repos","events_url":"https://api.github.com/users/dingoatemytokens/events{/privacy}","received_events_url":"https://api.github.com/users/dingoatemytokens/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"While this is a good solution for the current SPA, please note that it will cause difficulties when we introduce MFEs. Since globalPlugins is static, it acts as a shared singleton across the runtime. This means the host and all other MFEs will share the same instance, breaking isolation and potentially leading to conflicts, especially if there are version mismatches between the applications","created_at":"2026-01-02T03:21:13Z","updated_at":"2026-01-02T03:35:02Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2656776704","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656776704"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2656776704"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656776704/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":210,"original_line":210,"side":"RIGHT","author_association":"COLLABORATOR","original_position":210,"position":210,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656785440","pull_request_review_id":3622172633,"id":2656785440,"node_id":"PRRC_kwDOQBxSA86eW1Qg","diff_hunk":"@@ -0,0 +1,280 @@\n+# Global API Plugins Specification\n+\n+## Problem Statement\n+\n+The HAI3 API layer needs a flexible plugin architecture that allows cross-cutting concerns (logging, authentication, mocking, telemetry) to be applied across API services. The current implementation has revealed architectural issues that require a new approach:\n+\n+1. **Protocol-specific concerns mixed with generic plugin system** - REST and SSE have fundamentally different request/response models\n+2. **MockPlugin trying to be protocol-agnostic** - Leads to complex logic and unclear responsibilities\n+3. **Centralized plugin registry** - Makes protocol-level customization difficult\n+\n+**Corrective Update (Post-Implementation Review):**\n+Based on implementation review, the architecture is being refactored to a protocol-specific plugin model where each protocol manages its own plugin type and mocking stays in plugins but is protocol-aware.\n+\n+## User-Facing Behavior\n+\n+### Protocol-Level Plugin Registration\n+- **Global**: `RestProtocol.globalPlugins.add(...)` applies to all REST services\n+- **Global**: `SseProtocol.globalPlugins.add(...)` applies to all SSE services\n+- **Instance**: `restProtocol.plugins.add(...)` for service-specific plugins\n+- Type-safe: Each protocol only accepts its own plugin type\n+\n+### Mock Mode\n+- **REST**: `RestMockPlugin` returns fake responses via `{ shortCircuit: RestResponseContext }`\n+- **SSE**: `SseMockPlugin` returns fake EventSource via `{ shortCircuit: EventSourceLike }`\n+- Each mock plugin is honest about what it does - no cross-protocol logic\n+- Per-service mocking remains the preferred pattern for vertical slice compliance\n+\n+### Short-Circuit Pattern\n+- Protocol-specific short-circuit types prevent type confusion\n+- REST: `{ shortCircuit: RestResponseContext }` - returns response data\n+- SSE: `{ shortCircuit: EventSourceLike }` - returns mock event source\n+- Type guards: `isRestShortCircuit()`, `isSseShortCircuit()`\n+\n+## Non-Goals\n+\n+- Plugin communication/shared state between plugins\n+- Plugin versioning or compatibility checks\n+- Complex dependency graph with topological sorting\n+- Async `destroy()` hooks\n+- String-based plugin naming or identification\n+- Centralized `apiRegistry.plugins.*` namespace (moved to protocol level)\n+\n+## Requirements\n+\n+### Functional Requirements\n+\n+#### FR-1: Protocol-Specific Plugin Hooks\n+Each protocol defines its own plugin hook interfaces:\n+- `RestPluginHooks`: `onRequest`, `onResponse`\n+- `SsePluginHooks`: `onConnect`, `onEvent`\n+- `WsPluginHooks`: `onConnect`, `onMessage` (future)\n+\n+#### FR-2: Protocol-Specific Short-Circuit Types\n+Short-circuit responses are protocol-specific:\n+- REST: `{ shortCircuit: RestResponseContext }` - complete response\n+- SSE: `{ shortCircuit: EventSourceLike }` - mock event source to use\n+- Type guards prevent accidental cross-protocol usage\n+\n+#### FR-3: Protocol-Level Plugin Management\n+Plugin registration moves from central registry to protocol level:\n+- `RestProtocol.globalPlugins.add(plugin)` for global REST plugins\n+- `SseProtocol.globalPlugins.add(plugin)` for global SSE plugins\n+- `protocol.plugins.add(plugin)` for instance-specific plugins\n+- Plugin resolution: global plugins first, then instance plugins\n+\n+#### FR-4: Pure SseProtocol\n+SseProtocol becomes pure - no mock simulation logic:\n+- Single branch: \"did plugin short-circuit?\" -> use provided EventSource, else create real one\n+- Same code path after getting the source (attaching handlers)\n+- All mock simulation logic moves to `SseMockPlugin`\n+\n+#### FR-5: Protocol-Specific Mock Plugins\n+Mock plugins are protocol-aware and self-contained:\n+- `RestMockPlugin extends RestPluginWithConfig<RestMockConfig>`\n+- `SseMockPlugin extends SsePluginWithConfig<SseMockConfig>`\n+- SseMockPlugin creates and returns a fake EventSource\n+- Each is honest about what protocol it supports\n+\n+#### FR-6: Vertical Slice Architecture Support\n+The plugin system must support vertical slice architecture:\n+- Screensets must have zero footprint outside their folder\n+- Each screenset can register its own services with its own mock configuration\n+- No global mock state that screensets need to contribute to\n+\n+### Non-Functional Requirements\n+\n+#### NFR-1: Type Safety\n+All plugin-related code must use proper TypeScript typing:\n+- No ESLint disable comments for type-related rules\n+- Proper type guards instead of type assertions where possible\n+- Protocol-specific generics prevent cross-protocol type errors\n+\n+#### NFR-2: Performance\n+- Plugin chain execution should add minimal overhead\n+- Short-circuit should immediately stop the chain without unnecessary iterations\n+\n+## Scenarios / User Journeys\n+\n+### Scenario 1: REST Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/billing/services/BillingApiService.ts\n+class BillingApiService extends BaseApiService {\n+  constructor() {\n+    const restProtocol = new RestProtocol();\n+    super({ baseURL: '/api/billing' }, restProtocol);\n+\n+    // Register protocol-specific mock plugin\n+    restProtocol.plugins.add(new RestMockPlugin({\n+      mockMap: {\n+        'GET /api/billing/invoices': () => mockInvoices,\n+        'POST /api/billing/payment': (body) => mockPaymentResult(body),\n+      },\n+      delay: 100,\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 2: SSE Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/chat/services/ChatStreamService.ts\n+class ChatStreamService extends BaseApiService {\n+  constructor() {\n+    const sseProtocol = new SseProtocol();\n+    super({ baseURL: '/api/chat' }, sseProtocol);\n+\n+    // Register SSE-specific mock plugin that returns fake EventSource\n+    sseProtocol.plugins.add(new SseMockPlugin({\n+      mockStreams: {\n+        '/api/chat/stream': () => createMockEventSource([\n+          { event: 'message', data: 'Hello' },\n+          { event: 'message', data: ' World' },\n+          { event: 'done', data: '' },\n+        ]),\n+      },\n+      delay: 50, // delay between events\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 3: Cross-Cutting REST Plugin (Global)\n+\n+```typescript\n+// Register auth plugin globally for all REST services\n+RestProtocol.globalPlugins.add(new AuthRestPlugin({\n+  getToken: () => localStorage.getItem('token'),\n+}));\n+\n+// Later, any REST service will have auth applied\n+apiRegistry.register(BillingApiService); // Auth plugin runs for all requests\n+```\n+\n+### Scenario 4: Pure SseProtocol Implementation\n+\n+```typescript\n+// SseProtocol is now pure - single branch logic\n+class SseProtocol {\n+  connect(url: string, onMessage: (event: MessageEvent) => void): string {\n+    const connectionId = this.generateId();\n+\n+    // Execute plugin chain\n+    const context: SseConnectContext = { url, headers: {} };\n+    const result = await this.executePluginChain(context);\n+\n+    // Single branch: did plugin provide EventSource?\n+    const eventSource = isSseShortCircuit(result)\n+      ? result.shortCircuit  // Use plugin-provided EventSource\n+      : new EventSource(url); // Create real EventSource\n+\n+    // Same code path for both - just attach handlers\n+    this.attachHandlers(connectionId, eventSource, onMessage);\n+    return connectionId;\n+  }\n+}\n+```\n+\n+### Scenario 5: Cross-Cutting Plugin Implementing Multiple Protocols\n+\n+```typescript\n+// For plugins that need to work across protocols\n+class TelemetryPlugin extends ApiPluginBase implements RestPluginHooks, SsePluginHooks {\n+  // REST hooks\n+  onRequest(ctx: RestRequestContext) {\n+    this.trackRequest('REST', ctx.url);\n+    return ctx;\n+  }\n+\n+  onResponse(response: RestResponseContext) {\n+    this.trackResponse('REST', response.status);\n+    return response;\n+  }\n+\n+  // SSE hooks\n+  onConnect(ctx: SseConnectContext) {\n+    this.trackRequest('SSE', ctx.url);\n+    return ctx;\n+  }\n+\n+  onEvent(event: MessageEvent) {\n+    this.trackEvent('SSE', event.type);\n+    return event;\n+  }\n+}\n+\n+// Register with both protocols\n+RestProtocol.globalPlugins.add(telemetryPlugin);\n+SseProtocol.globalPlugins.add(telemetryPlugin);","path":"openspec/changes/archive/2025-12-31-add-global-api-plugins/spec.md","commit_id":"a575b52d5776b1500d8113cb9e65a596203dfbfa","original_commit_id":"0035dc07f082e03565df7983c2be6691e4796dbd","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yeah, good catch. Thanks!","created_at":"2026-01-02T03:38:13Z","updated_at":"2026-01-02T03:38:13Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2656785440","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656785440"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2656785440"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2656785440/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":210,"original_line":210,"side":"RIGHT","in_reply_to_id":2656776704,"author_association":"MEMBER","original_position":210,"position":210,"subject_type":"line"},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2660284029","pull_request_review_id":3625488498,"id":2660284029,"node_id":"PRRC_kwDOQBxSA86ekLZ9","diff_hunk":"@@ -0,0 +1,280 @@\n+# Global API Plugins Specification\n+\n+## Problem Statement\n+\n+The HAI3 API layer needs a flexible plugin architecture that allows cross-cutting concerns (logging, authentication, mocking, telemetry) to be applied across API services. The current implementation has revealed architectural issues that require a new approach:\n+\n+1. **Protocol-specific concerns mixed with generic plugin system** - REST and SSE have fundamentally different request/response models\n+2. **MockPlugin trying to be protocol-agnostic** - Leads to complex logic and unclear responsibilities\n+3. **Centralized plugin registry** - Makes protocol-level customization difficult\n+\n+**Corrective Update (Post-Implementation Review):**\n+Based on implementation review, the architecture is being refactored to a protocol-specific plugin model where each protocol manages its own plugin type and mocking stays in plugins but is protocol-aware.\n+\n+## User-Facing Behavior\n+\n+### Protocol-Level Plugin Registration\n+- **Global**: `RestProtocol.globalPlugins.add(...)` applies to all REST services\n+- **Global**: `SseProtocol.globalPlugins.add(...)` applies to all SSE services\n+- **Instance**: `restProtocol.plugins.add(...)` for service-specific plugins\n+- Type-safe: Each protocol only accepts its own plugin type\n+\n+### Mock Mode\n+- **REST**: `RestMockPlugin` returns fake responses via `{ shortCircuit: RestResponseContext }`\n+- **SSE**: `SseMockPlugin` returns fake EventSource via `{ shortCircuit: EventSourceLike }`\n+- Each mock plugin is honest about what it does - no cross-protocol logic\n+- Per-service mocking remains the preferred pattern for vertical slice compliance\n+\n+### Short-Circuit Pattern\n+- Protocol-specific short-circuit types prevent type confusion\n+- REST: `{ shortCircuit: RestResponseContext }` - returns response data\n+- SSE: `{ shortCircuit: EventSourceLike }` - returns mock event source\n+- Type guards: `isRestShortCircuit()`, `isSseShortCircuit()`\n+\n+## Non-Goals\n+\n+- Plugin communication/shared state between plugins\n+- Plugin versioning or compatibility checks\n+- Complex dependency graph with topological sorting\n+- Async `destroy()` hooks\n+- String-based plugin naming or identification\n+- Centralized `apiRegistry.plugins.*` namespace (moved to protocol level)\n+\n+## Requirements\n+\n+### Functional Requirements\n+\n+#### FR-1: Protocol-Specific Plugin Hooks\n+Each protocol defines its own plugin hook interfaces:\n+- `RestPluginHooks`: `onRequest`, `onResponse`\n+- `SsePluginHooks`: `onConnect`, `onEvent`\n+- `WsPluginHooks`: `onConnect`, `onMessage` (future)\n+\n+#### FR-2: Protocol-Specific Short-Circuit Types\n+Short-circuit responses are protocol-specific:\n+- REST: `{ shortCircuit: RestResponseContext }` - complete response\n+- SSE: `{ shortCircuit: EventSourceLike }` - mock event source to use\n+- Type guards prevent accidental cross-protocol usage\n+\n+#### FR-3: Protocol-Level Plugin Management\n+Plugin registration moves from central registry to protocol level:\n+- `RestProtocol.globalPlugins.add(plugin)` for global REST plugins\n+- `SseProtocol.globalPlugins.add(plugin)` for global SSE plugins\n+- `protocol.plugins.add(plugin)` for instance-specific plugins\n+- Plugin resolution: global plugins first, then instance plugins\n+\n+#### FR-4: Pure SseProtocol\n+SseProtocol becomes pure - no mock simulation logic:\n+- Single branch: \"did plugin short-circuit?\" -> use provided EventSource, else create real one\n+- Same code path after getting the source (attaching handlers)\n+- All mock simulation logic moves to `SseMockPlugin`\n+\n+#### FR-5: Protocol-Specific Mock Plugins\n+Mock plugins are protocol-aware and self-contained:\n+- `RestMockPlugin extends RestPluginWithConfig<RestMockConfig>`\n+- `SseMockPlugin extends SsePluginWithConfig<SseMockConfig>`\n+- SseMockPlugin creates and returns a fake EventSource\n+- Each is honest about what protocol it supports\n+\n+#### FR-6: Vertical Slice Architecture Support\n+The plugin system must support vertical slice architecture:\n+- Screensets must have zero footprint outside their folder\n+- Each screenset can register its own services with its own mock configuration\n+- No global mock state that screensets need to contribute to\n+\n+### Non-Functional Requirements\n+\n+#### NFR-1: Type Safety\n+All plugin-related code must use proper TypeScript typing:\n+- No ESLint disable comments for type-related rules\n+- Proper type guards instead of type assertions where possible\n+- Protocol-specific generics prevent cross-protocol type errors\n+\n+#### NFR-2: Performance\n+- Plugin chain execution should add minimal overhead\n+- Short-circuit should immediately stop the chain without unnecessary iterations\n+\n+## Scenarios / User Journeys\n+\n+### Scenario 1: REST Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/billing/services/BillingApiService.ts\n+class BillingApiService extends BaseApiService {\n+  constructor() {\n+    const restProtocol = new RestProtocol();\n+    super({ baseURL: '/api/billing' }, restProtocol);\n+\n+    // Register protocol-specific mock plugin\n+    restProtocol.plugins.add(new RestMockPlugin({\n+      mockMap: {\n+        'GET /api/billing/invoices': () => mockInvoices,\n+        'POST /api/billing/payment': (body) => mockPaymentResult(body),\n+      },\n+      delay: 100,\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 2: SSE Service with Protocol-Specific Mock Plugin\n+\n+```typescript\n+// screensets/chat/services/ChatStreamService.ts\n+class ChatStreamService extends BaseApiService {\n+  constructor() {\n+    const sseProtocol = new SseProtocol();\n+    super({ baseURL: '/api/chat' }, sseProtocol);\n+\n+    // Register SSE-specific mock plugin that returns fake EventSource\n+    sseProtocol.plugins.add(new SseMockPlugin({\n+      mockStreams: {\n+        '/api/chat/stream': () => createMockEventSource([\n+          { event: 'message', data: 'Hello' },\n+          { event: 'message', data: ' World' },\n+          { event: 'done', data: '' },\n+        ]),\n+      },\n+      delay: 50, // delay between events\n+    }));\n+  }\n+}\n+```\n+\n+### Scenario 3: Cross-Cutting REST Plugin (Global)\n+\n+```typescript\n+// Register auth plugin globally for all REST services\n+RestProtocol.globalPlugins.add(new AuthRestPlugin({\n+  getToken: () => localStorage.getItem('token'),\n+}));\n+\n+// Later, any REST service will have auth applied\n+apiRegistry.register(BillingApiService); // Auth plugin runs for all requests\n+```\n+\n+### Scenario 4: Pure SseProtocol Implementation\n+\n+```typescript\n+// SseProtocol is now pure - single branch logic\n+class SseProtocol {\n+  connect(url: string, onMessage: (event: MessageEvent) => void): string {\n+    const connectionId = this.generateId();\n+\n+    // Execute plugin chain\n+    const context: SseConnectContext = { url, headers: {} };\n+    const result = await this.executePluginChain(context);\n+\n+    // Single branch: did plugin provide EventSource?\n+    const eventSource = isSseShortCircuit(result)\n+      ? result.shortCircuit  // Use plugin-provided EventSource\n+      : new EventSource(url); // Create real EventSource\n+\n+    // Same code path for both - just attach handlers\n+    this.attachHandlers(connectionId, eventSource, onMessage);\n+    return connectionId;\n+  }\n+}\n+```\n+\n+### Scenario 5: Cross-Cutting Plugin Implementing Multiple Protocols\n+\n+```typescript\n+// For plugins that need to work across protocols\n+class TelemetryPlugin extends ApiPluginBase implements RestPluginHooks, SsePluginHooks {\n+  // REST hooks\n+  onRequest(ctx: RestRequestContext) {\n+    this.trackRequest('REST', ctx.url);\n+    return ctx;\n+  }\n+\n+  onResponse(response: RestResponseContext) {\n+    this.trackResponse('REST', response.status);\n+    return response;\n+  }\n+\n+  // SSE hooks\n+  onConnect(ctx: SseConnectContext) {\n+    this.trackRequest('SSE', ctx.url);\n+    return ctx;\n+  }\n+\n+  onEvent(event: MessageEvent) {\n+    this.trackEvent('SSE', event.type);\n+    return event;\n+  }\n+}\n+\n+// Register with both protocols\n+RestProtocol.globalPlugins.add(telemetryPlugin);\n+SseProtocol.globalPlugins.add(telemetryPlugin);","path":"openspec/changes/archive/2025-12-31-add-global-api-plugins/spec.md","commit_id":"a575b52d5776b1500d8113cb9e65a596203dfbfa","original_commit_id":"0035dc07f082e03565df7983c2be6691e4796dbd","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"updated","created_at":"2026-01-05T04:54:50Z","updated_at":"2026-01-05T04:54:50Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2660284029","pull_request_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2660284029"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/118#discussion_r2660284029"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/118"}},"reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments/2660284029/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":210,"original_line":210,"side":"RIGHT","in_reply_to_id":2656776704,"author_association":"MEMBER","original_position":210,"position":210,"subject_type":"line"}],"source_reviews":[]},{"source_pr_number":117,"source_url":"https://github.com/cyberfabric/cyberware-frontx/pull/117","source_state":"closed","source_author":"leonid","target_issue_number":null,"title":"[PR #117] Create SECURITY.md for security policy","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"patch-1","pr_head_sha":"898ed523da6cbb62e2942085315c043f3098c59f","pr_base_ref":"main","pr_head_owner":"leonid","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/117","id":3136455731,"node_id":"PR_kwDOQBxSA8668oQz","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/117","diff_url":"https://github.com/cyberfabric/cyberware-frontx/pull/117.diff","patch_url":"https://github.com/cyberfabric/cyberware-frontx/pull/117.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/117","number":117,"state":"closed","locked":false,"title":"Create SECURITY.md for security policy","user":{"login":"leonid","id":249603,"node_id":"MDQ6VXNlcjI0OTYwMw==","avatar_url":"https://avatars.githubusercontent.com/u/249603?v=4","gravatar_id":"","url":"https://api.github.com/users/leonid","html_url":"https://github.com/leonid","followers_url":"https://api.github.com/users/leonid/followers","following_url":"https://api.github.com/users/leonid/following{/other_user}","gists_url":"https://api.github.com/users/leonid/gists{/gist_id}","starred_url":"https://api.github.com/users/leonid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leonid/subscriptions","organizations_url":"https://api.github.com/users/leonid/orgs","repos_url":"https://api.github.com/users/leonid/repos","events_url":"https://api.github.com/users/leonid/events{/privacy}","received_events_url":"https://api.github.com/users/leonid/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Add a security policy document outlining supported versions and vulnerability reporting.","created_at":"2025-12-30T10:25:38Z","updated_at":"2026-01-05T10:33:16Z","closed_at":"2026-01-05T10:32:55Z","merged_at":null,"merge_commit_sha":"5909ceb2e58bf29f299944541a72db8022c11719","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":fa
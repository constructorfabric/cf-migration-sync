32:48Z","git_url":"git://github.com/cyberfabric/cyberware-frontx.git","ssh_url":"git@github.com:cyberfabric/cyberware-frontx.git","clone_url":"https://github.com/cyberfabric/cyberware-frontx.git","svn_url":"https://github.com/cyberfabric/cyberware-frontx","homepage":"https://cyberfabric.org","size":12550,"stargazers_count":15,"watchers_count":15,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":6,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":50,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ai","llm","nocode","react","saas","shadcn","tailwind","typescript"],"visibility":"private","forks":6,"open_issues":50,"watchers":15,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/165"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/165"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/165"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/165/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/165/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/165/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/6ba2ecb3f8ecca021b1eec9b2b33f3929d6c66ae"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3881922501","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/165#issuecomment-3881922501","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/165","id":3881922501,"node_id":"IC_kwDOQBxSA87nYW_F","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-11T03:30:05Z","updated_at":"2026-02-11T03:30:05Z","body":"# PR #165 Review Report: Feature/date i18n\n\n## Summary\n\nThis PR adds locale-aware formatting utilities (date, number, currency, sorting) to `@hai3/i18n` (L1), re-exports from `@hai3/framework` (L2), and exposes a `useFormatters()` hook in `@hai3/react` (L3). It also includes the React 19 forwardRef migration (merged from main) and some build tooling side-effects.\n\n---\n\n## Architecture & Dependencies: PASS\n\n`npm run arch:check` passed all 6/6 checks (build, ESLint, TypeScript, dependency-cruiser, knip).\n\n| Package | Layer | @hai3/* peerDeps | Status |\n|---------|-------|------------------|--------|\n| `@hai3/state` | L1 SDK | none | PASS |\n| `@hai3/screensets` | L1 SDK | none | PASS |\n| `@hai3/api` | L1 SDK | none | PASS |\n| `@hai3/i18n` | L1 SDK | none | PASS |\n| `@hai3/framework` | L2 | `state`, `screensets`, `api`, `i18n` | PASS |\n| `@hai3/react` | L3 | `framework` | PASS |\n| `@hai3/uikit` | UI | none | PASS |\n| `@hai3/studio` | Dev | `react` | PASS |\n| `@hai3/cli` | Tooling | none | PASS |\n\nLayer boundaries are fully respected. `@hai3/uikit` has zero `@hai3/*` dependencies. The `useFormatters` hook correctly imports from `@hai3/framework` (not directly from `@hai3/i18n`).\n\n---\n\n## OpenSpec Proposal: APPROVED\n\nThe proposal, spec, design, and tasks follow the OpenSpec workflow correctly and are well-structured.\n\n**Strengths:**\n- Proper L1 -> L2 -> L3 layer propagation\n- Spec uses Given/When/Then with SHALL language throughout\n- All tasks have traceability to spec requirements\n- Design delegates to browser `Intl` APIs (no reinvented locale logic)\n- No registry root changes\n- Rollback path documented\n\n**Minor gaps (non-blocking):**\n- `formatCurrency` doesn't address invalid `currencyCode` throwing `RangeError` (contradicts \"SHALL NOT throw\" guarantee, but only for the `currencyCode` param -- implicit precondition)\n- No explicit risk statement (low risk, additive-only)\n- `formatRelative` uses approximate month/year lengths (30d/365d) -- cosmetic boundary edge cases\n\n---\n\n## Implementation: BLOCK (2 blockers)\n\n### Blockers\n\n**B1. `as unknown as Date` casts in test file (3 occurrences)**\n\n`packages/i18n/src/formatters/__tests__/dateFormatter.test.ts:33,36,66`\n```typescript\nexpect(formatDate(null as unknown as Date, 'short')).toBe('');\nexpect(formatDate(undefined as unknown as Date, 'short')).toBe('');\nexpect(formatDateTime(null as unknown as Date, 'short', 'short')).toBe('');\n```\n\nGUIDELINES.md BLOCKLIST explicitly forbids `\"as unknown as\"` casts. Fix: widen the `DateInput` type to `Date | number | string | null | undefined` (since the runtime already handles null/undefined gracefully), then tests can pass `null` directly without casts.\n\n> Note: the wider codebase has ~20+ pre-existing `as unknown as` casts in production code (framework plugins, api mocks, etc.), so this is not a pattern unique to this PR. Still a valid finding per the rules.\n\n**B2. `@types/jest` added to root devDependencies without justification**\n\n`package.json:106`\n```json\n\"@types/jest\": \"^30.0.0\",\n```\n\nThe monorepo uses vitest exclusively. No jest configuration, imports, or usage exists anywhere. This violates STOP CONDITIONS (\"Adding new top-level dependencies\") and could cause type conflicts with vitest globals. Must be removed. Likely an accidental troubleshooting artifact.\n\n### Warnings\n\n**W1. `as Date` cast in production code**\n\n`packages/i18n/src/formatters/dateFormatter.ts:17`\n```typescript\nconst d = new Date(value as Date);\n```\n\nWhile `as Type` (as opposed to `as unknown as`) is not explicitly blocklisted, this cast is unnecessary and misleading -- it narrows a three-member union (`Date | number | string`) to `Date`. The `Date` constructor accepts all three types. Consider: `value instanceof Date ? new Date(value.getTime()) : new Date(value)`.\n\n**W2. Test locale mocks diverge from production types**\n\nAll test files mock `getLanguage()` with BCP47 strings (`'de-DE'`, `'en-US'`) via `as ReturnType<...>` casts. These are not valid `Language` enum values (which use `'de'`, `'en'`). Works at runtime because Intl accepts any BCP47 string, but mocks don't accurately represent production behavior.\n\n**W3. `UseFormattersReturn` duplicates all 10 function signatures inline**\n\n`packages/react/src/types.ts:163-174` manually re-declares all signatures instead of referencing the exported `DateFormatStyle`, `TimeFormatStyle`, `DateInput` types from `@hai3/i18n`. Creates a maintenance drift risk if signatures change.\n\n**W4. No test for `useFormatters` hook itself**\n\nOnly L1 formatters are tested. No test verifies the React hook returns all functions or that memo invalidation works on language change.\n\n### Info\n\n- **`postcss.config.ts` -> `.js` rename**: Valid since root has `\"type\": \"module\"`. Removal of `postcss-load-config` is safe.\n- **`void language` pattern in `useFormatters`**: Unconventional but intentional and commented. Formatters read locale at call time; useMemo just needs identity invalidation.\n- **No Intl formatter caching**: Each call creates a new `Intl.*` instance. Non-blocking perf optimization opportunity for later.\n\n---\n\n## Questions from the PR Author\n\n> Do I need to develop a new feature like this via the openspec workflow?\n\nYes, new features should go through OpenSpec. The workflow was followed correctly here.\n\n> Was I correct to put these functions into the i18n package?\n\nYes, `@hai3/i18n` (L1 SDK) is the correct home. Formatters depend on `i18nRegistry.getLanguage()` which lives in this package, and they have zero external `@hai3/*` dependencies.\n\n---\n\n## Required Actions\n\n1. Remove `as unknown as Date` casts in `dateFormatter.test.ts` (widen `DateInput` to accept `null | undefined`, or use untyped variables)\n2. Remove `@types/jest` from root `package.json`","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3881922501/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null},{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3894705745","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/165#issuecomment-3894705745","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/165","id":3894705745,"node_id":"IC_kwDOQBxSA87oJH5R","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-13T03:51:16Z","updated_at":"2026-02-13T03:51:16Z","body":"# PR #165 Re-review (v2)\n\nAll previously identified blockers (B1, B2) have been addressed. Architecture checks pass 6/6. Nice work on the fixes.\n\n## Resolved Since Last Review\n\n- `as unknown as Date` casts removed -- `DateInput` widened to include `null | undefined`, tests pass `null` directly\n- `as Date` cast removed from `toDate()` -- now just `new Date(value)`\n- Test mocks now use `Language.German` / `Language.English` enum values instead of raw BCP47 strings\n- `UseFormattersReturn` replaced with `type UseFormattersReturn = Formatters` referencing a canonical `Formatters` interface using `typeof` -- no more signature drift risk\n- `formatCurrency` now catches invalid `currencyCode` with try/catch -- addresses \"SHALL NOT throw\"\n- `getRelativeUnit` rewritten with calendar-aware month/year boundaries\n- Spec and design docs updated to match\n\n## Remaining Issues (all in root `package.json`)\n\nThree devDependencies were added by this PR that are unnecessary:\n\n| Line | Dependency | Why remove |\n|------|-----------|------------|\n| 109 | `\"node-addon-api\": \"^8.0.0\"` | No native modules in this repo. Flagged unused by `knip`. |\n| 110 | `\"node-gyp\": \"^11.0.0\"` | Same -- no native build step. Flagged unused by `knip`. |\n| 111 | `\"@types/jest\": \"^30.0.0\"` | Monorepo uses vitest exclusively. The one pre-existing file using `jest.spyOn` (`mockEffects.test.ts`) is in `__tests__/` which is excluded from `tsconfig.json` type-checking. This dep provides no value and could cause type conflicts with vitest globals. |\n\nAll three are likely accidental troubleshooting artifacts. Remove them and the `package-lock.json` diff will shrink too.\n\n## Verdict\n\n**Approve after removing the 3 unused devDependencies from root `package.json`.** Everything else is clean.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/comments/3894705745/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null}],"source_review_comments":[],"source_reviews":[{"id":3754189614,"node_id":"PRR_kwDOQBxSA87fxGMu","user":{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?u=a983485ea6e632a911c48b8dc160937e6252ae5d&v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"New features and any refactoring in this 
requests":true,"pull_request_creation_policy":"all","topics":["ai","llm","nocode","react","saas","shadcn","tailwind","typescript"],"visibility":"private","forks":6,"open_issues":50,"watchers":15,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/155"},"html":{"href":"https://github.com/cyberfabric/cyberware-frontx/pull/155"},"issue":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/155"},"comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/155/comments"},"review_comments":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/155/comments"},"review_comment":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/155/commits"},"statuses":{"href":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/821153d9fb2aa82681bf04121742e55ffbf1e7c6"}},"author_association":"MEMBER","auto_merge":null,"assignee":null,"active_lock_reason":null},"source_issue_comments":[],"source_review_comments":[],"source_reviews":[]},{"source_pr_number":151,"source_url":"https://github.com/cyberfabric/cyberware-frontx/pull/151","source_state":"closed","source_author":"dAlcaSan","target_issue_number":null,"title":"[PR #151] fix(cli): Clean UIKit=none projects by removing styling infrastructure","status":"exported","mirrored_at":null,"comments_status":"none","comments_mirrored":0,"pr_head_ref":"main","pr_head_sha":"2c863bc245f2892d5bfa299f983f68f114b7b2d4","pr_base_ref":"main","pr_head_owner":"dAlcaSan","pr_from_fork":1,"source_data":{"url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/151","id":3214561078,"node_id":"PR_kwDOQBxSA86_mk82","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/151","diff_url":"https://github.com/cyberfabric/cyberware-frontx/pull/151.diff","patch_url":"https://github.com/cyberfabric/cyberware-frontx/pull/151.patch","issue_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/151","number":151,"state":"closed","locked":false,"title":"fix(cli): Clean UIKit=none projects by removing styling infrastructure","user":{"login":"dAlcaSan","id":58691149,"node_id":"MDQ6VXNlcjU4NjkxMTQ5","avatar_url":"https://avatars.githubusercontent.com/u/58691149?v=4","gravatar_id":"","url":"https://api.github.com/users/dAlcaSan","html_url":"https://github.com/dAlcaSan","followers_url":"https://api.github.com/users/dAlcaSan/followers","following_url":"https://api.github.com/users/dAlcaSan/following{/other_user}","gists_url":"https://api.github.com/users/dAlcaSan/gists{/gist_id}","starred_url":"https://api.github.com/users/dAlcaSan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dAlcaSan/subscriptions","organizations_url":"https://api.github.com/users/dAlcaSan/orgs","repos_url":"https://api.github.com/users/dAlcaSan/repos","events_url":"https://api.github.com/users/dAlcaSan/events{/privacy}","received_events_url":"https://api.github.com/users/dAlcaSan/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\r\n\r\nFixes the CLI \"None\" UIKit option to generate truly clean projects without @hai3/uikit-specific styling infrastructure.\r\n\r\n## Problem\r\n\r\nWhen selecting \"None (implement your own)\" for UIKit during `hai3 create`, the generated project still included:\r\n- `tailwind.config.ts` with @hai3/uikit CSS variable mappings\r\n- `postcss.config.ts`\r\n- `scripts/generate-colors.ts`\r\n- `generate:colors` script in package.json\r\n\r\nThis coupling made it difficult for users to bring their own UIKit since the configurations assumed @hai3/uikit.\r\n\r\n## Solution\r\n\r\n### Files modified:\r\n- [packages/cli/src/core/types.ts](cci:7://file:///Users/david/Development/Dev-HAI3/packages/cli/src/core/types.ts:0:0-0:0) - Added `uikit` field to [Hai3Config](cci:2://file:///Users/david/Development/Dev-HAI3/packages/cli/src/core/types.ts:13:0-20:1) interface\r\n- [packages/cli/src/generators/project.ts](cci:7://file:///Users/david/Development/Dev-HAI3/packages/cli/src/generators/project.ts:0:0-0:0) - Skip UIKit-dependent files when `uikit=none`\r\n- [packages/cli/src/commands/screenset/create.ts](cci:7://file:///Users/david/Development/Dev-HAI3/packages/cli/src/commands/screenset/create.ts:0:0-0:0) - Block creation when no UIKit configured\r\n- [packages/cli/src/commands/screenset/copy.ts](cci:7://file:///Users/david/Development/Dev-HAI3/packages/cli/src/commands/screenset/copy.ts:0:0-0:0) - Block copy when no UIKit configured\r\n\r\n### When `uikit=none`:\r\n- ❌ `tailwind.config.ts` - not generated\r\n- ❌ `postcss.config.ts` - not generated\r\n- ❌ `scripts/generate-colors.ts` - not generated\r\n- ❌ `generate:colors` script - not in package.json\r\n- ❌ Demo screenset - not generated\r\n- ✅ [hai3.config.json](cci:7://file:///Users/david/Development/testlib2/patata/hai3.config.json:0:0-0:0) - includes `\"uikit\": \"none\"`\r\n\r\n### package.json scripts (clean):\r\n```json\r\n\"dev\": \"vite\",\r\n\"build\": \"vite build\",\r\n\"type-check\": \"tsc --noEmit\"","created_at":"2026-01-27T13:16:41Z","updated_at":"2026-01-28T11:01:00Z","closed_at":"2026-01-28T11:01:00Z","merged_at":"2026-01-28T11:01:00Z","merge_commit_sha":"3e38896f738edaaca599bcb528e879b699ef606b","assignees":[],"requested_reviewers":[{"login":"GeraBart","id":246844849,"node_id":"U_kgDODraNsQ","avatar_url":"https://avatars.githubusercontent.com/u/246844849?v=4","gravatar_id":"","url":"https://api.github.com/users/GeraBart","html_url":"https://github.com/GeraBart","followers_url":"https://api.github.com/users/GeraBart/followers","following_url":"https://api.github.com/users/GeraBart/following{/other_user}","gists_url":"https://api.github.com/users/GeraBart/gists{/gist_id}","starred_url":"https://api.github.com/users/GeraBart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GeraBart/subscriptions","organizations_url":"https://api.github.com/users/GeraBart/orgs","repos_url":"https://api.github.com/users/GeraBart/repos","events_url":"https://api.github.com/users/GeraBart/events{/privacy}","received_events_url":"https://api.github.com/users/GeraBart/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/151/commits","review_comments_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/151/comments","review_comment_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/pulls/comments{/number}","comments_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/issues/151/comments","statuses_url":"https://api.github.com/repos/cyberfabric/cyberware-frontx/statuses/2c863bc245f2892d5bfa299f983f68f114b7b2d4","head":{"label":"dAlcaSan:main","ref":"main","sha":"2c863bc245f2892d5bfa299f983f68f114b7b2d4","user":{"login":"dAlcaSan","id":58691149,"node_id":"MDQ6VXNlcjU4NjkxMTQ5","avatar_url":"https://avatars.githubusercontent.com/u/58691149?v=4","gravatar_id":"","url":"https://api.github.com/users/dAlcaSan","html_url":"https://github.com/dAlcaSan","followers_url":"https://api.github.com/users/dAlcaSan/followers","following_url":"https://api.github.com/users/dAlcaSan/following{/other_user}","gists_url":"https://api.github.com/users/dAlcaSan/gists{/gist_id}","starred_url":"https://api.github.com/users/dAlcaSan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dAlcaSan/subscriptions","organizations_url":"https://api.github.com/users/dAlcaSan/orgs","repos_url":"https://api.github.com/users/dAlcaSan/repos","events_url":"https://api.github.com/users/dAlcaSan/events{/privacy}","received_events_url":"https://api.github.com/users/dAlcaSan/received_events","type":"User","user_view_type":"public","site_admin":false},"re
nButton, ButtonVariant, ButtonSize, IconButtonSize, Select, SelectContent, SelectGroup, SelectItem, SelectLabel, SelectTrigger, SelectValue, Skeleton, Avatar, AvatarImage, AvatarFallback } from '@hai3/uikit';\n+\n+/**\n+ * UI Kit Elements Screen ID\n+ */\n+export const UI_KIT_ELEMENTS_SCREEN_ID = 'uikit';\n+\n+/**\n+ * UI Kit Elements Screen\n+ * Demo page with available UI Kit elements and styles annotations\n+ */\n+export const UIKitElementsScreen: React.FC = () => {\n+  const [airplaneMode, setAirplaneMode] = useState(false);\n+\n+  return (\n+    <div className=\"flex flex-col gap-8 p-8\">\n+      <div className=\"flex flex-col gap-4\">\n+        <h1 className=\"text-4xl font-bold\">UI Kit Elements</h1>\n+        <p className=\"text-muted-foreground\">\n+          Demo page with available UI Kit elements and styles annotations\n+        </p>\n+      </div>\n+\n+      <div className=\"max-w-2xl flex flex-col gap-8\">\n+        {/* Avatar Element Block */}\n+        <div className=\"flex flex-col gap-4\">\n+          <h2 className=\"text-2xl font-semibold\">Avatar</h2>\n+          <div className=\"flex items-center justify-center p-6 border border-border rounded-lg bg-background\">\n+            <div className=\"flex flex-row flex-wrap items-center gap-12\">\n+              <Avatar>\n+                <AvatarImage src=\"https://github.com/shadcn.png\" alt=\"@shadcn\" />\n+                <AvatarFallback>CN</AvatarFallback>\n+              </Avatar>\n+              <Avatar className=\"rounded-lg\">\n+                <AvatarImage\n+                  src=\"https://github.com/evilrabbit.png\"\n+                  alt=\"@evilrabbit\"\n+                />\n+                <AvatarFallback>ER</AvatarFallback>\n+              </Avatar>\n+              <div className=\"*:data-[slot=avatar]:ring-background flex -space-x-2 *:data-[slot=avatar]:ring-2 *:data-[slot=avatar]:grayscale\">\n+                <Avatar>\n+                  <AvatarImage src=\"https://github.com/shadcn.png\" alt=\"@shadcn\" />\n+                  <AvatarFallback>CN</AvatarFallback>\n+                </Avatar>\n+                <Avatar>\n+                  <AvatarImage\n+                    src=\"https://github.com/maxleiter.png\"\n+                    alt=\"@maxleiter\"\n+                  />\n+                  <AvatarFallback>LR</AvatarFallback>\n+                </Avatar>\n+                <Avatar>\n+                  <AvatarImage\n+                    src=\"https://github.com/evilrabbit.png\"\n+                    alt=\"@evilrabbit\"\n+                  />\n+                  <AvatarFallback>ER</AvatarFallback>\n+                </Avatar>\n+              </div>\n+            </div>\n+          </div>\n+        </div>\n+\n+        {/* Button Element Block */}\n+        <div className=\"flex flex-col gap-4\">\n+          <h2 className=\"text-2xl font-semibold\">Button</h2>\n+          <div className=\"flex flex-col gap-4 p-6 border border-border rounded-lg bg-background overflow-hidden\">\n+            {/* First row: 6 Default sized buttons with variants */}\n+            <div className=\"flex flex-wrap items-center justify-between w-full gap-2 min-w-0\">\n+              <Button variant={ButtonVariant.Default} className=\"shrink-0\">Default</Button>\n+              <Button variant={ButtonVariant.Destructive} className=\"shrink-0\">Destructive</Button>\n+              <Button variant={ButtonVariant.Outline} className=\"shrink-0\">Outline</Button>\n+              <Button variant={ButtonVariant.Secondary} className=\"shrink-0\">Secondary</Button>\n+              <Button variant={ButtonVariant.Ghost} className=\"shrink-0\">Ghost</Button>\n+              <Button variant={ButtonVariant.Link} className=\"shrink-0\">Link</Button>\n+            </div>\n+\n+            {/* Second row: 6 buttons grouped by size (Small, Default, Large) */}\n+            <div className=\"flex flex-wrap items-center justify-between w-full gap-2 min-w-0\">\n+              {/* Small group */}\n+              <div className=\"flex items-center gap-2 shrink-0\">\n+                <Button variant={ButtonVariant.Outline} size={ButtonSize.Sm}>Small Outlined</Button>\n+                <IconButton\n+                  variant={ButtonVariant.Outline}\n+                  size={IconButtonSize.Small}\n+                  aria-label=\"Small icon button\"\n+                >\n+                  <svg","path":"src/screensets/drafts/demo/screens/uikit/UIKitElementsScreen.tsx","commit_id":"9eee49188d109f0038ca3106522cf9405f0d997c","original_commit_id":"9eee49188d109f0038ca3106522cf9405f0d997c","user":{"login":"beyond-event-horizon","id":238198382,"node_id":"U_kgDODjKebg","avatar_url":"https://avatars.githubusercontent.com/u/238198382?v=4","gravatar_id":"","url":"https://api.github.com/users/beyond-event-horizon","html_url":"https://github.com/beyond-event-horizon","followers_url":"https://api.github.com/users/beyond-event-horizon/followers","following_url":"https://api.github.com/users/beyond-event-horizon/following{/other_user}","gists_url":"https://api.github.com/users/beyond-event-horizon/gists{/gist_id}","starred_url":"https://api.github.com/users/beyond-event-horizon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beyond-event-horizon/subscriptions","organizations_url":"https://api.github.com/users/beyond-event-horizon/orgs","repos_url":"https://api.github.com/users/beyond-event-horizon/repos","events_url":"https://api.github.com/users/beyond-event-horizon/events{/privacy}","received_events_url":"https://api.github.com/users/beyond-event-horizon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think it would make sense to extract svg icons to separate files placed in the screenset's ui kit","created_at":"2025-11-07T04:22:04Z","updated_at":"2025-11-07T04:22:27Z","html_url":"https://github.com/cyberfabric/cyberware-frontx/pull/20#discussion_r2501633587","pull_request_url":"https://api.github.com/repos/cyberfab
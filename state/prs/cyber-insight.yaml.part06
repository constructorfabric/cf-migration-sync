r | PRIMARY KEY, AUTO INCREMENT | Internal primary key |\n+| `repo_id` | integer | NOT NULL | References repo.gitlab_repo_id |\n+| `file_id` | integer | NOT NULL | References file.id |\n+| `loc` | integer | NOT NULL | Lines of code count (0 for deleted/binary files) |","path":"streams/raw_git/git_loc.md","commit_id":"7b4811e24e84830df73aabdea58e332784a65b32","original_commit_id":"81dc8a7b1b188af1a8973df750823b68fb578879","user":{"login":"maxcherey","id":191410199,"node_id":"U_kgDOC2iwFw","avatar_url":"https://avatars.githubusercontent.com/u/191410199?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcherey","html_url":"https://github.com/maxcherey","followers_url":"https://api.github.com/users/maxcherey/followers","following_url":"https://api.github.com/users/maxcherey/following{/other_user}","gists_url":"https://api.github.com/users/maxcherey/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcherey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcherey/subscriptions","organizations_url":"https://api.github.com/users/maxcherey/orgs","repos_url":"https://api.github.com/users/maxcherey/repos","events_url":"https://api.github.com/users/maxcherey/events{/privacy}","received_events_url":"https://api.github.com/users/maxcherey/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"we need to split it into added and deleted","created_at":"2026-02-26T15:56:18Z","updated_at":"2026-02-26T15:56:18Z","html_url":"https://github.com/cyberfabric/cyber-insight/pull/3#discussion_r2859844383","pull_request_url":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/3","_links":{"self":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/comments/2859844383"},"html":{"href":"https://github.com/cyberfabric/cyber-insight/pull/3#discussion_r2859844383"},"pull_request":{"href":"https://api.github.com/repos/cyberfabric/cyber-insight/pulls/3"}},"reactions":{"url":"https://api.github.c